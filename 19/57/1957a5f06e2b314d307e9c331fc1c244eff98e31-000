# 27 October 2026 13:13 Paris: capture the live car review viewport with a temporary camera, restoring the view afterwards.
import hou
output = globals()['OUTPUT']
subject = hou.node(globals().get('SUBJECT', '/obj/ZRM_CarReview'))
viewer = next(p for p in hou.ui.paneTabs() if p.type() == hou.paneTabType.SceneViewer)
viewport = viewer.curViewport()
old_camera = viewport.camera()
old_view = viewport.defaultCamera().stash()
camera = hou.node('/obj').createNode('cam', 'zrm_capture_camera')
flags = [(n, n.isDisplayFlagSet()) for n in hou.node('/obj').children() if n.type().name() == 'geo']
try:
    for node, flag in flags: node.setDisplayFlag(node == subject)
    camera.parmTuple('t').set(globals().get('POSITION', (5.5, 3.2, 6.5)))
    camera.parmTuple('r').set(hou.hmath.buildRotateLookAt(hou.Vector3(camera.parmTuple('t').eval()), hou.Vector3(globals().get('TARGET', (0, 0.6, 0))), hou.Vector3(0, 1, 0)).extractRotates())
    camera.parm('focal').set(45)
    viewport.setCamera(camera)
    settings = viewer.flipbookSettings().stash()
    settings.output(output); settings.outputToMPlay(False)
    settings.useResolution(True); settings.resolution((1200, 900))
    settings.frameRange((hou.frame(), hou.frame()))
    viewer.flipbook(viewport, settings)
finally:
    viewport.setCamera(old_camera)
    if old_camera is None: viewport.setDefaultCamera(old_view)
    camera.destroy()
    for node, flag in flags: node.setDisplayFlag(flag)
result = output
