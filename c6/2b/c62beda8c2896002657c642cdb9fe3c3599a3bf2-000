import hou, numpy as np

geo = hou.pwd().geometry()
geo.clear()

# 1. Measured 3D Profile Curves from 6 views (Decklid header to Roof header)
# Decklid header at Z = -1.988 (5mm gap to decklid at Z = -1.993)
# Roof header at Z = -1.020 (5mm gap to roof at Z = -1.015)
measured_z = np.array([-1.988, -1.794, -1.600, -1.406, -1.212, -1.020])
measured_x = np.array([0.486, 0.507, 0.533, 0.562, 0.573, 0.575])
measured_yc = np.array([1.037, 1.083, 1.127, 1.167, 1.218, 1.256])
measured_ye = np.array([1.036, 1.085, 1.127, 1.166, 1.190, 1.217])

num_u = 9 # 9 rows along Z
z_pts = np.linspace(-1.988, -1.020, num_u)
num_v = 5 # 5 control columns across X

x_edges = np.interp(z_pts, measured_z, measured_x)
yc_centers = np.interp(z_pts, measured_z, measured_yc)
ye_edges = np.interp(z_pts, measured_z, measured_ye)

surf = geo.createNURBSSurface(num_v, num_u)

for i in range(num_u):
    z = float(z_pts[i])
    xe = float(x_edges[i])
    yc = float(yc_centers[i])
    ye = float(ye_edges[i])
    xc = float(xe * 0.5)
    y_mid = float(yc + (ye - yc) * 0.25)
    v_pts = [
        (-xe, ye, z),
        (-xc, y_mid, z),
        (0.0, yc, z),
        (xc, y_mid, z),
        (xe, ye, z)
    ]
    for j in range(num_v):
        surf.vertex(i, j).point().setPosition(hou.Vector3(*v_pts[j]))
