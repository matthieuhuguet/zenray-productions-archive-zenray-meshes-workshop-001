# 26 October 2026 : ZenRay Meshes, ORGANIC COMPONENT TABLE judged by the soft ridge bench (BranchLab), replacing the binary colour class cover for the wood components.
# EN: the trunk, roots and foliage keep their region agreement (ComponentScore) ; main limbs and branches are judged by the ridge bench (precision x recall of the drawn centreline on the
# soft limb ridges of every view) because a binary colour mask loses the relief (Matthieu, 26 October 2026) ; twigs are hidden by the leaves in the reference, so they are reported as not measurable.
# FR : tableau des composants de l'arbre, bois jugé par le banc de crêtes douces. Usage: python BranchComponents.py <tag> [obj=tree]
import sys, os, json
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
import BranchLab as B
W = B.W


def main(tag, obj="tree"):
    cj = json.load(open(W + "versions/Components_%s_%s.json" % (obj, tag))); comp = {k: dict(v) for k, v in cj["components"].items()}
    V, R, A = B._views_with_arg(obj); RL = B.limb_map(R, A, 1); sk = json.load(open(W + "work/%s/tree_%s_skeleton.json" % (obj, tag))); N = np.array(sk["nodes"]); par = np.array(sk["parent"]); rad = np.array(sk["radius"]); s = B.score(V, RL, N, par, rad)
    P = s["precision"]; f = lambda r: 2 * P * r / max(P + r, 1e-9)
    comp["3"]["completion_region_mask"] = comp["3"]["completion"]; comp["3"]["completion"] = round(f(s["recall_thick"]), 3); comp["3"]["judge"] = "ridge bench, thick recall %s, precision %s" % (s["recall_thick"], P)
    comp["4"]["completion_region_mask"] = comp["4"]["completion"]; comp["4"]["completion"] = round(f(s["recall_med"]), 3); comp["4"]["judge"] = "ridge bench, medium recall %s, precision %s" % (s["recall_med"], P)
    comp["5"]["completion_region_mask"] = comp["5"]["completion"]; comp["5"]["completion"] = None; comp["5"]["judge"] = "not measurable : twigs are hidden by the leaves in the reference"
    vals = [v["completion"] for v in comp.values() if v.get("completion") is not None and "check" not in v.get("name", "")]
    out = {"_date": "26 October 2026", "object": obj, "tag": tag, "bench": {k: s[k] for k in ("G", "F", "precision", "recall_thick", "recall_med", "n_nodes", "length_m")}, "components": comp, "mean_completion": round(float(np.mean(vals)), 3)}
    json.dump(out, open(W + "versions/Components_%s_%s_ridge.json" % (obj, tag), "w"), indent=1)
    json.dump({k: comp[k]["completion"] for k in ("3", "4", "5")}, open(W + "work/%s/ridge_override_%s.json" % (obj, tag), "w"))   # read by ComponentScore for the board and the table
    lines = ["# %s %s components judged by the ridge bench (26 October 2026)" % (obj, tag), "", "Mean completion (measurable components) : **%s** ; bench G %s, F %s." % (out["mean_completion"], s["G"], s["F"]), "", "| N | Component | Completion | Judge |", "|---|---|---|---|"]
    for k in sorted(comp, key=int):
        v = comp[k]; c = v.get("completion"); lines.append("| %s | %s | %s | %s |" % (k, v["name"], "n/a" if c is None else "%d %%" % round(100 * c), v.get("judge", "region agreement (ComponentScore)")))
    open(W + "versions/Components_%s_%s_ridge.md" % (obj, tag), "w").write("\n".join(lines) + "\n"); print("\n".join(lines))


if __name__ == "__main__":
    main(*sys.argv[1:])
