"""Pass 9 : two straightening methods for a quad mesh on a reference surface, same projection, same judge. Written 30 October 2026.
(1) template_fit : re-implementation of the smoothing kernel of QuadWild (per face rigid fit of a regular square of equal area,
    per vertex weighted average, 30 percent Laplacian, damping, projection), optional fold guard.
(2) barrier : minimization of the Winslow type energy sum over corners of (1 - theta) tr(J^T J) / chi(det J) + theta (1 + det^2) / chi(det J)
    with the regularized chi(d) = (d + sqrt(eps^2 + d^2)) / 2 (Garanzha et al. 2021, formula from the slides of the authors), on the tangent
    plane of every vertex, L-BFGS inside, projection on the reference surface between outer iterations.
FR : deux redresseurs de quads sur une surface de reference : ajustement de gabarit carre (noyau de QuadWild) et energie de Winslow a barriere."""
import numpy as np
import trimesh
from scipy.optimize import minimize


AT_FLOOR = 1e-4          # 30 October 2026 : floor of the target quad area, as a fraction of the median (1e-2 degraded the arch : squashed 0.63 to 0.77 percent, straightness 5.31 to 6.40 ; 0 gives NaN on a zero area quad)


class Surface:
    def __init__(self, V, F):
        self.m = trimesh.Trimesh(V, F, process=False)

    def project(self, X):
        cp, d, tid = trimesh.proximity.closest_point(self.m, X)
        return cp


def quad_normals(P, Q):
    n = np.cross(P[Q[:, 2]] - P[Q[:, 0]], P[Q[:, 3]] - P[Q[:, 1]])
    return n / np.maximum(np.linalg.norm(n, axis=1, keepdims=True), 1e-30)


def quad_areas(P, Q):
    return 0.5 * np.linalg.norm(np.cross(P[Q[:, 2]] - P[Q[:, 0]], P[Q[:, 3]] - P[Q[:, 1]]), axis=1)


def min_corner_det(P, Q):
    n = quad_normals(P, Q); d = []
    for k in range(4):
        a = P[Q[:, (k + 1) % 4]] - P[Q[:, k]]; b = P[Q[:, (k - 1) % 4]] - P[Q[:, k]]
        d.append(np.einsum("ij,ij->i", np.cross(a, b), n))
    return np.min(d, axis=0)


def vertex_adjacency(Q, n):
    nb = [set() for _ in range(n)]
    for q in Q:
        for k in range(4):
            nb[q[k]].add(int(q[(k + 1) % 4])); nb[q[k]].add(int(q[(k - 1) % 4]))
    ptr = np.array([0] + [len(s) for s in nb]).cumsum(); flat = np.array([w for s in nb for w in s])
    return ptr, flat


def laplacian_avg(P, ptr, flat):
    cnt = np.diff(ptr)
    return np.add.reduceat(P[flat], ptr[:-1]) / cnt[:, None]


# ============================================================================================================================
# (1) template fit
# ============================================================================================================================
def template_fit(P, Q, surf, fixed=None, steps=30, damp=0.5, smooth_term=0.3, weight="deviation", guard=False, verbose=False):
    P = P.copy(); n = len(P); fixed = np.zeros(n, bool) if fixed is None else fixed
    ptr, flat = vertex_adjacency(Q, n)
    sq = np.array([[-1, -1], [1, -1], [1, 1], [-1, 1]], float) / 2.0      # unit square, counter clockwise
    for s in range(steps):
        nrm = quad_normals(P, Q); A = quad_areas(P, Q)
        c = P[Q].mean(axis=1)
        # tangent frame of each quad : e1 along the first diagonal projected, e2 = n x e1
        e1 = P[Q[:, 2]] - P[Q[:, 0]]; e1 = e1 - nrm * np.einsum("ij,ij->i", e1, nrm)[:, None]; e1 /= np.maximum(np.linalg.norm(e1, axis=1, keepdims=True), 1e-30)
        e2 = np.cross(nrm, e1)
        loc = P[Q] - c[:, None, :]
        x = np.einsum("fkj,fj->fk", loc, e1); y = np.einsum("fkj,fj->fk", loc, e2)       # (m,4) planar coordinates
        # best rotation of the square T (side sqrt(A)) onto the planar points, equal area => no scaling
        side = np.sqrt(np.maximum(A, 1e-30))[:, None]
        tx = sq[:, 0][None, :] * side; ty = sq[:, 1][None, :] * side
        num = (tx * y - ty * x).sum(axis=1); den = (tx * x + ty * y).sum(axis=1)
        th = np.arctan2(num, den)
        # the square diagonal 0 -> 2 is at 45 degrees : the fit above is relative to the diagonal frame, so rotate the template
        cs, sn = np.cos(th)[:, None], np.sin(th)[:, None]
        rx = cs * tx - sn * ty; ry = sn * tx + cs * ty
        tgt = c[:, None, :] + rx[:, :, None] * e1[:, None, :] + ry[:, :, None] * e2[:, None, :]
        dev = ((tgt - P[Q]) ** 2).sum(axis=(1, 2)) / np.maximum(A, 1e-30)
        w = dev + 1e-5 if weight == "deviation" else 1.0 / np.maximum(A, 1e-30)
        acc = np.zeros_like(P); ws = np.zeros(n)
        for k in range(4):
            np.add.at(acc, Q[:, k], tgt[:, k, :] * w[:, None]); np.add.at(ws, Q[:, k], w)
        new = np.where(ws[:, None] > 0, acc / np.maximum(ws, 1e-30)[:, None], P)
        lap = laplacian_avg(P, ptr, flat)
        new = new * (1 - smooth_term) + lap * smooth_term
        cand = P * damp + new * (1 - damp)
        cand[fixed] = P[fixed]
        cand = surf.project(cand); cand[fixed] = P[fixed]
        if guard:
            t = 1.0
            while t > 1e-3:
                trial = surf.project(P + (cand - P) * t); trial[fixed] = P[fixed]
                if min_corner_det(trial, Q).min() > 0 or min_corner_det(P, Q).min() <= 0:
                    cand = trial; break
                t *= 0.5
            else:
                cand = P
        P = cand
    return P


# ============================================================================================================================
# (2) Winslow type barrier energy
# ============================================================================================================================
def tangent_frames(N):
    t = np.where(np.abs(N[:, [0]]) < 0.9, np.array([[1.0, 0, 0]]), np.array([[0, 1.0, 0]]))
    e1 = np.cross(N, t); e1 /= np.maximum(np.linalg.norm(e1, axis=1, keepdims=True), 1e-30)
    e2 = np.cross(N, e1)
    return e1, e2


def barrier_energy_grad(X, Q, nq, At, eps, theta):
    """Energy and gradient w.r.t. the vertex positions X, quad normals nq frozen, target areas At (per quad)."""
    E = 0.0; G = np.zeros_like(X)
    for k in range(4):
        i0, i1, i2 = Q[:, k], Q[:, (k + 1) % 4], Q[:, (k - 1) % 4]
        a = X[i1] - X[i0]; b = X[i2] - X[i0]
        d = np.einsum("ij,ij->i", np.cross(a, b), nq) / At
        S = (np.einsum("ij,ij->i", a, a) + np.einsum("ij,ij->i", b, b)) / At
        r = np.sqrt(eps ** 2 + d ** 2); chi = np.maximum(0.5 * (d + r), 1e-12); dchi = 0.5 * (1 + d / r)
        shape = S / chi; area = (1 + d ** 2) / chi
        E += ((1 - theta) * shape + theta * area).sum()
        dF_dS = (1 - theta) / chi
        dF_dd = (1 - theta) * (-S * dchi / chi ** 2) + theta * (2 * d / chi - (1 + d ** 2) * dchi / chi ** 2)
        ga = (dF_dS / At)[:, None] * 2 * a + (dF_dd / At)[:, None] * np.cross(b, nq)
        gb = (dF_dS / At)[:, None] * 2 * b + (dF_dd / At)[:, None] * np.cross(nq, a)
        np.add.at(G, i1, ga); np.add.at(G, i2, gb); np.add.at(G, i0, -(ga + gb))
    return E, G


class ArcSet:
    """Polylines of the elementary arcs : nearest point, tangent, projection for vertices that slide along their arc."""
    def __init__(self, polys):
        self.polys = [np.asarray(p, float) for p in polys]

    def nearest(self, aid, X):
        """For points X (k,3) of arc aid : nearest point on the polyline and the unit tangent of the nearest segment."""
        A = self.polys[aid]; a = A[:-1]; b = A[1:]; ab = b - a
        L2 = np.maximum((ab ** 2).sum(axis=1), 1e-30)
        t = np.clip(((X[:, None, :] - a[None]) * ab[None]).sum(axis=2) / L2[None], 0, 1)
        C = a[None] + t[:, :, None] * ab[None]
        d2 = ((X[:, None, :] - C) ** 2).sum(axis=2); j = d2.argmin(axis=1)
        idx = np.arange(len(X)); tan = ab[j]; tan = tan / np.maximum(np.linalg.norm(tan, axis=1, keepdims=True), 1e-30)
        return C[idx, j], tan


# 30 October 2026 : ISOLINE FAIRING (ZenRay Retopology F1). EN: at every interior valence 4 vertex the two edge pairs that continue each other should form straight lines of the UNFOLDED surface. Energy fair * sum |x_a + R x_b - (I + R) x_c|^2 / A_c over the lines (a, c, b) : R = identity inside a face, R = rotation about the arc tangent that unfolds face B onto face A when the line crosses a hard edge arc (centre c slides on its arc). R is frozen per outer iteration like the quad normals, the term is linear in the positions.
# FR : rectitude des lignes d'isovaleur : un terme lineaire par ligne a-c-b, avec depliage de la face B sur la face A a travers un arc d'arete vive.
def fair_lines(Q, n):
    """lines (c, a, b) of the interior valence 4 vertices : the opposite neighbours of the cyclic ring. Boundary and irregular vertices give none."""
    at = [[] for _ in range(n)]
    for q in Q:
        for k in range(4):
            at[int(q[k])].append((int(q[(k - 1) % 4]), int(q[(k + 1) % 4])))
    cnt = {}
    for q in Q:
        for k in range(4):
            e = (min(int(q[k]), int(q[(k + 1) % 4])), max(int(q[k]), int(q[(k + 1) % 4]))); cnt[e] = cnt.get(e, 0) + 1
    bd = {v for e, c in cnt.items() if c == 1 for v in e}; out = []
    for v, lst in enumerate(at):
        if v in bd or len(lst) != 4: continue
        nxt = dict(lst)
        if len(nxt) != 4: continue
        ring = [lst[0][0], lst[0][1]]
        while len(ring) < 4:
            m = nxt.get(ring[-1])
            if m is None or m in ring: break
            ring.append(m)
        if len(ring) != 4: continue
        out.append((v, ring[0], ring[2])); out.append((v, ring[1], ring[3]))
    return np.array(out, np.int64).reshape(-1, 3)


def edge_quad_normal(P, Q, nq):
    """map (min, max) edge -> normal of one quad containing it."""
    m = {}
    for qi, q in enumerate(Q):
        for k in range(4):
            m[(min(int(q[k]), int(q[(k + 1) % 4])), max(int(q[k]), int(q[(k + 1) % 4])))] = qi
    return m


def rodrigues(axis, ang):
    """rotation matrices (m,3,3) about unit axes (m,3) by angles (m,)."""
    K = np.zeros((len(axis), 3, 3)); K[:, 0, 1] = -axis[:, 2]; K[:, 0, 2] = axis[:, 1]; K[:, 1, 0] = axis[:, 2]; K[:, 1, 2] = -axis[:, 0]; K[:, 2, 0] = -axis[:, 1]; K[:, 2, 1] = axis[:, 0]
    s = np.sin(ang)[:, None, None]; c = np.cos(ang)[:, None, None]; return np.eye(3)[None] + s * K + (1 - c) * (K @ K)


def fair_rotations(P, Q, nq, lines, kind, arc_of, arcs, eq, N):
    """R (m,3,3) per line : identity except for lines that cross a hard-edge arc at a sliding centre ; and the normal Nl (m,3) of the plane in which the line must be straight (vertex normal, or the normal of face A for a crossing line)."""
    R = np.tile(np.eye(3), (len(lines), 1, 1)); Nl = N[lines[:, 0]].copy()
    if arcs is None or len(lines) == 0: return R, Nl
    c, a, b = lines.T; cross = np.where((kind[c] == 1) & (kind[a] == 0) & (kind[b] == 0))[0]
    if len(cross) == 0: return R, Nl
    tan = np.zeros((len(cross), 3))
    for aid in np.unique(arc_of[c[cross]]):
        sel = np.where(arc_of[c[cross]] == aid)[0]; _, tg = arcs.nearest(aid, P[c[cross][sel]]); tan[sel] = tg
    nA = np.array([nq[eq[(min(int(c[i]), int(a[i])), max(int(c[i]), int(a[i])))]] for i in cross]); nB = np.array([nq[eq[(min(int(c[i]), int(b[i])), max(int(c[i]), int(b[i])))]] for i in cross])
    ang = np.arctan2(np.einsum("ij,ij->i", tan, np.cross(nB, nA)), np.einsum("ij,ij->i", nB, nA)); R[cross] = rodrigues(tan, ang); Nl[cross] = nA; return R, Nl


def fair_energy_grad(X, lines, R, Nl, w):
    """E = w sum |P (u_a + R u_b)|^2 with u the unit edge directions from the centre and P the projector on the tangent plane (normal Nl) : zero for any spacing of a straight line, and zero for a ring line of a cylinder, which the intrinsic straightness metric also accepts (the 3D chord form pulled such lines off the surface)."""
    c, a, b = lines.T; ra = X[a] - X[c]; rb = X[b] - X[c]; la = np.maximum(np.linalg.norm(ra, axis=1, keepdims=True), 1e-12); lb = np.maximum(np.linalg.norm(rb, axis=1, keepdims=True), 1e-12)
    ua = ra / la; ub = rb / lb; d = ua + np.einsum("mij,mj->mi", R, ub); d = d - Nl * (d * Nl).sum(1, keepdims=True); E = float(w * (d ** 2).sum())
    ga = 2 * w * (d - ua * (d * ua).sum(1, keepdims=True)) / la; Rtd = np.einsum("mji,mj->mi", R, d); gb = 2 * w * (Rtd - ub * (Rtd * ub).sum(1, keepdims=True)) / lb
    G = np.zeros_like(X); np.add.at(G, a, ga); np.add.at(G, b, gb); np.add.at(G, c, -(ga + gb)); return E, G


def fair_rings(Q, n):
    """rings (c, n0, n1, n2, n3) of the interior valence 4 vertices in cyclic order (same selection as fair_lines)."""
    lines = fair_lines(Q, n)
    if len(lines) == 0: return np.zeros((0, 5), np.int64)
    at = [[] for _ in range(n)]
    for q in Q:
        for k in range(4): at[int(q[k])].append((int(q[(k - 1) % 4]), int(q[(k + 1) % 4])))
    out = []
    for v in np.unique(lines[:, 0]):
        nxt = dict(at[v]); ring = [at[v][0][0], at[v][0][1]]
        while len(ring) < 4: ring.append(nxt[ring[-1]])
        out.append((int(v),) + tuple(ring))
    return np.array(out, np.int64)


def ring_energy_grad(X, rings, w):
    """30 October 2026 : the EXACT form of the intrinsic straightness metric. With the four face angles a0..a3 around a valence 4 vertex (angles between consecutive unit edge directions) the metric is max(|a0 - a2|, |a1 - a3|) / 2 ; E = w sum ((a0 - a2)^2 + (a1 - a3)^2), analytic gradient through the unit directions."""
    c = rings[:, 0]; nb = rings[:, 1:]; r = X[nb] - X[c][:, None, :]; ln = np.maximum(np.linalg.norm(r, axis=2, keepdims=True), 1e-12); u = r / ln
    cs = np.einsum("mkj,mkj->mk", u, np.roll(u, -1, axis=1)); cs = np.clip(cs, -1 + 1e-9, 1 - 1e-9); al = np.arccos(cs); sn = np.sqrt(1 - cs ** 2)
    sd = al[:, 0] - al[:, 2]; td = al[:, 1] - al[:, 3]; E = float(w * (sd ** 2 + td ** 2).sum()); dE = np.stack([2 * w * sd, 2 * w * td, -2 * w * sd, -2 * w * td], axis=1)
    up = np.roll(u, -1, axis=1); um = np.roll(u, 1, axis=1)                                      # dalpha_k/du_k and dalpha_k/du_(k+1)
    g_u = np.zeros_like(u)
    g_u += (dE / sn)[:, :, None] * (-(up - cs[:, :, None] * u))                                  # alpha_k depends on u_k
    dEm = np.roll(dE, 1, axis=1); csm = np.roll(cs, 1, axis=1); snm = np.roll(sn, 1, axis=1)
    g_u += (dEm / snm)[:, :, None] * (-(um - csm[:, :, None] * u))                               # alpha_(k-1) depends on u_k
    g_r = (g_u - u * np.einsum("mkj,mkj->mk", u, g_u)[:, :, None]) / ln
    G = np.zeros_like(X); np.add.at(G, nb.ravel(), g_r.reshape(-1, 3)); np.add.at(G, c, -g_r.sum(axis=1)); return E, G


def barrier(P, Q, surf, fixed=None, outer=12, inner=60, theta=1.0 / 128, size="keep", size_smooth=5, groups=None, kind=None, arc_of=None, arcs=None, verbose=False, fair=0.0, fair_angles=0.0):
    """kind (n,) : 0 free on the surface, 1 slides along arc arc_of[v] of the ArcSet arcs, 2 fixed."""
    P = P.copy(); n = len(P)
    if kind is None:
        kind = np.zeros(n, int) if fixed is None else np.where(fixed, 2, 0)
    kind = np.asarray(kind)
    free = np.where(kind != 2)[0]
    A0 = quad_areas(P, Q)
    if size == "smooth":                          # target areas diffused over the face graph : sizes vary smoothly, shape energy does the rest
        fa = {}
        for qi, q in enumerate(Q):
            for k in range(4):
                fa.setdefault((min(q[k], q[(k + 1) % 4]), max(q[k], q[(k + 1) % 4])), []).append(qi)
        pairs = np.array([v for v in fa.values() if len(v) == 2])
        At = A0.copy()
        for _ in range(size_smooth):
            nbsum = np.zeros_like(At); cnt = np.zeros_like(At)
            np.add.at(nbsum, pairs[:, 0], At[pairs[:, 1]]); np.add.at(cnt, pairs[:, 0], 1)
            np.add.at(nbsum, pairs[:, 1], At[pairs[:, 0]]); np.add.at(cnt, pairs[:, 1], 1)
            At = 0.5 * At + 0.5 * nbsum / np.maximum(cnt, 1)
    elif size == "patch" and groups is not None:
        # target area = (total area of the patch) / (number of quads of the patch), then one diffusion step so that neighbouring patches blend
        g = np.asarray(groups); tot = np.bincount(g, weights=A0); cnt = np.bincount(g)
        At = (tot / np.maximum(cnt, 1))[g]
    else:
        At = np.maximum(A0, AT_FLOOR * float(np.median(A0)))      # 30 October 2026 : a degenerate (zero area) input quad must not give a zero target area (NaN seen on the arch sweep)
    hist = []
    if fair > 0:
        lines = fair_lines(Q, n); eq = edge_quad_normal(P, Q, None)
    if fair_angles > 0: rings = fair_rings(Q, n); rings = rings[kind[rings[:, 0]] == 0]
    for it in range(outer):
        nq = quad_normals(P, Q)
        N = np.zeros_like(P)
        for k in range(4):
            np.add.at(N, Q[:, k], nq * quad_areas(P, Q)[:, None])
        N /= np.maximum(np.linalg.norm(N, axis=1, keepdims=True), 1e-30)
        e1, e2 = tangent_frames(N)
        if arcs is not None:
            for aid in np.unique(arc_of[kind == 1]):
                vs = np.where((kind == 1) & (arc_of == aid))[0]
                _, tan = arcs.nearest(aid, P[vs]); e1[vs] = tan; e2[vs] = 0.0
        dmin = (min_corner_det(P, Q) / At).min()
        eps = np.sqrt(1e-6 ** 2 + 0.04 * min(dmin, 0.0) ** 2)
        eps = max(eps, 1e-9)

        if fair > 0:
            Rf, Nl = fair_rotations(P, Q, nq, lines, kind, arc_of, arcs, eq, N); fw = 1.0

        def f(t):
            X = P.copy()
            X[free] += t[:len(free), None] * e1[free] + t[len(free):, None] * e2[free]
            E, G = barrier_energy_grad(X, Q, nq, At, eps, theta)
            if fair > 0:
                Ef, Gf = fair_energy_grad(X, lines, Rf, Nl, fair * fw); E += Ef; G = G + Gf
            if fair_angles > 0 and len(rings):
                Ea, Ga = ring_energy_grad(X, rings, fair_angles); E += Ea; G = G + Ga
            g = np.concatenate([np.einsum("ij,ij->i", G[free], e1[free]), np.einsum("ij,ij->i", G[free], e2[free])])
            return E, g
        t0 = np.zeros(2 * len(free))
        res = minimize(f, t0, jac=True, method="L-BFGS-B", options={"maxiter": inner, "maxcor": 20})
        t = res.x
        X = P.copy(); X[free] += t[:len(free), None] * e1[free] + t[len(free):, None] * e2[free]
        def proj(Y):
            Z = Y.copy(); m = kind == 0
            if m.any(): Z[m] = surf.project(Y[m])      # 30 October 2026 : no free vertex (a 2 quad piece whose vertices all slide on arcs) : nothing to project
            if arcs is not None:
                for aid in np.unique(arc_of[kind == 1]):
                    vs = np.where((kind == 1) & (arc_of == aid))[0]
                    Z[vs], _ = arcs.nearest(aid, Y[vs])
            Z[kind == 2] = P[kind == 2]
            return Z
        X = proj(X)
        # fold guard on the projected result : halve the step if it created a fold that the previous state did not have
        step = 1.0
        while step > 1e-3 and min_corner_det(X, Q).min() <= 0 < min_corner_det(P, Q).min():
            step *= 0.5
            X = proj(P + (X - P) * step)
        P = X
        hist.append((it, float(res.fun), float(min_corner_det(P, Q).min() / At.mean())))
        if verbose:
            print(hist[-1])
    return P, hist
