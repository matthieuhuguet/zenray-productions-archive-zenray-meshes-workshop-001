#!/bin/zsh
# 26 October 2026 : ZenRay Meshes, FAST tree modelling step : TreeGrow + Houdini rebuild + topology export + X-ray limb score of one wood class, nothing else (no board, no hero).
# Usage: TreeIter.sh <tag> <class thick|med|thin> [k=v ...]   rules default to work/$OBJ/tree_rules.txt and tree_ctrl.txt, arguments override.  FR : un pas court, un score.
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; TAG=$1; CLS=$2; OBJ=${OBJ:-tree}; cd $W
RULES=$(cat work/$OBJ/tree_rules.txt); CTRL=$(cat work/$OBJ/tree_ctrl.txt)
python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom "c=hou.node('/obj/ZRM_Tree/CTRL_zrm'); [c.parm(kv.split('=')[0]).set(float(kv.split('=')[1])) for kv in '$CTRL'.split(',')]; result=1" live > /dev/null
rm -f work/$OBJ/topo_$TAG.npz
OBJ=$OBJ zsh Scripts/RunTree.sh $TAG ${=RULES} "${@:3}" > /tmp/claude-501/tree_$TAG.log 2>&1 || true
python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom "g={'SOP':'/obj/ZRM_Tree/OUT_tree','OUT':'$W/work/$OBJ/topo_$TAG.npz'}; exec(open('$W/Scripts/ExportTopo.py').read(), g); result=g['result']" live > /dev/null
$PY -I Scripts/LimbScore.py $OBJ $TAG $CLS | $PY -c "import sys,json; d=json.loads(sys.stdin.read()); print('$TAG $CLS', {k:d[k] for k in ('score','cover','leak')}, {v:d[v]['recall_class'] for v in ('front','back','right','left','top') if v in d})"
