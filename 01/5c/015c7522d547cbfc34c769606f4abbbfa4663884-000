#!/usr/bin/env python3
# 10 November 2026: the numbers of one or several versions on one line each. usage: evalv.py <version> [...]
import json, sys
rs = {r['version']: r for r in (json.loads(l) for l in open('iterations.jsonl'))}
for a in sys.argv[1:]:
    v = 'V_%03d' % int(a); r = rs.get(v)
    if not r or not r.get('ok'):
        print(v, 'FAILED or missing'); continue
    m = r.get('measured', {}); q = json.load(open('04_checks/%s-qa/qa.json' % v)); f = q['fidelity']
    bad = [g['gate'] for g in q['gates'] if not g['pass']]
    print('%s gates %s failed %s | F1 min %.4f | F2 %.4f F3 %.4f | plan %.0f%% <=1px mean %.2f | quads %d' % (v, r.get('gates'), bad, min(m.get('F1.' + x, 0) for x in f), m.get('F2') or 0, m.get('F3') or 0, 100 * r['fit']['within_1px'], r['fit']['mean_px'], r.get('quads') or 0))
    print('      ' + ' | '.join('%s R %.3f/%.3f P %.3f/%.3f' % (x[:3], d['line_recall'], d.get('line_recall_consensus', 0), d['border_precision'], d.get('border_precision_consensus', 0)) for x, d in f.items()))
