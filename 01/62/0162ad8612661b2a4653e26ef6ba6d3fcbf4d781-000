        V[k, :, 2] = np.clip(np.interp(V[k, :, 1], np.array(yy_)[o], np.array(zz_)[o]), lo_, hi_)
    def end_face(ring, z_tip):
        # the end face keeps the inset section's widths (scaled) but takes the HEIGHTS of the profile at the tip
        f = ring.copy(); f[:, 0] *= P["end_face_scale"]
        y0, y1 = ring[:, 1].min(), ring[:, 1].max(); t = (ring[:, 1] - y0) / max(y1 - y0, 1e-6)
        ey = np.array(pr["ext_y"]); ez = np.array(pr["z_front"] if z_tip > 0 else pr["z_back"]); ok = np.isfinite(ez)
        inner = ring[0, 2]
        yt_tip = min(at(ytop_p, z_tip), y1); yb_tip = y0              # the end face never reaches below the body
        # 25 October 2026: the roof height AT the tip (0.24 m on the tail, bumper bottom) squashed the tall vertical tail
        # face ; the end face rises to the highest height where the side extreme still passes the last inner section.
        if P.get("end_face_from_extreme", 1):
            past = ok & ((ez > inner) if z_tip > 0 else (ez < inner))
            if past.any(): yt_tip = min(max(yt_tip, float(ey[past].max())), y1)
