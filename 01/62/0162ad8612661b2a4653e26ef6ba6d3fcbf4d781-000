                V[:, :, 0] = np.where(above, V[:, :, 0] * np.interp(V[:, :, 1], cp["fy_y"], cp["fy"]), V[:, :, 0])
                # 25 October 2026: the end views see the widest section, so fy widened the nose and tail corners in plan
                # too ; the widened points never pass the top view half width at their own z (times plan_clamp).
    # PLAN CLAMP (25 October 2026): no cage point passes the top view half width at its own z (times plan_clamp) ;
    # the traced shoulder curves kept their full width to the tail (37 cm over the plan at the rear corners, v17).
    if P.get("plan_clamp", 0) > 0:
        ze = P.get("plan_clamp_end_m", 0.04)   # the plan half width falls to 0 on the last pixel; read it a little inside
        zq = np.clip(V[:, :, 2], m["keys"]["tail"] + ze, m["keys"]["nose"] - ze)
        lim = np.array([[at(hw_p, zz_) for zz_ in row] for row in zq]) * P["plan_clamp"]
