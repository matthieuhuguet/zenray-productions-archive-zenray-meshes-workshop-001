    # cage face is named after its panel (row band x station zone), so the subdivided body splits into real parts
    "buttress_on": 1,   # 26 October 2026: 0 = no separate buttress panel (v408), 1 = buttress panel behind the quarter glass
    "joints_z": {"cowl": 1.56, "roof_front": 0.384, "roof_rear": -0.995, "deck_front": -1.925, "door_front": 0.73, "door_rear": -0.53},
    # 26 October 2026: roof_front, roof_rear and deck_front were read on the top view while its mask held the cast shadow
    # (z stretched by 4.5 %) ; converted to the corrected frame by z' = 1.0448 z - 0.076 (was 0.44, -0.88, -1.77), which
    # lands on the sheet's lines (0.384, -1.009, -1.937 on the line map). Door joints come from the side views (unchanged).
    "nose_rows": "lines/nose_rows.json",
    "design_curves": "lines/design_curves_side_world.json",   # 25 October 2026: traced guide curves drive the named rows
    "plan_curves": "lines/design_curves_top_world.json",
    "design_rows_x": {"belt_top": "plan_shoulder_upper", "glass_base": "plan_dlo_bottom", "roof_edge": "plan_dlo_top", "hood_edge": "plan_hood_edge"},
    "cage_fair": {"on": 1, "knot_m": 0.35, "lam": 0.05, "end_weight": 30.0, "amount": 1.0, "arch_skip": 1.0,
                  "arch_rows": ["floor_edge", "fender_inner", "sill", "door_low"], "rows_skip": []},   # 25 October 2026
    "joint_curves": {"door_rear": ["door_rear_joint", "pillar_b"], "door_front": "door_front_joint"},   # 25 October 2026
    # 25 October 2026: rear door cut and B pillar, mean of the left view (read on the sheet) and the right view traces ;
    # the two views differ by about 8 cm here
    "joint_points": {"door_rear": [[-0.573, 1.26], [-0.625, 1.0], [-0.678, 0.89], [-0.455, 0.33]]},
    "planar_panels": [], "planar_amount": 1.0,   # 25 October 2026: hood not planar, the side silhouette rises to 0.56 at the tip   # 25 October 2026: faceted front
    "design_rows_ext": {"belt": "fender_top", "belt_top": "fender_top"},   # 25 October 2026: continuation past the traced end
    "design_rows": {"belt_top": "shoulder_upper", "sill": "sill_bottom", "door_low": "sill_crease", "belt": "shoulder_lower", "glass_base": "dlo_bottom", "roof_edge": "dlo_top"},
    "fair": 1, "fair_keep_ends_m": 0.15, "fair_knot_len_m": 0.35, "fair_knot_h_m": 0.12,   # 25 October 2026: guide curves are FAIRED (least squares cubic splines), never raw per station samples
    "split_rows": [],   # 25 October 2026: a midpoint row is inserted after each named row listed here (denser section, more fit freedom)
    "floor_lift": 0.0,   # 25 October 2026: offset of the floor centre (subdivision lowers it by a few mm)
    "measure_frame": "frame",   # generic rule 6 (25 October 2026): profiles are read on the symmetrised visual hull, the consistent target
    "segments": 6,                    # roof line pieces: nose-hood, hood, windshield, roof, rear glass, tail
    "between": {"nose": 4, "hood_lead": 4, "cowl": 4, "roof_front": 5, "roof_rear": 4, "deck": 4},
    "end_inset": 0.025, "end_face_scale": 0.94, "tail_support_m": 0.0, "plan_clamp": 1.03,
    "arch_stations": [1.0, 0.75, 0.4, 0.0],   # fractions of the arch radius around each axle (each side)
    "arch_pad": 1.06, "sill_h": 0.07, "door_low_frac": 0.45, "belt_drop": 0.80,
    "glass_inset": 0.03, "roof_edge_drop": 0.035, "fender_gap": 0.03, "cabin_min": 0.10,
    "crease_rows": ["sill", "door_low", "belt", "roof_edge"], "soft_crease_rows": ["roof_centre"], "crease_stations": ["nose", "cowl", "roof_front", "deck", "tail"],
}
# learned defaults and per instance overrides (written by ArchetypeFit.py): the archetype keeps its rules in PARAMS,
# an instance may override any numeric rule through <work>/arch_params.json (25 October 2026)
def load_overrides(wd):
    f = os.path.join(wd, "arch_params.json")
    if os.path.exists(f):
        PARAMS.update({k: v for k, v in json.load(open(f)).items() if k in PARAMS})


ROWS = ["floor_centre", "floor_edge", "fender_inner", "sill", "door_low", "belt", "belt_top", "glass_base", "roof_edge", "roof_centre"]   # belt_top added 25 October 2026 (shoulder band)


def axis_map(meta, v):
    lo = np.array(meta["lo"]); D = np.array(meta["dims_m"]); hi = lo + D
    rx, uy = np.array(v["rx"]), np.array(v["uy"])
    a, b = int(np.argmax(np.abs(rx))), int(np.argmax(np.abs(uy)))
    umin = lo[a] if rx[a] > 0 else -hi[a]; vmax = hi[b] if uy[b] > 0 else -lo[b]
    s = v["px_per_m"]; bb = v["bbox"]
    xc, yc = (bb[0] + bb[2]) / 2, (bb[1] + bb[3]) / 2       # centre alignment, same rule as SheetHull.view_px
    ucen, vcen = umin + D[a] / 2, vmax - D[b] / 2
    return rx[a], uy[b], (lambda u, vv: (xc + (u - ucen) * s, yc + (vcen - vv) * s))


def sample(mask, to_px, us, vs):
    out = np.zeros((len(us), len(vs)), bool)
    for i, u in enumerate(us):
        for j, v in enumerate(vs):
            px, py = to_px(u, v); ix, iy = int(round(px)), int(round(py))
            out[i, j] = 0 <= iy < mask.shape[0] and 0 <= ix < mask.shape[1] and mask[iy, ix]
    return out


def piecewise(z, y, k):
    """Best k segment piecewise linear fit (dynamic programming on sample indices): returns breakpoint indices."""
    n = len(z)
    def cost(i, j):
        zz, yy = z[i:j + 1], y[i:j + 1]
        A = np.stack([zz, np.ones_like(zz)], 1); c, *_ = np.linalg.lstsq(A, yy, rcond=None)
        return float(((A @ c - yy) ** 2).sum())
    C = np.full((k + 1, n), np.inf); B = np.zeros((k + 1, n), int); C[0, 0] = 0
    pre = {}
    for s in range(1, k + 1):
        for j in range(1, n):
            for i in range(s - 1, j):
                if C[s - 1, i] == np.inf:
                    continue
                key = (i, j)
                if key not in pre:
                    pre[key] = cost(i, j)
                v = C[s - 1, i] + pre[key]
                if v < C[s, j]:
                    C[s, j], B[s, j] = v, i
    br = [n - 1]; j = n - 1
    for s in range(k, 0, -1):
        j = B[s, j]; br.append(j)
    return br[::-1]


def measure(wd):
    meta = json.load(open(os.path.join(wd, PARAMS["measure_frame"], "frame.json"))); W = json.load(open(os.path.join(wd, "car_components.json")))["wheels"]
    V = {v["name"]: v for v in meta["views"]}; lo = np.array(meta["lo"]); D = np.array(meta["dims_m"])
    zs = np.linspace(lo[2] + D[2] - 1e-3, lo[2] + 1e-3, 120)            # front (+z) to back
    ys = np.linspace(lo[1], lo[1] + D[1], 300)
    side = np.asarray(Image.open(os.path.join(wd, PARAMS["measure_frame"], "mask_right.png"))) > 127
    sa, sb, tp = axis_map(meta, V["right"])
    S = sample(side, lambda u, v: tp(u, v), zs * sa, ys * sb)
    ytop = np.array([ys[np.where(r)[0].max()] if r.any() else np.nan for r in S])
    ok = np.isfinite(ytop); ytop = np.interp(np.arange(len(zs)), np.where(ok)[0], ytop[ok])
    # underside: lowest pixel of the run hanging from the roof, wheels excluded by arches later
    ybot = []
    for r in S:
        k = np.where(r)[0]
        if not len(k):
            ybot.append(np.nan); continue
        run = [k.max()]
        for kk in k[::-1][1:]:
            if run[-1] - kk <= 2: run.append(kk)
            else: break
        ybot.append(ys[min(run)])
    ybot = np.array(ybot); ok = np.isfinite(ybot); ybot = np.interp(np.arange(len(zs)), np.where(ok)[0], ybot[ok])
    away = np.array([min(abs(z - W["front_z"]), abs(z - W["rear_z"])) > 1.3 * W["tyre_r"] for z in zs])
    floor = float(np.percentile(ybot[away & (np.arange(len(zs)) > 5) & (np.arange(len(zs)) < len(zs) - 6)], 30))   # sill line between the wheels (lower third)
    top = np.asarray(Image.open(os.path.join(wd, PARAMS["measure_frame"], "mask_top.png"))) > 127
    ta, tb, tpt = axis_map(meta, V["top"])
    xs = np.linspace(lo[0], lo[0] + D[0], 300)
    T = sample(top, lambda u, v: tpt(u, v), zs * ta, xs * tb)
    hw = np.array([np.ptp(xs[np.where(r)[0]]) / 2 if r.any() else 0.0 for r in T])
    def width_by_height(view):
        msk = np.asarray(Image.open(os.path.join(wd, PARAMS["measure_frame"], "mask_%s.png" % view))) > 127
        fa, fb, tpf = axis_map(meta, V[view])
        out = []
        for y in ys:
            _, py = tpf(0.0, y * fb); row = msk[int(np.clip(round(py), 0, msk.shape[0] - 1))]
            c0 = int(round(tpf(0.0, 0.0)[0]))
            if 0 <= c0 < len(row) and row[c0]:
                l = c0
                while l > 0 and row[l - 1]: l -= 1
                r = c0
                while r < len(row) - 1 and row[r + 1]: r += 1
                out.append(max(c0 - l, r - c0) / V[view]["px_per_m"])
            else:
                out.append(0.0)
        return ndi.gaussian_filter1d(np.array(out), 1.0)
    F = width_by_height("front"); Fb = width_by_height("back")
    # SIDE SKIRTS (25 October 2026): the end views give the clearance under the CENTRE of the floor, the side view the
    # lowest point anywhere across (the skirts, hidden behind the tyres in the end views)
    def centre_clear(view):
        msk = np.asarray(Image.open(os.path.join(wd, PARAMS["measure_frame"], "mask_%s.png" % view))) > 127
        yy, xx = np.nonzero(msk); cx = (xx.min() + xx.max()) // 2; col = np.where(msk[:, cx])[0]
        return (yy.max() - col.max()) / V[view]["px_per_m"]
    floor_centre = float(max(floor, 0.5 * (centre_clear("front") + centre_clear("back"))))
    # belt (shoulder) height: where the front half width drops below belt_drop of its maximum, going up
    fmax = F.max(); above = np.where((F < PARAMS["belt_drop"] * fmax) & (ys > ys[np.argmax(F)]))[0]
    y_belt = float(ys[above[0]]) if len(above) else float(lo[1] + 0.6 * D[1])
    br = piecewise(zs, ndi.gaussian_filter1d(ytop, 1.5), PARAMS["segments"])
    names = ["nose", "hood_lead", "cowl", "roof_front", "roof_rear", "deck", "tail"]
    keys = {n: float(zs[i]) for n, i in zip(names, br)}
    zfront, zback = [], []
    for j in range(len(ys)):
        k = np.where(S[:, j])[0]
        zfront.append(float(zs[k.min()]) if len(k) else np.nan); zback.append(float(zs[k.max()]) if len(k) else np.nan)
    prof_ext = {"ext_y": ys.tolist(), "z_front": zfront, "z_back": zback}
    if PARAMS["fair"]:
        from scipy.interpolate import LSQUnivariateSpline
        def fair(x, y, step, keep_ends=0.0):
            x0, y0 = np.asarray(x), np.asarray(y)
            o = np.argsort(x0); x, y = x0[o], y0[o]
            t = np.arange(x[0] + step, x[-1] - step * 0.5, step)
            f = LSQUnivariateSpline(x, y, t, k=3)(x)[np.argsort(o)]
            if keep_ends > 0:   # 25 October 2026: the ends (vertical tail, flat nose) are discontinuities the spline must not smooth
                d = np.minimum(x0 - x0.min(), x0.max() - x0); w = np.clip(d / keep_ends, 0, 1)
                f = w * f + (1 - w) * y0
            return f
        ke = PARAMS["fair_keep_ends_m"]
        ytop = fair(zs, ytop, PARAMS["fair_knot_len_m"], ke); ybot = fair(zs, ybot, PARAMS["fair_knot_len_m"], ke); hw = fair(zs, hw, PARAMS["fair_knot_len_m"], ke)
    # nose plan outline traced on the top view (flat front, rounded corners) replaces the measured half width there
    pt = os.path.join(wd, "lines", "design_curves_top_world.json")
    if os.path.exists(pt):
        cc = json.load(open(pt))["curves"].get("plan_outline_front")
        if cc:
            zc, xc = np.array(cc["z"]), np.array(cc["x"]); o = np.argsort(zc); zc, xc = zc[o], xc[o]
            sel = zs >= zc[0]; hw = np.array(hw, float); hw[sel] = np.interp(zs[sel], zc, xc)
        F = np.maximum(fair(ys, F, PARAMS["fair_knot_h_m"]), 0); Fb = np.maximum(fair(ys, Fb, PARAMS["fair_knot_h_m"]), 0)
    prof = {"z": zs.tolist(), "ytop": ytop.tolist(), "ybot": ybot.tolist(), "hw": np.asarray(hw).tolist(),
            "F_y": ys.tolist(), "F": F.tolist(), "F_back": Fb.tolist(), **prof_ext}
    return {"_date": "25 October 2026", "dims_m": D.tolist(), "floor_y": floor, "floor_centre_y": floor_centre, "belt_y": y_belt, "keys": keys,
            "wheels": W, "profiles": prof}


def build(m, out_prefix):
    P = PARAMS; pr = m["profiles"]; W = m["wheels"]
    # GUIDE CURVES (25 October 2026): y(z) of each named row from the traced design curves, NaN outside their z range
    dc_path = os.path.join(os.path.dirname(out_prefix), P["design_curves"]); DC = {}
    if os.path.exists(dc_path):
        for nm, c in json.load(open(dc_path))["curves"].items():
            zz, yy = np.array(c["z"]), np.array(c["y"]); o = np.argsort(zz); DC[nm] = (zz[o], yy[o])
    pc_path = os.path.join(os.path.dirname(out_prefix), P["plan_curves"]); PC = {}
    if os.path.exists(pc_path):
        for nm, c in json.load(open(pc_path))["curves"].items():
            zz, xx = np.array(c["z"]), np.array(c["x"]); o = np.argsort(zz); PC[nm] = (zz[o], xx[o])
    def dx(row, z):
        nm = P["design_rows_x"].get(row)
        if nm not in PC: return None
        zz, xx = PC[nm]
        return float(np.interp(z, zz, xx)) if zz[0] - 1e-6 <= z <= zz[-1] + 1e-6 else None
    nr_path = os.path.join(os.path.dirname(out_prefix), P["nose_rows"]); NR = json.load(open(nr_path))["rows"] if os.path.exists(nr_path) else {}
    NRY = json.load(open(nr_path)).get("y_from_trace", {}) if os.path.exists(nr_path) else {}   # 26 October 2026
    def dy(row, z):
        nm = P["design_rows"].get(row)
        if nm not in DC: return None
        zz, yy = DC[nm]
        if zz[0] - 1e-6 <= z <= zz[-1] + 1e-6: return float(np.interp(z, zz, yy))
        # 25 October 2026: a row whose traced curve stops (shoulder lines end at the A pillar, z 0.72) continues on an
        # extension curve (fender top) shifted to meet it without a step ; before, the belt fell back to 1.06 m (S bump).
        ext = P.get("design_rows_ext", {}).get(row)
        if ext and ext in DC:
            ze, ye = DC[ext]
            if ze[0] - 1e-6 <= z <= ze[-1] + 1e-6:
                zj = zz[-1] if z > zz[-1] else zz[0]; yj = float(np.interp(zj, zz, yy))
                off = yj - float(np.interp(zj, ze, ye)) if ze[0] - 1e-6 <= zj <= ze[-1] + 1e-6 else 0.0
                return float(np.interp(z, ze, ye)) + off
        return None
    zs_p, ytop_p, hw_p = np.array(pr["z"]), np.array(pr["ytop"]), np.array(pr["hw"])
    Fy, Fv = np.array(pr["F_y"]), np.array(pr["F"])
    at = lambda arr, z: float(np.interp(-z, -zs_p, arr))            # profiles are sampled with z decreasing
    Fbv = np.array(pr.get("F_back", pr["F"]))
    zf, zb = m["keys"]["cowl"], m["keys"]["deck"]
    def Fat(y, z=None):
        # width by height from the nearest end view: front view ahead of the windshield, back view behind the rear
        # glass, linear blend in between (generic rule, 25 October 2026)
        a = float(np.interp(y, Fy, Fv)); b = float(np.interp(y, Fy, Fbv))
        if z is None: return a
        t = float(np.clip((zf - z) / max(zf - zb, 1e-6), 0, 1))
        return (1 - t) * a + t * b
    names = ["nose", "hood_lead", "cowl", "roof_front", "roof_rear", "deck", "tail"]
    st, tags = [], {}
    for a, b in zip(names[:-1], names[1:]):
        za, zb = m["keys"][a], m["keys"][b]; n = P["between"][a]
        for t in range(n):
            st.append(za + (zb - za) * t / n)
        tags[a] = za
    st.append(m["keys"]["tail"]); tags["tail"] = m["keys"]["tail"]
    r_arch = W["tyre_r"] * P["arch_pad"]
    for zc in (W["front_z"], W["rear_z"]):
        for f in P["arch_stations"]:
            for sgn in (-1, 1):
                st.append(zc + sgn * f * r_arch)
    st = np.array(sorted(set(np.round(st, 5)), reverse=True))
    st = np.concatenate([st, list(P["joints_z"].values())])
    st = np.array(sorted(set(np.round(st, 5)), reverse=True))
    st = st[(st <= m["keys"]["nose"]) & (st >= m["keys"]["tail"])]
    x_in_f = W["track_half"] - W["tyre_w"] / 2 - P["fender_gap"]
    x_in_r = W.get("track_half_rear", W["track_half"]) - W.get("tyre_w_rear", W["tyre_w"]) / 2 - P["fender_gap"]
    dz_any = lambda z: min(abs(z - W["front_z"]), abs(z - W["rear_z"])) > r_arch * 1.05
    # nose and tail: the extreme stations are pulled inside by end_inset (wide rounded ends), plus a flat end face
    L = m["keys"]["nose"] - m["keys"]["tail"]
    z_nose_in, z_tail_in = m["keys"]["nose"] - P["end_inset"] * L, m["keys"]["tail"] + P["end_inset"] * L
    st = np.clip(st, z_tail_in, z_nose_in); st = np.array(sorted(set(np.round(st, 5)), reverse=True))
    rings = []
    for z in st:
        yt, hw = at(ytop_p, z), at(hw_p, z)
        # underside: the sill line between the axles, the real profile in the overhangs (diffuser and splitter recess)
        overhang = z > W["front_z"] + r_arch or z < W["rear_z"] - r_arch
        yb = max(at(np.array(pr["ybot"]), z), 0.0) if overhang else m["floor_y"]
        yc = max(yb, m.get("floor_centre_y", yb) + P["floor_lift"]) if not overhang else yb      # floor centre above the skirts
        dz = min(abs(z - W["front_z"]), abs(z - W["rear_z"]))
        x_in = x_in_f if abs(z - W["front_z"]) < abs(z - W["rear_z"]) else x_in_r
        arch = W["tyre_r"] + np.sqrt(max(r_arch ** 2 - dz ** 2, 0.0)) if dz < r_arch else -1.0
        cabin = yt > m["belt_y"] + P["cabin_min"]
        yb_belt = min(m["belt_y"], yt - 0.02)
        y_sill = yb + P["sill_h"]
        rows = {}
        rows["floor_centre"] = (0.0, yc)
        rows["floor_edge"] = (min(x_in, hw * 0.95), yc)
        y_fi = max(arch, yb + 0.02)
        if arch < 0 and yc > yb + 0.005:   # skirt: lowest point under the sill, inside the tyre shadow
            x_sk = min(0.5 * (x_in + hw), hw * 0.97)
            rows["fender_inner"] = (x_sk, yb)
        else:
            rows["fender_inner"] = (min(x_in, hw * 0.95), min(y_fi, yt - 0.06))
        wF = lambda y: min(hw, max(Fat(y, z), 0.05))
        y_s = min(max(y_sill, arch), yt - 0.05)
        if dy("sill", z) is not None and arch < 0: y_s = dy("sill", z)
        rows["sill"] = (hw, y_s)
        y_dl = yb + P["door_low_frac"] * (yb_belt - yb)
        y_dl = min(max(y_dl, arch + 0.02 if arch > 0 else -1), yt - 0.04)
        if dy("door_low", z) is not None and arch < 0: y_dl = max(dy("door_low", z), y_s + 0.01)
        rows["door_low"] = (hw, y_dl)
        y_b = max(yb_belt, rows["door_low"][1] + 0.01)
        if dy("belt", z) is not None: y_b = max(min(dy("belt", z), yt - 0.03), rows["door_low"][1] + 0.01)
        rows["belt"] = (wF(y_b) * 0.985, y_b)
        # belt_top: the upper line of the shoulder band (side y, plan x), between the belt and the glass (25 October 2026)
        ybt = dy("belt_top", z); ybt = y_b + 0.012 if ybt is None else min(max(ybt, y_b + 0.004), yt - 0.02)
        xbt = dx("belt_top", z); xbt = wF(ybt) * 0.96 if xbt is None else min(xbt, hw)
        rows["belt_top"] = (xbt, ybt)
        if cabin:
            yg = yb_belt + 0.03; yr = yt - P["roof_edge_drop"]
            if dy("glass_base", z) is not None: yg = max(dy("glass_base", z), y_b + 0.005)
            if dy("roof_edge", z) is not None: yr = min(max(dy("roof_edge", z), yg + 0.02), yt - 0.005)
            yg = max(yg, ybt + 0.004)
