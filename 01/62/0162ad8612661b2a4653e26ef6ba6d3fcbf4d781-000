    V = np.concatenate([end_face(V[0], m["keys"]["nose"])[None], V, end_face(V[-1], m["keys"]["tail"])[None]])
    st = np.concatenate([[m["keys"]["nose"]], st, [m["keys"]["tail"]]])
    # TAIL SUPPORT LOOP (25 October 2026): the subdivision rounded the tall vertical tail face 10 to 19 cm short in the
    # side view ; a copy of the tail end face moved tail_support_m inward holds the face flat to its full height.
    ts = P.get("tail_support_m", 0.0)
    if ts > 0:
        sup = V[-1].copy(); sup[:, 2] += ts
        V = np.concatenate([V[:-1], sup[None], V[-1:]]); st = np.concatenate([st[:-1], [st[-1] + ts], st[-1:]])
