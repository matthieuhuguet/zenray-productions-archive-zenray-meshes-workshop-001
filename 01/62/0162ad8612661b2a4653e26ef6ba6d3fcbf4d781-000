            w = np.ones(keep.sum()); w[0] = w[-1] = CF["end_weight"]
            for a in (0, 1):
                fv = pfit(st[keep], V[keep, j, a], w, st[keep]); V[keep, j, a] = (1 - CF.get("amount", 1.0)) * V[keep, j, a] + CF.get("amount", 1.0) * fv
    # SLANTED JOINTS (25 October 2026): a joint station follows its traced side curve, z by height (the rear door cut is a
    # diagonal on the sheet, 22 cm from belt to sill) ; points outside the curve's heights keep the end values.
    for jn, cn in P.get("joint_curves", {}).items():
        cl = cn if isinstance(cn, list) else [cn]   # several traced curves concatenated by height (door cut, then B pillar)
        if jn in P.get("joint_points", {}):         # explicit [z, y] points (mean of the left and right views) win
            jp = np.array(P["joint_points"][jn]); zz_, yy_ = jp[:, 0], jp[:, 1]
        elif any(c_ not in DC for c_ in cl) or jn not in P["joints_z"]: continue
