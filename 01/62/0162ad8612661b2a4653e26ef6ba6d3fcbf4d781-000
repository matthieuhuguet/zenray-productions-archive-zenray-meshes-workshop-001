    # carries a width factor, a roof offset and (end faces) a length offset learned by CageComp.py from the subdivided
    # surface against the measured profiles; the rules stay the same, only the cage moves out to where the limit
    # surface must land. FR : la cage est poussée pour que la surface subdivisée tombe sur les profils mesurés.
    cpath = os.path.join(os.path.dirname(out_prefix), "cage_comp.json")
    if os.environ.get("ZRM_NO_COMP"):   # 25 October 2026: row loft body, no subdivision so no limit surface compensation
        cpath = cpath.replace("cage_comp.json", "cage_comp_loft.json"); P["plan_clamp"] = float(os.environ.get("ZRM_PLAN_CLAMP", "1.0"))   # the loft learns its own compensation (LOFT=1 CageComp.py)
    if os.path.exists(cpath):
