# 28 October 2026: Build candidate delivery_v606
# Rear Diffuser Welds, Valance Flare & Rocker Flange (Candidate v606):
# 1. Rear Diffuser Hermetic Welds (38 Vertices at 0.00 mm):
#    - Welds 38 boundary contact vertices of CAR_diffuser_rear_C to CAR_body_tail_face_C
#      (< 7.0 mm gap sealed to 0.00 mm)
#    - Hermetically closes the open slot above the aerodynamic diffuser with 0 cracks
# 2. Rear Valance Lower Corner Outer Flare (+12.0 mm):
#    - Expands outer perimeter vertices of CAR_body_tail_face_C, CAR_body_bumper_rear_C,
#      and CAR_vent_rear_L/R (Y in [0.20, 0.40 m], Z < -1.95 m, |X| > 0.65 m) by +12.0 mm
#    - Lifts Bottom view IoU to a record 0.9747 (+2 points)
# 3. Rocker Sill Flange Subtle Widening (+5.5 mm):
#    - Calibrates the outer longitudinal sill edge of CAR_body_rocker_L and CAR_body_rocker_R
#      (Y in [0.20, 0.40 m], |X| > 1.02 m) by +5.5 mm outward
#    - Fills the 3 to 4 pixel deficit in rows 270-280 of Back view, lifting Back IoU to 0.9446
# 4. Shattering Record Mean SheetScore IoU: 0.9703
#    - Front: 0.9777
#    - Left: 0.9758
#    - Bottom: 0.9747
#    - Top: 0.9746
#    - Right: 0.9742
#    - Back: 0.9446
#    - Mean IoU: 0.9703 (0.970267)
# 5. Strict Topology & AnimReview Verification:
#    - 100.000% pure quads (90,269 pure quads, 0 tris, 0 ngons, 0 non-manifold edges, 0 cracks)
#    - All 21 AnimReview gates passed (all_pass=True)
#    - Centerline vertices (|X| < 3.0 mm) snapped to X = 0.000 mm

import os, sys, json
import numpy as np
from scipy.spatial import cKDTree
from scipy import ndimage as ndi
from PIL import Image

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import Raster, SheetScore, TopoCheck as TC
from AnimReview import load_review_params, review

def build_v606():
    base_dir = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
    base_npz = os.path.join(base_dir, "work/car/delivery_v605.npz")

    d = np.load(base_npz, allow_pickle=True)
    P = d["P"].astype(float).copy()
    Q_ = [list(map(int, q)) for q in d["Q"]]
    names = list(d["names"])
    names_arr = np.array(names)

    print(f"Loaded v605 base: {len(P)} vertices, {len(Q_)} quads.")

    # 1. Rear Diffuser Hermetic Welds (38 contact vertices)
    q_tf = np.array(Q_)[names_arr == "CAR_body_tail_face_C"]
    v_tf = np.unique(q_tf).astype(int)
    tree_tf = cKDTree(P[v_tf])

    q_diff = np.array(Q_)[names_arr == "CAR_diffuser_rear_C"]
    v_diff = np.unique(q_diff).astype(int)

    diff_welds = 0
    for vi in v_diff:
        dist, target_idx = tree_tf.query(P[vi])
        if dist < 0.0070: # within 7.0 mm
            P[vi] = P[v_tf[target_idx]]
            diff_welds += 1
    print(f"Rear diffuser: welded {diff_welds} contact vertices to tail face at 0.00 mm.")

    # 2. Rear Valance Lower Corner Outer Flare (+12.0 mm)
    rear_lower_parts = [
        "CAR_body_tail_face_C", "CAR_body_bumper_rear_C", "CAR_diffuser_rear_C",
        "CAR_vent_rear_L", "CAR_vent_rear_R"
    ]
    valance_pts = 0
    for p_name in rear_lower_parts:
        q_mask = (names_arr == p_name)
        v_idx = np.unique(np.array(Q_)[q_mask]).astype(int)
        for vi in v_idx:
            x = P[vi, 0]
            y = P[vi, 1]
            z = P[vi, 2]
            if 0.20 <= y <= 0.40 and z < -1.95 and abs(x) > 0.65:
                w_y = np.sin((y - 0.20) / (0.40 - 0.20) * np.pi)
                w_x = np.clip((abs(x) - 0.65) / (0.95 - 0.65), 0.0, 1.0)
                P[vi, 0] += np.sign(x) * 0.0120 * w_y * w_x
                valance_pts += 1
    print(f"Rear valance: flared {valance_pts} outer corner vertices by +12.0 mm.")

    # 3. Rocker Sill Flange Subtle Widening (+5.5 mm)
    rocker_parts = ["CAR_body_rocker_L", "CAR_body_rocker_R"]
    rocker_pts = 0
    for p_name in rocker_parts:
        q_mask = (names_arr == p_name)
        v_idx = np.unique(np.array(Q_)[q_mask]).astype(int)
        for vi in v_idx:
            x = P[vi, 0]
            y = P[vi, 1]
            z = P[vi, 2]
            if 0.20 <= y <= 0.40 and abs(x) > 1.02:
                w_y = np.sin((y - 0.20) / (0.40 - 0.20) * np.pi)
                w_x = np.clip((abs(x) - 1.02) / (1.12 - 1.02), 0.0, 1.0)
                P[vi, 0] += np.sign(x) * 0.0055 * w_y * w_x
                rocker_pts += 1
    print(f"Rocker sills: widened {rocker_pts} outer flange vertices by +5.5 mm.")

    # 4. Centerline symmetry
    center_pts = np.where(np.abs(P[:, 0]) < 0.003)[0]
    P[center_pts, 0] = 0.0
    print(f"Centerline: snapped {len(center_pts)} vertices to X=0.000 mm.")

    # 5. Save delivery_v606.npz and export OBJ
    out_npz = os.path.join(base_dir, "work/car/delivery_v606.npz")
    out_obj = os.path.join(base_dir, "versions/ZenRayCar_v606.obj")
    Q_arr = np.array(Q_, dtype=object)
    np.savez_compressed(out_npz, P=P, Q=Q_arr, names=names_arr)
    print(f"Saved {out_npz}")

    with open(out_obj, "w") as f:
        f.write("# ZenRayCar_v606 (28 October 2026)\n")
        f.write(f"# Pure quads: {len(Q_)}, Vertices: {len(P)}\n")
        for v in P:
            f.write(f"v {v[0]:.6f} {v[1]:.6f} {v[2]:.6f}\n")
        curr_g = None
        for q, n in zip(Q_, names):
            if n != curr_g:
                curr_g = n
                f.write(f"g {curr_g}\n")
            f.write(f"f {q[0]+1} {q[1]+1} {q[2]+1} {q[3]+1}\n")
    print(f"Saved {out_obj}")

    # 6. Run AnimReview
    prm = load_review_params(os.path.join(base_dir, "work/car/trim_params.json"))
    topo_prm = TC.load_params(os.path.join(base_dir, "work/car/trim_params.json"))
    wheels = json.load(open(os.path.join(base_dir, "work/car/wheel_params.json")))

    Nc, Tc = np.unique(names_arr, return_inverse=True)
    Pc, Cc, Ic = P, np.array([len(q) for q in Q_], np.int32), np.array([v for q in Q_ for v in q], np.int32)
    rep = review(Pc, Cc, Ic, Tc, Nc, wheels, prm, topo_prm)
    audit_path = os.path.join(base_dir, "versions/Audit_v606.json")
    json.dump(rep, open(audit_path, "w"), indent=2)
    print(f"AnimReview: passed {rep['passed']} / {rep['total']}, all_pass={rep['all_pass']}")
    for g in rep["gates"]:
        if not g["ok"]:
            print("  FAILED GATE:", g)

    # 7. Run SheetScore
    fdir = os.path.join(base_dir, "work/car/frame/")
    meta = json.load(open(fdir + "frame.json"))

    faces_tri = []
    for q in Q_:
        faces_tri.append([q[0], q[1], q[2]])
        faces_tri.append([q[0], q[2], q[3]])
    faces_tri = np.array(faces_tri, dtype=np.int32)

    mr = Raster.Renderer(P, faces_tri)
    sheet_scores = {}
    for v in meta["views"]:
        vname = v["name"]
        mref = np.asarray(Image.open(os.path.join(fdir, f"mask_{vname}.png"))) > 127
        M, _ = SheetScore.render_in_panel(mr, meta, v, mref.shape)
        M = ndi.binary_fill_holes(M)
        inter = (M & mref).sum()
        union = (M | mref).sum()
        sheet_scores[vname] = round(float(inter / max(union, 1)), 4)
    print("SheetScore IoU:", sheet_scores)
    mean_iou = round(float(np.mean(list(sheet_scores.values()))), 4)
    print("Mean SheetScore IoU:", mean_iou)

    # 8. Run WireframeScoreRef3
    from WireframeScoreRef3 import compute_wireframe_score_ref3
    wf_scores = compute_wireframe_score_ref3(out_npz)
    mean_rec = np.mean([val["rec"] for val in wf_scores.values()])
    mean_prec = np.mean([val["prec"] for val in wf_scores.values()])
    mean_f1 = np.mean([val["f1"] for val in wf_scores.values()])
    print(f"Wireframe Recall ref3: mean={mean_rec*100:.2f}%, prec={mean_prec*100:.2f}%, f1={mean_f1:.4f}")

    return rep["all_pass"], mean_iou, mean_rec

if __name__ == "__main__":
    ok, iou, rec = build_v606()
    if not ok:
        sys.exit(1)
