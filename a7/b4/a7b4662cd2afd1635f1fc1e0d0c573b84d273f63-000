"""30 October 2026 : QUADWILD RECIPE and its SWEEP : the configuration of QuadWild Bi-MDF that gave the best hard surface result on the arch (QuadWild mechanical), run with density control and judged, and the same run over a grid of settings.
RECIPE (QuadWild mechanical) : step 1 `quadwild mesh.obj 2 prep.txt` with prep.txt = `do_remesh 1 / sharp_feature_thr 35 / alpha 0.01 / scaleFact 1` ; e0 = mean edge of `mesh_rem_p0.obj` ; step 2 `quad_from_patches mesh_rem_p0.obj 123 main.txt` with main.txt = `config/main_config/flow_noalign_lemon.txt` where `scaleFact` = target edge / e0 (and `alpha` of the flow, 0.005 by default) ; both run from the root of tools/quadwild-bimdf ; output `mesh_rem_p0_123_quadrangulation_smooth.obj`. Organic : `sharp_feature_thr -1`.
    python -I QwSweep.py mesh.obj out_dir target_quads out.json "thr,alpha,flow" ["thr,alpha,flow" ...]     (flow = lemon or approx_mst)
FR : la recette de QuadWild mechanical et son balayage de reglages, jugee a densite controlee."""
import json, os, shutil, subprocess, sys
from concurrent.futures import ProcessPoolExecutor
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import QwParts as QP, ZrlTopoJudge as TJ
QW = QP.QW; KEYS = ("quads", "folded_share", "squashed_share", "jac_mean", "angle_dev_mean_deg", "straight_dev_mean_deg", "straight_dev_p90_deg", "poles_per_1000_quads", "boundary_edges", "symmetry_axis", "symmetry_mean_edge", "dev_mean_mm")


def write_sharp(obj, path, deg):
    """30 October 2026 : the creases of a FINISHED triangle mesh given to QuadWild as a .sharp file (count, then convex,face,edge per line ; idea and format of the car session, QwCreases.py) : the grid follows the creases where the angle threshold guesses on a blurred surface. Returns the number of sharp edges."""
    import collections as C
    import numpy as np
    V = []; F = []
    for l in open(obj):
        if l.startswith("v "): V.append([float(x) for x in l.split()[1:4]])
        elif l.startswith("f "): F.append([int(x.split("/")[0]) - 1 for x in l.split()[1:]])
    V = np.array(V); F = np.array(F); n = np.cross(V[F[:, 1]] - V[F[:, 0]], V[F[:, 2]] - V[F[:, 0]]); n /= np.maximum(np.linalg.norm(n, axis=1, keepdims=True), 1e-30); Cc = V[F].mean(1); ef = C.defaultdict(list)
    for fi, f in enumerate(F):
        for k in range(3): u, w = int(f[k]), int(f[(k + 1) % 3]); ef[(min(u, w), max(u, w))].append((fi, k))
    cosf = np.cos(np.radians(deg)); rows = []
    for e, l in ef.items():
        if len(l) != 2: continue
        (f1, k1), (f2, k2) = l
        if float(n[f1] @ n[f2]) < cosf: rows.append((1 if float(n[f2] @ (Cc[f1] - Cc[f2])) < 0 else 0, f1, k1))
    with open(path, "w") as f:
        f.write("%d\n" % len(rows)); f.write("".join("%d,%d,%d\n" % r for r in rows))
    return len(rows)


def one(args):
    src, work, ref, target, thr, alpha, flow, name = args; d = os.path.join(work, name); os.makedirs(d, exist_ok=True); shutil.copy(src, os.path.join(d, "part.obj")); part = os.path.join(d, "part.obj"); edge = (QP.area_of(part) / target) ** 0.5
    prep = os.path.join(d, "prep.txt"); open(prep, "w").write("do_remesh 1\nsharp_feature_thr %s\nalpha 0.01\nscaleFact 1\n" % thr)
    try:
        sd = float(os.environ.get("QW_SHARP_DEG", "0")); sharp = []
        if sd > 0: sp = os.path.join(d, "part.sharp"); write_sharp(part, sp, sd); sharp = [sp]
        r0 = subprocess.run([f"{QW}/build/Build/bin/quadwild", part, "2", prep] + sharp, capture_output=True, text=True, timeout=900, cwd=QW); rem = os.path.join(d, "part_rem_p0.obj")
        if not os.path.exists(rem): return name, {"error": "no remesh", "rc": r0.returncode, "tail": (r0.stdout + r0.stderr)[-400:]}
        e0 = QP.mean_edge(rem); sf = edge / e0; tgt = target; cands = []; flowfile = f"{QW}/config/main_config/flow_noalign_{flow}.txt"; best = None
        for attempt in range(3):
            txt = open(flowfile).read().replace("scaleFact 1", "scaleFact %.5f" % sf).replace("alpha 0.005", "alpha %s" % alpha); cfg = os.path.join(d, "main.txt"); open(cfg, "w").write(txt); outp = os.path.join(d, "part_rem_p0_123_quadrangulation_smooth.obj")
            if os.path.exists(outp): os.remove(outp)
            subprocess.run([f"{QW}/build/Build/bin/quad_from_patches", rem, "123", cfg], capture_output=True, text=True, timeout=900, cwd=QW)
            rawq = outp.replace("_smooth", "")
            if not os.path.exists(outp) and os.path.exists(rawq): shutil.copy(rawq, outp)      # 30 October 2026 : QuadWild's smoothing step crashes on some tiny sheets while the raw quadrangulation exists : use the raw quads (the layout barrier smooths them afterwards)
            if not os.path.exists(outp): break
            n = sum(1 for l in open(outp) if l.startswith("f ")); keep = outp[:-4] + "_att%d.obj" % attempt; shutil.copy(outp, keep); cands.append((abs(n / tgt - 1), attempt, n, keep)); best = min(cands)[2:]      # 30 October 2026 : the attempt closest to the target density wins, not the last one (thin tiny sheets lost area on the last attempt) ; : a later attempt removes outp and may fail : keep a copy of every attempt that produced quads
            if abs(n / tgt - 1) <= 0.08: break
            sf = sf * (n / tgt) ** 0.5
        if not best: return name, {"error": "no quads"}
        j = TJ.judge(best[1], ref); r = {k: j.get(k) for k in KEYS}; r.update({"quads_vs_target": round(best[0] / target, 3), "file": best[1], "thr": thr, "alpha": alpha, "flow": flow}); return name, r
    except subprocess.TimeoutExpired: return name, {"error": "timeout"}
    except Exception as ex: return name, {"error": "exception %s" % repr(ex)[:200]}


def main():
    src, out, target, out_json = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2]), int(sys.argv[3]), sys.argv[4]; ref = os.environ.get("QW_REF", src); jobs = []
    os.makedirs(out, exist_ok=True)
    for spec in sys.argv[5:]:
        thr, alpha, flow = spec.split(","); jobs.append((src, out, ref, target, thr, alpha, flow, "t%s_a%s_%s" % (thr, alpha, flow)))
    res = {}
    with ProcessPoolExecutor(int(os.environ.get("QW_WORKERS", "6"))) as ex:
        for name, r in ex.map(one, jobs): res[name] = r; json.dump(res, open(out_json, "w"), indent=1); print(name, {k: r.get(k) for k in ("quads_vs_target", "folded_share", "squashed_share", "angle_dev_mean_deg", "straight_dev_mean_deg", "error")}, flush=True)


if __name__ == "__main__": main()
