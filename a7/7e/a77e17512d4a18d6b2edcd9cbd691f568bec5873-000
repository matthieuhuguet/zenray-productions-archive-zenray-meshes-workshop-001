"""30 October 2026 : ZenRay Lines TUNE BODY : build, mesh and measure several named variants of the body parameters at once (in parallel), and print for each : unmeshed faces, folded and squashed quads, the mean edge length of every region of the body.
    python -I ZrlTuneBody.py model.obj variants.json [--workers 4] [--edge 0.02]      variants.json : {"A": {"trunk_edge_scale": 0.8, ...}, "B": {...}}
FR : plusieurs variantes de paramètres du corps construites et mesurées en parallèle (un fichier, pas l'entrée standard : multiprocessing relance le module principal)."""
import argparse, json, os, sys
from multiprocessing import Pool
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import ZrlTuneJunction as TJ


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("obj"); ap.add_argument("variants"); ap.add_argument("--workers", type=int, default=4); ap.add_argument("--edge", type=float, default=0.02); ap.add_argument("--base", default="{}", help="json of parameters common to all variants"); a = ap.parse_args()
    obj = os.path.abspath(a.obj); V = json.load(open(a.variants)); base = json.loads(a.base); names = list(V); tasks = [(obj, dict(base, **V[k]), a.edge) for k in names]
    with Pool(a.workers) as p: res = p.map(TJ.evaluate, tasks, chunksize=1)
    for k, r in zip(names, res): print(k, json.dumps(r))


if __name__ == "__main__":
    main()
