import sys
from collections import defaultdict
import numpy as np

def clean_fender(p, faces):
    edge_to_face = defaultdict(list)
    for idx, f in enumerate(faces):
        for a, b in zip(f, f[1:] + f[:1]):
            edge = tuple(sorted((a, b)))
            edge_to_face[edge].append(idx)

    tri_indices = [idx for idx, f in enumerate(faces) if len(f) == 3]

    remap = {}
    for idx in tri_indices:
        f = faces[idx]
        b_edges = []
        for a, b in zip(f, f[1:] + f[:1]):
            edge = tuple(sorted((a, b)))
            if len(edge_to_face[edge]) == 1:
                b_edges.append((a, b))
        if b_edges:
            a, b = b_edges[0]
            while a in remap: a = remap[a]
            while b in remap: b = remap[b]
            if a != b:
                remap[b] = a

    def get_mapped(v):
        while v in remap: v = remap[v]
        return v

    new_faces = []
    for f in faces:
        mapped = []
        for v in f:
            v_m = get_mapped(v)
            if not mapped or v_m != mapped[-1]:
                mapped.append(v_m)
        if len(mapped) > 1 and mapped[0] == mapped[-1]:
            mapped.pop()
        if len(mapped) == 4:
            new_faces.append(mapped)

    used = sorted(set(v for f in new_faces for v in f))
    idx_map = {old: new for new, old in enumerate(used)}
    clean_pts = p[used]
    clean_quads = [[idx_map[v] for v in f] for f in new_faces]
    return clean_pts, clean_quads
