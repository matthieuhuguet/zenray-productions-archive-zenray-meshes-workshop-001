        if p0 is not None: c[0] = p0
        if p1 is not None: c[-1] = p1
        sp = type(sp)(t, c, 3)
        if not np.isfinite(c).all() or (c < lo - margin).any() or (c > hi + margin).any(): continue      # 1 November 2026 : control points far from the data mean a wild curve. FR : des points de contrôle loin des données veulent dire une courbe folle.
