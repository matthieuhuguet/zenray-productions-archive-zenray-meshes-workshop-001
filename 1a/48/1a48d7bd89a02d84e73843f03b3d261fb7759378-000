            ids, cnt = np.unique(v, return_counts=True); out[y0:y1, x0:x1][c] = ids[cnt.argmax()]; n_done += 1
    return out, n_done


def end_dir(q, reach):
    """the outward direction of a chain at its first point"""
    s = chord(q); k = min(int(np.searchsorted(s, reach)), len(q) - 1); return q[k] - q[0]


def build_strokes(pieces, a, sc):
    """two pieces that arrive at a node in line are one stroke, like an edge flow of ZenRay Lines : at each node the most opposite pair is joined while it stays within the angle"""
    reach = a["A_tangent_px"] * sc; at = {}; lim = np.cos(np.radians(180.0 - a["A_stroke_deg"]))
    for k, pc in enumerate(pieces):
