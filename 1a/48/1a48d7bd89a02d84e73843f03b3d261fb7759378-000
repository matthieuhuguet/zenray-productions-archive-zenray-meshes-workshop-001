    n = np.array([-d[1], d[0]]) / L; return p0, p1, wquantile(np.abs((q - p0) @ n), w)


def fit_spline(q, w, p0, p1, tol, max_ctrl):
    """a clamped cubic B-spline with as few control points as the tolerance allows ; the ends are held by a large weight, then set exactly"""
    s = chord(q); keep = np.r_[True, np.diff(s) > 1e-6]; q, w, s = q[keep], w[keep], s[keep]
    if len(q) < 8 or s[-1] < 1e-6: return None
