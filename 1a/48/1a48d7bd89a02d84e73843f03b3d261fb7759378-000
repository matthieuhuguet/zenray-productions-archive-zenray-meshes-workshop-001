def clean_islands(lab, a, sc):
    """a tiny island of a label that lives elsewhere is noise, and it chops a long border into pieces : it joins what surrounds it ; a small piece that is whole keeps its place"""
    thr = (a["A_island_px"] * sc) ** 2; out = lab.copy(); H, W = lab.shape; n_done = 0
    for i in np.unique(lab).tolist():
