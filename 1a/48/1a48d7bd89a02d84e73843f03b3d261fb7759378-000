        for c, i, j in sorted(pairs):
            if c > lim or i in used or j in used: continue
            used.update((i, j)); mate[(lst[i][0], lst[i][1])] = (lst[j][0], lst[j][1]); mate[(lst[j][0], lst[j][1])] = (lst[i][0], lst[i][1])
