def trace(lab):
    """the borders of a label image as chains of crack midpoints between junctions, in lattice coordinates (pixel i covers i to i + 1)"""
    H, W = lab.shape; P = np.pad(lab, 1, constant_values=-1); K = W + 3; adj = {}

    def link(a, b): adj.setdefault(a, []).append(b); adj.setdefault(b, []).append(a)
    ys, xs = np.nonzero(P[:, 1:] != P[:, :-1])
    for y, x in zip(ys.tolist(), xs.tolist()): link(y * K + x + 1, (y + 1) * K + x + 1)
    ys, xs = np.nonzero(P[1:, :] != P[:-1, :])
    for y, x in zip(ys.tolist(), xs.tolist()): link((y + 1) * K + x, (y + 1) * K + x + 1)
