def midpoints(q):
    """a staircase of cracks gives a much calmer chain through its midpoints, the two ends stay"""
    return np.vstack([q[:1], (q[1:] + q[:-1]) / 2, q[-1:]]) if len(q) > 2 else q


def chord(q):
    s = np.r_[0.0, np.cumsum(np.linalg.norm(np.diff(q, axis=0), axis=1))]; return s


def corners(q, win, deg):
    """indices where the direction turns sharply between the two chords of a window : maxima only, one per window"""
    s = chord(q); n = len(q)
    if n < 5 or s[-1] < 2 * win: return []
    a = np.searchsorted(s, s - win); b = np.minimum(np.searchsorted(s, s + win), n - 1); u = q - q[np.clip(a, 0, n - 1)]; v = q[b] - q; dot = (u * v).sum(1); cr = u[:, 0] * v[:, 1] - u[:, 1] * v[:, 0]; ang = np.degrees(np.abs(np.arctan2(cr, dot))); ang[(s < win) | (s > s[-1] - win)] = 0; out = []
    for i in np.argsort(-ang):
        if ang[i] < deg: break
        if all(abs(s[i] - s[j]) >= win for j in out): out.append(int(i))
    return sorted(out)


def wquantile(e, w, f=0.95):
    o = np.argsort(e); c = np.cumsum(w[o]); return float(e[o][np.searchsorted(c, f * c[-1])]) if len(e) else 0.0


def fit_line(q, w, p0=None, p1=None):
    """a straight line, through its two ends when they are given, else the best one by its weights : returns its ends and its error"""
