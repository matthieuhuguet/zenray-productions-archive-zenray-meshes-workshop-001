def sample(piece, step=0.5):
    """points along a fitted piece, about step apart"""
    if piece["kind"] == "multi": return np.vstack([sample(x, step) if k == 0 else sample(x, step)[1:] for k, x in enumerate(piece["parts"])])
    if piece["kind"] == "line":
        a, b = piece["p0"], piece["p1"]; n = max(int(np.linalg.norm(b - a) / step), 1); return a + (b - a) * np.linspace(0, 1, n + 1)[:, None]
    n = max(int(piece["len"] / step), 8); return piece["sp"](np.linspace(0, 1, n + 1))


