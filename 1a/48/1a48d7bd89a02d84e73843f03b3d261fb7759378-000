def draw(strokes, links, shape):
    """the curves as an 8 connected wall, which a 4 connected region cannot cross ; links close the tiny gaps where a stroke stops on another"""
    H, W = shape; wall = np.zeros(shape, bool)

    def put(c):
        iy, ix = np.clip(np.floor(c[:, 0]).astype(int), 0, H - 1), np.clip(np.floor(c[:, 1]).astype(int), 0, W - 1)
        for k in range(len(c) - 1):
            if abs(iy[k + 1] - iy[k]) > 1 or abs(ix[k + 1] - ix[k]) > 1: r, s_ = draw_line(iy[k], ix[k], iy[k + 1], ix[k + 1]); wall[r, s_] = True
        wall[iy, ix] = True
    for st in strokes: put(sample(st["fit"], step=0.5))
    for u, v in links: put(np.array([u, v]))
    return wall


