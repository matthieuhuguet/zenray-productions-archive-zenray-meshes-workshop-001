        for i in range(len(lst)):
            for j in range(i + 1, len(lst)):
                u, v = lst[i][2], lst[j][2]; L = np.linalg.norm(u) * np.linalg.norm(v)
                if L > 1e-6 and lst[i][0] != lst[j][0]: pairs.append((float(u @ v / L), i, j))
