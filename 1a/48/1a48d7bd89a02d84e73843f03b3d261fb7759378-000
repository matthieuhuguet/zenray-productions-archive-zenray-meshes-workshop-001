        if n < 2: continue
        sz = np.bincount(cc.ravel())[1:]; big = int(sz.argmax())
        for k, sl in enumerate(ndi.find_objects(cc)):
            if k == big or sz[k] >= thr: continue
            y0, y1, x0, x1 = max(sl[0].start - 2, 0), min(sl[0].stop + 2, H), max(sl[1].start - 2, 0), min(sl[1].stop + 2, W); c = cc[y0:y1, x0:x1] == k + 1; ring = ndi.binary_dilation(c, iterations=2) & ~c; v = out[y0:y1, x0:x1][ring]
