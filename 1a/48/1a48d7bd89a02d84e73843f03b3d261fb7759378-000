    def walk(a, b):
        path = [a, b]; seen.add((a, b)); seen.add((b, a))
        while path[-1] not in junction:
            n = path[-1]; c = adj[n][0] if adj[n][1] == path[-2] else adj[n][1]
            if (n, c) in seen: break
            seen.add((n, c)); seen.add((c, n)); path.append(c)
            if c == path[0]: break
        return path
    for j in junction:
        for b in adj[j]:
            if (j, b) not in seen: arcs.append(walk(j, b))
    for a in adj:
        for b in adj[a]:
            if (a, b) not in seen: arcs.append(walk(a, b))
    out = []
    for path in arcs:
        q = np.array([(n // K - 1, n % K - 1) for n in path], np.float64); out.append(dict(nodes=q, start=path[0], end=path[-1], closed=path[0] == path[-1]))
