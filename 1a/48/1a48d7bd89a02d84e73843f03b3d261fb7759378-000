def finish_views(labels, p, home, sc):
    """all the views, in parallel on the CPU ; writes arcs_<view>.json"""
    a = {k: p.get(k, v) for k, v in DEF.items()}
    if not a["A_on"]: return labels, {}
    jobs = []
    for name in p["views"]:
        D = np.load(f"{home}/02_masks/regions_{name}.npz"); E = D["edges"].astype(np.float32) / 255
        if "edges_raw" in D: E = np.maximum(E, D["edges_raw"].astype(np.float32) / 255)
        jobs.append((labels[name], E, a, sc, name))
    out = dict(labels); stats = {}
    with ProcessPoolExecutor(int(a["A_workers"])) as ex:
        for name, new, doc, st in ex.map(finish_view, jobs): out[name] = new; stats[name] = st; json.dump(dict(view=name, unit="panel pixels", pieces=doc), open(f"{home}/02_masks/arcs_{name}.json", "w"))
    return out, stats


def selftest():
    """a border with noisy steps : it must come back straight and on the line of the image ; a curve with no line must stay a curve ; a closed stroke must stay closed"""
    a = dict(DEF, A_snap_on=1, A_free_tol_px=1.0); sc = 3; H = W = 300; yy, xx = np.mgrid[:H, :W]; rng = np.random.default_rng(1); noise = ndi.gaussian_filter(rng.normal(size=(H, W)), 2) * 12; lab = ((xx + noise) > 152).astype(np.int32); E = np.zeros((H, W), np.float32); E[:, 150] = 1; E = ndi.gaussian_filter(E, 1); E /= E.max(); _, new, doc, st = finish_view((lab, E, a, sc, "t")); edge = lambda L: (L[20:-20] > 0).argmax(1)
    wob0, wob1 = float(edge(lab).std()), float(edge(new).std()); where = float(edge(new).mean()); circ = ((yy - 150) ** 2 + (xx - 150) ** 2) < 100 ** 2; lab2 = np.where(circ, 0, -1).astype(np.int32); _, new2, doc2, st2 = finish_view((lab2, np.zeros((H, W), np.float32), a, sc, "c")); iou2 = float(((new2 >= 0) & circ).sum() / ((new2 >= 0) | circ).sum())
    ok = wob1 < 0.2 * wob0 and abs(where - 150.5) <= 1.0 and st["straight_share"] > 0.95 and st2["straight_share"] < 0.2 and iou2 > 0.98; print(json.dumps(dict(wobble_before=round(wob0, 2), wobble_after=round(wob1, 2), line_at=round(where, 2), straight=st["straight_share"], circle_straight=st2["straight_share"], circle_iou=round(iou2, 4), ok=ok))); sys.exit(0 if ok else 1)


