"""30 October 2026 : baseline of the Houdini Quad Remesh SOP on any OBJ, for the any-mesh comparison (run with hython).
    hython HouQuadBench.py in.obj out.obj target_quads [symmetry_axis 0|1|2 or -1]
FR : reference du SOP Quad Remesh de Houdini, comparee a ZenRay Retopology avec le meme juge (ZrlTopoJudge.py)."""
import sys, hou
src, out, target = sys.argv[1], sys.argv[2], int(sys.argv[3])
g = hou.node("/obj").createNode("geo", "bench")
for c in g.children(): c.destroy()
f = g.createNode("file"); f.parm("file").set(src)
q = g.createNode("quadremesh"); q.setInput(0, f); q.parm("targetquadcount").set(target)
q.cook(force=True); geo = q.geometry(); geo.saveToFile(out); print("saved", out, "prims", len(geo.prims()))
