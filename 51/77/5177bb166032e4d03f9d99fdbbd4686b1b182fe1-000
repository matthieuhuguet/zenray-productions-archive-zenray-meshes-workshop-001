#!/bin/zsh
# 1 November 2026 : M22, from a cut sheet painted by ChatGPT Images to the gallery of sheets, in one command. FR : de la planche de découpe peinte par ChatGPT Images à la galerie de feuilles, en une commande.
# Usage : zsh Scripts/micro/MicroCutAll.sh Projects/<id>/params.json ["note of the version"]
set -e
cd /Users/zenray/.claude/tmp/tmp-zenray-meshes
PY=/Users/zenray/.venvs/zenray-meshes/bin/python
P=$1
if [ ! -f $(dirname $P)/02_masks/regions_top.npz ]; then $PY -I Scripts/micro/MicroRegions.py $P | tail -1; fi     # only the lines of the reference, to measure how well the cut lies on them
$PY -I Scripts/micro/MicroCutRead.py $P
$PY -I Scripts/micro/MicroLegend.py $P
$PY -I Scripts/micro/MicroOutline.py $P board
find $(dirname $P)/03_sheets -maxdepth 1 -name "S*" -delete
$PY -I Scripts/micro/MicroSheets.py $P | tail -1
$PY -I Scripts/micro/MicroSelfTest.py $P || echo "some lines must be checked, see 06_checks/selftest.json"
if [ -n "$2" ]; then $PY -I Scripts/micro/MicroVersions.py $P snapshot "$2"; fi
$PY -I Scripts/micro/MicroDoc.py $P
