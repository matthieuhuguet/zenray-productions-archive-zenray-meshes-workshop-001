#!/bin/zsh
# 1 November 2026 : M22, from a cut sheet painted by ChatGPT Images to the gallery of sheets, in one command. FR : de la planche de découpe peinte par ChatGPT Images à la galerie de feuilles, en une commande.
# Usage : zsh Scripts/micro/MicroCutAll.sh Projects/<id>/params.json ["note of the version"]
set -e
cd /Users/zenray/.claude/tmp/tmp-zenray-meshes
PY=/Users/zenray/.venvs/zenray-meshes/bin/python
P=$1
if [ ! -f $(dirname $P)/02_masks/regions_top.npz ]; then $PY -I Scripts/micro/MicroRegions.py $P | tail -1; fi     # only the lines of the reference, to measure how well the cut lies on them
$PY -I Scripts/micro/MicroCutRead.py $P
find $(dirname $P)/02_masks -maxdepth 1 -name "labels_raw_*" -delete      # 2 November 2026 : a new reading replaces the masks as read. FR : une nouvelle lecture remplace les masques lus.
$PY -I Scripts/micro/MicroCutFit.py $P      # 2 November 2026 : the mask gives the pieces, the sheet gives the borders. FR : le masque donne les pièces, la planche donne les bords.
$PY -I Scripts/micro/MicroLegend.py $P
$PY -I Scripts/micro/MicroOutline.py $P board
find $(dirname $P)/03_sheets -maxdepth 1 \( -name "S*" -o -name "sheets.json" \) -delete      # 2 November 2026 : no more sheets of several pieces, the model fails on them. FR : plus de feuilles de plusieurs pièces, le modèle y échoue.
$PY -I Scripts/micro/MicroPieces.py $P | tail -2      # 2 November 2026 : one component, one image, one prompt. FR : un composant, une image, un prompt.
if grep -q '"model"' $P; then $PY -I Scripts/micro/MicroSelfTest.py $P || echo "some lines must be checked, see 06_checks/selftest.json"; fi      # 2 November 2026 : the simulated fill needs a known model. FR : le remplissage simulé exige un modèle connu.
if [ -n "$2" ]; then $PY -I Scripts/micro/MicroVersions.py $P snapshot "$2"; fi
$PY -I Scripts/micro/MicroDoc.py $P
