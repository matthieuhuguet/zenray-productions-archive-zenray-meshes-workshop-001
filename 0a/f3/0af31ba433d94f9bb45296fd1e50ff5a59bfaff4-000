        case = make_case(**kw)
        hull = visual_hull(case, eps_px=1.5)
        f0 = fidelity(hull, case["truth"])
        cuts, cal, hb = estimate_cuts(case, hull)
        final, acc = apply_cuts(case, hull, cuts, cal)
        f1 = fidelity(final, case["truth"])
        rec = recovery(case, acc)
        big = [r for r in rec if not r["plane"].startswith("front_haunch")]    # les petites facettes (0,16 % de la surface) sont hors score
        found = sum(r["found"] for r in big)
        v = vsummary(verify(final))
        print(f"{name}: coupes candidates {len(cuts)}, acceptées {len(acc)}; facettes obliques retrouvées {found}/{len(big)}", flush=True)
        print("  avant :", {k: round(x, 3) for k, x in f0.items()}, flush=True)
        print("  après :", {k: round(x, 3) for k, x in f1.items()}, v, flush=True)
        print("  facettes :", [(r['plane'], r.get('found'), round(r.get('angle_err_deg', -1), 1), round(r.get('offset_err_mm', -1), 1)) for r in big], round(time.time() - t, 1), "s", flush=True)
        res[name] = {"cuts_candidates": len(cuts), "cuts_accepted": len(acc), "oblique_found": found, "oblique_total": len(big), "before": f0, "after": f1, "verifiers_after": v, "per_plane": rec,
                     "light_calibration_sigma": {nm: float(cal[nm][3]) for nm in VIEWS6}}
    json.dump(res, open("out/e2b_shading.json", "w"), indent=1)
