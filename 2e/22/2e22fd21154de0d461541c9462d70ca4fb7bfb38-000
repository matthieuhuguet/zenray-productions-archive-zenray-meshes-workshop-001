#!/bin/zsh
# 2 November 2026 : the tutorial frames at the full 1280 px of the video, with the same index as frames/ (fps=1 + mpdecimate, as in extract.sh, before scaling). FR : les images du tuto en pleine résolution, avec le même numéro que frames/.
V=/Users/zenray/.claude/tmp/tmp-houdini-dracard/videos; O=/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/dracard/v3/refs; mkdir -p $O
grab() { ep=$1; shift; sel=""; for f in "$@"; do sel="$sel+eq(n\,$((f-1)))"; done; sel=${sel#+}; T=$(mktemp -d); ffmpeg -nostdin -loglevel error -hwaccel videotoolbox -i $V/$ep.mp4 -vf "fps=1,mpdecimate=hi=400:lo=200:frac=0.2,select='$sel'" -vsync vfr $T/o_%03d.png; i=1; for f in "$@"; do mv $T/o_$(printf %03d $i).png $O/${ep%%_*}_$(printf %05d $f).png; i=$((i+1)); done; rm -rf $T; echo done $ep; }
grab ep07_kH4IJ6tPzEs 16 71 86 113 183 211 226 239 253 267 366 379 407 421 477 491 &
grab ep10_kNFneG4z3WU 1597 2046 2066 2150 2171 2192 2318 2338 2397 2465 2486 2507 2633 2654 &
wait
echo ALLDONE
