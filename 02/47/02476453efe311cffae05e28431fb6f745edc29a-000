# 12 November 2026: try a pinhole camera for the front view from points known in other views. FR : essai de caméra en perspective.
import numpy as np
from scipy.optimize import least_squares
X=[ # (X,Y,Z, x or None, y or None, name)
 ( 1.1035,None,3.11,2277.55,None,'tyre FL outer'),(-1.1035,None,3.11,469.25,None,'tyre FR outer'),
 ( 1.01,None,-0.8,2133,None,'plate L'),(-1.01,None,-0.8,617,None,'plate R'),
 ( 1.0947,None,2.0145,2187,None,'mirror L tip'),
 (None,-0.392,2.737,None,1374,'tyre contact'),(None,-0.280,3.71,None,1322,'splitter bottom'),
 (None,0.834,-0.9,None,362,'plate top'),(None,0.523,2.0,None,609,'mirror tip')]
def res(p,rows):
  f,Zc,Yc,cx,cy=p; r=[]
  for X_,Y_,Z_,x,y,n in rows:
    d=Zc-Z_
    if x is not None: r.append(cx+f*X_/d-x)
    if y is not None: r.append(cy-f*(Y_-Yc)/d-y)
  return np.array(r)
for drop in [None,'plate L','mirror L tip','splitter bottom']:
  rows=[r for r in X if not (drop and r[5].startswith(drop.split()[0]))]
  s=least_squares(res,[30000,40,0.5,1373,900],args=(rows,),bounds=([1000,6,-5,1200,0],[1e6,500,10,1550,2000]))
  f,Zc,Yc,cx,cy=s.x
  print('drop',drop,'f %.0f Zc %.2f Yc %.2f cx %.1f cy %.1f'%tuple(s.x),'scale@Z3.0 %.0f @Z3.9 %.0f @Z-0.8 %.0f'%(f/(Zc-3),f/(Zc-3.9),f/(Zc+0.8)))
  print('  residuals px', ' '.join('%s:%+.1f'%(r[5].split()[0]+r[5].split()[-1],v) for r,v in zip([r for r in rows for k in (0,1) if r[3+k] is not None],res(s.x,rows))))
print('--- leave one out (mirror excluded)')
base=[r for r in X if not r[5].startswith('mirror')]
for k in range(len(base)):
  rows=base[:k]+base[k+1:]
  s=least_squares(res,[34000,45,1.2,1374,80],args=(rows,),bounds=([1000,6,-5,1200,-500],[1e6,500,10,1550,2000]))
  print('predict %-16s'%base[k][5], 'error px %+.1f'%res(s.x,[base[k]])[0], ' f %.0f Zc %.1f'%(s.x[0],s.x[1]))
