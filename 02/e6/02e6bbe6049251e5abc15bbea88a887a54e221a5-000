def check_js_untouched_logic():
    js = r"""
    const assert = require('node:assert/strict');
    // Old V5 buggy check:
    const oldUntouched = (S, M) => M && !S.edits.size === !(M.edits || []).length;
    // Patched 2.0 check:
    const editsSig = list => JSON.stringify([...list].sort((a, b) => (a.j - b.j) || (a.r - b.r)));
    const currentEditsList = S => [...S.edits.entries()].map(([k, v]) => ({ j: +k.split(',')[0], r: +k.split(',')[1], ...v }));
    const newUntouched = (S, M) => Boolean(M && editsSig(currentEditsList(S)) === editsSig(M.edits || []));

    const M_edited = { edits: [{ j: 1, r: 2, dx: 0.1, dy: 0.0 }] };
    const S_modified = { edits: new Map([['3,4', { dx: 0.5, dy: -0.2 }]]) };
    const S_identical = { edits: new Map([['1,2', { dx: 0.1, dy: 0.0 }]]) };
    const M_empty = { edits: [] };
    const S_empty = { edits: new Map() };

    assert.equal(oldUntouched(S_modified, M_edited), true, 'Proves old V5 falsely returns true when both have 1 different edit');
    assert.equal(newUntouched(S_modified, M_edited), false, 'Patched version rejects overwriting different edits');
    assert.equal(newUntouched(S_identical, M_edited), true, 'Patched version accepts genuinely untouched model');
    assert.equal(newUntouched(S_empty, M_empty), true, 'Patched version accepts clean empty state');
    console.log('[PASS] JS untouched() diff-collision bug reproduced & fix verified in Node');
    """
    subprocess.run(['node', '-e', js], check=True)


