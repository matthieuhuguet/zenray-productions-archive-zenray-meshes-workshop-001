#!/usr/bin/env python3
# 10 November 2026: corners (interior angle) and sides (length in cm) of plan faces, as the mesher sees them after its
# own cuts. usage: faceinfo.py <version> <face,face,...>
import json, sys
sys.path.insert(0, '/Users/zenray/.claude/skills/zenray-meshes/scripts/v4')
import numpy as np, PanelMesh as PM
ver = int(sys.argv[1]); want = sys.argv[2].split(',')
solved = json.load(open('02_solved/V_%03d/cage.solved.json' % ver)); net = PM.Net(solved)
def show(tag):
    print(tag)
    for name, f in net.F.items():
        if name.split('#')[0] not in want:
            continue
        lp = f['loop']; names = [n for n, _ in lp]; out = []
        for sd in net.sides(name):
            L = sum(PM.arclen(net.edge(a, b))[-1] for a, b in zip(sd, sd[1:]))
            out.append('%s(%d°) -%.0fcm%s-' % (sd[0], round(net.corner_angle(lp, names.index(sd[0]))), L * 100, ('[' + ','.join(sd[1:-1]) + ']') if len(sd) > 2 else ''))
        print('  %-16s %s' % (name, ' '.join(out)))
show('plan'); d = net.demote(); s = net.split_slivers(); t = net.cut_tips(); net.quadrangulate(); show('after demote %s, slivers %s, tips %s' % (d, s, t))
