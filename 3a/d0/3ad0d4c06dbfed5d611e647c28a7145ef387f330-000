#!/bin/zsh
# 28 October 2026 : judge one delivery npz (topology, review, six-view silhouette and lines, holes) and print one line. Usage: JudgeDelivery.sh vNNN
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; C=$1; cd $W; mkdir -p versions/Audit_$C
$PY -I Scripts/TopoCheck.py work/car/delivery_$C.npz work/car/topo_params.json versions/Topo_$C --no-board > /dev/null
$PY -I Scripts/AnimReview.py work/car/delivery_$C.npz work/car/topo_params.json work/car/wheel_params.json versions/Review_$C > /dev/null 2>&1
$PY -I -c "
import sys;sys.path.insert(0,'Scripts');import numpy as np,TopoFix
d=np.load('work/car/delivery_$C.npz',allow_pickle=True);TopoFix.write_obj('versions/ZenRayCar_$C.obj',d['P'],[list(map(int,q)) for q in d['Q']],[str(x) for x in d['names']])"
$PY -I Scripts/SheetScore.py work/car/frame work/car/views versions/ZenRayCar_$C.obj versions/Audit_$C/vs.png > versions/Audit_$C/silhouette.json
$PY -I Scripts/LineScore.py work/car/frame work/car/views versions/ZenRayCar_$C.obj versions/Audit_$C/lines.png > versions/Audit_$C/lines.json
$PY -I - $C <<'PYE'
import json,sys;t=sys.argv[1]
T=json.load(open(f'versions/Topo_{t}.json'));R=json.load(open(f'versions/Review_{t}.json'))
s=json.load(open(f'versions/Audit_{t}/silhouette.json'));l=json.load(open(f'versions/Audit_{t}/lines.json'))
fail=[g['gate']+'='+str(g['measured']) for g in R['gates'] if not g['ok']]
print(t,'faces',T['faces'],'faults',T['error_faces'],'gates',R['passed'],'/',R['total'],fail,'sil',s['mean_kept'],s['mean_raw'],'holes',sum(s['hole_px'].values()),'lines',l['mean_f1'],l['mean_f1_normal_only'])
PYE
