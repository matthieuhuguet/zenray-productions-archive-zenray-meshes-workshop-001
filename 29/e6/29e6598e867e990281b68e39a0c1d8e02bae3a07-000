class FrontCaster:
    """Front ray cast : the skin point with the largest z under (x, y)."""
    def __init__(self, obj):
        V, F, _, _ = RM.from_obj(obj); self.T = V[F]; self.lo = self.T[:, :, :2].min(1); self.hi = self.T[:, :, :2].max(1)

    def __call__(self, x, y):
        m = (self.lo[:, 0] <= x) & (self.hi[:, 0] >= x) & (self.lo[:, 1] <= y) & (self.hi[:, 1] >= y); T = self.T[m]
        if not len(T): raise ValueError("no skin under (%.3f, %.3f)" % (x, y))
        a, b, c = T[:, 0], T[:, 1], T[:, 2]; v0, v1 = b[:, :2] - a[:, :2], c[:, :2] - a[:, :2]; d = v0[:, 0] * v1[:, 1] - v0[:, 1] * v1[:, 0]
        w = np.array([x, y]) - a[:, :2]; ok = np.abs(d) > 1e-14; d = np.where(ok, d, 1.0)
        s = (w[:, 0] * v1[:, 1] - w[:, 1] * v1[:, 0]) / d; u = (v0[:, 0] * w[:, 1] - v0[:, 1] * w[:, 0]) / d; hit = ok & (s >= -1e-9) & (u >= -1e-9) & (s + u <= 1 + 1e-9)
        if not hit.any(): raise ValueError("no skin under (%.3f, %.3f)" % (x, y))
        z = a[:, 2] + s * (b[:, 2] - a[:, 2]) + u * (c[:, 2] - a[:, 2]); return np.array([x, y, float(z[hit].max())])


def catmull(P, step):
    """2D Catmull-Rom through P, sampled every `step` metres (approximately)."""
    P = np.asarray(P, float); E = np.vstack([2 * P[0] - P[1], P, 2 * P[-1] - P[-2]]); out = [P[0]]
    for i in range(1, len(E) - 2):
        p0, p1, p2, p3 = E[i - 1], E[i], E[i + 1], E[i + 2]; n = max(2, int(np.linalg.norm(p2 - p1) / step) + 1)
        for t in np.linspace(0, 1, n)[1:]:
            out.append(0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t + (-p0 + 3 * p1 - 3 * p2 + p3) * t ** 3))
    return np.array(out)


def build_doc(prm=PARAMS):
    cast = FrontCaster(prm["obj"]); L = prm["landmarks"]; nodes, arcs, nid = [], [], {}
    def node(name, side):
        key = (name, side if L[name][0] != 0 else 0)
        if key not in nid: x, y = L[name]; nid[key] = len(nodes); nodes.append({"id": len(nodes), "p": cast(side * x if x else 0.0, y).round(6).tolist()})
        return nid[key]
    for side in (1, -1):
        for cname, (a, mid, b) in prm["curves"].items():
            if L[a][0] == 0 and L[b][0] == 0 and side == -1: continue           # the sternum curves are on x = 0, made once
            pts2 = [L[a]] + mid + [L[b]]; pts2 = [[side * p[0], p[1]] for p in pts2]
            S = np.array([cast(x, y) for x, y in catmull(pts2, 0.01)]); m = max(4, int(round(SP.polyline_length(S) / prm["ctrl_step_m"])) + 1)
            C = SP.fit(S, m); ia, ib = node(a, side), node(b, side); C[0] = nodes[ia]["p"]; C[-1] = nodes[ib]["p"]
            arcs.append({"id": len(arcs), "a": ia, "b": ib, "closed": False, "pair": ["", ""], "ctrl": np.round(C, 6).tolist(), "mirror": -1, "name": cname + ("_L" if side > 0 else "_R") if L[a][0] or L[b][0] else cname})
    for i, A in enumerate(arcs):                                         # mirror pairs by their reflected middle control point
        if not A["name"].endswith("_L"): continue
        for j, B in enumerate(arcs):
            if B["name"] == A["name"][:-2] + "_R": A["mirror"], B["mirror"] = j, i
    seeds = []
    for nm, (x, y) in prm["seeds"].items():
        for side, suf in ((1, "_L"), (-1, "_R")): seeds.append({"name": nm + suf, "p": cast(side * x, y).round(6).tolist()})
    corners = {str(v): True for v in nid.values()}
    return {"version": 1, "date": "29 October 2026", "units": "m", "spline": {"degree": 3, "knots": "clamped uniform : n control points, n-3 spans, parameter u in [0, n-3]"},
            "nodes": nodes, "arcs": [{k: v for k, v in a.items() if k != "name"} for a in arcs], "components": [], "component_seeds": seeds, "corners_force": corners, "model_ref": prm["obj"]}


def build_doc_panels(prm=PARAMS, pan=PANELS):
    """29 October 2026, v4 : the network on the panel lines : crease nodes snapped to the crease map, crease arcs = cheapest path along the valley
    (ZrlCreases.crease_path), free arcs through their points ; all lifted on the skin by the front ray cast and fitted to cubic B-splines ; no forced
    corner, every face finds its own corners by the turn of its curves (a leg that continues straight is not a corner of the face beside it)."""
    import ZrlCreases as ZC, ZrlRefMesh as RM
    cast = FrontCaster(prm["obj"]); V, F, _, _ = RM.from_obj(prm["obj"]); cprm = dict(ZC.PARAMS); cm = ZC.crease_map(V, F, cprm)
    N = {k: np.array(v, float) for k, v in pan["nodes"].items()}
    for k in pan["on_crease"]:
        c, r = ZC.world_to_pixel(cprm, np.array([[N[k][0], N[k][1], 0.0]]))[0]; rad = prm["snap_mm"] / 1000.0 * cprm["px_per_m"]
        rr, cc = np.mgrid[int(r - rad):int(r + rad) + 1, int(c - rad):int(c + rad) + 1]; ok = (rr - r) ** 2 + (cc - c) ** 2 <= rad ** 2
        if N[k][0] == 0: ok &= np.abs(cc - c) < 0.5                                       # a node on the symmetry line stays on it
        cv = np.where(ok, np.nan_to_num(cm["curv"][np.clip(rr, 0, cprm["res"] - 1), np.clip(cc, 0, cprm["res"] - 1)]), -1)
        i = np.unravel_index(np.argmax(cv), cv.shape)
        if cv[i] > cprm["min_curv"]: N[k] = ZC.pixel_to_world(cprm, np.array([float(rr[i])]), np.array([float(cc[i])]))[0, :2]
    nodes, arcs, nid = [], [], {}
    def node(name, side):
        x, y = N[name]; key = (name, side if x != 0 else 0)
        if key not in nid: nid[key] = len(nodes); nodes.append({"id": len(nodes), "p": cast(side * x, y).round(6).tolist()})
        return nid[key]
    paths = {}
    for a, b, mode, mid, name in pan["arcs"]:
        paths[name] = ZC.crease_path(cm, cprm, N[a], N[b], snap_mm=0.0) if mode == "crease" else catmull([N[a].tolist()] + mid + [N[b].tolist()], 0.004)
        paths[name][0], paths[name][-1] = N[a], N[b]
    for side in (1, -1):
        for a, b, mode, mid, name in pan["arcs"]:
            if N[a][0] == 0 and N[b][0] == 0 and side == -1: continue
            pts = paths[name] * np.array([side, 1.0]); S = np.array([cast(x, y) for x, y in pts]); S = SP.clean_polyline(S) if hasattr(SP, "clean_polyline") else S
            m = max(4, int(round(SP.polyline_length(S) / prm["ctrl_step_m"])) + 1); C = SP.fit(S, m); ia, ib = node(a, side), node(b, side)
            C[0] = nodes[ia]["p"]; C[-1] = nodes[ib]["p"]
            arcs.append({"id": len(arcs), "a": ia, "b": ib, "closed": False, "pair": ["", ""], "ctrl": np.round(C, 6).tolist(), "mirror": -1,
                         "name": name + ("" if N[a][0] == 0 and N[b][0] == 0 else ("_L" if side > 0 else "_R"))})
    for i, A in enumerate(arcs):
        if A["name"].endswith("_L"):
            for j, B in enumerate(arcs):
                if B["name"] == A["name"][:-2] + "_R": A["mirror"], B["mirror"] = j, i
    sides = lambda nm: [(0, "")] if pan["seeds"][nm][0] == 0 else [(1, "_L"), (-1, "_R")]        # 29 October 2026 : a seed on x = 0 is one patch across the sternum
    seeds = [{"name": nm + suf, "p": cast(side * x, y).round(6).tolist()} for nm, (x, y) in pan["seeds"].items() for side, suf in sides(nm)]
    def corner(c, side): nm, _, sd = c.partition("@"); return node(nm, {"L": 1, "R": -1}[sd] if sd else side)
    copts = {nm + suf: {"corners": [corner(c, side) for c in cs]} for nm, cs in pan.get("corners", {}).items() for side, suf in sides(nm)}
    return {"version": 1, "date": "29 October 2026", "units": "m", "spline": {"degree": 3, "knots": "clamped uniform : n control points, n-3 spans, parameter u in [0, n-3]"},
            "nodes": nodes, "arcs": [{k: v for k, v in a.items() if k != "name"} for a in arcs], "arc_names": [a["name"] for a in arcs], "components": [],
            "component_seeds": seeds, "component_options": copts, "corners_force": {}, "model_ref": prm["obj"]}


def judge(res, ref, prm):
    P = np.array(res["P"], float).reshape(-1, 3); Q = np.array(res["Q"], int).reshape(-1, 4); st = res["stats"]
    E = np.concatenate([Q[:, [0, 1]], Q[:, [1, 2]], Q[:, [2, 3]], Q[:, [3, 0]]]); E = np.unique(np.sort(E, 1), axis=0); el = np.linalg.norm(P[E[:, 0]] - P[E[:, 1]], axis=1)
    X = P[Q]; qe = np.linalg.norm(X - np.roll(X, -1, axis=1), axis=2); aspect = qe.max(1) / np.maximum(qe.min(1), 1e-12)
    from scipy.spatial import cKDTree
    side = P[:, 0] > 1e-4; tree = cKDTree(P); d_mir, _ = tree.query(P[side] * np.array([-1.0, 1, 1])) if side.any() else (np.zeros(1), None)
    edge_faces = {}
    for q in range(len(Q)):
        for k in range(4):
            a, b = sorted((Q[q, k], Q[q, (k + 1) % 4])); edge_faces[(a, b)] = edge_faces.get((a, b), 0) + 1
    bnd = np.unique(np.array([v for (a, b), n in edge_faces.items() if n == 1 for v in (a, b)], int))
    _, _, dsurf = ref.closest(P[bnd]) if len(bnd) else (None, None, np.zeros(1))
    jac = np.array(res.get("quad_jac") or [], float)
    return {"quads": int(len(Q)), "faces_meshed": st["faces_meshed"], "folded": st["folded_quads"], "min_jacobian": round(float(st["min_jac"]), 3),
            "quads_below_0.5": st["quads_below_jac_min"], "jacobian_p05": round(float(np.percentile(jac, 5)), 3) if len(jac) else None,
            "symmetry_max_mm": round(float(d_mir.max()) * 1000, 3), "border_on_skin_max_mm": round(float(dsurf.max()) * 1000, 3),
            "edge_mean_m": round(float(el.mean()), 4), "edge_cv": round(float(el.std() / el.mean()), 3), "quad_aspect_max": round(float(aspect.max()), 2),
            "quad_aspect_p95": round(float(np.percentile(aspect, 95)), 2), "welded": st["welded"], "manifold": st["manifold"],
            "faces": [(f.get("component"), f.get("side_counts"), f.get("folded"), round(float(f.get("min_jac", 0)), 3)) for f in res["faces"] if f.get("quads")]}


def tutte_refill(res, prm):
    """29 October 2026 : every four sided patch gets its interior again from ZrlTutteFill (bijective map to the square, in the front view, lifted by
    the front ray cast), then exact symmetry across x = 0 (mutual twins), then fresh Jacobians, folds and per face numbers in res (same judge as NM)."""
    import ZrlTutteFill as TF
    from scipy.spatial import cKDTree
    cast = FrontCaster(prm["obj"]); P0 = np.array(res["P"], float).reshape(-1, 3); P, done = TF.refill(P0, res, cast)
    def sym(P):
        R = P * np.array([-1.0, 1, 1]); d, j = cKDTree(P).query(R); ok = (d <= 0.01) & (j[j] == np.arange(len(P)))
        P = P.copy(); P[ok] = 0.5 * (P[ok] + R[j[ok]]); P[ok & (j == np.arange(len(P))), 0] = 0.0; return P
    ref = NM.load_ref(prm["obj"]); Q = np.array(res["Q"], int).reshape(-1, 4); z = np.tile([0.0, 0.0, 1.0], (len(Q), 1))
    def jacs(P):
        n = ref.normals_at(P[Q].mean(1), guide=z); n = np.where(((n * z).sum(1) > 0)[:, None], n, z); return TF.quad_jacobians(P, Q, n)
    P = sym(P); j0, j1 = jacs(P0), jacs(P); foq = np.array(res["face_of_quad"], int); kept = []
    for f, G in TF.face_grids(res):                                   # 29 October 2026 : the Tutte interior is kept only on the faces it improves
        qs = np.flatnonzero(foq == f["id"]); inner = G[1:-1, 1:-1].ravel()
        if len(qs) and j1[qs].min() < j0[qs].min(): P[inner] = P0[inner]
        else: kept.append(f.get("component"))
    if prm.get("optimize_interior", True):                          # 29 October 2026 : then each interior vertex moves to raise the worst quad around it
        inner = TF.interior_vertices(Q, foq)                         # every vertex inside one face (Tarini spokes and poles too), borders excluded
        P2, gain = TF.optimize_interior(P, Q, inner, cast); P2 = sym(P2); j2 = jacs(P2); res.setdefault("stats", {})["interior_opt"] = gain
        groups = {}                                                   # kept per mirrored pair (name without _L/_R), only where the true Jacobian improves on both
        for f in res["faces"]:
            if f.get("quads"): groups.setdefault(str(f.get("component"))[:-2] if str(f.get("component")).endswith(("_L", "_R")) else str(f.get("component")), []).append(f)
        jp = jacs(P); inner_set = set(inner)
        for key, fs in groups.items():
            if all(j2[np.flatnonzero(foq == f["id"])].min() > jp[np.flatnonzero(foq == f["id"])].min() for f in fs):
                for f in fs: vv = [v for v in np.unique(Q[foq == f["id"]]) if int(v) in inner_set]; P[vv] = P2[vv]
        P = sym(P)
    done = kept; jac = jacs(P)
    st = res["stats"]; jmin = float(st.get("jac_min_threshold", 0.5)) if isinstance(st.get("jac_min_threshold"), (int, float)) else 0.5
    res["P"] = P.tolist(); res["quad_jac"] = jac.tolist(); st["folded_quads"] = int((jac < 0).sum()); st["min_jac"] = float(jac.min()); st["quads_below_jac_min"] = int((jac < jmin).sum())
    st["tutte_faces"] = done; foq = np.array(res["face_of_quad"], int)
    for f in res["faces"]:
        qs = np.flatnonzero(foq == f["id"])
        if len(qs): f["folded"] = int((jac[qs] < 0).sum()); f["min_jac"] = float(jac[qs].min())
    return res


def run(prm=PARAMS):
    doc = build_doc_panels(prm) if prm.get("layout") == "panels" else build_doc(prm)
    res = NM.build(doc, {"ref": prm["obj"], "edge_m": prm["edge_m"], "write_obj": False, "corners_force": doc["corners_force"], "symmetry_x": True, "min_arc_count": prm.get("min_arc_count", 2),
                         "component_options": doc.get("component_options") or {}})
    if prm.get("tutte_fill", True) and prm.get("layout") == "panels": tutte_refill(res, prm)   # 29 October 2026 : interiors that cannot fold
    J = judge(res, NM.load_ref(prm["obj"]), prm)
    os.makedirs(os.path.dirname(prm["out_obj"]), exist_ok=True); json.dump(doc, open(prm["out_doc"], "w"))
    P = np.array(res["P"], float).reshape(-1, 3); Q = np.array(res["Q"], int).reshape(-1, 4)   # 29 October 2026 : the quads, for ZrlCreases.py and any viewer
    with open(prm["out_obj"], "w") as f:
        f.write("".join("v %.6f %.6f %.6f\n" % tuple(p) for p in P) + "".join("f %d %d %d %d\n" % tuple(q + 1) for q in Q))
    return doc, res, J


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0]); ap.add_argument("--edge", type=float, default=PARAMS["edge_m"]); a = ap.parse_args()
    prm = dict(PARAMS, edge_m=a.edge); doc, res, J = run(prm); print(json.dumps(J, indent=1))


if __name__ == "__main__":
    main()
