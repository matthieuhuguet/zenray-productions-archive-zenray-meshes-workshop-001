"""5 November 2026 : ROUGH, a lumpiness measure : the angle between the normals of adjacent faces, median and 90th percentile, over the faces that lie inside the body box (so thin parts do not count). Lower is smoother. FR : mesure du bosselage : angle entre normales de faces voisines.
Usage : python Rough.py part.obj [ymin ymax]"""
import sys, numpy as np
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts/Dracard/Comp")
from CompFit import load_quads
V, Fq = load_quads(sys.argv[1]); T = np.array([[f[0], f[k], f[k + 1]] for f in Fq for k in range(1, len(f) - 1)])
fn = np.cross(V[T[:, 1]] - V[T[:, 0]], V[T[:, 2]] - V[T[:, 0]]); a = np.linalg.norm(fn, axis=1); ok = a > 1e-12; fn[ok] /= a[ok, None]
E = {}
for i, t in enumerate(T):
    for k in range(3):
        e = tuple(sorted((int(t[k]), int(t[(k + 1) % 3])))); E.setdefault(e, []).append(i)
c = np.array([V[T[i]].mean(0) for i in range(len(T))]); y0 = float(sys.argv[2]) if len(sys.argv) > 2 else -9; y1 = float(sys.argv[3]) if len(sys.argv) > 3 else 9
ang = []
for e, fs in E.items():
    if len(fs) == 2 and ok[fs[0]] and ok[fs[1]] and y0 <= c[fs[0], 1] <= y1:
        ang.append(np.degrees(np.arccos(np.clip(fn[fs[0]] @ fn[fs[1]], -1, 1))))
ang = np.array(ang); print("edges", len(ang), "median %.2f p90 %.2f p99 %.2f" % (np.median(ang), np.percentile(ang, 90), np.percentile(ang, 99)))
