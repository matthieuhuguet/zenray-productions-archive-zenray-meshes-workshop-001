# 25 October 2026 : ZenRay Meshes, write a copy of a named car npz WITHOUT the parts whose name contains any of the given
# substrings (to find which family makes an artefact by elimination). Usage: python PartFilter.py <in.npz> <out.npz> sub1,sub2
import sys
import numpy as np
d = np.load(sys.argv[1], allow_pickle=True); subs = sys.argv[3].split(","); N = d["names"]
keep_n = np.array([not any(s in n for s in subs) for n in N]); keep_f = keep_n[d["T"]]
np.savez(sys.argv[2], P=d["P"], F=d["F"][keep_f], T=d["T"][keep_f], names=N); print(int(keep_f.sum()), "faces kept")
