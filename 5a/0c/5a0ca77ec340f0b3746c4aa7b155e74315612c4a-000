"""29 October 2026 : ZenRay Retopology MESH VIEW : an orthographic picture of a quad mesh (.obj), faces painted far to near so the near side hides the far side, quad edges in light lines.
    python -I ZrlMeshView.py mesh.obj out.png [--view front|back|left|top] [--box x0,y0,x1,y1] [--size 1100]
FR : image orthographique d'un maillage de quads, faces peintes de loin en près."""
import argparse
import os, sys
import numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from PIL import Image, ImageDraw


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("obj"); ap.add_argument("out"); ap.add_argument("--view", default="front"); ap.add_argument("--box"); ap.add_argument("--size", type=int, default=1100); ap.add_argument("--parts", help="quad components json written by ZrlClosedCheck --obj (obj + .parts.json) : the quads take the pale colour of their zone (ZrlPalette)"); a = ap.parse_args()
    V, Q = [], []
    for l in open(a.obj):
        t = l.split()
        if t and t[0] == "v": V.append([float(x) for x in t[1:4]])
        elif t and t[0] == "f": Q.append([int(x.split("/")[0]) - 1 for x in t[1:]])
    V = np.array(V); axes, sign, depth = {"front": ((0, 1), 1.0, 2), "back": ((0, 1), -1.0, 2), "left": ((2, 1), 1.0, 0), "top": ((0, 2), 1.0, 1)}[a.view]; dsign = -1.0 if a.view == "back" else 1.0
    u = sign * V[:, axes[0]]; v = V[:, axes[1]]; d = dsign * V[:, depth]
    if a.box: x0, y0, x1, y1 = [float(x) for x in a.box.split(",")]
    else: x0, x1, y0, y1 = u.min() - 0.02, u.max() + 0.02, v.min() - 0.02, v.max() + 0.02
    W = a.size; H = int(W * (y1 - y0) / (x1 - x0)); img = Image.new("RGB", (W, H), (16, 16, 20)); dr = ImageDraw.Draw(img)
    X = (u - x0) / (x1 - x0) * W; Y = H - (v - y0) / (y1 - y0) * H; order = np.argsort([d[q].mean() for q in Q])
    parts = None
    if a.parts:
        import json, ZrlPalette as PL; parts = json.load(open(a.parts)); cols = {n: PL.colour(n) for n in set(parts)}
    for i in order:
        q = Q[i]; n = np.cross(V[q[1]] - V[q[0]], V[q[2]] - V[q[0]])
        if len(q) > 3: n = n + np.cross(V[q[2]] - V[q[0]], V[q[3]] - V[q[0]])
        shade = int(60 + 120 * abs(n[depth]) / max(np.linalg.norm(n), 1e-12)); pts = [(X[k], Y[k]) for k in q]
        if parts: k_ = 0.45 + 0.55 * (shade - 60) / 120.0; dr.polygon(pts, fill=tuple(int(c * k_) for c in cols[parts[i]]), outline=(52, 58, 70))
        else: dr.polygon(pts, fill=(shade // 2, shade // 2, shade), outline=(200, 205, 215))
    img.save(a.out); print(a.out, len(Q), "quads")


if __name__ == "__main__":
    main()
