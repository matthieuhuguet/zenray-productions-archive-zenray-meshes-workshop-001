"""Pass 9 : where do the squashed quads (minimal corner Jacobian under 0.3) of the REAL arch come from. Written 30 October 2026.
Usage : python3 -I real_arch_squashed.py arch=DIR out=squashed.json    (same DIR as run_real_arch.py).
FR : origine des quads ecrases de l'arche reelle : coin de patch ou non, angle du coin au pire sommet du quad."""
import sys, json, collections
sys.path.insert(0, ".")
import numpy as np
import run_real_arch as RA
import zr8_judge as J, zr8_localrepair as LR

qpart, qcorners = RA.dump["qpart"], RA.dump["qcorners"]
patch_of = np.full(len(RA.Q0), -1)
for p, qf in enumerate(qpart): patch_of[list(qf)] = p
all_nodes = {int(c) for cs in qcorners for c in cs}
out = {}
for label, P in (("raw", RA.P0), ("smooth", RA.Ps)):
    Jc = J.corner_jacobians(P, RA.Q0); Jm = Jc.min(axis=1); d = collections.Counter()
    for f in np.where((Jm >= 0) & (Jm < 0.3))[0]:
        k = int(np.argmin(Jc[f])); v = int(RA.Q0[f][k]); p = int(patch_of[f])
        ang = LR.corner_quad_angle(P, RA.Q0, [f], v)
        d["own_patch_corner" if v in set(qcorners[p]) else ("foreign_node" if v in all_nodes else "non_node")] += 1
        d["angle_lt58" if ang < 58 else ("angle_58_122" if ang <= 122 else "angle_gt122")] += 1
        d["total"] += 1
    out[label] = dict(d); print(label, dict(d), flush=True)
json.dump(out, open(dict(kv.split("=", 1) for kv in sys.argv[1:])["out"], "w"), indent=1)
