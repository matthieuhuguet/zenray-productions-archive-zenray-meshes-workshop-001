# 10 November 2026: viewport captures for the wheel boards (side camera over the reference, perspective with wireframe).
import hou
CHK = '/Users/zenray/.claude/tmp/tmp-zenray-meshes/Projects/12_Car2Cage/04_checks/'
def _shot(sv, vp, path):
    fb = sv.flipbookSettings().stash(); fb.output(path); fb.outputToMPlay(False); fb.useResolution(True); fb.resolution((1200, 1200)); fb.cropOutMaskOverlay(True); fb.frameRange((hou.frame(), hou.frame())); sv.flipbook(vp, fb)
def capture(tag, width=1.25, hide=()):
    # 10 November 2026: width = ortho width of the side camera; the reference alone is captured too, at the same framing.
    sv = hou.ui.paneTabOfType(hou.paneTabType.SceneViewer); vp = sv.curViewport(); ref = hou.node('/obj/REF_car2'); hou.clearAllSelected()
    cam = hou.node('/obj/CAM_side'); cam.parm('orthowidth').set(width); vp.setCamera(cam)
    shown = [n for n in hou.node('/obj').children() if n.type().name() == 'geo' and n.name() != 'REF_car2' and n.isDisplayFlagSet()]
    for n in shown: n.setDisplayFlag(False)
    _shot(sv, vp, CHK + tag + '_ref.png')
    for n in shown: n.setDisplayFlag(n.name() not in hide)
    _shot(sv, vp, CHK + tag + '_side.png')
    ref.setDisplayFlag(False); vp.setCamera(hou.node('/obj/CAM_persp'))
    ds = vp.settings().displaySet(hou.displaySetType.SceneObject); old = ds.shadedMode(); ds.setShadedMode(hou.glShadingType.SmoothWire)
    _shot(sv, vp, CHK + tag + '_persp_wire.png'); ds.setShadedMode(old); ref.setDisplayFlag(True); vp.setCamera(hou.node('/obj/CAM_side'))
    return [CHK + tag + '_side.png', CHK + tag + '_persp_wire.png']

def capture_cam(tag, cam_name, width, centre=None):
    # 11 November 2026: one view through any orthographic camera, with the reference alone first, at the same framing.
    sv = hou.ui.paneTabOfType(hou.paneTabType.SceneViewer); vp = sv.curViewport(); hou.clearAllSelected()
    cam = hou.node('/obj/' + cam_name); cam.parm('orthowidth').set(width)
    if centre: cam.parmTuple('t').set(centre)
    vp.setCamera(cam)
    shown = [n for n in hou.node('/obj').children() if n.type().name() == 'geo' and n.name() != 'REF_car2' and n.isDisplayFlagSet()]
    for n in shown: n.setDisplayFlag(False)
    _shot(sv, vp, CHK + tag + '_ref.png')
    for n in shown: n.setDisplayFlag(True)
    _shot(sv, vp, CHK + tag + '_side.png')
    return CHK + tag + '_side.png'
