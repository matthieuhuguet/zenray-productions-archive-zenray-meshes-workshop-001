"""Pass 8 : add the date '30 October 2026' to every prose line, heading and table row of the given markdown files (idempotent).
Usage : python3 -I datestamp.py files=a.md,b.md [date=30 October 2026]. Code fences are left alone. Written 30 October 2026.
FR : ajoute la date en anglais a chaque ligne de prose, titre et ligne de tableau (regle de la mission)."""
import sys, re

DATE = "30 October 2026"


def stamp(text, date=DATE):
    out = []; fence = False; in_table = False
    lines = text.split("\n")
    for i, ln in enumerate(lines):
        if ln.strip().startswith("```"):
            fence = not fence; out.append(ln); in_table = False; continue
        if fence or not ln.strip():
            out.append(ln); in_table = False; continue
        s = ln.rstrip()
        if s.startswith("|"):
            cells = [c.strip() for c in s.strip().strip("|").split("|")]
            is_sep = all(re.fullmatch(r":?-+:?", c) for c in cells if c != "")
            if not in_table:
                in_table = True
                if cells and cells[-1] == "Date":
                    out.append(s); continue
                out.append(s + " Date |"); continue
            if is_sep:
                out.append(s + "-" * 3 + "|"); continue
            if date in s.split("|")[-2]:
                out.append(s); continue
            out.append(s + " " + date + " |"); continue
        in_table = False
        if date in s:
            out.append(s); continue
        out.append(s + " (" + date + ")")
    return "\n".join(out)


if __name__ == "__main__":
    a = dict(kv.split("=", 1) for kv in sys.argv[1:])
    for f in a["files"].split(","):
        t = open(f).read()
        open(f, "w").write(stamp(t, a.get("date", DATE)))
