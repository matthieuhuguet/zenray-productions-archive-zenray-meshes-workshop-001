def build_part(name, overrides=None):
    P = json.loads(json.dumps(REGISTRY[name]["default"]))
    for g, d in (overrides or {}).items(): P[g].update(d)
    return REGISTRY[name]["build"](P), P


def write_obj(path, objs, mirror=False):
    off = 0
    with open(path, "w") as f:
        for name, (V, F) in objs.items():
            f.write("o %s\n" % name); W = V.copy()
            if mirror: W[:, 0] = -W[:, 0]
            for v in W: f.write("v %.6f %.6f %.6f\n" % tuple(v))
            for q in F: q = q[::-1] if mirror else q; f.write("f " + " ".join(str(i + off + 1) for i in q) + "\n")
            off += len(V)


