import os, sys, json
import numpy as np
from scipy import ndimage as ndi
from PIL import Image

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import Raster, SheetScore, TopoCheck as TC
from AnimReview import load_review_params, review

def build_v624():
    base_dir = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
    base_npz = os.path.join(base_dir, "work/car/delivery_v623.npz")

    d = np.load(base_npz, allow_pickle=True)
    P = d["P"].astype(float).copy()
    Q_ = [list(map(int, q)) for q in d["Q"]]
    names = list(d["names"])
    names_arr = np.array(names)

    print(f"Loaded v623 base: {len(P)} vertices, {len(Q_)} quads.")

    # 1. Lateral Fascia Side to Bumper Corner Seam Welds
    P[26008, 2] = P[95831, 2]
    P[26030, 2] = P[95847, 2]
    print("Lateral fascia: welded vertices 26008 and 26030 to bumper corners in Z (closed 7.98 mm gap).")

    # 2. Headlight Upper Perimeter Welds to Front Band
    P[95738, 1] = P[25785, 1]
    P[95738, 2] = P[25785, 2]
    P[95770, 1] = P[25753, 1]
    P[95770, 2] = P[25753, 2]
    print("Headlights: welded vertices 95738 and 95770 to front band in Y and Z (closed 2.55 mm gap).")

    # 3. Centerline symmetry snapping
    center_pts = np.where(np.abs(P[:, 0]) < 0.003)[0]
    P[center_pts, 0] = 0.0
    print(f"Centerline: snapped {len(center_pts)} vertices to X=0.000 mm.")

    # 4. Save delivery_v624.npz and export OBJ
    out_npz = os.path.join(base_dir, "work/car/delivery_v624.npz")
    out_obj = os.path.join(base_dir, "versions/ZenRayCar_v624.obj")
    Q_arr = np.array(Q_, dtype=object)
    np.savez_compressed(out_npz, P=P, Q=Q_arr, names=names_arr)
    print(f"Saved {out_npz}")

    with open(out_obj, "w") as f:
        f.write("# ZenRayCar_v624 (28 October 2026)\n")
        f.write(f"# Pure quads: {len(Q_)}, Vertices: {len(P)}\n")
        for v in P:
            f.write(f"v {v[0]:.6f} {v[1]:.6f} {v[2]:.6f}\n")
        curr_g = None
        for q, n in zip(Q_, names):
            if n != curr_g:
                curr_g = n
                f.write(f"g {curr_g}\n")
            f.write(f"f {q[0]+1} {q[1]+1} {q[2]+1} {q[3]+1}\n")
    print(f"Saved {out_obj}")

    # 5. Run AnimReview
    prm = load_review_params(os.path.join(base_dir, "work/car/trim_params.json"))
    topo_prm = TC.load_params(os.path.join(base_dir, "work/car/trim_params.json"))
    wheels = json.load(open(os.path.join(base_dir, "work/car/wheel_params.json")))

    Nc, Tc = np.unique(names_arr, return_inverse=True)
    Pc, Cc, Ic = P, np.array([len(q) for q in Q_], np.int32), np.array([v for q in Q_ for v in q], np.int32)
    rep = review(Pc, Cc, Ic, Tc, Nc, wheels, prm, topo_prm)
    audit_path = os.path.join(base_dir, "versions/Audit_v624.json")
    json.dump(rep, open(audit_path, "w"), indent=2)
    print(f"AnimReview: passed {rep['passed']} / {rep['total']}, all_pass={rep['all_pass']}")
    for g in rep["gates"]:
        if not g["ok"]:
            print("  FAILED GATE:", g)

    # 6. Run SheetScore
    fdir = os.path.join(base_dir, "work/car/frame/")
    meta = json.load(open(fdir + "frame.json"))

    faces_tri = []
    for q in Q_:
        faces_tri.append([q[0], q[1], q[2]])
        faces_tri.append([q[0], q[2], q[3]])
    faces_tri = np.array(faces_tri, dtype=np.int32)

    mr = Raster.Renderer(P, faces_tri)
    sheet_scores = {}
    for v in meta["views"]:
        vname = v["name"]
        mref = np.asarray(Image.open(os.path.join(fdir, f"mask_{vname}.png"))) > 127
        M, _ = SheetScore.render_in_panel(mr, meta, v, mref.shape)
        M = ndi.binary_fill_holes(M)
        inter = (M & mref).sum()
        union = (M | mref).sum()
        sheet_scores[vname] = round(float(inter / max(union, 1)), 4)
    print("SheetScore IoU:", sheet_scores)
    mean_iou = round(float(np.mean(list(sheet_scores.values()))), 4)
    print("Mean SheetScore IoU:", mean_iou)

    # 7. Run WireframeScoreRef3
    from WireframeScoreRef3 import compute_wireframe_score_ref3
    wf_scores = compute_wireframe_score_ref3(out_npz)
    mean_rec = np.mean([val["rec"] for val in wf_scores.values()])
    mean_prec = np.mean([val["prec"] for val in wf_scores.values()])
    mean_f1 = np.mean([val["f1"] for val in wf_scores.values()])
    print(f"Wireframe Recall ref3: mean={mean_rec*100:.2f}%, prec={mean_prec*100:.2f}%, f1={mean_f1:.4f}")

    return rep["all_pass"], mean_iou, mean_rec

if __name__ == "__main__":
    ok, iou, rec = build_v624()
    if not ok:
        sys.exit(1)
