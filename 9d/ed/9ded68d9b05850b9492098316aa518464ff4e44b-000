<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CMY 2.0 : 4 archétypes pour tout mailler en quadrangles</title>
<style>
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Regular.woff2') format('woff2');font-weight:100 450;font-style:normal}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Medium.woff2') format('woff2');font-weight:451 599;font-style:normal}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Bold.woff2') format('woff2');font-weight:600 900;font-style:normal}
:root{
  --font:'Adobe Clean','Hiragino Sans W4',sans-serif;
  --paper:#f5f4f1; --ink:#15171c; --mute:#5c616b; --line:#dad8d2; --card:#ffffff; --soft:#eceae4;
  --cyan:#0ea5b5; --mag:#d92d7a; --yel:#e0a100; --ok:#16a34a; --r:14px; --t:.2s;
}
:root[data-theme="dark"]{
  --paper:#121317; --ink:#f0efe9; --mute:#9aa0ab; --line:#292d36; --card:#1a1c22; --soft:#23262f;
  --cyan:#38d9e8; --mag:#f45b9a; --yel:#ffd60a; --ok:#4ade80;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#121317; --ink:#f0efe9; --mute:#9aa0ab; --line:#292d36; --card:#1a1c22; --soft:#23262f;
    --cyan:#38d9e8; --mag:#f45b9a; --yel:#ffd60a; --ok:#4ade80;
  }
}
@media (prefers-reduced-motion: reduce){ :root{ --t:0s } }
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:16px;line-height:1.55;font-synthesis:none;transition:background var(--t),color var(--t)}
main{max-width:1320px;margin:0 auto;padding:34px 22px 64px}
header.top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap;margin-bottom:18px}
h1{font-size:clamp(28px,3.5vw,40px);font-weight:500;line-height:1.12;margin:0}
.stamp{font-size:13px;color:var(--mute);margin-top:6px}
.theme-btn{border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit;font-size:14px;padding:9px 15px;border-radius:999px;cursor:pointer;min-height:40px;transition:all var(--t)}
.prose{max-width:74ch;margin-bottom:24px}
.prose p{margin:0 0 12px}
.sandbox{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:16px;margin-bottom:26px;align-items:start}
@media (max-width:940px){ .sandbox{grid-template-columns:1fr} }
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:16px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.tab{border:1px solid var(--line);background:transparent;color:var(--ink);font:inherit;font-size:14px;padding:8px 14px;border-radius:999px;cursor:pointer;min-height:38px;transition:all var(--t)}
.tab[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink);font-weight:500}
canvas#cmyCanvas{width:100%;height:auto;display:block;border-radius:10px;background:#10141c;border:1px solid var(--line)}
.panel{display:flex;flex-direction:column;gap:14px}
.ctrl{display:flex;flex-direction:column;gap:5px}
.ctrl label{display:flex;justify-content:space-between;font-size:13px;color:var(--mute)}
.ctrl output{color:var(--ink);font-weight:500}
input[type=range]{width:100%;accent-color:var(--ink);margin:0}
.legend-list{display:flex;flex-direction:column;gap:8px;font-size:14px;padding-top:8px;border-top:1px solid var(--line)}
.leg-item{display:flex;align-items:center;gap:10px}
.swatch{width:14px;height:14px;border-radius:4px;flex:none}
.schema-card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:14px;margin-bottom:24px}
.schema-card svg{width:100%;height:auto;display:block;border-radius:10px}
svg text{font-family:var(--font)}
.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
@media (max-width:960px){ .gallery{grid-template-columns:1fr} }
.gitem{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.gitem img{width:100%;height:auto;display:block}
.gitem figcaption{padding:12px 14px;font-size:14px;color:var(--mute)}
.gitem strong{color:var(--ink);display:block;margin-bottom:2px}
</style>
</head>
<body>
