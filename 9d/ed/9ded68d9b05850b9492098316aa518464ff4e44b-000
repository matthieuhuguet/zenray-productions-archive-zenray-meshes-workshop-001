<script>
const root = document.documentElement;
document.getElementById('themeBtn').addEventListener('click', () => {
  const darkNow = root.getAttribute('data-theme') === 'dark' ||
    (!root.getAttribute('data-theme') && matchMedia('(prefers-color-scheme: dark)').matches);
  root.setAttribute('data-theme', darkNow ? 'light' : 'dark');
});

const cv = document.getElementById('cmyCanvas');
const ctx = cv.getContext('2d');
let arch = 'A', layer = 'cmy', cyanN = 8, fwhm = 0.75, bend = 0.45;

const summaries = {
  A: '472 quads purs · Jacobien médian 0,992',
  B: '1 613 px plis + 11 lignes cyan 0 croisement',
  C: '414 quads · 0 torsion Bishop · Couture ventrale',
  D: '486 quads + 30 cartes · Erreur Da Vinci 0,0'
};

function drawArch() {
  const W = cv.width, H = cv.height;
  ctx.clearRect(0, 0, W, H);
  ctx.fillStyle = '#111622';
  ctx.fillRect(0, 0, W, H);

  if (layer === 'uv') {
    // Crisp straight M1 UV island schematic for chosen archetype
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.strokeRect(180, 40, 520, 380);
    ctx.fillStyle = '#38d9e8'; ctx.font = '15px Adobe Clean, sans-serif';
    ctx.fillText('Espace UV UDIM 1001 · Îlot droit sans distorsion (' + arch + ')', 192, 66);
    const cols = cyanN, rows = 8;
    const ux = 240, uy = 95, uw = 400, uh = 290;
    for (let i = 0; i < cols; i++) {
      for (let j = 0; j < rows; j++) {
        if (arch === 'A' && ((i < 2 && j < 2) || (i === Math.floor(cols / 2) && j === 3))) continue;
        ctx.fillStyle = arch === 'D' && i >= cols - 2 ? 'rgba(74,222,128,0.34)' : 'rgba(56,217,232,0.24)';
        ctx.strokeStyle = '#38d9e8';
        ctx.lineWidth = 1.3;
        ctx.fillRect(ux + (i / cols) * uw, uy + (j / rows) * uh, uw / cols, uh / rows);
        ctx.strokeRect(ux + (i / cols) * uw, uy + (j / rows) * uh, uw / cols, uh / rows);
      }
    }
    ctx.strokeStyle = '#ffd60a'; ctx.lineWidth = 3;
    ctx.strokeRect(ux, uy, uw, uh);
    return;
  }

  ctx.save();
  if (arch === 'A') {
    // Symmetric Shell with U-notch + Slot
    const ox = 170, oy = 70, pw = 540, ph = 320;
    ctx.beginPath();
    ctx.moveTo(ox, oy + 70);
    ctx.lineTo(ox + pw * 0.42, oy + 70);
    ctx.lineTo(ox + pw * 0.42, oy);
    ctx.lineTo(ox + pw, oy);
    ctx.lineTo(ox + pw, oy + ph - bend * 30);
    ctx.quadraticCurveTo(ox + pw * 0.5, oy + ph + bend * 40, ox, oy + ph - bend * 30);
    ctx.closePath();
    ctx.fillStyle = layer === 'quads' ? 'rgba(56,217,232,0.16)' : 'rgba(244,91,154,0.12)';
    ctx.fill();
    ctx.strokeStyle = '#f45b9a'; ctx.lineWidth = 3; ctx.stroke();
    // Side slot
    ctx.fillStyle = '#111622'; ctx.fillRect(ox + pw * 0.62, oy + 125, 42, 72);
    ctx.strokeStyle = '#f45b9a'; ctx.strokeRect(ox + pw * 0.62, oy + 125, 42, 72);
    // Cyan streamlines
    ctx.strokeStyle = '#38d9e8'; ctx.lineWidth = 1.6;
    for (let k = 1; k < cyanN; k++) {
      const tx = k / cyanN;
      const gx = ox + tx * pw;
      const gy0 = tx < 0.42 ? oy + 70 : oy;
      ctx.beginPath(); ctx.moveTo(gx, gy0); ctx.lineTo(gx, oy + ph - 12); ctx.stroke();
    }
    if (layer === 'quads') {
      for (let r = 1; r < 6; r++) {
        const gy = oy + (r / 6) * ph;
        ctx.beginPath(); ctx.moveTo(gy < oy + 70 ? ox + pw * 0.42 : ox, gy); ctx.lineTo(ox + pw, gy); ctx.stroke();
      }
    }
    // Yellow symmetry & bottom edge
    ctx.strokeStyle = '#ffd60a'; ctx.lineWidth = 2 + fwhm * 3.5;
    ctx.beginPath(); ctx.moveTo(ox, oy + 70); ctx.lineTo(ox, oy + ph - bend * 30); ctx.stroke();
  } else if (arch === 'B') {
    // Asymmetric Curved Plate (Arm_Flare)
    const cx = 440, cy = 230;
    ctx.beginPath();
    ctx.moveTo(150, cy + 10);
    ctx.bezierCurveTo(220, 90 - bend * 30, 560, 100, 740, cy + 15);
    ctx.bezierCurveTo(560, 360 + bend * 30, 260, 380, 150, cy + 10);
    ctx.closePath();
    ctx.fillStyle = 'rgba(56,217,232,0.14)'; ctx.fill();
    ctx.strokeStyle = '#f45b9a'; ctx.lineWidth = 3; ctx.stroke();
    ctx.strokeStyle = '#38d9e8'; ctx.lineWidth = 1.6;
    for (let k = 1; k < cyanN; k++) {
      const t = k / cyanN, gx = 150 + t * 590;
      const spread = Math.sin(t * Math.PI) * (120 + bend * 25);
      ctx.beginPath(); ctx.moveTo(gx, cy - spread); ctx.lineTo(gx, cy + spread); ctx.stroke();
    }
    ctx.strokeStyle = '#ffd60a'; ctx.lineWidth = 2 + fwhm * 4;
    ctx.beginPath(); ctx.moveTo(168, cy); ctx.quadraticCurveTo(450, cy - 38 - bend * 24, 725, cy + 14); ctx.stroke();
    ctx.strokeStyle = '#ff9f1c'; ctx.lineWidth = 1.8 + fwhm * 3.2;
    ctx.beginPath(); ctx.moveTo(320, cy + 52); ctx.quadraticCurveTo(520, cy + 32, 720, cy + 15); ctx.stroke();
  } else if (arch === 'C') {
    // Organic S-Limb Bishop Tube
    const nSeg = cyanN + 4;
    ctx.strokeStyle = '#38d9e8'; ctx.lineWidth = 1.6;
    let prevTop = null, prevBot = null;
    for (let i = 0; i <= nSeg; i++) {
      const t = i / nSeg;
      const x = 140 + t * 600;
      const yMid = 230 + Math.sin(t * Math.PI * 2) * (25 + bend * 45);
      const rad = 68 * (1 - 0.62 * Math.pow(t, 1.1));
      ctx.beginPath(); ctx.ellipse(x, yMid, 12, rad, 0, 0, Math.PI * 2); ctx.stroke();
      const ptT = [x, yMid - rad], ptB = [x, yMid + rad];
      if (layer === 'quads' && prevTop) {
        ctx.beginPath(); ctx.moveTo(prevTop[0], prevTop[1]); ctx.lineTo(ptT[0], ptT[1]); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(prevBot[0], prevBot[1]); ctx.lineTo(ptB[0], ptB[1]); ctx.stroke();
      }
      prevTop = ptT; prevBot = ptB;
    }
    // Gold dorsal keel
    ctx.strokeStyle = '#ffd60a'; ctx.lineWidth = 2 + fwhm * 4;
    ctx.beginPath();
    for (let i = 0; i <= nSeg; i++) {
      const t = i / nSeg, x = 140 + t * 600;
      const yMid = 230 + Math.sin(t * Math.PI * 2) * (25 + bend * 45) - 68 * (1 - 0.62 * Math.pow(t, 1.1));
      if (i === 0) ctx.moveTo(x, yMid); else ctx.lineTo(x, yMid);
    }
    ctx.stroke();
  } else if (arch === 'D') {
    // Da Vinci Branching Tree + Leaf Cards
    ctx.strokeStyle = '#d4a373'; ctx.lineWidth = 18; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(440, 410); ctx.lineTo(440, 250); ctx.stroke();
    ctx.lineWidth = 11;
    ctx.beginPath(); ctx.moveTo(440, 250); ctx.lineTo(310 - bend * 40, 125); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(440, 250); ctx.lineTo(570 + bend * 40, 130); ctx.stroke();
    // Magenta fork collar
    ctx.strokeStyle = '#f45b9a'; ctx.lineWidth = 2.5;
    ctx.strokeRect(416, 226, 48, 46);
    // Cyan rings
    ctx.strokeStyle = '#38d9e8'; ctx.lineWidth = 1.6;
    for (let k = 1; k <= Math.min(cyanN, 10); k++) {
      const y = 400 - k * 14;
      ctx.beginPath(); ctx.moveTo(426, y); ctx.lineTo(454, y); ctx.stroke();
    }
    // Yellow leaf card anchors + green cards
    const tips = [[310 - bend * 40, 125], [570 + bend * 40, 130]];
    tips.forEach(([tx, ty]) => {
      for (let c = 0; c < 6; c++) {
        const ax = tx + Math.cos(c * 1.1) * 34, ay = ty + Math.sin(c * 1.4) * 26;
        ctx.fillStyle = 'rgba(74,222,128,0.45)'; ctx.strokeStyle = '#4ade80'; ctx.lineWidth = 1.4;
        ctx.fillRect(ax - 16, ay - 10, 32, 20); ctx.strokeRect(ax - 16, ay - 10, 32, 20);
        ctx.fillStyle = '#ffd60a'; ctx.beginPath(); ctx.arc(ax, ay, 3, 0, Math.PI * 2); ctx.fill();
      }
    });
  }
  ctx.restore();
}

document.querySelectorAll('[data-arch]').forEach(b => b.addEventListener('click', () => {
  arch = b.dataset.arch;
  document.querySelectorAll('[data-arch]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  document.getElementById('archSummary').textContent = summaries[arch];
  drawArch();
}));
document.querySelectorAll('[data-layer]').forEach(b => b.addEventListener('click', () => {
  layer = b.dataset.layer;
  document.querySelectorAll('[data-layer]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  drawArch();
}));
document.getElementById('slCyan').addEventListener('input', e => { cyanN = +e.target.value; document.getElementById('outCyan').textContent = cyanN; drawArch(); });
document.getElementById('slFwhm').addEventListener('input', e => { fwhm = +e.target.value / 100; document.getElementById('outFwhm').textContent = fwhm.toFixed(2).replace('.', ','); drawArch(); });
document.getElementById('slBend').addEventListener('input', e => { bend = +e.target.value / 100; document.getElementById('outBend').textContent = e.target.value + ' %'; drawArch(); });

const qs = new URLSearchParams(location.search);
if (qs.get('theme')) root.setAttribute('data-theme', qs.get('theme'));
if (qs.get('arch')) document.querySelector(`[data-arch="${qs.get('arch')}"]`)?.click();
if (qs.get('layer')) document.querySelector(`[data-layer="${qs.get('layer')}"]`)?.click();
drawArch();
</script>
</body>
</html>
