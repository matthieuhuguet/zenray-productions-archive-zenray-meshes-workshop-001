"""28 October 2026, 03:20 : ZenRay Meshes finishing, CURVE SNAP, pin the lateral edge of several parts on ONE smooth curve (x(z), y(z)) and its mirror.
Per part and per side, the seam vertices are the vertices within --edge-band-m of the part's lateral extreme in each z slice ; each moves in x and y
onto the curve at its own z, and every other vertex of the part takes the move of its nearest seam vertex, faded to 0 at --falloff-m (smoothstep),
as SnapSide.py does, so no tooth appears. FR : épingle le bord latéral de plusieurs pièces sur une seule courbe lisse, symétrique.
python CurveSnap.py <in.npz> <out.npz> <curve_L.npy> --parts A,B,C [--z-range lo,hi] [--falloff-m 0.06] [--edge-band-m 0.012] [--max-mm 60]
"""
import argparse
import json

import numpy as np
from scipy.spatial import cKDTree


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("inp"); ap.add_argument("out"); ap.add_argument("curve")
    ap.add_argument("--parts", default="CAR_body_glass_windshield_C,CAR_body_roof_C,CAR_body_glass_rear_C")
    ap.add_argument("--z-range", default="")
    ap.add_argument("--falloff-m", type=float, default=0.06)
    ap.add_argument("--edge-band-m", type=float, default=0.012)
    ap.add_argument("--max-mm", type=float, default=60.0)
    ap.add_argument("--inner", action="store_true", help="seam = the part's INNER lateral extreme (a rail lying outside the curve)")
    a = ap.parse_args()
    d = np.load(a.inp, allow_pickle=True); P = d["P"].astype(float); names = np.array([str(x) for x in d["names"]])
    C = np.load(a.curve); C = C[np.argsort(C[:, 2])]
    lo, hi = (float(v) for v in a.z_range.split(",")) if a.z_range else (C[0, 2], C[-1, 2])
    rep = {}
    for part in a.parts.split(","):
        V = np.array(sorted({v for q, m in zip(d["Q"], names) if m == part for v in q}))
        if not len(V):
            rep[part] = "missing"; continue
        X = P[V]; disp = np.zeros_like(X); gaps = []
        for side in (1.0, -1.0):
            seam = []
            for zc in np.arange(lo, hi, 0.004):
                sl = np.nonzero((np.abs(X[:, 2] - zc) < 0.002) & (X[:, 0] * side > 0.25))[0]
                if len(sl):
                    s = X[sl, 0] * side
                    sel = s < s.min() + a.edge_band_m if a.inner else s > s.max() - a.edge_band_m
                    seam.extend(sl[sel])
            seam = np.unique(seam)
            if not len(seam):
                continue
            zt = X[seam, 2]
            tx = side * np.interp(zt, C[:, 2], C[:, 0]); ty = np.interp(zt, C[:, 2], C[:, 1])
            g = np.stack([tx - X[seam, 0], ty - X[seam, 1], np.zeros(len(seam))], 1)
            ok = np.linalg.norm(g, axis=1) * 1000 < a.max_mm; seam, g = seam[ok], g[ok]
            gaps += list(np.linalg.norm(g, axis=1) * 1000)
            r, k = cKDTree(X[seam]).query(X)
            w = np.clip(1 - r / a.falloff_m, 0, 1); w = w * w * (3 - 2 * w)
            m = X[:, 0] * side > 0
            disp[m] = (w[:, None] * g[k])[m]
        P[V] = X + disp
        rep[part] = {"seam_gap_mm_p50_max": [round(float(np.median(gaps)), 1), round(float(max(gaps)), 1)] if gaps else None}
    np.savez(a.out, P=P.astype(np.float32), Q=d["Q"], names=d["names"])
    print(json.dumps(rep))


if __name__ == "__main__":
    main()
