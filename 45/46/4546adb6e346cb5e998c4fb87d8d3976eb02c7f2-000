"""Pass 8 : verifier of the writing rules of the mission, on markdown / json / python files. Written 30 October 2026.
Usage : python3 -I check_rules.py files=a.md,b.json   -> JSON report, exit code 0 = green, 1 = red.
Rules : (1) no em dash, no en dash ; (2) no run of two hyphens outside table separator rows ; (3) in markdown, every non-empty line outside
code fences carries the date '30 October 2026' ; (4) no numeric year-month-day date outside code ;
(5) json files parse. A built in self test feeds a deliberately bad text and must turn red. FR : regles de forme, testees dans les deux sens."""
import sys, re, json

DATE = "30 October 2026"


def check_text(name, text):
    problems = []
    fence = False
    is_md = name.endswith(".md")
    for n, ln in enumerate(text.split("\n"), 1):
        if ln.strip().startswith("```"):
            fence = not fence; continue
        if chr(0x2014) in ln or chr(0x2013) in ln:
            problems.append((n, "dash"))
        sep = bool(re.fullmatch(r"\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*", ln)) and "|" in ln
        if ("-" * 2) in ln and not sep:
            problems.append((n, "double hyphen"))
        hdr = bool(re.search(r"\|\s*Date\s*\|\s*$", ln))              # table header row whose last column is the date column
        if is_md and not fence and ln.strip() and DATE not in ln and not sep and not hdr:
            problems.append((n, "no date"))
        if is_md and not fence and re.search(r"\b2026-\d\d-\d\d\b", ln):
            problems.append((n, "numeric date"))
    return problems


def main(a):
    rep = {}; ok = True
    for f in a["files"].split(","):
        t = open(f).read(); pr = check_text(f, t)
        if f.endswith(".json"):
            try: json.loads(t)
            except Exception as e: pr.append((0, "json " + str(e)[:40]))
        rep[f] = pr[:8] + ([("...", len(pr))] if len(pr) > 8 else []); ok &= not pr
    # self test : bad text must be red, good text must be green
    bad = "Titre\n" + chr(0x2014) + " mauvais " + "-" * 2 + " texte 2026" + "-10-30\n"
    good = "Titre (%s)\nTexte correct (%s)\n" % (DATE, DATE)
    st = bool(check_text("x.md", bad)) and not check_text("x.md", good)
    rep["self_test_two_ways"] = st
    print(json.dumps({"green": ok and st, "report": rep}, ensure_ascii=False, indent=1))
    return 0 if ok and st else 1


if __name__ == "__main__":
    sys.exit(main(dict(kv.split("=", 1) for kv in sys.argv[1:])))
