"""E2b' : borne de l'information d'ombrage multivue (H3 corrigée). Segmentation de facettes SUPPOSÉE parfaite (identifiants de vérité), lumière calibrée sur K facettes de normale connue,
normales des autres facettes par intersection des équations (b + h y).n = I - a vues dans 2 vues ou plus. Balayage du bruit, de K et de la distance de la lumière. 30 October 2026."""
import sys, json
import numpy as np
from scipy.optimize import least_squares
sys.path.insert(0, ".")
from e2_common import *

def region_stats(case, imgs, min_px=250):
    """Par facette de vérité (identifiant global de plan) et par vue : intensité médiane, nombre de pixels."""
    st = {}
    for nm in VIEWS6:
        fid = case["views"][nm]["fid"]; I = imgs[nm]
        for f in np.unique(fid[fid >= 0]):
            m = fid == f
            if m.sum() >= min_px: st[(f, nm)] = (float(np.median(I[m])), int(m.sum()))
    return st

def normals_of(case):
    n = np.concatenate([P.n for P in case["car"].pieces]); return n

def fit_light(known, st, N, nm):
    """I = a + h n_y + max(0, b.n) sur les facettes connues vues dans la vue nm."""
    rows = [(N[f], st[(f, nm)][0], st[(f, nm)][1]) for f in known if (f, nm) in st]
    if len(rows) < 5: return None
    Nn = np.array([r[0] for r in rows]); y = np.array([r[1] for r in rows]); w = np.sqrt([r[2] for r in rows]); w = w / w.max()
    X = np.c_[np.ones(len(y)), Nn]; c, *_ = np.linalg.lstsq(X * w[:, None], y * w, rcond=None)
    th0 = np.r_[c[0], 0.0, c[1:]]
    f = lambda th: w * (th[0] + th[1] * Nn[:, 1] + np.clip(Nn @ th[2:], 0, None) - y)
    sol = least_squares(f, th0, max_nfev=200)
    return sol.x

def solve_normal(eqs, dirs, seed=1):
    def cost(t):
        n = np.array([np.sin(t[0]) * np.cos(t[1]), np.cos(t[0]), np.sin(t[0]) * np.sin(t[1])])
        return np.array([bb @ n - cc for bb, cc in eqs])
    rng = np.random.default_rng(seed); best = None
    for _ in range(40):
        sol = least_squares(cost, [rng.uniform(0.1, np.pi - 0.1), rng.uniform(0, 2 * np.pi)])
        n = np.array([np.sin(sol.x[0]) * np.cos(sol.x[1]), np.cos(sol.x[0]), np.sin(sol.x[0]) * np.sin(sol.x[1])])
        if any(n @ d < 0.05 for d in dirs): continue
        if best is None or sol.cost < best[0] - 1e-12: best = (sol.cost, n)
    return None if best is None else best[1]

def run(noise, K, dist, seed=0, trials=3):
    errs = []; errs_sym = []; solved = 0; total = 0
    for t in range(trials):
        case = make_case(noise_img=0.0, seed=seed + t)
        imgs = clay_from_views(case["views"], light_dist=dist, noise=noise, rng=np.random.default_rng(seed + 10 * t))
        st = region_stats(case, imgs)
        N = normals_of(case)
        facets = sorted({f for (f, nm) in st})
        rng = np.random.default_rng(100 + t)
        # facettes connues : K facettes tirées parmi les plus grandes (normales de vérité) ; les autres sont à retrouver
        area = {f: sum(st[(f, nm)][1] for nm in VIEWS6 if (f, nm) in st) for f in facets}
        big = sorted(facets, key=lambda f: -area[f])[:max(K, 5)]
        known = list(rng.choice(big, size=min(K, len(big)), replace=False))
        lights = {nm: fit_light(known, st, N, nm) for nm in VIEWS6}
        est = {}
        for f in facets:
            if f in known: continue
            total += 1
            eqs = []; dirs = []
            for nm in VIEWS6:
                if (f, nm) not in st or lights[nm] is None: continue
                a, h = lights[nm][0], lights[nm][1]; b = lights[nm][2:]
                I = st[(f, nm)][0]
                if I - a < 0.03 + abs(h): continue
                eqs.append((b + h * np.array([0, 1.0, 0]), I - a)); dirs.append(case["views"][nm]["frame"][2])
            if len(eqs) < 2: continue
            n = solve_normal(eqs, dirs)
            if n is None: continue
            solved += 1; est[f] = n
            errs.append(float(np.degrees(np.arccos(np.clip(n @ N[f], -1, 1)))))
    return {"noise": noise, "K": K, "light_dist_m": dist, "facets_total": total, "facets_solved": solved, "err_median_deg": float(np.median(errs)) if errs else None,
            "err_p90_deg": float(np.percentile(errs, 90)) if errs else None, "share_under_3deg": float(np.mean(np.array(errs) < 3)) if errs else None}

if __name__ == "__main__":
    out = []
    for dist in (1e4, 6.0):
        for K in (8, 14):
            for noise in (0.0, 0.005, 0.01, 0.02):
                r = run(noise, K, dist); out.append(r)
                print({k: (round(v, 2) if isinstance(v, float) else v) for k, v in r.items()}, flush=True)
    json.dump(out, open("out/e2b_bound.json", "w"), indent=1)
