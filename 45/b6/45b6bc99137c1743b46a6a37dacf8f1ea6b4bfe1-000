# 26 October 2026 : ZenRay Meshes, LINE GAPS : the reference lines the model misses (red pixels of the LineScore board),
# grouped into connected strokes and reported in world units (lateral, height) with their length, longest first, per view.
# It turns "the score says 0.69" into "the sheet draws a 2.2 m straight crease from (0.9, 0.26) to (-1.29, 0.47) that the
# model does not have". FR : les traits de la planche absents du modèle, en mètres, du plus long au plus court.
# Usage: python LineGaps.py <frame_dir> <lines_board.png> <lines.json> [views=left,right] [min_len_m=0.25] [top=8]
import sys, os, json
import numpy as np
from PIL import Image
from scipy import ndimage as ndi


def main(fdir, board, lines_json, views="left,right", min_len=0.25, top=8):
    min_len = float(min_len); top = int(top)
    meta = json.load(open(os.path.join(fdir, "frame.json"))); L = json.load(open(lines_json)); B = np.asarray(Image.open(board).convert("RGB")).astype(int)
    lo = np.array(meta["lo"]); D = np.array(meta["dims_m"]); hi = lo + D; out = {}
    for v in meta["views"]:
        if v["name"] not in views.split(","): continue
        y0 = L[v["name"]]["tile_y0"]; nxt = sorted(L[k]["tile_y0"] for k in L if isinstance(L[k], dict) and L[k].get("tile_y0", -1) > y0)
        T = B[y0: nxt[0] if nxt else B.shape[0]]
        red = (T[..., 0] == 220) & (T[..., 1] == 60) & (T[..., 2] == 60)
        lab, n = ndi.label(ndi.binary_dilation(red, iterations=2))   # strokes broken by matched pixels are rejoined over 2 px
        rx, uy = np.array(v["rx"]), np.array(v["uy"]); a, b = int(np.argmax(np.abs(rx))), int(np.argmax(np.abs(uy)))
        umin = lo[a] if rx[a] > 0 else -hi[a]; vmax = hi[b] if uy[b] > 0 else -lo[b]; ucen, vcen = umin + D[a] / 2, vmax - D[b] / 2
        s = v["px_per_m"]; bb = v["bbox"]; xc, yc = (bb[0] + bb[2]) / 2, (bb[1] + bb[3]) / 2
        res = []
        for k in range(1, n + 1):
            rr, cc = np.where((lab == k) & red)
            if len(rr) < 3: continue
            U = ucen + (cc - xc) / s; V = vcen + (yc - rr) / s
            P = np.stack([U, V], 1); c = P.mean(0); w, e = np.linalg.eigh(np.cov((P - c).T)); d = e[:, -1]; t = (P - c) @ d
            ln = float(t.max() - t.min())
            if ln < min_len: continue
            p0, p1 = c + t.min() * d, c + t.max() * d
            res.append({"len_m": round(ln, 2), "from": [round(float(x), 3) for x in p0], "to": [round(float(x), 3) for x in p1], "px": int(len(rr)),
                        "straightness": round(float(np.sqrt(max(w[0], 0))), 4)})
        res.sort(key=lambda r: -r["len_m"]); out[v["name"]] = res[:top]
    print(json.dumps(out, indent=1))


if __name__ == "__main__":
    main(*sys.argv[1:])
