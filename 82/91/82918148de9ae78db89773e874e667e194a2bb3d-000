Non-destructive reference patch module ready to be imported by:
  - /Users/zenray/.claude/skills/zenray-meshes/scripts/v5/GeminiBridge.py (on POST /save)
  - /Users/zenray/.claude/skills/zenray-meshes/scripts/v5/OnePictureIsolate.py (post-isolation gate)

Validates 4/5 orthographic views BEFORE contour/CMY drawing starts:
  1. Square aspect ratio per view (catches I_008 left=0.75, top=2.00 drift)
  2. Neutral background uniformity & clean main foreground silhouette without frame border clipping
  3. Horizontal Mirror IoU (Front vs horizontally flipped Back silhouette)
  4. Epipolar span lock: Front_H vs Left_H, Front_H vs Back_H, Front_W vs Top_W
  5. Auto-computes per-view scale correction hints (zoom_left, zoom_top, zoom_back)
"""
import json
import sys
from pathlib import Path

import numpy as np
from PIL import Image
from scipy import ndimage as ndi


DEFAULT_PARAMS = {
    "max_aspect_err": 0.04,
    "max_bg_std": 14.0,
    "min_border_margin_px": 2,
    "min_mirror_iou": 0.85,
    "max_height_ratio_err": 0.12,
    "max_width_ratio_err": 0.14,
    "pass_score": 0.80,
}


def extract_fg_mask(im_rgb: Image.Image):
    """Segment foreground object using border ring median color and largest connected component."""
    arr = np.asarray(im_rgb, dtype=np.float32)
    h, w, _ = arr.shape
    border = np.concatenate([
        arr[0:6, :].reshape(-1, 3),
        arr[-6:, :].reshape(-1, 3),
        arr[:, 0:6].reshape(-1, 3),
        arr[:, -6:].reshape(-1, 3),
    ], axis=0)
    bg_col = np.median(border, axis=0)
    bg_std = float(np.mean(np.std(border, axis=0)))
    dist = np.linalg.norm(arr - bg_col, axis=2)
    raw = dist > max(8.0, 4.0 * bg_std)
    raw = ndi.binary_closing(raw, iterations=2)
    raw = ndi.binary_fill_holes(raw)
    lab, n = ndi.label(raw)
    if n == 0:
        return np.zeros((h, w), dtype=bool), bg_std, (0, 0, 0, 0), 0
    sizes = np.bincount(lab.ravel())
    sizes[0] = 0
    best = int(np.argmax(sizes))
    sig_islands = int((sizes[1:] > 0.01 * sizes[best]).sum())
    mask = (lab == best)
    ys, xs = np.nonzero(mask)
    bbox = (int(xs.min()), int(ys.min()), int(xs.max()) + 1, int(ys.max()) + 1)
    return mask, bg_std, bbox, sig_islands


def normalize_bbox_mask(mask: np.ndarray, bbox, side: int = 160) -> np.ndarray:
    x0, y0, x1, y1 = bbox
    if x1 <= x0 or y1 <= y0:
        return np.zeros((side, side), dtype=bool)
    crop = Image.fromarray(mask[y0:y1, x0:x1].astype(np.uint8) * 255).resize((side, side), Image.NEAREST)
    return np.asarray(crop) > 127


def evaluate_views(imgs: dict, params: dict = None) -> dict:
    """
    Evaluate {'front': PIL, 'back': PIL, 'left': PIL, 'top': PIL} (and optional 'right').
    Returns crisp traffic-light gate verdict + remediation hints + score in [0, 1].
    """
    P = dict(DEFAULT_PARAMS)
    if params:
        P.update(params)

    required = ("front", "back", "left", "top")
    missing = [k for k in required if k not in imgs]
    if missing:
        return {"status": "REJECT_REDO", "score": 0.0, "reasons": [f"missing views: {missing}"]}

    info = {}
    reasons = []
    for name, im in imgs.items():
        w, h = im.size
        aspect = w / float(max(h, 1))
        aspect_err = abs(aspect - 1.0)
        mask, bg_std, bbox, islands = extract_fg_mask(im.convert("RGB"))
        x0, y0, x1, y1 = bbox
        mpx = P["min_border_margin_px"]
        clipped = (x0 <= mpx) or (y0 <= mpx) or (x1 >= w - mpx) or (y1 >= h - mpx)
        w_frac = (x1 - x0) / float(max(w, 1))
        h_frac = (y1 - y0) / float(max(h, 1))
        info[name] = {
            "size": [w, h],
            "aspect": round(aspect, 4),
            "aspect_err": round(aspect_err, 4),
            "bg_std": round(bg_std, 2),
            "bbox": list(bbox),
            "w_frac": round(w_frac, 4),
            "h_frac": round(h_frac, 4),
            "clipped": bool(clipped),
            "islands": islands,
        }
        if aspect_err > P["max_aspect_err"]:
            reasons.append(f"{name}: non-square aspect {aspect:.3f}")
        if bg_std > P["max_bg_std"]:
            reasons.append(f"{name}: noisy background std={bg_std:.1f}")
        if w_frac < 0.05 or h_frac < 0.05:
            reasons.append(f"{name}: empty or tiny foreground ({w_frac:.2f}x{h_frac:.2f})")

        info[name]["_mask"] = mask

    mf = normalize_bbox_mask(info["front"]["_mask"], info["front"]["bbox"])
    mb = normalize_bbox_mask(info["back"]["_mask"], info["back"]["bbox"])[:, ::-1]
    mirror_iou = float((mf & mb).sum()) / float(max((mf | mb).sum(), 1))

    fh = max(info["front"]["h_frac"], 1e-6)
    fw = max(info["front"]["w_frac"], 1e-6)
    h_ratio_back = info["back"]["h_frac"] / fh
    h_ratio_left = info["left"]["h_frac"] / fh
    w_ratio_top = info["top"]["w_frac"] / fw

    if mirror_iou < P["min_mirror_iou"]:
        reasons.append(f"front/back mirror IoU too low ({mirror_iou:.3f} < {P['min_mirror_iou']})")
    if abs(h_ratio_left - 1.0) > P["max_height_ratio_err"]:
        reasons.append(f"epipolar height drift left/front ({h_ratio_left:.3f})")
    if abs(h_ratio_back - 1.0) > P["max_height_ratio_err"]:
        reasons.append(f"epipolar height drift back/front ({h_ratio_back:.3f})")
    if abs(w_ratio_top - 1.0) > P["max_width_ratio_err"]:
        reasons.append(f"epipolar width drift top/front ({w_ratio_top:.3f})")

    # Sub-scores (0..1)
    s_aspect = 1.0 if all(info[k]["aspect_err"] <= P["max_aspect_err"] for k in required) else 0.0
    s_mirror = min(1.0, max(0.0, (mirror_iou - 0.50) / (P["min_mirror_iou"] - 0.50)))
    s_epip = 1.0 if (
        abs(h_ratio_left - 1.0) <= P["max_height_ratio_err"]
        and abs(h_ratio_back - 1.0) <= P["max_height_ratio_err"]
        and abs(w_ratio_top - 1.0) <= P["max_width_ratio_err"]
    ) else 0.35
    s_bg = 1.0 if all(info[k]["bg_std"] <= P["max_bg_std"] for k in required) else 0.4
    score = round(0.30 * s_aspect + 0.30 * s_mirror + 0.25 * s_epip + 0.15 * s_bg, 3)

    # Strip internal numpy masks before returning JSON-safe dict
    for k in info:
        info[k].pop("_mask", None)

    zoom_hints = {
        "zoom_back": round(1.0 / max(h_ratio_back, 1e-4), 4),
        "zoom_left": round(1.0 / max(h_ratio_left, 1e-4), 4),
        "zoom_top": round(1.0 / max(w_ratio_top, 1e-4), 4),
    }

    if score >= P["pass_score"] and s_aspect == 1.0 and not any("empty" in r for r in reasons):
        status = "PASS"
    elif s_aspect == 1.0 and mirror_iou >= P["min_mirror_iou"] and abs(h_ratio_left - 1.0) <= 0.22 and abs(w_ratio_top - 1.0) <= 0.22:
        status = "AUTO_ZOOM_FIX"
    else:
        status = "REJECT_REDO"

    return {
        "status": status,
        "score": score,
        "mirror_iou_front_back": round(mirror_iou, 4),
        "epipolar": {
            "height_ratio_back": round(h_ratio_back, 4),
            "height_ratio_left": round(h_ratio_left, 4),
            "width_ratio_top": round(w_ratio_top, 4),
        },
        "zoom_hints": zoom_hints,
        "reasons": reasons,
        "views": info,
    }


def split_grid4(grid_img: Image.Image, margin: int = 12) -> dict:
    """Split a 2x2 Grid4 sheet: TL=front, TR=back, BL=left, BR=top (trimming divider crosshairs)."""
    w, h = grid_img.size
    hw, hh = w // 2, h // 2
    m = margin
    return {
        "front": grid_img.crop((m, m, hw - m, hh - m)),
        "back": grid_img.crop((hw + m, m, w - m, hh - m)),
        "left": grid_img.crop((m, hh + m, hw - m, h - m)),
        "top": grid_img.crop((hw + m, hh + m, w - m, h - m)),
    }


