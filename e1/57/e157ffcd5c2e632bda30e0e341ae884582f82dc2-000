            A, B = masks[a], masks[b]; B2 = B[:, ::-1] if flip else B[::-1, :]; im_ = gap(A, B2) if A.any() and B.any() else 0.0; cc = row["cells"][a][2]; line.setdefault("mirror", {})[f"{a}_{b}"] = round(im_, 1)
            if (A.sum() > 30 or B.sum() > 30) and im_ > r["dist_tol_frac"] * cc: reasons.append(f"{a} et {b} ne se répondent pas ({im_ / cc:.1%} de la case)")
