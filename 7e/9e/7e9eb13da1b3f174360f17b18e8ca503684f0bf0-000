            elif opts.get("merge"):                                                      # a rule : merge corners that snap together if at least 3 stay
                pass
            else: return {"fail": "corners snap together"}
    K = len(ci)
    if not 3 <= K <= 8: return {"fail": "true corners %d after snap" % K}
    sl = [(cum[ci[(k + 1) % K]] - cum[ci[k]]) % Ltot for k in range(K)]
    F = m["F"][Z]; used = np.unique(F); vid = {int(v): i for i, v in enumerate(used)}
    target = list(sl); cap_chord = {}
    if strip and K == 4 and opts.get("cap") == "narrow" and opts.get("cap_count", "chord") == "chord":              # the count of a cap follows its CHORD (the true width of the strip), not the length of the boundary run between its two corner vertices
        for k in range(4):
            a_, b_ = ci[k], ci[(k + 1) % 4]; chord = float(np.linalg.norm(Pb[a_] - Pb[b_])); inside = [t_ for t_ in tip_idx(cum, Ltot, tips) if (t_ - a_) % nB <= (b_ - a_) % nB]
            if inside and chord < sl[k]: target[k] = chord; cap_chord[k] = chord
    if opts.get("corners_only"): return dict(B=B, cum=cum, Ltot=Ltot, ci=ci, K=K, sl=sl, target=target, cap_chord=cap_chord, e=None, sp=None, normal=normal, F=F, used=used, vid=vid, strip=strip, raw=raw, Z=Z, nB=nB)      # the counts come from a global layout (shared arcs)
    lay = {"arcs": {"a%d" % k: float(target[k]) for k in range(K)}, "mirror": [], "patches": [{"name": "P", "sides": [["a%d" % k] for k in range(K)]}]}; sol = CT.solve(lay, edge)
    if not sol.get("ok"): return {"fail": "counts infeasible"}
    e = [int(sol["counts"]["a%d" % k]) for k in range(K)]; sp = sol["tarini"].get("P") if K != 4 else None
    return dict(B=B, cum=cum, Ltot=Ltot, ci=ci, K=K, sl=sl, e=e, sp=sp, normal=normal, F=F, used=used, vid=vid, strip=strip, raw=raw, Z=Z, nB=nB)


def strip_sections(m, pr, F, vid, n):
    """breakpoints (arc length offsets from the side start, e + 1 values) of ONE long side of a strip patch so that its lattice points face the uniform points of the other long side : the cross sections follow the harmonic coordinate x (Dirichlet on the two caps, free on the long sides). Returns {side: array}."""
    B, cum, Ltot, ci, K, sl, e = [pr[k] for k in ("B", "cum", "Ltot", "ci", "K", "sl", "e")]; nB = len(B); e0, e1 = e[0], e[1]; long_ = (0, 2) if e0 >= e1 else (1, 3); caps = tuple(s_ for s_ in range(4) if s_ not in long_)
    so = side_of(pr); bl = [vid[int(v)] for v in B]; capv = {c: [bl[bi] for bi in range(nB) if c in so[bi]] for c in caps}
    Wc = cot_weights(m["P"], F, vid); Dg = np.asarray(Wc.sum(1)).ravel(); Lap = (sps.diags(Dg) - Wc).tocsr(); fx = {}
    for v in capv[caps[0]]: fx[v] = 0.0
    for v in capv[caps[1]]: fx[v] = 1.0
    fidx = np.array(sorted(fx)); fv = np.array([fx[i] for i in fidx]); free = np.setdiff1d(np.arange(n), fidx); x = np.zeros(n); x[fidx] = fv; x[free] = spsolve(Lap[free][:, free].tocsc(), -(Lap[free][:, fidx] @ fv))
    def side_x(k):
        idx = [(ci[k] + t) % nB for t in range((ci[(k + 1) % K] - ci[k]) % nB + 1)]; s3 = np.array([(cum[i] - cum[ci[k]]) % Ltot for i in idx]); s3[-1] = sl[k]; xs = x[[bl[i] for i in idx]]; return s3, xs
    sA, xA = side_x(long_[0]); sB, xB = side_x(long_[1]); tt = np.arange(e[long_[0]] + 1) / e[long_[0]] * sl[long_[0]]
    inc_a = xA[-1] >= xA[0]; xa = np.maximum.accumulate(xA) if inc_a else np.minimum.accumulate(xA); xt = np.interp(tt, sA, xa)                  # x of the uniform points of side A
    # side B is traversed the other way round the loop : its j-th point faces the (e - j)-th point of A
    xt_b = xt[::-1]; inc_b = xB[-1] >= xB[0]; xb = np.maximum.accumulate(xB) if inc_b else np.minimum.accumulate(xB)
    if inc_b: sb = np.interp(xt_b, xb + 1e-12 * np.arange(len(xb)), sB)
    else: sb = np.interp(xt_b[::-1], xb[::-1] - 1e-12 * np.arange(len(xb))[::-1], sB[::-1])[::-1]
    sb = np.maximum.accumulate(sb); sb[0], sb[-1] = 0.0, sl[long_[1]]
    return {long_[1]: sb}


def side_of(pr):
    """side index (or two, at the corners) of every boundary vertex index."""
    ci, nB, K = pr["ci"], pr["nB"], pr["K"]; out = []
    for bi in range(nB):
        s = []
        for k in range(K):
            span = (ci[(k + 1) % K] - ci[k]) % nB
            if span == 0: span = nB
            if (bi - ci[k]) % nB <= span: s.append(k)
        out.append(s)
    return out


def lscm(P, T, pins):
    """least squares conformal map (Levy 2002) of the triangles T (indices into P), free boundary, pins = {vertex: (x, y)} ; returns (n, 2)."""
    n = len(P); rows = []; cols = []; vals = []; r = 0
    for t in T:
        a, b, c = P[t[0]], P[t[1]], P[t[2]]; e1 = b - a; l1 = np.linalg.norm(e1); x1 = e1 / max(l1, 1e-20); nn = np.cross(e1, c - a); A2 = np.linalg.norm(nn)
        if A2 < 1e-20: continue
        y1 = np.cross(nn / A2, x1); X = [(0.0, 0.0), (l1, 0.0), ((c - a) @ x1, (c - a) @ y1)]; w = np.sqrt(A2 / 2)
        for j in range(3):
            d = complex(X[(j + 2) % 3][0] - X[(j + 1) % 3][0], X[(j + 2) % 3][1] - X[(j + 1) % 3][1]) * w / A2 * 2
            vj = t[j]                                                                  # re: dr u - di v ; im: di u + dr v
            rows += [r, r, r + 1, r + 1]; cols += [vj, n + vj, vj, n + vj]; vals += [d.real, -d.imag, d.imag, d.real]
        r += 2
    M = sps.coo_matrix((vals, (rows, cols)), shape=(r, 2 * n)).tocsc(); fixed = sorted(pins); fidx = np.array(fixed + [n + f for f in fixed]); xfix = np.array([pins[f][0] for f in fixed] + [pins[f][1] for f in fixed])
    free = np.setdiff1d(np.arange(2 * n), fidx); A = M[:, free]; b = -M[:, fidx] @ xfix
    sol = spsolve((A.T @ A).tocsc() + 1e-12 * sps.identity(len(free), format="csc"), A.T @ b); X = np.zeros(2 * n); X[free] = sol; X[fidx] = xfix; return np.stack([X[:n], X[n:]], 1)


def locate_lift(U, T2, Pl, Q2, k=24):
    """barycentric lift of the planar points Q2 through the flattened triangles (U, T2) to the 3D vertices Pl : (P3 (m,3), unlocated count)."""
    cen = U[T2].mean(1); tree = cKDTree(cen); P3 = np.zeros((len(Q2), 3)); bad = 0; _, cand = tree.query(Q2, k=min(k, len(T2)))
    for qi, q in enumerate(Q2):
        found = False
        for t in np.atleast_1d(cand[qi]):
            a, b, c = U[T2[t]]; M = np.array([[b[0] - a[0], c[0] - a[0]], [b[1] - a[1], c[1] - a[1]]])
            if abs(np.linalg.det(M)) < 1e-18: continue
            l1, l2 = np.linalg.solve(M, q - a)
            if l1 >= -1e-6 and l2 >= -1e-6 and l1 + l2 <= 1 + 1e-6: P3[qi] = (1 - l1 - l2) * Pl[T2[t, 0]] + l1 * Pl[T2[t, 1]] + l2 * Pl[T2[t, 2]]; found = True; break
        if not found: t = int(np.atleast_1d(cand[qi])[0]); P3[qi] = Pl[T2[t]].mean(0); bad += 1
    return P3, bad


def fill(m, Z, edge, opts=OPTS, pr=None):
    """one patch of the region Z : (P3, Q, report) or (None, None, {"fail": ..}). embed : mvc (current), cot, neumann, dist, lscm."""
    pr = pr or prep(m, Z, edge, opts)
    if "fail" in pr: return None, None, pr
    B, cum, Ltot, ci, K, sl, e, sp, normal, F, used, vid = [pr[k] for k in ("B", "cum", "Ltot", "ci", "K", "sl", "e", "sp", "normal", "F", "used", "vid")]
    Pl = m["P"][used]; T2 = np.array([[vid[int(a)] for a in t] for t in F]); embed = opts.get("embed", "mvc"); nB = len(B); n = len(used)
    if K != 4 and embed not in ("mvc", "cot"): embed = "mvc"
    if embed in ("sect", "neumann", "dist", "lscm") and not pr["strip"] and not opts.get("all_k4"): embed = "mvc"
    V = cyclic_polygon(e); S2 = [V[k] + (V[(k + 1) % K] - V[k]) * (np.arange(e[k] + 1) / e[k])[:, None] for k in range(K)]
    if embed in ("mvc", "cot", "sect"):
        bps = dict(pr.get("bps") or {})
        if embed == "sect" and K == 4 and not bps: bps = strip_sections(m, pr, F, vid, n)
        uv = {}
        for bi, v in enumerate(B):
            for k in range(K):
                d = (cum[bi] - cum[ci[k]]) % Ltot
                if d <= sl[k] + 1e-9:
                    t = float(np.clip(d / max(sl[k], 1e-12), 0, 1))
                    if k in bps: t = float(np.interp(d, bps[k], np.arange(e[k] + 1) / e[k]))                  # the side carries its own breakpoints (shared arc partition)
                    uv[int(v)] = V[k] + (V[(k + 1) % K] - V[k]) * t; break
        W = mvc_weights(m["P"], F, vid) if embed in ("mvc", "sect") else cot_weights(m["P"], F, vid)
        U = np.zeros((n, 2)); inner = [int(v) for v in used if int(v) not in uv]
        for v, p in uv.items(): U[vid[v]] = p
        if inner:
            ii = np.array([vid[v] for v in inner]); bi_ = np.array([vid[v] for v in uv]); Dg = np.asarray(W.sum(1)).ravel(); Lap = (sps.diags(Dg) - W).tocsr()
            U[ii] = spsolve(Lap[ii][:, ii].tocsc(), -(Lap[ii][:, bi_] @ U[bi_])).reshape(len(ii), 2)
    elif embed in ("neumann", "dist"):
        e0, e1 = float(V[1][0] - V[0][0]) if K == 4 else 0, float(V[2][1] - V[1][1])                          # rectangle e0 x e1 (sides 0 and 2 have e[0] edges, sides 1 and 3 e[1])
        e0, e1 = float(e[0]), float(e[1]); long_ = (0, 2) if e0 >= e1 else (1, 3); caps = tuple(s for s in range(4) if s not in long_)
        so = side_of(pr); bl = [vid[int(v)] for v in B]
        capv = {c: [bl[bi] for bi in range(nB) if c in so[bi]] for c in caps}; lonv = {c: [bl[bi] for bi in range(nB) if c in so[bi]] for c in long_}
        # coordinates : along the long axis x (0 at cap caps[0]), across y (0 at long side long_[0]) ; the rectangle is e[long] x e[cap]
        Lx = float(e[long_[0]]); Wy = float(e[caps[0]]); U = np.zeros((n, 2))
        if embed == "neumann":
            Wc = cot_weights(m["P"], F, vid); Dg = np.asarray(Wc.sum(1)).ravel(); Lap = (sps.diags(Dg) - Wc).tocsr()
            def solve_with(fixed):
                fidx = np.array(sorted(fixed)); fv = np.array([fixed[i] for i in fidx]); free = np.setdiff1d(np.arange(n), fidx); x = np.zeros(n); x[fidx] = fv
                x[free] = spsolve(Lap[free][:, free].tocsc(), -(Lap[free][:, fidx] @ fv)); return x
            fx = {}; [fx.__setitem__(v, 0.0) for v in capv[caps[0]]]; [fx.__setitem__(v, Lx) for v in capv[caps[1]]]
