        for i in range(G.shape[0] - 1):
            for j in range(G.shape[1] - 1): Qd.append([pts.setdefault(vkey(G[a, b]), (len(pts), G[a, b]))[0] for a, b in ((i, j), (i + 1, j), (i + 1, j + 1), (i, j + 1))])
        for i in range(G.shape[0]):
            for j in range(G.shape[1]): pts.setdefault(vkey(G[i, j]), (len(pts), G[i, j]))
    if K == 4: add(coons(S2[0], S2[1], S2[2][::-1], S2[3][::-1]))
    else:
        P0 = V.mean(0)
        if opts.get("pole") == "perp":                                                      # the pole where the perpendiculars to the sides at the spoke feet meet (least squares) : the three blocks are then close to rectangles
            Ad = np.zeros((2, 2)); bd = np.zeros(2)
            for i in range(K):
                Eq = S2[i][sp[i - 1]]; d = (V[(i + 1) % K] - V[i]); d = d / max(np.linalg.norm(d), 1e-20); Ad += np.outer(d, d); bd += d * (Eq @ d)
            try:
                X = np.linalg.solve(Ad, bd); cr2 = lambda a, b: a[0] * b[1] - a[1] * b[0]; inside = all(cr2(V[(i + 1) % K] - V[i], X - V[i]) * cr2(V[(i + 1) % K] - V[i], P0 - V[i]) >= 0 for i in range(K))
                if inside: P0 = X
            except np.linalg.LinAlgError: pass
        spoke = [P0 + (S2[i][sp[i - 1]] - P0) * (np.arange(sp[i] + 1) / sp[i])[:, None] for i in range(K)]
        for i in range(K): add(coons(S2[i][:sp[i - 1] + 1], spoke[i][::-1], spoke[i - 1][::-1], S2[i - 1][sp[(i - 2) % K]:][::-1]))
    Q2 = np.zeros((len(pts), 2))
    for _, (k_, p_) in pts.items(): Q2[k_] = p_
    Qd = np.array(Qd, np.int64)
    if opts.get("uvsmooth"): Q2 = smooth_uv(Q2, Qd, opts["uvsmooth"])
    P3, bad = locate_lift(U, T2, Pl, Q2)
    return _finish(P3, Qd, normal, F, m, opts, dict(sides=K, counts=e, unlocated=bad, strip=pr["strip"], raw=pr["raw"], triangles=len(F)))


def smooth_uv(Q2, Qd, iters):
    """Laplacian smoothing of the interior lattice vertices in the (convex) uv polygon : the border (edges used by one quad) stays, so the arc length boundary is kept."""
    ec = collections.Counter()
    for q in Qd:
        for k in range(4): a, b = int(q[k]), int(q[(k + 1) % 4]); ec[(min(a, b), max(a, b))] += 1
    bd = {v for (a, b), c in ec.items() if c == 1 for v in (a, b)}; n = len(Q2); E = np.array(list(ec.keys()))
    W = sps.coo_matrix((np.ones(2 * len(E)), (np.r_[E[:, 0], E[:, 1]], np.r_[E[:, 1], E[:, 0]])), shape=(n, n)).tocsr(); W = sps.diags(1.0 / np.maximum(np.asarray(W.sum(1)).ravel(), 1)) @ W
    free = np.array([v for v in range(n) if v not in bd]); X = Q2.copy()
    if not len(free): return X
    for _ in range(int(iters)): X[free] = (W @ X)[free]
    return X


def _grid_arrays(G):
    """(m+1, n+1, 2) grid -> points (N,2), quads (q,4) with indices i * (n + 1) + j."""
    m1, n1 = G.shape[:2]; Qd = [[i * n1 + j, (i + 1) * n1 + j, (i + 1) * n1 + j + 1, i * n1 + j + 1] for i in range(m1 - 1) for j in range(n1 - 1)]; return G.reshape(-1, 2), np.array(Qd, np.int64)


def _finish(P3, Qd, normal, F, m, opts, rep):
    nq = np.cross(P3[Qd[:, 2]] - P3[Qd[:, 0]], P3[Qd[:, 3]] - P3[Qd[:, 1]]).sum(0)
    if nq @ normal < 0: Qd = Qd[:, ::-1]
    return P3, Qd, rep
