def cot_weights(P, F, vid, clamp=1e-3):
    """symmetric positive cotangent weights w_ij = 0.5 (cot a + cot b), negatives clamped to `clamp` (so the Laplacian stays an M matrix : a Tutte like embedding)."""
    n = len(vid); rows = []; cols = []; vals = []
    for t in F:
        for k in range(3):
            i, j, l = t[k], t[(k + 1) % 3], t[(k + 2) % 3]                       # angle at l, opposite the edge (i, j)
            a = P[i] - P[l]; b = P[j] - P[l]; cr = np.linalg.norm(np.cross(a, b)); cot = (a @ b) / max(cr, 1e-20)
            rows += [vid[i], vid[j]]; cols += [vid[j], vid[i]]; vals += [0.5 * cot, 0.5 * cot]
    W = sps.coo_matrix((vals, (rows, cols)), shape=(n, n)).tocsr(); W.data = np.maximum(W.data, clamp); return W


def cap_corners(Pb, cum, Ltot, nB, t0, t1, edge, opts):
    """the four corners of a strip whose two true corners (tips) are at the arc parameters t0 < t1. returns (ci, None) with the corner vertex indices, or (None, C) with arc parameters to snap.
    cap = narrow : the cap is the narrowest cross section near each tip (boundary vertices i before and j after the tip vertex, chord shortest) : the two long sides start face to face ; falls back to dd when the loop is too short.
    cap = dd (default) : the tip +- dd (dd = half an edge) ; cap = fallback / vertex : see prep."""
    la = (t1 - t0) * Ltot; lb = Ltot - la
    if opts.get("cap") == "narrow":
        nbm = max(1, min(int(opts.get("narrow_nb", 6)), nB // 4 - 1)); ci_ = []; ok = nB >= 8
        for t in (t0, t1):
            a = int(np.argmin(np.abs(cum[:-1] - t * Ltot))); best = None
            for i in range(1, nbm + 1):
                for j in range(1, nbm + 1):
                    cap_len = cum[(a - i) % nB] - cum[(a + j) % nB]; cap_len = (cum[(a + j) % nB] - cum[(a - i) % nB]) % Ltot
                    c_ = float(np.linalg.norm(Pb[(a - i) % nB] - Pb[(a + j) % nB])) + float(opts.get("narrow_w", 0.5)) * cap_len
                    if best is None or c_ < best[0]: best = (c_, (a - i) % nB, (a + j) % nB)
            ci_ += [best[1], best[2]]
        ci = sorted(set(ci_))
        if ok and len(ci) == 4 and ci_[1] != ci_[2] and ((ci_[1] - ci_[0]) % nB) < ((ci_[2] - ci_[0]) % nB): return ci, None
    dd = min(0.5 * edge, 0.1 * min(la, lb)) / Ltot; return None, [(t0 + dd) % 1.0, (t1 - dd) % 1.0, (t1 + dd) % 1.0, (t0 - dd) % 1.0]


def tip_idx(cum, Ltot, tips): return [int(np.argmin(np.abs(cum[:-1] - t * Ltot))) for t in tips]


def prep(m, Z, edge, opts=OPTS, prm=AP.PARAMS):
    """everything before the embedding : boundary loop, true corners (strip promotion, cap rule), corner vertices, counts by the MILP. returns dict or {"fail": reason}."""
    Ls, ln = AP.loops(m, Z)
    if len(Ls) != 1: return {"fail": "loops %d (not a disk)" % len(Ls)}
    B = np.asarray(Ls[0], np.int64); Pb = m["P"][B]; normal = m["N"][Z].mean(0); normal /= max(np.linalg.norm(normal), 1e-9)
    cum = np.r_[0, np.cumsum(np.linalg.norm(np.diff(np.vstack([Pb, Pb[:1]]), axis=0), axis=1))]; Ltot = cum[-1]
    if opts.get("ci_fixed"):                                                              # corners given by the caller (annulus cut : the four ends of the cut)
        ci = sorted(opts["ci_fixed"]); K = len(ci); nB = len(B); sl = [(cum[ci[(k + 1) % K]] - cum[ci[k]]) % Ltot for k in range(K)]
        if opts.get("corners_only"):                                                      # 30 October 2026 : corners given by the caller and no counts yet (the QuadWild hybrid : the counts come from the global MILP)
            F = m["F"][Z]; used = np.unique(F); vid = {int(v): i for i, v in enumerate(used)}; return dict(B=B, cum=cum, Ltot=Ltot, ci=ci, K=K, sl=sl, target=list(sl), cap_chord={}, e=None, sp=None, normal=normal, F=F, used=used, vid=vid, strip=False, raw=K, Z=Z, nB=nB)
        lay = {"arcs": {"a%d" % k: float(sl[k]) for k in range(K)}, "mirror": [], "patches": [{"name": "P", "sides": [["a%d" % k] for k in range(K)]}]}; sol = CT.solve(lay, edge)
        if not sol.get("ok"): return {"fail": "counts infeasible"}
        e = [int(sol["counts"]["a%d" % k]) for k in range(K)]; sp = sol["tarini"].get("P") if K != 4 else None; F = m["F"][Z]; used = np.unique(F); vid = {int(v): i for i, v in enumerate(used)}
        return dict(B=B, cum=cum, Ltot=Ltot, ci=ci, K=K, sl=sl, e=e, sp=sp, normal=normal, F=F, used=used, vid=vid, strip=False, raw=K, Z=Z, nB=nB)
    Cr, _, Xr, per = CR.detect(Pb, CR.vertex_normals_on_loop(m, Z, B)); C = [float(c) / CR.PARAMS["n"] for c in Cr]; raw = len(C); strip = False; nB = len(B); tips = []
    if len(C) == 2:
        strip = True; t0, t1 = sorted(C); tips = [t0, t1]; ci_f, C = cap_corners(Pb, cum, Ltot, nB, t0, t1, edge, opts)
        if ci_f is not None: C = None; ci = ci_f
    if C is not None and len(C) <= 1 and opts.get("round"):                              # a round zone (no or one true corner) : four corners evenly spaced by arc length, the first at the true corner or at the boundary point farthest from the centre
        if opts.get("round") == "diam":                                                  # the two boundary points farthest apart are the tips of a strip
            D = np.linalg.norm(Pb[:, None, :] - Pb[None, :, :], axis=2); a_, b_ = np.unravel_index(np.argmax(D), D.shape); t0, t1 = sorted([float(cum[a_] / Ltot), float(cum[b_] / Ltot)]); strip = True; tips = [t0, t1]; ci_f, C = cap_corners(Pb, cum, Ltot, nB, t0, t1, edge, opts)
            if ci_f is not None: C = None; ci = ci_f
        else:
            t0 = C[0] if C else float(cum[int(np.argmax(np.linalg.norm(Pb - Pb.mean(0), axis=1)))] / Ltot); C = [(t0 + q / 4.0) % 1.0 for q in range(4)]
    if C is not None:
        if not 3 <= len(C) <= 8: return {"fail": "true corners %d" % len(C)}
        ci = sorted({int(np.argmin(np.abs(cum[:-1] - C[k] * Ltot))) for k in range(len(C))})
        if len(ci) != len(C):
            if 3 <= nB <= 8: ci = list(range(nB))
            elif strip and opts.get("cap") in ("fallback", "narrow"):                                   # the cap corners fell on the same boundary vertex : take the vertices before and after each tip vertex
                ci_ = []
                for t in (t0, t1):
                    a = int(np.argmin(np.abs(cum[:-1] - t * Ltot))); ci_ += [(a - 1) % nB, (a + 1) % nB]
