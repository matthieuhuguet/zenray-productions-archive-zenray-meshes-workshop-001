#!/bin/zsh
# 2 November 2026 : the body, every part fitted at the same time on the same clean frames, the others held fixed, then rebuilt and the cameras polished on the whole body, as many rounds as asked. FR : le corps, chaque pièce ajustée en même temps sur les mêmes images propres, les autres tenues fixes, puis reconstruites et les caméras polies sur le corps entier.
# Usage : BodyLoop.sh <v3 folder> <rounds> <minutes per fit> [fresh]
cd "$1" || exit 1
HY=/Applications/Houdini/Current/Frameworks/Houdini.framework/Versions/Current/Resources/bin/hython; PY=/Users/zenray/.venvs/zenray-meshes/bin/python; C=../../../Scripts/Dracard/Comp; V=$(cat parts/body_views.txt); U=$(cat parts/body_unseen.txt); ROUNDS=$2; MIN=$3
typeset -A SPEC FOLD BR KEEP
SPEC=(torso parts/torso.json thigh parts/thigh.json calf_foot parts/calf_foot.json arm parts/arm.json)
FOLD=(torso parts/01_torso thigh parts/02_thigh calf_foot parts/03_calf_foot arm parts/04_arm)
BR=(torso "0.5:0.03,0.3:0.02,0.18:0.012,0.1:0.007" thigh "0.4:0.02,0.25:0.012,0.12:0.007" calf_foot "0.3:0.012,0.15:0.007,0.08:0.004" arm "0.15:0.008,0.08:0.005,0.03:0.002")
build() { perl -e 'alarm 200; exec @ARGV' $HY $C/ChainBuild.py $SPEC[$1] $FOLD[$1] 2>&1 | grep -E 'Error|Traceback' | cut -c1-200; }
merged() { # all parts but $1, mirrored when they are mirrored. FR : toutes les parties sauf $1.
  local L=(); for p in torso thigh calf_foot arm; do [[ $p == $1 ]] && continue; [[ $p == torso ]] && L+=($FOLD[$p]/part.obj) || L+=($FOLD[$p]/part.obj:m); done; $PY -I parts/mirror_obj.py parts/fixed_$1.obj $L >/dev/null; }
if [[ "$4" == "fresh" ]]; then for p in torso thigh calf_foot arm; do rm -f $FOLD[$p]/sculpt.json; build $p; done; fi
for r in $(seq 1 $ROUNDS); do
  for p in torso thigh calf_foot arm; do merged $p; cp parts/body_cams.json $FOLD[$p]/cams.json; done
  for p in torso thigh calf_foot arm; do
    if [[ $p == torso ]]; then EXTRA=(--symmetric 1); else EXTRA=(--symmetric 0 --mirror-part 1); fi
    $PY -I $C/CompFit.py $FOLD[$p] full/ep03 "" --assembled $V --fixed parts/fixed_$p.obj $EXTRA --levels 2 --minutes $MIN --cam-range 8 --centers 120 --brushes $BR[$p] --fair 60 > $FOLD[$p]/fit.log 2>&1 &
  done; wait
  for p in torso thigh calf_foot arm; do build $p; done
  $PY -I parts/mirror_obj.py parts/05_body/part.obj parts/01_torso/part.obj parts/02_thigh/part.obj:m parts/03_calf_foot/part.obj:m parts/04_arm/part.obj:m >/dev/null
  $PY -I parts/mirror_obj.py parts/fixed_torso.obj parts/02_thigh/part.obj:m parts/03_calf_foot/part.obj:m parts/04_arm/part.obj:m >/dev/null
  $PY -I $C/CompFit.py parts/01_torso full/ep03 "" --assembled $V,$U --fixed parts/fixed_torso.obj --symmetric 1 --levels 2 --cam-range 8 --cams-only parts/body_cams.json 2>&1 | grep -E 'Traceback' | cut -c1-200
  cp parts/body_cams.json parts/05_body/cams.json
  echo ROUND $r $(date +%H:%M); $PY -I $C/PartBoard.py parts/05_body full/ep03 ${V} parts/05_body/board.png --mask grey --tile 300 2>&1 | tail -1 | cut -c1-200; echo UNSEEN; $PY -I $C/PartBoard.py parts/05_body full/ep03 ${U} parts/05_body/board_unseen.png --mask grey --tile 300 2>&1 | tail -1 | cut -c1-200
done
echo BODYLOOP_DONE
