  {"date": "10 November 2026", "rule": "Calques pneu et jante des quatre roues de profil validés (planche wheels-W_002) : SAM comme témoin, cercle ajusté comme forme enregistrée, rayon lu sur les anneaux, contrôle gauche contre droite.", "topic": "découpe, SAM, masques", "applies_to_v5": true, "source": "Rules.md, 10 November 2026 (9fe92acd508d)"},
