    for k, v in rep["gates"].items(): print("  %-13s %-5s %-10s %s" % (k, "GREEN" if v["pass"] else "RED", v["value"], v["rule"]))


def main():
    ap = argparse.ArgumentParser(); sp = ap.add_subparsers(dest="cmd", required=True); r = sp.add_parser("run"); r.add_argument("mesh"); r.add_argument("--target", type=int, required=True); r.add_argument("--out"); r.add_argument("--set", action="append", default=[]); r.add_argument("--params"); r.add_argument("--no-board", action="store_true"); r.add_argument("--no-baseline", action="store_true"); g = sp.add_parser("gates"); g.add_argument("report"); a = ap.parse_args()
    if a.cmd == "gates": print_gates(json.load(open(a.report))); return
    P = dict(PARAMS)
    if a.params: P.update(json.load(open(a.params)))
    for kv in a.set:
        k, v = kv.split("=", 1)
        if k not in P: raise SystemExit("unknown parameter %s (known : %s)" % (k, ", ".join(P)))
        P[k] = json.loads(v) if isinstance(PARAMS[k], list) else (type(PARAMS[k])(v) if not isinstance(PARAMS[k], str) else v)
    if a.no_baseline: P["baseline_guard"] = 0
    out = a.out or os.path.join(os.path.dirname(os.path.abspath(a.mesh)), "retopo_" + os.path.splitext(os.path.basename(a.mesh))[0]); rep = run(a.mesh, a.target, out, P, not a.no_board)
    if "error" in rep: raise SystemExit(rep["error"])
    print_gates(rep); print("report", os.path.join(out, "report.json"))


if __name__ == "__main__": main()
