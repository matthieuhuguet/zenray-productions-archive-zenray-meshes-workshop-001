def reference_wins(ours, ref, P):
    """30 October 2026 : who keeps the result when the input is already a quad mesh at the same density. Order of Matthieu : never worse than the reference, and a look at the hood showed that the gates alone are not enough (the reference was a clean grid with 2 poles per 1000 and a 0.34 percent folded edge, the result was green on folds but had 18 poles per 1000 and a ragged border). Rules : (1) coverage decides first ; (2) the reference wins when it has more green gates (density apart) ; (3) otherwise, even when the result has MORE green gates, the reference wins when the result is geometrically worse : straightness above both the gate and 1.25 times the reference, or more than 8 poles per 1000 above the reference. Returns (reference_wins, reason)."""
    go, gr = ours["gates"], ref["gates"]
    if go["coverage"]["pass"] != gr["coverage"]["pass"]: return (not go["coverage"]["pass"]), "coverage"
    no, nr = sum(int(v["pass"]) for k, v in go.items() if k != "density"), sum(int(v["pass"]) for k, v in gr.items() if k != "density")
    if nr > no: return True, "green gates %d (result) against %d (reference)" % (no, nr)
    so, sr = ours["measures"]["straight_iso_mean_deg"], ref["measures"]["straight_iso_mean_deg"]; po, pr = ours["measures"]["poles_per_1000_quads"], ref["measures"]["poles_per_1000_quads"]
