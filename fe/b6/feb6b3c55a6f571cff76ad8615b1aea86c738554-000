def surface_samples(V, T, n, seed=1):
    rng = np.random.default_rng(seed); a, b, c = V[T[:, 0]], V[T[:, 1]], V[T[:, 2]]; ar = 0.5 * np.linalg.norm(np.cross(b - a, c - a), axis=1); i = rng.choice(len(T), n, p=ar / ar.sum()); u = rng.random((n, 2)); m = u.sum(1) > 1; u[m] = 1 - u[m]
    return a[i] + u[:, :1] * (b[i] - a[i]) + u[:, 1:] * (c[i] - a[i])


def crease_share(V, T, deg=60.0):
    """share of the interior edges whose two faces make a dihedral angle above deg."""
    n = np.cross(V[T[:, 1]] - V[T[:, 0]], V[T[:, 2]] - V[T[:, 0]]); a = np.linalg.norm(n, axis=1); n = n / np.maximum(a, 1e-30)[:, None]; ef = collections.defaultdict(list)
    for i, t in enumerate(T):
        for k in range(3): p, q = int(t[k]), int(t[(k + 1) % 3]); ef[(min(p, q), max(p, q))].append(i)
    ang = [np.degrees(np.arccos(np.clip(n[f[0]] @ n[f[1]], -1, 1))) for f in ef.values() if len(f) == 2 and a[f[0]] > 1e-14 and a[f[1]] > 1e-14]
    return float((np.array(ang) > deg).mean()) if ang else 0.0


def detect_regime(V, T, P):
    if P["regime"] != "auto": return {"regime": P["regime"], "crease_share60": None}
    s = crease_share(V, T, 60.0); return {"regime": "hard" if s >= P["hard_crease_share60"] else "organic", "crease_share60": round(s, 4)}


def mirror_distance(V, T, ax, c, n, tree_cache=None):
    """distances (as a fraction of the bounding diagonal) from the mirrored surface samples to the surface itself, point to triangle distance."""
    import trimesh
    S = surface_samples(V, T, n); R = S.copy(); R[:, ax] = 2 * c - R[:, ax]; m = trimesh.Trimesh(V, T, process=False); _, d, _ = trimesh.proximity.closest_point(m, R); return d / float(np.linalg.norm(V.max(0) - V.min(0)))


def detect_symmetry(V, T, P):
    """best mirror plane among the three axis planes, centre refined from the bounding box centre by two median steps. Returns the axis, the centre, the p95 and the verdict."""
    if P["symmetry"] == "off": return {"symmetric": False, "axis": None, "reason": "off"}
    best = None
    for ax in ("xyz" if P["symmetry"] == "auto" else P["symmetry"]):
        i = "xyz".index(ax); c = float((V[:, i].max() + V[:, i].min()) / 2); S = surface_samples(V, T, P["sym_samples"], 3); tree = cKDTree(surface_samples(V, T, 6 * P["sym_samples"], 4))
        for _ in range(2):                                                                          # centre refinement : the median offset between mirrored samples and their nearest surface samples
            R = S.copy(); R[:, i] = 2 * c - R[:, i]; _, ix = tree.query(R); c += float(np.median(tree.data[ix][:, i] - R[:, i])) / 2
        d = mirror_distance(V, T, i, c, P["sym_samples"]); r = {"axis": ax, "index": i, "center": round(c, 6), "p95": round(float(np.percentile(d, 95)), 5), "p50": round(float(np.median(d)), 5)}
        if best is None or r["p95"] < best["p95"]: best = r
    best["symmetric"] = best["p95"] <= P["sym_p95_frac"]; return best


def load_quads(path):
    V, F = TJ.load(path); return V, np.array([f for f in F if len(f) == 4], np.int64)


def boundary_length(V, F):
    ec = collections.Counter()
    for f in F:
        for i in range(len(f)): p, q = f[i], f[(i + 1) % len(f)]; ec[(min(p, q), max(p, q))] += 1
    e = [k for k, c in ec.items() if c == 1]
    return (float(sum(np.linalg.norm(V[a] - V[b]) for a, b in e)), len(e))


def components(F, n):
    par = list(range(n))
    def fd(x):
        while par[x] != x: par[x] = par[par[x]]; x = par[x]
        return x
    for f in F:
        for v in f[1:]: par[fd(int(v))] = fd(int(f[0]))
    return len({fd(int(v)) for f in F for v in f})


def coverage(V, T, Vq, Q, tol):
    """recall = share of the reference surface within tol of the result, precision = the reverse, and the worst recall over the connected components of the reference (a lost component is a recall near 0 on that component)."""
    S = surface_samples(V, T, 40000, 5); QT = np.vstack([Q[:, [0, 1, 2]], Q[:, [0, 2, 3]]]); Sq = surface_samples(Vq, QT, 40000, 6); tree = cKDTree(Sq); d = tree.query(S)[0]
    par = list(range(len(V)))
    def fd(x):
        while par[x] != x: par[x] = par[par[x]]; x = par[x]
        return x
    for t in T: par[fd(int(t[1]))] = fd(int(t[0])); par[fd(int(t[2]))] = fd(int(t[0]))
    comp = np.array([fd(int(t[0])) for t in T]); worst = 1.0; hidden = 0; solid = None
    for cid in np.unique(comp):
        sub = T[comp == cid]; Sc = surface_samples(V, sub, 2000, 8); rc = float((tree.query(Sc)[0] <= tol).mean())
        if rc < 0.9:                                                                                # a piece the result does not reach : lost, or hidden INSIDE the closed result (an eyeball behind the lids) : only a lost piece counts
            if solid is None:
                import trimesh
                solid = trimesh.Trimesh(Vq, QT, process=False); solid = solid if solid.is_watertight else False
            if solid is not False and float(solid.contains(Sc[:300]).mean()) >= 0.8: hidden += 1; continue
        worst = min(worst, rc)
    coverage.hidden = hidden
    return float((d <= tol).mean()), float((cKDTree(S).query(Sq)[0] <= tol).mean()), worst


def component_faces(T, n):
    """list of triangle index arrays, one per connected component (vertex connectivity)."""
    par = list(range(n))
    def fd(x):
        while par[x] != x: par[x] = par[par[x]]; x = par[x]
        return x
    for t in T: par[fd(int(t[1]))] = fd(int(t[0])); par[fd(int(t[2]))] = fd(int(t[0]))
    g = collections.defaultdict(list)
    for i, t in enumerate(T): g[fd(int(t[0]))].append(i)
    return [np.array(v) for v in g.values()]


def safe_straighten(pre, Vq, Qq, theta, P, bad, pin=None):
    """the layout barrier, or the unstraightened quads when the barrier raises (a degenerate piece) : the failure is recorded in bad, never silent."""
    try:
        Pb = LB.straighten(pre, Vq, Qq, P["barrier_outer"], P["barrier_inner"], theta, "keep", log=lambda s: None, fair=P["fair"], pin=pin, slide_deg=P["slide_deg"])[0]
        if np.isfinite(Pb).all(): return Pb
        bad.append("non finite result")
    except Exception as ex: bad.append(repr(ex)[:100])
    return Vq


def tri_to_quads(V, T):
    """last resort for a component QuadWild cannot mesh : every triangle becomes three quads (edge midpoints and centroid) : a pure quad cover of the exact same surface, angles between 60 and 120 degrees, irregular vertices only at the old corners. Returns (vertices, quads)."""
    P = [list(v) for v in V]; mid = {}; Q = []
    def m(a, b):
        k = (min(a, b), max(a, b))
        if k not in mid: mid[k] = len(P); P.append(list((np.asarray(V[a]) + np.asarray(V[b])) / 2))
        return mid[k]
    for t in T:
        a, b, c = int(t[0]), int(t[1]), int(t[2]); g = len(P); P.append(list((np.asarray(V[a]) + np.asarray(V[b]) + np.asarray(V[c])) / 3)); ab, bc, ca = m(a, b), m(b, c), m(c, a)
        Q += [[a, ab, g, ca], [b, bc, g, ab], [c, ca, g, bc]]
    return np.array(P), Q


def best_quad_file(smooth):
    """QuadWild's own smoothing collapses thin pieces (a leaf ribbon thinner than one quad : 19 percent squashed after smoothing against 8 percent before) : of the smoothed and the raw quadrangulation of a piece the one with fewer folded or squashed quads is kept (the smoothed one on a tie)."""
    import ZrlQuadStats as QS
    raw = os.path.join(os.path.dirname(smooth), "part_rem_p0_123_quadrangulation.obj"); best = None
    for f in (smooth, raw):
        if not os.path.exists(f): continue
        try:
            V, Q = load_quads(f)
            if not len(Q): continue
            j = QS.stats(V, Q)[2]; bad = float((~(j >= 0.3)).mean())      # NaN (a zero area quad) counts as bad
        except Exception: continue
        if best is None or bad < best[0] - 1e-9: best = (bad, V, Q)
    return best[1], best[2]


def run_split(V, T, mesh, out, target, thr, alpha, theta, P, log=print, pin=None):
    """30 October 2026 : COMPONENT BY COMPONENT : every connected component is cut out, meshed by QuadWild with its share of the target (by area), straightened by the layout barrier and the results are concatenated. No component can vanish or fuse with another : a component QuadWild cannot mesh gets the three quads per triangle cover (up to split_fallback_tris triangles), otherwise it is listed as lost. The density loop keeps the PASS whose total is closest to the target (the per component minimum of quads makes the count non monotonic)."""
    from concurrent.futures import ProcessPoolExecutor
    comps = component_faces(T, len(V)); a = V[T[:, 0]]; areas = 0.5 * np.linalg.norm(np.cross(V[T[:, 1]] - a, V[T[:, 2]] - a), axis=1); ca = np.array([areas[c].sum() for c in comps]); wd = os.path.join(out, "split"); os.makedirs(wd, exist_ok=True); srcs = []
    for ci, fl in enumerate(comps):
        used = np.unique(T[fl]); mp = {int(v): k + 1 for k, v in enumerate(used)}; path = os.path.join(wd, "c%04d.obj" % ci)
        open(path, "w").write("".join("v %.7f %.7f %.7f\n" % tuple(V[v]) for v in used) + "".join("f %d %d %d\n" % tuple(mp[int(k)] for k in T[f]) for f in fl)); srcs.append(path)
    scale = 1.0; tries = []; passes = []
    for attempt in range(P["split_density_passes"]):
        tg = [max(P["split_min_quads"], int(round(scale * target * ca[i] / ca.sum()))) for i in range(len(comps))]; jobs = [(srcs[i], wd, srcs[i], tg[i], str(thr), alpha, P["flow"], "p%d_q%04d" % (attempt, i)) for i in range(len(comps))]
        with ProcessPoolExecutor(P["split_workers"]) as ex: out_ = list(ex.map(SW.one, jobs))
        results = {int(n.split("_q")[1]): r for n, r in out_}; got = sum(r["quads"] for r in results.values() if "file" in r) + 3 * sum(len(comps[i]) for i in range(len(comps)) if "file" not in results.get(i, {}) and len(comps[i]) <= P["split_fallback_tris"]); ratio = got / target; tries.append({"scale": round(scale, 3), "quads": got, "ratio": round(ratio, 3)}); passes.append(results)
        if abs(ratio - 1) <= 0.5 * P["density_tol"]: break
        scale /= ratio
    best = min(range(len(passes)), key=lambda k: abs(tries[k]["ratio"] - 1)); results = passes[best]
    allV = []; allF = []; raw = []; lost = []; bad = []; fallback = []
    order = sorted(range(len(passes)), key=lambda k: abs(tries[k]["ratio"] - 1)); rescued = []
    failed = [i for i in range(len(comps)) if not any("file" in passes[k].get(i, {}) for k in range(len(passes)))]
    for mult in (4, 16, 64):                                                                      # a piece QuadWild cannot mesh at its share of the target (a leaf of a few quads) is retried at 4, 16 then 64 times that count : a few extra quads rather than a lost piece
        if not failed: break
        jobs = [(srcs[i], wd, srcs[i], int(max(P["split_min_quads"], round(target * ca[i] / ca.sum())) * mult), str(thr), alpha, P["flow"], "r%d_q%04d" % (mult, i)) for i in failed]
        with ProcessPoolExecutor(P["split_workers"]) as ex: out_ = list(ex.map(SW.one, jobs))
        got_ = {int(n.split("_q")[1]): r for n, r in out_ if "file" in r}
        if got_: passes.append(got_); tries.append({"scale": "rescue x%d" % mult, "quads": 0, "ratio": 99.0}); rescued += list(got_)
        failed = [i for i in failed if i not in got_]
    order = order + [k for k in range(len(passes)) if k not in order]
    for i in range(len(comps)):
        r = next((passes[k][i] for k in order if "file" in passes[k].get(i, {})), {})      # a component that failed in the chosen pass takes its result from the closest other pass
        if "file" not in r:
            if len(comps[i]) <= P["split_fallback_tris"]:
                used = np.unique(T[comps[i]]); mp = {int(v): k for k, v in enumerate(used)}; Vc, Qc = tri_to_quads(V[used], [[mp[int(k)] for k in T[f]] for f in comps[i]]); off = sum(len(x) for x in allV); allV.append(Vc); allF += [[int(k) + off for k in q] for q in Qc]; fallback.append(i)
            else: lost.append(i)
            continue
        pre = os.path.join(os.path.dirname(r["file"]), "part_rem_p0"); Vq, Qq = best_quad_file(r["file"]); Pb = safe_straighten(pre, Vq, Qq, theta, P, bad, pin); off = sum(len(x) for x in allV); allV.append(Pb); allF += [list(map(lambda k: int(k) + off, q)) for q in Qq]; raw.append(r["file"])
    return np.vstack(allV), allF, {"components": len(comps), "lost_components": lost, "triangle_cover_components": fallback, "split_tries": tries, "split_best_pass": best, "rescued_components": rescued, "barrier_failed_components": bad}


def mirror_layout(prefix, ax, c, diag, out_prefix):
    """30 October 2026 : the QuadWild layout of a half, mirrored through the plane ax = c and welded on the plane, written as the five layout files of out_prefix : the layout aware barrier can then run on the WHOLE mirrored quad mesh (the seam is no longer a border). Hard edge lists lose the edges lying on the plane (they were the cut border, not creases)."""
    import zr8_layout as LY, zr8_io as IO
    lay = LY.Layout(prefix); V = lay.V; F = lay.F; n = len(V); nf = len(F); tol = 1e-6 * diag; onp = np.abs(V[:, ax] - c) < tol; mid = np.arange(n); k = n; Vm = V.copy(); Vm[:, ax] = 2 * c - Vm[:, ax]; extra = []
    for v in range(n):
        if not onp[v]: mid[v] = k; k += 1; extra.append(Vm[v])
    Vn = np.vstack([V] + ([np.array(extra)] if extra else [])); Fn = np.vstack([F, np.array([[mid[a], mid[cc], mid[b]] for a, b, cc in F])]); pid = np.concatenate([lay.pid, lay.pid + lay.npatch]); corners = [list(map(int, cs)) for cs in lay.corners] + [[int(mid[v]) for v in cs] for cs in lay.corners]
    def on_plane_edge(f, e): a, b = int(Fn[f][e]), int(Fn[f][(e + 1) % 3]); return onp[a if a < n else 0] and onp[b if b < n else 0] if (a < n and b < n) else False
    feats = [(f, e) for f, e in lay.features if not on_plane_edge(f, e)] + [(nf + f, [2, 1, 0][e]) for f, e in lay.features if not on_plane_edge(f, e)]; cf = [v for v in lay.c_features if not onp[v]]; cf = cf + [int(mid[v]) for v in cf]
    with open(out_prefix + ".obj", "w") as o: o.write("".join("v %.9g %.9g %.9g\n" % tuple(p) for p in Vn)); o.write("".join("f %d %d %d\n" % tuple(int(i) + 1 for i in t) for t in Fn))
    open(out_prefix + ".patch", "w").write("%d\n%s\n" % (len(Fn), "\n".join(str(int(p)) for p in pid))); open(out_prefix + ".corners", "w").write("%d\n%s\n" % (len(corners), "\n".join("%d %s" % (len(cs), " ".join(map(str, cs))) for cs in corners)))
    open(out_prefix + ".feature", "w").write("%d\n%s\n" % (len(feats), "\n".join("%d,%d" % (f, e) for f, e in feats))); open(out_prefix + ".c_feature", "w").write("%d\n%s\n" % (len(cf), "\n".join(map(str, cf)))); return out_prefix


def symmetrize(Pf, pair, ax, c):
    """exact mirror symmetry of the whole quad mesh after a global optimisation : every vertex and its partner are replaced by the mean of the vertex and the reflection of its partner ; plane vertices are put on the plane."""
    Pf = Pf.copy(); n = len(pair)
    for v in range(n):
        w = int(pair[v])
        if w == v: Pf[v, ax] = c
        elif v < w:
            r = Pf[w].copy(); r[ax] = 2 * c - r[ax]; m = 0.5 * (Pf[v] + r); Pf[v] = m; r2 = m.copy(); r2[ax] = 2 * c - r2[ax]; Pf[w] = r2
    return Pf


def clip_half_components(V, T, ax, c):
    """30 October 2026 : the half x >= c clipped COMPONENT BY COMPONENT : QwMirror.clip_half welds vertices by position, which fuses pieces sewn onto another one (eyelashes, hair cards, teeth that share exact positions with the head) into one non manifold sheet whose smaller triangles are then dropped. Clipping every component on its own keeps them apart. Returns (vertices, triangles)."""
    Vs = []; Ts = []; off = 0
    for fl in component_faces(T, len(V)):
        used = np.unique(T[fl]); mp = {int(v): k for k, v in enumerate(used)}; sub = np.array([[mp[int(k)] for k in T[f]] for f in fl])
        if V[used][:, ax].max() <= c + 1e-12: continue                                       # entirely on the other side : the mirror recreates it
        try: HV, HT = MIR.clip_half(V[used], sub, ax, c)
        except Exception: continue
        if len(HT) == 0: continue
        Vs.append(HV); Ts.append(HT + off); off += len(HV)
    return np.vstack(Vs), np.vstack(Ts)


def combine_extras(Vf, Ff, ex):
    """append the separately meshed small pieces (already mirrored) to the body result."""
    if not ex: return Vf, Ff
