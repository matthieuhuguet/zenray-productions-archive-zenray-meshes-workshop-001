        if cnt[(min(a, b), max(a, b))] == 1: nxt[a].append(b)
    seen = set(); loops = 0; slits = 0
    for st in list(nxt):
        if st in seen: continue
        loop = [st]; seen.add(st); cur = nxt[st][0]
        while cur != st and cur not in seen and len(loop) < 100000:
            loop.append(cur); seen.add(cur); cur = nxt[cur][0] if nxt[cur] else st
