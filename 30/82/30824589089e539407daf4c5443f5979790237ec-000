"""28 October 2026, 20:30 : ZenRay Meshes finishing, GLASS RULED, a side window rebuilt as a taut ruled surface (finish checklist + rule 223) :
top edge = the rail outer edge curve (rail_out2_L.npy), bottom edge = the belt line arc of DesignLines.json (y) with x one arc fitted on the old glass
bottom ; per z column a straight segment from bottom to top, columns from the old glass z range (cut where the edges meet, a pointed tip), sides
mirrored ; closed 6 mm shell (outward by signed volume). FR : vitre latérale refaite en surface réglée tendue entre la ceinture et le rail.
python GlassRuled.py <delivery.npz> <out.npz> --part CAR_body_glass_door_L [--inset-m 0.004] [--rows 10]"""
import argparse, json, os, sys
import numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from FinishCheck import part
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car/finish/"
ap = argparse.ArgumentParser(); ap.add_argument("npz"); ap.add_argument("out"); ap.add_argument("--part", required=True)
ap.add_argument("--inset-m", type=float, default=0.004); ap.add_argument("--rows", type=int, default=10); ap.add_argument("--edge-m", type=float, default=0.02)
ap.add_argument("--thick", type=float, default=0.006); ap.add_argument("--top", default=W + "rail_out2_L.npy")
a = ap.parse_args()
G, _ = part(a.npz, a.part); L = json.load(open(W + "DesignLines.json"))["belt"]; T = np.load(a.top); T = T[np.argsort(T[:, 2])]
z0, z1 = G[:, 2].min(), G[:, 2].max(); zz = np.linspace(z0, z1, max(2, int((z1 - z0) / a.edge_m)) + 1)
yb = np.polyval(L["coef"], zz)
bot = []
for z in zz:
    s = G[np.abs(G[:, 2] - z) < 0.015]; bot.append(s[s[:, 1].argmin(), 0] if len(s) else np.nan)
bot = np.array(bot); k = ~np.isnan(bot); xb = np.polyval(np.polyfit(zz[k], bot[k], 2), zz)
xt, yt = np.interp(zz, T[:, 2], T[:, 0]) - a.inset_m, np.interp(zz, T[:, 2], T[:, 1])
ok = yt - yb > 0.01; zz, xb, yb, xt, yt = zz[ok], xb[ok], yb[ok], xt[ok], yt[ok]
t = np.linspace(0, 1, a.rows + 1)
S = np.stack([xb[None, :] * (1 - t[:, None]) + xt[None, :] * t[:, None], yb[None, :] * (1 - t[:, None]) + yt[None, :] * t[:, None], np.repeat(zz[None, :], len(t), 0)], -1)
nb, na = S.shape[:2]; du = np.gradient(S, axis=1); dv = np.gradient(S, axis=0); N = np.cross(du, dv); N /= np.linalg.norm(N, axis=-1, keepdims=True) + 1e-12
if N[..., 0].mean() < 0: N = -N
B = S - a.thick * N; gid = lambda j, i: j * na + i; off = nb * na; P = np.vstack([S.reshape(-1, 3), B.reshape(-1, 3)]); F = []
for j in range(nb - 1):
    for i in range(na - 1):
        q = [gid(j, i), gid(j, i + 1), gid(j + 1, i + 1), gid(j + 1, i)]; F.append(q); F.append([off + x for x in q[::-1]])
ring = [gid(0, i) for i in range(na)] + [gid(j, na - 1) for j in range(1, nb)] + [gid(nb - 1, i) for i in range(na - 2, -1, -1)] + [gid(j, 0) for j in range(nb - 2, 0, -1)]
for k in range(len(ring)): F.append([ring[k], off + ring[k], off + ring[(k + 1) % len(ring)], ring[(k + 1) % len(ring)]])
vol = sum(np.dot(P[q[0]], np.cross(P[q[j]], P[q[j + 1]])) for q in F for j in (1, 2))
if vol < 0: F = [q[::-1] for q in F]
R = a.part[:-2] + "_R"; PR = P * np.array([-1, 1, 1]); FR = [[v + len(P) for v in q[::-1]] for q in F]
np.savez(a.out, P=np.vstack([P, PR]).astype(np.float32), Q=np.array(F + FR, dtype=object), names=np.array([a.part] * len(F) + [R] * len(FR)))
print(json.dumps({"grid": [nb, na], "z": [round(float(zz.min()), 3), round(float(zz.max()), 3)], "faces_per_side": len(F)}))
