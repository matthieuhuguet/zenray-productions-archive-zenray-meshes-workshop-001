"""2 November 2026 : DRACARD, one definition of a tube for the fit and for Houdini : control points give a dense curve, ramp keys give a radius along its length, so what is measured is what Houdini builds. Only numpy, it runs in hython too.
FR : une seule définition du tube pour l'ajustement et pour Houdini : les points de contrôle donnent une courbe dense, les clés de rampe un rayon le long de sa longueur, donc ce qui est mesuré est ce que Houdini construit."""
import math
import numpy as np


def hermite(xk, yk, x):
    """piecewise cubic through the keys, slopes by finite differences. FR : cubique par morceaux passant par les clés, pentes par différences finies."""
    xk = np.asarray(xk, float); yk = np.asarray(yk, float); x = np.clip(x, xk[0], xk[-1]); n = len(xk)
    if n == 1: return np.full_like(x, yk[0], dtype=float)
    d = np.diff(yk, axis=0) / np.diff(xk).reshape((-1,) + (1,) * (yk.ndim - 1)); m = np.zeros_like(yk); m[0] = d[0]; m[-1] = d[-1]
    if n > 2: m[1:-1] = (d[:-1] + d[1:]) / 2
    i = np.clip(np.searchsorted(xk, x, side="right") - 1, 0, n - 2); h = xk[i + 1] - xk[i]; t = (x - xk[i]) / h; sh = (-1,) + (1,) * (yk.ndim - 1); t_ = t.reshape(sh); h_ = h.reshape(sh)
    return (2 * t_ ** 3 - 3 * t_ ** 2 + 1) * yk[i] + (t_ ** 3 - 2 * t_ ** 2 + t_) * h_ * m[i] + (-2 * t_ ** 3 + 3 * t_ ** 2) * yk[i + 1] + (t_ ** 3 - t_ ** 2) * h_ * m[i + 1]


def dense_curve(pts, n):
    """a smooth curve through the control points, resampled evenly by length. FR : une courbe lisse par les points de contrôle, rééchantillonnée régulièrement en longueur."""
    p = np.asarray(pts, float)
    if len(p) == 2: return p[0] + np.linspace(0, 1, n)[:, None] * (p[1] - p[0])
    s = np.r_[0, np.cumsum(np.maximum(np.linalg.norm(np.diff(p, axis=0), axis=1), 1e-6) ** 0.5)]; q = hermite(s, p, np.linspace(0, s[-1], 4 * n)); L = np.r_[0, np.cumsum(np.linalg.norm(np.diff(q, axis=0), axis=1))]; u = np.linspace(0, L[-1], n); return np.stack([np.interp(u, L, q[:, k]) for k in range(3)], 1)


def radius(t, n):
    keys = sorted(t["ramp"], key=lambda k: k[0]); return np.maximum(hermite([k[0] for k in keys], [k[1] for k in keys], np.linspace(0, 1, n)), 1e-4) * t.get("radius", 1.0)


OBJ_CACHE = {}


def sheet_rows(t, n=None, m=None, side=0):
    """2 November 2026 : a membrane between two curves, the Skin node of the series : pts holds both curves one after the other, ramp[0] is how far the free edge pulls back in its middle. FR : une membrane entre deux courbes, le node Skin de la série : pts porte les deux courbes l'une après l'autre, ramp[0] dit combien le bord libre recule en son milieu."""
    n = n or t.get("stations", 24); m = m or t.get("cols", 8); k = len(t["pts"]) // 2; A = dense_curve(t["pts"][:k], n); B = dense_curve(t["pts"][k:], n); sc = t["ramp"][0][1]; s0 = np.linspace(0, 1, n); R = []
    for u in np.linspace(0, 1, m):
        ts = s0 * (1 - sc * 4 * u * (1 - u)); a = np.stack([np.interp(ts, s0, A[:, i]) for i in range(3)], 1); b = np.stack([np.interp(ts, s0, B[:, i]) for i in range(3)], 1); r_ = (1 - u) * a + u * b
        if t.get("width") and side: r_ = r_.copy(); r_[:, 0] += side * t["width"] * math.sin(math.pi * u) * (1 - s0 ** 2)      # 4 November 2026 : a plate is a lens, not a line : seen from the front a sheet has no area. FR : une plaque est une lentille, pas une ligne : de face une feuille n'a pas d'aire.
        R.append(r_)
    return np.array(R)


def tube_mesh(t, n=None, cols=None):
    """rings along the curve with a transported frame, closed by a point at each end. FR : anneaux le long de la courbe, repère transporté, fermés par un point à chaque bout."""
    if t.get("kind") == "obj":      # 2 November 2026 : a finished part held fixed while another is fitted on the same frames. FR : une partie finie tenue fixe pendant qu'une autre s'ajuste sur les mêmes images.
        if t["file"] not in OBJ_CACHE:
            V_, F_ = [], []
            for l in open(t["file"]):
                if l.startswith("v "): V_.append([float(x) for x in l.split()[1:4]])
                elif l.startswith("f "):
                    i_ = [int(q.split("/")[0]) - 1 for q in l.split()[1:]]; F_ += [(i_[0], i_[k], i_[k + 1]) for k in range(1, len(i_) - 1)]
            OBJ_CACHE[t["file"]] = (np.array(V_, np.float32), np.array(F_, np.int32))
        V_, F_ = OBJ_CACHE[t["file"]]; xf = t.get("xform", [0.0, 0.0, 0.0, 1.0]); rot = t.get("rot")
        if rot and any(rot):      # 4 November 2026 : the head turns about its own origin by small angles, in degrees about x, y, z. FR : la tête tourne autour de son origine de petits angles, en degrés autour de x, y, z.
            a_, b_, c_ = (math.radians(x_) for x_ in rot); Rx = np.array([[1, 0, 0], [0, math.cos(a_), -math.sin(a_)], [0, math.sin(a_), math.cos(a_)]]); Ry = np.array([[math.cos(b_), 0, math.sin(b_)], [0, 1, 0], [-math.sin(b_), 0, math.cos(b_)]]); Rz = np.array([[math.cos(c_), -math.sin(c_), 0], [math.sin(c_), math.cos(c_), 0], [0, 0, 1]]); V_ = (V_ @ (Rz @ Ry @ Rx).T).astype(np.float32)
        return (V_ * xf[3] + np.array(xf[:3], np.float32)).astype(np.float32), F_      # xform : translation then uniform scale, to place the part in the whole. FR : translation puis échelle uniforme, pour placer la partie dans l'ensemble.
    if t.get("kind") == "sheet":
        sides = (1, -1) if t.get("width") else (0,); Vs, Fs, off = [], [], 0
        for sd in sides:
            R = sheet_rows(t, side=sd); m, n_ = R.shape[:2]; i0 = (np.arange(m - 1)[:, None] * n_ + np.arange(n_ - 1)[None, :]).ravel(); Vs.append(R.reshape(-1, 3)); Fs.append(np.vstack([np.stack([i0, i0 + 1, i0 + n_], 1), np.stack([i0 + 1, i0 + n_ + 1, i0 + n_], 1)]) + off); off += m * n_
        return np.vstack(Vs).astype(np.float32), np.vstack(Fs).astype(np.int32)
    n = n or t.get("stations", 40); cols = cols or t.get("cols", 20); c = dense_curve(t["pts"], n); r = radius(t, n); T = np.gradient(c, axis=0); T /= np.maximum(np.linalg.norm(T, axis=1, keepdims=True), 1e-9); ref = np.array([1.0, 0, 0]) if abs(T[0, 0]) < 0.9 else np.array([0, 1.0, 0]); U = np.zeros_like(c); u = np.cross(T[0], ref); u /= np.linalg.norm(u)
    for i in range(n):
        u = u - T[i] * np.dot(u, T[i]); u /= np.maximum(np.linalg.norm(u), 1e-9); U[i] = u
    W = np.cross(T, U); a = np.linspace(0, 2 * np.pi, cols, endpoint=False); ca, sa = np.cos(a)[None, :, None], np.sin(a)[None, :, None]; V = c[:, None, :] + r[:, None, None] * (ca * U[:, None, :] + sa * W[:, None, :]); V = V.reshape(-1, 3); V = np.vstack([V, c[0], c[-1]])
    if t.get("flatten"):
        k = np.mean(np.asarray(t["pts"], float), 0); V = k + (V - k) * np.asarray(t["flatten"], float)
    i0 = np.arange(n - 1)[:, None] * cols + np.arange(cols)[None, :]; i1 = np.arange(n - 1)[:, None] * cols + (np.arange(cols)[None, :] + 1) % cols; a_, b_ = i0.ravel(), i1.ravel(); F = [np.stack([a_, b_, a_ + cols], 1), np.stack([b_, b_ + cols, a_ + cols], 1)]; N = len(V); ring = np.arange(cols); F.append(np.stack([np.full(cols, N - 2), (ring + 1) % cols, ring], 1)); F.append(np.stack([np.full(cols, N - 1), (n - 1) * cols + ring, (n - 1) * cols + (ring + 1) % cols], 1)); return V.astype(np.float32), np.vstack(F).astype(np.int32)
