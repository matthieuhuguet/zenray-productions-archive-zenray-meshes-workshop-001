# 25 October 2026 : ZenRay Meshes diagnosis : does the objective rank the TRUE spans above the found ones?
import sys, os, json, numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import Methods as M, Bench, SpanFit as S
obj, ver = sys.argv[1], sys.argv[2]
vd = '../benchmark/views/%s' % obj
p = dict(S.P); imgs = S.degraded_depths(vd, p); deg = dict(bits=8, blur=1.5, noise=0.01)
true = {v: float(np.nanmax(np.load(f'{vd}/depth_{v}.npy')) - np.nanmin(np.load(f'{vd}/depth_{v}.npy'))) for v in M.VIEWS_ORDER}
found = json.load(open(f'../benchmark/m08/{obj}_{ver}.log.json'))['result']['spans']
tmp = f'../benchmark/m08/_diag_{obj}.obj'
for name, sp in (('true', true), ('found', found)):
    M.m06_depth_sheet(vd, tmp, n=224, affine='given', spans_given=sp, **deg)
    print(obj, name, 'image %.4f depth %.4f' % (Bench.image_score(tmp, vd)['image_score'], S.depth_consistency(tmp, vd, imgs)), flush=True)
