# 11 November 2026: front and top reference planes of the car-2 sheet at the calibrated scale, with their orthographic cameras. Native nodes only.
import hou, json
FR = json.load(open('/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car2/frame/frame.V1.json')); lo, dims = FR['lo'], FR['dims_m']; hi = [lo[i] + dims[i] for i in range(3)]
V = '/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car2/views_ref/'; W, H = 620, 412
ref = hou.node('/obj/REF_car2'); merge_in = [ref.node('mat_left')]
def plane(name, img, orient, size, centre, axis, flip_u, flip_v):
    for n in [c for c in ref.children() if c.name().startswith(name)]: n.destroy()
    g = ref.createNode('grid', name + '_view'); g.parm('orient').set(orient); g.parmTuple('size').set(size); g.parm('rows').set(H + 1); g.parm('cols').set(W + 1); g.parmTuple('t').set(centre)
    tx = ref.createNode('texture', name + '_uv'); tx.setInput(0, g); tx.parm('type').set(0); tx.parm('axis').set(axis)
    ut = ref.createNode('uvtransform::2.0', name + '_flip'); ut.setInput(0, tx); ut.parmTuple('s').set((-1 if flip_u else 1, -1 if flip_v else 1, 1)); ut.parmTuple('p').set((0.5, 0.5, 0))
    am = ref.createNode('attribfrommap', name + '_colour'); am.setInput(0, ut); am.parm('filename').set(V + img)
    return am
vf = [v for v in FR['views'] if v['name'] == 'front'][0]; x0 = lo[0] - vf['bbox'][0] / vf['sx']; yt = hi[1] + vf['bbox'][1] / vf['sy']
front = plane('front', '00_front_rgb.png', 'xy', (W / vf['sx'], H / vf['sy']), (x0 + W / vf['sx'] / 2, yt - H / vf['sy'] / 2, -3.0), 2, False, False)
vt = [v for v in FR['views'] if v['name'] == 'top'][0]; zl = hi[2] + vt['bbox'][0] / vt['sx']; xt = hi[0] + vt['bbox'][1] / vt['sy']
top = plane('top', '04_top_rgb.png', 'zx', (H / vt['sy'], W / vt['sx']), (xt - H / vt['sy'] / 2, -0.6, zl - W / vt['sx'] / 2), 1, False, False)
mg = ref.node('all_views') or ref.createNode('merge', 'all_views')
mg.setInput(0, ref.node('mat_left')); mg.setInput(1, front); mg.setInput(2, top)
ref.node('OUT_ref').setInput(0, mg); ref.layoutChildren()
obj = hou.node('/obj')
cf = obj.node('CAM_front') or obj.createNode('cam', 'CAM_front'); cf.parmTuple('t').set((0, 0.6, 10)); cf.parmTuple('r').set((0, 0, 0)); cf.parm('projection').set('ortho'); cf.parm('orthowidth').set(2.8); cf.parm('resx').set(1200); cf.parm('resy').set(1200)
ct = obj.node('CAM_top') or obj.createNode('cam', 'CAM_top'); ct.parmTuple('t').set((0, 10, 1.4)); ct.parmTuple('r').set((-90, -90, 0)); ct.parm('projection').set('ortho'); ct.parm('orthowidth').set(2.8); ct.parm('resx').set(1200); ct.parm('resy').set(1200)
