# 25 October 2026 : ZenRay Meshes, fast orthographic rasterizer on the GPU (moderngl, headless OpenGL on Apple M5 Max).
# EN: renders one view of a mesh into mask, depth toward the viewer (metres), camera space flat normal (facing the
# viewer) and face id, in one draw call. Same conventions as Bench.rasterize (pixel centres, x right, y up, z to viewer).
# FR : rastériseur orthographique GPU, masque, profondeur, normale caméra et identifiant de face en un seul rendu.
import numpy as np
import moderngl

_CTX = None
VS = """
#version 330
in vec3 in_pos; in vec3 in_nrm; in float in_id;
uniform vec3 rx; uniform vec3 uy; uniform vec3 tz; uniform vec3 c; uniform float s; uniform float R; uniform float zr;
out vec3 v_n; flat out float v_id; out float v_d;
void main(){
  vec3 p = in_pos - c;
  float px = dot(p, rx) * s; float py = dot(p, uy) * s; float d = dot(p, tz);
  gl_Position = vec4(px / (R * 0.5), py / (R * 0.5), -d / zr, 1.0);
  v_n = vec3(dot(in_nrm, rx), dot(in_nrm, uy), dot(in_nrm, tz)); v_id = in_id; v_d = d;
}"""
FS = """
#version 330
in vec3 v_n; flat in float v_id; in float v_d;
layout(location=0) out vec4 o_n; layout(location=1) out vec4 o_d;
void main(){ vec3 n = normalize(v_n); if (n.z < 0.0) n = -n; o_n = vec4(n, 1.0); o_d = vec4(v_d, v_id, 0.0, 1.0); }"""


def ctx():
    global _CTX
    if _CTX is None:
        _CTX = moderngl.create_standalone_context(require=330)
    return _CTX


class Renderer:
    """Upload a mesh once, render any number of views."""

    def __init__(self, vertices, faces):
        g = ctx()
        v = np.asarray(vertices, np.float64); f = np.asarray(faces, np.int64)
        tri = v[f]                                            # (F,3,3) unindexed: flat normals and per face id
        n = np.cross(tri[:, 1] - tri[:, 0], tri[:, 2] - tri[:, 0])
        n /= np.linalg.norm(n, axis=1, keepdims=True) + 1e-20
        ids = np.repeat(np.arange(len(f), dtype=np.float32), 3)
        data = np.concatenate([tri.reshape(-1, 3).astype(np.float32), np.repeat(n, 3, 0).astype(np.float32), ids[:, None]], 1)
        self.prog = g.program(vertex_shader=VS, fragment_shader=FS)
        self.vbo = g.buffer(np.ascontiguousarray(data).tobytes())
        self.vao = g.vertex_array(self.prog, [(self.vbo, "3f 3f 1f", "in_pos", "in_nrm", "in_id")])
        self.zr = float(np.linalg.norm(v.max(0) - v.min(0))) * 2 + 1.0
        self.nf = len(f)

    def render(self, center, px_per_m, view_axes, res):
        g = ctx()
        rx, uy, tz = (np.array(a, np.float32) for a in view_axes)
        cn = g.texture((res, res), 4, dtype="f4"); cd = g.texture((res, res), 4, dtype="f4")
        db = g.depth_renderbuffer((res, res))
        fbo = g.framebuffer([cn, cd], db)
        fbo.use(); g.viewport = (0, 0, res, res)
        g.enable(moderngl.DEPTH_TEST); g.depth_func = "<"
        fbo.clear(0, 0, 0, 0, depth=1.0)
        cd_clear = np.zeros((res, res, 4), np.float32); cd_clear[..., 1] = -1
        cd.write(cd_clear.tobytes())
        for k, val in (("rx", rx), ("uy", uy), ("tz", tz), ("c", np.array(center, np.float32))):
            self.prog[k].value = tuple(float(x) for x in val)
        self.prog["s"].value = float(px_per_m); self.prog["R"].value = float(res); self.prog["zr"].value = self.zr
        self.vao.render(moderngl.TRIANGLES)
        N = np.frombuffer(cn.read(), np.float32).reshape(res, res, 4)[::-1]
        D = np.frombuffer(cd.read(), np.float32).reshape(res, res, 4)[::-1]
        for o in (fbo, cn, cd, db):
            o.release()
        mask = N[..., 3] > 0.5
        depth = np.where(mask, D[..., 0], np.nan)
        fid = np.where(mask, D[..., 1].round().astype(np.int64), -1)
        return mask, depth, N[..., :3].copy(), fid

    def release(self):
        self.vao.release(); self.vbo.release(); self.prog.release()
