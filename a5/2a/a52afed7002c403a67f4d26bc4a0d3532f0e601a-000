import sys, numpy as np
def read(p):
    V=[];F=[];G=[];names=[];cur=0
    for l in open(p):
        if l.startswith('v '): V.append([float(x) for x in l.split()[1:4]])
        elif l.startswith('g ') or l.startswith('o '):
            sp=l.split(None,1); nm=sp[1].strip() if len(sp)>1 and sp[1].strip() else 'model'; cur=names.index(nm) if nm in names else (names.append(nm) or len(names)-1)
        elif l.startswith('f '):
            ids=[int(t.split('/')[0])-1 for t in l.split()[1:]]
            for j in range(1,len(ids)-1): F.append([ids[0],ids[j],ids[j+1]]); G.append(cur)
    return np.array(V),np.array(F),np.array(G),names
def sub(V,F,G):
    mid={};V=list(V);out=[];og=[]
    def m(a,b):
        k=(min(a,b),max(a,b))
        if k not in mid: V.append((np.array(V[a])+np.array(V[b]))/2); mid[k]=len(V)-1
        return mid[k]
    for (a,b,c),g in zip(F,G):
        ab,bc,ca=m(a,b),m(b,c),m(c,a); out+=[[a,ab,ca],[ab,b,bc],[ca,bc,c],[ab,bc,ca]]; og+=[g]*4
    return np.array(V),np.array(out),np.array(og)
src,dst,n=sys.argv[1],sys.argv[2],int(sys.argv[3]); V,F,G,names=read(src)
for _ in range(n): V,F,G=sub(V,F,G)
with open(dst,'w') as f:
    f.write(''.join('v %.7f %.7f %.7f\n'%tuple(p) for p in V))
    for gi,nm in enumerate(names or ['model']):
        f.write('g %s\n'%nm); f.write(''.join('f %d %d %d\n'%tuple(int(x)+1 for x in t) for t,g in zip(F,G) if g==gi))
print(len(V),len(F))
