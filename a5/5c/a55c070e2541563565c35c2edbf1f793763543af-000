PARAMS = {   # 29 October 2026 : every value of the junctions
    "ctrl_step_m": 0.04,         # one control point per 4 cm on a bridge
    "edge_scale": 1.0,           # mesh edge scale of a junction component (kept for the arms and the shoulder ring)
    "leg_edge_scale": 0.85,      # the legs are meshed with edges 0.85 times the global edge (the toe caps close with it : the counts of their columns have the right parity)
    "torso_edge_scale": 0.6,     # the faces of the torso junction are meshed with edges 0.6 times the global edge : more rows of polygons on the chest, the back and the shoulders
    "hand_edge_scale": 0.3,      # and the faces of a hand junction with 0.4
    "side_margin_m": 0.002,      # the tube side starts 2 mm behind the plane of its open ring : a bridge never runs along the tube
    "side_lateral": 1.5,         # and reaches 1.5 ring radii from the axis of the tube
    "side_along": 3.0,           # and 3 ring radii along it
    "endpoint_free_m": 0.012,    # a bridge may use the wall of the rings within 12 mm (one mesh edge) of its two end nodes (the corners of the rings)
    "smooth_step_m": 0.005,      # the path is resampled every 5 mm before it is smoothed
    "smooth_iters": 140,         # smoothing steps (Laplacian flow, projected on the surface)
    "smooth_lambda": 0.5,        # weight of the neighbours in one step
    "project_every": 4,          # the curve goes back on the surface every 4 steps
    "centre_tol_m": 0.004,       # a node within 4 mm of the plane of symmetry is on it
    "mirror_tol_m": 0.012,       # the mirror image of a node is the nearest node within 12 mm
    "pole_upper": 0.88,          # height of the chest poles between the hips (0) and the shoulders (1)
    "pole_lower": 0.12,          # height of the belly poles (found by ZrlTuneJunction.py : with 0.12 every junction face of Manny closes)
    "lead_m": 0.015,             # a bridge leaves a ring corner straight away from its tube for 15 mm before it turns
    "trunk": 1,                  # 1 : the trunk is a tube of horizontal rings with a chest junction and a pelvis junction ; 0 : one torso junction with two tiers of poles
    "trunk_seams": 12,           # seams (columns) per ring of the trunk, a multiple of 4
    "trunk_step_m": 0.04,        # distance between two rings of the trunk
    "trunk_top_offset_m": 0.09,  # the top ring of the trunk stands this far under the shoulder rings (the arms and the trunk are one loop above 1.34 m on Manny)
    "trunk_bottom_offset_m": 0.10,   # the bottom ring stands this far over the hip rings
