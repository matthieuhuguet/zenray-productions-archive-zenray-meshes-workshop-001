"""28 October 2026 : mirror a rebuilt left part to the right (x -> -x, faces reversed), renamed. python MirrorPart.py <in.npz> <name_L> <name_R> <out.npz>"""
import sys
import numpy as np
i, nl, nr, o = sys.argv[1:5]
d = np.load(i, allow_pickle=True); P = d["P"].copy(); P[:, 0] *= -1
Q = np.array([list(q)[::-1] for q in d["Q"]], dtype=object)
n = np.array([nr if str(x) == nl else str(x) for x in d["names"]])
np.savez(o, P=P, Q=Q, names=n, **({"skin": d["skin"]} if "skin" in d.files else {}))
