<script>
const WIRE="topologie = topologie parfaite comme l'aurait faite un tech artist senior hard surface en 2026, rendue en wireframe fin d'un rouge pur vif #FF0000 uniquement (aucun autre rouge ailleurs sur l'image, lignes d'un pixel de large, sans ombre sur le fil) ; ";
function promptOf(id){const v=document.getElementById('t-'+id).value;const w=document.getElementById('wire');return v.replace('{WIRE}',(!w||w.checked)?WIRE:'')}
function showPrompts(){document.querySelectorAll('[data-prompt]').forEach(p=>{p.textContent=promptOf(p.dataset.prompt)})}
function pngOf(img){const c=document.createElement('canvas');c.width=img.naturalWidth;c.height=img.naturalHeight;c.getContext('2d').drawImage(img,0,0);return new Promise(r=>c.toBlob(r,'image/png'))}
showPrompts();document.getElementById('wire')?.addEventListener('change',showPrompts);
document.getElementById('find')?.addEventListener('input',e=>{const q=e.target.value.trim().toLowerCase();document.querySelectorAll('.piece').forEach(a=>{a.hidden=q&&!a.dataset.name.includes(q)})});
function flash(b,ok,label){const o=b.dataset.label||b.textContent;b.dataset.label=o;b.textContent=label;b.classList.add(ok?'good':'bad');setTimeout(()=>{b.textContent=o;b.classList.remove('good','bad')},1800)}
document.querySelectorAll('[data-copy-img]').forEach(b=>b.addEventListener('click',async()=>{const img=document.querySelector('#'+b.dataset.copyImg+' img.sheet');try{await img.decode();const blob=await pngOf(img);await navigator.clipboard.write([new ClipboardItem({'image/png':blob})]);flash(b,true,'Image copiée')}catch(e){console.warn('clipboard image',e.name,e.message);const r=document.createRange();r.selectNode(img);const s=getSelection();s.removeAllRanges();s.addRange(r);let ok=false;try{ok=document.execCommand('copy')}catch(x){}s.removeAllRanges();flash(b,ok,ok?'Image copiée':'Copie refusée : glisser l\'image')}}));
document.querySelectorAll('[data-copy-txt]').forEach(b=>b.addEventListener('click',async()=>{const t=promptOf(b.dataset.copyTxt);try{await navigator.clipboard.writeText(t);flash(b,true,'Prompt copié')}catch(e){console.warn('clipboard text',e.name,e.message);const a=document.createElement('textarea');a.value=t;document.body.append(a);a.select();let ok=false;try{ok=document.execCommand('copy')}catch(x){}a.remove();flash(b,ok,ok?'Prompt copié':'Copie refusée')}}));
document.querySelectorAll('[data-dl]').forEach(a=>{a.href=document.querySelector('#'+a.dataset.dl+' img.sheet').src});
const lb=document.getElementById('lb');document.querySelectorAll('img.sheet').forEach(i=>i.addEventListener('click',()=>{lb.querySelector('img').src=i.src;lb.classList.add('on')}));lb.addEventListener('click',()=>lb.classList.remove('on'));
</script></body></html>