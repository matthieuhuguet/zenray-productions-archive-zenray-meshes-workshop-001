# 27 October 2026 13:18 Paris: fit an editable cubic guide surface to one measured panel, without touching its assembly neighbours.
import argparse, json, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import numpy as np
from scipy.interpolate import BSpline, LinearNDInterpolator, NearestNDInterpolator
from scipy.spatial import cKDTree
from ReplaceComponents import read_mesh
from TopoFix import save, orient
from collections import Counter, defaultdict


def knots(count):
    return np.r_[np.zeros(4), np.linspace(0, 1, count - 2)[1:-1], np.ones(4)]


def build(config):
    p, q, names = read_mesh(config['source'])
    side = float(config['side'])
    normal_axis=int(config.get('normal_axis',0));projection=config.get('projection_axes',[2,1])
    if len(projection)!=2 or normal_axis in projection:raise ValueError('Invalid projection axes')
    faces = [f for f, name in zip(q, names) if name == config['part']]
    for bound in config.get('axis_bounds',[]):
        axis=int(bound['axis']);lo=bound.get('min',-float('inf'));hi=bound.get('max',float('inf'))
        faces=[f for f in faces if np.all((p[f,axis]>=lo)&(p[f,axis]<=hi))]
    selected = []
    for f in faces:
        v = p[f]; normal = np.cross(v[1]-v[0], v[2]-v[0])
        if side * normal[normal_axis] > config['normal_min'] * np.linalg.norm(normal): selected.append(f)
    edges = Counter(tuple(sorted((a,b))) for f in selected for a,b in zip(f,f[1:]+f[:1]))
    adjacency = defaultdict(list)
    for (a,b), count in edges.items():
        if count == 1: adjacency[a].append(b); adjacency[b].append(a)
    assert adjacency and all(len(v)==2 for v in adjacency.values()), 'Outer skin boundary must be one simple loop'
    remaining=set(adjacency); loops=[]
    while remaining:
        start=min(remaining); loop=[start]; previous=None
        while True:
            choices=[v for v in adjacency[loop[-1]] if v != previous]
            nxt=choices[0]
            if nxt==start: break
            assert nxt not in loop, 'Boundary repeats a vertex'
            previous=loop[-1]; loop.append(nxt)
        remaining.difference_update(loop); loops.append(loop)
    loop=max(loops,key=lambda ids: np.linalg.norm(np.diff(p[ids+[ids[0]]],axis=0),axis=1).sum())
    boundary=p[loop]; yz=boundary[:,projection]
    low, high=yz.min(0),yz.max(0); norm=(yz-low)/(high-low)
    corners=[int(np.argmax(norm @ np.array(c))) for c in [(-1,-1),(1,-1),(1,1),(-1,1)]]
    assert len(set(corners))==4, 'Four distinct corners required'
    # 27 October 2026: use boundary order, then orient the four-sided patch consistently.
    corners=sorted(corners); arcs=[]
    for a,b in zip(corners,corners[1:]+[corners[0]+len(loop)]):
        arc=boundary[np.arange(a,b+1)%len(loop)]; d=np.r_[0,np.cumsum(np.linalg.norm(np.diff(arc,axis=0),axis=1))]; d/=d[-1]
        arcs.append((d,arc))
    if np.linalg.norm(np.diff(arcs[0][1],axis=0),axis=1).sum() < np.linalg.norm(np.diff(arcs[1][1],axis=0),axis=1).sum(): arcs=arcs[1:]+arcs[:1]
    n=config['samples']; t=np.linspace(0,1,n)
    curves=[np.stack([np.interp(t,d,a[:,k]) for k in range(3)],axis=1) for d,a in arcs]
    bottom,right,top,left=curves[0],curves[1],curves[2][::-1],curves[3][::-1]
    u=t[:,None,None]; v=t[None,:,None]
    patch=(1-v)*bottom[:,None]+v*top[:,None]+(1-u)*left[None,:]+u*right[None,:]
    patch-=((1-u)*(1-v)*bottom[0]+u*(1-v)*bottom[-1]+(1-u)*v*top[0]+u*v*top[-1])
    used=sorted({x for f in selected for x in f}); skin=p[used]
    interp=LinearNDInterpolator(skin[:,projection],skin[:,normal_axis]); nearest=NearestNDInterpolator(skin[:,projection],skin[:,normal_axis])
    query=patch[:,:,projection]; x=interp(query); missing=~np.isfinite(x);x[missing]=nearest(query[missing]);patch[:,:,normal_axis]=x
    nu,nv=config['controls']; ku,kv=knots(nu),knots(nv)
    bu=BSpline.design_matrix(t,ku,3).toarray();bv=BSpline.design_matrix(t,kv,3).toarray()
    design=np.einsum('ui,vj->uvij',bu,bv).reshape(n*n,nu*nv)
    weights=np.ones((n,n));weights[[0,-1],:]=config.get('boundary_weight',1);weights[:,[0,-1]]=config.get('boundary_weight',1)
    weights=weights.reshape(-1,1)
    control=np.linalg.lstsq(design*weights,patch.reshape(-1,3)*weights,rcond=None)[0].reshape(nu,nv,3)
    su,sv=config['mesh'];a=np.linspace(0,1,su);b=np.linspace(0,1,sv)
    # 27 October 2026: apply interface gap clearances along U and V if configured.
    gaps=config.get('interface_gap_m')
    if gaps:
        span_u=float(np.linalg.norm(control[-1].mean(0)-control[0].mean(0)))
        span_v=float(np.linalg.norm(control[:,-1].mean(0)-control[:,0].mean(0)))
        fu=min(float(gaps[0])/max(span_u,1e-6),0.1)
        fv=min(float(gaps[1])/max(span_v,1e-6),0.1)
        a=fu+a*(1-2*fu);b=fv+b*(1-2*fv)
    au=BSpline.design_matrix(a,ku,3).toarray();av=BSpline.design_matrix(b,kv,3).toarray()
    surface=np.einsum('ui,vj,ijc->uvc',au,av,control)
    du=np.gradient(surface,axis=0);dv=np.gradient(surface,axis=1);normals=np.cross(du,dv);normals/=np.maximum(np.linalg.norm(normals,axis=2,keepdims=True),1e-12)
    if np.mean(normals[:,:,normal_axis])*side<0:normals*=-1
    outer=surface.reshape(-1,3);inner=(surface-config['thickness_m']*normals).reshape(-1,3);pts=np.vstack([outer,inner]);offset=len(outer)
    quads=[]
    for i in range(su-1):
        for j in range(sv-1):
            face=[i*sv+j,(i+1)*sv+j,(i+1)*sv+j+1,i*sv+j+1];quads+=[face,[x+offset for x in face[::-1]]]
    border=list(range(sv))+[i*sv+sv-1 for i in range(1,su)]+[(su-1)*sv+j for j in range(sv-2,-1,-1)]+[i*sv for i in range(su-2,0,-1)]
    for a,b in zip(border,border[1:]+border[:1]):quads.append([a,b,b+offset,a+offset])
    part_names=[config['part']]*len(quads);quads,_=orient(pts,quads,part_names)
    save(config['output'],pts,quads,part_names)
    fit=(design@control.reshape(-1,3)).reshape(n,n,3)
    residual=np.linalg.norm(fit-patch,axis=2)*1000
    guides={'date':'27 October 2026','source':config['source'],'part':config['part'],'controls':control.tolist(),'knots_u':ku.tolist(),'knots_v':kv.tolist(),'degree':3,'config':config,'fit_mm_p50_p95_max':np.percentile(residual,[50,95,100]).tolist(),'boundary_max_mm':float(max(residual[0].max(),residual[-1].max(),residual[:,0].max(),residual[:,-1].max())),'boundary_arc_counts':[len(a) for d,a in arcs],'source_boundary_loops':len(loops),'status':'prototype fitted to measured existing skin; reference and interface validation required'}
    Path(config['guides']).write_text(json.dumps(guides,indent=2)+'\n')
    return {'faces':len(quads),'controls':nu*nv,'fit_mm':guides['fit_mm_p50_p95_max']}


if __name__=='__main__':
    parser=argparse.ArgumentParser();parser.add_argument('config');args=parser.parse_args()
    print(json.dumps(build(json.load(open(args.config)))))
