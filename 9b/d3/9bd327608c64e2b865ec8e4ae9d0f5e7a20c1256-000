# 26 October 2026: scratch exploration of the ap-title render for the thumbnail (not the delivered pipeline).
# It writes only under Montage/Thumbnail/Work, through a scratch projects root, so the real Motion base stays untouched.
import copy
import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True  # never write __pycache__ into the ZenRayMotionDesign repository
MOTION = Path("/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayMotionDesign/motion")
sys.path.insert(0, str(MOTION))
import server  # noqa: E402  the same module the Motion Design app runs

WORK = Path("/Users/zenray/.claude/tmp/tmp-zenray-meshes/Montage/Thumbnail/Work")
REAL_ROOT = Path(os.path.expanduser(server.CFG["paths"]["projects"]))
base = json.loads((REAL_ROOT / "zenray-meshes-end-title-ppm" / "project.json").read_text(encoding="utf-8"))
os.environ["ZRMD_MOTION_PROJECTS"] = str(WORK / "projects")

size = sys.argv[1] if len(sys.argv) > 1 else "125"
pid = "zenray-meshes-thumbnail-ppm"
p = copy.deepcopy(base)
p["format"] = "1x1"
p["fps"] = 60
p["title"] = "ZenRay Meshes : Modeling Car, miniature (exploration)"
sc = p["scenes"][0]
sc["params"]["items"] = [f"Modeling Car | 960 | 540 | {size} | 0.00 | 2.55 | 0.63 | 0.58 | 0.28"]
sc["params"]["bg"] = "transparent"
p["theme"]["bg"] = "transparent"
server.write_project(pid, p)
page = server.cook(pid, WORK / "pages" / f"explore-{size}")
html_path = page / "index.html"
html = html_path.read_text(encoding="utf-8")
old = "html, body { margin: 0; padding: 0; background: #000; }"
if old not in html:
    raise SystemExit("export page background rule not found, the cooked page changed")
html_path.write_text(html.replace(old, "html, body { margin: 0; padding: 0; background: transparent; }"), encoding="utf-8")
out = WORK / "snaps" / f"explore-{size}"
out.mkdir(parents=True, exist_ok=True)
r = server.hyperframes(page, "snapshot", "--at", "1.5", "--no-end", "--zoom", "0,0,1080,1080", "--zoom-scale", "2", "-o", str(out), timeout=300)
print("returncode", r.returncode)
print((r.stdout or "")[-1200:])
print((r.stderr or "")[-1200:])
for f in sorted(out.rglob("*")):
    if f.is_file():
        print("file", f, f.stat().st_size)
