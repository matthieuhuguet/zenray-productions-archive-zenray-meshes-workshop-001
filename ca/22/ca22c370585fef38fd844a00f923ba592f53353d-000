#!/bin/zsh
# 29 October 2026 : builds "ZenRay Meshes.app" in ~/Applications (found by Spotlight and the Dock) : the launcher ZenRayLines.sh as the executable,
# the atelier and python paths beside it, an icon, an ad hoc signature. Rebuild only when the launcher itself changes : the page and the server
# code are read from the atelier at every launch, so the app always opens the latest ZenRay Meshes. Usage : BuildLinesApp.sh [destination folder]
# FR : construit « ZenRay Meshes.app » : un lanceur, jamais une copie du code ; l'app ouvre toujours la dernière version.
set -euo pipefail
HERE="${0:A:h}"; ROOT="${HERE:h:h:h}"; DEST="${1:-$HOME/Applications}"; APP="$DEST/ZenRay Meshes.app"; OLD="$DEST/ZenRay Lines.app"
PY=/Users/zenray/.venvs/zenray-meshes/bin/python
if [[ -d "$OLD" ]]; then mkdir -p "$DEST/Deprecated" && rm -rf "$DEST/Deprecated/ZenRay Lines.app" && mv "$OLD" "$DEST/Deprecated/"; fi   # 30 October 2026 : ZenRay Lines is now ZenRay Meshes (module Retopology) ; the old bundle is kept in Deprecated
rm -rf "$APP"; mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$HERE/ZenRayLines.sh" "$APP/Contents/MacOS/ZenRayMeshes"; chmod +x "$APP/Contents/MacOS/ZenRayMeshes"
print -rn -- "$ROOT" > "$APP/Contents/Resources/root-path.txt"; print -rn -- "$PY" > "$APP/Contents/Resources/python-path.txt"
[[ -f "$HERE/icon/AppIcon.icns" ]] || "$PY" -I "$HERE/BuildLinesIcon.py" >/dev/null
cp "$HERE/icon/AppIcon.icns" "$APP/Contents/Resources/AppIcon.icns"
cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>ZenRay Meshes</string>
  <key>CFBundleDisplayName</key><string>ZenRay Meshes</string>
  <key>CFBundleIdentifier</key><string>studio.zenray.meshes</string>
  <key>CFBundleExecutable</key><string>ZenRayMeshes</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
codesign --force --sign - "$APP" >/dev/null 2>&1 || true
echo "{\"ok\":true,\"app\":\"$APP\"}"
