# 25 October 2026 : ZenRay Meshes, one strip to judge a component by eye: the reference panel of a view next to the
# materials render of the same side (crop box of the ColorViews board), same height. FR : bande de comparaison à l'œil.
# Usage: python CompareFace.py <tag> <view: front|left> [height=320]
import sys
from PIL import Image
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"
CROP = {"front": ((1065, 280, 1600, 600), "00_front_rgb.png"), "left": ((60, 300, 820, 580), "02_left_rgb.png")}


def main(tag, view, h=320):
    h = int(h); box, ref = CROP[view]
    m = Image.open(W + "versions/Car_%s_materials.png" % tag).crop(box); m = m.resize((int(m.width * h / m.height), h))
    r = Image.open(W + "work/car/views/" + ref).convert("RGB"); r = r.resize((int(r.width * h / r.height), h))
    o = Image.new("RGB", (r.width + m.width, h), (96, 96, 96)); o.paste(r, (0, 0)); o.paste(m, (r.width, 0))
    out = W + "versions/Car_%s_%s_cmp.png" % (tag, view); o.save(out); print(out)


if __name__ == "__main__":
    main(*sys.argv[1:])
