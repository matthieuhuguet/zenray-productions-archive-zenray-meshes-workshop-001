"""29 October 2026 : ZenRay Retopology PART AUDIT, every part of the validated car (v752) judged as it is : quads only, closed, manifold,
oriented, smallest scaled Jacobian, edge ratio ; a part already clean is KEPT (it is already a perfect component), the others go to the
retopology. Writes work/lines/part_audit.json.        FR : l'audit de chaque pièce de v752 telle quelle : les pièces propres sont gardées."""
import json, sys
from collections import Counter
import numpy as np
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
sys.path.insert(0, f"{ROOT}/Scripts/retopo"); sys.path.insert(0, f"{ROOT}/Scripts/lines"); import ZrrData as D, ZrrCheck as K, ZrlFair as FA
PARAMS = {"jacobian_min": 0.3, "edge_ratio_max": 8.0, "fair_prefixes": ["CAR_body_", "CAR_bumper_"]}   # 29 October 2026 : a kept part must have no crushed or folded quad

car = D.load(); out = {}
for k, n in enumerate(car["names"]):
    ps = np.flatnonzero(car["T"] == k)
    if len(ps) == 0: continue
    sides = Counter(car["C"][ps].tolist()); E = Counter(); D_ = Counter(); Q = []
    for p in ps:
        v = car["I"][car["off"][p]:car["off"][p + 1]]
        if len(v) == 4: Q.append(v)
        for a, b in zip(v, np.roll(v, -1)): E[(min(a, b), max(a, b))] += 1; D_[(a, b)] += 1
    J = K.scaled_jacobian(car["P"], np.array(Q)) if Q else np.array([1.0])
    L = [np.linalg.norm(car["P"][a] - car["P"][b]) for (a, b) in E]
    r = {"polys": int(len(ps)), "quads_only": set(sides) == {4}, "border_edges": sum(1 for c in E.values() if c == 1), "nonmanifold": sum(1 for c in E.values() if c > 2),
         "flipped": sum(1 for c in D_.values() if c > 1), "jac_min": round(float(J.min()), 3), "edge_ratio": round(float(max(L) / max(min(L), 1e-9)), 1)}
    r["clean"] = bool(r["quads_only"] and r["border_edges"] == 0 and r["nonmanifold"] == 0 and r["flipped"] == 0 and r["jac_min"] >= PARAMS["jacobian_min"])
    r["ripple_p99_deg"] = round(FA.ripple(car["P"], np.array(Q)), 2) if Q else None                 # 29 October 2026 : clean is not enough, fair too
    r["fair_applies"] = any(n.startswith(p) for p in PARAMS["fair_prefixes"])   # 29 October 2026 : class A smoothness is asked of body panels and glass only
    r["fair"] = bool(not r["fair_applies"] or (r["ripple_p99_deg"] is not None and r["ripple_p99_deg"] <= FA.PARAMS["fair_p99_deg"]))
    out[n] = r
json.dump(out, open(f"{ROOT}/work/lines/part_audit.json", "w"), indent=1)
clean = [n for n, r in out.items() if r["clean"]]; dirty = {n: r for n, r in out.items() if not r["clean"]}
print("clean", len(clean), "of", len(out)); print("NOT clean :")
for n, r in sorted(dirty.items()): print(f"  {n:34s} {r}")
