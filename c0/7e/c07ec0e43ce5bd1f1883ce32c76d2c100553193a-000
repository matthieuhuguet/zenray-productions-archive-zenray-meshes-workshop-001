import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); sys.dont_write_bytecode=True
import diag, numpy as np
S='/Users/zenray/.claude/tmp/tmp-zenray-meshes'
def zone_report(obj,edge,o,worst=6):
    m=diag.AP.mesh(os.path.abspath(obj)); zones=diag.ANY.segment(m,25.0,max(4,int(0.002*len(m['F']))),merge_deg=35.0,log=lambda s:None); rows=[]
    tot=dict(border=[0,0],corner=[0,0],interior=[0,0]); totf=dict(border=[0,0],corner=[0,0],interior=[0,0])
    for k,(Z,seed) in enumerate(zones):
        try: r,err=diag.fill4(m,Z,edge,o)
        except Exception: continue
        if r is None: continue
        n0,n1=r['info']['n0'],r['info']['n1']; Q=r['Q']; qm=diag.quad_metrics(r['P3r'],Q,r['Nz'][r['tri_of']])
        ci=np.repeat(np.arange(n0),n1); cj=np.tile(np.arange(n1),n0)
        d=np.minimum.reduce([ci,cj,n0-1-ci,n1-1-cj]); corner=(np.minimum(ci,n0-1-ci)<=1)&(np.minimum(cj,n1-1-cj)<=1)
        zone={'corner':corner,'border':(d<=1)&~corner,'interior':d>1}
        for key,mask in zone.items():
            tot[key][0]+=int((qm['jmin'][mask]<0.3).sum()); tot[key][1]+=int(mask.sum()); totf[key][0]+=int((qm['jmin'][mask]<0).sum()); totf[key][1]+=int(mask.sum())
        rows.append((int((qm['jmin']<0).sum()),k,r['info']['tris'],n0,n1,round(r['info']['opp_ratio'],2),round(float(np.median(qm['aspect'])),2),round(float(np.median(np.degrees(np.arcsin(np.clip(qm['jmin'],-1,1))))),1)))
    return rows,tot,totf
if __name__=='__main__':
    obj,edge=sys.argv[1],float(sys.argv[2]); o=dict(k=300,relax=0.0)
    for kv in sys.argv[3:]:
        a,b=kv.split('='); o[a]=float(b) if a in ('sag','relax','k') else b
    rows,tot,totf=zone_report(obj,edge,o); rows.sort(reverse=True)
    print('worst zones: folds zone tris n0 n1 opp_ratio median_aspect median_min_corner_angle_deg'); [print(*r) for r in rows[:6]]
    for key in tot: print(key,'squashed',tot[key][0],'/',tot[key][1],f'= {tot[key][0]/max(tot[key][1],1):.2f}','| folded',totf[key][0],f'= {totf[key][0]/max(totf[key][1],1):.3f}')
