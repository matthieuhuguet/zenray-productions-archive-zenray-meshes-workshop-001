"""Density model for QuadWild Bi-MDF : quads ~ k * A / (scaleFact * e)^2 where e = mean edge of the remeshed mesh (_rem_p0.obj), A = surface area.
FR : modele de densite : nombre de quads en fonction de scaleFact."""
import json, sys, os, numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); import qw6
def area(path):
    V = []; F = []
    for l in open(path):
        t = l.split()
        if t and t[0] == "v": V.append([float(x) for x in t[1:4]])
        elif t and t[0] == "f": F.append([int(x.split("/")[0]) - 1 for x in t[1:]])
    V = np.array(V); T = np.array([[f[0], f[k], f[k + 1]] for f in F for k in range(1, len(f) - 1)])
    return float(0.5 * np.linalg.norm(np.cross(V[T[:, 1]] - V[T[:, 0]], V[T[:, 2]] - V[T[:, 0]]), axis=1).sum()), V, T
def mean_edge(path):
    A, V, T = area(path); e = np.concatenate([np.linalg.norm(V[T[:, k]] - V[T[:, (k + 1) % 3]], axis=1) for k in range(3)]); return float(e.mean())
if __name__ == "__main__":
    R = [json.loads(l) for l in open(qw6.HERE + "/results1.jsonl")]; kk = {}
    for m in ("arch_hard", "lily_plant", "eucalyptus_tree", "manny_character"):
        A = area(f"{qw6.GT}/{m}.obj")[0]
        for d in R:
            if d["mesh"] == m and d["prep"] in ("basic", "organic") and d["tag"].startswith(("base", "scale")) and "quads" in d:
                s = d["kw"].get("scaleFact", 1) if d.get("kw") else 1
                k = d["quads"] * (s * d["edge_size"]) ** 2 / A; kk.setdefault((m, d["prep"]), []).append((s, d["quads"], round(k, 3), d["edge_size"]))
    for k, v in kk.items(): print(k, "area", round(area(f"{qw6.GT}/{k[0]}.obj")[0], 4), v)
