# 10 November 2026: the Object-level HDAs (truck components): node created in /obj, its displayed SOP cooked, counts.
import hou, json, glob, os
res = json.load(open('/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026/data/hda_check.json'))
for r in res:
    if r.get('category') != 'Object': continue
    f = '/Users/zenray/.claude/skills/zenray-meshes/otls/' + r['file']; hou.hda.installFile(f); d = hou.hda.definitionsInFile(f)[0]
    n = hou.node('/obj').createNode(d.nodeTypeName())
    parms = [p for p in n.parms() if not p.isHidden() and p.parmTemplate().type().name() not in ('Folder', 'FolderSet', 'Label', 'Separator')]
    tx = {'tx', 'ty', 'tz', 'rx', 'ry', 'rz', 'sx', 'sy', 'sz', 'px', 'py', 'pz', 'prx', 'pry', 'prz', 'scale', 'xOrd', 'rOrd', 'keeppos', 'childcomp', 'constraints_on', 'constraints_path', 'lookatpath', 'lookupobjpath', 'lookup', 'pathobjpath', 'roll', 'pos', 'uparmtype', 'pathorient', 'up', 'bank', 'pre_xform', 'shop_materialpath', 'shop_materialopts', 'tdisplay', 'display', 'use_dcolor', 'dcolor', 'picking', 'pickscript', 'caching', 'vport_shadeopen', 'vport_displayassubdiv', 'vport_onionskin', 'stereo', 'iconscale'}
    own = [p for p in parms if p.name() not in tx and not p.name().startswith(('vm_', 'ri_', 'categories', 'reflect', 'refract', 'light', 'vport', 'viewer', 'ogl_', 'karma', 'xn__'))]
    r['visible_parms'] = len(own); r['parm_names'] = [p.name() for p in own][:24]
    sop = n.displayNode()
    try:
        g = sop.geometry(); r['points'] = len(g.points()); r['prims'] = len(g.prims()); r['quads'] = sum(1 for p in g.prims() if len(p.vertices()) == 4)
        r['errors'] = [e[:160] for e in sop.errors()]
    except Exception as e:
        r['cook_error'] = str(e)[:200]
    r.pop('note', None); print(r['file'], r['visible_parms'], r.get('prims'), r.get('errors') or r.get('cook_error') or '', flush=True)
json.dump(res, open('/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026/data/hda_check.json', 'w'), indent=1)
