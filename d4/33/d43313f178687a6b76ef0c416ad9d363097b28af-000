"""Pass 9 : finite difference test of the analytic gradient of the barrier energy (zr8_straighten.barrier_energy_grad), and a broken gradient
that the test must reject. Exit code 0 = green. Written 30 October 2026.
FR : test du gradient analytique contre les differences finies, avec un gradient volontairement faux qui doit etre rejete."""
import sys
sys.path.insert(0, ".")
import numpy as np
import zr8_straighten as S

rng = np.random.default_rng(3)
n = 7; x, y = np.meshgrid(np.arange(n), np.arange(n))
P = np.c_[x.ravel(), y.ravel(), 0.1 * rng.normal(size=n * n)].astype(float) + rng.normal(0, 0.08, (n * n, 3))
Q = np.array([[i * n + j, i * n + j + 1, (i + 1) * n + j + 1, (i + 1) * n + j] for i in range(n - 1) for j in range(n - 1)])
nq = S.quad_normals(P, Q); At = S.quad_areas(P, Q)
theta, eps = 0.125, 0.05
E, G = S.barrier_energy_grad(P, Q, nq, At, eps, theta)
G_fd = np.zeros_like(P); h = 1e-6
for v in range(len(P)):
    for c in range(3):
        Pp = P.copy(); Pm = P.copy(); Pp[v, c] += h; Pm[v, c] -= h
        G_fd[v, c] = (S.barrier_energy_grad(Pp, Q, nq, At, eps, theta)[0] - S.barrier_energy_grad(Pm, Q, nq, At, eps, theta)[0]) / (2 * h)
rel = np.abs(G - G_fd).max() / max(np.abs(G_fd).max(), 1e-30)
bad = G.copy(); bad[3] *= 1.5                                   # deliberately broken gradient
rel_bad = np.abs(bad - G_fd).max() / max(np.abs(G_fd).max(), 1e-30)
print("relative max error of the analytic gradient : %.2e ; broken gradient : %.2e" % (rel, rel_bad))
ok = rel < 1e-5 and rel_bad > 1e-2
print("GREEN" if ok else "RED")
sys.exit(0 if ok else 1)
