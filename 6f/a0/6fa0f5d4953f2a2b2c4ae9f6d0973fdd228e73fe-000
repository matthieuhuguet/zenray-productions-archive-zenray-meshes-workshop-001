# 27 October 2026 13:51 Paris: independent closed backing sampled from a panel grid, with configurable clearance and overlap.
import argparse,json,os,sys
import numpy as np
sys.path.insert(0,os.path.dirname(os.path.abspath(__file__)))
from ReplaceComponents import read_mesh
from TopoFix import save,orient


def main(args):
    config=json.load(open(args.config));panel,_,_=read_mesh(config['panel']);base,faces,names=read_mesh(config['assembly'])
    nu,nv=config['grid'];outer=panel[:nu*nv].reshape(nu,nv,3).copy();centre=outer[:,:,1:].mean(axis=(0,1))
    outer[:,:,1:]=centre+(outer[:,:,1:]-centre)*float(config['scale'])
    outer[:,:,0]-=float(config['offset_m']);inner=outer.copy();inner[:,:,0]-=float(config['thickness_m'])
    p=np.vstack([outer.reshape(-1,3),inner.reshape(-1,3)]);offset=nu*nv;q=[]
    for i in range(nu-1):
        for j in range(nv-1):
            face=[i*nv+j,(i+1)*nv+j,(i+1)*nv+j+1,i*nv+j+1];q.extend([face,[x+offset for x in face[::-1]]])
    border=list(range(nv))+[i*nv+nv-1 for i in range(1,nu)]+[(nu-1)*nv+j for j in range(nv-2,-1,-1)]+[i*nv for i in range(nu-2,0,-1)]
    for a,b in zip(border,border[1:]+border[:1]):q.append([a,b,b+offset,a+offset])
    q,_=orient(p,q,[config['part_left']]*len(q));mirror=p.copy();mirror[:,0]*=-1
    start=len(base);allp=np.vstack([base,p,mirror]);allq=faces+[[v+start for v in face] for face in q]+[[v+start+len(p) for v in face[::-1]] for face in q]
    alln=names+[config['part_left']]*len(q)+[config['part_right']]*len(q)
    save(args.output,allp,allq,alln);print(json.dumps({'added_components':2,'faces_each':len(q),'offset_m':config['offset_m'],'scale':config['scale']}))

if __name__=='__main__':
    ap=argparse.ArgumentParser();ap.add_argument('config');ap.add_argument('output');main(ap.parse_args())
