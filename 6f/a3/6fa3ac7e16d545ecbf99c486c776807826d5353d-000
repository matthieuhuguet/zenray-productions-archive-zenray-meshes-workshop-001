    L.append(s)
def lic(t):
    t = t or ""
    tl = t.lower()
    tags = []
    if "affero" in tl or "agpl" in tl: tags.append("AGPL")
    if re.search(r"gnu general public|gpl", tl) and "affero" not in tl and "lesser" not in tl: tags.append("GPL")
    if "lgpl" in tl or "lesser" in tl: tags.append("LGPL")
    if re.search(r"\bmit\b", tl): tags.append("MIT")
    if "bsd" in tl: tags.append("BSD")
    if "apache" in tl: tags.append("Apache-2.0")
    if "mpl" in tl or "mozilla" in tl: tags.append("MPL-2.0")
    if "cc by-nc" in tl or "non-commercial" in tl or "noncommercial" in tl or "non commercial" in tl or "academic" in tl: tags.append("non commercial ou académique")
    if "aucun" in tl and "license" in tl or "aucune licence" in tl or "aucun fichier license" in tl: tags.append("aucune licence trouvée")
    if "conflit" in tl: tags.append("CONFLIT")
    return " + ".join(dict.fromkeys(tags)) if tags else "à lire"
