def clean(s):
    s = str(s).replace("—", ", ").replace("–", ", ")
    s = re.sub(r"-{2,}", "-", s)
    s = re.sub(r"\b(\d{4})-(\d\d)-(\d\d)\b", r"\1/\2/\3", s)
    return s.replace("|", "/").replace("\n", " ")
def clean_text(s):
    s = str(s).replace("\u2014", ", ").replace("\u2013", ", ")
    s = re.sub(r"-{2,}", "-", s)
    s = re.sub(r"\b(\d{4})-(\d\d)-(\d\d)\b", r"\1/\2/\3", s)
    return s.replace("\n", " ")
def e(s=""):
