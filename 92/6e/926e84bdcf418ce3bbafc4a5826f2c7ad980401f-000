    lab = np.where(keep[cell], cell, 0); nxt = n + 1; colours = {}
    for i, sl in enumerate(ndi.find_objects(black)):
        if sl is not None and (black[sl] == i + 1).sum() >= r["C_black_cell_px"] * sc * sc: lab[sl][black[sl] == i + 1] = nxt; colours[nxt] = (10.0, 10.0, 10.0); nxt += 1
    idx = ndi.distance_transform_edt(lab == 0, return_distances=False, return_indices=True); full = lab[idx[0], idx[1]]; trim = max(int(round(r["C_outer_trim_px"] * sc)), 0); inside = ndi.binary_erosion(obj, iterations=trim) if trim else obj; full = np.where(inside, full, 0); out = np.full(full.shape, -1, np.int32); cells = []; ids = np.unique(full[full > 0])
    for new, i in enumerate(ids.tolist()):
        m = full == i
        if i in colours: col = colours[i]
        else:
            core = (lab == i) & ~ink; core2 = ndi.binary_erosion(core, iterations=1); px = big[core2 if core2.sum() >= 5 else core]; col = tuple(np.median(px, axis=0).tolist()) if len(px) else (0.0, 0.0, 0.0)
        c = np.array(col)
        if c.max() - c.min() < r["C_bg_sat"] and c.max() > r["C_dark_val"] * 1.2: continue      # a grey cell inside the outline is the background seen through a hole. FR : une cellule grise dans le contour est le fond vu à travers un trou.
        out[m] = len(cells); ys, xs = np.nonzero(m); cells.append(dict(colour=[round(float(v), 1) for v in col], area=int(m.sum()), box=[int(xs.min()), int(ys.min()), int(xs.max()) + 1, int(ys.max()) + 1]))
    return out, cells


def palette(cells, r, sc):
    """the colours of the whole sheet : close colours are one, from the largest area down ; a small cell is blended with its outline, so it joins a colour from further away"""
    order = sorted(range(len(cells)), key=lambda i: -cells[i]["area"]); P = []; small = r["C_small_cell_px"] * sc * sc
    for i in order:
        c = np.array(cells[i]["colour"]); d = [float(np.linalg.norm(c - q)) for q in P]; lim = r["C_small_dist"] if cells[i]["area"] < small else r["C_palette_dist"]
        if d and min(d) < lim: cells[i]["pal"] = int(np.argmin(d))
        else: cells[i]["pal"] = len(P); P.append(c)
    return [p.tolist() for p in P]


def side_of(c, halfw, r):
    """which side of the object a cell shows : +1, -1, or 0 for what crosses the plane of symmetry"""
    if c["view"] == "left": return 1
    if c["view"] == "right": return -1
    lo, hi = c["ext"][0]; cx = (lo + hi) / 2
    if lo * hi < 0 and min(abs(lo), abs(hi)) > r["C_centre_frac"] * max(abs(lo), abs(hi)): return 0
    if abs(cx) < r["C_centre_frac"] * halfw: return 0
    return 1 if cx > 0 else -1


def read_table(home):
    """the table ChatGPT gave, pasted in 04_received/cut_table.txt : each row holds a hex colour and the name of the piece"""
    f = f"{home}/04_received/cut_table.txt"; rows = []
    if not os.path.exists(f): return rows
    for line in open(f):
        m = re.search(r"#([0-9a-fA-F]{6})", line)
        if not m: continue
        cols = [c.strip(" *`") for c in line.strip().strip("|").split("|")]; k = next(i for i, c in enumerate(cols) if m.group(0) in c); name = next((c for c in cols[k + 1:] + cols[:k] if c and not re.fullmatch(r"[\d\s.,xX]+", c) and "#" not in c), None)
        if name: rows.append((np.array([int(m.group(1)[q:q + 2], 16) for q in (0, 2, 4)], float), name))
    return rows


def names_for(home, defs):
    """the name of each piece : the row of the table nearest to its colour, else a neutral name and its colour"""
    table = read_table(home); fam = {}
    for d in defs:
        c = np.array([int(d["hex"][q:q + 2], 16) for q in (1, 3, 5)], float); name = min(table, key=lambda t: np.linalg.norm(t[0] - c))[1] if table else None; fam[d["family"]] = dict(fr=name or f"Pièce {int(d['family'][-2:])}", group="Pièces", shape=f"pièce de la planche de découpe, couleur {d['hex']}")
    return dict(groups=["Pièces"], families=fam)


