def world_map(fr, v):
    """panel column and row to metres, through the frame"""
    lo = np.array(fr["lo"]); D = np.array(fr["dims_m"]); hi = lo + D; rx, uy = np.array(v["rx"]), np.array(v["uy"]); a, b = int(np.argmax(np.abs(rx))), int(np.argmax(np.abs(uy))); umin = lo[a] if rx[a] > 0 else -hi[a]; vmax = hi[b] if uy[b] > 0 else -lo[b]; bb = v["bbox"]; ppm = v["px_per_m"]; sa, sb = np.sign(rx[a]), np.sign(uy[b])
    return a, b, (lambda col: (umin + (col - bb[0]) / ppm) * sa), (lambda row: (vmax - (row - bb[1]) / ppm) * sb)


def cells_of(rgb, sc, r):
    """the closed cells of one panel at sc times its size : labels 0..n-1, -1 outside, with the colour of each cell ; the black lines go to their nearest cell, so a border lies in the middle of its line"""
