def side_of(c, halfw, r):
    """which side of the object a cell shows : +1, -1, or 0 for what crosses the plane of symmetry"""
    if c["view"] == "left": return 1
    if c["view"] == "right": return -1
    lo, hi = c["ext"][0]; cx = (lo + hi) / 2
    if lo * hi < 0 and min(abs(lo), abs(hi)) > r["C_centre_frac"] * max(abs(lo), abs(hi)): return 0
    if abs(cx) < r["C_centre_frac"] * halfw: return 0
    return 1 if cx > 0 else -1


def read_table(home):
    """the table ChatGPT gave, pasted in 04_received/cut_table.txt : each row holds a hex colour and the name of the piece"""
    f = f"{home}/04_received/cut_table.txt"; rows = []
    if not os.path.exists(f): return rows
    for line in open(f):
        m = re.search(r"#([0-9a-fA-F]{6})", line)
        if not m: continue
        cols = [c.strip(" *`") for c in line.strip().strip("|").split("|")]; k = next(i for i, c in enumerate(cols) if m.group(0) in c); name = next((c for c in cols[k + 1:] + cols[:k] if c and not re.fullmatch(r"[\d\s.,xX]+", c) and "#" not in c), None)
        if name: rows.append((np.array([int(m.group(1)[q:q + 2], 16) for q in (0, 2, 4)], float), name))
    return rows


