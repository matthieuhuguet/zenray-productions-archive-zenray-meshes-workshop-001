def main():
    ap = argparse.ArgumentParser(); ap.add_argument("doc"); ap.add_argument("--ref", required=True); ap.add_argument("--out", required=True); ap.add_argument("--edge", type=float, default=0.03); ap.add_argument("--sweep", action="store_true", help="sweep the edge length of the panels that still fold"); ap.add_argument("--reflex", action="store_true", help="cut a patch with reflex corners (U, L) into rectangles when that folds fewer quads"); ap.add_argument("--tune", action="store_true", help="a tournament of the fill knobs for every patch that folds quads ; the winners are written into the document (component_mesh_params)"); ap.add_argument("--auto-edge", type=float, default=0.0, help="N : an edge per panel that gives about N quads (equal density)"); ap.add_argument("--shapes", action="store_true", help="try 5 and 6 sided shapes of every patch that still folds quads"); ap.add_argument("--repair", action="store_true", help="local repair of folded and squashed quads after the fill"); ap.add_argument("--save-doc"); a = ap.parse_args()
