            if bestf[1] != 1.0:
                res = NM.build(sub, dict(base, **dict(knobs, edge_m=e * bestf[1]))); doc.setdefault("component_edge_m", {})[name] = e * bestf[1]; log("%s : edge x%.2f, score %.3f" % (name, bestf[1], bestf[0]))
        faces = [f for f in res["faces"] if (f.get("reason") or "") != "complement"]; ok = [f for f in faces if f["status"] == "meshed"]      # the sub document holds one patch : the face that is not the complement is the component (its seed may sit a hair outside the loop)
        if not ok or not len(res["Q"]): rows.append((name, "UNMESHED", ",".join(sorted({(f.get("reason") or "")[:20] for f in faces})), 0, 0, 0)); continue
