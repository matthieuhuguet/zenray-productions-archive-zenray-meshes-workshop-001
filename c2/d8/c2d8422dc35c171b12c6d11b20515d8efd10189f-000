import json, sys
sys.path.insert(0, '/Users/zenray/.claude/skills/zenray-meshes/scripts/v4')
import numpy as np, ViewGraph as VG
from PIL import Image, ImageDraw
proj = json.load(open('project.json')); frame = json.load(open(proj['frame'])); v = sys.argv[1]; k = float(sys.argv[3]) if len(sys.argv) > 3 else 3.0
vd = sys.argv[4] if len(sys.argv) > 4 else proj['views']
m = VG.vmap(frame, v); im = Image.open('%s/%s_rgb.png' % (vd, VG.FILES[v])).convert('RGB')
mk = np.asarray(Image.open('%s/%s_mask.png' % (proj['views'], VG.FILES[v])).convert('L')) > 127; ys, xs = np.nonzero(mk)
x0, y0, x1, y1 = max(xs.min() - 14, 0), max(ys.min() - 14, 0), min(xs.max() + 14, im.width), min(ys.max() + 14, im.height)
c = im.crop((x0, y0, x1, y1)); c = c.resize((int(c.width * k), int(c.height * k)), Image.LANCZOS); d = ImageDraw.Draw(c)
ar, au = m['ir'], m['iu']; lo = frame['lo']; dims = frame['dims_m']; names = 'xyz'
def to_px(val, axis):
    X = np.zeros((1, 3)); X[0, axis] = val; uv = VG.to_view(m, X)[0]; return ((uv[0] - x0) * k, (uv[1] - y0) * k)
for axis in (ar, au):
    a = np.floor(lo[axis] / 0.25) * 0.25
    for val in np.arange(a, lo[axis] + dims[axis] + 0.26, 0.25):
        px, py = to_px(val, axis); big = abs(val * 2 - round(val * 2)) < 1e-6; col = (255, 60, 60) if big else (255, 170, 170)
        if axis == ar:
            d.line([(px, 0), (px, c.height)], fill=col, width=1)
            if big: d.text((px + 2, 2), '%s%.1f' % (names[axis], val), fill=(255, 255, 0))
        else:
            d.line([(0, py), (c.width, py)], fill=col, width=1)
            if big: d.text((2, py + 1), '%s%.1f' % (names[axis], val), fill=(255, 255, 0))
c.save(sys.argv[2]); print(sys.argv[2], c.size)
