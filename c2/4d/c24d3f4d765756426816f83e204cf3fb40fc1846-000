    "--axis",
    "z",
    "--at=-2.0,-1.75,-1.6,-1.5,-1.38,-1.3,-1.23,-1.13,-1.05,-0.95,-0.85,-0.77,-0.5,-0.2,0.1,0.4,0.7,1.0",
