    "{A}versions/Assembly_pipe.json"
   ],
   "allow_fail": true,
   "doc": "assembly graph (Procedura) : parts closed, typed mates measured, a part admitted only if all pass ; exit 1 until every part is admitted"
  },
  {
   "name": "judge",
   "cmd": [
