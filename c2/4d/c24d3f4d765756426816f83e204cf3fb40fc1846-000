   ],
   "doc": "curve rig of the left side : fender, door, quarter, quarter band v2 (28 October 2026)"
  },
  {
   "name": "cage",
   "cmd": [
    "{PY}",
    "-I",
    "{A}Scripts/curverig/CageFit.py",
    "{A}work/car/curverig/RIG_car_hard.json",
    "{A}work/car/curverig/cage_side.npz"
   ],
   "doc": "one fair subdivision cage through the curves, creases kept (mode fair, beta 0.05)"
  },
  {
   "name": "fair_selftest",
   "cmd": [
    "{PY}",
    "-I",
    "{A}Scripts/curverig/CurveFair.py",
