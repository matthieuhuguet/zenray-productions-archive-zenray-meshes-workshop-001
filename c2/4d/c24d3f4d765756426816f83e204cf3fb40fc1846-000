    "{A}work/car/curverig/RIG_car_hard.json",
    "--json",
    "{A}versions/CurveFair_sections_pipe.json"
   ],
   "allow_fail": true,
   "doc": "no zigzag, stair or Z in any section, corners only on design creases ; exit 1 until all pass"
  },
  {
   "name": "folds",
   "cmd": [
    "{PY}",
    "-I",
    "{A}Scripts/curverig/FoldLocate.py",
    "{A}work/car/curverig/cage_side.npz",
    "{A}work/car/curverig/RIG_car_hard.json",
    "--k",
    "4",
    "--top",
    "30"
   ],
   "allow_fail": true,
   "doc": "non design folds of the cage, clustered with their nearest rig nodes"
  },
  {
   "name": "schematic",
   "cmd": [
    "{PY}",
    "-I",
    "{A}Scripts/curverig/Schematic.py"
   ],
   "doc": "the schematic sheet that makes the truth : six reference views, every NURBS curve of the rig, readings and their smooth fits ; points.json with the node matrices (28 October 2026)"
  },
  {
   "name": "sheet",
   "cmd": [
    "{PY}",
    "-I",
    "{A}Scripts/finish/ComponentSheet.py",
    "{A}work/car/delivery_pipe.npz",
    "{A}versions/ComponentSheet_pipe.png"
   ],
   "doc": "component sheet, every component alone with its measured state"
  },
  {
   "name": "audit",
   "cmd": [
    "{PY}",
    "-I",
    "{A}Scripts/finish/FinishAudit.py",
