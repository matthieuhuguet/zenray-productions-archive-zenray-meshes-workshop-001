"""30 October 2026 : ZenRay Meshes, CAR FINISH : rebuild the stair-stepped small parts (closer plates, headlights, fender vents) as clean slabs : per connected component, the convex hull of its vertices in the plane of its two largest axes, extruded along the thin axis, meshed in quads (fan from the centre, then split to the target edge). Straight diagonal edges instead of voxel steps ; a closed shell ; the group keeps its name.
    python -I CarCleanSmallParts.py in.obj out.obj [--parts "closer|headlight|vent_fender"] [--edge-mm 20] [--min-turn-deg 8]
FR : reconstruit les petites pieces en escalier (closer, phares, aerations) en dalles propres : enveloppe convexe dans le plan des deux grands axes, extrudee, maillee en quads."""
import argparse, collections, re
import numpy as np
from scipy.spatial import ConvexHull


def components(F):
    par = {}
    def find(x):
        while par.setdefault(x, x) != x: par[x] = par[par[x]]; x = par[x]
        return x
    for f in F:
        for v in f[1:]: par[find(f[0])] = find(v)
    comp = collections.defaultdict(list)
    for f in F: comp[find(f[0])].append(f)
    return list(comp.values())


def simplify(poly, min_turn):
    pts = list(poly); changed = True
    while changed and len(pts) > 3:
        changed = False
        for i in range(len(pts)):
            a, b, c = pts[i - 1], pts[i], pts[(i + 1) % len(pts)]; u = b - a; w = c - b
            ang = np.degrees(np.arccos(np.clip(u @ w / max(np.linalg.norm(u) * np.linalg.norm(w), 1e-12), -1, 1)))
            if ang < min_turn: pts.pop(i); changed = True; break
    return np.array(pts)


class Builder:
    def __init__(self, base, obb=False): self.obb = obb; self.verts = []; self.key = {}; self.base = base; self.faces = []
    def vid(self, p):
        k = tuple(np.round(p * 1e6).astype(np.int64))
        if k not in self.key: self.key[k] = self.base + len(self.verts); self.verts.append(p)
        return self.key[k]
    def grid_quad(self, a, b, c, d, n):
        for i in range(n):
            for j in range(n):
                f = lambda s, t: (1 - s) * ((1 - t) * a + t * d) + s * ((1 - t) * b + t * c)
                p = [f(i / n, j / n), f((i + 1) / n, j / n), f((i + 1) / n, (j + 1) / n), f(i / n, (j + 1) / n)]; self.faces.append([self.vid(q) for q in p])


def slab(P, edge, min_turn, B):
    c = P.mean(0); u, s, vt = np.linalg.svd(P - c, full_matrices=False); e1, e2, e3 = vt; X = (P - c) @ vt.T
    if B.obb: u0, u1, v0, v1 = X[:, 0].min(), X[:, 0].max(), X[:, 1].min(), X[:, 1].max(); poly = np.array([[u0, v0], [u1, v0], [u1, v1], [u0, v1]])                  # a slat is a rectangle (oriented box) : the stair steps are noise around its straight edges
    else: h = ConvexHull(X[:, :2]); poly = simplify(X[h.vertices, :2], min_turn)
    w0, w1 = X[:, 2].min(), X[:, 2].max()
    if w1 - w0 < 1e-4: w0, w1 = w0 - 0.0005, w1 + 0.0005
    c2 = poly.mean(0); n = len(poly); mid = [(poly[i] + poly[(i + 1) % n]) / 2 for i in range(n)]
    to3 = lambda q, w: c + q[0] * e1 + q[1] * e2 + w * e3; nsub = max(1, int(np.ceil(max(np.linalg.norm(poly[(i + 1) % n] - poly[i]) for i in range(n)) / 2 / edge)))
    for w in (w1, w0):
        for i in range(n): B.grid_quad(to3(c2, w), to3(mid[i - 1], w), to3(poly[i], w), to3(mid[i], w), nsub)
    nt = max(1, int(np.ceil((w1 - w0) / edge)))
    for i in range(n):
        a, b = poly[i], poly[(i + 1) % n]; ne = 2 * nsub                                           # the top fan quads cut every polygon edge in 2 x nsub pieces : the wall must use the same count, or the shell opens
        for k in range(ne):
            p, q = a + (b - a) * k / ne, a + (b - a) * (k + 1) / ne; B.grid_quad(to3(p, w0), to3(q, w0), to3(q, w1), to3(p, w1), 1)
    return c


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("inp"); ap.add_argument("out"); ap.add_argument("--parts", default="headlight|vent_fender"); ap.add_argument("--hull", action="store_true", help="convex hull outline instead of the oriented box"); ap.add_argument("--edge-mm", type=float, default=20.0); ap.add_argument("--min-turn-deg", type=float, default=8.0); a = ap.parse_args()
    lines = open(a.inp).read().split("\n"); V = []; last_v = -1; cur = None; groups = collections.OrderedDict()
    for i, l in enumerate(lines):
        if l.startswith("v "): V.append([float(x) for x in l.split()[1:4]]); last_v = i
        elif l.startswith("g "): cur = l[2:].strip(); groups.setdefault(cur, [])
        elif l.startswith("f ") and cur is not None: groups[cur].append([int(x.split("/")[0]) - 1 for x in l.split()[1:]])
    V = np.array(V); rx = re.compile(a.parts); B = Builder(len(V), obb=not a.hull); newfaces = {}; edge = a.edge_mm / 1000.0
    for g, F in groups.items():
        if not rx.search(g) or not F: continue
        B.faces = []
        for comp in components(F):
            P = V[sorted({v for f in comp for v in f})]; k0 = len(B.faces); ctr = slab(P, edge, a.min_turn_deg, B)
            for fi in range(k0, len(B.faces)):                                                     # outward orientation : a slab is convex, so the normal must point away from its centre
                f = B.faces[fi]; q = [B.verts[k - B.base] for k in f]; n = np.cross(q[2] - q[0], q[3] - q[1])
                if n @ (np.mean(q, 0) - ctr) < 0: B.faces[fi] = f[::-1]
        # orient every face outward from its own component centre : slabs are convex, so the sign of the normal against the vector from the centre decides
        newfaces[g] = (B.faces, None)
    out = []; cur = None; skip = False
    for i, l in enumerate(lines):
        if l.startswith("g "):
            cur = l[2:].strip(); skip = cur in newfaces; out.append(l)
            if skip:
                faces = newfaces[cur][0]; NV = B.verts
                for f in faces:
                    out.append("f " + " ".join(str(k + 1) for k in f))
            continue
        if l.startswith("f ") and skip: continue
        out.append(l)
        if i == last_v: out += ["v %.6f %.6f %.6f" % tuple(p) for p in B.verts]
    open(a.out, "w").write("\n".join(out))
    print("rebuilt groups %d ; new vertices %d" % (len(newfaces), len(B.verts)))


if __name__ == "__main__": main()
