                   "quad_jac": np.round(np.asarray(getattr(net, "quad_stats", {}).get("jmin", []), float), 3).tolist(),   # 29 October 2026 : the judge per quad (reference normals), drawn by the editor
                   "face_of_quad": net.face_of_quad, "faces": fr, "issues": net.issues, "stats": stats, "obj_path": obj_path, "latest_obj": latest,
                   "arc_counts": net.counts_by_arc, "arc_parents": net.arc_parents()})


# ------------------------------------------------------------------------------------------------------------------ components of different scale in one document
def _split_units(doc, params):
    """a document whose components do not share one scale (a hand next to a torso : component_options[name].unit, default the request's unit or the document's mesh_unit) is cut in one
    sub document per scale, each with its own arcs, nodes and seeds. Returns [(unit, doc)] or None when there is only one scale."""
    p = params or {}; co = p.get("component_options") or doc.get("component_options") or {}; default = float(p.get("unit") or doc.get("mesh_unit") or 1.0)
    unit_of = lambda name: float((co.get(name) or {}).get("unit", default)) if name else default
    groups = {}
    for a in doc["arcs"]: groups.setdefault(unit_of((a.get("pair") or ["", ""])[0]), []).append(a)
    if len(groups) < 2: return None
    out = []
    for u, arcs in sorted(groups.items(), reverse=True):
        nids = {x for a in arcs for x in (a["a"], a["b"])}; sub = dict(doc); sub["arcs"] = arcs; sub["nodes"] = [n for n in doc["nodes"] if n["id"] in nids]
        sub["component_seeds"] = [q for q in doc.get("component_seeds", []) if unit_of(q["name"]) == u]; out.append((u, sub))
    return out


def _sum(a, b):
    if isinstance(a, dict) and isinstance(b, dict): return {k: _sum(a.get(k), b.get(k)) if k in a and k in b else (a.get(k) if k in a else b.get(k)) for k in set(a) | set(b)}
    if isinstance(a, bool) or isinstance(b, bool): return a
    if isinstance(a, (int, float)) and isinstance(b, (int, float)): return a + b
    if isinstance(a, list) and isinstance(b, list): return a + b
    return a if a is not None else b


def _merge_results(kind, parts):
    """merge the answers of the sub documents : vertex and face indices are offset, counters add up, ids of arcs and nodes are the document's own and never change."""
    out = None; vo = fo = 0
    for r in parts:
        r = json.loads(json.dumps(r))
        if out is None: out = r; vo = len(r.get("P", [])) // 3; fo = len(r["faces"]); continue
        if kind == "build":
            out["Q"] += [q + vo for q in r.get("Q", [])]; out["P"] += r.get("P", []); out["quad_jac"] += r.get("quad_jac", []); out["face_of_quad"] += [f + fo for f in r.get("face_of_quad", [])]
        for f in r["faces"]: f["id"] += fo
        out["faces"] += r["faces"]; out["issues"] += r.get("issues", [])
        for k in ("arc_counts", "arc_parents"): out[k] = dict(out.get(k) or {}, **(r.get(k) or {}))
        for k in ("stats", "euler", "face_counts"):
            if k in r and k in out: out[k] = _sum(out[k], r[k])
        for k in ("dangling_arcs", "unplaced_seeds"):
            if k in r: out[k] = (out.get(k) or []) + r[k]
        if "time_s" in r and "time_s" in out: out["time_s"] += r["time_s"]
        fo += len(r["faces"]); vo += len(r.get("P", [])) // 3
    out["obj_path"] = out["latest_obj"] = None
    return out


def build(doc, params=None):
    parts = _split_units(doc, params)
    if not parts: return _build_one(doc, params)
    return _merge_results("build", [_build_one(sub, dict(params or {}, unit=u, write_obj=False)) for u, sub in parts])


def faces_report(doc, params=None):
    parts = _split_units(doc, params)
    if not parts: return _faces_report_one(doc, params)
    return _merge_results("faces", [_faces_report_one(sub, dict(params or {}, unit=u)) for u, sub in parts])


