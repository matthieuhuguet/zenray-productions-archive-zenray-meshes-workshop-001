    return "%d-%s-%d_%s" % (now.day, MONTHS[now.month - 1], now.year, now.strftime("%H%M%S"))


def native(x):
    """JSON friendly copy (numpy scalars and arrays -> python)."""
    if isinstance(x, dict): return {(k if isinstance(k, str) else str(k)): native(v) for k, v in x.items()}
    if isinstance(x, (list, tuple, set)): return [native(v) for v in x]
    if isinstance(x, np.ndarray): return native(x.tolist())
    if isinstance(x, (np.integer,)): return int(x)
    if isinstance(x, (np.floating, float)): x = float(x); return x if math.isfinite(x) else None      # NaN and infinity are not JSON
    if isinstance(x, (np.bool_,)): return bool(x)
    return x


# ----------------------------------------------------------------------------------------------------------- reference surface
def tri_closest(p, a, b, c):
    """Closest point of triangles (a, b, c) to points p, all (M, 3) (Ericson, Real-Time Collision Detection 5.1.5, vectorised)."""
    ab, ac, ap = b - a, c - a, p - a
    d1, d2 = (ab * ap).sum(1), (ac * ap).sum(1)
    bp = p - b; d3, d4 = (ab * bp).sum(1), (ac * bp).sum(1)
    cp = p - c; d5, d6 = (ab * cp).sum(1), (ac * cp).sum(1)
    vc, vb, va = d1 * d4 - d3 * d2, d5 * d2 - d1 * d6, d3 * d6 - d5 * d4
    den = va + vb + vc; den = np.where(np.abs(den) < 1e-30, 1.0, den)
    res = a + ab * (vb / den)[:, None] + ac * (vc / den)[:, None]                        # inside the triangle
    with np.errstate(divide="ignore", invalid="ignore"):
        m = (va <= 0) & ((d4 - d3) >= 0) & ((d5 - d6) >= 0); t = (d4 - d3) / ((d4 - d3) + (d5 - d6)); res[m] = (b + (c - b) * t[:, None])[m]   # edge bc
        m = (vb <= 0) & (d2 >= 0) & (d6 <= 0); t = d2 / (d2 - d6); res[m] = (a + ac * t[:, None])[m]                                          # edge ac
        m = (d6 >= 0) & (d5 <= d6); res[m] = c[m]                                                                                             # vertex c
        m = (vc <= 0) & (d1 >= 0) & (d3 <= 0); t = d1 / (d1 - d3); res[m] = (a + ab * t[:, None])[m]                                          # edge ab
    m = (d3 >= 0) & (d4 <= d3); res[m] = b[m]                                                                                                 # vertex b
    m = (d1 <= 0) & (d2 <= 0); res[m] = a[m]                                                                                                  # vertex a
    return res


class Ref:
    """Reference surface : triangles, KD tree on their centroids, outward normals (away from the bounding box centre)."""
    def __init__(self, tri):
        tri = np.asarray(tri, float)
        self.A, self.B, self.C = tri[:, 0], tri[:, 1], tri[:, 2]
        n = np.cross(self.B - self.A, self.C - self.A); L = np.linalg.norm(n, axis=1)
        self.N = n / np.maximum(L, 1e-30)[:, None]
        self.cent = tri.mean(1); self.kd = cKDTree(self.cent)
        pts = tri.reshape(-1, 3); self.center = (pts.min(0) + pts.max(0)) / 2
        self.sign = self._closed_orientation(tri)                      # 29 October 2026 : +1 or -1 when the surface is closed and consistently wound (outward = the winding, any shape : a mannequin with arms), 0 otherwise (open shells : away from the box centre)

    @staticmethod
    def _closed_orientation(tri):
        """+1 if the triangles form a closed, consistently oriented surface with outward winding, -1 if inward, 0 if they do not (open panels, double shells : the car)."""
        P = tri.reshape(-1, 3); key = np.round(P / 1e-5).astype(np.int64); key -= key.min(0)
        if key.max() < (1 << 20): _, inv = np.unique((key[:, 0] << 40) | (key[:, 1] << 20) | key[:, 2], return_inverse=True)          # one integer per vertex : unique on a column is ten times faster than on rows
        else: _, inv = np.unique(key, axis=0, return_inverse=True)
        inv = inv.reshape(-1, 3).astype(np.int64)
        n = int(inv.max()) + 1; a = np.concatenate([inv[:, 0], inv[:, 1], inv[:, 2]]); b = np.concatenate([inv[:, 1], inv[:, 2], inv[:, 0]]); code = a * n + b; rev = b * n + a
        if len(np.unique(code)) != len(code) or not np.isin(rev, code).all(): return 0           # a repeated half edge, or an edge without its twin : not a closed oriented surface
        vol = float(np.einsum("ij,ij->i", tri[:, 0], np.cross(tri[:, 1], tri[:, 2])).sum() / 6.0); box = float(np.prod(P.max(0) - P.min(0)))
        return 0 if abs(vol) < 0.01 * box else (1 if vol > 0 else -1)

    def closest(self, pts, k=None, guide=None):
        """Closest surface point of pts. guide (M, 3) : expected outward direction per point ; triangles facing away from it
        (dot below 0.1) are penalised so that a point of a panel never jumps to the inner layer of a double shell."""
        k = min(k or PARAMS["project_k"], len(self.A)); pts = np.asarray(pts, float).reshape(-1, 3); M = len(pts)
        _, idx = self.kd.query(pts, k=k, workers=-1); idx = idx.reshape(M, k)
        P = np.repeat(pts, k, 0); i = idx.ravel()
        q = tri_closest(P, self.A[i], self.B[i], self.C[i])
        d = np.linalg.norm(q - P, axis=1)
        if guide is not None:
            dots = (self.outward(i, q) * np.repeat(np.asarray(guide, float).reshape(-1, 3), k, 0)).sum(1)
            d = d + (dots < 0.1) * 10.0
        d = d.reshape(M, k); j = d.argmin(1); sel = np.arange(M) * k + j
        return q[sel], i[sel], d[np.arange(M), j]

    def outward(self, tri_idx, q):
        n = self.N[tri_idx]
        if self.sign: return n * self.sign                              # a closed oriented surface : outward is the winding, wherever the point is
        s = ((q - self.center) * n).sum(1)
        return np.where((s < -1e-9)[:, None], -n, n)

    def normals_at(self, pts, guide=None):
        q, i, _ = self.closest(pts, guide=guide); return self.outward(i, q)

    def node_normal(self, p, band=None):
        band = PARAMS["node_normal_band_m"] if band is None else band
        k = min(8, len(self.A)); p = np.asarray(p, float)
        _, idx = self.kd.query(p, k=k); idx = np.atleast_1d(idx)
        q = tri_closest(np.repeat(p[None], len(idx), 0), self.A[idx], self.B[idx], self.C[idx])
        d = np.linalg.norm(q - p, axis=1); near = d <= d.min() + band
        n = self.outward(idx[near], q[near]); n0 = self.outward(idx[[int(np.argmin(d))]], q[[int(np.argmin(d))]])[0]
        facing = n @ n0 > -0.5                                                   # 29 October 2026 : a slit (the armpit between the arm and the flank) has two sheets whose normals face each other : the sum cancels or flips, only the sheet of the nearest triangle counts
        if facing.any(): n = n[facing]
        v = n.sum(0); L = np.linalg.norm(v)
        return n[0] if L < 1e-9 else v / L


_REF = {}


def read_obj(path):
    V, F = [], []
    for line in open(path):
        w = line.split()
        if not w: continue
        if w[0] == "v": V.append([float(x) for x in w[1:4]])
        elif w[0] == "f":
            ix = [int(t.split("/")[0]) for t in w[1:]]; ix = [i - 1 if i > 0 else len(V) + i for i in ix]
            for j in range(1, len(ix) - 1): F.append([ix[0], ix[j], ix[j + 1]])
    V = np.array(V, float); return V[np.array(F)]


def read_obj_cached(path):
    """the triangles of an OBJ, cached as .npy next to the work files (key : path, size, modification time) : a 2 million triangle model parses in 11 s the first time and loads in a fraction of a second after."""
    import hashlib
    st = os.stat(path); key = hashlib.sha1(("%s|%d|%d" % (os.path.abspath(path), st.st_size, int(st.st_mtime))).encode()).hexdigest()[:16]; d = os.path.join(PARAMS["out_dir"], "..", "cache"); f = os.path.join(d, key + ".npy")
    if os.path.exists(f):
        try: return np.load(f)
        except Exception: pass
    tri = read_obj(path)
    if len(tri) > 50000:                                                      # small models parse faster than they load
        try: os.makedirs(d, exist_ok=True); np.save(f + ".tmp.npy", tri); os.replace(f + ".tmp.npy", f)
        except OSError: pass
    return tri


def load_ref(ref=None):
    if isinstance(ref, Ref): return ref
    key = ref or PARAMS["ref"]
    if key not in _REF:
        if key == "v752":
            import ZrrData as D
            car = D.load(); T, _ = D.triangulate(car); tri = car["P"][T]
        elif isinstance(key, str) and key.lower().endswith(".obj") and os.path.isabs(key): tri = read_obj_cached(key)
        else: raise ValueError("reference must be 'v752' or an absolute .obj path, got %r" % (key,))
        _REF[key] = Ref(tri)
    return _REF[key]


# ----------------------------------------------------------------------------------------------------------------- polylines
def resample_step(pts, step):
    pts = SP.clean_polyline(pts); cum = np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(pts, axis=0), axis=1))]); L = cum[-1]
    if L < 1e-12: return np.vstack([pts[0], pts[0]])
    m = max(1, int(round(L / step))); s = np.linspace(0.0, L, m + 1)
    return np.stack([np.interp(s, cum, pts[:, k]) for k in range(3)], 1)


def resample_count(pts, cum, count):
    s = np.linspace(0.0, cum[-1], count + 1)
    return np.stack([np.interp(s, cum, pts[:, k]) for k in range(3)], 1)


def eval_arc(ctrl, step):
    ctrl = np.asarray(ctrl, float); n = len(ctrl)
    if n < 4: return resample_step(ctrl, step)
    spans = n - 3; Lc = np.linalg.norm(np.diff(ctrl, axis=0), axis=1).sum()
    u = np.linspace(0.0, spans, max(8, int(Lc / (step * 0.75)) + spans * 4))
    return resample_step(SP.evaluate(ctrl, u), step)


def cumlen(pts): return np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(pts, axis=0), axis=1))])


# ---------------------------------------------------------------------------------------------------------------------- doctor
def _doctor(doc, prm):
    """Returns (fixed document, issues, {arc id: polyline}). The input document is never modified."""
    D = copy.deepcopy(doc); tol = prm["weld_tol_m"]; issues = []
    def issue(kind, **kw): issues.append(dict({"kind": kind}, **kw))
    nodes = {n["id"]: np.array(n["p"], float) for n in D["nodes"]}
    nid_list = list(nodes); NP = np.array([nodes[i] for i in nid_list]) if nodes else np.zeros((0, 3)); kdn = cKDTree(NP) if len(NP) else None
    def nearest_node(p):
        if kdn is None: return None, np.inf
        d, j = kdn.query(p); return nid_list[j], float(d)
    arcs = []
    for a in D["arcs"]:
        if not isinstance(a.get("ctrl"), list) or len(a["ctrl"]) < 2: issue("bad_arc", arc=a.get("id"), value=None, fix="removed"); continue
        ctrl = np.array(a["ctrl"], float); aid = a["id"]
        a.setdefault("a", -1); a.setdefault("b", -1); a.setdefault("mirror", -1)
        for end in ("a", "b"):
            if a[end] != -1 and a[end] not in nodes: issue("missing_node", arc=aid, value=a[end], fix="end detached"); a[end] = -1
        gap = float(np.linalg.norm(ctrl[0] - ctrl[-1])); island = False
        if a.get("closed"):
            if gap <= tol: ctrl[-1] = ctrl[0] if (a["a"] < 0 and a["b"] < 0) else ctrl[-1]; island = a["a"] < 0 and a["b"] < 0
            else: issue("false_closed", arc=aid, value=round(gap, 6), fix="closed flag cleared"); a["closed"] = False
        if island: a["ctrl"] = ctrl.tolist(); arcs.append(a); continue
        for end, k in (("a", 0), ("b", -1)):
            nid = a[end]; e = ctrl[k]
            if nid == -1:                                           # free end : attach it when a node lies within the tolerance
                j, dj = nearest_node(e)
                if j is not None and dj <= tol: a[end] = j; ctrl[k] = nodes[j]; issue("attached", arc=aid, value=round(dj, 6), fix="free end attached to node %s" % j)
                else: issue("free_end", arc=aid, value=None, fix="kept free (dangling arcs are pruned from the faces)")
                continue
            d = float(np.linalg.norm(e - nodes[nid]))
            if d <= tol:
                ctrl[k] = nodes[nid]
                if d > prm["snap_report_m"]: issue("snapped", arc=aid, value=round(d, 6), fix="end snapped onto node %s" % nid)
            else:
                j, dj = nearest_node(e)
                if j is not None and dj <= tol: a[end] = j; ctrl[k] = nodes[j]; issue("loose_end", arc=aid, value=round(d, 6), fix="reattached to node %s (%.1f mm away)" % (j, dj * 1000))
                else: a[end] = -1; issue("loose_end", arc=aid, value=round(d, 6), fix="detached from node %s, free end" % nid)
        a["ctrl"] = ctrl.tolist(); arcs.append(a)
    polys = {}; keep = []
    for a in arcs:                                                  # polylines of the repaired arcs, zero length arcs out
        P = eval_arc(a["ctrl"], prm["step_m"]); L = float(cumlen(P)[-1])
        if L < prm["min_arc_len_m"]: issue("zero_length", arc=a["id"], value=round(L, 6), fix="removed"); continue
        polys[a["id"]] = P; keep.append(a)
    if len(keep) > 1:                                               # duplicates : same place, same length
        mids = np.array([P[len(P) // 2] for P in (polys[a["id"]] for a in keep)]); pairs = sorted(cKDTree(mids).query_pairs(prm["dup_mid_tol_m"]))
        gone = set()
        def samp(P, m=24): return resample_count(P, cumlen(P), m)
        for i, j in pairs:
            ai, aj = keep[i], keep[j]
            if i in gone or j in gone: continue
            Pi, Pj = polys[ai["id"]], polys[aj["id"]]; Li, Lj = cumlen(Pi)[-1], cumlen(Pj)[-1]
            if abs(Li - Lj) > 0.05 * max(Li, Lj) + 0.01: continue
            Si, Sj = samp(Pi), samp(Pj)
            m = min(np.linalg.norm(Si - Sj, axis=1).mean(), np.linalg.norm(Si - Sj[::-1], axis=1).mean())
            if m < prm["dup_mean_dist_m"]: gone.add(j); issue("duplicate_arc", arc=aj["id"], value=round(float(m), 6), fix="removed, arc %s kept" % ai["id"])
        keep = [a for k, a in enumerate(keep) if k not in gone]
    ids = {a["id"] for a in keep}
    for a in keep:
        if a.get("mirror", -1) not in ids: a["mirror"] = -1
    D["arcs"] = keep; polys = {a["id"]: polys[a["id"]] for a in keep}
    deg = collections.Counter()
    for a in keep:
        for end in ("a", "b"):
            if a[end] >= 0: deg[a[end]] += 1
    for nid in nodes:
