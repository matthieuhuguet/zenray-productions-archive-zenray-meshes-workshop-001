            D = np.concatenate([Q[:, [0, 1]], Q[:, [1, 2]], Q[:, [2, 3]], Q[:, [3, 0]]]); key = np.sort(D, axis=1); u, cnt = np.unique(key, axis=0, return_counts=True)
            dd = np.unique(D, axis=0, return_counts=True)[1]
            stats.update({"edges": int(len(u)), "boundary_edges": int((cnt == 1).sum()), "non_manifold_edges": int((cnt > 2).sum()), "flipped_edges": int((dd > 1).sum()),
                          "duplicate_vertices": int(len(P) - len(np.unique(np.round(P, 6), axis=0))), "euler_mesh": int(len(np.unique(Q)) - len(u) + nq),
                          "min_jac": float(self.quad_stats["jmin"].min()), "folded_quads": int((self.quad_stats["jmin"] <= 0).sum()),
                          "max_edge_ratio": float(self.quad_stats["ratio"].max())})
            stats["manifold"] = bool(stats["non_manifold_edges"] == 0 and stats["flipped_edges"] == 0)
            stats["welded"] = bool(stats["non_manifold_edges"] == 0 and stats["duplicate_vertices"] == 0)
            stats["closed"] = bool(stats["boundary_edges"] == 0)
