                J[:, j] = (np.cross(e1, e2) * n_ref).sum(1) / (l1 * l2); ang[:, j] = np.degrees(np.arccos(np.clip((e1 * e2).sum(1) / (l1 * l2), -1, 1)))
            jmin = J.min(1); self.quad_stats = {"jmin": jmin, "ratio": ratio, "ang": ang}
        foq = np.array(self.face_of_quad, dtype=np.int64)
        for f in self.faces:
            if f["status"] != "meshed": continue
            qs = np.flatnonzero(foq == f["id"]); jm = jmin[qs]; thr = np.full(len(qs), prm["jac_min"]); pos = {q: i for i, q in enumerate(qs)}
            for cq in f["corner_quads"]:                              # corner quads of sharp (or very obtuse) corners : 0.9 sin(angle)
                if cq in pos:
                    a = ang[cq, 0:4].min() if False else None
                    j_c = int(np.argmin(np.abs(J[cq] - np.sin(np.radians(ang[cq]))) + (J[cq] < 0) * 9))
                    th = ang[cq][int(np.argmin(np.abs(ang[cq] - 90.0)) if False else j_c)]
                    if th < prm["sharp_deg"] or th > 180.0 - prm["sharp_deg"]: thr[pos[cq]] = min(prm["jac_min"], prm["sharp_factor"] * math.sin(math.radians(th)))
            f["quads"] = int(len(qs)); f["min_jac"] = float(jm.min()); f["edge_ratio"] = float(ratio[qs].max()); f["folded"] = int((jm <= 0).sum())
            f["jac_margin"] = float((jm - thr).min()); f["judge_ok"] = bool(f["folded"] == 0 and f["jac_margin"] >= 0)
            f["bad_quads"] = int((jm < thr).sum()); f["bad_fraction"] = round(float((jm < thr).mean()), 4)
            if prm["drop_failed"] and not f["judge_ok"]: f["status"], f["reason"] = "rejected", "failed the judge (min Jacobian %.2f, %d folded)" % (f["min_jac"], f["folded"]); drop.append(f["id"])
