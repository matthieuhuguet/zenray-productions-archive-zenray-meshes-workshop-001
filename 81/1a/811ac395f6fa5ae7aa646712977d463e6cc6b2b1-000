    # ---- report
    def arc_parents(self):
        """{sub arc id: document arc id} for the arcs created by splits (T junctions, virtual corners) : ids of sides that are not in the document."""
        return {aid: A["parent"] for aid, A in self.arcs.items() if A["parent"] != aid}

    def face_report(self):
        out = []
        for f in self.faces:
            cn = [self.tail(h) for h in f["he"] if self.tail(h) in f["corner_nodes"]]
            r = {"id": f["id"], "component": f.get("component"), "status": f["status"], "reason": f["reason"], "area": round(f["area"], 6), "perimeter": round(f["perimeter"], 6),
                 "centroid": f["centroid"], "arcs": [list(h) for h in f["he"]], "corners": cn, "corner_points": [self.nodes[v] for v in cn],
                 "corner_virtual": [v not in self.real_nodes for v in cn]}
            if f.get("extra_seeds"): r["extra_seeds"] = f["extra_seeds"]
            if f.get("reflex"): r["reflex_corners"] = f["reflex"]
            if "sides" in f: r["sides"] = [[h[0] for h in s] for s in f["sides"]]; r["n_sides"] = len(f["sides"])
            for k in ("side_counts", "quads", "min_jac", "edge_ratio", "folded", "jac_margin", "judge_ok", "bad_quads", "bad_fraction"):
                if k in f: r[k] = f[k]
            out.append(r)
        return out


# ------------------------------------------------------------------------------------------------------------------ public API
def faces(doc, ref=None, params=None):
    """Faces of the curve network on the surface : ordered (arc id, direction) loops, area, perimeter, centroid, corners, Euler."""
    net = Net(doc, ref, params); net.trace(); net.corners()
    return native({"faces": net.face_report(), "euler": net.euler, "dangling_arcs": net.dangling, "issues": net.issues})


def faces_report(doc, params=None):
    """POST /faces : doctor + faces + corners + counts, no fill. Per face : id, component, status, corners, sides, side_counts, boundary polyline."""
    net = Net(doc, None, params); net.trace(); net.corners(); net.counts(); step = net.prm["boundary_step_m"]; out = net.face_report()
    for r, f in zip(out, net.faces):
        P = np.concatenate([net.hpts(h)[:-1] for h in f["he"]] + [net.hpts(f["he"][0])[:1]]); keep = max(1, int(round(step / net.prm["step_m"])))
        idx = sorted(set(range(0, len(P), keep)) | {len(P) - 1}); r["boundary"] = np.round(P[idx], 5).ravel().tolist(); r.pop("poly", None)
        r["side_counts"] = f.get("side_counts")
    st = collections.Counter(f["status"] for f in net.faces)
    return native({"ok": True, "faces": out, "euler": net.euler, "dangling_arcs": net.dangling, "issues": net.issues, "unplaced_seeds": net.unplaced_seeds,
                   "arc_counts": net.counts_by_arc, "arc_parents": net.arc_parents(), "face_counts": {"faces": len(net.faces), "ok": st.get("ok", 0), "skipped": st.get("skipped", 0), "infeasible": st.get("infeasible", 0)},
                   "timing": net.timing, "time_s": round(time.time() - net.t0, 3)})


def write_obj(net, path, name="ZenRayLines"):
    os.makedirs(os.path.dirname(path), exist_ok=True); foq = np.array(net.face_of_quad, dtype=np.int64); comp = {f["id"]: f.get("component") for f in net.faces}
    with open(path, "w") as fh:
        fh.write("# ZenRay Lines mesh, 29 October 2026\no %s\n" % name)
        for p in net.V: fh.write("v %.6f %.6f %.6f\n" % (p[0], p[1], p[2]))
        for fid in sorted(set(foq.tolist())):
            fh.write("g %s\n" % ("_".join(str(comp[fid]).split()) if comp.get(fid) else "face_%d" % fid))
            for q in net.Q[foq == fid]: fh.write("f %d %d %d %d\n" % tuple(int(i) + 1 for i in q))
    return path


def _run(doc, params):
    net = Net(doc, (params or {}).get("ref"), params)
    net.trace(); net.corners(); net.counts(); net.fill(); net.conform(); net.judge(); return net


def build(doc, params=None):
    t0 = time.time(); net = _run(doc, params); fallback = []
    if net.prm["auto_fallback"]:                                    # N sided faces (N = 3, 5, 6) that fail the judge : try a 4 sided patch
        bad = [f["id"] for f in net.faces if f["status"] == "meshed" and not f.get("judge_ok", True) and len(f["sides"]) in (5, 6)
               and "rotate" not in (net.prm.get("face_options") or {}).get(f["id"], (net.prm.get("face_options") or {}).get(str(f["id"]), {}))]
        if bad:
            p2 = dict(params or {}); fo = {str(k): dict(v) for k, v in (p2.get("face_options") or {}).items()}
            for i in bad: fo.setdefault(str(i), {})["rotate"] = 0
            p2["face_options"] = fo; net2 = _run(doc, p2)
            fold = lambda n, i: n.faces[i].get("folded", 10 ** 9) if n.faces[i]["status"] == "meshed" else 10 ** 9
            better = [i for i in bad if fold(net2, i) < fold(net, i)]                # keep the 4 sided retry only where it unfolds the face
            if better and len(better) == len(bad): net = net2; fallback = bad
            elif better:
                p3 = dict(params or {}); fo3 = {str(k): dict(v) for k, v in (p3.get("face_options") or {}).items()}
                for i in better: fo3.setdefault(str(i), {})["rotate"] = 0
                p3["face_options"] = fo3; net = _run(doc, p3); fallback = better
    fr = net.face_report(); st = collections.Counter(f["status"] for f in net.faces)
    stats = dict(net.stats)
    meshed = [f for f in net.faces if f["status"] == "meshed" or (f.get("quads") and f["status"] == "rejected")]
    stats.update({"faces_judge_ok": sum(1 for f in net.faces if f.get("judge_ok")), "faces_without_fold": sum(1 for f in meshed if f.get("folded") == 0),
                  "quads_below_jac_min": int((net.quad_stats["jmin"] < net.prm["jac_min"]).sum()) if getattr(net, "quad_stats", None) else 0})
    stats.update({"faces_total": len(net.faces), "faces_meshed": st.get("meshed", 0), "faces_skipped": st.get("skipped", 0), "faces_infeasible": st.get("infeasible", 0),
                  "skipped_reasons": dict(collections.Counter(f["reason"] for f in net.faces if f["status"] == "skipped")),
                  "euler_network": net.euler, "dangling_arcs": net.dangling, "t_junctions": len(net.tj), "fallback_faces": fallback, "mirror_dropped": net.mirror_dropped,
                  "issues_by_kind": dict(collections.Counter(i["kind"] for i in net.issues)), "timing": net.timing})
    if hasattr(net, "count_stats"): stats["count_deviation"] = net.count_stats
    obj_path = latest = None
    if net.prm["write_obj"] and len(net.Q):
        obj_path = write_obj(net, os.path.join(net.prm["out_dir"], "mesh_%s.obj" % stamp()))
        latest = write_obj(net, os.path.join(net.prm["out_dir"], "latest.obj"))
    stats["time_s"] = round(time.time() - t0, 3); stats["unplaced_seeds"] = net.unplaced_seeds
    return native({"ok": True, "P": np.round(net.V, 6).ravel().tolist() if len(net.V) else [], "Q": net.Q.ravel().tolist() if len(net.Q) else [],
                   "face_of_quad": net.face_of_quad, "faces": fr, "issues": net.issues, "stats": stats, "obj_path": obj_path, "latest_obj": latest,
                   "arc_counts": net.counts_by_arc, "arc_parents": net.arc_parents()})


if __name__ == "__main__":
    args = sys.argv[1:]; ref = args[args.index("--ref") + 1] if "--ref" in args else None
    doc = json.load(open(args[0])); res = build(doc, {"ref": ref} if ref else {})
    print(json.dumps(res["stats"], indent=1)); print("obj", res["obj_path"])
