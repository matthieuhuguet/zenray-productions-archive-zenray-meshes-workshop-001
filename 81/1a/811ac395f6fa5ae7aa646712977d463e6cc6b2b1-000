FEATURE_KEYS = ["step_m", "tangent_dist_m", "node_normal_band_m", "soft_window_m", "boundary_step_m"]   # ... and the lengths that measure the SHAPE (tangents, bends, normals), scaled by `feature_unit` (default : unit)


def make_params(params=None):
    """PARAMS overridden by the request, then every absolute tolerance multiplied by `unit` and every shape length by `feature_unit` (1 : a car or a torso ; 0.1 : the fingers of a hand, features ten
    times smaller : a 1 cm duplicate tolerance would otherwise merge neighbouring seams). A body that joins limbs and fingers in one network takes a small unit for the tolerances and a feature_unit of 1.
    edge_m is the wanted edge and is never scaled."""
    prm = dict(PARAMS); prm.update(params or {}); u = float(prm.get("unit", 1.0)); fu = float(prm.get("feature_unit") or u)
    for k in LENGTH_KEYS: prm[k] = prm[k] * u
    for k in FEATURE_KEYS: prm[k] = prm[k] * fu
    prm["max_face_area_m2"] = prm["max_face_area_m2"] * fu * fu      # a shape size, not a tolerance
    return prm


