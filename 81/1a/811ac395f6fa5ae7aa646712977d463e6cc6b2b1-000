            keep = ~np.isin(foq, drop); self.Q = self.Q[keep]; self.face_of_quad = [x for x, k in zip(self.face_of_quad, keep) if k]
            used = np.unique(self.Q); remap = -np.ones(len(P), dtype=np.int64); remap[used] = np.arange(len(used)); self.V = P[used]; self.fixed_v = self.fixed_v[used]; self.Q = remap[self.Q]
            prm = dict(prm); prm["drop_failed"] = False; self.prm = prm; self.judge(); return
