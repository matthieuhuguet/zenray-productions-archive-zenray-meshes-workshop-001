# 10 November 2026: the truck HDAs are object shells with a "rebuild" button that runs external Python scripts
# (tmp-modeling-for-film-tv-hard-surface-vehicles-gnomon/reproduction/Scripts/Truck): press it, then count.
import hou, json, time
res = json.load(open('/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026/data/hda_check.json'))
for r in res:
    if r.get('category') != 'Object': continue
    f = '/Users/zenray/.claude/skills/zenray-meshes/otls/' + r['file']; hou.hda.installFile(f); d = hou.hda.definitionsInFile(f)[0]; n = hou.node('/obj').createNode(d.nodeTypeName()); t0 = time.time()
    try:
        n.parm('rebuild').pressButton(); err = ''
    except Exception as e:
        err = str(e)[-160:]
    pts = prs = qd = 0
    for c in n.allSubChildren():
        if c.type().category().name() == 'Sop' and c.isDisplayFlagSet() and c.parent().type().category().name() == 'Object':
            try: g = c.geometry(); pts += len(g.points()); prs += len(g.prims()); qd += sum(1 for p in g.prims() if len(p.vertices()) == 4)
            except Exception as e: err = err or str(e)[-160:]
    r.update({'needs_rebuild_button': True, 'external_scripts': True, 'points': pts, 'prims': prs, 'quads': qd, 'errors': [err] if err else [], 'cook_s': round(time.time() - t0, 2)})
    print(r['file'], 'prims', prs, 'quads', qd, err[:90], flush=True)
json.dump(res, open('/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026/data/hda_check.json', 'w'), indent=1)
