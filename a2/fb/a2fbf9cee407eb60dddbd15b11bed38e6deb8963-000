"""2 November 2026 : a graduated 3D ruler drawn on a tutorial frame, from its fitted camera : a grid in the plane x = 0 (profile) or z = const (width), so positions are read on the image instead of guessed. FR : une règle graduée 3D tracée sur une image du tuto, depuis sa caméra ajustée : on lit les positions sur l'image au lieu de les deviner.
    python -I WorldGrid.py <v3 folder> <cams.json> <view> <plane: x|z> <value> <out.png> [zoom]"""
import sys, os, json
import numpy as np
from PIL import Image, ImageDraw, ImageFont
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE); sys.path.insert(0, os.path.dirname(HERE)); from DragonFit import cam_matrix, DEF
folder, camf, view, plane, val, out = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], float(sys.argv[5]), sys.argv[6]; zoom = float(sys.argv[7]) if len(sys.argv) > 7 else 2.0
VI = json.load(open(f"{folder}/views.json"))[view]; x0, y0, x1, y1 = VI["rect"]; x1 -= DEF["toolbar_px"]; a = Image.open(f"{folder}/refs/{view}.png").convert("RGB").crop((x0, y0, x1, y1)); w, h = a.size; cam = json.load(open(camf))[view]; R, t, fp = cam_matrix(cam, w, h, 45.0); a = a.resize((int(w * zoom), int(h * zoom)), Image.LANCZOS); d = ImageDraw.Draw(a)
def proj(p):
    q = R @ np.asarray(p, float) + t; return (w / 2 + fp * q[0] / q[2]) * zoom, (h / 2 - fp * q[1] / q[2]) * zoom
us = np.arange(-2.4, 2.41, 0.1); vs = np.arange(0.0, 2.01, 0.1)
for u in us:
    pts = [proj((val, v, u) if plane == "x" else (u, v, val)) for v in (vs[0], vs[-1])]; major = abs(u * 2 - round(u * 2)) < 1e-6; d.line(pts, fill=(255, 220, 0) if major else (120, 120, 0), width=1)
    lab = proj((val, 0.0, u) if plane == "x" else (u, 0.0, val))
    if major: d.text((lab[0] - 8, lab[1] + 2), f"{u:.1f}", fill=(255, 255, 0))
for v in vs:
    pts = [proj((val, v, u) if plane == "x" else (u, v, val)) for u in (us[0], us[-1])]; major = abs(v * 2 - round(v * 2)) < 1e-6; d.line(pts, fill=(0, 220, 255) if major else (0, 110, 120), width=1)
    if major: lab = proj((val, v, us[0]) if plane == "x" else (us[0], v, val)); d.text((max(lab[0], 2), lab[1] - 6), f"{v:.1f}", fill=(0, 255, 255))
a.save(out); print(a.size)
