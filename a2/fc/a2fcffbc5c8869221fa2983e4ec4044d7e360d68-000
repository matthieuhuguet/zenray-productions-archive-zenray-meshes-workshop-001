<!-- 29 October 2026 : ZenRay Retopology, vector editor for the car curve network. Data from Scripts/lines/ZrlExport.py, served by Scripts/lines/ZrlServe.py. -->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>ZenRay Retopology</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div id="app">

  <aside id="left" aria-label="Views and tools">
    <header class="brand">
      <h1>ZenRay Retopology</h1>
      <p class="tagline">Edit the car curve network as vectors in orthographic views. <a href="3d.html">3D editor</a></p>
    </header>

    <section class="block">
      <h2>View</h2>
      <div id="viewButtons" class="stack" role="radiogroup" aria-label="View"></div>
    </section>

    <section class="block">
      <h2>Mode</h2>
      <button id="bAdd" class="btn wide" type="button">Add arc</button>
      <p id="modeHint" class="hint">Select, drag handles and nodes.</p>
    </section>

    <section class="block">
      <h2>Camera</h2>
      <div class="kv"><span>Zoom</span><b id="zoomVal">100%</b></div>
      <button id="bFit" class="btn wide" type="button">Fit view</button>
    </section>

    <section class="block">
      <h2>Surface under cursor (m)</h2>
      <div id="coords" class="coords">-</div>
      <div id="hoverInfo" class="hint hover"></div>
    </section>

    <section class="block help">
      <h2>Keys</h2>
      <ul>
        <li><kbd>Wheel</kbd> zoom at the cursor</li>
        <li><kbd>Space</kbd> + drag, or middle drag: pan</li>
        <li><kbd>Del</kbd> delete the selected arc</li>
        <li><kbd>Cmd Z</kbd> or <kbd>Ctrl Z</kbd> undo, with <kbd>Shift</kbd> redo</li>
        <li><kbd>1</kbd> to <kbd>5</kbd> views, <kbd>F</kbd> fit</li>
        <li><kbd>Esc</kbd> deselect, or cancel Add arc</li>
      </ul>
    </section>
  </aside>

  <main id="center">
    <div id="stage">
      <svg id="svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1600" preserveAspectRatio="none" role="img" aria-label="Orthographic view with the curve network">
        <g id="gComp" fill="none" stroke-linecap="round" stroke-linejoin="round"></g>
        <g id="gHid" fill="none" stroke-linecap="round" stroke-linejoin="round"></g>
        <g id="gVis" fill="none" stroke-linecap="round" stroke-linejoin="round"></g>
        <g id="gGaps" fill="none"></g>
        <g id="gHover"></g>
        <g id="gSel"></g>
        <g id="gNodes"></g>
        <g id="gTop"></g>
      </svg>
    </div>
    <div id="statusBar" role="status"><span id="status">Loading...</span></div>
  </main>

  <aside id="right" aria-label="Network">
    <section class="block">
      <h2>Components</h2>
      <div id="compList" class="chips"></div>
    </section>

    <section class="block grow">
      <h2>Arcs <span id="arcCount" class="count"></span></h2>
      <input id="filter" type="search" placeholder="Filter by id or component" autocomplete="off" spellcheck="false">
      <div id="arcList" class="list"></div>
    </section>

    <section class="block">
      <h2>Selected</h2>
      <div id="selInfo" class="info"></div>
      <div class="buttons">
        <button id="bSmooth" class="btn" type="button">Smooth arc</button>
        <button id="bWeld" class="btn" type="button">Weld ends</button>
        <button id="bDelete" class="btn" type="button">Delete</button>
      </div>
    </section>

    <section class="block">
      <h2>Parameters</h2>
      <div class="checks">
        <label class="check"><input id="pMirror" type="checkbox"> Mirror (x to -x)</label>
        <label class="check"><input id="pSnap" type="checkbox"> Snap to surface</label>
        <label class="check"><input id="pHidden" type="checkbox"> Show hidden arcs</label>
        <label class="check"><input id="pNodes" type="checkbox"> Show nodes</label>
        <label class="check"><input id="pGaps" type="checkbox"> Show node gaps</label>
        <label class="check"><input id="pSvgBg" type="checkbox"> SVG background</label>
      </div>
      <label class="slider"><span>Background image</span><select id="pBgSource"><option value="model">Model render</option><option value="sheet">Reference sheet (six views)</option></select></label>
      <label class="slider"><span>Background</span><input id="pBgOpacity" type="range" min="0" max="1" step="0.05"></label>
      <label class="slider"><span>Line width</span><input id="pLineWidth" type="range" min="0.5" max="4" step="0.1"></label>
      <label class="slider"><span>Smooth amount</span><input id="pSmooth" type="range" min="0.05" max="1" step="0.05"></label>
    </section>

    <section class="block">
      <h2>History and files</h2>
      <div class="buttons">
        <button id="bUndo" class="btn" type="button">Undo</button>
        <button id="bRedo" class="btn" type="button">Redo</button>
      </div>
      <div class="buttons">
        <button id="bExportJson" class="btn" type="button">Export JSON</button>
        <button id="bExportSvg" class="btn" type="button">Export SVG</button>
        <button id="bExportPng" class="btn" type="button">Export PNG</button>
      </div>
      <div class="buttons">
        <button id="bSave" class="btn primary" type="button">Save to atelier</button>
        <button id="bLoadSaved" class="btn" type="button">Load saved</button>
      </div>
    </section>
  </aside>

</div>
<script src="app.js"></script>
<script src="version-guard.js"></script>
</body>
</html>
