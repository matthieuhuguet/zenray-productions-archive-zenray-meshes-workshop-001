"""28 October 2026 : replace one named part of a delivery by the same part from a candidate npz (finishing stage). python SwapPart.py <delivery.npz> <cand.npz> <part> <out.npz>"""
import sys
import numpy as np
dl, cd, name, out = sys.argv[1:5]
d = np.load(dl, allow_pickle=True); c = np.load(cd, allow_pickle=True)
n = np.array([str(x) for x in d["names"]]); keep = n != name
Q = [list(map(int, q)) for q in d["Q"][keep]]; N = list(n[keep])
used = sorted({v for q in Q for v in q}); r = {v: i for i, v in enumerate(used)}
P = list(d["P"][used]); Q = [[r[v] for v in q] for q in Q]
cn = np.array([str(x) for x in c["names"]]); base = len(P); P += list(c["P"])
for q, m in zip(c["Q"], cn):
    if m == name:
        Q.append([base + int(v) for v in q]); N.append(name)
np.savez(out, P=np.array(P, np.float32), Q=np.array(Q, dtype=object), names=np.array(N))
print(len(Q))
