"""26 October 2026 : the 1:1 thumbnail inside a 9:16 frame (YouTube Shorts) : the whole square, scaled and centred, black bars above and below, never cropped.
Every value comes from Params/thumbnail.json, block "shorts". FR : la miniature carrée entière au centre d'un cadre 9:16, bandes noires, aucun recadrage.
Usage: /Users/zenray/.venvs/zenray-uv/bin/python -I Scripts/Letterbox9x16.py [--params Params/thumbnail.json]
"""
import argparse
import json
from pathlib import Path

from PIL import Image

HERE = Path(__file__).resolve().parents[1]
RESAMPLE = getattr(Image, "Resampling", Image).LANCZOS


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--params", default=str(HERE / "Params" / "thumbnail.json"))
    a = ap.parse_args()
    cfg = json.load(open(a.params))
    if "shorts" not in cfg:
        raise SystemExit('Params/thumbnail.json has no "shorts" block')
    sh = cfg["shorts"]
    src = Image.open(HERE / sh["source"]).convert("RGB")
    bar = tuple(sh["bar_rgb"])
    for w in sh["widths"]:
        h = w * 16 // 9
        sq = src.resize((w, w), RESAMPLE)
        canvas = Image.new("RGB", (w, h), bar)
        canvas.paste(sq, (0, (h - w) // 2))
        stem = HERE / "Out" / f"thumbnail-9x16-{w}x{h}"
        canvas.save(str(stem) + ".png")
        canvas.save(str(stem) + ".jpg", quality=int(sh["jpg_quality"]), subsampling=0)
        top = canvas.crop((0, 0, w, (h - w) // 2)).getextrema()
        print(f"{stem.name}: {w} x {h}, ratio {w / h:.4f}, bars {(h - w) // 2} px above and below, extrema of the top bar {top}")


if __name__ == "__main__":
    main()
