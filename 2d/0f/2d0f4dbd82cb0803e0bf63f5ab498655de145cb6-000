# 25 October 2026 : ZenRay Meshes M16 : BLUEPRINT LOFT, the hard surface body built like a modeller does (no voxel).
# EN: from the sheet, per station z along the length: roof y_top(z) and underside y_bot(z) (side view, wheels removed
# so the arches appear), half width w(z) (top view), and the cross section SHAPE: the front view's half width as a
# function of normalised height, f(t), t = 0 at the underside, 1 at the roof. Ring point j at height t_j sits at
# x = w(z) * f_z(t_j) / max f. The result is a structured grid, stations x ring points: perfect quad topology by
# construction, edge loops along and across the body, mirror symmetric, ready for UV. Writes an OBJ.
# FR : carrosserie construite comme un modeleur : profils lus sur les vues, grille de sections, topologie parfaite.
# Usage: python BlueprintLoft.py <work_dir> <out.obj> [stations=96] [ring=40]
import sys, os, json
import numpy as np
from PIL import Image
from scipy import ndimage as ndi

P = {"stations": 160, "ring": 40, "smooth_profile": 2.0, "smooth_underside": 0.6, "wheel_pad": 1.03, "min_h": 0.04}


def axis_map(meta, v):
    lo = np.array(meta["lo"]); D = np.array(meta["dims_m"]); hi = lo + D
    rx, uy = np.array(v["rx"]), np.array(v["uy"])
    a, b = int(np.argmax(np.abs(rx))), int(np.argmax(np.abs(uy)))
    umin = lo[a] if rx[a] > 0 else -hi[a]; vmax = hi[b] if uy[b] > 0 else -lo[b]
    s = v["px_per_m"]; x0, y0 = v["bbox"][0], v["bbox"][1]
    to_px = lambda u, vv: (x0 + (u - umin) * s, y0 + (vmax - vv) * s)
    return a, b, rx[a], uy[b], to_px


def main(wd, out, stations=160, ring=40):
    p = dict(P); p["stations"], p["ring"] = int(stations), int(ring)
    meta = json.load(open(os.path.join(wd, "frame/frame.json"))); comp = json.load(open(os.path.join(wd, "car_components.json")))["wheels"]
    V = {v["name"]: v for v in meta["views"]}
    lo = np.array(meta["lo"]); D = np.array(meta["dims_m"])
    zs = np.linspace(lo[2] + 1e-3, lo[2] + D[2] - 1e-3, p["stations"])
    # side view (right): roof and underside per z, wheels removed so that the arches are open
    side = np.asarray(Image.open(os.path.join(wd, "frame/mask_right.png"))) > 127
    side_full = side.copy()
    a, b, sa, sb, to_px = axis_map(meta, V["right"])
    yy, xx = np.mgrid[0:side.shape[0], 0:side.shape[1]]
    for zc in (comp["front_z"], comp["rear_z"]):
        cx, cy = to_px(zc * sa, comp["tyre_r"] * sb)
        r = comp["tyre_r"] * V["right"]["px_per_m"] * p["wheel_pad"]
        side &= ~((xx - cx) ** 2 + (yy - cy) ** 2 < r * r)
    ytop, ybot = np.zeros_like(zs), np.zeros_like(zs)
    ys_world = np.linspace(lo[1], lo[1] + D[1], 400)
    wheel_top = comp["tyre_r"] * (1 + p["wheel_pad"])
    near_wheel = lambda z: min(abs(z - comp["front_z"]), abs(z - comp["rear_z"])) < comp["tyre_r"] * p["wheel_pad"]
    for i, z in enumerate(zs):
        colf, colw = [], []
        for y in ys_world:
            px, py = to_px(z * sa, y * sb)
            ix, iy = int(round(px)), int(round(py))
            inb = 0 <= iy < side.shape[0] and 0 <= ix < side.shape[1]
            colf.append(inb and side_full[iy, ix]); colw.append(inb and side[iy, ix])
        colf, colw = np.array(colf), np.array(colw)
        if colf.any():
            ytop[i] = ys_world[np.where(colf)[0].max()]
            if colw.any():
                # lowest body pixel that is part of the run connected to the roof (shadow strips and ground lines drop out)
                k = np.where(colw)[0]; run = [k.max()]
                for kk in k[::-1][1:]:
                    if run[-1] - kk <= 2:
                        run.append(kk)
                    else:
                        break
                ybot[i] = ys_world[min(run)]
            else:
                ybot[i] = min(wheel_top, ytop[i] - p["min_h"])
            if near_wheel(z):
                dz = min(abs(z - comp["front_z"]), abs(z - comp["rear_z"]))
                arch = comp["tyre_r"] + np.sqrt(max((comp["tyre_r"] * p["wheel_pad"]) ** 2 - dz ** 2, 0))
                ybot[i] = max(ybot[i], min(arch, ytop[i] - p["min_h"]))
        else:
            ytop[i] = ybot[i] = np.nan
    ok = np.isfinite(ytop)
    ytop = np.interp(zs, zs[ok], ytop[ok]); ybot = np.interp(zs, zs[ok], ybot[ok])
    ytop = ndi.gaussian_filter1d(ytop, p["smooth_profile"]); ybot = ndi.gaussian_filter1d(ybot, p["smooth_underside"])
    ybot = np.minimum(ybot, ytop - p["min_h"])
    # top view: half width per z
    top = np.asarray(Image.open(os.path.join(wd, "frame/mask_top.png"))) > 127
    a, b, sa, sb, to_px = axis_map(meta, V["top"])
    xs_world = np.linspace(lo[0], lo[0] + D[0], 400)
    hw = np.zeros_like(zs)
    for i, z in enumerate(zs):
        hit = []
        for x in xs_world:
            # top view: right axis = -z, up axis = +x
            px, py = to_px(z * sa, x * sb)
            ix, iy = int(round(px)), int(round(py))
            hit.append(0 <= iy < top.shape[0] and 0 <= ix < top.shape[1] and top[iy, ix])
        hit = np.array(hit)
        hw[i] = (np.ptp(xs_world[np.where(hit)[0]]) / 2) if hit.any() else 0.0
    hw = ndi.gaussian_filter1d(hw, p["smooth_profile"])
    # front view: half width F(y) at ABSOLUTE height y (the cabin narrows upward); x(y, z) = min(hw(z), F(y))
    fr = np.asarray(Image.open(os.path.join(wd, "frame/mask_front.png"))) > 127
    a, b, sa, sb, to_px = axis_map(meta, V["front"])
    ygrid = np.linspace(lo[1], lo[1] + D[1], 300)
    F = []
    for y in ygrid:
        _, py = to_px(0.0, y * sb)
        row = fr[int(np.clip(round(py), 0, fr.shape[0] - 1)), :]
        cx0, _ = to_px(0.0, 0.0); cx0 = int(round(cx0))
        if 0 <= cx0 < len(row) and row[cx0]:
            l = cx0
            while l > 0 and row[l - 1]:
                l -= 1
            r = cx0
            while r < len(row) - 1 and row[r + 1]:
                r += 1
            F.append(max(cx0 - l, r - cx0) / V["front"]["px_per_m"])
        else:
            F.append(0.0)
    F = ndi.gaussian_filter1d(np.array(F), 1.0)
    nh = p["ring"] // 2 + 1
    ts = 0.5 - 0.5 * np.cos(np.linspace(0, np.pi, nh))          # denser rows near the underside and the roof
    verts = []
    for i, z in enumerate(zs):
        ring = []
        for t in ts:
            y = ybot[i] + t * (ytop[i] - ybot[i])
            x = max(min(hw[i], float(np.interp(y, ygrid, F))), 0.02)
            ring.append((x, y, z))
        full = [(-x, y, z) for (x, y, z) in ring[::-1]] + ring[1:-1]
        verts.append(full)
    verts = np.array(verts)                                              # [stations, ringpts, 3]
    S, Rn = verts.shape[0], verts.shape[1]
    with open(out, "w") as fo:
        fo.write("# ZenRay Meshes blueprint loft, 25 October 2026\n")
        for v in verts.reshape(-1, 3):
            fo.write("v %.5f %.5f %.5f\n" % tuple(v))
        idx = lambda i, j: i * Rn + (j % Rn) + 1
        for i in range(S - 1):
            for j in range(Rn):
                fo.write("f %d %d %d %d\n" % (idx(i, j), idx(i, j + 1), idx(i + 1, j + 1), idx(i + 1, j)))
        # end caps as quad fans would add triangles: close with one n-gon each, later grid-filled in Houdini
        fo.write("f " + " ".join(str(idx(0, j)) for j in range(Rn)[::-1]) + "\n")
        fo.write("f " + " ".join(str(idx(S - 1, j)) for j in range(Rn)) + "\n")
    print(json.dumps({"stations": S, "ring": Rn, "faces": (S - 1) * Rn + 2, "len_m": float(D[2]), "max_half_width": float(hw.max()), "roof_max": float(ytop.max())}))


if __name__ == "__main__":
    a = sys.argv
    main(a[1], a[2], **dict(x.split("=") for x in a[3:]))
