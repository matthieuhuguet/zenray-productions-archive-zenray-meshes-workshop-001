# 27 October 2026 18:58: Build an editable quad shell for a front fascia panel in Houdini.
import hou
import math

node = hou.pwd()
geo = node.geometry()
geo.clear()
width = node.evalParm('half_width')
y_low = node.evalParm('y_low')
y_high = node.evalParm('y_high')
z_center = node.evalParm('z_center')
z_corner_inset = node.evalParm('z_corner_inset')
thickness = node.evalParm('thickness')
columns = node.evalParm('columns')
rows = node.evalParm('rows')
assert columns >= 2 and rows >= 2 and width > 0 and y_high > y_low and thickness > 0
name = geo.addAttrib(hou.attribType.Prim, 'name', '')
points = []
for layer in range(2):
    for j in range(rows + 1):
        y = y_low + (y_high-y_low)*j/rows
        for i in range(columns + 1):
            u = -1 + 2*i/columns
            p = geo.createPoint()
            p.setPosition((u*width, y, z_center-z_corner_inset*u*u-layer*thickness))
            points.append(p)
stride = columns + 1
layer_size = stride*(rows + 1)
def quad(indices):
    prim = geo.createPolygon()
    for idx in indices: prim.addVertex(points[idx])
    prim.setAttribValue(name, 'CAR_body_fascia_panel_C')
for layer in range(2):
    off = layer*layer_size
    for j in range(rows):
        for i in range(columns):
            a = off+j*stride+i; b=a+1; c=a+stride+1; d=a+stride
            quad((a,b,c,d) if layer == 0 else (d,c,b,a))
ring = list(range(stride)) + [j*stride+columns for j in range(1, rows+1)] + [rows*stride+i for i in range(columns-1,-1,-1)] + [j*stride for j in range(rows-1,0,-1)]
for a,b in zip(ring,ring[1:]+ring[:1]): quad((b,a,a+layer_size,b+layer_size))
