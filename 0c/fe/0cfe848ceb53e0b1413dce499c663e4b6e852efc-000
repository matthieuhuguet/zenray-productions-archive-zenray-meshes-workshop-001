# 25 October 2026 : ZenRay Meshes car, BODY BY ROW LOFT (method change). The creased Catmull-Clark of the cage rounded
# every band BETWEEN two character lines and carried the noise of each measured station along the car (lumpy, wavy sides),
# while the sheet is made of clean bands split by crisp lines. Here every named row of the cage is a smooth curve along
# the car (monotone cubic through the stations, no overshoot), sampled densely in z, and the surface between two rows is
# straight across : crisp character lines across, smooth bands along, like the sheet. Panel names follow the cage faces.
# FR : chaque rangée nommée devient une courbe lisse le long de la voiture, la surface est droite entre deux rangées.
# Usage: python RowLoft.py <loft_params.json> <cage_prefix> <out.npz>
import sys, os, json
import numpy as np
from scipy.interpolate import PchipInterpolator


def main(params, prefix, out):
    C = json.load(open(params)); cj = json.load(open(prefix + "_cage.json"))
    st = np.array(cj["stations"]); R = cj["ring"]; S = len(st); panels = cj["panels"]
    V = np.array([list(map(float, l.split()[1:])) for l in open(prefix + "_cage.obj") if l.startswith("v ")]).reshape(S, R, 3)
    # dense samples per station interval : n_per_m along the length, at least 1 per interval
    zs, seg = [], []
    for i in range(S - 1):
        n = max(1, int(abs(st[i] - st[i + 1]) * C["n_per_m"]))
        for k in range(n): zs.append(i + k / n); seg.append(i)
    zs.append(S - 1); seg.append(S - 2)
    t = np.array(zs)                                     # station parameter (fractional index), monotone
    G = np.zeros((len(t), R, 3))
    for j in range(R):
        for a in range(3):
            G[:, j, a] = PchipInterpolator(np.arange(S), V[:, j, a])(t)
    if C.get("fair", 1):
        # 25 October 2026: FAIR ROWS. Each row (x and y along z) is a penalised cubic B-spline (P-spline : knots every knot_m,
        # second difference penalty lam), ends held by a large weight ; the arch rows ignore the stations inside the wheel
        # arches (the arches are cut afterwards), so the side runs clean from bumper to bumper.
        from scipy.interpolate import BSpline
        m = json.load(open(prefix + "_measure.json")) if os.path.exists(prefix + "_measure.json") else None
        Wh = m["wheels"] if m else None; E = cj["exp_rows"]; nh = len(E)
        row_of = lambda j: E[nh - 1 - j] if j < nh else E[j - (nh - 1)]
        zt = np.interp(t, np.arange(S), V[:, 0, 2] * 0 + st)   # sample z along the car
        zlo, zhi = st.min(), st.max(); kn = np.arange(zlo, zhi + 1e-9, C["knot_m"])
        if kn[-1] < zhi: kn = np.append(kn, zhi)
        T = np.concatenate([[zlo] * 3, kn, [zhi] * 3])
        # 25 October 2026: CLEAN CURVES ; each character line is a cubic B-spline with one knot every knot_m (few control
        # points, smooth by construction, like a designer's curve) and deliberate C0 corners (knot repeated 3 times) only at
        # the design breaks listed per row in "breaks" (windshield base, rear glass base) ; FR : courbes propres, peu de points.
        def knots_for(bz):
            pts = [zlo] + sorted(b for b in bz if zlo + 0.05 < b < zhi - 0.05) + [zhi]; inner = []
            for a_, b_ in zip(pts[:-1], pts[1:]):
                n_ = max(1, int(round((b_ - a_) / C["knot_m"]))); inner += list(np.linspace(a_, b_, n_ + 1)[1:-1])
                if b_ < zhi: inner += [b_] * 3
            return np.concatenate([[zlo] * 4, sorted(inner), [zhi] * 4])
        def fit(z, v, w, zq):
            T_ = T; B = BSpline.design_matrix(np.clip(z, zlo, zhi), T_, 3).toarray(); nb = B.shape[1]
            D = np.diff(np.eye(nb), 2, axis=0); A = B.T @ (w[:, None] * B) + C["lam"] * D.T @ D
            c = np.linalg.solve(A, B.T @ (w * v)); return BSpline.design_matrix(np.clip(zq, zlo, zhi), T, 3).toarray() @ c
        ra = Wh["tyre_r"] * C["arch_pad"] if Wh else 0
        for j in range(R):
            r = row_of(j); z = V[:, j, 2]; keep0 = np.ones(S, bool)
            if C.get("fit_skip_ends", 1): keep0[0] = keep0[-1] = False   # 25 October 2026: end faces (tips, ground shadow) pulled the floor down
            T = knots_for(C.get("breaks", {}).get(r, []))
            for a in (0, 1):
                keep = keep0.copy()
                # 25 October 2026: only the HEIGHT (y) of the arch rows is perturbed over the wheels (arch top) ; their width
                # (x) there is the real haunch bulge, so x is fitted on every station (skipping it lost the rear haunch)
                if Wh and r in C["arch_rows"] and (a == 1 or not C.get("arch_skip_x_keep", 1)):
                    keep &= np.minimum(np.abs(z - Wh["front_z"]), np.abs(z - Wh["rear_z"])) > ra * C["arch_skip"]
                w = np.where(np.arange(S)[keep] % (S - 1) == 0, C["end_weight"], 1.0)
                G[:, j, a] = fit(z[keep], V[keep, j, a], w, zt)
            G[:, j, 2] = zt
    # 26 October 2026: WHEEL COVER ; a car body covers its tyres in plan (the sheet's top view never shows them), so the rows
    # that frame the arches (wheel_cover.rows) are pushed out over each tyre to tyre face + cover_m by a smooth bump (a
    # max filter then a Gaussian of sigma_m along z : no kink, the curve stays clean). The top view rounds the rear corners
    # over the tyres (0.23 m off the side views at z -2.0) ; the side views and the back view win.
    # FR : la caisse couvre ses pneus vue de dessus, bosse lisse sur les rangées qui encadrent les passages.
    WC = C.get("wheel_cover")
    if WC and WC.get("on", 1):
        # 26 October 2026: the first bump (max filter of the deficit, then Gaussian) added the largest nearby deficit to points
        # that needed less (sill 1.29 m at z -1.8 for a 1.13 target) ; now new = |x| + softplus(face - |x|) * w(z), w a C2
        # plateau window over the tyre (plus extra_m per row, smootherstep ramps of ramp_m) : |x| where w = 0, max(|x|, face)
        # inside, a smooth blend between
        Wp = json.load(open(os.path.join(os.path.dirname(os.path.abspath(params)), C.get("wheels", "wheel_params.json"))))
        E_ = cj["exp_rows"]; nh_ = len(E_); zq = G[:, 0, 2]; k_ = WC.get("soft_m", 0.006); rp = WC.get("ramp_m", 0.12)
        sstep = lambda u: np.where(u <= 0, 0.0, np.where(u >= 1, 1.0, u ** 3 * (u * (6 * u - 15) + 10)))
        for rn, rc in WC["rows"].items():
            if rn not in E_: continue
            for inst in Wp["instances"]:
                if inst["x"] <= 0: continue
                face = inst["x"] + 0.5 * Wp["tyre_w"] + Wp.get("bulge", 0.0) + WC["cover_m"]
                ex = rc.get("extra_rear_m" if inst["z"] < 0 else "extra_front_m", rc.get("extra_m", 0.0))
                lo, hi = inst["z"] - Wp["tyre_r"] - (ex if inst["z"] < 0 else rc.get("extra_m", 0.0)), inst["z"] + Wp["tyre_r"] + (rc.get("extra_m", 0.0) if inst["z"] < 0 else ex)
                w = sstep((zq - (lo - rp)) / rp) * sstep(((hi + rp) - zq) / rp)
                for j in sorted({nh_ - 1 - E_.index(rn), nh_ - 1 + E_.index(rn)}):
                    if not 0 <= j < G.shape[1]: continue
                    ax = np.abs(G[:, j, 0]); u = face - ax
                    sp = k_ * np.logaddexp(0.0, u / k_)
                    G[:, j, 0] = np.sign(G[:, j, 0]) * (ax + sp * w)
    # 25 October 2026: CHARACTER LINE GROOVES ; a named row sinks inward by d (x toward the axis), so the two bands that meet
    # there break their normals enough to draw the line the sheet shows (belt crease, sill crease)
    if C.get("groove_rows"):
        E_ = cj["exp_rows"]; nh_ = len(E_)
        for rn, d in C["groove_rows"].items():
            if rn not in E_: continue
            for j in (nh_ - 1 - E_.index(rn), nh_ - 1 + E_.index(rn)):
                if 0 <= j < R: G[:, j, 0] -= np.sign(G[:, j, 0]) * d
    if C.get("min_y") is not None: G[:, :, 1] = np.maximum(G[:, :, 1], C["min_y"])   # 25 October 2026: no row below the floor plane
    # 25 October 2026: ROW ORDER ; from the sill up, each row stays above the row below (row_gap_m) and, from the glass
    # base up, inside it in x : rows never cross, so no fold in any section (ShapeCheck "folds")
    if C.get("order_rows", 1):
        E_ = cj["exp_rows"]; nh_ = len(E_)
        for side in (1, -1):
            prev = None
            for k in range(E_.index("sill"), nh_):
                j = ((nh_ - 1 + k) if side > 0 else (nh_ - 1 - k)) % R
                if prev is not None:
                    G[:, j, 1] = np.maximum(G[:, j, 1], G[:, prev, 1] + C.get("row_gap_m", 0.003))
                    if E_[k] in C.get("inward_rows", ["glass_base", "roof_edge"]):
                        G[:, j, 0] = np.sign(G[:, j, 0]) * np.minimum(np.abs(G[:, j, 0]), np.abs(G[:, prev, 0]))
                prev = j
    # 25 October 2026: CROWN ; the top band (roof_centre -> roof_edge, roof and hood) was a straight ruled strip, a tent
    # with a ridge in the front view ; crown_n columns are inserted, x linear and y = yc + (ye - yc) * u**crown_p, flat top
    # that drops near its edges, as the sheet. Panels of the inserted strips follow their band.
    cols = []
    cn, cp = C.get("crown_n", 0), C.get("crown_p", 3.0)
    def crown(ja, jb, ua, ub):   # ja centre column, jb edge column
        out = []
        for k in range(1, cn + 1):
            u = k / (cn + 1); u = ua + (ub - ua) * u
            out.append((ja, jb, u))
        return out
    # 26 October 2026: SIDE SUBDIVISION ; a side band (sill to door_low, door_low to belt ...) was ONE quad tall (0.3 to 0.4 m),
    # so the arch cut, which removes quads by their centre, left a tongue hanging in the middle of the rear arch and square
    # corners beside it ; side_subdiv n inserts n - 1 straight columns in every band between two rows of side_rows (the
    # band is ruled, the shape does not change), and the cut then follows the circle. FR : bandes de flanc subdivisées.
    E_s = cj["exp_rows"]; nh_s = len(E_s); ss = int(C.get("side_subdiv", 1)); srow = set(C.get("side_rows", []))
    rname = lambda j: E_s[nh_s - 1 - j] if j < nh_s else E_s[j - (nh_s - 1)]
    for j in range(R):
        cols.append((j, j, 0.0, j, 1.0))
        if cn and j == 0: cols += [(0, 1, u, 0, cp) for (_, _, u) in crown(0, 1, 0, 1)]
        if cn and j == R - 1: cols += [(0, R - 1, u, R - 1, cp) for (_, _, u) in crown(0, R - 1, 0, 1)[::-1]]
        if ss > 1 and j < R - 1 and rname(j) in srow and rname(j + 1) in srow:
            cols += [(j, j + 1, k / ss, j, 1.0) for k in range(1, ss)]
    G2 = np.zeros((len(t), len(cols), 3))
    for k, (a, b, u, _, pw) in enumerate(cols):
        if a == b: G2[:, k] = G[:, a]
        else:
            G2[:, k, 0] = G[:, a, 0] + u * (G[:, b, 0] - G[:, a, 0]); G2[:, k, 2] = G[:, a, 2] + u * (G[:, b, 2] - G[:, a, 2])
            G2[:, k, 1] = G[:, a, 1] + (G[:, b, 1] - G[:, a, 1]) * u ** pw
    band = [c[3] for c in cols]; R2 = len(cols)
    P = G2.reshape(-1, 3); Q, N = [], []
    idx = lambda i, j: i * R2 + (j % R2)
    for i in range(len(t) - 1):
        for j in range(R2):
            Q.append((idx(i, j), idx(i, j + 1), idx(i + 1, j + 1), idx(i + 1, j))); N.append(panels[seg[i] * R + band[j]])
    R_orig, R = R, R2
    # 25 October 2026: WHEEL ARCHES CUT IN THE CONSTRUCTION (no boolean) ; quads whose centre lies inside an arch cylinder
    # (|x| > arch_x0, distance to the axle < tyre_r x arch_pad_cut) are removed, and the vertices on the new boundary are
    # moved radially onto the arc : a clean circular opening. FR : passages découpés à la construction, bord ramené sur l'arc.
    if C.get("arch_cut", 0):
        Wp = json.load(open(os.path.join(os.path.dirname(os.path.abspath(params)), C.get("wheels", "wheel_params.json"))))
        Rc = Wp["tyre_r"] * C.get("arch_pad_cut", 1.14); x0 = C.get("arch_x0", 0.40)
        cen = np.array([(i["y"], i["z"]) for i in Wp["instances"] if i["x"] > 0])
        Qa = np.array(Q); ce = P[Qa].mean(1); inside = np.zeros(len(Qa), bool)
        for yc, zc in cen: inside |= (np.abs(ce[:, 0]) > x0) & (np.hypot(ce[:, 1] - yc, ce[:, 2] - zc) < Rc)
        bnd = np.intersect1d(np.unique(Qa[inside].ravel()), np.unique(Qa[~inside].ravel()))
        for v in bnd:
            if abs(P[v, 0]) <= x0: continue
            dd = np.hypot(P[v, 1] - cen[:, 0], P[v, 2] - cen[:, 1]); k = int(np.argmin(dd))
            if dd[k] < Rc * 1.4 and dd[k] > 1e-6:
                ny_ = cen[k, 0] + (P[v, 1] - cen[k, 0]) * Rc / dd[k]
                if ny_ >= C.get("min_y", 0.10):
                    P[v, 1] = ny_; P[v, 2] = cen[k, 1] + (P[v, 2] - cen[k, 1]) * Rc / dd[k]
                elif abs(P[v, 1] - cen[k, 0]) < Rc:   # 25 October 2026: low points slide along z only, never below the floor
                    P[v, 2] = cen[k, 1] + np.sign(P[v, 2] - cen[k, 1]) * np.sqrt(Rc ** 2 - (P[v, 1] - cen[k, 0]) ** 2)
        Q = [q for q, k_ in zip(Q, inside) if not k_]; N = [n for n, k_ in zip(N, inside) if not k_]
    h = R // 2                                           # end caps between symmetric ring pairs, as the cage
    for i, flip, cap in ((0, True, panels[(S - 1) * R_orig]), (len(t) - 1, False, panels[(S - 1) * R_orig + R_orig // 2 - 1])):
        for j in range(h - 1):
            q = (idx(i, j), idx(i, j + 1), idx(i, R - 2 - j), idx(i, R - 1 - j)); Q.append(q[::-1] if flip else q); N.append(cap)
    np.savez(out, grid_shape=np.array([len(t), R]), grid_cols=np.array([c[3] for c in cols]), P=P.astype(np.float32), Q=np.array(Q, np.int32)[:, ::-1], names=np.array(["CAR_body_" + n for n in N]), panel=np.array(N))
    print(json.dumps({"points": len(P), "quads": len(Q), "samples_z": len(t)}))


if __name__ == "__main__":
    main(*sys.argv[1:])
