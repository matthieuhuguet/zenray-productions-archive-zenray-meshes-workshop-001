const ISO = {pending: 0, last: 0, w: 480, chain: Promise.resolve(), all: store.get('zrb3d-iso-all', '0') === '1'};   // 13 November 2026, 19:42: all the iterations, or the latest and the validated ones
const isoUrl = (p, w) => '/iso?f=' + encodeURIComponent(p) + (w ? '&w=' + w : '');
const isoStatus = x => x.files.some(y => y.verdict === 'valid') ? 'valid' : (!x.files.length || x.files.every(y => y.verdict === 'refused')) ? 'missing' : 'pending';
function isoHtml(c){
  const iso = c.isolation, all = iso.views.flatMap(x => x.files), ok = iso.views.filter(x => isoStatus(x) === 'valid').length;
  const nv = all.filter(y => y.verdict === 'valid').length, nr = all.filter(y => y.verdict === 'refused').length, nt = all.length - nv - nr;
  const off = D.live ? '' : ' disabled title="Seulement dans l\'application locale"';
  const nIt = all.length;
  return `<div class="iso-hd"><h3>Vues générées<em>${esc((iso.kits || [iso.kit]).map(k => k.slice(0, 5)).join(', '))}</em></h3><button class="quiet" data-iso-all="1" aria-pressed="${ISO.all}" title="Montrer toutes les images de chaque vue, dans l'ordre où elles sont arrivées, la plus récente en dernier">Itérations : ${ISO.all ? 'toutes (' + nIt + ')' : 'dernière et validées'}</button><span class="iso-sum">${ok} vue${ok > 1 ? 's' : ''} sur 5 validée${ok > 1 ? 's' : ''} · ${plural(nv, 'image validée', 'images validées')} · ${plural(nr, 'refusée', 'refusées')} · ${nt} à juger</span><span class="iso-save" id="iso-save" aria-live="polite"></span></div>
    <p class="iso-why">À gauche, l'image de départ avec la pièce entourée en rouge ; puis les vues rendues par le modèle d'image. Valide ou refuse chaque image : une vue compte dès qu'une de ses images est validée, une vue dont toutes les images sont refusées est à refaire. Un clic sur l'image l'ouvre en pleine résolution ; un second clic sur le même verdict l'annule.</p>
    <div class="iso-grid"><figure class="iso-col ref"><h4>Départ</h4><button class="iso-pic" data-zoom="${esc(isoUrl(iso.ref))}"><img loading="lazy" alt="Image de départ, pièce entourée en rouge" src="${esc(isoUrl(iso.ref, ISO.w))}"></button></figure>`
    + iso.views.map(x => { const st = isoStatus(x); return `<div class="iso-col ${st}"><h4>${esc(VIEW[x.view] || cap(x.view))}<span class="iso-dot" title="${{valid: 'vue validée', pending: 'à juger', missing: 'à générer'}[st]}"></span></h4>`
      + (x.files.length ? isoShown(x).map(y => `<figure class="iso-fig${y === x.files[x.files.length - 1] ? ' last' : ''}" data-verdict="${y.verdict || ''}"><button class="iso-pic" data-zoom="${esc(isoUrl(y.path))}" title="${esc(y.name)}"><img loading="lazy" alt="${esc(c.name)}, vue ${esc(VIEW[x.view] || x.view)}" src="${esc(isoUrl(y.path, ISO.w))}"></button>
        <figcaption><span class="iso-name">${esc(y.kit.slice(0, 5))} · ${esc(y.by || '')}${y === x.files[x.files.length - 1] ? ' · la plus récente' : ''}</span><span class="seg" role="group" aria-label="Verdict sur ${esc(y.name)}"><button data-iso="valid" data-iso-file="${esc(y.name)}" data-iso-kit="${esc(y.kit)}" aria-pressed="${y.verdict === 'valid'}"${off}>Valider</button><button data-iso="refused" data-iso-file="${esc(y.name)}" data-iso-kit="${esc(y.kit)}" aria-pressed="${y.verdict === 'refused'}"${off}>Refuser</button></span></figcaption></figure>`).join('')
        : '<div class="iso-none">Pas encore générée</div>') + '</div>'; }).join('') + '</div>';
}
const isoShown = x => ISO.all ? x.files : x.files.filter((y, i) => i === x.files.length - 1 || y.verdict === 'valid');   // the latest and the validated ones, or all
const isoSay = (t, cls) => { const el = document.getElementById('iso-save'); if (el){ el.className = 'iso-save ' + (cls || ''); el.innerHTML = t; } };
const isoPaint = (c, t, cls) => { const el = document.getElementById('iso'); if (el){ el.innerHTML = isoHtml(c); isoSay(t || '', cls); } };
document.addEventListener('click', e => { const t = e.target.closest('[data-iso-all]'); if (!t) return; ISO.all = !ISO.all; store.set('zrb3d-iso-all', ISO.all ? '1' : '0'); const c = byId(current); if (c && c.isolation) isoPaint(c); });
document.addEventListener('click', e => {
  const t = e.target.closest('[data-iso]'); if (!t || t.disabled) return;
  const c = byId(current); if (!c || !c.isolation) return;
  const y = c.isolation.views.flatMap(x => x.files).find(f => f.name === t.dataset.isoFile && f.kit === t.dataset.isoKit); if (!y) return;
  const was = y.verdict || null, want = was === t.dataset.iso ? null : t.dataset.iso;   // a second click on the same verdict takes it back
  y.verdict = want; ISO.pending++; ISO.last = Date.now();
  isoPaint(c, '<i class="spin"></i>Enregistrement…', 'busy');
  ISO.chain = ISO.chain.then(async () => {
    try {
      const r = await fetch('/api/isolation-verdict', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({c: c.id, kit: y.kit, file: y.name, verdict: want})});
      const g = await r.json().catch(() => ({}));
      if (!r.ok || !g.ok) throw new Error(g.error || ('HTTP ' + r.status));
      y.date = g.date; ISO.pending--; ISO.last = Date.now();
      isoPaint(c, ISO.pending ? '<i class="spin"></i>Enregistrement…' : 'Enregistré · ' + esc(String(g.date).split(', ')[1] || g.date), ISO.pending ? 'busy' : 'ok');
    } catch (err) {
      if (y.verdict === want) y.verdict = was; ISO.pending--; ISO.last = Date.now();
      isoPaint(c, 'Échec, verdict non enregistré : ' + esc(err.message), 'bad'); toast('Verdict non enregistré : ' + err.message);
    }
  });
});
// 12 November 2026: the local application (HubServe.py) asks its server every two seconds; a new registry or a new page reloads the window,
// the choices (component, group, mode, view) come back from storage. FR : l'application locale se recharge seule quand le registre change.
if (D.live) {
  let seen = null;
  const brand = document.querySelector('.brand');
  const poll = async () => {
    try {
      const v = await (await fetch('/api/version', {cache: 'no-store'})).json();
      if (seen && v.token !== seen){                                       // keep the place: version shown and scroll come back after the reload
        if (ISO.pending || Date.now() - ISO.last < 6000){ setTimeout(poll, 2000); return; }   // 13 November 2026, 18:00: never while a verdict is on its way
        store.set('zrb3d-keep', JSON.stringify({c: current, v: version, y: window.scrollY}));
        return location.reload();
      }
      seen = v.token;
      brand.textContent = `ZenRay Blueprints 3D · ${R.project} · en direct · registre du ${R.date}` + (v.busy ? ' · mise à jour…' : '') + (v.error ? ' · erreur : ' + v.error.slice(0, 80) : '');
    } catch (e) { brand.textContent = `ZenRay Blueprints 3D · ${R.project} · serveur local injoignable · registre du ${R.date}`; }
    setTimeout(poll, 2000);
  };
  poll();
}
// 12 November 2026: the RETURN link of a component (HubReturn.py, /c/<key> on the local server): ?open= takes its identifier, its short code (R12)
// or its simple name, in any case, and opens it on the Planche. FR : le lien de retour ouvre le composant par son identifiant, son code court ou son nom.
const norm = s => String(s || '').toLowerCase().replace(/[\s_\-]+/g, '');
const findKey = k => { if (!k) return null; const n = norm(k);
  return byId(k) || R.components.find(c => norm(c.short_id) === n) || R.components.find(c => norm(c.id) === n) || R.components.find(c => norm(c.name) === n) || null; };
const opened = findKey(Q.get('open'));
if (opened){ current = opened.id; scope = ''; }
else if (Q.get('open')) setTimeout(() => toast('Composant introuvable : ' + Q.get('open')), 300);
if (R.scopes[Q.get('scope')]) scope = Q.get('scope');
if (COVER[Q.get('cover')]) cover = Q.get('cover');
if (Q.get('show')) shown = Q.get('show').split(',').filter(k => SHOWS.includes(k));
if (Q.get('look') === 'wire') look = 'wire';
// a past version: the local server makes its tiles once and keeps them (Hub.version_tiles); the archived page in the cloud has only the latest
async function chooseVersion(v){
  const c = byId(current);
  if (!v || v === c.drawing){ version = null; return renderA(); }
  const key = c.id + '|' + v;
  if (!verTiles[key]){
    try { const r = await fetch('/api/version-tiles?c=' + encodeURIComponent(c.id) + '&v=' + encodeURIComponent(v), {cache: 'no-store'}); verTiles[key] = await r.json(); }
    catch (e) { toast('Version illisible : ' + e.message); return; }
  }
  if (verTiles[key].error){ toast(verTiles[key].error); delete verTiles[key]; return; }
  version = v; renderA();
}
document.addEventListener('change', (e) => { if (e.target.matches('[data-version]')) chooseVersion(e.target.value); });
if (Q.get('version')) setTimeout(() => chooseVersion(Q.get('version')), 0);
try { const keep = JSON.parse(store.get('zrb3d-keep', 'null')); store.set('zrb3d-keep', 'null');
  if (keep && keep.c === current){ (keep.v ? chooseVersion(keep.v) : Promise.resolve()).then(() => setTimeout(() => window.scrollTo(0, keep.y || 0), 60)); }
} catch (e) { /* nothing kept */ }
renderSide(); show(opened ? 'a' : (location.hash.slice(1) || store.get('zrb3d-view', 'a')));
if (Q.has('probe')) document.documentElement.dataset.width = document.documentElement.scrollWidth + ' of ' + innerWidth;   // the verifier reads this: no sideways overflow
</script>
