<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ZenRay Blueprints 3D</title>
<!-- 12 November 2026 (date read from `date`): third round of the design proposals of the hub ZenRay Blueprints 3D, after Matthieu's
     second feedback: never more than two columns, one status label (done, in progress, to do) instead of the three-bar meter,
     the project as a tree (Car2, its groups, its components), the project picture under its name with its five views.
     Built by Scripts/BuildMockups.py from the real registry of Car2.
     FR : troisième tour : deux colonnes maximum, une étiquette d'état, le projet en arbre, l'image du projet aux cinq vues. -->
<style>
@font-face{font-family:'Adobe Clean';src:url(data:font/woff2;base64,) format('woff2');font-weight:100 450;font-display:block}
@font-face{font-family:'Adobe Clean';src:url(data:font/woff2;base64,) format('woff2');font-weight:451 900;font-display:block}
@font-face{font-family:'AnthropicMono';src:url(data:font/ttf;base64,) format('truetype');font-display:block}
/* every value of the design lives here: change a token, the three views follow */
:root{
  --font:'Adobe Clean','Hiragino Sans W4',sans-serif; --mono:'AnthropicMono',ui-monospace,monospace;
  --bg:#f6f6f5; --panel:#ffffff; --well:#ececea; --ink:#161616; --soft:#6c6c69; --faint:#a9a9a5; --line:#e4e4e1; --accent:#1d4fa8; --blue:#103a80;
  --done:#2f7d5c; --doing:#1d4fa8; --todo:#a9a9a5;                        /* the three states of a component, nothing else is coloured */
  --radius:14px; --radius-s:9px; --gap:18px; --tile-gap:10px; --side:300px; --t:.2s; --cell:16 / 10; --columns:2;
  --size:15px; --size-s:13px; --size-xs:11.5px; --h1:34px; --h2:15px; --project:32px;
  --lift:0 1px 2px rgba(0,0,0,.04),0 10px 28px rgba(0,0,0,.07);
}
:root[data-palette="encre"]{--bg:#f1f3f6; --panel:#ffffff; --well:#e6e9ee; --line:#dde1e7; --soft:#646b76; --faint:#a2a8b2}
:root[data-palette="papier"]{--bg:#f5f3ee; --panel:#fffefb; --well:#ebe8e0; --line:#e4e0d6; --soft:#716d64; --faint:#aba69b}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#121212; --panel:#1b1b1b; --well:#242424; --ink:#ededeb; --soft:#9c9c98; --faint:#666663; --line:#2c2c2b; --accent:#7fb0ff; --done:#6cc39b; --doing:#7fb0ff; --todo:#666663; --lift:0 1px 2px rgba(0,0,0,.5),0 10px 28px rgba(0,0,0,.4)}}
:root[data-theme="dark"]{--bg:#121212; --panel:#1b1b1b; --well:#242424; --ink:#ededeb; --soft:#9c9c98; --faint:#666663; --line:#2c2c2b; --accent:#7fb0ff; --done:#6cc39b; --doing:#7fb0ff; --todo:#666663; --lift:0 1px 2px rgba(0,0,0,.5),0 10px 28px rgba(0,0,0,.4)}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);font-size:var(--size);line-height:1.4;font-synthesis:none;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;text-align:left}
input{font:inherit;color:inherit}
.mono{font-family:var(--mono);font-size:.84em}
.top{position:sticky;top:0;z-index:20;display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;padding:9px 20px;background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.brand{font-size:var(--size-s);color:var(--soft)}
.pick{display:inline-flex;align-items:center;gap:8px;font-size:var(--size-s);color:var(--soft)}
.pick select{font:inherit;font-size:var(--size);color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-s);padding:7px 30px 7px 12px;min-height:36px;cursor:pointer;transition:border-color var(--t),background var(--t)}
.pick select:hover{border-color:var(--faint)}
.hd a.btn,.hd a.quiet{text-decoration:none;display:inline-flex;align-items:center}
.tabs{display:flex;gap:2px;margin-left:auto}
.tabs button{padding:6px 14px;border-radius:999px;color:var(--soft);font-size:var(--size-s);transition:background var(--t),color var(--t)}
.tabs button:hover{color:var(--ink)}
.tabs button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.quiet{padding:6px 12px;border-radius:999px;font-size:var(--size-s);color:var(--soft);transition:color var(--t),background var(--t)}
.quiet:hover{color:var(--ink);background:var(--well)}
/* one label for the state of a component: done, in progress, to do */
.tag{display:inline-flex;align-items:center;gap:6px;font-size:var(--size-xs);color:var(--soft);white-space:nowrap;flex:none}
.tag::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--doing);box-sizing:border-box}
.tag.done::before{background:var(--done)}
.tag.todo::before{background:none;border:1.5px solid var(--todo)}
.tag.big{font-size:var(--size-s);color:var(--ink);padding:5px 13px 5px 11px;border-radius:999px;background:var(--panel);border:1px solid var(--line)}
.tag.big::before{width:8px;height:8px}
/* the shell: the project and its tree on the left, the view on the right */
.bench{display:grid;grid-template-columns:var(--side) minmax(0,1fr);gap:var(--gap);align-items:start;padding:var(--gap) 20px 44px}
.side{position:sticky;top:60px;max-height:calc(100vh - 76px);overflow:auto;padding:16px 14px 14px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius)}
.proj h1{margin:0;font-size:var(--project);font-weight:500;letter-spacing:-.02em;line-height:1}
.proj .n{margin:5px 0 12px;color:var(--soft);font-size:var(--size-s)}
.cover{display:block;width:100%;aspect-ratio:16/9;border-radius:var(--radius-s);overflow:hidden;background:#3b3c41}
.cover img{width:100%;height:100%;object-fit:contain;display:block;animation:fade var(--t) both}
.seg{display:inline-flex;padding:2px;border-radius:999px;background:var(--well)}
.seg button{padding:5px 12px;border-radius:999px;font-size:var(--size-xs);color:var(--soft);transition:background var(--t),color var(--t)}
.seg button[aria-pressed="true"]{background:var(--panel);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08)}
.proj .seg{display:flex;margin-top:8px}
.proj .seg button{flex:1;text-align:center;padding:5px 2px}
.counts{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:12px}
.side input{width:100%;padding:7px 11px;border-radius:var(--radius-s);border:1px solid transparent;background:var(--well);margin:14px 0 6px;outline:none;font-size:var(--size-s);transition:border-color var(--t)}
.side input:focus{border-color:var(--accent)}
/* the tree: project, groups, components */
details.node>summary{list-style:none;display:flex;align-items:center;gap:8px;padding:6px 6px;font-size:var(--size-s);font-weight:500;cursor:pointer;border-radius:var(--radius-s)}
details.node>summary::-webkit-details-marker{display:none}
details.node>summary::before{content:'';width:6px;height:6px;flex:none;border-right:1.5px solid var(--soft);border-bottom:1.5px solid var(--soft);transform:rotate(-45deg);transition:transform var(--t)}
details.node[open]>summary::before{transform:rotate(45deg)}
details.node>summary span{margin-left:auto;color:var(--faint);font-weight:400;font-size:var(--size-xs)}
/* the name of the project or of a group is a button: it opens the overview of all its drawings; the chevron folds */
details.node>summary{transition:background var(--t),color var(--t)}
details.node>summary:hover{background:var(--well)}
details.node>summary .lab{flex:1;font-weight:500}
details.node>summary[aria-current="true"]{background:var(--ink);color:var(--bg)}
details.node>summary[aria-current="true"]::before{border-color:var(--bg)}
details.node>summary[aria-current="true"] span{color:inherit;opacity:.7}
.kids{margin-left:9px;padding-left:9px;border-left:1px solid var(--line)}
.item{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;padding:6px 9px;border-radius:var(--radius-s);font-size:var(--size-s);color:var(--soft);transition:background var(--t),color var(--t)}
.item:hover{background:var(--well);color:var(--ink)}
.item[aria-current="true"]{background:var(--ink);color:var(--bg)}
.item[aria-current="true"] .tag{color:inherit;opacity:.85}
.view{display:none}
.view.on{display:grid;gap:var(--gap)}
.hd{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px}
.hd .crumb{width:100%;color:var(--soft);font-size:var(--size-s);margin-bottom:-6px}
.hd h2{margin:0;font-size:var(--h1);font-weight:500;letter-spacing:-.02em;line-height:1.05}
.hd .where{width:100%;color:var(--soft);font-size:var(--size-s);margin-top:-2px}
.hd .right{margin-left:auto;display:flex;align-items:center;gap:6px}
.btn{padding:8px 16px;border-radius:999px;background:var(--ink);color:var(--bg);font-size:var(--size-s);transition:opacity var(--t),transform var(--t)}
.btn:hover{opacity:.85}.btn:active{transform:scale(.97)}
.more{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px 18px;display:none;font-size:var(--size-s);color:var(--soft)}
.more.on{display:grid;gap:8px;animation:rise var(--t) both}
.more b{color:var(--ink);font-weight:500}
.more .acts{display:flex;flex-wrap:wrap;gap:6px}
.more .acts button{padding:5px 12px;border-radius:999px;background:var(--well);font-size:var(--size-xs);color:var(--ink)}
/* ---------- Planche: never more than two columns; the other views are further down ---------- */
.views{display:grid;gap:var(--gap)}
.views.single{grid-template-columns:repeat(var(--columns),minmax(0,1fr))}
.vrow h3,.box h3{margin:0 0 8px;font-size:var(--h2);font-weight:500}
.vrow h3 em{font-style:normal;font-weight:400;color:var(--faint);font-size:var(--size-xs);margin-left:8px}
.hd .counts{margin:0}
.pair{display:grid;grid-template-columns:repeat(var(--n,2),minmax(0,1fr));gap:var(--tile-gap)}
.cell.m3d{background:#1c1c1f}
.seg button:disabled{opacity:.38;cursor:not-allowed}
.item.no3d{opacity:.42}
.ver{display:inline-flex;align-items:center;gap:6px;font-size:var(--size-xs);color:var(--soft)}
.ver select{font:inherit;font-size:var(--size-xs);color:var(--ink);background:var(--well);border:1px solid transparent;border-radius:999px;padding:5px 10px;cursor:pointer;transition:border-color var(--t)}
.ver select:focus{outline:none;border-color:var(--accent)}
.cell.none.small{min-height:0}
.views.single .pair{grid-template-columns:minmax(0,1fr)}
.cell{display:block;width:100%;aspect-ratio:var(--cell);border-radius:var(--radius-s);overflow:hidden;background:var(--well);transition:transform var(--t),box-shadow var(--t)}
.cell.bp{background:var(--blue)}
.cell img{width:100%;height:100%;object-fit:contain;display:block}
button.cell:hover{transform:translateY(-2px);box-shadow:var(--lift)}
.absent{color:var(--faint);font-size:var(--size-s);margin:-4px 2px 0}
.strip{display:grid;grid-template-columns:repeat(var(--columns),minmax(0,1fr));gap:var(--gap)}
.box{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px;min-width:0}
.box.wide{grid-column:1 / -1}
.box .pic{display:block;width:100%;aspect-ratio:16/9;border-radius:var(--radius-s);overflow:hidden;background:#161616;transition:transform var(--t)}
.box .pic:hover{transform:scale(1.01)}
.box .pic img{width:100%;height:100%;object-fit:cover;display:block}
.tl{list-style:none;margin:0;padding:0;columns:var(--columns);column-gap:28px;font-size:var(--size-s)}
.tl li{display:flex;gap:10px;padding:3px 0;break-inside:avoid}
.tl time{color:var(--faint);white-space:nowrap;min-width:38px}
.empty{color:var(--faint);font-size:var(--size-s);margin:0}
/* ---------- Chantiers: a gallery, group after group, two cards per row ---------- */
.gh{display:flex;align-items:baseline;gap:12px;margin:10px 2px -4px}
.gh h3{margin:0;font-size:22px;font-weight:500;letter-spacing:-.01em}
.gh span{color:var(--soft);font-size:var(--size-s)}
.gal{display:grid;grid-template-columns:repeat(var(--columns),minmax(0,1fr));gap:var(--gap)}
.gc{display:block;width:100%;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:transform var(--t),box-shadow var(--t);animation:rise var(--t) both;animation-delay:calc(min(var(--i),10) * 18ms)}
.gc:hover{transform:translateY(-3px);box-shadow:var(--lift)}
.gc .main{display:grid;grid-template-columns:1fr 1fr;gap:3px;padding:3px 3px 0;background:var(--well)}
.gc .main span{display:block;aspect-ratio:var(--cell);overflow:hidden;border-radius:6px;background:var(--well)}
.gc .main span.bp{background:var(--blue)}
.gc .main img{width:100%;height:100%;object-fit:contain;display:block;transition:transform var(--t)}
.gc:hover .main img{transform:scale(1.03)}
.gc .thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;padding:3px;background:var(--well)}
.gc .thumbs span{display:block;aspect-ratio:var(--cell);border-radius:4px;overflow:hidden;background:var(--panel)}
.gc .thumbs span.no{background:none;border:1px dashed var(--line)}
.gc .thumbs img{width:100%;height:100%;object-fit:contain;display:block}
.gc .ft{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 13px 12px}
.gc .ft b{font-weight:500}
/* ---------- Chronologie: hour after hour, two cards per row ---------- */
.filters{display:flex;flex-wrap:wrap;gap:6px}
.filters button{padding:6px 14px;border-radius:999px;font-size:var(--size-s);color:var(--soft);background:var(--panel);border:1px solid var(--line);transition:background var(--t),color var(--t),border-color var(--t)}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.hour{display:grid;grid-template-columns:76px minmax(0,1fr);gap:var(--gap);margin-top:6px}
.hour>time{position:sticky;top:64px;align-self:start;font-size:26px;font-weight:500;letter-spacing:-.02em;line-height:1}
.hour>time small{display:block;font-size:var(--size-xs);font-weight:400;color:var(--soft);letter-spacing:0;margin-top:5px}
.feed{display:grid;grid-template-columns:repeat(var(--columns),minmax(0,1fr));gap:12px}
.ec{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:4px;width:100%;padding:4px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);transition:transform var(--t),box-shadow var(--t);animation:rise var(--t) both;animation-delay:calc(min(var(--i),10) * 18ms)}
.ec:hover{transform:translateY(-2px);box-shadow:var(--lift)}
.ec .th{display:block;aspect-ratio:var(--cell);border-radius:var(--radius-s);overflow:hidden;background:var(--well)}
.ec .th.bp{background:var(--blue)}
.ec .th img{width:100%;height:100%;object-fit:contain;display:block}
.ec .txt{grid-column:1 / -1;display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px;padding:8px 10px 9px}
.ec b{font-weight:500}
.ec .g{color:var(--faint);font-size:var(--size-xs);margin-left:auto}
.ec .ls{width:100%;font-size:var(--size-s);color:var(--soft)}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
/* ---------- lightbox, toast ---------- */
.light{position:fixed;inset:0;z-index:60;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.88);padding:24px;cursor:zoom-out;opacity:0;pointer-events:none;transition:opacity var(--t)}
.light.on{opacity:1;pointer-events:auto}
.light{cursor:default;overflow:hidden;padding:0}
.light img{position:absolute;left:0;top:0;transform-origin:0 0;max-width:none;max-height:none;border-radius:0;cursor:grab;user-select:none;-webkit-user-drag:none}
.light img.drag{cursor:grabbing}
.light .info{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);background:rgba(0,0,0,.6);color:#eee;font-size:12px;padding:6px 12px;border-radius:999px;pointer-events:none;white-space:nowrap}
.light .close{position:absolute;top:14px;right:16px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.12);color:#fff;font-size:18px;line-height:34px;text-align:center;cursor:pointer}
.toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);opacity:0;background:var(--ink);color:var(--bg);padding:9px 16px;border-radius:999px;font-size:var(--size-s);transition:opacity var(--t),transform var(--t);z-index:70;pointer-events:none;max-width:92vw}
.toast.on{opacity:1;transform:translate(-50%,0)}
.fallback{width:100%;min-height:70px;padding:10px;border-radius:var(--radius-s);border:1px solid var(--line);background:var(--well);font-family:var(--mono);font-size:12px}
@media (max-width:860px){:root{--columns:1}.top{padding:9px 16px}.tabs{margin-left:0;width:100%}.tabs button{flex:1;text-align:center;padding:6px 4px}.bench{grid-template-columns:minmax(0,1fr);padding:14px 16px 40px}.side{position:static;max-height:none}.hd h2{font-size:26px}.hd .right{margin-left:0;width:100%;flex-wrap:wrap}.hour{grid-template-columns:minmax(0,1fr);gap:8px}.hour>time{position:static}.pair{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (prefers-reduced-motion: reduce){*{transition:none !important;animation:none !important}}
:root.still *{transition:none !important;animation:none !important}
/* 13 November 2026, 18:00 (Matthieu: « je peux valider ou non les images qui ont été générées »): the generated views of a kit and their verdict */
.iso{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px 16px}
.iso-hd{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px}
.iso-hd h3{margin:0;font-size:var(--size);font-weight:500}.iso-hd h3 em{font-style:normal;color:var(--soft);font-weight:400;margin-left:6px}
.iso-sum{font-size:var(--size-s);color:var(--soft)}
.iso-save{flex-basis:100%;font-size:var(--size-xs);color:var(--soft);display:flex;align-items:center;gap:6px;height:18px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;transition:color var(--t)}   /* its own line, always there: the grid never moves under a second click */
.iso-save.ok{color:var(--done)}.iso-save.bad{color:#b3261e}
.spin{width:11px;height:11px;border-radius:50%;border:1.5px solid var(--line);border-top-color:var(--soft);animation:zrspin .7s linear infinite;display:inline-block}
@keyframes zrspin{to{transform:rotate(360deg)}}
.iso-why{margin:6px 0 12px;font-size:var(--size-xs);color:var(--soft);max-width:90ch}
.iso-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.iso-col{margin:0;display:flex;flex-direction:column;gap:8px;min-width:0}
.iso-col h4{margin:0;font-size:var(--size-xs);font-weight:500;color:var(--soft);display:flex;align-items:center;gap:6px}
.iso-dot{width:7px;height:7px;border-radius:50%;border:1.5px solid var(--todo);box-sizing:border-box}
.iso-col.valid .iso-dot{background:var(--done);border-color:var(--done)}.iso-col.pending .iso-dot{background:var(--doing);border-color:var(--doing)}
.iso-fig{margin:0;display:flex;flex-direction:column;gap:6px}
.iso-pic{display:block;width:100%;aspect-ratio:3/4;padding:0;background:var(--well);border-radius:var(--radius-s);overflow:hidden;border:2px solid transparent;box-sizing:border-box;cursor:zoom-in;transition:border-color var(--t),opacity var(--t)}
.iso-pic img{width:100%;height:100%;object-fit:contain;display:block}
.iso-fig[data-verdict="valid"] .iso-pic{border-color:var(--done)}
.iso-fig[data-verdict="refused"] .iso-pic{opacity:.38}
.iso-fig.last .iso-name{color:var(--ink)}.iso-col{overflow:visible}
.iso-fig figcaption{display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.iso-name{font-size:var(--size-xs);color:var(--faint);overflow-wrap:anywhere}
.iso-fig .seg button{min-height:28px}
.iso-fig .seg button[data-iso="valid"][aria-pressed="true"]{color:var(--done)}
.iso-none{aspect-ratio:3/4;border:1.5px dashed var(--line);border-radius:var(--radius-s);display:grid;place-items:center;font-size:var(--size-xs);color:var(--faint);text-align:center;padding:8px;box-sizing:border-box}
@media (prefers-reduced-motion: reduce){.spin{animation:none}.iso-pic,.iso-save{transition:none}}
a.cell.ctx{display:block;max-width:520px}
</style>
</head>
<body>
<header class="top">
  <label class="pick" id="pick" hidden><span>Projet</span><select id="project" aria-label="Changer de projet"></select></label>
  <div class="brand">ZenRay Blueprints 3D</div>
  <nav class="tabs" aria-label="Vues">
    <button data-view="a" aria-pressed="true">Planche</button>
    <button data-view="b" aria-pressed="false">Chantiers</button>
    <button data-view="c" aria-pressed="false">Chronologie</button>
  </nav>
  <button class="quiet" id="palette">Couleurs : neutre</button>
  <button class="quiet" id="theme">Thème : auto</button>
</header>
<main class="bench">
  <aside class="side" id="side"></aside>
  <div>
    <section class="view on" id="view-a"></section>
    <section class="view" id="view-b"></section>
    <section class="view" id="view-c"></section>
  </div>
</main>
<div class="light" id="light"><img alt="" draggable="false"><div class="info"></div><div class="close" title="Fermer (Échap)">×</div></div>
<div class="toast" id="toast"></div>
