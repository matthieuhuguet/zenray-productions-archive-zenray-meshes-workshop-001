"""28 October 2026, 21:10 : ZenRay Meshes finishing, FENDER GRID, the front fender rebuilt as one adaptive quad grid (finish checklist) :
columns in z (door cut to nose), each column runs from its bottom (the sill line, or the arch circle when the column is over the wheel) to its top
(the top edge : hood side curve where it exists, the frozen target fender top behind it, one arc each), so the arch edge follows the circle exactly
and no cell is cut ; x of every vertex = ray (+x to -x) hit on the frozen target fender, then smoothed (Gaussian over --smooth cells) ; closed 12 mm
shell, outward by signed volume, mirrored. FR : l'aile refaite en une grille adaptée, arche suivant le cercle, profondeur lue sur la forme gelée.
python FenderGrid.py <delivery.npz> <out.npz> [--target work/car/target_v644.npz] [--rows 22] [--smooth 1.5]"""
import argparse, json, os, sys
import numpy as np, trimesh
from scipy.ndimage import gaussian_filter
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from FinishCheck import part, tri
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car/"
ap = argparse.ArgumentParser(); ap.add_argument("npz"); ap.add_argument("out"); ap.add_argument("--target", default=W + "target_v644.npz")
ap.add_argument("--rows", type=int, default=22); ap.add_argument("--edge-m", type=float, default=0.02); ap.add_argument("--smooth", type=float, default=1.5)
ap.add_argument("--y-bottom", type=float, default=0.30); ap.add_argument("--thick", type=float, default=0.012); ap.add_argument("--pad", type=float, default=0.012); ap.add_argument("--fan", type=int, default=1, help="1 : each column is a fan of rays in its (x, y) plane from an inner centre, farthest hit kept, from the top edge to the bottom (arch or sill) : works on the near horizontal top and the near vertical side alike (28 October 2026)"); ap.add_argument("--centre", default="0.55,0.35")
a = ap.parse_args()
TP, TQ = part(a.target, "CAR_body_fender_front_L"); tm = trimesh.Trimesh(TP, tri(TQ), process=False)
Ar, _ = part(a.npz, "CAR_arch_front_L"); HC = np.load(W + "finish/hood_side_L.npy"); HC = HC[np.argsort(HC[:, 2])]
A_ = np.stack([Ar[:, 2], Ar[:, 1], np.ones(len(Ar))], 1); s2, s1, cc = np.linalg.lstsq(A_, Ar[:, 2] ** 2 + Ar[:, 1] ** 2, rcond=None)[0]
cz, cy = s2 / 2, s1 / 2; R = np.sqrt(cc + cz * cz + cy * cy) + a.pad
z0, z1 = TP[:, 2].min() + 0.01, TP[:, 2].max() - 0.01; zz = np.linspace(z0, z1, int((z1 - z0) / a.edge_m) + 1)
top = np.array([TP[np.abs(TP[:, 2] - z) < 0.012][:, 1].max() for z in zz]); behind = zz < HC[0, 2]
ct = np.polyfit(zz[behind], top[behind], 2); yt = np.where(behind, np.polyval(ct, zz), np.interp(zz, HC[:, 2], HC[:, 1]))
j = np.argmin(np.abs(zz - HC[0, 2])); yt[behind] += HC[0, 1] - np.polyval(ct, HC[0, 2])   # C0 at the cowl
dz = np.abs(zz - cz); yb = np.where(dz < R, cy + np.sqrt(np.clip(R * R - dz * dz, 0, None)), a.y_bottom); yb = np.maximum(yb, a.y_bottom)
ok = yt - yb > 0.03; zz, yt, yb = zz[ok], yt[ok], yb[ok]
t = np.linspace(0, 1, a.rows + 1); Y = yb[None, :] + (yt - yb)[None, :] * t[:, None]; Z = np.repeat(zz[None, :], len(t), 0)
if a.fan:
    cx0, cy0 = (float(v) for v in a.centre.split(","))
    xt = np.where(zz < HC[0, 2], np.nan, np.interp(zz, HC[:, 2], HC[:, 0]))
    X = np.zeros_like(Y); miss = np.zeros(Y.shape, bool)
    for i, z in enumerate(zz):
        # angle of the bottom point (arch or sill, on the outer side) and of the top point (hood edge, or the target top)
        sl = TP[np.abs(TP[:, 2] - z) < 0.012]
        tp = np.array([xt[i] if not np.isnan(xt[i]) else sl[sl[:, 1].argmax(), 0], yt[i]])
        bsl = sl[np.abs(sl[:, 1] - yb[i]) < 0.02]; bp = np.array([bsl[:, 0].max() if len(bsl) else sl[:, 0].max(), yb[i]])
        a0, a1 = np.arctan2(bp[1] - cy0, bp[0] - cx0), np.arctan2(tp[1] - cy0, tp[0] - cx0)
        for j, tt in enumerate(t):
            ang = a0 + (a1 - a0) * tt; dvec = np.array([np.cos(ang), np.sin(ang), 0.0]); o = np.array([cx0, cy0, z])
            loc, _, _ = tm.ray.intersects_location([o], [dvec], multiple_hits=True)
            if len(loc):
                f = loc[np.argmax(((loc - o) ** 2).sum(1))]; X[j, i], Y[j, i] = f[0], f[1]
            else:
                miss[j, i] = True; X[j, i], Y[j, i] = (bp if tt < 0.5 else tp)
    X[0], Y[0] = [np.array([v]) for v in ()] or X[0], Y[0]
    for k, arr in ((0, X), (1, Y)):
        arr[1:-1, 1:-1] = gaussian_filter(arr, a.smooth)[1:-1, 1:-1]
    G = np.stack([X, Y, Z], -1); nb, na = G.shape[:2]
else:
    org = np.stack([np.full(Y.size, 2.0), Y.ravel(), Z.ravel()], 1)
    loc, ri, _ = tm.ray.intersects_location(org, np.tile([-1.0, 0, 0], (len(org), 1)), multiple_hits=False)
    X = np.full(Y.size, np.nan); X[ri] = loc[:, 0]; X = X.reshape(Y.shape); miss = np.isnan(X)
    if miss.any():   # misses near the top edge : nearest surface point
        cp = trimesh.proximity.closest_point(tm, np.stack([np.full(miss.sum(), 0.8), Y[miss], Z[miss]], 1))[0]; X[miss] = cp[:, 0]
    X[1:-1, 1:-1] = gaussian_filter(X, a.smooth)[1:-1, 1:-1]
    G = np.stack([X, Y, Z], -1); nb, na = G.shape[:2]
du = np.gradient(G, axis=1); dv = np.gradient(G, axis=0); N = np.cross(du, dv); N /= np.linalg.norm(N, axis=-1, keepdims=True) + 1e-12
if N[..., 0].mean() < 0: N = -N
B = G - a.thick * N; gid = lambda j, i: j * na + i; off = nb * na; P = np.vstack([G.reshape(-1, 3), B.reshape(-1, 3)]); F = []
for j in range(nb - 1):
    for i in range(na - 1):
        q = [gid(j, i), gid(j, i + 1), gid(j + 1, i + 1), gid(j + 1, i)]; F.append(q); F.append([off + x for x in q[::-1]])
ring = [gid(0, i) for i in range(na)] + [gid(j, na - 1) for j in range(1, nb)] + [gid(nb - 1, i) for i in range(na - 2, -1, -1)] + [gid(j, 0) for j in range(nb - 2, 0, -1)]
for k in range(len(ring)): F.append([ring[k], off + ring[k], off + ring[(k + 1) % len(ring)], ring[(k + 1) % len(ring)]])
vol = sum(np.dot(P[q[0]], np.cross(P[q[k]], P[q[k + 1]])) for q in F for k in (1, 2))
if vol < 0: F = [q[::-1] for q in F]
PR = P * np.array([-1, 1, 1]); FR = [[v + len(P) for v in q[::-1]] for q in F]
np.savez(a.out, P=np.vstack([P, PR]).astype(np.float32), Q=np.array(F + FR, dtype=object), names=np.array(["CAR_body_fender_front_L"] * len(F) + ["CAR_body_fender_front_R"] * len(FR)))
print(json.dumps({"grid": [nb, na], "arch": [round(float(cz), 3), round(float(cy), 3), round(float(R), 3)], "ray_miss": int(np.sum(miss)), "faces_per_side": len(F)}))
