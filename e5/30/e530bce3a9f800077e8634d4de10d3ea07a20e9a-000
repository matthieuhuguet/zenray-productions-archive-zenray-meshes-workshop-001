"""1 November 2026 : M22 verifier of the grids and of the reader, both ways : every sheet filled cleanly must read green line by line, one sheet filled wrongly must read red on exactly the three spoiled lines. Exit code 0 only if both hold. Writes 06_checks/selftest.json.
    python -I MicroSelfTest.py Projects/<id>/params.json        FR : vérificateur des grilles et du lecteur, dans les deux sens."""
import sys, json, io, contextlib
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
sys.path.insert(0, ROOT + "/Scripts/micro"); import MicroCommon as C, MicroSimFill as F, MicroIngest as I


def main(params):
    p, home = C.load(params); idx = json.load(open(f"{home}/03_sheets/sheets.json")); out = dict(clean=[], flagged=[]); n = 0; ok = 0
    for s in idx["sheets"]:
        with contextlib.redirect_stdout(io.StringIO()): F.main(params, s["id"], f"{home}/06_checks/sim_{s['id']}_good.png"); r = I.main(params, s["id"], f"{home}/06_checks/sim_{s['id']}_good.png", "_simgood")
        for l in r["lines"]:
            n += 1; ok += l["verdict"] == "ok"
            if l["verdict"] != "ok": out["flagged"].append(dict(sheet=s["id"], line=l["line"], mc=l["mc"], fr=l["fr"], reasons=l["reasons"]))
    sid = idx["sheets"][0]["id"]
    with contextlib.redirect_stdout(io.StringIO()): F.main(params, sid, f"{home}/06_checks/sim_{sid}_bad.png", True); b = I.main(params, sid, f"{home}/06_checks/sim_{sid}_bad.png", "_simbad")
    red = [l["line"] for l in b["lines"] if l["verdict"] != "ok"]; out.update(lines=n, green=ok, bad_sheet=sid, bad_red_lines=red); good = ok == n and red == [1, 2, 3]; out["pass"] = good; json.dump(out, open(f"{home}/06_checks/selftest.json", "w"), indent=1, ensure_ascii=False)
    print(f"clean sheets : {ok} of {n} lines green ; wrong sheet : lines {red} red (expected [1, 2, 3]) ; pass = {good}")
    for f in out["flagged"][:14]: print(" ", f["sheet"], "L%d" % f["line"], f["mc"], f["fr"], f["reasons"][:2])
    sys.exit(0 if good else 1)


if __name__ == "__main__": main(sys.argv[1])
