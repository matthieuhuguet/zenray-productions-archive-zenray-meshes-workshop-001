# 25 October 2026 : ZenRay Meshes, traced guide curves -> snapped to the view's edge pixels -> world coordinates.
# EN: each traced point moves to the nearest edge pixel within snap_px (the drawing of the design line), then maps to
# the world through the frame (centre alignment, same rule as SheetScore); output keeps the two world axes of the view.
# FR : chaque point décalqué se recolle au contour le plus proche, puis passe en coordonnées du monde.
# Usage: python DesignCurves.py <curves.json> <edges.npy> <frame_dir> <out.json> [board.png view_rgb.png]
import sys, json, os
import numpy as np
from scipy import ndimage as ndi
P = {"snap_px": 4}


def to_world(meta, view, px, py):
    v = [x for x in meta["views"] if x["name"] == view][0]
    lo = np.array(meta["lo"]); D = np.array(meta["dims_m"]); hi = lo + D
    rx, uy = np.array(v["rx"]), np.array(v["uy"]); a, b = int(np.argmax(np.abs(rx))), int(np.argmax(np.abs(uy)))
    umin = lo[a] if rx[a] > 0 else -hi[a]; vmax = hi[b] if uy[b] > 0 else -lo[b]
    s = v["px_per_m"]; bb = v["bbox"]; xc, yc = (bb[0] + bb[2]) / 2, (bb[1] + bb[3]) / 2
    ucen, vcen = umin + D[a] / 2, vmax - D[b] / 2
    u = ucen + (px - xc) / s; w = vcen - (py - yc) / s
    return "xyz"[a], u * np.sign(rx[a]), "xyz"[b], w * np.sign(uy[b])


def main(cfile, edges, fdir, out, board=None, rgb=None):
    C = json.load(open(cfile)); E = np.load(edges); meta = json.load(open(os.path.join(fdir, "frame.json")))
    dist, idx = ndi.distance_transform_edt(~E, return_indices=True)
    res = {"_date": "25 October 2026", "view": C["view"], "curves": {}}; snapped_all = {}
    for name, pts in C["curves"].items():
        sn = []
        for x, y in pts:
            xi, yi = int(round(x)), int(round(y))
            if dist[yi, xi] <= P["snap_px"]: y2, x2 = idx[0][yi, xi], idx[1][yi, xi]; sn.append((float(x2), float(y2)))
            else: sn.append((float(x), float(y)))
        snapped_all[name] = sn
        an, u, bn, w = to_world(meta, C["view"], np.array([p[0] for p in sn]), np.array([p[1] for p in sn]))
        res["curves"][name] = {an: u.round(4).tolist(), bn: w.round(4).tolist(), "px": sn}
    json.dump(res, open(out, "w"), indent=1); print(out, len(res["curves"]))
    if board:
        from PIL import Image, ImageDraw
        im = Image.open(rgb).convert("RGB"); s = 3; im = im.resize((im.width * s, im.height * s)); d = ImageDraw.Draw(im)
        for name, sn in snapped_all.items():
            d.line([(x * s, y * s) for x, y in sn], fill=(230, 80, 50), width=3)
            d.text((sn[0][0] * s, sn[0][1] * s - 14), name, fill=(255, 255, 255))
        im.save(board)


if __name__ == "__main__":
    main(*sys.argv[1:])
