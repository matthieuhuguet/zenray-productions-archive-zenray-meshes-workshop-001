#!/bin/zsh
# 26 October 2026 : ZenRay Meshes, ONE COMMAND from a calibrated sheet to an organic asset (tree like objects) : soft ridge maps, measured limbs and branches (m20), twigs, leaf cards, build in Houdini,
# scores, components table and a smooth hero. Every number lives in the block below (HDA style : change it here, nowhere else). FR : une commande, de la planche à l'arbre.
# Usage: OBJ=tree zsh TreeFromSheet.sh <tag>        (OBJ = work/<obj>, tree by default)
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; TAG=$1; OBJ=${OBJ:-tree}; cd $W
# ---- parameters (the winning recipe of the 26 October 2026 tournament, skill sections 101 to 103) ----
M20="tau1=0.3 sub1=4 tau2=0.2 sub2=4.5 avg2=0.25 tol=0.08"     # limbs : thick ridges first, then medium branches hung on them ; tol = the smoothing of every whole branch curve in metres (0.08 : limbs 98 percent clean of kinks)
BUILD="prune_out=0 max_seg_m=3.0 carve_wood=1 carve_k=1 carve_dilate_px=3 carve_mask=ridgewood file_twigs=1 shell_clumps=2400 root_flare=1.25 trunk_clear_k=1.0 trunk_clear_m=0.1"   # no old pruning, leaves carved off visible wood, twigs toward the foliage, a slight root flare (roots component 0.849 to 0.864), leaves allowed 1.0 radius + 0.1 m from the trunk ; the leaf shape and its hang (0.4, centred) are in work/<obj>/tree_ctrl.txt
# ----------------------------------------------------------------------------------------------------
PHASE=${PHASE:-wood}   # wood : trunk, limbs and branches measured on the sheet, nothing else (the default, the work of the day) ; full : twigs and leaves added last
[ "$PHASE" = "wood" ] && BUILD="$BUILD leaves=0 file_twigs=0"   # the invented twigs belong to the leaf phase : the wood phase keeps only what the sheet shows
$PY -I Scripts/BranchLab.py ridge $OBJ | tail -1
$PY -I Scripts/BranchMethods.py m20 obj=$OBJ ${=M20} | tail -1 | cut -c1-240
cp work/$OBJ/branches_m20.npz work/$OBJ/limbs_$TAG.npz
OBJ=$OBJ zsh Scripts/TreeIter.sh $TAG thick limb_src=file limb_file=work/$OBJ/limbs_$TAG.npz ${=BUILD} | tail -1 | cut -c1-120
$PY -I Scripts/ComponentScore.py $TAG --obj $OBJ --no-board | tail -1 | cut -c1-90
$PY -I Scripts/CurveStats.py work/$OBJ/limbs_$TAG.npz $OBJ --json versions/CurveStats_${OBJ}_$TAG.json | cut -c1-200
$PY -I Scripts/BranchComponents.py $TAG $OBJ | sed -n 3,3p
$PY -I Scripts/ComponentScore.py $TAG --obj $OBJ | tail -1 | cut -c1-110   # again, now with the ridge judged wood components and the board
$PY -I Scripts/TopoToRender.py work/$OBJ/topo_$TAG.npz work/$OBJ/render_$TAG.npz | tail -1
$PY -I Scripts/CleanView.py work/$OBJ/render_$TAG.npz versions/TreeHero_${OBJ}_$TAG.png "" 30 700 | tail -1
echo "hero: versions/TreeHero_${OBJ}_$TAG.png   limbs: work/$OBJ/limbs_$TAG.npz"
