"""29 October 2026 : ZenRay Retopology DUEL, one component, two cuts : the finisher tournament (ZrrBest, 8 variants) runs on the outline of
the voxel partition (work/retopo/shell.npz, sharp corners) and on the outline of the MBO cut (work/lines/shell_mbo.npz, smooth
borders) ; the best of the 16 builds is kept (most judge lines passed, then the smallest kink, then the smallest deviation).
Writes work/lines/components/<component>/ (panel.npz, panel.obj, judge.json) and versions/Lines_<component>.png.
python ZrlDuel.py <component>        FR : un component, deux découpes, seize variantes, la meilleure gardée."""
import json, os, sys
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
sys.path.insert(0, f"{ROOT}/Scripts"); sys.path.insert(0, f"{ROOT}/Scripts/retopo"); sys.path.insert(0, f"{ROOT}/Scripts/curverig")
import ZrrData as D, ZrrPatch as Z, ZrrBest as B, ZrrSheet as S
PARAMS = {"cuts": {"voxel": f"{ROOT}/work/retopo/shell.npz", "mbo": f"{ROOT}/work/lines/shell_mbo.npz"}, "out": f"{ROOT}/work/lines/components"}   # 29 October 2026

if __name__ == "__main__":
    name = sys.argv[1]; car = D.load(); vis = json.load(open(f"{ROOT}/work/retopo/visibility.json")); runs = {}
    for tag, path in PARAMS["cuts"].items():
        Z._SHELL.clear(); base = dict(Z.PARAMS); base["partition"] = path; Z.PARAMS["partition"] = path
        top, rows = B.best(name, car, vis, base=base); runs[tag] = (top, rows)
    ok = {t: r for t, r in runs.items() if r[0] is not None}
    if not ok: print(name, "NO BUILD", flush=True); sys.exit(1)
    tag = max(ok, key=lambda t: B.rank(ok[t][0][1])); (res, j, prm), rows = ok[tag]
    d = Z.save(res, PARAMS["out"]); pid = car["names"].index(name); T, _ = D.triangulate(car, car["T"] == pid)
    S.board(res, j, f"{ROOT}/versions/Lines_{name}.png", old=(car["P"], T), title=f"ZenRay Retopology, {name}, cut {tag}, {res['info']['nu']} x {res['info']['nv']} quads, score {j['score']['percent']} %, 29 October 2026")
    json.dump({"cut": tag, "info": res["info"], "judge": j, "params": {k: prm[k] for k in B.VARIANTS}, "duel": {t: (r[0][1]["score"]["percent"] if r[0] else None) for t, r in runs.items()}},
              open(os.path.join(d, "judge.json"), "w"), indent=1, default=float)
    print(f"{name:30s} {j['score']['percent']:5.1f} % cut {tag} duel {[(t, r[0][1]['score']['percent'] if r[0] else None) for t, r in runs.items()]} failed {[k for k, v in j.items() if k != 'score' and not v['ok']]}", flush=True)
