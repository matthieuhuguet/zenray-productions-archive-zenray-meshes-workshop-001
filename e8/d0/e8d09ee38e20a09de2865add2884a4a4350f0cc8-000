def bad_boundary_vertex(P, Q, qf, loop, hi_margin=5.0):
    """Boundary vertex of the patch whose quads of the patch have the largest corner angle above HI. Returns (v, angles list, theta total) or None."""
    inc = collections.defaultdict(list)
    for f in qf:
        for k in range(4): inc[int(Q[f][k])].append((f, k))
    best = None
    for v in loop:
        angs = []
        for f, k in inc[v]:
            q = Q[f]; a = P[q[(k + 1) % 4]] - P[v]; b = P[q[(k - 1) % 4]] - P[v]
            n = np.cross(P[q[2]] - P[q[0]], P[q[3]] - P[q[1]]); n /= max(np.linalg.norm(n), 1e-30)
            angs.append(float(np.degrees(np.arctan2(n @ np.cross(a, b), a @ b)) % 360.0))
        if not angs: continue
        m = max(angs)
        if m > HI + hi_margin and (best is None or m > best[3]): best = (v, angs, sum(angs), m)
    return best


def repair_mesh(P, Q, qpart, qcorners, ref, h, max_splits=2000, min_gain=0.02, verbose=False):
    """Local repair of every patch that has a boundary vertex whose quad angle exceeds HI. P (n,3), Q (m,4) arrays, qpart per patch quad ids, qcorners per patch
    corner vertex ids. Returns (P2, Q2, log) with unused vertices and dead quads removed."""
    P = np.array(P, float); Q = np.array(Q, int)
    alive = np.ones(len(Q), bool)
    patches = [{"qf": list(qf), "corners": set(int(c) for c in qcorners[i])} for i, qf in enumerate(qpart)]
    queue = list(range(len(patches))); log = []; tried = set(); splits = 0
    while queue and splits < max_splits:
        pi = queue.pop(0); rec = patches[pi]
        loop = patch_loop(Q, rec["qf"])
        if loop is None: log.append(("noloop", pi)); continue
        bv = bad_boundary_vertex(P, Q, rec["qf"], loop)
        while bv is not None and (pi, bv[0]) in tried:
            # look for the next worst vertex
            loop2 = [x for x in loop if (pi, x) not in tried]
            if not loop2: bv = None; break
            bv = bad_boundary_vertex(P, Q, rec["qf"], loop2)
            if bv is not None and (pi, bv[0]) in tried: bv = None
        if bv is None: continue
        v, angs, theta, mx = bv
        n = R.quads_needed(theta)
        if n is None or n < 2:
            tried.add((pi, v)); log.append(("skip_angle", pi, v, round(theta, 1))); queue.append(pi); continue
        corner_set = set(rec["corners"]) | {v}
        res = try_split(P, Q, rec["qf"], loop, corner_set, v, theta, n, ref, h)
        if res is not None:
            jo = corner_j_all(P, Q[rec["qf"]]); jn = corner_j_all(res["pos"], res["quads"])
            res["old_stats"] = (int((jo < 0).sum()), int((jo < 0.3).sum()), float(jo.mean())); res["new_stats"] = (int((jn < 0).sum()), int((jn < 0.3).sum()), float(jn.mean()))
            better = (res["new_stats"][0], res["new_stats"][1], -res["new_stats"][2]) < (res["old_stats"][0], res["old_stats"][1], -res["old_stats"][2])
            res["better"] = better
        if res is None or not res["better"] or res["new_stats"][0] > res["old_stats"][0]:
            tried.add((pi, v)); log.append(("rejected", pi, v, round(theta, 1), n, None if res is None else (res["old_stats"], res["new_stats"]))); queue.append(pi); continue
        # apply
        names = res["names"]; gid = {}; newP = []
        for k, nm in enumerate(names):
            if nm[0] == "old": gid[k] = nm[1]
            else:
                gid[k] = len(P) + len(newP); newP.append(res["pos"][k])
        P = np.vstack([P, np.array(newP)]) if newP else P
        newQ = np.array([[gid[i] for i in q] for q in res["quads"]])
        for f in rec["qf"]: alive[f] = False
        base = len(Q); Q = np.vstack([Q, newQ]); alive = np.concatenate([alive, np.ones(len(newQ), bool)])
        # split the new quads into the two sub patches by their tag : names ('int', tag, i) and quads touching them ; use the per tag lists stored in res
        tagA = set(res["quad_tags"]["A"]); 
        qa = [base + i for i in range(len(newQ)) if i in tagA]; qb = [base + i for i in range(len(newQ)) if i not in tagA]
        cornersA = set(gid[nm_i] for nm_i in res["corners_idx"]["A"]); cornersB = set(gid[nm_i] for nm_i in res["corners_idx"]["B"])
        patches.append({"qf": qa, "corners": cornersA}); patches.append({"qf": qb, "corners": cornersB})
        queue += [len(patches) - 2, len(patches) - 1]
        splits += 1; log.append(("split", pi, v, round(theta, 1), n, res["old_stats"], res["new_stats"], res["x"]))
    # compact
    keep = np.where(alive)[0]; Qk = Q[keep]; used = np.unique(Qk); remap = -np.ones(len(P), int); remap[used] = np.arange(len(used))
    return P[used], remap[Qk], log
