# 27 October 2026 14:05 Paris: eliminate newly damaged support faces only, leaving previously checked faces intact.
import argparse,os,sys,json
import numpy as np
sys.path.insert(0,os.path.dirname(os.path.abspath(__file__)))
import TopoCheck
from ReplaceComponents import read_mesh
from TopoFix import save


def flags(points,faces,names,params):
    uniq,ids=np.unique(names,return_inverse=True);counts=np.array([len(q) for q in faces]);indices=np.concatenate(faces)
    return TopoCheck.analyse(points,counts,indices,ids,uniq,TopoCheck.load_params(params))[2]


def main(args):
    base,q,n=read_mesh(args.baseline);cand,q2,n2=read_mesh(args.candidate)
    if len(base)!=len(cand) or n!=n2 or len(q)!=len(q2) or any(a!=b for a,b in zip(q,q2)):raise ValueError('Topology differs from baseline')
    before=flags(base,q,n,args.params);after=flags(cand,q,n,args.params);removed=np.flatnonzero(after & ~before)
    if len(removed)>args.max_faces:raise ValueError('Too many newly faulty faces')
    keep=np.ones(len(q),bool);keep[removed]=False;save(args.output,cand,[f for f,k in zip(q,keep) if k],[name for name,k in zip(n,keep) if k])
    print(json.dumps({'baseline_faults':int(before.sum()),'candidate_faults':int(after.sum()),'removed_new_fault_faces':len(removed)}))

if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('baseline');p.add_argument('candidate');p.add_argument('params');p.add_argument('output');p.add_argument('--max-faces',type=int,default=100);main(p.parse_args())
