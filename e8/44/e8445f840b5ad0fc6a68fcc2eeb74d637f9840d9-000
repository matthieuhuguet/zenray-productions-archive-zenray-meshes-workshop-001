"""Pass 9 : half mirror quadrangulation versus whole mesh QuadWild, symmetry residual and judge. Written 30 October 2026.
Usage : python3 -I run_symmetry.py base=WORK cases=arch:mechanical:3.0,sphere:organic:2.0,... out=res.json
For each case : detect the best mirror plane, QuadWild on the whole mesh (baseline) and on the half, mirror and weld.
FR : quadrangulation par moitie puis reflet et soudure, comparee a QuadWild sur le maillage entier."""
import sys, json, os, time
sys.path.insert(0, ".")
import numpy as np, trimesh
import zr8_io as IO, zr8_judge as J, zr8_symmetry as SY, qw_run as QR

a = dict(kv.split("=", 1) for kv in sys.argv[1:]); base = a["base"]; out = []
os.makedirs(base + "/sym", exist_ok=True)
def mean_edge(V, F):
    e = np.concatenate([F[:, [0, 1]], F[:, [1, 2]], F[:, [2, 0]]]); return float(np.linalg.norm(V[e[:, 0]] - V[e[:, 1]], axis=1).mean())
for spec in a["cases"].split(","):
    name, mode, scale = spec.split(":")
    src = "%s/meshes/%s.obj" % (base, name); V, F = IO.read_obj_tri_or_quad(src); V = np.array(V); F = np.array(F); edge = mean_edge(V, F)
    planes = SY.detect_mirror_planes(V, F, edge)
    if not planes:
        print(name, "no mirror plane"); out.append({"name": name, "planes": 0}); continue
    n, d, med, inl = planes[0]
    if name == "torus":                                    # the torus has a continuous family of planes through its axis : pick x = 0 explicitly
        n, d = np.array([1.0, 0, 0]), 0.0
    if name == "sphere":
        n, d = np.array([0, 0, 1.0]), 0.0
    res = {"name": name, "planes_found": len(planes), "plane_normal": np.round(n, 3).tolist(), "plane_offset": round(float(d), 4), "detect_median_edges": round(med, 3), "detect_inliers": round(inl, 3)}
    Vh, Fh = SY.cut_half(V, F, n, d)
    hp = "%s/sym/%s_half.obj" % (base, name); IO.write_obj(hp, Vh, Fh)
    t = time.time(); r = QR.run({"mesh": hp, "workdir": base + "/sym", "mode": mode, "scale": scale})
    if not r["ok"]:
        res["half_run"] = "failed"; out.append(res); print(name, "half run failed", r.get("tail")); continue
    res["half_seconds"] = round(time.time() - t, 1)
    # whole mesh baseline from the earlier runs (same mode and scale)
    wp = "%s/qw/%s_rem_p0_123_quadrangulation_smooth.obj" % (base, name)
    for label, path in (("whole", wp), ("half_raw", r["quad"]), ("half_smooth", r["quad_smooth"])):
        if not os.path.exists(path): continue
        P, Q = IO.read_obj_tri_or_quad(path); P = np.array(P); Q = np.array(Q)
        if label.startswith("half"):
            P, Q = SY.mirror_weld(P, Q, n, d, 1e-5)
        j = J.judge_plus(P, Q, ref_tris=(V, F)); med_r, max_r = SY.mirror_residual(P, Q, n, d, mean_edge(P[Q[:, [0, 1]].ravel()].reshape(-1, 2, 3).reshape(-1, 3)[:0] if False else P, Q) if False else edge)
        res[label] = {"quads": int(len(Q)), "folded_pct": round(100 * j["folded_frac"], 3), "squashed_pct": round(100 * j["squashed_frac"], 3), "jac_mean": round(j["jac_mean"], 4),
                      "angle_dev": round(j["angle_dev_mean_deg"], 2), "turn_iso": round(j["loop_turn_iso_mean_deg"], 2), "poles_per_1000": round(j["poles_per_1000_quads"], 1),
                      "euler": j["euler"], "boundary_edges": j["boundary_edges"], "nonmanifold": j["nonmanifold_edges"], "dist_to_input_frac_diag": round(j["dist_mean_frac_diag"], 6),
                      "mirror_residual_median_edges": round(med_r, 4), "mirror_residual_max_edges": round(max_r, 4)}
    out.append(res); print(json.dumps(res), flush=True)
json.dump(out, open(a["out"], "w"), indent=1)
