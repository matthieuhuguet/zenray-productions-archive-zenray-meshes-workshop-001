"""Découpe de la planche six vues (cadres lus par séparateurs), masques de silhouette par distance au fond + fermeture, sorties dans out/board/.
30 October 2026."""
import sys, json, os
import numpy as np, cv2
from PIL import Image
BOARD = "/home/user/Memory/Projects/zenray-meshes/handoff/car-finish-30-October-2026/files/tmp/tmp-zenray-meshes/refs/objects/06_Car/06_Car_6views_25-October-2026.png"
ROWS = [(0, 410), (413, 777), (780, 1254)]
COLS = [(0, 624), (629, 1254)]
NAMES = [["front", "back"], ["left", "right"], ["top", "bottom"]]
def panels():
    a = np.asarray(Image.open(BOARD).convert("RGB"))
    out = {}
    for r, (y0, y1) in enumerate(ROWS):
        for c, (x0, x1) in enumerate(COLS):
            out[NAMES[r][c]] = (a[y0:y1, x0:x1].copy(), (x0, y0))
    return out
def mask_of(img, thr=14.0):
    a = img.astype(np.float32)
    # fond : médiane des bords du cadre
    border = np.concatenate([a[:6].reshape(-1, 3), a[-6:].reshape(-1, 3), a[:, :6].reshape(-1, 3), a[:, -6:].reshape(-1, 3)])
    bg = np.median(border, axis=0)
    d = np.sqrt(((a - bg) ** 2).sum(2))
    m = (d > thr).astype(np.uint8)
    # le bord du cadre (ligne séparatrice) retiré
    m[:4] = 0; m[-4:] = 0; m[:, :4] = 0; m[:, -4:] = 0
    m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8))
    n, lab, stats, _ = cv2.connectedComponentsWithStats(m, 8)
    if n > 1:
        big = 1 + np.argmax(stats[1:, cv2.CC_STAT_AREA])
        m = (lab == big).astype(np.uint8)
    # remplir les trous
    ff = m.copy(); h, w = m.shape; cv2.floodFill(ff, np.zeros((h + 2, w + 2), np.uint8), (0, 0), 1)
    m = m | (1 - ff)
    return m, bg
if __name__ == "__main__":
    os.makedirs("out/board", exist_ok=True)
    P = panels()
    info = {}
    for k, (img, org) in P.items():
        m, bg = mask_of(img)
        ys, xs = np.where(m)
        info[k] = {"origin": org, "size": [img.shape[1], img.shape[0]], "bg": bg.round(1).tolist(), "mask_bbox": [int(xs.min()), int(ys.min()), int(xs.max()), int(ys.max())], "mask_px": int(m.sum())}
        ov = img.copy(); cnt, _ = cv2.findContours(m, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
        cv2.drawContours(ov, cnt, -1, (255, 40, 40), 1)
        Image.fromarray(ov).save(f"out/board/{k}_overlay.png"); Image.fromarray(img).save(f"out/board/{k}.png"); Image.fromarray(m * 255).save(f"out/board/{k}_mask.png")
        print(k, info[k])
    json.dump(info, open("out/board/board_info.json", "w"), indent=1)
