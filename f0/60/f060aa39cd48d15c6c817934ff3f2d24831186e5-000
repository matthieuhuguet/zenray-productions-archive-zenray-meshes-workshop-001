"""30 October 2026 : QuadWild Bi-MDF on any triangle OBJ (built in tools/quadwild-bimdf, no Gurobi), for the any-mesh comparison with the same judge.
    python -I QwBench.py mesh.obj out_dir [organic|mechanical|basic] [timeout_s]
Runs quadwild (field, patches) then quad_from_patches (quantization with Bi-MDF, quad patches) and prints the output files. FR : QuadWild Bi-MDF sur un OBJ triangule quelconque."""
import glob, os, shutil, subprocess, sys, time
QW = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/tools/quadwild-bimdf"
src, out = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2]); kind = sys.argv[3] if len(sys.argv) > 3 else "basic"; tmo = int(sys.argv[4]) if len(sys.argv) > 4 else 900
os.makedirs(out, exist_ok=True); name = os.path.splitext(os.path.basename(src))[0]; dst = os.path.join(out, name + ".obj"); shutil.copy(src, dst)
prep = {"organic": "basic_setup_Organic.txt", "mechanical": "basic_setup_Mechanical.txt"}.get(kind, "basic_setup.txt"); t = time.time()
r1 = subprocess.run([f"{QW}/build/Build/bin/quadwild", dst, "2", f"{QW}/config/prep_config/{prep}"], capture_output=True, text=True, timeout=tmo, cwd=QW)
rem = os.path.join(out, name + "_rem_p0.obj")
if not os.path.exists(rem): print("quadwild failed", r1.stdout[-300:], r1.stderr[-300:]); sys.exit(1)
r2 = subprocess.run([f"{QW}/build/Build/bin/quad_from_patches", rem, "123", f"{QW}/config/main_config/flow_noalign_lemon.txt"], capture_output=True, text=True, timeout=tmo, cwd=QW)
print("seconds", round(time.time() - t, 1)); print([os.path.basename(p) for p in sorted(glob.glob(os.path.join(out, name + "*quad*.obj")))], r2.stdout[-200:].replace("\n", " "))
