#!/bin/zsh
# 2 November 2026 : the head, from blocks to final sculpt, in one command, each stage feeding the next as in ep04. FR : la tête, des blocs au sculpt final, en une commande, chaque étape nourrissant la suivante comme dans l'ep04.
# Usage : RunHead.sh <v3 folder>
cd "$1" || exit 1
HY=/Applications/Houdini/Current/Frameworks/Houdini.framework/Versions/Current/Resources/bin/hython; PY=/Users/zenray/.venvs/zenray-meshes/bin/python; C=../../../Scripts/Dracard/Comp; V=$(cat parts/head_views.txt); B() { perl -e 'alarm 200; exec @ARGV' $HY $C/$1 "${@:2}" 2>&1 | grep -v Octane | tail -1 | cut -c1-110; }
rm -f parts/h4/sculpt.json parts/h4/cams.json
if [[ "$2" != "from3" ]]; then      # 2 November 2026 : RunHead.sh <folder> from3 keeps the base and rebuilds from the elements. FR : garde la base et reconstruit depuis les éléments.
rm -f parts/h1/sculpt.json parts/h1/cams.json parts/h2/sculpt.json parts/h2/cams.json
B ChainBuild.py parts/head_s1.json parts/h1
$PY -I $C/CompFit.py parts/h1 full/ep04 $V --mask grey --levels 1 --minutes 3 --fresh --cam-range 8 --centers 60 --brushes 0.5:0.03,0.3:0.02,0.18:0.012,0.1:0.007 --fair 40 2>&1 | grep -E '^score|Traceback' | cut -c1-260
B ChainBuild.py parts/head_s1.json parts/h1
B ChainBuild.py parts/head_s2.json parts/h2
$PY -I $C/CompFit.py parts/h2 full/ep04 "" --assembled $V --symmetric 1 --fixed parts/h3/out_ears.obj,parts/h3/out_teeth.obj --levels 1 --minutes 5 --fresh --cam-range 8 --centers 200 --brushes 0.18:0.012,0.1:0.007,0.06:0.004 --fair 120 2>&1 | grep -E '^score|Traceback' | cut -c1-260
B ChainBuild.py parts/head_s2.json parts/h2
fi
B HeadBuild.py parts/h2/part.obj parts/head_features.json parts/h3
cp parts/h2/cams.json parts/h3/cams.json
B ChainBuild.py parts/head_s4.json parts/h4
cp parts/h3/cams.json parts/h4/cams.json
$PY -I $C/CompFit.py parts/h4 full/ep04 "" --assembled $V --symmetric 1 --fixed parts/h3/out_ears.obj,parts/h3/out_teeth.obj --levels 0 --minutes ${HEAD_MINUTES:-9} --cam-range 8 --protect parts/h3/report.json --centers 220 --grey 6 --brushes 0.1:0.006,0.06:0.004,0.035:0.0025 --fair 80 --landmarks parts/read/lm.json --lm 14 2>&1 | grep -E '^score|Traceback' | cut -c1-260
B ChainBuild.py parts/head_s4.json parts/h4
python3 - <<'PY'
out = open("parts/h4/all.obj", "w"); off = 0
for f in ("parts/h4/part.obj", "parts/h3/out_teeth.obj", "parts/h3/out_ears.obj"):
    n = 0
    for l in open(f):
        if l.startswith("v "): out.write(l); n += 1
        elif l.startswith("f "): out.write("f " + " ".join(str(int(x.split("/")[0]) + off) for x in l.split()[1:]) + "\n")
    off += n
out.close()
PY
mkdir -p parts/h4v; cp parts/h4/all.obj parts/h4v/part.obj; cp parts/h4/cams.json parts/h4v/cams.json
$PY -I $C/PartBoard.py parts/h4v full/ep04 ${V} parts/h4v/board.png --mask grey --tile 300 2>&1 | tail -2 | cut -c1-520
# 2 November 2026 : the test that counts : views never used to build, their camera is polished, the shape is not touched. FR : le test qui compte : des vues jamais utilisées pour construire, leur caméra est polie, la forme n'est pas touchée.
U=$(cat parts/head_unseen.txt); cp parts/h4/cams.json parts/h4/cams_after_fit.json; echo UNSEEN; $PY -I $C/CompFit.py parts/h4 full/ep04 "" --symmetric 1 --fixed parts/h3/out_ears.obj,parts/h3/out_teeth.obj --assembled $U --levels 0 --check 1 --cam-range 8 2>&1 | grep -E '^score|Traceback' | cut -c1-300; cp parts/h4/overlay.png parts/h4/overlay_unseen.png
echo RUNHEAD_DONE
