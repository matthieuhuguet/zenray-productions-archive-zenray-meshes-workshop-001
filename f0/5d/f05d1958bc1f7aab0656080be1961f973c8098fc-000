def truth_curves(obj, nodes, parent, tol=0.3, ymin=7.8):
    # 3D truth on a synthetic instance : precision = share of the curve samples lying on the truth wood surface, recall = share of the truth wood samples within tol of the curve. FR : vérité 3D des courbes.
    from scipy.spatial import cKDTree
    import TruthScore as T
    tw = T.sample(W + "work/%s/topo_w_truth.npz" % obj, "branches", n=60000, ymin=ymin); cp = B.densify(nodes, parent, 0.1); cp = cp[cp[:, 1] > ymin]
    dc = cKDTree(tw).query(cp)[0]; dt = cKDTree(cp).query(tw)[0]; return {"truth_precision": round(float((dc < tol).mean()), 3), "truth_recall": round(float((dt < tol).mean()), 3), "truth_chamfer": round(float((dc.mean() + dt.mean()) / 2), 3)}


def setup(obj="tree", h=0.1, kmin=1, pair="max", comb="min"):
    V, R, A = B._views_with_arg(obj); RL = B.limb_map(R, A, kmin); root = np.array(V.ms["trunk"]["points"][-1], float); r_root = float(V.ms["trunk"]["radius"][-1])
    E, geo = B.evidence_volume(V, RL, h=h, y0=V.crown_base - 0.3, pair=pair, comb=comb); return V, RL, E, geo, root, r_root


def _vox(P, geo):
    x0, y0, z0, h = geo; return np.round((np.asarray(P, float) - np.array([x0, y0, z0])) / h).astype(int)


def _world(I, geo):
    x0, y0, z0, h = geo; return np.array([x0, y0, z0]) + np.asarray(I, float) * h


def chains_smooth(nodes, parent, h, step=0.35, s_fac=0.8):
    # one smoothing spline per chain between branch points and tips (car lesson : few control points, smooth by construction). FR : une spline lissée par tronçon.
    from scipy.interpolate import splprep, splev
    N = len(parent); kids = [[] for _ in range(N)]
    for i, p_ in enumerate(parent):
        if p_ >= 0: kids[p_].append(i)
    key = [i for i in range(N) if parent[i] < 0 or len(kids[i]) != 1]; out_n = []; out_p = []; ids = {}
    for k in key:
        if parent[k] < 0: ids[k] = len(out_n); out_n.append(nodes[k].copy()); out_p.append(-1)
    for k in key:                                     # walk the chain up from every key node (order : key nodes are processed parent first)
        pass
    order = []; st = [i for i in range(N) if parent[i] < 0]
    while st:
        i = st.pop(); order.append(i); st.extend(kids[i])
    keyset = set(key)
    for k in order:
        if parent[k] < 0: continue
        chain = [k]; c = parent[k]
        while c not in keyset: chain.append(c); c = parent[c]
        chain.append(c); chain = chain[::-1]; P = nodes[chain]; top = ids[c]
        if len(P) >= 5:
            try:
                tck, u = splprep(P.T, s=len(P) * (s_fac * h) ** 2, k=min(3, len(P) - 1)); L = float(np.sum(np.linalg.norm(np.diff(P, axis=0), axis=1))); n = max(int(L / step), 1)
                Q = np.array(splev(np.linspace(0, 1, n + 1), tck)).T; Q[0] = P[0]; Q[-1] = P[-1]
            except Exception: Q = P
        else: Q = P
        prev = top
        for j in range(1, len(Q)):
            out_n.append(Q[j].copy()); out_p.append(prev); prev = len(out_n) - 1
        ids[k] = prev
    return np.array(out_n), np.array(out_p)


def prune_spurs(nodes, parent, min_len=0.6):
    # delete leaf chains shorter than min_len (iterated once from the shortest). FR : élaguer les chicots.
    N = len(parent); kids = [[] for _ in range(N)]
    for i, p_ in enumerate(parent):
        if p_ >= 0: kids[p_].append(i)
    alive = np.ones(N, bool)
    for i in range(N):
        if kids[i] or parent[i] < 0: continue
        chain = [i]; c = parent[i]; L = 0.0
        while c >= 0 and len(kids[c]) == 1 and parent[c] >= 0: chain.append(c); c = parent[c]
        L = sum(np.linalg.norm(nodes[a] - nodes[parent[a]]) for a in chain if parent[a] >= 0)
        if L < min_len and c >= 0 and len(kids[c]) > 1: alive[chain] = False
    idx = -np.ones(N, int); idx[alive] = np.arange(alive.sum()); par = np.array([idx[parent[i]] if parent[i] >= 0 else -1 for i in range(N) if alive[i]]); return nodes[alive], par


def prune_subtree(nodes, parent, lmin):
    # keep a node only if the wood carried by its subtree (itself and all descendants) is at least lmin metres : monotone, no collapse. FR : garder ce qui porte au moins lmin de bois.
    N = len(parent); kids = [[] for _ in range(N)]
    for i, p_ in enumerate(parent):
        if p_ >= 0: kids[p_].append(i)
    order = []; st = [i for i in range(N) if parent[i] < 0]
    while st:
        i = st.pop(); order.append(i); st.extend(kids[i])
    sub = np.zeros(N)
    for i in reversed(order):
        sub[i] = sum(sub[k] + np.linalg.norm(nodes[k] - nodes[i]) for k in kids[i])
    alive = sub >= lmin; alive[[i for i in range(N) if parent[i] < 0]] = True; idx = -np.ones(N, int); idx[alive] = np.arange(alive.sum())
    return nodes[alive], np.array([idx[parent[i]] if parent[i] >= 0 else -1 for i in range(N) if alive[i]])


