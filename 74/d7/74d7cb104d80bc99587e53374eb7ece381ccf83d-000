"""29 October 2026 : ZenRay Lines JUNCTION VIEW : an orthographic picture of the network of a joined document, junction bridges in red, ring arcs of the open ends in blue, the rest grey, poles in green, crossings of two bridges in yellow.
    python -I ZrlJunctionView.py doc.json out.png [--view front|back|left|top] [--box x0,y0,x1,y1] [--size 1400]
FR : image orthographique du réseau : ponts en rouge, anneaux ouverts en bleu, pôles en vert, croisements de ponts en jaune."""
import argparse, json, os, sys
import numpy as np
from PIL import Image, ImageDraw
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import ZrlSpline as SP


def polyline(arc, n=24):
    C = np.asarray(arc["ctrl"], float)
    try: return SP.sample(C, n)
    except Exception: return C


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("doc"); ap.add_argument("out"); ap.add_argument("--view", default="front"); ap.add_argument("--box"); ap.add_argument("--size", type=int, default=1400); ap.add_argument("--labels", action="store_true"); a = ap.parse_args()
    d = json.load(open(a.doc)); N = {n["id"]: np.array(n["p"]) for n in d["nodes"]}; axes = {"front": (0, 1), "back": (0, 1), "left": (2, 1), "top": (0, 2)}[a.view]; sign = -1.0 if a.view == "back" else 1.0
    open_nodes = set(); [open_nodes.update(r["nodes"]) for t in d["tube_rings"].values() for e, r in ((("base", t["rings"][0]), ("top", t["rings"][-1]))) if e in t["open"]]
    pts = np.array(list(N.values())); u = sign * pts[:, axes[0]]; v = pts[:, axes[1]]
    if a.box: x0, y0, x1, y1 = [float(x) for x in a.box.split(",")]
    else: x0, x1, y0, y1 = u.min() - 0.03, u.max() + 0.03, v.min() - 0.03, v.max() + 0.03
    W = a.size; Hh = int(W * (y1 - y0) / (x1 - x0)); img = Image.new("RGB", (W, Hh), (18, 18, 22)); dr = ImageDraw.Draw(img)
    P = lambda p: ((sign * p[axes[0]] - x0) / (x1 - x0) * W, Hh - (p[axes[1]] - y0) / (y1 - y0) * Hh)
    bridge_pair = {n for n in d["component_options"] if n.startswith("junction_")}
    segs_red = []
    for arc in d["arcs"]:
        col = (90, 90, 100); w = 1
        if arc["pair"][0] in bridge_pair: col = (255, 70, 60); w = 3
        elif arc["a"] in open_nodes and arc["b"] in open_nodes: col = (70, 150, 255); w = 3
        line = [P(p) for p in polyline(arc)]; dr.line(line, fill=col, width=w)
        if arc["pair"][0] in bridge_pair: segs_red.append((arc["id"], [np.array(p) for p in line]))
    def inter(p, q, r, s):
        d1, d2 = q - p, s - r; den = d1[0] * d2[1] - d1[1] * d2[0]
        if abs(den) < 1e-9: return None
        t = ((r - p)[0] * d2[1] - (r - p)[1] * d2[0]) / den; k = ((r - p)[0] * d1[1] - (r - p)[1] * d1[0]) / den
        return p + t * d1 if 0 < t < 1 and 0 < k < 1 else None
    cross = 0
    for i in range(len(segs_red)):
        for j in range(i + 1, len(segs_red)):
            ai, li = segs_red[i]; aj, lj = segs_red[j]
            A, B = d["arcs"][ai], d["arcs"][aj]
            if {A["a"], A["b"]} & {B["a"], B["b"]}: continue
            hit = None
            for k in range(len(li) - 1):
                for m in range(len(lj) - 1):
                    x = inter(li[k], li[k + 1], lj[m], lj[m + 1])
                    if x is not None: hit = x; break
                if hit is not None: break
            if hit is not None: cross += 1; dr.ellipse([hit[0] - 7, hit[1] - 7, hit[0] + 7, hit[1] + 7], outline=(255, 230, 0), width=3)
    for nid, p in N.items():
        if nid >= max(N) - 5 and nid in N and d["nodes"][nid] and nid >= len(d["nodes"]) - 6: x, y = P(p); dr.ellipse([x - 8, y - 8, x + 8, y + 8], fill=(60, 220, 100))
    if a.labels:
        for nid, p in N.items():
            x, y = P(p)
            if 0 <= x < W and 0 <= y < Hh: dr.ellipse([x - 3, y - 3, x + 3, y + 3], fill=(240, 240, 240)); dr.text((x + 5, y - 5), str(nid), fill=(255, 255, 120))
    img.save(a.out); print(a.out, "bridge crossings in this view", cross)


if __name__ == "__main__":
    main()
