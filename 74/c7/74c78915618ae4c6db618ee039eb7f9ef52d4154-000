    python -I MicroOutline.py Projects/<id>/params.json out.png view:x0:x1:y0:y1 [view:x0:x1:y0:y1 ...]        (panel pixels)"""
import sys
import numpy as np
from PIL import Image
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts/micro"); import MicroCommon as C


def strip(p, home, v, x0, x1, y0, y1, sc, source):
    rgb = C.panel_rgb(p, v); L = np.load(f"{home}/02_masks/{source}_{v}.npz")["labels" if source == "labels" else "regions"][y0 * sc:y1 * sc, x0 * sc:x1 * sc]; R = np.asarray(Image.fromarray(rgb[y0:y1, x0:x1]).resize((L.shape[1], L.shape[0]), Image.LANCZOS)).copy(); O = R.copy(); b = np.zeros(L.shape, bool); b[:, 1:] |= L[:, 1:] != L[:, :-1]; b[1:, :] |= L[1:, :] != L[:-1, :]; R[b] = (255, 40, 40); R[L < 0] = (R[L < 0] * 0.35 + np.array([0, 60, 160]) * 0.65).astype(np.uint8); return np.vstack([O, R, np.full((6, L.shape[1], 3), 255, np.uint8)])


def main(params, out, crops, source="labels"):
    p, home = C.load(params); sc = p["scale"]; rows = []
    for c in crops: v, *n = c.split(":"); rows.append(strip(p, home, v, *[int(x) for x in n], sc, source))
    W = max(r.shape[1] for r in rows); Image.fromarray(np.vstack([np.pad(r, ((0, 0), (0, W - r.shape[1]), (0, 0)), constant_values=255) for r in rows])).save(out); print(out)


def board(params):
    """all the views with their finished borders over the reference, at full size : 06_checks/borders_finished.png"""
    p, home = C.load(params); tiles = []
    for v in p["views"]:
        L = np.load(f"{home}/02_masks/labels_{v}.npz")["labels"]; R = np.asarray(Image.fromarray(C.panel_rgb(p, v)).resize((L.shape[1], L.shape[0]), Image.LANCZOS)).copy(); b = np.zeros(L.shape, bool); b[:, 1:] |= L[:, 1:] != L[:, :-1]; b[1:, :] |= L[1:, :] != L[:-1, :]; R[b] = (255, 50, 40); tiles.append(R)
    C.save_board(tiles, f"{home}/06_checks/borders_finished.png"); print("borders_finished.png")


if __name__ == "__main__" and len(sys.argv) == 3 and sys.argv[2] == "board": board(sys.argv[1]); sys.exit(0)
if __name__ == "__main__":
    a = [x for x in sys.argv[3:] if not x.startswith("--")]; main(sys.argv[1], sys.argv[2], a, "regions" if "--regions" in sys.argv else "labels")
