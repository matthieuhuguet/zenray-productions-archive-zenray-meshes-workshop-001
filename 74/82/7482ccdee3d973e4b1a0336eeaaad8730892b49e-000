"""Pente d'intensité par facette dans les rendus argile synthétiques selon la distance de la lumière ponctuelle (à comparer à la planche réelle : 5 à 28 niveaux par 100 pixels). 30 October 2026."""
import sys, json
import numpy as np
sys.path.insert(0, ".")
from e2_common import *
out = {}
case = make_case()
for dist in (6.0, 12.0, 25.0):
    imgs = clay_from_views(case["views"], light_dist=dist)
    sl = []
    for nm in ("left", "top", "front"):
        v = case["views"][nm]; fid = v["fid"]; I = imgs[nm]
        for f in np.unique(fid[fid >= 0]):
            ys, xs = np.where(fid == f)
            if len(ys) < 400: continue
            X = np.c_[xs, ys, np.ones_like(xs)].astype(float); c, *_ = np.linalg.lstsq(X, I[ys, xs], rcond=None)
            sl.append(float(np.hypot(c[0], c[1]) * 100 * 255))
    out[str(dist)] = {"median_levels_per_100px": float(np.median(sl)), "p90": float(np.percentile(sl, 90)), "facets": len(sl)}
    print(dist, out[str(dist)])
json.dump(out, open("out/light_gradient_check.json", "w"), indent=1)
