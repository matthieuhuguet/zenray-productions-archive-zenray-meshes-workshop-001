def view_cost(m, r): x = m ^ r["mask"]; return float(r["weight"][x].sum()) / r["area"]


def grey_cost(S, key, r, cam, fov, coef):
    """silhouette and inner grey together : the inner forms are what a silhouette cannot see. FR : silhouette et gris intérieur ensemble : les formes intérieures sont ce qu'une silhouette ne voit pas."""
