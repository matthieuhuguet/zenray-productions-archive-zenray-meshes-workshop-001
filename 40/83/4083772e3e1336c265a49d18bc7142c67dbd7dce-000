    if p["kind"] == "pos": t["pts"][p["i"]][p["ax"]] += d
    elif p["kind"] == "ramp": t["ramp"][p["i"]][1] = max(t["ramp"][p["i"]][1] + d, 0.002)
    elif p["kind"] == "shift":
