            if "_pts0" in t: t["_pts0"] = [[float(c_[k] + (q[k] - c_[k]) * (1 + d)) for k in range(3)] for q in t["_pts0"]]; t["_ramp0"] = [v * (1 + d) for v in t["_ramp0"]]
