    ap = argparse.ArgumentParser(); ap.add_argument("quads", nargs="?"); ap.add_argument("ref", nargs="?"); ap.add_argument("--json", action="store_true"); ap.add_argument("--selftest", action="store_true"); a = ap.parse_args()
    if a.selftest: sys.exit(0 if selftest() else 1)
