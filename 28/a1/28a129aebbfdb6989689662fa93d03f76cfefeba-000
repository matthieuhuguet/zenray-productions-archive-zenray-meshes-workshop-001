# 25 October 2026 : test M10 fusion with the TRUE spans and with the M09 fitted spans.
import sys, os, json, numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import Methods as M, Bench
obj = sys.argv[1]; vd = '../benchmark/views/%s' % obj; gt = '../benchmark/gt/%s.obj' % obj
true = {v: float(np.nanmax(np.load(f'{vd}/depth_{v}.npy')) - np.nanmin(np.load(f'{vd}/depth_{v}.npy'))) for v in M.VIEWS_ORDER}
fit = json.load(open(f'../benchmark/m09/{obj}.log.json'))['result']['spans']
for name, sp in (('true', true), ('fit', fit)):
    for tv in (2.0, 4.0, 8.0):
        out = f'../benchmark/m09/{obj}_tsdf_{name}_{tv}.obj'
        M.m10_tsdf_fusion(vd, out, sp, n=320, trunc_vox=tv)
        sc = Bench.score(out, gt, vd)
        print(obj, name, 'trunc', tv, 'F0.5 %.3f F1 %.3f' % (sc['fscore_0.005'], sc['fscore_0.01']), flush=True)
