"""Pass 8 : synthetic triangle meshes for the experiments (sphere, torus, bumpy potato, curved band, synthetic arch,
bent tube with caps, L bracket). Written 30 October 2026. Usage : python3 -I zr8_meshes.py out_dir
FR : maillages synthetiques de test, tous fabriques ici, sans donnees externes."""
import sys, os
import numpy as np
import trimesh
from shapely.geometry import Polygon


def sphere(subdiv=4, radius=1.0):
    m = trimesh.creation.icosphere(subdivisions=subdiv, radius=radius)
    return m.vertices.copy(), m.faces.copy()


def torus(R=1.0, r=0.35, n=64, m=32):
    t = trimesh.creation.torus(R, r, major_sections=n, minor_sections=m)
    return t.vertices.copy(), t.faces.copy()


def potato(subdiv=4, seed=7):
    rng = np.random.default_rng(seed)
    V, F = sphere(subdiv)
    # smooth radial bumps : a few low frequency random cosines
    d = V / np.linalg.norm(V, axis=1, keepdims=True)
    f = np.zeros(len(V))
    for _ in range(6):
        k = rng.normal(size=3); k /= np.linalg.norm(k); w = rng.uniform(1.5, 3.5); ph = rng.uniform(0, 6.28)
        f += rng.uniform(0.04, 0.10) * np.cos(w * (d @ k) * 3.14159 + ph)
    V = d * (1.0 + f)[:, None] * np.array([1.0, 0.8, 1.25])
    return V, F


def curved_band(radius=1.0, sweep_deg=240.0, height=0.35, nu=120, nv=18, bump=0.06):
    """Open surface : a strip bent along a circular arc with a gentle sinusoidal bump. Has a boundary of one loop."""
    u = np.linspace(0, np.radians(sweep_deg), nu); v = np.linspace(-height / 2, height / 2, nv)
    U, Vv = np.meshgrid(u, v, indexing="ij")
    rad = radius + bump * np.sin(3 * U) * np.cos(np.pi * Vv / height)
    X = np.stack([rad * np.cos(U), rad * np.sin(U), Vv], axis=-1).reshape(-1, 3)
    F = []
    for i in range(nu - 1):
        for j in range(nv - 1):
            a = i * nv + j; b = (i + 1) * nv + j; c = (i + 1) * nv + j + 1; d = i * nv + j + 1
            F += [[a, b, c], [a, c, d]]
    return X, np.array(F)


def extrude(poly_pts, depth, holes=None):
    p = Polygon(poly_pts, holes or [])
    m = trimesh.creation.extrude_polygon(p, depth)
    return m.vertices.copy(), m.faces.copy()


def arch(R_out=1.0, R_in=0.7, leg=0.6, depth=0.5, n=40):
    """Synthetic arch : half annulus on top of two straight legs, extruded along z. True sharp edges."""
    th = np.linspace(0, np.pi, n)
    outer = [(R_out * np.cos(t), leg + R_out * np.sin(t)) for t in th]
    inner = [(R_in * np.cos(t), leg + R_in * np.sin(t)) for t in th[::-1]]
    pts = [(R_out, 0.0)] + outer + [(-R_out, 0.0), (-R_in, 0.0)] + inner + [(R_in, 0.0)]
    # remove duplicate consecutive points
    clean = [pts[0]]
    for p in pts[1:]:
        if np.hypot(p[0] - clean[-1][0], p[1] - clean[-1][1]) > 1e-9:
            clean.append(p)
    return extrude(clean, depth)


def bracket(a=1.0, b=0.35, c=1.0, depth=0.4):
    pts = [(0, 0), (a, 0), (a, b), (b, b), (b, c), (0, c)]
    return extrude(pts, depth)


def bent_tube(radius=0.2, length=2.0, bend_deg=90.0, nu=96, nv=24, taper=0.25):
    """Tube following a circular arc, closed by two flat disc caps triangulated as fans around a centre vertex."""
    s = np.linspace(0, 1, nu); Rb = length / np.radians(bend_deg)
    ang = s * np.radians(bend_deg)
    C = np.stack([Rb * np.sin(ang), Rb * (1 - np.cos(ang)), 0 * s], axis=1)
    T = np.stack([np.cos(ang), np.sin(ang), 0 * s], axis=1)
    N = np.stack([-np.sin(ang), np.cos(ang), 0 * s], axis=1); B = np.array([0, 0, 1.0])
    r = radius * (1.0 - taper * s)
    phi = np.linspace(0, 2 * np.pi, nv, endpoint=False)
    V = []
    for i in range(nu):
        for ph in phi:
            V.append(C[i] + r[i] * (np.cos(ph) * N[i] + np.sin(ph) * B))
    V = np.array(V); F = []
    for i in range(nu - 1):
        for j in range(nv):
            a = i * nv + j; b = i * nv + (j + 1) % nv; c = (i + 1) * nv + (j + 1) % nv; d = (i + 1) * nv + j
            F += [[a, d, c], [a, c, b]]
    for end, flip in ((0, True), (nu - 1, False)):
        cidx = len(V); V = np.vstack([V, C[end][None]])
        for j in range(nv):
            a = end * nv + j; b = end * nv + (j + 1) % nv
            F.append([cidx, b, a] if flip else [cidx, a, b])
    return np.array(V), np.array(F)


ALL = {"sphere": sphere, "torus": torus, "potato": potato, "band": curved_band, "arch": arch, "bracket": bracket, "tube": bent_tube}

if __name__ == "__main__":
    out = sys.argv[1]; os.makedirs(out, exist_ok=True)
    for name, fn in ALL.items():
        V, F = fn()
        m = trimesh.Trimesh(V, F, process=True)
        if name in ("arch", "bracket"):
            m = m.subdivide_to_size(max_edge=0.04)   # coarse extrusions : refine so that the remesher has a mesh to work with
        m.fix_normals()
        with open(os.path.join(out, name + ".obj"), "w") as f:
            for p in m.vertices: f.write("v %.9g %.9g %.9g\n" % tuple(p))
            for t in m.faces: f.write("f %d %d %d\n" % (t[0] + 1, t[1] + 1, t[2] + 1))
        print(name, len(m.vertices), len(m.faces), "watertight" if m.is_watertight else "open", "euler", m.euler_number)
