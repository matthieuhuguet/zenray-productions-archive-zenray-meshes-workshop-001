# 25 October 2026 : ZenRay Meshes, per column gap between the reference mask and the reproduction mask of one view
# (top edge and bottom edge, in metres, signed: + means the reproduction must go UP / OUT). Uses SheetScore's camera.
# FR : écart par colonne entre masque de référence et reproduction, bord haut et bas, en mètres.
# Usage: python ProfileGap.py <frame_dir> <mesh.obj> <view> [step_px=20]
import sys, os, json
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np, trimesh
from PIL import Image
import Raster
from SheetScore import render_in_panel

def main(fdir, mesh_path, view, step=20):
    meta = json.load(open(os.path.join(fdir, "frame.json"))); v = [x for x in meta["views"] if x["name"] == view][0]
    mref = np.asarray(Image.open(os.path.join(fdir, "mask_%s.png" % view))) > 127
    m = trimesh.load(mesh_path, force="mesh", process=False); r = Raster.Renderer(m.vertices, m.faces)
    M, _ = render_in_panel(r, meta, v, mref.shape); r.release(); s = v["px_per_m"]
    def edges(A):
        t = np.where(A.any(0), A.argmax(0), -1); b = np.where(A.any(0), A.shape[0] - 1 - A[::-1].argmax(0), -1); return t, b
    tr, br = edges(mref); tm, bm = edges(M); out = []
    for x in range(0, mref.shape[1], int(step)):
        if tr[x] < 0 or tm[x] < 0: continue
        out.append({"px": x, "top_m": round((tm[x] - tr[x]) / s, 4), "bot_m": round((br[x] - bm[x]) / s, 4)})
    print(json.dumps(out))

if __name__ == "__main__":
    main(*sys.argv[1:])
