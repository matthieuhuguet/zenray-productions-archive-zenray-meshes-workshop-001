# 28 October 2026 14:52 Paris: editable preliminary cape surface for comparison with the reference.
import hou, math
node = hou.pwd()
geo = node.geometry()
rows = node.evalParm('rows')
columns = node.evalParm('columns')
width_top = node.evalParm('width_top')
width_bottom = node.evalParm('width_bottom')
height = node.evalParm('height')
fold_depth = node.evalParm('fold_depth')
center_top = node.evalParm('center_top')
center_bottom = node.evalParm('center_bottom')
top_y = node.evalParm('top_y')
back_z = node.evalParm('back_z')
points = []
for row in range(rows + 1):
    v = row / rows
    width = width_top * (1-v) + width_bottom * v
    for col in range(columns + 1):
        u = col / columns
        point = geo.createPoint()
        x = center_top*(1-v)+center_bottom*v+(u-.5)*width
        y = top_y-v*height
        z = back_z-fold_depth*v*math.cos(u*math.pi*6)
        if node.evalParm('follow_upper'):
            upper = node.parent().node('cape_surface_v001')
            upper_v = max(0.0, min(1.0, (upper.evalParm('top_y')-y)/upper.evalParm('height')))
            upper_width = upper.evalParm('width_top')*(1-upper_v)+upper.evalParm('width_bottom')*upper_v
            upper_center = upper.evalParm('center_top')*(1-upper_v)+upper.evalParm('center_bottom')*upper_v
            upper_u = max(0.0, min(1.0, (x-upper_center)/upper_width + .5))
            upper_z = upper.evalParm('back_z')-upper.evalParm('fold_depth')*upper_v*math.cos(upper_u*math.pi*6)
            z = upper_z-node.evalParm('layer_gap')
        point.setPosition((x,y,z))
        points.append(point)
for row in range(rows):
    for col in range(columns):
        polygon = geo.createPolygon()
        for index in (row*(columns+1)+col, row*(columns+1)+col+1, (row+1)*(columns+1)+col+1, (row+1)*(columns+1)+col):
            polygon.addVertex(points[index])
