"""2 November 2026 : each part goes into the whole by a size and a translation solved from its own anchors : the same points known in the part and in the bundle of the whole dragon. No descent, no grid. FR : chaque partie entre dans l'ensemble par une taille et une translation calculées depuis ses propres repères : les mêmes points connus dans la partie et dans le calcul commun du dragon entier.
    python -I PlaceByAnchors.py <bundle.json> <sets.json> <out.json>      sets.json : {"sets": [{"name", "tubes", "anchors": {"world point": [x, y, z in the part]}, "free_x": false}]}"""
import sys, json
import numpy as np
B = json.load(open(sys.argv[1]))["points"]; SETS = json.load(open(sys.argv[2]))["sets"]; placed = []
def fit(pairs, free_x):
    A = np.array([p for p, _ in pairs], float); W = np.array([w for _, w in pairs], float)
    for i, n in enumerate(pairs): pass
    cA, cW = A.mean(0), W.mean(0); s = float(((A - cA) * (W - cW)).sum() / max(((A - cA) ** 2).sum(), 1e-9)); t = cW - s * cA
    if not free_x: t[0] = 0.0
    return s, t, float(np.sqrt((((A * s + t) - W) ** 2).sum(1).mean()))
for st in SETS:
    pr = []
    for name, p in st["anchors"].items():
        w = list(B[name])
        if name.startswith("c_"): w[0] = 0.0
        pr.append((p, w))
    s, t, e = fit(pr, st.get("free_x", False)); print(f'{st["name"]:8s} size {s:.3f} shift {np.round(t, 3).tolist()} anchor error {e:.3f}')
    for b in st["tubes"]:
        n = json.loads(json.dumps(b))
        if n.get("kind") == "obj": n["xform"] = [float(t[0]), float(t[1]), float(t[2]), s]
        else:
            n["pts"] = [[float(q[k] * s + t[k]) for k in range(3)] for q in b["pts"]]
            if n.get("kind") != "sheet": n["radius"] = b.get("radius", 1.0) * s
        placed.append(n)
json.dump(dict(tubes=placed, groups=[[t["name"] for t in st["tubes"]] for st in SETS]), open(sys.argv[3], "w"), indent=0)
