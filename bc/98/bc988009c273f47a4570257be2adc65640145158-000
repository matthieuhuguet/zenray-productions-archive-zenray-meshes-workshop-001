"""31 October 2026 : the common judge for a wheel written by WheelRef.py or WheelFromCar.py : per part sides, open edges, non manifold edges, smallest scaled Jacobian, signed volume (positive = normals outward).
    python -I WheelJudge.py dir_with_obj_files        FR : le juge commun d'une roue, par pièce."""
import sys, glob, os
import numpy as np
from collections import Counter
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts/retopo"); import ZrrCheck as K
def read(path):
    V = []; F = []
    for l in open(path):
        if l.startswith("v "): V.append([float(x) for x in l.split()[1:4]])
        elif l.startswith("f "): F.append([int(x.split("/")[0]) - 1 for x in l.split()[1:]])
    return np.array(V), F
for f in sorted(glob.glob(sys.argv[1] + "/*.obj") + glob.glob(sys.argv[1] + "/parts/*.obj")):
    n = os.path.basename(f)
    if len(sys.argv) < 3 and (n in ("wheel.obj", "dish.obj", "rim_band.obj") or n.startswith("wheel_")): continue      # pass any second argument to judge every file
    V, F = read(f); E = Counter()
    for q in F:
        for a, b in zip(q, q[1:] + q[:1]): E[(min(a, b), max(a, b))] += 1
    Q = np.array([q for q in F if len(q) == 4]); J = K.scaled_jacobian(V, Q)
    vol = sum(np.dot(V[q[0]], np.cross(V[q[k]], V[q[k + 1]])) / 6 for q in F for k in range(1, len(q) - 1))
    print(f"{n:22s} faces {len(F):5d} sides {dict(Counter(len(q) for q in F))} open {sum(1 for c in E.values() if c == 1)} nonmanifold {sum(1 for c in E.values() if c > 2)} jac_min {J.min():.3f} volume {vol:+.5f}")
