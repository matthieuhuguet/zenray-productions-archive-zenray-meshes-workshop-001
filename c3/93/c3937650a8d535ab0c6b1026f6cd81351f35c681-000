import sys, os, json, numpy as np, shutil
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); import qw6, q3, q3run, q3b
def forced(mesh, axis, frac):
    V, F0 = q3.loadobj(f"{qw6.GT}/{mesh}.obj"); V = np.array(V); F = [[f[0], f[k], f[k + 1]] for f in F0 for k in range(1, len(f) - 1)]
    os.makedirs("car", exist_ok=True); q3b.write_obj(f"car/{mesh}_tri.obj", V, F); src = os.path.abspath(f"car/{mesh}_tri.obj")
    cen = np.array([V[f].mean(0)[axis] for f in F]); c0 = V[:, axis].min() + frac * (V[:, axis].max() - V[:, axis].min()); gof = ["A" if c > c0 else "B" for c in cen]
    d = f"car/{mesh}_split"; os.makedirs(d, exist_ok=True); sh = os.path.abspath(f"{d}/features.sharp"); n = q3.write_sharp(sh, F, gof, V); out = {"mesh": mesh, "axis": axis, "plane": round(float(c0), 4), "sharp_edges": n}
    for tag, kw, extra in [("auto35", {}, None), ("organic", dict(sharp_feature_thr=-1), None), ("forced35", {}, sh), ("forced_org", dict(sharp_feature_thr=-1), sh)]:
        r, o = q3run.run_case(f"{mesh}_{tag}", src, kw, extra=extra, num=8, ref=f"{qw6.GT}/{mesh}.obj")
        if o and os.path.exists(o):
            Vq, Fq = q3.loadobj(o); Q = np.array([f for f in Fq if len(f) == 4]); r["border"] = q3b.border_report(Vq, Q, V, F, gof)
        out[tag] = {k: r.get(k) for k in ("stage12_s", "seconds", "patches", "quads", "folded_share", "squashed_share", "poles_per_1000_quads", "border", "fail12", "no_output")}
    return out
if __name__ == "__main__":
    print(json.dumps(forced(sys.argv[1], int(sys.argv[2]), float(sys.argv[3])), indent=1))
