# 27 October 2026: Pure Transformers/Lego Component_Roof built from 3D reference curves
import hou, numpy as np

geo = hou.pwd().geometry()
geo.clear()

# 1. Measured 3D Profile Curves from 6 views (Rear Header to Windshield Header)
measured_z = np.array([-1.015, -0.776, -0.537, -0.298, -0.059, 0.180, 0.385])
measured_x = np.array([0.577, 0.580, 0.586, 0.603, 0.622, 0.622, 0.525])
measured_yc = np.array([1.266, 1.309, 1.339, 1.349, 1.338, 1.303, 1.230])
measured_ye = np.array([1.218, 1.262, 1.293, 1.302, 1.287, 1.248, 1.210])

num_u = 9 # 9 rows along Z
z_pts = np.linspace(-1.015, 0.385, num_u)
num_v = 5 # 5 control columns across X

x_edges = np.interp(z_pts, measured_z, measured_x)
yc_centers = np.interp(z_pts, measured_z, measured_yc)
ye_edges = np.interp(z_pts, measured_z, measured_ye)

surf = geo.createNURBSSurface(num_v, num_u)

for i in range(num_u):
    z = float(z_pts[i])
    xe = float(x_edges[i])
    yc = float(yc_centers[i])
    ye = float(ye_edges[i])
    xc = float(xe * 0.5)
    y_mid = float(yc + (ye - yc) * 0.25)
    v_pts = [
        (-xe, ye, z),
        (-xc, y_mid, z),
        (0.0, yc, z),
        (xc, y_mid, z),
        (xe, ye, z)
    ]
    for j in range(num_v):
        surf.vertex(i, j).point().setPosition(hou.Vector3(*v_pts[j]))
