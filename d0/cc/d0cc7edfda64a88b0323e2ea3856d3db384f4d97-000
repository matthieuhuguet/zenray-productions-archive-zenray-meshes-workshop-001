import os, shutil, sys
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import QwParts as QP
src, out, target = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2]), int(sys.argv[3]); kind = sys.argv[4] if len(sys.argv) > 4 else "organic"
os.makedirs(out, exist_ok=True); V, G = QP.groups(src, set()); tri = os.path.join(out, "part.obj")
faces = []; Vl = []
for l in open(src):
    t = l.split()
    if t and t[0] == "v": Vl.append(t[1:4])
    elif t and t[0] == "f": faces.append([int(x.split("/")[0]) - 1 for x in t[1:]])
