"""30 October 2026 : ZenRay Meshes : error of a quad mesh against the EXACT surface points of the synthetic faceted car (FacetCarBench.py) : one sided distance mesh to truth (mean, p95, p99) and truth to mesh, in mm. Same bias before and after a finish, so the difference is the change in fidelity.
    python -I FacetCarEval.py quads.obj truth_points.npz
FR : erreur d'un maillage de quads contre les points exacts de la voiture facettee de verite."""
import sys
import numpy as np
from scipy.spatial import cKDTree


def main():
    V = []; Q = []
    for l in open(sys.argv[1]):
        if l.startswith("v "): V.append([float(x) for x in l.split()[1:4]])
        elif l.startswith("f "):
            f = [int(x.split("/")[0]) - 1 for x in l.split()[1:]]
            if len(f) == 4: Q.append(f)
    V = np.array(V); Q = np.array(Q); T = np.load(sys.argv[2])["pts"]
    S = np.vstack([V[Q].mean(1), V[Q[:, :2]].mean(1), V[Q[:, 1:3]].mean(1), V[np.unique(Q)]]); d1 = cKDTree(T).query(S)[0] * 1000; d2 = cKDTree(S).query(T)[0] * 1000
    print("mesh->truth mm : mean %.2f p95 %.2f p99 %.2f | truth->mesh mm : mean %.2f p95 %.2f p99 %.2f | quads %d" % (d1.mean(), np.percentile(d1, 95), np.percentile(d1, 99), d2.mean(), np.percentile(d2, 95), np.percentile(d2, 99), len(Q)))


if __name__ == "__main__": main()
