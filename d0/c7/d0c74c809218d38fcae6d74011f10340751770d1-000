{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenray.local/schemas/cmy2-component-contract.v2.json",
  "title": "ZenRay Meshes 2.0 Component Contract (CMY 2.0 -> Houdini -> /zenray-uv -> /zenray-height)",
  "description": "Contrat unifié par composant reliant l'isolation 5 vues, les couches CMY 2.0 (Cyan, Magenta, Yellow, Pin), les attributs géométriques Houdini pure-quad, le dépliage /zenray-uv M1 et les 5 cartes procédurales /zenray-height (Copernicus).",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "component_id",
    "archetype",
    "views_iso_gate",
    "cmy2_layers",
    "houdini_contract",
    "uv_bridge",
    "height_bridge",
    "verification_lamps"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "project": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
    "component_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
    "archetype": {
      "type": "string",
      "enum": ["A_shell", "B_pocket_hardsurface", "C_organic_limb", "D_tree_cards"]
    },
    "views_iso_gate": {
      "type": "object",
      "required": ["view_count", "scanline_err_px", "bottom_top_iou", "passed"],
      "properties": {
        "view_count": { "type": "integer", "minimum": 4, "maximum": 8 },
        "scanline_err_px": { "type": "number", "minimum": 0 },
        "bottom_top_iou": { "type": "number", "minimum": 0, "maximum": 1 },
        "silhouette_leak_tolerance_px": { "type": "integer", "minimum": 1 },
        "passed": { "type": "boolean" }
      }
    },
    "cmy2_layers": {
      "type": "object",
      "required": ["magenta_contours", "cyan_flow_ribs", "yellow_features", "recess_pockets"],
      "properties": {
        "magenta_contours": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "closed", "pts", "corner_flags"],
            "properties": {
              "id": { "type": "string" },
              "closed": { "type": "boolean" },
              "pts": {
                "type": "array",
                "minItems": 3,
                "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
              },
              "corner_flags": { "type": "array", "items": { "type": "boolean" } }
            }
          }
        },
        "cyan_flow_ribs": {
          "type": "object",
          "required": ["solver", "crossing_count", "curves"],
          "properties": {
            "solver": { "enum": ["laplace_streamline", "bishop_frame", "da_vinci_branch"] },
            "crossing_count": { "type": "integer", "const": 0 },
            "curves": { "type": "array", "items": { "type": "array" } }
          }
        },
        "yellow_features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "mode", "sign", "fwhm_weight", "pts", "user_editable"],
            "properties": {
              "id": { "type": "string" },
              "mode": { "enum": ["crisp", "smooth"] },
              "sign": { "enum": ["ridge", "valley"] },
              "fwhm_weight": { "type": "number", "minimum": 0.05, "maximum": 1.0 },
              "pts": { "type": "array", "minItems": 2 },
              "user_editable": { "const": true }
            }
          }
        },
        "recess_pockets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bbox", "area_px", "min_inset_px", "class"],
            "properties": {
              "bbox": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer" } },
              "area_px": { "type": "integer", "minimum": 1 },
              "min_inset_px": { "type": "number", "minimum": 0 },
              "class": { "enum": ["slot_recess", "bevel_groove", "through_hole"] }
            }
          }
        },
        "selection_pins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "view", "xy", "radius_px"],
            "properties": {
              "kind": { "enum": ["keep", "drop"] },
              "view": { "type": "string" },
              "xy": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
              "radius_px": { "type": "number", "minimum": 1 }
            }
          }
        }
      }
    },
    "houdini_contract": {
      "type": "object",
      "required": ["solver", "pure_quads", "non_manifold_edges", "min_scaled_jacobian", "prim_attrs", "edge_groups"],
      "properties": {
        "solver": { "enum": ["milp_coons_blocks", "bishop_sweep", "da_vinci_foliage_cards"] },
        "pure_quads": { "type": "boolean", "const": true },
        "non_manifold_edges": { "type": "integer", "const": 0 },
        "min_scaled_jacobian": { "type": "number", "minimum": 0.25, "maximum": 1.0 },
        "prim_attrs": {
          "type": "object",
          "required": ["name", "zrm_archetype", "zrm_mat_family", "zrm_grid_uv"],
          "properties": {
            "name": { "type": "string" },
            "zrm_archetype": { "type": "string" },
            "zrm_mat_family": {
              "enum": ["brushed_metal", "painted_armor", "skin_subsurface", "bark_wood", "foliage_card", "leather_cloth"]
            },
            "zrm_grid_uv": { "type": "boolean" }
          }
        },
        "edge_groups": {
          "type": "object",
          "required": ["zrm_seam_suggest", "creaseweight"],
          "properties": {
            "zrm_seam_suggest": { "type": "integer", "minimum": 0 },
            "creaseweight": { "type": "string" }
          }
        }
      }
    },
    "uv_bridge": {
      "type": "object",
      "required": ["skill", "method", "guided_by_cmy", "target_score", "island_straightness"],
      "properties": {
        "skill": { "const": "zenray-uv" },
        "method": { "const": "M1_artist_cut" },
        "guided_by_cmy": { "type": "boolean", "const": true },
        "target_score": { "type": "number", "minimum": 0.99 },
        "island_straightness": { "type": "boolean" }
      }
    },
    "height_bridge": {
      "type": "object",
      "required": ["skill", "engine", "maps", "packed_orm"],
      "properties": {
        "skill": { "const": "zenray-height" },
        "engine": { "const": "Copernicus" },
        "maps": {
          "type": "array",
          "contains": { "enum": ["BaseColor", "Normal", "Height", "Roughness", "AO"] },
          "minItems": 5
        },
        "packed_orm": { "type": "boolean" },
        "normal_convention": { "enum": ["OpenGL", "DirectX"] }
      }
    },
    "verification_lamps": {
      "type": "object",
      "required": ["isolate_5v", "cmy2_edit", "houdini_3d", "uv_and_height"],
      "properties": {
        "isolate_5v": { "enum": ["ok", "warn", "bad"] },
        "cmy2_edit": { "enum": ["ok", "warn", "bad"] },
        "houdini_3d": { "enum": ["ok", "warn", "bad"] },
        "uv_and_height": { "enum": ["ok", "warn", "bad"] }
      }
    }
  }
}
