# 25 October 2026 : export a Houdini SOP with its "name" primitive attribute to an npz (points, triangles, name id per
# triangle, names) for colour coded component views. Run in Houdini with g = {"SOP": path, "OUT": npz}.
import hou, numpy as np
geo = hou.node(globals()["SOP"]).geometry()
P = np.array(geo.pointFloatAttribValues("P"), np.float32).reshape(-1, 3)
names = list(geo.primStringAttribValues("name")) if geo.findPrimAttrib("name") else [""] * len(geo.prims())
uniq = sorted(set(names)); idx = {n: i for i, n in enumerate(uniq)}
tri, tid = [], []
for p, n in zip(geo.prims(), names):
    vs = [v.point().number() for v in p.vertices()]
    for k in range(1, len(vs) - 1): tri.append((vs[0], vs[k], vs[k + 1])); tid.append(idx[n])
np.savez(globals()["OUT"], P=P, F=np.array(tri, np.int32), T=np.array(tid, np.int32), names=np.array(uniq))
result = {"points": len(P), "tris": len(tri), "names": len(uniq)}
