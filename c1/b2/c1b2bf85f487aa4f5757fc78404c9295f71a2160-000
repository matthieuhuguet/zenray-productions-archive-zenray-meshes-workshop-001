"""30 October 2026 : ZenRay Lines PALETTE : the pale colour of every component, read from the one palette file of the editor (lines/palette.json), so a render shows the same zones as the app : legs pale green, torso blue, arms pale red, head pale violet, a lighter band on every joint (the component <name>_joint), like the MetaHuman body topology picture.
    colour(name) -> (r, g, b) in 0..255
FR : la couleur pâle de chaque composant, lue dans le fichier de palette unique de l'éditeur."""
import colorsys, json, os, re
HERE = os.path.dirname(os.path.abspath(__file__))
CANDIDATES = [os.path.join(HERE, "..", "..", "lines", "palette.json"), os.path.join(HERE, "..", "..", "templates", "zenray-lines-app", "palette.json")]      # the atelier layout, then the skill layout
_P = None


def palette():
    global _P
    if _P is None:
        for c in CANDIDATES:
            if os.path.exists(c): _P = json.load(open(c)); _P["_re"] = [re.compile(f["match"]) for f in _P["families"]]; break
        else: raise FileNotFoundError("palette.json not found next to the editor : " + ", ".join(CANDIDATES))
    return _P


def colour(name):
    P = palette(); joint = P["joint_lighten"] if P.get("joint_suffix") and name.endswith(P["joint_suffix"]) else 0.0
    for r, f in zip(P["_re"], P["families"]):
        if r.match(name): base = f["color"]; break
    else:
        h = 0
        for ch in name: h = (h * 31 + ord(ch)) & 0xFFFFFFFF
        base = list(colorsys.hls_to_rgb((h % 360) / 360.0, P["fallback"]["lightness"], P["fallback"]["saturation"]))
    return tuple(int(round(255 * (v + (1 - v) * joint))) for v in base)


if __name__ == "__main__":
    for n in ("leg_R_1", "leg_R_1_joint", "trunk", "trunk_joint", "arm_L_2", "arm_L_2_joint", "head_1", "junction_chest", "finger_R_1", "mystery"): print("%-16s" % n, colour(n))
