def encode_webp_b64(src_path: str, name: str, max_w: int = 1280, quality: int = 86) -> str:
    img = Image.open(src_path).convert("RGB")
    if img.width > max_w:
        nh = int(round(img.height * (max_w / img.width)))
        img = img.resize((max_w, nh), Image.Resampling.LANCZOS)
    buf = io.BytesIO()
    img.save(buf, format="WEBP", quality=quality, method=6)
    data = buf.getvalue()
    (ASSETS_DIR / f"{name}.webp").write_bytes(data)
    return "data:image/webp;base64," + base64.b64encode(data).decode("ascii")


def encode_font_b64(filename: str) -> str:
    data = (AUDIT_DIR / "fonts" / filename).read_bytes()
    return "data:font/woff2;base64," + base64.b64encode(data).decode("ascii")


