        a["sig"] = sorted(ss[0]["extents"], reverse=True) if len(ss) == 1 else sorted((hi - lo).tolist(), reverse=True); a["hidden"] = any(fnmatch.fnmatch(a["family"], h) for h in r["hidden_families"])
    atoms.sort(key=lambda a: (a["family"], a["part"], a["shells"][0]))
