            else: groups[(s["faces"], tuple(s["extents"]))] = [s]
        big = max(groups.values(), key=len)
        if len(big) >= r["repeat_min"]:
            rest = [s for s in ss if s not in big]; atoms += [dict(part=part, family=s["family"], shells=[s["id"]]) for s in big]
            if rest: atoms.append(dict(part=part, family=rest[0]["family"], shells=[s["id"] for s in rest]))
        else: atoms.append(dict(part=part, family=ss[0]["family"], shells=[s["id"] for s in ss]))
