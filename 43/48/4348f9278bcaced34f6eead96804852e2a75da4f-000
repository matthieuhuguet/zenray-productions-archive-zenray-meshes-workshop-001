### 1.4 Code (numpy seul), testé le 30 October 2026
```python
# ------------------------------------------------------------ boundary resampling with local normals
def resample_loop(P, normals, n):
    """closed polyline P (k,3) with a normal per vertex -> n points equally spaced in arc length, with interpolated unit normals."""
    Y = np.vstack([P, P[:1]]); NN = np.vstack([normals, normals[:1]]); cum = np.r_[0, np.cumsum(np.linalg.norm(np.diff(Y, axis=0), axis=1))]
    t = np.linspace(0, cum[-1], n, endpoint=False); X = np.stack([np.interp(t, cum, Y[:, k]) for k in range(3)], 1); Nr = np.stack([np.interp(t, cum, NN[:, k]) for k in range(3)], 1)
    Nr /= np.maximum(np.linalg.norm(Nr, axis=1, keepdims=True), 1e-12); return X, Nr, cum[-1]

def tangent_turn(X, Nr, i, j, k):
    """signed turning angle (deg) at X[j] between the chords i->j and j->k, measured in the tangent plane of the normal at j."""
    u = X[j] - X[i]; v = X[k] - X[j]; n = Nr[j]; u = u - (u @ n) * n; v = v - (v @ n) * n
    a, b = np.linalg.norm(u), np.linalg.norm(v)
    if a < 1e-12 or b < 1e-12: return 0.0
    c = np.clip(u @ v / (a * b), -1, 1); s = np.cross(u, v) @ n / (a * b); return float(np.degrees(np.arctan2(s, c)))

# ------------------------------------------------------------ Douglas-Peucker on a closed loop
def dp_closed(X, eps):
    """indices of a Douglas-Peucker simplification of the closed polyline X with tolerance eps (distance in 3D)."""
    n = len(X); a = 0; d = np.linalg.norm(X - X[a], axis=1); b = int(np.argmax(d)); keep = {a, b}
    def rec(i, j):                                  # open arc i -> j (indices modulo n, going forward)
        idx = [(i + t) % n for t in range(1, ((j - i) % n))]
        if not idx: return
        p, q = X[i], X[j]; qq = q - p; L = max(np.linalg.norm(qq), 1e-12)
        dist = np.array([np.linalg.norm(np.cross(X[m] - p, qq)) / L if np.linalg.norm(qq) > 1e-12 else np.linalg.norm(X[m] - p) for m in idx])
        k = int(np.argmax(dist))
        if dist[k] > eps: m = idx[k]; keep.add(m); rec(i, m); rec(m, j)
    rec(a, b); rec(b, a); return sorted(keep)

# ------------------------------------------------------------ the detector
PARAMS = dict(n=360, eps_frac=(0.004, 0.008, 0.016, 0.032), cluster_frac=0.025, t_fine=28.0, t_coarse=35.0, ratio=0.55, spike_concave=150.0, max_corners=8)

def detect(P, normals, prm=PARAMS):
    """true corners of a closed boundary : Douglas-Peucker at four tolerances (scale space), the turns of the kept vertices are integrated inside clusters (a tip that is rounded gives two vertices), a cluster is a corner when
    its integrated turn is >= t_fine at the finest scale, >= t_coarse at the coarsest scale and the two are of the same order (turn_fine / turn_coarse >= ratio : a smooth arc gives a turn that grows like sqrt(tolerance), a corner does not).
    A concave turn above spike_concave is a slit and never a corner ; a convex turn up to 180 (the tip of a strip) is allowed. returns (indices in the resampled loop, integrated turns, resampled loop, perimeter)."""
    n = prm["n"]; X, Nr, per = resample_loop(P, normals, n); S = len(prm["eps_frac"]); verts = []                                  # (sample, scale, signed turn)
    for s, ef in enumerate(prm["eps_frac"]):
        K = dp_closed(X, ef * per)
        if len(K) == 2: verts += [(K[0], s, 180.0), (K[1], s, 180.0)]; continue                 # a strip or a lens collapses to two vertices : its two tips, convex U-turns
        if len(K) < 3: continue
        for a in range(len(K)): verts.append((K[a], s, tangent_turn(X, Nr, K[a - 1], K[a], K[(a + 1) % len(K)])))
    coarse = [t for (j, s, t) in verts if s == S - 1]; sign = 1.0 if sum(coarse) >= 0 else -1.0                                      # loop orientation : convex turns have the sign of the total turning
    # local width : distance from a sample to the boundary samples that are far away along the arc (the other side of a strip)
    far = max(3, int(prm.get("width_arc", 0.1) * n)); D = np.linalg.norm(X[:, None, :] - X[None, :, :], axis=2); idxs = np.arange(n); sep = np.minimum(np.abs(idxs[:, None] - idxs[None, :]), n - np.abs(idxs[:, None] - idxs[None, :])); W = np.where(sep >= far, D, np.inf).min(axis=1)
    gmax = prm.get("gap_max", 0.06) * n; pts = sorted({j for j, s, t in verts if sign * t > 5.0}); clusters = []
    def close(a, b): return min(abs(a - b), n - abs(a - b)) <= gmax and np.linalg.norm(X[a] - X[b]) <= prm.get("merge_width", 0.5) * min(W[a], W[b])
    for j in pts:
        if clusters and close(clusters[-1][-1], j): clusters[-1].append(j)
        else: clusters.append([j])
    if len(clusters) > 1 and close(clusters[-1][-1], clusters[0][0]): clusters[0] = clusters.pop() + clusters[0]
    out = []
    for c in clusters:
        cs = set(c); T = []
        for s in range(S): T.append(min(180.0, sum(sign * t for (j, ss, t) in verts if ss == s and j in cs and sign * t > 0)))
        # concave spikes are filtered because only convex (sign) turns are summed
        if T[0] >= prm["t_fine"] and T[-1] >= prm["t_coarse"] and T[0] / max(T[-1], 1e-9) >= prm["ratio"]:
            best = max(c, key=lambda j: max([sign * t for (jj, ss, t) in verts if jj == j] or [0])); out.append((best, T[-1]))
    out.sort(key=lambda r: -r[1]); out = out[:prm["max_corners"]]; out.sort(key=lambda r: r[0])
    return [r[0] for r in out], [r[1] for r in out], X, per

```
Appel : idx, turns, X, per = detect(P_boucle (k,3), normales_boucle (k,3)) ; idx = indices dans la boucle rééchantillonnée X (n = 360) ; remonter au sommet de bord d'origine par la plus proche abscisse curviligne (le correctif de ZrlTutteFill accroche déjà les coins à un sommet de bord).

## 2. Zones annulaires (2 boucles) et lentilles (2 coins)

### 2.1 Couper ou fusionner : ce que fait la littérature lue
- QuadWild [CODE] : le tracé est récursif et traite explicitement les patchs non disque : passes « CHECK NO DISK ONES » puis « FORCE SOLVING NO DISK ONES » dans RecursiveProcess, avec GetTopologicallyNotOKPartitionsIndex ; le papier exige un patch homéomorphe à un disque (condition topologique) et ajoute des chemins de coupe (rondes de boucles, de bord à bord). Il n'existe pas de motif d'anneau dans le code de motifs.
- Takayama 2014 : seulement des disques à 2 à 6 côtés ; un anneau est découpé par l'artiste (document : « the user has to manually split the polygon »).
- Les anneaux de l'arche sont à une seule rangée de quads : mesurés sur les 25 anneaux (arche, zones à 2 boucles, partition de cette passe) : 8 triangles médians (min 8, max 46), boucles de 4 sommets médianes ; l'intérieur de la boucle interne est bordé par des triangles NON zonés (étiquette -1, composantes de 12 triangles médianes, 34 au plus), pas par une zone voisine ; fusion avec le remplissage du trou (composante non zonée qui ne touche que l'anneau) : possible pour 6 anneaux sur 25 seulement ; fusion avec une zone voisine qui serait un disque : 0 sur 25.

### 2.2 Coupes le long du plus court chemin entre les boucles [MESURÉ]
Algorithme : (1) boucle externe = la plus longue, interne = l'autre ; (2) Dijkstra sur le graphe des arêtes de la zone, poids = longueur 3D, des sommets de la boucle externe vers ceux de la boucle interne : chemin P1 ; (3) ouvrir : dupliquer les sommets le long de P1 (les coins de triangle d'un même sommet sont fusionnés par union-find seulement à travers les arêtes non coupées) ; (4) deuxième coupe : départ sur la boucle externe à mi-périmètre de P1 (fenêtre de plus ou moins 1/8), Dijkstra vers la boucle interne en interdisant les sommets de P1 : chemin P2 ; ouvrir.
Résultats sur les 25 anneaux de l'arche :
| Coupe | Disque (caractéristique d'Euler 1, une boucle de bord) |
|---|---|
| une coupe | 25 sur 25 |
| deux coupes : deux disques | 25 sur 25 |
| deux coupes : les deux pièces ont 4 vrais coins détectés | 9 sur 25 (30 pièces sur 50 ont 4 coins ; 11 pièces 2 coins, 7 pièces 3 coins) |
Les pièces à 2 ou 3 coins sont de minces bandes de quelques triangles ; les anneaux de 4 sommets par boucle (8 triangles) sont de simples rangées de 4 quads.
Recommandation [ESTIMÉ] : (a) anneau à une rangée (aire / (longueur moyenne de boucle x edge) <= environ 1,5, ou nombre de triangles <= 2 x longueur de boucle) : ne pas couper, émettre UN anneau de quads le long de la boucle (n quads, n du MILP, les deux boucles sont les bords) ; (b) anneau large : deux coupes (ci-dessus) donnent deux patchs à 4 côtés (arc externe, coupe, arc interne, coupe) à remplir par le polygone cyclique ; (c) si le trou est une composante non zonée qui ne touche que l'anneau (6 cas sur 25), fusionner l'anneau et le trou en un disque. Une seule coupe suffit pour le plongement de Tutte (un disque à 4 côtés qui contient deux fois le chemin) mais crée un patch dont deux côtés sont la même arête de coupe : il faut alors imposer le même compte aux deux côtés (contrainte d'égalité dans le MILP).

### 2.3 Lentilles et bandes (zones à 2 vrais coins) [MESURÉ + Tarini 2021]
Mesures : arche 17 zones à 2 coins détectés, lys 28.
- Tarini N = 2 (déjà établi) : e0 et e1 pairs ; un doublet central ; s0 = e1 / 2, s1 = e0 / 2 ; Takayama évite le doublet par les motifs 2-0 (l = (3 + 2 p1 + y, 1 + 2 p0 + y)) et 2-1 (l = (2 + 2 p1 + x + y, 2 + 2 p0 + x + y)).
- Alternative 1 (coupe au milieu) : relier les milieux des deux arcs par le plus court chemin et couper : deux triangles (pointe + 2 extrémités de la coupe), traités par N = 3 de Tarini (inégalité triangulaire) ; testé : deux disques obtenus pour 15 zones sur 17 (arche) et 28 sur 28 (lys). Rapport périmètre / (2 x longueur de coupe) médian : 48,5 (arche : bandes très étroites) et 7,4 (lys).
- Alternative 2 (bande étroite, rapport périmètre / coupe > environ 20) : une seule rangée de quads le long de la bande : n quads sur la longueur, 1 sur la largeur ; les deux pointes sont des triangles dégénérés ou des quads avec un côté de longueur nulle : traiter la pointe comme un coin de valence 2 (doublet, accepté seulement si l'application l'accepte) ou la fermer par un quad.
- Alternative 3 (fusion) : rattacher la lentille à sa zone voisine la plus longue et la traiter comme un bord ; rarement possible (les lentilles du lys sont isolées).
Choix : bandes étroites (rapport > 20) : alternative 2 ; lentilles larges : alternative 1 ; sinon Takayama 2-0 ou 2-1.

## 3. La normale du Jacobien d'un quad gauche

### 3.1 Définitions de la littérature [DOC]
Verdict (Stimpson, Ernst, Knupp, Pébay, Thompson ; manuel SAND2007-1751) : le Jacobien normalisé (scaled Jacobian) d'un quad est le MINIMUM sur les 4 coins de J_i / (L_i L_{i-1}) ; il vaut 1 pour un carré unité ; plage acceptable [0,3 ; 1], plage normale [-1 ; 1] (commentaire du code de VTK-m, https://docs-m.vtk.org/latest/CellScaledJacobianMetric_8h_source.html). Le code de Verdict (https://raw.githubusercontent.com/Kitware/VTK/master/ThirdParty/verdict/vtkverdict/V_QuadMetric.cpp) calcule : arêtes e0 = P1-P0, e1 = P2-P1, e2 = P3-P2, e3 = P0-P3 ; axes principaux p0 = e0 - e2, p1 = e1 - e3 ; NORMALE AU CENTRE n = normalize(p0 x p1) ; produits vectoriels de coin c0 = e3 x e0, c1 = e0 x e1, c2 = e1 x e2, c3 = e2 x e3 ; aires signées de coin A_i = n . c_i ; SJ_i = A_i / (L_i L_{i-1}) ; résultat = min SJ_i. Les références : Knupp, « Algebraic mesh quality metrics », SIAM J. Sci. Comput. 23(1), 2001 ; Pébay, « Planar quadrilateral quality measures », Engineering with Computers 20, 2004 (le rapport INRIA RR-4436, 2002, montre que certaines mesures étendues du triangle aux quads ne détectent pas la dégénérescence en triangle) [DOC via recherche]. Sandia : pour un quad à 4 noeuds la mesure de forme est proportionnelle au gauchissement (https://www.sandia.gov/files/sierra/SM_Users_5_30/user_manual/commands/metrics.html).

### 3.2 Identités et mesures [MESURÉ]
- p0 x p1 = 2 (d1 x d2) avec d1 = P2 - P0, d2 = P3 - P1 : la normale au centre de Verdict EST la normale des diagonales (vérifié numériquement sur 1 000 quads aléatoires : rapport 2,000000, parallèles).
- La somme des quatre produits de coin non normalisés c0 + c1 + c2 + c3 vaut aussi 2 (d1 x d2) : même direction. La moyenne des quatre normales de coin NORMALISÉES est une autre quantité, plus tolérante.
- Effet sur les quads de l'arche et du lys (zones à réseau relevé sans relax, snap, sag) :
| Normale | Arche : J < 0 | Arche : J < 0,3 | Lys : J < 0 | Lys : J < 0,3 |
|---|---|---|---|---|
| coin 0 (code actuel de ZrlQuadStats) | 1 249 (10,74 %) | 9 198 (79,11 %) | 429 (1,04 %) | 23 794 (57,60 %) |
| diagonales = normale au centre de Verdict | 862 (7,41 %) | 9 198 | 413 (1,00 %) | 23 754 (57,50 %) |
| moyenne des 4 normales de coin normalisées | 561 (4,82 %) | 9 198 | 316 (0,76 %) | 23 741 (57,47 %) |
