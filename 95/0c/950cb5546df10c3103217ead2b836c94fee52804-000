"""30 October 2026 : ZenRay Meshes, independent GROUND TRUTH car : the synthetic faceted car of the research (exact planes and straight creases) is sampled on a voxel grid, meshed by marching cubes (a noisy, staircase-free but faceted-smoothed reconstruction like the volume methods give), written as an OBJ ; its exact surface points are saved for the Chamfer.
    python -I FacetCarBench.py out_dir [--voxel-mm 12]
FR : voiture facettee synthetique a verite exacte : maillage par cubes marchants et nuage de points exact de la surface."""
import argparse, os, sys
import numpy as np
E = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/research/car-cloud/Projects/zenray-meshes/research-car/experiments"; sys.path.insert(0, E)
import facetcar as FC
from skimage import measure


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("out"); ap.add_argument("--voxel-mm", type=float, default=12.0); a = ap.parse_args(); os.makedirs(a.out, exist_ok=True)
    car, _p = FC.build(); h = a.voxel_mm / 1000.0; xs = np.arange(-1.1, 1.1, h); ys = np.arange(0.0, 1.45, h); zs = np.arange(-2.4, 2.4, h)
    occ = np.zeros((len(xs), len(ys), len(zs)), bool)
    for i, x in enumerate(xs):
        Y, Z = np.meshgrid(ys, zs, indexing="ij"); X = np.stack([np.full(Y.shape, x), Y, Z], -1).reshape(-1, 3); occ[i] = car._inside(car.tree, X).reshape(len(ys), len(zs))
    occ = np.pad(occ, 1); V, F, _, _ = measure.marching_cubes(occ.astype(float), 0.5, spacing=(h, h, h)); V = V + np.array([xs[0] - h, ys[0] - h, zs[0] - h])
    with open(os.path.join(a.out, "truth_mc.obj"), "w") as f:
        for v in V: f.write("v %.6f %.6f %.6f\n" % tuple(v))
        f.write("g FACETCAR\n")
        for t in F: f.write("f %d %d %d\n" % (t[0] + 1, t[1] + 1, t[2] + 1))
    pts, nrm, fid = FC.sample_surface(car, 6000); np.savez(os.path.join(a.out, "truth_points.npz"), pts=pts, nrm=nrm, fid=fid)
    print("voxels", occ.shape, "triangles", len(F), "truth points", len(pts), "bbox", V.min(0).round(3), V.max(0).round(3))


if __name__ == "__main__": main()
