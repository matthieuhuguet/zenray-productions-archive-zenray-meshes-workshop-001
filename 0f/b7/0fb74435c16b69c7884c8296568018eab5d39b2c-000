/* 29 October 2026 : ZenRay Lines 3D, the few rules the 3D page adds to style.css */
#stage3 { position: relative; flex: 1; min-height: 0; overflow: hidden; background: #f6f6f5; }
#cv { position: absolute; inset: 0; width: 100%; height: 100%; display: block; outline: none; touch-action: none; }
#boxSel { position: absolute; border: 1px dashed #d4733b; background: rgba(212, 115, 59, 0.08); pointer-events: none; display: none; }
.grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4px; margin-bottom: 8px; }
.grid3 .btn { padding: 4px 2px; font-size: 12px; }
.btn.tool.active, .btn.on { background: #2b2b2b; color: #fff; border-color: #2b2b2b; }
.buttons.wrap { display: flex; flex-wrap: wrap; gap: 4px; }
.row { display: flex; gap: 4px; margin: 6px 0; }
.row input { flex: 1; min-width: 0; }
.slider b { font-family: 'GT Ultra', system-ui, sans-serif; font-weight: 400; min-width: 3.2em; text-align: right; }
kbd { font-size: 10px; opacity: 0.65; }
#meshInfo { max-height: 220px; overflow: auto; white-space: pre-wrap; font-size: 12px; }
@media (prefers-color-scheme: dark) { #stage3 { background: #1d1d1d; } }
.coords3 { float: right; font-family: 'GT Ultra', system-ui, sans-serif; opacity: 0.7; }
#tags { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
#tags .tag { position: absolute; transform: translate(8px, -50%); font: 11px/1.2 'GT Ultra', system-ui, sans-serif; background: rgba(255,255,255,0.82); color: #222; padding: 1px 5px; border-radius: 6px; white-space: nowrap; }
#tags .tag.sel { background: #d4733b; color: #fff; }
.comps { max-height: 260px; overflow: auto; }
.row-c { display: grid; grid-template-columns: 12px 1fr; column-gap: 6px; padding: 3px 4px; border-radius: 6px; cursor: pointer; align-items: center; }
.row-c i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
.row-c small { grid-column: 2; opacity: 0.6; font-size: 11px; }
.row-c.sel { background: rgba(212, 115, 59, 0.16); }
.legend { font-size: 11px; opacity: 0.85; margin: 6px 0; }   /* 29 October 2026 : the judge colours of the quads */
.legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin: 0 4px 0 8px; vertical-align: -1px; }
.flow { margin: 6px 0 0 18px; padding: 0; font-size: 12px; line-height: 1.45; }   /* 29 October 2026 : the stages of ZenRay Lines */
.flow li { margin-bottom: 4px; }
/* 29 October 2026 : the 3D editor's left panel carries more tools : wider, one checkbox per line */
#app { --left-w: 236px; }
#left .checks { grid-template-columns: 1fr; }

/* 29 October 2026 : components list : actions on each row, inline rename, filter */
.row-c { grid-template-columns: 12px 1fr auto; }
.row-c .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row-c .acts { display: flex; gap: 6px; opacity: 0.35; font-size: 11px; }
.row-c:hover .acts, .row-c.sel .acts { opacity: 1; }
.row-c .acts b { font-weight: 400; cursor: pointer; padding: 0 3px; border-radius: 4px; }
.row-c .acts b:hover { background: rgba(0, 0, 0, 0.08); }
.row-c small { grid-column: 2 / 4; }
.row-c input.rename { width: 100%; font: inherit; padding: 1px 4px; }
input.filter { width: 100%; margin: 4px 0; }

/* 29 October 2026 : drawers (folded tools), a calmer page */
details.more { margin-top: 8px; border-top: 1px solid var(--line, rgba(0,0,0,0.08)); padding-top: 6px; }
details.more > summary { cursor: pointer; font-size: 12px; opacity: 0.75; list-style: none; user-select: none; }
details.more > summary::before { content: '\25B8'; display: inline-block; width: 12px; transition: transform 0.15s; }
details.more[open] > summary::before { transform: rotate(90deg); }
details.more > summary::-webkit-details-marker { display: none; }
#selInfo.inline { display: inline; font-size: 11px; margin-left: 6px; opacity: 0.7; }
ul.keys { padding-left: 16px; font-size: 12px; line-height: 1.5; }
