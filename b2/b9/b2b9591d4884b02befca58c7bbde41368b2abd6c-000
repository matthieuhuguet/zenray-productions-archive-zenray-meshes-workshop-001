"""E2a : enveloppe visuelle polyédrique par silhouettes ajustées (H1 + H2) contre la sculpture de voxels lissée (B0), trois niveaux de perturbation. 30 October 2026."""
import sys, json, time
import numpy as np
sys.path.insert(0, ".")
from e2_common import *
levels = [("propre", dict()), ("planche_moyenne", dict(edge_jitter=1.0)), ("planche_mauvaise", dict(edge_jitter=2.0))]
res = {}
for name, kw in levels:
    case = make_case(**kw)
    t = time.time()
    hull = visual_hull(case, eps_px=1.5)
    t1 = time.time() - t
    print(name, 'hull faces', len(hull.faces), 'watertight', hull.is_watertight, 'vol', round(hull.volume, 3), 's', round(t1, 1), flush=True)
    f = fidelity(hull, case["truth"]); print('  fidelity ok', round(time.time() - t, 1), flush=True)
    v = vsummary(verify(hull)); print('  verify ok', round(time.time() - t, 1), flush=True)
    b0 = baseline_voxel(case); print('  B0 faces', len(b0.faces), round(time.time() - t, 1), flush=True)
    fb = fidelity(b0, case["truth"]); print('  B0 fidelity', round(time.time() - t, 1), flush=True); vb = vsummary(verify(b0)); print('  B0 verify', round(time.time() - t, 1), flush=True)
    # H2 : sans ajustement de droites (eps 0.5 px, quasi marches de pixel)
    hull_raw = visual_hull(case, eps_px=0.5 if name == 'propre' else 3.0)
    fr = fidelity(hull_raw, case["truth"]); vr = vsummary(verify(hull_raw))
    res[name] = {"hull_fitted_eps1.5px": {"fidelity": f, "verifiers": v, "facets": len(hull.faces)}, "hull_second_eps": {"fidelity": fr, "verifiers": vr}, "voxel_taubin_B0": {"fidelity": fb, "verifiers": vb}, "seconds_hull": t1}
    print(name, "\n  hull eps1.5:", {k: round(x, 3) for k, x in f.items()}, v, "\n  hull eps0.5:", {k: round(x, 3) for k, x in fr.items()}, vr, "\n  B0 voxel+Taubin:", {k: round(x, 3) for k, x in fb.items()}, vb)
json.dump(res, open("out/e2a_hull.json", "w"), indent=1)
