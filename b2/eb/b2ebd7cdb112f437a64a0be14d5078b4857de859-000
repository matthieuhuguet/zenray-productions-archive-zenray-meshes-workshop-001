"""28 October 2026, 17:40 : ZenRay Meshes finishing, SOLIDIFY, every single sided part (open edges over --ratio of its faces, or listed) becomes a
closed shell : coincident vertices merged inside the part, inner copy offset by --thick along the vertex normals (away from the visible side), faces
reversed, one quad wall per open edge ; closed shell oriented by signed volume. Parts that already are closed are left untouched.
python Solidify.py <in.npz> <out.npz> [--parts A,B | --auto 1 --ratio 0.25] [--thick 0.005] [--skip liner]   FR : épaissit les pièces simple face en coques fermées."""
import argparse, json
from collections import defaultdict
import numpy as np
from scipy.spatial import cKDTree
ap = argparse.ArgumentParser(); ap.add_argument("inp"); ap.add_argument("out"); ap.add_argument("--parts", default=""); ap.add_argument("--auto", type=int, default=1)
ap.add_argument("--ratio", type=float, default=0.25); ap.add_argument("--thick", type=float, default=0.005); ap.add_argument("--skip", default="liner,wheel,tire,rim"); ap.add_argument("--merge-mm", type=float, default=0.1)
a = ap.parse_args()
d = np.load(a.inp, allow_pickle=True); P = d["P"].astype(float); n = np.array([str(x) for x in d["names"]]); DQ = d["Q"]; Q = [list(map(int, q)) for q in DQ]
by = defaultdict(list)
for i, m in enumerate(n): by[m].append(i)
def open_edges(F):
    E = defaultdict(int)
    for q in F:
        for k in range(len(q)): E[(min(q[k], q[(k + 1) % len(q)]), max(q[k], q[(k + 1) % len(q)]))] += 1
    return [e for e, c in E.items() if c == 1], E
todo = set(a.parts.split(",")) - {""}
if a.auto:
    for m, idx in by.items():
        if any(s in m.lower() for s in a.skip.split(",")): continue
        oe, _ = open_edges([Q[i] for i in idx])
        if len(oe) > a.ratio * len(idx): todo.add(m)
newP = list(P); outQ, outN = [], []; rep = {}
for m, idx in by.items():
    F = [Q[i] for i in idx]
    if m not in todo:
        outQ += F; outN += [m] * len(F); continue
    V = sorted({x for q in F for x in q}); X = P[V]; t = cKDTree(X); rm = {v: v for v in V}
    for i, j in (t.query_pairs(a.merge_mm / 1000) if a.merge_mm > 0 else []): rm[V[j]] = rm[V[i]]
    for v in V:
        while rm[rm[v]] != rm[v]: rm[v] = rm[rm[v]]
    F = [[rm[x] for x in q] for q in F]; F = [[x for k, x in enumerate(q) if x != q[k - 1]] for q in F]; F = [q for q in F if len(set(q)) >= 3]
    vn = defaultdict(lambda: np.zeros(3))
    for q in F:
        v = P[q]; nn = np.cross(v[2] - v[0], v[-1] - v[1])
        for x in q: vn[x] = vn[x] + nn
    U = sorted({x for q in F for x in q}); off = {}
    for x in U:
        nv = vn[x] / (np.linalg.norm(vn[x]) + 1e-12); off[x] = len(newP); newP.append(P[x] - a.thick * nv)
    S = F + [[off[x] for x in q[::-1]] for q in F]
    oe, E = open_edges(F); D = set()
    for q in F:
        for k in range(len(q)): D.add((q[k], q[(k + 1) % len(q)]))
    for (u, w) in oe:
        if (u, w) not in D: u, w = w, u
        S.append([w, u, off[u], off[w]])
    NP = np.array(newP); vol = sum(np.dot(NP[q[0]], np.cross(NP[q[k]], NP[q[k + 1]])) for q in S for k in range(1, len(q) - 1)) / 6
    if vol < 0: S = [q[::-1] for q in S]
    oe2, E2 = open_edges(S); rep[m] = {"open_before": len(oe), "open_after": len(oe2), "nonmanifold": sum(c > 2 for c in E2.values())}
    outQ += S; outN += [m] * len(S)
np.savez(a.out, P=np.array(newP, np.float32), Q=np.array(outQ, dtype=object), names=np.array(outN))
print(json.dumps({"solidified": len(rep), "open_after_total": sum(r["open_after"] for r in rep.values()), "nonmanifold_total": sum(r["nonmanifold"] for r in rep.values())}))
print(json.dumps({k: v for k, v in rep.items() if v["open_after"] or v["nonmanifold"]}))
