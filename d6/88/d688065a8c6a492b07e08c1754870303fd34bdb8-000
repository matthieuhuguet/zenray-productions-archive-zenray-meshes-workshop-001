# 28 October 2026 : finishing preview in the live Houdini scene : /obj/ZRM_Finish shows the candidate part (left) and the target part shifted (right), wireframe on shaded.
import hou
cand, targ, shift = globals()['CAND'], globals()['TARG'], float(globals().get('SHIFT', 1.7))
g = hou.node('/obj/ZRM_Finish') or hou.node('/obj').createNode('geo', 'ZRM_Finish')
for c in g.children(): c.destroy()
a = g.createNode('file', 'candidate'); a.parm('file').set(cand)
b = g.createNode('file', 'target'); b.parm('file').set(targ)
t = g.createNode('xform', 'shift_target'); t.setInput(0, b); t.parm('tx').set(shift)
m = g.createNode('merge', 'both'); m.setInput(0, a); m.setInput(1, t)
m.setDisplayFlag(True); m.setRenderFlag(True); g.layoutChildren()
result = [a.geometry().intrinsicValue('primitivecount'), b.geometry().intrinsicValue('primitivecount')]
