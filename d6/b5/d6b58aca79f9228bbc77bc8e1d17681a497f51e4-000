    out.push('<path id="arc-' + a.id + '" class="' + (e.anyVis ? 'visible' : 'hidden') + '" data-pair="' + escapeHtml(a.pair.join(' / ')) + '" data-mirror="' + a.mirror + '" ' + style + ' d="' + d + '"/>');
    written++;
  }
  out.push('</g>', '<g id="nodes" stroke="none">');
  for (const nd of doc.nodes) {
    project(view, nd.p, q);
    if (!opts.showHidden && !isVisible(depthMap, q[0], q[1], q[2])) continue;
    out.push('<circle id="node-' + nd.id + '" cx="' + n2(q[0]) + '" cy="' + n2(q[1]) + '" r="' + opts.nodeRadius + '" fill="' + opts.colors.node + '"/>');
  }
  out.push('</g>', '</svg>');
  return { text: out.join('\n') + '\n', arcs: written };
}

