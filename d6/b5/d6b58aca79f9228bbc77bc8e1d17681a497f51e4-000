// ------------------------------------------------------------------------------------------------------------------ SVG export
// One <path> per arc (id arc-<id>), one cubic Bezier per span (exact), image pixel coordinates of the view.
function buildSvg(doc, view, depthMap, opts) {
  const res = view.res, D = opts.decimals, f = Math.pow(10, D), n2 = (v) => String(Math.round(v * f) / f), q = [0, 0, 0], model = opts.model;
  const pr = (p) => { project(view, p, q); return n2(q[0]) + ' ' + n2(q[1]); };
  const out = ['<?xml version="1.0" encoding="UTF-8"?>',
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + res + ' ' + res + '" width="' + res + '" height="' + res + '">',
    '<title>ZenRay Retopology, view ' + escapeHtml(opts.viewName) + ', ' + escapeHtml(doc.date || '') + '</title>'];
  if (opts.backgroundHref) out.push('<image x="0" y="0" width="' + res + '" height="' + res + '" opacity="' + opts.bgOpacity + '" href="' + opts.backgroundHref + '"/>');
  out.push('<g id="arcs" fill="none" stroke-linecap="round" stroke-linejoin="round">');
  let written = 0;
  for (const a of doc.arcs) {
    const e = projectArc(model, a, view, depthMap);
    if (!e.anyVis && !opts.showHidden) continue;
    const spans = Spline.bezierSpans(a.ctrl);
    if (!spans.length) continue;
    let d = 'M' + pr(spans[0][0]);
    for (const s of spans) d += 'C' + pr(s[1]) + ' ' + pr(s[2]) + ' ' + pr(s[3]);
    const style = e.anyVis ? 'stroke="' + opts.colors.arc + '" stroke-width="' + opts.stroke + '"'
