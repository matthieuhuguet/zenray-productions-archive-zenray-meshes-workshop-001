"""28 October 2026, 03:50 : ZenRay Meshes finishing, MIRROR MOVE, make a part's move symmetric : the right half takes the mirrored displacement of the
left half (inverse distance of the 4 nearest left vertices, measured on the BEFORE positions), so a non mirrored grid still moves symmetrically.
python MirrorMove.py <before.npz> <after.npz> <out.npz> --parts A,B   FR : rend un déplacement symétrique, même sur une grille non miroir.
"""
import argparse

import numpy as np
from scipy.spatial import cKDTree

ap = argparse.ArgumentParser(); ap.add_argument("before"); ap.add_argument("after"); ap.add_argument("out"); ap.add_argument("--parts", required=True)
a = ap.parse_args()
o = np.load(a.before, allow_pickle=True); d = np.load(a.after, allow_pickle=True)
P0 = o["P"].astype(float); P = d["P"].astype(float); n = np.array([str(x) for x in d["names"]]); S = np.array([-1, 1, 1])
for part in a.parts.split(","):
    V = np.array(sorted({v for q, m in zip(d["Q"], n) if m == part for v in q})); X0 = P0[V]
    L = V[X0[:, 0] > 0]; R = V[X0[:, 0] <= 0]
    dist, idx = cKDTree(P0[L]).query(P0[R] * S, k=4)
    w = 1 / (dist + 1e-6); w /= w.sum(1, keepdims=True)
    P[R] = P0[R] + ((P[L] - P0[L])[idx] * w[..., None]).sum(1) * S
    X = P[V]; print(part, "mirror max mm %.1f" % (cKDTree(X).query(X * S)[0].max() * 1000))
np.savez(a.out, P=P.astype(np.float32), Q=d["Q"], names=d["names"])
