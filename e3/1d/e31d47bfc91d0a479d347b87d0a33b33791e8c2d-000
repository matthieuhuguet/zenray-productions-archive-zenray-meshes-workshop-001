# 27 October 2026: Export dedicated Lego component npz packages for Houdini modular graph
import sys
from pathlib import Path
import numpy as np

def export_lego():
    src_path = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car/delivery_v540.npz"
    d = np.load(src_path, allow_pickle=True)
    P = d["P"]
    Q = d["Q"]
    names = d["names"]

    targets = {
        "Component_Bumper_Rear_Lego": ["CAR_body_bumper_rear_C"],
        "Component_Light_Bar_Rear_Lego": ["CAR_light_bar_rear_C"],
        "Component_Fascia_Rear_Panel_Lego": ["CAR_fascia_rear_panel_C"],
        "Component_Liner_Lego": ["CAR_body_liner_C"],
        "Component_Door_L_Lego": ["CAR_body_door_L"],
        "Component_Door_R_Lego": ["CAR_body_door_R"],
        "Component_Nose_Lego": [n for n in set(names) if "nose" in n],
    }

    out_dir = Path("/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car")

    for node_name, part_names in targets.items():
        indices = [i for i, n in enumerate(names) if n in part_names]
        if not indices:
            print(f"Warning: no faces for {node_name}")
            continue
        faces = [Q[i] for i in indices]
        f_names = [names[i] for i in indices]

        used = sorted(set(v for f in faces for v in f))
        idx_map = {old: new for new, old in enumerate(used)}
        pts = P[used]
        c_faces = [[idx_map[v] for v in f] for f in faces]

        out_path = out_dir / f"{node_name}.npz"
        np.savez(out_path, P=np.asarray(pts, np.float32), Q=np.array(c_faces, np.int32), names=np.array(f_names))
        print(f"Exported {out_path.name}: {len(pts)} pts, {len(c_faces)} quads")

if __name__ == "__main__":
    export_lego()
