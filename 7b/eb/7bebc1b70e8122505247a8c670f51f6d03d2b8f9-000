FR : lecture et ecriture d'OBJ, lecture des fichiers de layout de QuadWild (.patch, .corners, .feature, .c_feature).
All scripts of pass8_tools take key=value arguments (no double hyphen options)."""
import numpy as np


def read_obj(path):
    """Return (V, F) where F is a list of index lists (triangles and quads kept as they are), 0 based."""
    V, F = [], []
    with open(path) as f:
        for line in f:
            if line.startswith("v "):
                V.append([float(x) for x in line.split()[1:4]])
            elif line.startswith("f "):
                F.append([int(tok.split("/")[0]) - 1 for tok in line.split()[1:]])
    return np.array(V, float), F


def read_obj_tri_or_quad(path):
    """Return (V, F) with F an (n, 3) or (n, 4) int array. Raises if mixed."""
    V, F = read_obj(path)
    sizes = {len(f) for f in F}
    if len(sizes) != 1:
        raise ValueError("mixed face sizes %s in %s" % (sorted(sizes), path))
    return V, np.array(F, int)


def write_obj(path, V, F):
    with open(path, "w") as f:
        for p in V:
            f.write("v %.9g %.9g %.9g\n" % tuple(p))
        for q in F:
            f.write("f " + " ".join(str(int(i) + 1) for i in q) + "\n")


def read_patch(path):
    """_p0.patch : first token = number of faces, then one patch id per face (0 based)."""
    tok = open(path).read().split()
    n = int(tok[0])
    ids = np.array([int(t) for t in tok[1:1 + n]], int)
    assert len(ids) == n
    return ids


def read_corners(path):
    """_p0.corners : number of patches, then for each patch : number of corners then that many vertex indices."""
    tok = open(path).read().split()
    k = 0
    npatch = int(tok[k]); k += 1
    out = []
    for _ in range(npatch):
        nc = int(tok[k]); k += 1
        out.append([int(t) for t in tok[k:k + nc]]); k += nc
    return out


def read_feature(path):
    """_p0.feature : number of features then lines 'faceIndex,edgeIndex' (edge j of face i = V(j)->V(j+1))."""
    lines = open(path).read().split("\n")
    n = int(lines[0].strip() or 0)
    return [tuple(int(x) for x in lines[1 + i].split(",")) for i in range(n)]


def read_c_feature(path):
    """_p0.c_feature : number of sharp corner vertices then their indices."""
    tok = open(path).read().split()
    n = int(tok[0])
    return [int(t) for t in tok[1:1 + n]]
