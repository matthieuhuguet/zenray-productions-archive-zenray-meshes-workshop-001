def slug(name):
    s = unicodedata.normalize("NFKD", name).encode("ascii", "ignore").decode().lower(); return re.sub(r"[^a-z0-9]+", "_", s).strip("_")


def one_copy(m, r, sc):
    """copies joined by a thin bridge, as the spokes of a wheel : the mask is eroded, step by step, the step with the most similar parts wins, and its largest part grows back alone. FR : des copies jointes par un pont fin, comme les branches d'une jante : on érode pas à pas, l'étape qui montre le plus de parties semblables l'emporte, et sa plus grande partie reprend seule sa taille."""
    best = (1, None, 0, None)
    for k in range(1, int(r["split_px"] * sc) + 1):
        e = ndi.binary_erosion(m, iterations=k); cc, n = ndi.label(e)
        if n < 2: continue
        sz = ndi.sum(e, cc, range(1, n + 1)); count = int((sz >= r["split_similar"] * sz.max()).sum()); part = cc == 1 + int(np.argmax(sz))
        if count > best[0] and ndi.distance_transform_edt(part).max() >= k: best = (count, part, k, e)      # 2 November 2026 : what remains must stay thicker than what was removed, or a tyre, a thin ring, falls into arcs. FR : ce qui reste doit rester plus épais que ce qui est retiré, sinon un pneu, anneau fin, tombe en arcs.
    if best[1] is None: return m
    _, big, k, e = best; return ndi.binary_dilation(big, iterations=k + 1) & m & ~ndi.binary_dilation(e & ~big, iterations=k)


def keep_regions(m, instances, r):
    """one piece, not all its copies : the largest region of the mask ; a single piece or one side of a pair also keeps its large other parts. FR : une pièce et non toutes ses copies : la plus grande région ; une pièce unique ou un côté de paire garde aussi ses autres grandes parties."""
    cc, n = ndi.label(m)
    many = instances >= r["split_min_copies"]
    if n <= 1: return one_copy(m, r, r["_sc"]) if many else m
    sz = ndi.sum(m, cc, range(1, n + 1)); big = sz.max()
    if instances > 2: one = cc == 1 + int(np.argmax(sz)); return one_copy(one, r, r["_sc"]) if many else one
    return np.isin(cc, 1 + np.flatnonzero(sz >= r["keep_region"] * big))


def piece_ids(m, ref_px):
    """a single piece shows in all its views ; of a mirrored or repeated piece, the atom the sheet shows best. FR : une pièce unique se montre dans toutes ses vues ; d'une pièce répétée, l'exemplaire que la planche montre le mieux."""
    if m["instances"] <= 1: return list(m["atoms"])
    return [max(m["atoms"], key=lambda i: (sum(ref_px.get(str(i), {}).values()), -i))]


