import hou, numpy as np

geo = hou.pwd().geometry()
geo.clear()

# 1. Measured 3D Profile Curves from 6 views (Tail Face junction to Rear Glass junction)
# Tail face junction at Z = -2.086 (10mm gap to tail face at Z = -2.096)
# Rear glass junction at Z = -1.993 (5mm gap to rear glass at Z = -1.988)
measured_z = np.array([-2.086, -2.057, -2.028, -1.993])
measured_x = np.array([0.582, 0.582, 0.581, 0.574])
measured_yc = np.array([0.999, 1.005, 1.008, 1.013])
measured_ye = np.array([0.997, 1.002, 1.005, 1.010])

num_u = 7 # 7 rows along Z
z_pts = np.linspace(-2.086, -1.993, num_u)
num_v = 5 # 5 control columns across X

x_edges = np.interp(z_pts, measured_z, measured_x)
yc_centers = np.interp(z_pts, measured_z, measured_yc)
ye_edges = np.interp(z_pts, measured_z, measured_ye)

surf = geo.createNURBSSurface(num_v, num_u)

for i in range(num_u):
    z = float(z_pts[i])
    xe = float(x_edges[i])
    yc = float(yc_centers[i])
    ye = float(ye_edges[i])
    xc = float(xe * 0.5)
    y_mid = float(yc + (ye - yc) * 0.25)
    v_pts = [
        (-xe, ye, z),
        (-xc, y_mid, z),
        (0.0, yc, z),
        (xc, y_mid, z),
        (xe, ye, z)
    ]
    for j in range(num_v):
        surf.vertex(i, j).point().setPosition(hou.Vector3(*v_pts[j]))
