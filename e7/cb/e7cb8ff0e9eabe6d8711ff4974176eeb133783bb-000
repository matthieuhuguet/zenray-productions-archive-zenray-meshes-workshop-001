# 25 October 2026 : ZenRay Meshes car, WHEEL ARCH LIPS (CAR_arch_front_L/R, CAR_arch_rear_L/R) : a ring of quads around
# each wheel opening, from angle a0 to a1 (degrees, 0 = toward the nose, 90 = up), between radius r_in and r_out around
# the axle, posed on the real body side (ray along -x on body_nose.npz) plus protrude, closed by its back copy at depth
# and its edges. Values in work/car/arch_lip_params.json ; axles from wheel_params.json.
# FR : lèvres de passages de roue, anneau de quads posé sur le flanc réel ; paramètres dans un JSON.
# Usage: python ArchBuild.py <arch_lip_params.json> <wheel_params.json> <body_nose.npz> <out.npz>
import sys, json, math
import numpy as np
import trimesh


def surface_strip(ray, bm, L, nv, wv, st_):
    """26 October 2026: a thin frame that follows the body surface instead of the side plane. The side plane offset cast along -x skews
    a quad where the surface slopes in x (the B pillar : corner angles 40 to 140 degrees, ComponentScore topology 0.43). Here the centre line is
    the ray hit, the across direction is normal x tangent, so every quad is a rectangle on the surface. FR : bande dans le repère tangent de la surface."""
    ns = len(L); C = np.full((ns, 3), np.nan); Nm = np.zeros((ns, 3)); ok = np.zeros(ns, bool)
    def hit(z, y):
        loc, _, it = ray.intersects_location(np.array([[3.0, y, z]]), np.array([[-1.0, 0, 0]]), multiple_hits=False)
        if len(loc) and float(loc[0, 0]) > st_.get("near_x_min", 0.2):
            n_ = bm.face_normals[it[0]]; return float(loc[0, 0]), (n_ if n_[0] > 0 else -n_)
        return None
    for i in range(ns):
        z, y = L[i]; h = hit(z, y)   # the pillar sits in the joint between two glass panels, the ray falls through the gap : sample both sides of it
        if h is None:
            for dz in st_.get("sample_dz", [0.01, 0.02, 0.03, 0.045, 0.06]):
                a, b = hit(z - dz, y), hit(z + dz, y)
                if a is not None and b is not None: h = ((a[0] + b[0]) / 2, a[1] + b[1]); break
        if h is not None:
            C[i] = (h[0], y, z); Nm[i] = h[1] / max(np.linalg.norm(h[1]), 1e-9); ok[i] = True
    for k in range(3):
        C[~ok, k] = np.interp(np.flatnonzero(~ok), np.flatnonzero(ok), C[ok, k]); Nm[~ok, k] = np.interp(np.flatnonzero(~ok), np.flatnonzero(ok), Nm[ok, k])
    Nm /= np.linalg.norm(Nm, axis=1, keepdims=True)
    for _ in range(int(st_.get("smooth_normals", 0))):   # 26 October 2026: neighbouring rows share their normal so the quads between them stay planar
        Nm[1:-1] = Nm[:-2] + 2 * Nm[1:-1] + Nm[2:]; Nm /= np.linalg.norm(Nm, axis=1, keepdims=True)
    Tg = np.gradient(C, axis=0); Tg /= np.maximum(np.linalg.norm(Tg, axis=1, keepdims=True), 1e-9)
    Sd = np.cross(Nm, Tg); Sd /= np.linalg.norm(Sd, axis=1, keepdims=True)
    side = np.stack([np.zeros(ns), nv[:, 1], nv[:, 0]], 1)        # the (z, y) normal of the plane version, as a 3D direction, keeps the winding
    Sd[(Sd * side).sum(1) < 0] *= -1
    G = np.zeros((ns, 2, 3))
    for j, sgn in enumerate((-1, 1)): G[:, j] = C + sgn * wv[:, None] * Sd + Nm * st_.get("protrude", 0.004)
    return G


def main(params, wparams, body, out):
    A = json.load(open(params)); W = json.load(open(wparams)); d = np.load(body, allow_pickle=True)
    bm = trimesh.Trimesh(d["P"], d["F"], process=False); ray = trimesh.ray.ray_triangle.RayMeshIntersector(bm)
    allP, allQ, allN = [], [], []
    for inst in W["instances"]:
        if inst["x"] < 0: continue                                   # one side measured, mirrored below
        front = inst["z"] > 0; R0 = W["tyre_r"] * A["r_in_pad"]; R1 = R0 + A["lip_w"]
        ang = np.radians(np.linspace(A["a0_deg"], A["a1_deg"], A["segments"]))
        G = np.zeros((len(ang), 2, 3))
        for i, a in enumerate(ang):
            for j, r in enumerate((R0, R1)):
                z = inst["z"] + r * math.cos(a); y = inst["y"] + r * math.sin(a)
                loc, _, _ = ray.intersects_location(np.array([[3.0, y, z]]), np.array([[-1.0, 0, 0]]), multiple_hits=False)
                xs = float(loc[0, 0]) if len(loc) else np.nan   # 25 October 2026: a miss is filled from its neighbours below
                G[i, j] = (xs + A["protrude"], y, z)
        for j in range(2):   # misses (opened arch, clipped tail) took a default outside the car and made spikes
            col = G[:, j, 0]; ok_ = np.isfinite(col)
            col[~ok_] = np.interp(np.flatnonzero(~ok_), np.flatnonzero(ok_), col[ok_]) if ok_.any() else inst["x"]
            G[:, j, 0] = col
        B = G.copy(); B[..., 0] -= A["depth"]
        for sd, tag in ((1, "L"), (-1, "R")):
            nm = "CAR_arch_%s_%s" % ("front" if front else "rear", tag)
            P = np.concatenate([G.reshape(-1, 3), B.reshape(-1, 3)]) * [sd, 1, 1]; n = len(ang); b = sum(len(p) for p in allP); allP.append(P)
            idx = lambda l, i, j: b + l * n * 2 + i * 2 + j
            Q = []
            for i in range(n - 1):
                Q.append((idx(0, i, 0), idx(0, i + 1, 0), idx(0, i + 1, 1), idx(0, i, 1)))     # face
                Q.append((idx(0, i, 0), idx(1, i, 0), idx(1, i + 1, 0), idx(0, i + 1, 0)))     # inner edge (toward the tyre)
                Q.append((idx(0, i, 1), idx(0, i + 1, 1), idx(1, i + 1, 1), idx(1, i, 1)))     # outer edge
            for q in Q: allQ.append(q if sd > 0 else q[::-1]); allN.append(nm)
    # SIDE STRIPS (25 October 2026): thin frames along a side polyline [z, y] (A and B pillars between the glasses), width
    # w across the line in the side plane, posed on the body side by the same ray, mirrored ; values in "strips"
    for nm0, st_ in A.get("strips", {}).items():
        if "row" in st_:
            # 26 October 2026: ROW STRIP ; the strip follows a named loft row in 3D (here roof_edge), offset along the band
            # toward the next column (d0 to d1 m) and lifted by protrude along the surface normal ; a ray cast side
            # polyline stopped matching the body when the row moved (light triangles on the windshield). FR : bande sur
            # une rangée réelle du loft, elle suit la rangée quand celle-ci bouge.
            L_ = np.load(st_.get("loft", "work/car/loft_v2.npz"), allow_pickle=True); nt_, R_ = L_["grid_shape"]; gc_ = L_["grid_cols"]
            G_ = L_["P"][: nt_ * R_].reshape(nt_, R_, 3); first_ = {}   # 26 October 2026: [: nt * R] skips the col_refine points appended after the grid
            for k_, j_ in enumerate(gc_): first_.setdefault(int(j_), k_)
            rows_ = st_.get("rows_order", ["roof_centre", "roof_edge", "glass_base", "belt_top", "belt", "door_low", "sill", "fender_inner", "floor_edge", "floor_centre"])
            ce = first_[rows_.index(st_["row"])]; cin = ce + int(st_.get("toward", -1))
            z_ = G_[:, ce, 2]; z0_, z1_ = st_["z"]; idx_ = np.flatnonzero((z_ >= z0_) & (z_ <= z1_)); ns = st_.get("steps", 40)
            pick = idx_[np.unique(np.linspace(0, len(idx_) - 1, ns).astype(int))]
            G = np.zeros((len(pick), 2, 3))
            for ii, i in enumerate(pick):
                Pe, Pc = G_[i, ce], G_[i, cin]; dv = Pc - Pe; dv /= max(np.linalg.norm(dv), 1e-9)
                tz = G_[min(i + 1, nt_ - 1), ce] - G_[max(i - 1, 0), ce]; nv = np.cross(tz, dv); nv /= max(np.linalg.norm(nv), 1e-9)
                if nv[1] < 0: nv = -nv   # outward : upward and outward on the roof rail
                for j, dd in enumerate((st_.get("d0", 0.008), st_.get("d1", 0.036))):
                    G[ii, j] = Pe + dv * dd + nv * st_.get("protrude", 0.004)
            G[..., 0] = np.abs(G[..., 0])
            ns = len(pick)
            for sd, tag in ((1, "L"), (-1, "R")):
                P = G.reshape(-1, 3) * [sd, 1, 1]; b = sum(len(p) for p in allP); allP.append(P)
                for i in range(ns - 1):
                    q = (b + 2 * i, b + 2 * i + 1, b + 2 * i + 3, b + 2 * i + 2); allQ.append(q if sd > 0 else q[::-1]); allN.append("%s_%s" % (nm0, tag))
            continue
        pts = np.array(st_["zy"], float); ns = st_.get("steps", 8)
        wv = np.linspace(st_["w"], st_.get("w_end", st_["w"]), ns) / 2   # 25 October 2026: width may taper along the strip
        t = np.linspace(0, 1, ns); L = np.array([np.interp(t, np.linspace(0, 1, len(pts)), pts[:, k]) for k in (0, 1)]).T
        dv = np.gradient(L, axis=0); nv = np.stack([-dv[:, 1], dv[:, 0]], 1); nv /= np.linalg.norm(nv, axis=1, keepdims=True)
        G = np.zeros((ns, 2, 3)); SF = st_.get("surface_frame", 0)
        if SF: G = surface_strip(ray, bm, L, nv, wv, st_)   # 26 October 2026: strip in the tangent frame of the body surface
        for i in range(0 if SF else ns):
            for j, sgn in enumerate((-1, 1)):
                z, y = L[i] + sgn * wv[i] * nv[i]
                loc, _, _ = ray.intersects_location(np.array([[3.0, y, z]]), np.array([[-1.0, 0, 0]]), multiple_hits=False)
                # 26 October 2026: a ray that misses the near side (glass opening of the body mesh) hits the FAR wall at x < 0 : that is a miss, not a
                # point (the B pillar had a vertex at x = -0.85 and a quad across the whole car, ComponentScore fault). FR : un impact de l'autre côté est un raté.
                hit_ = len(loc) and float(loc[0, 0]) > st_.get("near_x_min", 0.2)
                G[i, j] = ((float(loc[0, 0]) if hit_ else np.nan) + st_.get("protrude", 0.004), y, z)
        for j in range(2):   # 25 October 2026: misses inherit their neighbours (a constant 1.0 made wings on the roof)
            col = G[:, j, 0]; ok_ = np.isfinite(col)
            if ok_.any(): col[~ok_] = np.interp(np.flatnonzero(~ok_), np.flatnonzero(ok_), col[ok_])
            G[:, j, 0] = col
        for sd, tag in ((1, "L"), (-1, "R")):
            P = G.reshape(-1, 3) * [sd, 1, 1]; b = sum(len(p) for p in allP); allP.append(P)
            for i in range(ns - 1):
                q = (b + 2 * i, b + 2 * i + 1, b + 2 * i + 3, b + 2 * i + 2); allQ.append(q if sd > 0 else q[::-1]); allN.append("%s_%s" % (nm0, tag))
    np.savez(out, P=np.concatenate(allP).astype(np.float32), Q=np.array(allQ, np.int32), names=np.array(allN))
    print(json.dumps({"quads": len(allQ), "parts": sorted(set(allN))}))


if __name__ == "__main__":
    main(*sys.argv[1:])
