"""5 November 2026 : COMPONENTSHEET, the HTML sheet of the Dracard components : one card per component with its board (reference left, model right), its status (validated, to validate, to iterate, not started), its HDA and its parameters. Source of truth : components.json (statuses edited there or by telling the agent). Self contained (images embedded). FR : la feuille HTML des composants : une carte par composant avec sa planche, son statut, son HDA et ses paramètres.
Usage : python ComponentSheet.py components.json out.html"""
import sys, json, base64, io, html, datetime
from PIL import Image
D = json.load(open(sys.argv[1])); cards = []; counts = {}
ST = {"validated": ("Validé", "#1f8a4c"), "to_validate": ("À valider", "#b7791f"), "iterate": ("À itérer", "#c0562f"), "todo": ("Pas commencé", "#6b7280")}
for c in D["components"]:
    counts[c["status"]] = counts.get(c["status"], 0) + 1; img = ""
    if c.get("board"):
        im = Image.open(c["board"]).convert("RGB"); im.thumbnail((1300, 700)); b = io.BytesIO(); im.save(b, "JPEG", quality=80); img = '<img src="data:image/jpeg;base64,%s" alt="%s">' % (base64.b64encode(b.getvalue()).decode(), html.escape(c["name"]))
    if c.get("fit"):
        im = Image.open(c["fit"]).convert("RGB"); im.thumbnail((1300, 450)); b = io.BytesIO(); im.save(b, "JPEG", quality=82); img += '<img class=fit src="data:image/jpeg;base64,%s" alt="ajustement">' % base64.b64encode(b.getvalue()).decode()
    lab, col = ST[c["status"]]; params = ""
    if c.get("params"):
        P = json.load(open(c["params"])); params = "".join("<details><summary>%s</summary><div class=pp>%s</div></details>" % (html.escape(g), "".join("<span>%s <b>%s</b></span>" % (html.escape(k), html.escape(str(v))) for k, v in d.items())) for g, d in P.items())
    note = html.escape(c.get("note", "")); hda = html.escape(c.get("hda", ""))
    cards.append('<section class=card data-status="%s"><header><h2>%s</h2><span class=badge style="background:%s">%s</span></header>%s<p class=note>%s</p>%s<p class=hda>%s</p></section>' % (c["status"], html.escape(c["name"]), col, lab, img or '<div class=noimg>Pas encore de planche</div>', note, params, ("HDA : " + hda) if hda else ""))
summary = " · ".join("%s %d" % (ST[k][0], counts.get(k, 0)) for k in ST)
page = """<!doctype html><html lang=fr><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1"><title>Composants Dracard</title>
<style>:root{--bg:#f6f5f2;--card:#fff;--ink:#1d1d1f;--mut:#6b6b70;--line:#e3e1dc}@media (prefers-color-scheme:dark){:root{--bg:#16161a;--card:#202026;--ink:#f1f1f3;--mut:#a0a0a8;--line:#33333b}}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 -apple-system,system-ui,sans-serif}main{max-width:1280px;margin:0 auto;padding:28px 16px 60px}h1{font-size:30px;margin:0 0 4px}.sub{color:var(--mut);margin:0 0 18px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 22px}.filters button{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:7px 14px;font:inherit;cursor:pointer}.filters button.on{background:var(--ink);color:var(--bg)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(520px,1fr));gap:18px}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px}.card header{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}
.card h2{margin:0;font-size:20px}.badge{color:#fff;border-radius:999px;padding:3px 12px;font-size:13px;white-space:nowrap}.card img{width:100%;border-radius:10px;display:block}.card img.fit{margin-top:8px}.noimg{background:var(--bg);border-radius:10px;padding:50px 10px;text-align:center;color:var(--mut)}
.note{color:var(--mut);margin:10px 0 6px;font-size:14px}.hda{font:12px ui-monospace,monospace;color:var(--mut);margin:8px 0 0;word-break:break-all}details{margin-top:6px}summary{cursor:pointer;color:var(--mut);font-size:13px}.pp{display:flex;flex-wrap:wrap;gap:4px 14px;padding:6px 0;font-size:13px}
@media (max-width:560px){.grid{grid-template-columns:1fr}}</style></head><body><main><h1>Composants Dracard</h1><p class=sub>__SUMMARY__ · mis à jour le __DATE__ · chaque composant est un HDA autonome qui s'améliore à chaque itération de ton œil.</p>
<div class=filters><button class=on data-f=all>Tous</button><button data-f=to_validate>À valider</button><button data-f=iterate>À itérer</button><button data-f=validated>Validés</button><button data-f=todo>Pas commencés</button></div><div class=grid>__CARDS__</div></main>
<script>document.querySelectorAll('.filters button').forEach(function(b){b.onclick=function(){document.querySelectorAll('.filters button').forEach(function(x){x.classList.remove('on')});b.classList.add('on');var f=b.dataset.f;document.querySelectorAll('.card').forEach(function(c){c.style.display=(f==='all'||c.dataset.status===f)?'':'none'})}})</script></body></html>"""
MOIS = ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre"]; now = datetime.datetime.now(); date = "%d %s %d, %02d:%02d" % (now.day, MOIS[now.month - 1], now.year, now.hour, now.minute)
open(sys.argv[2], "w").write(page.replace("__SUMMARY__", summary).replace("__DATE__", date).replace("__CARDS__", "\n".join(cards))); print("sheet", len(cards), "cards", counts)
