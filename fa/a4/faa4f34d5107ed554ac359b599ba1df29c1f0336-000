import json, sys, collections
R = [json.loads(l) for l in open(sys.argv[1])]
def row(d):
    if d.get("no_output") or "quads" not in d: return f"| {d['tag']} | {d.get('seconds')} | FAIL rc={d.get('rc')} | | | | | | | | |"
    return f"| {d['tag']} | {d['seconds']} | {d['quads']} | {d.get('patches')} | {100*d['folded_share']:.2f} | {100*d['squashed_share']:.2f} | {100*d['valence4_share']:.1f} | {d['poles_per_1000_quads']} | {1000*d['dev_mean_frac_diag']:.2f} | {1000*d['holes_p99_frac_diag']:.2f} | {d.get('edge_p99_over_mean')} |"
HDR = "| essai | s | quads | patchs | plié % | écrasé % | val4 % | pôles/1000 | écart moy ‰diag | trous p99 ‰ | arête p99/moy |\n|---|---|---|---|---|---|---|---|---|---|---|"
for m in ["arch_hard", "lily_plant", "eucalyptus_tree", "manny_character"]:
    print(f"\n### {m}")
    for p in ("basic", "organic"):
        print(f"\nprep {p}\n{HDR}")
        for d in R:
            if d["mesh"] == m and d["prep"] == p: print(row(d))
    print("\nprep variants (flow de base)\n" + HDR)
    for d in R:
        if d["mesh"] == m and d["tag"] == "base": print(row(dict(d, tag=d["prep"])))
