"""2 November 2026 : the tubes fitted on the frames become the nodes of the series, one chain per part : curve, resample, sweep with Apply Scale Along Curve and its ramp, transform from centroid, mirror, merge, OUT. A part is a spline and a spline of radii, every value stays in its node. FR : les tubes ajustés sur les images deviennent les nodes de la série, une chaîne par partie : courbe, resample, sweep avec son ramp, transform from centroid, miroir, merge, OUT. Une partie est une spline et une spline de rayons, chaque valeur reste dans son node.
    hython TubeBuild.py <fit.json> <out folder> [name]      writes part.obj (with mirrors), half.obj (without), Tubes.hip, report.json"""
import sys, os, json, time
import numpy as np, hou
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__)))); from DragonShape import dense_curve, radius, sheet_rows
D = json.load(open(sys.argv[1])); OUT = sys.argv[2]; NAME = sys.argv[3] if len(sys.argv) > 3 else "Mad_Villain_Tubes"; os.makedirs(OUT, exist_ok=True); GREEN = hou.Color((0.2, 0.7, 0.25)); hou.hipFile.clear(suppress_save_prompt=True); geo = hou.node("/obj").createNode("geo", NAME); T0 = time.time()
def mk(t, label, *inputs, **parms):
    n = geo.createNode(t, label)
    for i, x in enumerate(inputs):
        if x is not None: n.setInput(i, x)
    for k, v in parms.items(): n.parm(k).set(v)
    return n
def curve(tag, pts):
    a = mk("add", f"curve_{tag}", keep=0); a.parm("points").set(len(pts))
    for i, q in enumerate(pts):
        a.parm(f"usept{i}").set(1)
        for k, ax in enumerate("xyz"): a.parm(f"pt{i}{ax}").set(float(q[k]))
    a.parm("prims").set(1); a.parm("prim0").set(f"0-{len(pts) - 1}"); a.parm("closed0").set(0); return a
halves, parts = [], []
for t in D["tubes"]:
    tag = t["name"]
    if t.get("kind") == "obj":      # 2 November 2026 : a finished part comes in with its size and place. FR : une partie finie entre avec sa taille et sa place.
        xf = t.get("xform", [0, 0, 0, 1]); f_ = mk("file", f"file_{tag}", file=os.path.abspath(t["file"])); f_.setColor(GREEN); x = mk("xform", f"transform_{tag}", f_, tx=xf[0], ty=xf[1], tz=xf[2], scale=xf[3]); o = mk("null", f"OUT_{tag.upper()}", x); o.setColor(GREEN); halves.append(o); parts.append(o); continue
    if t.get("kind") == "sheet":      # 2 November 2026 : the membrane : curves between two edges, a Skin, a thin Poly Extrude, as ep05 builds it. FR : la membrane : des courbes entre deux bords, un Skin, un Poly Extrude fin, comme l'ep05 la construit.
        rows = sheet_rows(t); cs = [curve(f"{tag}_{i}", r) for i, r in enumerate(rows)]; mg = mk("merge", f"merge_{tag}", *cs); sk = mk("skin", f"skin_{tag}", mg); ex = mk("polyextrude::2.0", f"polyextrude_{tag}", sk, dist=D.get("sheet_thickness", 0.012), outputback=1, extrusionmode="pointnormal"); o = mk("null", f"OUT_{tag.upper()}", ex); o.setColor(GREEN); halves.append(o); parts.append(mk("mirror", f"mirror_{tag}", o, dirx=1, diry=0, dirz=0) if t.get("mirror") else o); continue
    n = t.get("stations", 40); c = curve(tag, dense_curve(t["pts"], n)); keys = np.linspace(0, 1, 33); val = radius(t, 33) / t.get("radius", 1.0); s = mk("sweep::2.0", f"sweep_{tag}", c, surfaceshape="tube", surfacetype="quads", endcaptype="grid", radius=t.get("radius", 1.0), cols=t.get("cols", 20), applyscale=1); s.parm("scaleramp").set(hou.Ramp([hou.rampBasis.CatmullRom] * 33, keys.tolist(), val.tolist())); x = s
    if t.get("flatten"): k = np.mean(np.asarray(t["pts"], float), 0); x = mk("xform", f"transform_from_centroid_{tag}", s, sx=t["flatten"][0], sy=t["flatten"][1], sz=t["flatten"][2], px=float(k[0]), py=float(k[1]), pz=float(k[2]))
    o = mk("null", f"OUT_{tag.upper()}", x); o.setColor(GREEN); halves.append(o); parts.append(mk("mirror", f"mirror_{tag}", o, dirx=1, diry=0, dirz=0) if t.get("mirror") else o)
mh = mk("merge", "merge_half", *halves); m = mk("merge", "merge_all", *parts); ou = mk("null", "OUT_ALL", m); ou.setColor(GREEN); ou.setDisplayFlag(True); ou.setRenderFlag(True); geo.layoutChildren(); ou.geometry().saveToFile(f"{OUT}/part.obj"); mh.geometry().saveToFile(f"{OUT}/half.obj"); errs = [n.path() + " : " + n.errors()[0][:100] for n in geo.children() if n.errors()]; hou.hipFile.save(f"{OUT}/Tubes.hip"); g = ou.geometry(); rep = dict(tubes=len(D["tubes"]), nodes=len(geo.children()), points=len(g.points()), quads=float(np.mean([len(p.vertices()) == 4 for p in g.prims()])), errors=errs, seconds=round(time.time() - T0, 1)); json.dump(rep, open(f"{OUT}/report.json", "w"), indent=0); print(json.dumps(rep))
