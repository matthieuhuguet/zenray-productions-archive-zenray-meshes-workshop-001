"""28 October 2026 : ZenRay Meshes CAGE FIT (task K1a, the Maya way) : the body as ONE subdivision cage whose edge loops follow the
curves. The rig curves (clean NURBS) are re-sampled at the cage spacing (cage_m, about 8 cm, opposite sides matched again), the Coons and
crown positions are the targets, design curves are creased (sharp), and the cage is moved until its subdivision limit passes through the
targets (inverse subdivision : cage += target - limit, iters times, three Catmull Clark levels as the limit). Patch borders are now inner
loops of one mesh, so the surface stays smooth across them (a Coons loft only matches positions there, hence the pinches).
python CageFit.py <rig.json> <out.npz> [--cage-m 0.08] [--iters 12] [--levels 3]
FR : la caisse en une cage de subdivision dont les boucles suivent les courbes, ajustée pour passer par elles."""
import argparse, json, os, sys
from collections import defaultdict
import numpy as np
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE); sys.path.insert(0, os.path.join(os.path.dirname(HERE), "retopo"))
import RigLib as RL
import RetopoMethods as M
from PatchNet import Net


def coarse_counts(rig, cage_m):
    """Re-solve the interval counts for the cage spacing on the clean curves (same patch table)."""
    net = Net(cage_m, 0.012); C = np.array(rig["controls"], float)
    for k, v in rig["nodes"].items(): net.node(k, C[v])
    vname = {v: k for k, v in rig["nodes"].items()}
    for name, c in rig["curves"].items():
        a, b = vname[c["cvs"][0]], vname[c["cvs"][-1]]; poly = RL.evaluate(C[c["cvs"]], 200)
        net.edge(name, a, b, poly, fixed=c["fixed"], sharp=c["sharp"], samples=(None if not c.get("fracs") else poly[[int(round(f * 199)) for f in c["fracs"]]]))
    for p in rig["patches"]: net.patch(p["name"], *p["S"])
    net.solve_counts(min_across_sharp=2); return {k: int(e["n"]) for k, e in net.edges.items()}


def subdivide(P, Q, sharp, levels):
    sh = set(map(tuple, sharp))
    for _ in range(levels): P, Q, sh = M._cc(P, Q, sh)
    return P, Q


def smooth_field(r, Q, sharp, passes, w):
    """Laplacian smoothing of a per vertex field over the cage graph ; a crease vertex averages only along its crease (28 October 2026,
    Matthieu's rule of smooth curves : the fit corrects the low frequencies and never injects a ripple)."""
    nb = [set() for _ in range(len(r))]; sh = set(map(tuple, map(sorted, sharp))); onc = np.zeros(len(r), bool)
    for a, b in sh: onc[a] = onc[b] = True
    for q in Q:
        for k in range(len(q)):
            a, b = int(q[k]), int(q[(k + 1) % len(q)]); nb[a].add(b); nb[b].add(a)
    nbs = [np.array(sorted(x if not onc[i] else {j for j in x if tuple(sorted((i, j))) in sh} or x)) for i, x in enumerate(nb)]
    for _ in range(passes):
        m = np.array([r[x].mean(0) if len(x) else r[i] for i, x in enumerate(nbs)]); r = (1 - w) * r + w * m
    return r


def fair_solve(T, Q, sharp, grids, Xfix, fix, beta):
    """28 October 2026 : one fair surface through the curve network, the way a surface modeler fairs it. The fixed vertices (every curve
    with fix = all ; with fix = sharp, the creases, the open borders and the patch corners only) keep their place, the others minimise the
    bending energy sum |L x|^2 over the whole cage plus beta |x - T|^2 (T, the Coons loft, only as a weak guide). The Laplacian rows of crease
    vertices are left out, so a crease stays a crease while every other curve is crossed with a continuous tangent : no patch is crowned on
    its own any more, which made the sections scalloped (one bump per patch). FR : une seule surface lisse à travers le réseau de courbes."""
    import scipy.sparse as sp, scipy.sparse.linalg as spl
    n = len(T); E = defaultdict(int); nb = [set() for _ in range(n)]
    for q in Q:
        for k in range(4):
            a, b = int(q[k]), int(q[(k + 1) % 4]); E[(min(a, b), max(a, b))] += 1; nb[a].add(b); nb[b].add(a)
    sharp_v = {int(v) for e in sharp for v in e}; border = set(); corners = set()
    for _, G in grids:
        for e in (G[:, 0], G[:, -1], G[0, :], G[-1, :]): border |= set(map(int, e))
        corners |= {int(G[0, 0]), int(G[0, -1]), int(G[-1, 0]), int(G[-1, -1])}
    open_v = {v for e, c in E.items() if c == 1 for v in e}
    fixed = sorted(border if fix == "all" else (sharp_v | open_v | corners)); isfix = np.zeros(n, bool); isfix[fixed] = True
    r, c, v = [], [], []
    for i in range(n):
        if i in sharp_v or not nb[i]: continue
        d = len(nb[i]); r.append(i); c.append(i); v.append(1.0)
        for j in nb[i]: r.append(i); c.append(j); v.append(-1.0 / d)
    L = sp.csr_matrix((v, (r, c)), shape=(n, n)); K = (L.T @ L).tocsr(); fr = np.nonzero(~isfix)[0]; fx = np.nonzero(isfix)[0]
    A = (K[fr][:, fr] + beta * sp.identity(len(fr))).tocsc(); B = K[fr][:, fx]; X = T.copy(); X[fx] = Xfix[fx]
    lu = spl.splu(A)
    for k in range(3): X[fr, k] = lu.solve(beta * T[fr, k] - B @ X[fx, k])
    return X, isfix


def main(rig_path, out, cage_m, iters, levels, mode="interp", passes=6, w=0.5, fix="all", beta=0.05):
    rig = json.load(open(rig_path)); rig = dict(rig); rig["counts"] = coarse_counts(rig, cage_m)
    T, Q, sharp, lines, grids = RL.loft(rig); cage = T.copy(); n = len(cage); hist = []
    if mode == "fair":
        cage, isfix = fair_solve(T, Q, sharp, grids, T, fix, beta)
        for it in range(iters):   # the limit passes through the fixed curves ; the inside is faired again around them
            S, _ = subdivide(cage, Q, sharp, levels); L = S[:n]; r = np.where(isfix[:, None], T - L, 0.0); hist.append(round(float(np.abs(r).max() * 1000), 2))
            cage, _ = fair_solve(T, Q, sharp, grids, cage + r, fix, beta)
        S, QS = subdivide(cage, Q, sharp, levels)
        np.savez(out, cage=cage, Qc=np.array(Q), sharp=np.array(sharp), P=S, Q=np.array(QS))
        print(json.dumps({"cage_quads": len(Q), "cage_verts": n, "fixed": int(isfix.sum()), "subd_quads": len(QS), "residual_max_mm_per_iter": hist})); return
    for it in range(iters if mode != "none" else 0):
        S, _ = subdivide(cage, Q, sharp, levels); L = S[:n]; r = T - L
        if mode == "smooth": r = smooth_field(r, Q, sharp, passes, w)
        cage = cage + r; hist.append(round(float(np.abs(T - L).max() * 1000), 2))
    S, QS = subdivide(cage, Q, sharp, levels)
    np.savez(out, cage=cage, Qc=np.array(Q), sharp=np.array(sharp), P=S, Q=np.array(QS))
    print(json.dumps({"cage_quads": len(Q), "cage_verts": n, "subd_quads": len(QS), "residual_max_mm_per_iter": hist}))


if __name__ == "__main__":
    ap = argparse.ArgumentParser(); ap.add_argument("rig"); ap.add_argument("out"); ap.add_argument("--cage-m", type=float, default=0.08)
    ap.add_argument("--iters", type=int, default=6); ap.add_argument("--levels", type=int, default=3)
    # 28 October 2026 : fair by default (sections 4 -> 8 / 14 fair, folds max 10.8 -> 6.1 deg, same distance to the sculpt)
    ap.add_argument("--mode", default="fair", choices=["interp", "smooth", "none", "fair"]); ap.add_argument("--passes", type=int, default=6); ap.add_argument("--w", type=float, default=0.5)
    ap.add_argument("--fix", default="sharp", choices=["all", "sharp"]); ap.add_argument("--beta", type=float, default=0.05)   # 28 October 2026 : 19 / 23 sections fair (crowns kept for the shape)
    a = ap.parse_args(); main(a.rig, a.out, a.cage_m, a.iters, a.levels, a.mode, a.passes, a.w, a.fix, a.beta)
