print(json.dumps({"arch": [round(float(cz), 3), round(float(cy), 3), round(float(R), 3)], "faces_per_side": len(S), "open": sum(c == 1 for c in E2.values()), "nonmanifold": sum(c > 2 for c in E2.values())}))
