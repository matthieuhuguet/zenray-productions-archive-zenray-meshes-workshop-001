"""Pass 9 : straightening of the quads inside patches that are exact primitives (plane, cylinder, cone). Written 30 October 2026.
Usage : python3 -I run_prim_straighten.py items=DIR:name,DIR:name out=res.json [tolf=0.02]
For every patch whose triangles lie within tolf quad edges of a plane, a cylinder or a cone : the quads of the QuadWild patch are mapped by the isometric chart
(development), the interior vertices are re-solved in the chart (Tutte on the grid graph, then Winslow barrier with the patch boundary fixed, equal area target),
and lifted back by the inverse chart : interior vertices lie EXACTLY on the primitive and the topology and the boundary are untouched.
FR : redressement des quads a l'interieur des patchs qui sont des primitives exactes, dans la carte isometrique, bord et topologie inchanges."""
import sys, json, collections
sys.path.insert(0, ".")
import numpy as np
import zr8_io as IO, zr8_layout as L, zr8_judge as J, zr8_prims as PR, zr8_localrepair as LR, zr8_fill as Fm, zr8_straighten as S, layout_probe as LP

a = dict(kv.split("=", 1) for kv in sys.argv[1:]); tolf = float(a.get("tolf", "0.02")); out = {}


def mean_edge_quad(P, Q):
    return float(np.mean([np.linalg.norm(P[Q[:, k]] - P[Q[:, (k + 1) % 4]], axis=1).mean() for k in range(4)]))


def metrics(P, Q, ref, qsel=None):
    j = J.judge_plus(P, Q, ref_tris=ref); Jc = J.corner_jacobians(P, Q); Jm = Jc.min(axis=1)
    r = {"folded": int((Jm < 0).sum()), "squashed": int((Jm < 0.3).sum()), "jac_mean": round(j["jac_mean"], 4), "angle_dev": round(j["angle_dev_mean_deg"], 2),
         "turn_iso": round(j["loop_turn_iso_mean_deg"], 2), "turn_iso_p90": round(j["loop_turn_iso_p90_deg"], 2), "dist_to_input_frac_diag": round(j["dist_mean_frac_diag"], 6)}
    if qsel is not None and len(qsel):
        ang = np.degrees(np.arccos(np.clip(np.stack([np.einsum("ij,ij->i", P[Q[qsel, (k + 1) % 4]] - P[Q[qsel, k]], P[Q[qsel, (k - 1) % 4]] - P[Q[qsel, k]]) /
              np.maximum(np.linalg.norm(P[Q[qsel, (k + 1) % 4]] - P[Q[qsel, k]], axis=1) * np.linalg.norm(P[Q[qsel, (k - 1) % 4]] - P[Q[qsel, k]], axis=1), 1e-30) for k in range(4)]), -1, 1)))
        r["patch_quads"] = int(len(qsel)); r["patch_angle_dev"] = round(float(np.abs(ang - 90).mean()), 2); r["patch_folded"] = int((Jm[qsel] < 0).sum()); r["patch_squashed"] = int((Jm[qsel] < 0.3).sum())
        r["patch_jac_min"] = round(float(Jm[qsel].min()), 4); r["patch_jac_mean"] = round(float(Jm[qsel].mean()), 4)
    return r


for item in a["items"].split(","):
    d, name = item.rsplit(":", 1); pre = "%s/%s_rem_p0" % (d, name)
    lay = L.Layout(pre); dump = LP.read_dump(pre + "_123_dump.txt"); qpart = dump["qpart"]
    V, F = IO.read_obj_tri_or_quad(pre + ".obj"); ref = (np.array(V), np.array(F))
    res = {"name": name, "patches": lay.npatch}
    for label, qf_file in (("raw", pre + "_123_quadrangulation.obj"), ("smooth", pre + "_123_quadrangulation_smooth.obj")):
        P, Q = IO.read_obj_tri_or_quad(qf_file); P = np.array(P); Q = np.array(Q); h = mean_edge_quad(P, Q)
        cls = PR.classify_patches(lay, tolf * h); kinds = collections.Counter(c[1] for c in cls.values())
        P2 = P.copy(); sel = []; skipped = 0; chart_err = []; moved = []
        for p, (ch, kind, resid) in cls.items():
            if ch is None: continue
            qf = qpart[p]; loop = LR.patch_loop(Q, qf)
            if loop is None or len(qf) < 4: skipped += 1; continue
            verts = np.unique(Q[qf].ravel()); loc = {int(v): i for i, v in enumerate(verts)}
            uv = ch.fwd(P[verts]); chart_err.append(float(np.abs(ch.inv(uv) - P[verts]).max()))
            quads = np.array([[loc[int(x)] for x in Q[f]] for f in qf]); isb = np.zeros(len(verts), bool)
            for v in loop: isb[loc[int(v)]] = True
            if isb.all(): continue
            c2 = lambda A, B: A[:, 0] * B[:, 1] - A[:, 1] * B[:, 0]
            area = 0.5 * np.sum(c2(uv[quads[:, 1]] - uv[quads[:, 0]], uv[quads[:, 2]] - uv[quads[:, 0]]) + c2(uv[quads[:, 2]] - uv[quads[:, 0]], uv[quads[:, 3]] - uv[quads[:, 0]]))
            flip = area < 0
            if flip: uv[:, 1] *= -1
            uvh = Fm.harmonic_uv(uv.copy(), quads, set(np.where(isb)[0].tolist()))
            P3 = np.c_[uvh, np.zeros(len(uvh))]; kind_v = np.zeros(len(uvh), int); kind_v[isb] = 2
            P3, _ = S.barrier(P3, quads, Fm.PlaneSurface(), kind=kind_v, outer=5, inner=60, theta=1.0 / 8, size="patch", groups=np.zeros(len(quads), int))
            uvn = P3[:, :2].copy()
            if flip: uvn[:, 1] *= -1
            X = ch.inv(uvn)
            # accept only if it does not create folds in the patch
            Pt = P2.copy(); Pt[verts[~isb]] = X[~isb]
            j0 = LR.corner_j_all(P, Q[qf]); j1 = LR.corner_j_all(Pt, Q[qf])
            if (j1 < 0).sum() > (j0 < 0).sum() or j1.min() < min(j0.min(), 0.0) - 1e-9:
                skipped += 1; continue
            P2 = Pt; sel += list(qf); moved.append(float(np.linalg.norm(P2[verts[~isb]] - P[verts[~isb]], axis=1).max()) / h)
        sel = np.array(sorted(set(sel)), int)
        res[label] = {"h": round(h, 5), "patch_kinds": dict(kinds), "quads": int(len(Q)), "quads_in_primitive_patches": int(len(sel)), "patches_rejected_or_skipped": skipped,
                      "chart_roundtrip_max_err_over_h": round(max(chart_err) / h, 6) if chart_err else None, "interior_displacement_max_over_h": round(max(moved), 3) if moved else None,
                      "before": metrics(P, Q, ref, sel), "after": metrics(P2, Q, ref, sel)}
        print(name, label, json.dumps(res[label]), flush=True)
    out[name] = res
json.dump(out, open(a["out"], "w"), indent=1)
