}


def self_crossing(cp, closed=True, step=4):
    """True when the polyline crosses itself (segments that are not neighbours intersect)."""
    q = cp[::step]
    if closed:
        q = np.r_[q, q[:1]]
    a, b = q[:-1], q[1:]
    n = len(a)
    for i in range(n):
        j = np.arange(i + 2, n)
        if closed and i == 0:
            j = j[j != n - 1]
        if not len(j):
            continue
        p1, p2, p3, p4 = a[i], b[i], a[j], b[j]
        d1 = (p4[:, 0] - p3[:, 0]) * (p1[1] - p3[:, 1]) - (p4[:, 1] - p3[:, 1]) * (p1[0] - p3[:, 0])
        d2 = (p4[:, 0] - p3[:, 0]) * (p2[1] - p3[:, 1]) - (p4[:, 1] - p3[:, 1]) * (p2[0] - p3[:, 0])
        d3 = (p2[0] - p1[0]) * (p3[:, 1] - p1[1]) - (p2[1] - p1[1]) * (p3[:, 0] - p1[0])
        d4 = (p2[0] - p1[0]) * (p4[:, 1] - p1[1]) - (p2[1] - p1[1]) * (p4[:, 0] - p1[0])
        if np.any((d1 * d2 < 0) & (d3 * d4 < 0)):
            return True
    return False


def patient_chain(pts, closed, corners=None, data=None, tol=None, smooth_px=3.0, wave_window_px=8.0):
    pts = np.asarray(pts, np.float64)
    mode = 'wrap' if closed else 'nearest'
    cset = set(corners or []) | (set() if closed else {0, len(pts) - 1})
    ref = pts if data is None else np.asarray(data, np.float64)
    dat = ref[::max(len(ref) // 1500, 1)]
    tried, best = [], None
    for n_total in range(max(len(cset) + 2, 4), P['max_anchors'] + 1):
        for sp in P['smooth_px']:
            sm = np.c_[ndi.gaussian_filter1d(pts[:, 0], sp / 0.5, mode=mode), ndi.gaussian_filter1d(pts[:, 1], sp / 0.5, mode=mode)]
            idx = S._spread(sm, closed, sorted(cset), n_total)
            kinds = ['corner' if i in cset else 'smooth' for i in idx]
            u0, sc = S._chain_seed(sm, idx, kinds, closed)

            def res(v):
                cp, cn = S.sample_path(S._chain_anchors(u0 + v * sc, kinds), closed, 0.25, True)
                return S.signed_dist(cp, cn, dat)[0]
            sol = least_squares(res, np.zeros(len(u0)), loss='soft_l1', f_scale=0.5, diff_step=1e-2, max_nfev=P['max_nfev'])
            an = S._chain_anchors(u0 + sol.x * sc, kinds)
            cp, cn = S.sample_path(an, closed, 0.25, True)
            r = S.signed_dist(cp, cn, ref)[0]
            sig = 1.4826 * np.median(np.abs(r - np.median(r))) + 0.05
            keep = np.abs(r) < max(3.0 * sig, 2.0 * (tol or 0.6))
            wave = float(np.abs(ndi.median_filter(r, size=int(wave_window_px / 0.5) + 1, mode=mode)).max())
            from scipy.spatial import cKDTree
            spur = float(cKDTree(ref).query(cp)[0].max())
            cross = self_crossing(cp, closed)
            pf = {'anchors': len(an), 'rms_px': float(np.sqrt((r[keep] ** 2).mean())), 'inliers': float(keep.mean()),
                  'p95_px': float(np.percentile(np.abs(r), 95)), 'max_px': float(np.abs(r).max()), 'wave_px': wave, 'smooth_px': sp,
                  'spur_px': spur, 'self_crossing': bool(cross)}
            tried.append(pf)
            print('  chain %2d anchors, smoothing %.1f: rms %.3f inliers %.3f wave %.3f spur %.2f crossing %s' % (len(an), sp, pf['rms_px'], pf['inliers'], wave, spur, cross), flush=True)
            v5 = Gates.v5_fair({'kind': 'path', 'closed': closed, 'anchors': an, 'proofs': {'form': 'chain'}}, Gates.PROTOCOL['gates']['V5_fair'])
            pf['inflections'] = v5['inflections']
            ok = pf['rms_px'] <= P['rms_max_px'] and pf['inliers'] >= P['inliers_min'] and wave <= P['wave_max_px'] and spur <= P['spur_max_px'] and not cross and v5['ok']
            rank = (not ok, spur > P['spur_max_px'] or cross, not v5['ok'], wave)
            if best is None or rank < best[3]:
                best = (an, pf, ok, rank)
            if ok:
                break
        if best[2]:
            break
    an, pf, ok, _ = best
    return {'kind': 'path', 'closed': closed, 'prim': None, 'anchors': an,
            'proofs': dict(pf, form='chain', fitter='HaunchDraw.patient_chain', passed=ok,
                           tried=[(t['anchors'], round(t['rms_px'], 3), round(t['wave_px'], 3)) for t in tried])}


