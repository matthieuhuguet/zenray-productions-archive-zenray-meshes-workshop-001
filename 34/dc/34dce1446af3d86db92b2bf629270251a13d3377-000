def line_arc(aid, a, b, pa, pb, **kw):
    P0, P1 = np.array(pa, float), np.array(pb, float)
    return dict({"id": aid, "a": a, "b": b, "closed": False, "ctrl": [(P0 + (P1 - P0) * t).tolist() for t in (0, 1 / 3, 2 / 3, 1)], "mirror": -1}, **kw)


def write_tri_obj(path, V, F):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        for v in V: fh.write("v %.6f %.6f %.6f\n" % tuple(v))
        for f in F: fh.write("f %d %d %d\n" % tuple(i + 1 for i in f))
    return path


def cube_case(h=0.5):
    V = [(x, y, z) for x in (-h, h) for y in (-h, h) for z in (-h, h)]             # 8 nodes, id = 4x + 2y + z with bits
    quads = [(0, 1, 3, 2), (4, 6, 7, 5), (0, 4, 5, 1), (2, 3, 7, 6), (0, 2, 6, 4), (1, 5, 7, 3)]   # faces, any winding : the reference fixes outward
    tri = []
    for q in quads:                                                                  # outward winding : flip when the normal points to the centre
        a, b, c, d = (np.array(V[i]) for i in q); n = np.cross(b - a, c - a); cen = (a + b + c + d) / 4
        order = (q[0], q[1], q[2], q[3]) if n @ cen > 0 else (q[0], q[3], q[2], q[1])
        tri += [(order[0], order[1], order[2]), (order[0], order[2], order[3])]
    obj = write_tri_obj(f"{WORK}/test_cube_ref.obj", V, tri)
    edges = [(i, j) for i in range(8) for j in range(i + 1, 8) if bin(i ^ j).count("1") == 1]
    doc = {"version": 1, "units": "m", "nodes": [{"id": i, "p": list(V[i])} for i in range(8)],
           "arcs": [line_arc(k, i, j, V[i], V[j]) for k, (i, j) in enumerate(edges)], "components": []}
    return doc, obj


def layout_of(res):
    """The count layout rebuilt from a build() answer (independent of the solver) : lengths from the faces, counts from the answer."""
    return res


def test_a():
    doc, obj = cube_case(); t = time.time()
    r = NM.build(doc, {"ref": obj, "edge_m": 0.05, "write_obj": True}); s = r["stats"]
    ok = (s["faces_total"] == 6 and s["faces_meshed"] == 6 and s["quads"] == 6 * 20 * 20 and s["vertices"] == 6 * 19 * 19 + 12 * 19 + 8
          and s["welded"] and s["manifold"] and s["closed"] and s["euler_mesh"] == 2 and s["min_jac"] > 0.5 and s["folded_quads"] == 0)
    print("(a) cube : faces %d meshed %d, quads %d, vertices %d, welded %s manifold %s closed %s, Euler %s, min Jacobian %.3f, %.2fs -> %s"
          % (s["faces_total"], s["faces_meshed"], s["quads"], s["vertices"], s["welded"], s["manifold"], s["closed"], s["euler_mesh"], s["min_jac"], time.time() - t, "GREEN" if ok else "RED"))
    return ok, r


def test_b(r=None):
    doc, obj = cube_case(); net = NM.Net(doc, obj, {"edge_m": 0.05}); net.trace(); net.corners(); net.counts()
    arcs = sorted({h[0] for f in net.faces if f["status"] == "ok" for s in f["sides"] for h in s})
    L = {"arcs": {a: net.arcs[a]["len"] for a in arcs}, "mirror": [],
         "patches": [{"name": f["id"], "sides": [[h[0] for h in s] for s in f["sides"]]} for f in net.faces if f["status"] == "ok"]}
    good = not CT.check(L, net.counts_by_arc)
    broken = dict(net.counts_by_arc); broken[arcs[0]] += 1; red = bool(CT.check(L, broken))
    # the other direction of the verifier on the mesh : drop one quad of a built mesh -> the mesh checker must see a hole (boundary edges)
    res = NM.build(doc, {"ref": obj, "edge_m": 0.05, "write_obj": False}); net2 = NM.Net(doc, obj, {"edge_m": 0.05}); net2.trace(); net2.corners(); net2.counts(); net2.fill(); net2.conform()
    net2.Q = net2.Q[1:]; net2.face_of_quad = net2.face_of_quad[1:]; net2.judge(); hole = net2.stats["boundary_edges"] > 0 and not net2.stats["closed"]
    ok = good and red and hole
    print("(b) red case : solved counts pass %s ; one count +1 flagged %s ; mesh with a quad removed reports %d boundary edges (closed %s) -> %s"
          % (good, red, net2.stats["boundary_edges"], net2.stats["closed"], "GREEN" if ok else "RED"))
    return ok


def plane_case():
    h = 2.0
    obj = write_tri_obj(f"{WORK}/test_plane_ref.obj", [(-h, -h, 0), (h, -h, 0), (h, h, 0), (-h, h, 0)], [(0, 1, 2), (0, 2, 3)])
    tri = [(0.0, 0.0), (0.4, 0.0), (0.2, 0.35)]; R = 0.3; pent = [(0.9 + R * math.cos(2 * math.pi * k / 5 + 0.3), 0.9 + R * math.sin(2 * math.pi * k / 5 + 0.3)) for k in range(5)]
    nodes, arcs = [], []
    for base, poly in ((0, tri), (10, pent)):
        for k, (x, y) in enumerate(poly): nodes.append({"id": base + k, "p": [x, y, 0.0]})
        for k in range(len(poly)):
            i, j = base + k, base + (k + 1) % len(poly)
            arcs.append(line_arc(len(arcs), i, j, [*poly[k], 0.0], [*poly[(k + 1) % len(poly)], 0.0]))
    return {"version": 1, "units": "m", "nodes": nodes, "arcs": arcs, "components": []}, obj


def valences(net):
    cnt = collections.Counter(int(i) for q in net.Q for i in set(q)); nb = collections.defaultdict(set)
    for q in net.Q:
        for k in range(4): nb[int(q[k])].add(int(q[(k + 1) % 4])); nb[int(q[k])].add(int(q[(k - 1) % 4]))
    return {v: len(s) for v, s in nb.items()}


def test_c():
    doc, obj = plane_case(); net = NM.Net(doc, obj, {"edge_m": 0.04, "corner_deg": 35}); net.trace(); net.corners(); net.counts(); net.fill(); net.conform(); net.judge()
    meshed = [f for f in net.faces if f["status"] == "meshed"]; sides = sorted(len(f["sides"]) for f in meshed)
    val = valences(net); interior_poles = sorted(v for vi, v in val.items() if not net.fixed_v[vi] and v != 4)
    s = net.stats
    ok = sides == [3, 5] and interior_poles == [3, 5] and s["folded_quads"] == 0 and s["manifold"] and s["welded"] and s["min_jac"] > 0.05
    print("(c) flat plane : meshed faces with sides %s, interior poles (valence) %s, quads %d, folded %d, min Jacobian %.3f, manifold %s -> %s"
          % (sides, interior_poles, s["quads"], s["folded_quads"], s["min_jac"], s["manifold"], "GREEN" if ok else "RED"))
    for f in meshed: print("      face %d : %d sides, side counts %s, quads %d, min_jac %.3f" % (f["id"], len(f["sides"]), f["side_counts"], f["quads"], f["min_jac"]))
    return ok


def test_d():
    doc = json.load(open(f"{ROOT}/lines/data/lines.json")); t = time.time()
    rep = NM.doctor(doc); t_doc = time.time() - t
    print("(d) real car : doctor %.2fs, issues by kind %s, arcs %d -> %d" % (t_doc, rep["counts_by_kind"], rep["arcs_in"], rep["arcs_out"]))
    t = time.time(); r = NM.build(rep["fixed"]); dt = time.time() - t; s = r["stats"]
    print("    faces total %d, meshed %d, skipped %d %s, infeasible %d ; quads %d, vertices %d ; min Jacobian %.3f, folded quads %d, max edge ratio %.1f"
          % (s["faces_total"], s["faces_meshed"], s["faces_skipped"], s["skipped_reasons"], s["faces_infeasible"], s["quads"], s["vertices"], s["min_jac"], s["folded_quads"], s["max_edge_ratio"]))
    print("    welded %s manifold %s closed %s, non manifold edges %d, duplicate vertices %d, boundary edges %d ; Euler of the network %s ; time %.2fs %s"
          % (s["welded"], s["manifold"], s["closed"], s["non_manifold_edges"], s["duplicate_vertices"], s["boundary_edges"], s["euler_network"], dt, {k: round(v, 2) for k, v in s["timing"].items()}))
    bad = [f for f in r["faces"] if f["status"] == "meshed" and not f.get("judge_ok", True)]
    print("    meshed faces failing the judge : %d of %d" % (len(bad), s["faces_meshed"]))
    ok = s["faces_meshed"] > 0 and s["non_manifold_edges"] == 0 and dt < 15.0
    print("    -> %s" % ("GREEN" if ok else "RED"))
    return ok, r


def test_e():
    doc, obj = cube_case(); h = 0.5
    doc["component_seeds"] = [{"name": "roof", "p": [0.0, 0.0, 2.0]}, {"name": "floor", "p": [0.1, -3.0, 0.0]}, {"name": "roof_extra", "p": [0.2, 0.1, 5.0]}]
    # cube nodes bits : id = 4x + 2y + z ; axes here are x, y, z of the node coordinates, so +z face = nodes with z = +h
    r = NM.build(doc, {"ref": obj, "edge_m": 0.1, "write_obj": True, "out_dir": WORK}); comp = {f["id"]: f.get("component") for f in r["faces"]}
    named = collections.Counter(v for v in comp.values() if v); extra = [f.get("extra_seeds") for f in r["faces"] if f.get("extra_seeds")]
    txt = open(r["obj_path"]).read(); groups = [l.split()[1] for l in txt.splitlines() if l.startswith("g ")]
    ok = named.get("roof") == 1 and named.get("floor") == 1 and "roof_extra" not in named and extra == [["roof_extra"]] and "roof" in groups and "floor" in groups \
        and sum(1 for g in groups if g.startswith("face_")) == 4 and sum(1 for v in comp.values() if v is None) == 4
    print("(e) seeds : components %s, extra seeds %s, obj groups %s -> %s" % (dict(named), extra, groups, "GREEN" if ok else "RED"))
    return ok


def test_f():
    """Face options : skip, edge_scale, rotate, explicit corners, on the triangle + pentagon plane network (face ids from a first run)."""
    doc, obj = plane_case(); base = NM.build(doc, {"ref": obj, "edge_m": 0.04, "write_obj": False})
    ids = {len(f["sides"]): f["id"] for f in base["faces"] if f["status"] == "meshed"}; tri, pent = ids[3], ids[5]
    b_tri = sum(base["stats"]["counts"] and [c for a, c in base["arc_counts"].items() if int(a) < 3]); b_pent = sum(c for a, c in base["arc_counts"].items() if int(a) >= 3)
    o1 = NM.build(doc, {"ref": obj, "edge_m": 0.04, "write_obj": False, "face_options": {str(tri): {"edge_scale": 2.0}, pent: {"skip": True}}})
    st = {f["id"]: (f["status"], f["reason"]) for f in o1["faces"]}; c_tri = sum(c for a, c in o1["arc_counts"].items() if int(a) < 3)
    o2 = NM.build(doc, {"ref": obj, "edge_m": 0.04, "write_obj": False, "face_options": {str(pent): {"rotate": 2}, str(tri): {"rotate": 1}}})
    sides2 = {f["id"]: f.get("n_sides") for f in o2["faces"] if f["status"] == "meshed"}
    cn = [f["corners"] for f in base["faces"] if f["id"] == pent][0]
    o3 = NM.build(doc, {"ref": obj, "edge_m": 0.04, "write_obj": False, "face_options": {str(pent): {"corners": cn[:4]}}})
    sides3 = {f["id"]: f.get("n_sides") for f in o3["faces"] if f["status"] == "meshed"}
    ok = (st[pent] == ("skipped", "user") and c_tri < b_tri and sides2.get(tri) == 3 and sides2.get(pent) == 4 and sides3.get(pent) == 4
          and all(o["stats"]["manifold"] and o["stats"]["folded_quads"] == 0 for o in (o1, o2, o3)))
    print("(f) face options : skip -> %s ; edge_scale 2 lowers the triangle edge count %d -> %d ; rotate (triangle stays 3, pentagon becomes 4) %s ; 4 explicit corners on the pentagon -> %s -> %s"
          % (st[pent], b_tri, c_tri, sides2, sides3, "GREEN" if ok else "RED"))
    return ok


