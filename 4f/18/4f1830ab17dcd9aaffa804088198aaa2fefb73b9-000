"""1 November 2026, 19:30 : M22 rebuild the past versions of the masks with the settings they had, so the document can show the evolution : each step overlays its settings on the projects, reruns what they change and takes a snapshot ; the settings are always restored. Used once, kept for the next time a setting family must be compared.
    python -I MicroReplay.py
FR : reconstruit les anciennes versions des masques avec leurs réglages de l'époque, pour montrer l'évolution dans le document."""
import sys, json, subprocess
from concurrent.futures import ThreadPoolExecutor
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"; PY = sys.executable; S = ROOT + "/Scripts/micro/"; CAR, MAN, TRU = "06_Car", "07_Manny", "08_CarTruth"
OLD_CONTOUR = dict(R_mask_mirror=0, R_ground_open_px=0, R_mask_prior_px=1.0)
STEPS = [
    dict(step="first", note="Réglage des images générées appliqué à Manny : le nettoyage par régions efface ce que l'image ne dessine pas (reconstruite)", only=[MAN], overlay={MAN: dict(S_region_major=0.05, S_symmetry=0, S_free_sigma=0, A_on=0)}),
    dict(step="detector", note="Détecteur mesuré sur la vérité, avant la réparation du contour (reconstruite)", only=[CAR, MAN, TRU], overlay={CAR: dict(OLD_CONTOUR, S_free_sigma=0, S_sym_regions=0, A_on=0), MAN: dict(S_free_sigma=0, A_on=0), TRU: dict(S_free_sigma=0, A_on=0)}),
    dict(step="contour", note="Encoche, ombre au sol et bords dentelés réparés, régions miroir (reconstruite)", only=[CAR, MAN, TRU], overlay={CAR: dict(A_on=0), MAN: dict(A_on=0), TRU: dict(A_on=0)}),
    dict(step="lines", note="Bords en traits dessinés : droites ou courbes à peu de points de contrôle", only=[CAR, MAN, TRU], overlay={}, verdict={CAR: "Refusée à l'œil : les splines ne sont pas bien sur la voiture, ce ne sont pas de vraies découpes.", MAN: "Vraie amélioration, surtout comparée aux versions antérieures."}),
]


def run(project, step, keep):
    f = f"{ROOT}/Projects/{project}/params.json"; d = dict(keep[project]); d.update(step["overlay"].get(project, {})); json.dump(d, open(f, "w"), indent=2, ensure_ascii=False); chain = (["MicroShells.py", "MicroRegions.py", "MicroZones.py", "MicroLabels.py"] if project == CAR else []) + ["MicroMasks.py", "MicroLegend.py"]
    for s in chain: subprocess.run([PY, "-I", S + s, f], check=True, capture_output=True, cwd=ROOT)
    subprocess.run([PY, "-I", S + "MicroOutline.py", f, "board"], check=True, capture_output=True, cwd=ROOT)
    if project != CAR: subprocess.run([PY, "-I", S + "MicroTruth.py", f], check=True, capture_output=True, cwd=ROOT)


def main():
    keep = {p: json.load(open(f"{ROOT}/Projects/{p}/params.json")) for p in (CAR, MAN, TRU)}
    try:
        for st in STEPS:
            with ThreadPoolExecutor(3) as ex: [f.result() for f in [ex.submit(run, p, st, keep) for p in st["only"]]]
            for p in st["only"]:
                cmd = [PY, "-I", S + "MicroVersions.py", f"Projects/{p}/params.json", "snapshot", st["note"], "--step", st["step"]] + (["--rebuilt"] if "reconstruite" in st["note"] else []) + (["--truth-from", f"Projects/{TRU}"] if p == CAR else []) + (["--verdict", st["verdict"][p]] if p in st.get("verdict", {}) else []); print(subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT).stdout.strip(), flush=True)
    finally:
        for p, d in keep.items(): json.dump(d, open(f"{ROOT}/Projects/{p}/params.json", "w"), indent=2, ensure_ascii=False)


if __name__ == "__main__": main()
