import sys, numpy as np, time
sys.path.insert(0, ".")
from zrcar_common import *
from clay_render import *
from PIL import Image
P = "/home/user/Memory/Projects/zenray-meshes/handoff/car-finish-30-October-2026/files/tmp/tmp-zenray-meshes/versions/ZenRayCar_v752.obj"
V, F, G, names = load_obj(P)
Q, keep = quads_to_array(F)
ext = np.load("out/v752_exterior.npz")
vis, sgn = ext["vis"], ext["sign"]
tris = quads_to_tris(Q)
# normale par triangle orientée vers l'extérieur par le signe des faces
sg = np.concatenate([sgn, sgn])
tn = tri_normals(V, tris) * sg[:, None]
# lissage des normales par sommet (aires) pour un rendu comme un viewport
vn = np.zeros_like(V)
for k in range(3):
    np.add.at(vn, tris[:, k], tn)
vn /= np.maximum(np.linalg.norm(vn, axis=1), 1e-12)[:, None]
t = time.time()
import os; os.makedirs("out/img", exist_ok=True)
for name in ("front", "left", "top"):
    R = render(V, tris, name, px=0.004)
    img = shade(R, tn)
    Image.fromarray((img * 255).astype(np.uint8)).save(f"out/img/v752_clay_{name}.png")
    print(name, R["W"], R["H"], round(time.time() - t, 1))
