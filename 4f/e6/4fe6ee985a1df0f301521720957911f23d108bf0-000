# 27 October 2026: Pure Transformers/Lego Component_Hood built from 3D reference curves
import hou, numpy as np

geo = hou.pwd().geometry()
geo.clear()

# 1. Measured 3D Profile Curves from 6 views
# Centerline profile Y_center(Z) from side view:
z_pts = np.linspace(1.56, 2.26, 9)
# Smooth curvature from cowl (0.865) down to nose (0.525):
t_norm = (z_pts - 1.56) / (2.26 - 1.56)
y_center = 0.865 - 0.340 * (t_norm ** 1.35)

# Lateral shutlines X_edge(Z) from top view:
x_edge = 0.646 + 0.105 * (t_norm ** 0.8)

# Fender line height Y_edge(Z) from side view:
y_edge = 0.858 - 0.343 * (t_norm ** 1.25)

# Muscle crease line X_crease(Z) and Y_crease(Z):
x_crease = x_edge * 0.48

num_u = len(z_pts)
num_v = 5

surf = geo.createNURBSSurface(num_v, num_u)

for i in range(num_u):
    z = float(z_pts[i])
    yc = float(y_center[i])
    ye = float(y_edge[i])
    xe = float(x_edge[i])
    xc = float(x_crease[i])
    v_pts = [
        (-xe, ye, z),
        (-xc, yc - 0.006, z),
        (0.0, yc, z),
        (xc, yc - 0.006, z),
        (xe, ye, z)
    ]
    for j in range(num_v):
        surf.vertex(i, j).point().setPosition(hou.Vector3(*v_pts[j]))
