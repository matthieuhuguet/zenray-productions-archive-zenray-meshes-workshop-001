    "ctrl_spacing_m": 0.15, "ctrl_min": 4, "ctrl_max": 16,
    "refine_tol_m": 0.0,         # > 0 : add control points (up to ctrl_max) while the fit error is above this, 0 = off (strict spacing rule)
    "per_span": 40,              # samples per span used to measure the fit error (the editor draws 40 per span too)
    # mirror search (x -> -x)
