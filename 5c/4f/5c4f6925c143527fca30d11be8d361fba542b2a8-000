null1 = mk("null", "null1", arm); ad6 = mk("attribdelete", "attribdelete6", null1, ptdel="* ^P", primdel="*", vtxdel="*", dtldel="*")
pp13 = mk("polypath", "polypath13", ad6); rs17 = mk("resample", "resample17", pp13, length=0.03)
sw14 = mk("sweep::2.0", "sweep14", rs17, surfaceshape="tube", surfacetype="quads", endcaptype="grid", radius=0.025, cols=16, applyscale=1)
sp4 = mk("split", "split4", sw14); s21 = mk("sculpt", "sculpt21", sp4); s21.setColor(RED)
finger2 = polyline(mk, "skeleton2", [(0.75, 1.75, -0.3), (0.95, 1.55, -0.55), (1.05, 1.3, -0.7)]); rsF = mk("resample", "resample_finger", finger2, length=0.03)
swF = mk("sweep::2.0", "sweep_finger_wing", rsF, surfaceshape="tube", surfacetype="quads", endcaptype="grid", radius=0.015, cols=12, applyscale=1)
mrg27 = mk("merge", "merge27", s21, swF)
skin = mk("skin", "skin1", mrg27) ; sub = mk("subdivide", "subdivide_wing", skin, iterations=1); rs2 = mk("resample", "resample_wing", sub, length=0.04)
s22 = mk("sculpt", "sculpt22", rs2); s22.setColor(RED); pe = mk("polyextrude::2.0", "polyextrude_wing", s22, dist=0.01)
mir20 = mk("mirror", "mirror20", pe, dirx=1, diry=0, dirz=0, keeporiginal=1) if False else mk("mirror", "mirror20", pe, dirx=1, diry=0, dirz=0)
out_wing = mk("null", "OUT_WINGS", mir20)
# dorsal plates : curve -> resample -> subdivide curve -> ray onto the body -> match size -> sweep -> transform -> attribremap
spine_curve = polyline(mk, "curve1", [(0, 1.5, 0.05), (0, 1.35, -0.02), (0, 1.18, -0.05), (0, 1.0, -0.05), (0, 0.9, -0.4), (0, 0.75, -0.9), (0, 0.6, -1.5)])
rs25 = mk("resample", "resample25", spine_curve, length=0.1); ray = mk("ray", "ray1", rs25, ref); ray.parm("method").set(0) if ray and ray.parm("method") else None
plate = mk("box", "box_plate", sizex=0.04, sizey=0.12, sizez=0.04); ms2 = mk("matchsize", "matchsize2", plate)
cp = mk("copytopoints::2.0", "copytopoints_plates", ms2, ray); ar = mk("attribremap", "attribremap", ray)
sw17 = mk("sweep::2.0", "sweep17", rs25, surfaceshape="tube", surfacetype="quads", endcaptype="grid", radius=0.01, cols=8, applyscale=1)
merge21 = mk("merge", "merge21", ref, out_wing, cp, sw17); merge21.setDisplayFlag(True); merge21.setRenderFlag(True); W.layoutChildren()
