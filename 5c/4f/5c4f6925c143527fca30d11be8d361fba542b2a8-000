sub2 = mk("subdivide", "subdivide2", sub1, iterations=1); thick = mk("thicken", "thicken1", sub2); nor = mk("normal", "normal1", thick); bev = mk("polybevel::3.0", "polybevel1", nor)
ms1 = mk("matchsize", "matchsize1", bev); tr2 = mk("xform", "transform2", ms1); ray1 = mk("ray", "ray1", add1, file1); cp1 = mk("copytopoints::2.0", "copytopoints1", tr2, ray1)
sc = mk("sculpt", "sculpt1", cp1); sc.setColor(RED); out_jacket = mk("null", "out_jacket", qr); out_char = mk("null", "out_character", file1); merge1 = mk("merge", "merge1", out_char, out_jacket, sc)
merge1.setDisplayFlag(True); merge1.setRenderFlag(True); C.layoutChildren()
for n in obj.children(): n.setDisplayFlag(n.name() in ("Mad_Villain_Clothing",))
report = {}
for net in (W, C):
    for n in net.children():
        try: n.cook(force=True); g = n.geometry(); report[net.name() + "/" + n.name()] = (len(g.points()), len(g.prims()), [e[:70] for e in n.errors()][:1])
        except Exception as e: report[net.name() + "/" + n.name()] = str(e)[:70]
RESULT = {"missing": MISSING, "report": report}
