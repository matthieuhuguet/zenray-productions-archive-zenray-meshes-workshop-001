"""30 October 2026 : DRACARD episodes 5 (Wings and Details) and 6 (Procedural Clothing) rebuilt in two geo objects /obj/Mad_Villain_Wings and /obj/Mad_Villain_Clothing, from notes/ep05_ep06.md. The tutorial's reference bgeo files are replaced by Object Merge nodes on /obj/Mad_Villain. exec inside Houdini after Ep03.py and Ep04.py."""
import hou
obj = hou.node("/obj"); MISSING = []; RED = hou.Color((0.9, 0.15, 0.15)); GREEN = hou.Color((0.2, 0.7, 0.25))
def geo(name):
    o = obj.node(name)
    if o: o.destroy()
    return obj.createNode("geo", name)
def mkin(net):
    def mk(t, name, *inputs, **parms):
        try: n = net.createNode(t, name)
        except Exception as e: MISSING.append((t, name, str(e)[:50])); return None
        for i, x in enumerate(inputs):
            if x is not None: n.setInput(i, x)
        for k, v in parms.items():
            p = n.parm(k)
            if p is None: MISSING.append(("parm", name + "." + k, "absent")); continue
            try: p.set(v)
            except Exception as e: MISSING.append(("parm", name + "." + k, str(e)[:30]))
        return n
    return mk
def polyline(mk, name, pts):
    n = mk("add", name, keep=0); n.parm("points").set(len(pts))
    for i, p in enumerate(pts):
        for k, ax in enumerate("xyz"): n.parm("pt%d%s" % (i, ax)).set(p[k])
    n.parm("prims").set(1); n.parm("prim0").set("0-%d" % (len(pts) - 1)); n.parm("closed0").set(0); return n
