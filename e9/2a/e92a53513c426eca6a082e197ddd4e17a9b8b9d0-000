#!/usr/bin/env python3
# 10 November 2026, 14:30: one clay picture of a mesh from any angle (the turn of MeshViews shows six fixed ones).
# usage: shot.py <car.npz> <out.png> <azimuth deg from +z toward +x> <elevation deg> [px_per_m 420] [wire 0|1] [zoom box "x0,y0,x1,y1" in 0..1 of the picture]
import sys
sys.path.insert(0, '/Users/zenray/.claude/skills/zenray-meshes/scripts/v4')
import numpy as np
import MeshViews as MV
npz, out, az, el = sys.argv[1], sys.argv[2], float(sys.argv[3]), float(sys.argv[4])
ppm = float(sys.argv[5]) if len(sys.argv) > 5 else 420.0; MV.P['wire_alpha'] = 0.35 if (len(sys.argv) > 6 and sys.argv[6] == '1') else 0.0
parts = MV.load(npz); V, Q, pid = MV.merge(parts)
c = (V.min(0) + V.max(0)) / 2; ext = np.linalg.norm(V.max(0) - V.min(0)); W = int(ext * ppm * 1.02); H = int(ext * ppm * 0.62)
azr, elr = np.radians(az), np.radians(el)
toward = np.array([np.sin(azr) * np.cos(elr), np.sin(elr), np.cos(azr) * np.cos(elr)])
right = np.cross([0, 1, 0], toward); right /= np.linalg.norm(right); up = np.cross(toward, right)
X = V - c; uv = np.stack([W / 2 + (X @ right) * ppm, H / 2 - (X @ up) * ppm], 1)
buf = MV.raster(uv, -(X @ toward), Q, (H, W))
im = MV.shade(buf, V, Q, pid, parts, right, up, toward, wire_uv=uv if MV.P['wire_alpha'] > 0 else None)
if len(sys.argv) > 7:
    x0, y0, x1, y1 = [float(t) for t in sys.argv[7].split(',')]; im = im.crop((int(x0 * W), int(y0 * H), int(x1 * W), int(y1 * H)))
im.save(out); print(out, im.size)
