<!-- 29 October 2026 : ZenRay Lines 3D, the retopology editor : curves drawn and edited ON the model in a 3D view, converted to a welded quad mesh by the server (Scripts/lines/ZrlNetMesh.py through Scripts/lines/ZrlServe.py). -->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>ZenRay Lines 3D</title>
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="style3d.css">
</head>
<body>
<div id="app">
  <!-- 29 October 2026 : the everyday gestures stay in sight ; everything else is folded in drawers (their open state is remembered) ; every id is unchanged -->
  <aside id="left" aria-label="Tools">
    <header class="brand">
      <h1>ZenRay Lines 3D</h1>
      <p class="tagline">Draw the components on the model, then a welded quad mesh. <a href="index.html">2D views</a></p>
    </header>
    <section class="block">
      <h2>Draw</h2>
      <div id="tools" class="stack">
        <button class="btn wide tool" data-tool="select" type="button">Select and move <kbd>Q</kbd></button>
        <button class="btn wide tool" data-tool="autopatch" type="button" title="Click a zone : a four sided patch fitted on its contour">Auto patch, click a zone <kbd>W</kbd></button>
        <button class="btn wide tool" data-tool="draw" type="button">Draw curve <kbd>D</kbd></button>
        <button class="btn wide tool" data-tool="patch" type="button">Quad patch, 4 clicks <kbd>A</kbd></button>
        <button class="btn wide tool" data-tool="seed" type="button">Place component <kbd>C</kbd></button>
      </div>
      <label class="slider" title="An edge sharper than this stops the zone of the auto patch"><span>Zone angle (deg)</span><input id="pZoneDeg" type="range" min="8" max="60" step="1" value="25"><b id="pZoneDegVal">25</b></label>
      <label class="check" title="A clicked point goes onto the nearest sharp edge or part border, within 2 cm"><input id="pSnapEdge" type="checkbox" checked> Points snap to the mesh edges</label>
      <label class="check"><input id="pMirror" type="checkbox" checked> Mirror x to -x <kbd>M</kbd></label>
      <p id="toolHint" class="hint"></p>
      <details class="more" id="dMoreTools"><summary>More tools</summary>
        <div class="stack">
          <button class="btn wide tool" data-tool="insert" type="button">Insert point <kbd>I</kbd></button>
          <button class="btn wide tool" data-tool="split" type="button">Split curve <kbd>S</kbd></button>
          <button class="btn wide tool" data-tool="tweak" type="button">Tweak mesh <kbd>T</kbd></button>
          <button class="btn wide tool" data-tool="face" type="button">Pick a face <kbd>G</kbd></button>
          <button class="btn wide tool" data-tool="loop" type="button">Insert edge loop <kbd>L</kbd></button>
          <button class="btn wide tool" data-tool="extend" type="button">Extend a strip <kbd>E</kbd></button>
        </div>
      </details>
    </section>
    <section class="block">
      <h2>View</h2>
      <div class="grid3">
        <button class="btn" data-view="persp" type="button">Persp <kbd>0</kbd></button>
        <button class="btn" data-view="front" type="button">Front <kbd>1</kbd></button>
        <button class="btn" data-view="back" type="button">Back <kbd>2</kbd></button>
        <button class="btn" data-view="left" type="button">Left <kbd>3</kbd></button>
        <button class="btn" data-view="right" type="button">Right <kbd>4</kbd></button>
        <button class="btn" data-view="top" type="button">Top <kbd>5</kbd></button>
        <button class="btn" data-view="bottom" type="button">Bottom <kbd>6</kbd></button>
        <button id="bOrtho" class="btn" type="button">Ortho <kbd>O</kbd></button>
        <button id="bFrame" class="btn" type="button">Frame <kbd>F</kbd></button>
      </div>
      <div class="buttons wrap" id="showSwitch" title="Swap between the reference sheet and the current 3D model (V cycles)">
        <button class="btn" data-show="model" type="button">3D model</button>
        <button class="btn" data-show="reference" type="button">Reference <kbd>V</kbd></button>
        <button class="btn" data-show="both" type="button">Both</button>
      </div>
      <div class="buttons wrap" id="shadeSwitch" title="Grey shading, or each component of the model in its own colour (Shift V)">
        <button class="btn active" data-shade="gray" type="button">Grey</button>
        <button class="btn" data-shade="parts" type="button">Colours <kbd>⇧V</kbd></button>
      </div>
      <label class="check" title="The name of each component sits in its middle and follows the 3D view ; hidden when another part covers it (Shift N)"><input id="pTags" type="checkbox" checked> Names <kbd>⇧N</kbd></label>
      <label class="check" title="Two fingers turn around the model, pinch zooms, Shift + two fingers pans (Blender on a Mac). A mouse wheel still zooms."><input id="pTrackpad" type="checkbox" checked> Trackpad like Blender</label>
      <label class="check"><input id="pXray" type="checkbox"> X-ray <kbd>X</kbd></label>
      <details class="more" id="dDisplay"><summary>Display</summary>
        <div class="checks">
          <label class="check"><input id="pModel" type="checkbox" checked> Model</label>
          <label class="check"><input id="pHidden" type="checkbox" checked> Hidden curves, faint</label>
          <label class="check"><input id="pNodes" type="checkbox" checked> Nodes</label>
          <label class="check"><input id="pHandles" type="checkbox" checked> Control points</label>
          <label class="check"><input id="pMesh" type="checkbox" checked> Quad mesh</label>
          <label class="check"><input id="pSnap" type="checkbox" checked> Snap to surface</label>
          <label class="check"><input id="pSheet" type="checkbox" checked> Reference sheet in the views</label>
          <label class="check"><input id="pCrease" type="checkbox"> Drawn curves follow the creases</label>
          <label class="check"><input id="pShowCreases" type="checkbox"> Show the creases (red)</label>
        </div>
      </details>
      <details class="more" id="dKeys"><summary>Keys and gestures</summary>
        <ul class="keys">
          <li>Two fingers : turn around ; pinch : zoom ; <kbd>Shift</kbd> + two fingers : pan</li>
          <li><kbd>Alt</kbd> + drag, or right drag : turn ; middle drag : pan ; wheel : zoom</li>
          <li><kbd>W</kbd> auto patch ; <kbd>D</kbd> draw ; <kbd>A</kbd> quad patch ; <kbd>C</kbd> component</li>
          <li><kbd>Enter</kbd> finish a curve ; <kbd>Esc</kbd> cancel ; <kbd>Backspace</kbd> last point</li>
          <li><kbd>Del</kbd> delete ; <kbd>R</kbd> round ; <kbd>J</kbd> join ; <kbd>H</kbd> hide a part ; <kbd>Shift H</kbd> show all</li>
          <li><kbd>P</kbd> preview faces ; <kbd>U</kbd> isolate ; <kbd>B</kbd> best pattern ; <kbd>N</kbd> next problem ; <kbd>K</kbd> corner</li>
          <li><kbd>F2</kbd> rename the component ; <kbd>Cmd Z</kbd> undo ; <kbd>Shift Cmd Z</kbd> redo</li>
        </ul>
      </details>
    </section>
  </aside>

  <main id="center">
    <div id="stage3"><canvas id="cv"></canvas><div id="tags"></div><div id="boxSel"></div></div>
    <div id="statusBar" role="status"><span id="status">Loading...</span><span id="coords" class="coords3"></span></div>
  </main>

  <aside id="right" aria-label="Edit">
    <section class="block">
      <h2>Components <span id="compCount" class="count"></span></h2>
      <div class="row"><input id="compName" type="text" placeholder="Name of the next component" autocomplete="off" spellcheck="false"><button id="bCompAdd" class="btn" type="button">Place <kbd>C</kbd></button></div>
      <input id="compFilter" type="search" placeholder="Filter" autocomplete="off" spellcheck="false" class="filter">
      <div id="compList" class="list comps"></div>
      <details class="more" id="dCompOptions"><summary>Component options</summary>
        <div class="buttons wrap">
          <button id="bCompRename" class="btn" type="button">Rename</button>
          <button id="bCompDelete" class="btn" type="button">Remove name</button>
          <button id="bCompDeleteAll" class="btn" type="button">Delete with its curves</button>
          <button id="bCompCurves" class="btn" type="button">Its curves</button>
          <button id="bCompIsolate" class="btn" type="button">Isolate <kbd>U</kbd></button>
          <button id="bCompBest" class="btn" type="button">Best pattern <kbd>B</kbd></button>
          <button id="bPatternPrev" class="btn" type="button">Previous pattern</button>
          <button id="bCompRotate" class="btn" type="button">Next pattern</button>
          <button id="bCompDenser" class="btn" type="button">Denser</button>
          <button id="bCompCoarser" class="btn" type="button">Coarser</button>
          <button id="bCompSkip" class="btn" type="button">Skip or keep</button>
          <button id="bCompImport" class="btn" type="button">Import car components</button>
          <button id="bCompName" class="btn" type="button">Name faces from the model</button>
        </div>
      </details>
    </section>
    <section class="block">
      <h2>Result</h2>
      <div class="buttons wrap">
        <button id="bPreview" class="btn" type="button">Preview faces <kbd>P</kbd></button>
        <button id="bMesh" class="btn primary" type="button">Convert to mesh</button>
        <button id="bChainBuild" class="btn primary" type="button" title="Curves (control point matrices), components and quads rebuilt as they are in /obj/ZRL_Chain">Build in Houdini</button>
        <button id="bChainPull" class="btn" type="button" title="The curves moved in Houdini (EDIT_curves) come back here, one undo step">Pull from Houdini</button>
      </div>
      <div class="buttons wrap">
        <button id="bSave" class="btn primary" type="button">Save <kbd>Cmd S</kbd></button>
        <button id="bUndo" class="btn" type="button">Undo</button>
        <button id="bRedo" class="btn" type="button">Redo</button>
      </div>
      <div id="legend" class="legend"></div>
      <div id="doctorInfo" class="hint"></div>
      <div id="meshInfo" class="info"></div>
    </section>
    <section class="block">
      <details class="more" id="dSelection"><summary>Selected curves <span id="selInfo" class="info inline">Nothing selected.</span></summary>
        <div class="buttons wrap">
          <button id="bDelete" class="btn" type="button">Delete</button>
          <button id="bSmooth" class="btn" type="button">Smooth</button>
          <button id="bRound" class="btn" type="button">Round <kbd>R</kbd></button>
          <button id="bSimplify" class="btn" type="button">Simplify</button>
          <button id="bReverse" class="btn" type="button">Reverse</button>
          <button id="bJoin" class="btn" type="button">Join <kbd>J</kbd></button>
          <button id="bWeld" class="btn" type="button">Weld ends</button>
          <button id="bProject" class="btn" type="button">Project on surface</button>
        </div>
        <label class="slider"><span>Smooth amount</span><input id="pSmooth" type="range" min="0.05" max="1" step="0.05" value="0.5"></label>
        <label class="slider"><span>Control points (simplify)</span><input id="pCtrl" type="range" min="4" max="24" step="1" value="6"><b id="pCtrlVal">6</b></label>
        <div class="row">
          <input id="selText" type="search" placeholder="Select curves whose components contain..." autocomplete="off" spellcheck="false">
          <button id="bSelText" class="btn" type="button">Select</button>
        </div>
        <div class="buttons"><button id="bSelAll" class="btn" type="button">All</button><button id="bSelNone" class="btn" type="button">None</button><button id="bSelInvert" class="btn" type="button">Invert</button></div>
      </details>
      <details class="more" id="dMesh"><summary>Mesh settings and repair</summary>
        <div class="checks">
          <label class="check"><input id="pLive" type="checkbox" checked> Live preview of the faces</label>
          <label class="check"><input id="pLiveMesh" type="checkbox"> Live wireframe of the quads</label>
          <label class="check"><input id="pFaces" type="checkbox" checked> Faces and corners</label>
          <label class="check"><input id="pDoctor" type="checkbox" checked> Loose curves in red</label>
          <label class="check"><input id="pSolo" type="checkbox"> Selected curves only</label>
          <label class="check"><input id="pCompColour" type="checkbox"> Colour the quads by component</label>
          <label class="check"><input id="pSymX" type="checkbox"> Exact symmetry across x = 0</label>
        </div>
        <label class="slider"><span>Quad size (m)</span><input id="pEdge" type="range" min="0.008" max="0.08" step="0.001" value="0.02"><b id="pEdgeVal">0.020</b></label>
        <label class="slider"><span>Corner angle (deg)</span><input id="pCorner" type="range" min="10" max="80" step="1" value="35"><b id="pCornerVal">35</b></label>
        <label class="slider"><span>Relax iterations</span><input id="pRelax" type="range" min="0" max="200" step="5" value="30"><b id="pRelaxVal">30</b></label>
        <div class="buttons wrap">
          <button id="bBestAll" class="btn" type="button">Best patterns, all faces</button>
          <button id="bDoctor" class="btn" type="button">Check network</button>
          <button id="bAutoFix" class="btn" type="button">Auto fix (safe steps)</button>
          <button id="bRepair" class="btn" type="button">Repair network</button>
          <button id="bSnapSurface" class="btn" type="button">Snap curves on surface</button>
          <button id="bBridge" class="btn" type="button">Bridge islands</button>
          <button id="bWeldAll" class="btn" type="button">Weld every end</button>
          <button id="bNextProblem" class="btn" type="button">Next problem <kbd>N</kbd></button>
          <button id="bCorner" class="btn" type="button">Corner on or off <kbd>K</kbd></button>
          <button id="bRelaxMesh" class="btn" type="button">Relax mesh</button>
          <button id="bClearMesh" class="btn" type="button">Clear mesh</button>
          <button id="bCreaseAlign" class="btn" type="button">Edges on creases (this view)</button>
          <button id="bHoudini" class="btn" type="button">Send mesh only to Houdini</button>
        </div>
      </details>
      <details class="more" id="dFiles"><summary>Model and files</summary>
        <p class="hint">The six view sheet first, then the 3D model : a new version of the model replaces the reference and every curve follows its surface.</p>
        <div class="row"><input id="modelPath" type="text" placeholder="/path/to/model.obj, or original" autocomplete="off" spellcheck="false"></div>
        <label class="check"><input id="pModelViews" type="checkbox" checked> Also render the 2D views and warp the sheet</label>
        <div class="buttons wrap"><button id="bUseModel" class="btn" type="button">Use this model</button></div>
        <div id="modelInfo" class="info"></div>
        <div class="buttons wrap">
          <button id="bLoadSaved" class="btn" type="button">Load saved</button>
          <button id="bLoadOriginal" class="btn" type="button">Load original</button>
          <button id="bLoadMbo" class="btn" type="button">Load component network</button>
          <button id="bNewNet" class="btn" type="button">New empty network</button>
          <button id="bChainExport" class="btn" type="button">Export chain file</button>
          <button id="bExportJson" class="btn" type="button">Export JSON</button>
          <button id="bExportSvg" class="btn" type="button">Export SVG</button>
          <button id="bExportPng" class="btn" type="button">Export PNG</button>
          <button id="bExportObj" class="btn" type="button">Export OBJ</button>
        </div>
      </details>
    </section>
  </aside>
</div>
<script>window.ZRL_NO_AUTOSTART = true;</script>
<script src="app.js"></script>
<script src="view3d.js"></script>
<script src="app3d.js"></script>
<script src="version-guard.js"></script>
</body>
</html>
