<!-- 29 October 2026 : ZenRay Lines 3D, the retopology editor : curves drawn and edited ON the model in a 3D view, converted to a welded quad mesh by the server (Scripts/lines/ZrlNetMesh.py through Scripts/lines/ZrlServe.py). -->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>ZenRay Lines 3D</title>
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="style3d.css">
</head>
<body>
<div id="app">
  <aside id="left" aria-label="Tools">
    <header class="brand">
      <h1>ZenRay Lines 3D</h1>
      <p class="tagline">Curves on the model, then a welded quad mesh. <a href="index.html">2D views</a></p>
    </header>
    <section class="block">
      <h2>Tool</h2>
      <div id="tools" class="stack">
        <button class="btn wide tool" data-tool="select" type="button">Select and move <kbd>Q</kbd></button>
        <button class="btn wide tool" data-tool="draw" type="button">Draw curve <kbd>D</kbd></button>
        <button class="btn wide tool" data-tool="insert" type="button">Insert point <kbd>I</kbd></button>
        <button class="btn wide tool" data-tool="split" type="button">Split curve <kbd>S</kbd></button>
        <button class="btn wide tool" data-tool="tweak" type="button">Tweak mesh <kbd>T</kbd></button>
      </div>
      <p id="toolHint" class="hint"></p>
    </section>
    <section class="block">
      <h2>View</h2>
      <div class="grid3">
        <button class="btn" data-view="persp" type="button">Persp <kbd>0</kbd></button>
        <button class="btn" data-view="front" type="button">Front <kbd>1</kbd></button>
        <button class="btn" data-view="back" type="button">Back <kbd>2</kbd></button>
        <button class="btn" data-view="left" type="button">Left <kbd>3</kbd></button>
        <button class="btn" data-view="right" type="button">Right <kbd>4</kbd></button>
        <button class="btn" data-view="top" type="button">Top <kbd>5</kbd></button>
        <button class="btn" data-view="bottom" type="button">Bottom <kbd>6</kbd></button>
        <button id="bOrtho" class="btn" type="button">Ortho <kbd>O</kbd></button>
        <button id="bFrame" class="btn" type="button">Frame <kbd>F</kbd></button>
      </div>
      <div class="checks">
        <label class="check"><input id="pModel" type="checkbox" checked> Model</label>
        <label class="check"><input id="pXray" type="checkbox"> X-ray <kbd>X</kbd></label>
        <label class="check"><input id="pNodes" type="checkbox" checked> Nodes</label>
        <label class="check"><input id="pHandles" type="checkbox" checked> Control points</label>
        <label class="check"><input id="pMesh" type="checkbox" checked> Quad mesh</label>
        <label class="check"><input id="pMirror" type="checkbox" checked> Mirror x to -x <kbd>M</kbd></label>
        <label class="check"><input id="pSnap" type="checkbox" checked> Snap to surface</label>
      </div>
    </section>
    <section class="block help">
      <h2>Keys</h2>
      <ul>
        <li><kbd>Alt</kbd> + left drag, or right drag : orbit</li>
        <li><kbd>Alt</kbd> + middle drag, or middle drag : pan</li>
        <li>Wheel, or <kbd>Alt</kbd> + right drag : zoom</li>
        <li>Drag on empty space : box select ; <kbd>Shift</kbd> adds</li>
        <li><kbd>Del</kbd> delete ; <kbd>R</kbd> round ; <kbd>J</kbd> join at node</li>
        <li><kbd>Enter</kbd> finish a curve ; <kbd>Esc</kbd> cancel ; <kbd>Backspace</kbd> last point</li>
        <li><kbd>Cmd Z</kbd> undo ; <kbd>Shift Cmd Z</kbd> redo ; <kbd>Cmd S</kbd> save</li>
      </ul>
    </section>
  </aside>

  <main id="center">
    <div id="stage3"><canvas id="cv"></canvas><div id="boxSel"></div></div>
    <div id="statusBar" role="status"><span id="status">Loading...</span></div>
  </main>

  <aside id="right" aria-label="Edit">
    <section class="block">
      <h2>Selection</h2>
      <div id="selInfo" class="info">Nothing selected.</div>
      <div class="buttons wrap">
        <button id="bDelete" class="btn" type="button">Delete</button>
        <button id="bSmooth" class="btn" type="button">Smooth</button>
        <button id="bRound" class="btn" type="button">Round <kbd>R</kbd></button>
        <button id="bSimplify" class="btn" type="button">Simplify</button>
        <button id="bReverse" class="btn" type="button">Reverse</button>
        <button id="bJoin" class="btn" type="button">Join <kbd>J</kbd></button>
        <button id="bWeld" class="btn" type="button">Weld ends</button>
        <button id="bProject" class="btn" type="button">Project on surface</button>
      </div>
      <label class="slider"><span>Smooth amount</span><input id="pSmooth" type="range" min="0.05" max="1" step="0.05" value="0.5"></label>
      <label class="slider"><span>Control points (simplify)</span><input id="pCtrl" type="range" min="4" max="24" step="1" value="6"><b id="pCtrlVal">6</b></label>
      <div class="row">
        <input id="selText" type="search" placeholder="Select curves whose components contain..." autocomplete="off" spellcheck="false">
        <button id="bSelText" class="btn" type="button">Select</button>
      </div>
      <div class="buttons"><button id="bSelAll" class="btn" type="button">All</button><button id="bSelNone" class="btn" type="button">None</button><button id="bSelInvert" class="btn" type="button">Invert</button></div>
    </section>
    <section class="block">
      <h2>Quad mesh</h2>
      <label class="slider"><span>Quad size (m)</span><input id="pEdge" type="range" min="0.008" max="0.08" step="0.001" value="0.02"><b id="pEdgeVal">0.020</b></label>
      <label class="slider"><span>Corner angle (deg)</span><input id="pCorner" type="range" min="10" max="80" step="1" value="35"><b id="pCornerVal">35</b></label>
      <label class="slider"><span>Relax iterations</span><input id="pRelax" type="range" min="0" max="200" step="5" value="30"><b id="pRelaxVal">30</b></label>
      <div class="buttons wrap">
        <button id="bMesh" class="btn primary" type="button">Convert to mesh</button>
        <button id="bDoctor" class="btn" type="button">Check network</button>
        <button id="bRelaxMesh" class="btn" type="button">Relax mesh</button>
        <button id="bClearMesh" class="btn" type="button">Clear mesh</button>
        <button id="bExportObj" class="btn" type="button">Export OBJ</button>
      </div>
      <div id="meshInfo" class="info"></div>
    </section>
    <section class="block">
      <h2>History and files</h2>
      <div class="buttons"><button id="bUndo" class="btn" type="button">Undo</button><button id="bRedo" class="btn" type="button">Redo</button></div>
      <div class="buttons wrap">
        <button id="bExportJson" class="btn" type="button">Export JSON</button>
        <button id="bExportSvg" class="btn" type="button">Export SVG</button>
        <button id="bExportPng" class="btn" type="button">Export PNG</button>
      </div>
      <div class="buttons wrap">
        <button id="bSave" class="btn primary" type="button">Save to atelier</button>
        <button id="bLoadSaved" class="btn" type="button">Load saved</button>
        <button id="bLoadOriginal" class="btn" type="button">Load original</button>
      </div>
    </section>
  </aside>
</div>
<script>window.ZRL_NO_AUTOSTART = true;</script>
<script src="app.js"></script>
<script src="view3d.js"></script>
<script src="app3d.js"></script>
</body>
</html>
