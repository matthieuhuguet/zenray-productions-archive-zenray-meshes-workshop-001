<!-- 29 October 2026 : ZenRay Lines 3D, the retopology editor : curves drawn and edited ON the model in a 3D view, converted to a welded quad mesh by the server (Scripts/lines/ZrlNetMesh.py through Scripts/lines/ZrlServe.py). -->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>ZenRay Lines 3D</title>
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="style3d.css">
</head>
<body>
<div id="app">
  <!-- 29 October 2026 : the everyday gestures stay in sight ; everything else is folded in drawers (their open state is remembered) ; every id is unchanged -->
  <header id="topbar" aria-label="Project, history, views">
    <div class="tb-group"><b class="tb-brand">ZenRay Lines</b><button id="projBtn" class="btn sm" type="button" title="Projects : the car, the next ones">Car</button></div>
    <div class="tb-group">
      <button id="bUndo" class="btn sm icon" type="button" title="Undo the last edit (Cmd Z)" aria-label="Undo"><svg viewBox="0 0 20 20"><path d="M7.5 4.5 3.5 8.5l4 4M4 8.5h8a4.5 4.5 0 0 1 0 9H8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button id="bRedo" class="btn sm icon" type="button" title="Redo (Shift Cmd Z)" aria-label="Redo"><svg viewBox="0 0 20 20"><path d="m12.5 4.5 4 4-4 4M16 8.5H8a4.5 4.5 0 0 0 0 9h4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="tb-group">
      <button id="bViewBack" class="btn sm icon" type="button" title="Previous view ( [ )" aria-label="Previous view" disabled><svg viewBox="0 0 20 20"><path d="m12 4-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button id="bViewFwd" class="btn sm icon" type="button" title="Next view ( ] )" aria-label="Next view" disabled><svg viewBox="0 0 20 20"><path d="m8 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button id="bHome" class="btn sm" type="button" title="Normal view : perspective, the whole model, nothing isolated (Home)">Normal view</button>
    </div>
    <div class="tb-group seg" id="viewSeg" role="group" aria-label="Views">
      <button class="btn sm" data-view="persp" type="button" title="Perspective (0)">Persp</button>
      <button class="btn sm" data-view="front" type="button" title="Front (1)">Front</button>
      <button class="btn sm" data-view="back" type="button" title="Back (2)">Back</button>
      <button class="btn sm" data-view="left" type="button" title="Left (3)">Left</button>
      <button class="btn sm" data-view="right" type="button" title="Right (4)">Right</button>
      <button class="btn sm" data-view="top" type="button" title="Top (5)">Top</button>
      <button class="btn sm" data-view="bottom" type="button" title="Bottom (6)">Bottom</button>
    </div>
    <div class="tb-group">
      <button id="bOrtho" class="btn sm" type="button" title="Orthographic or perspective (O)">Ortho</button>
      <button id="bFrame" class="btn sm" type="button" title="Frame the selection, or the whole model (F)">Frame</button>
    </div>
    <div class="tb-group seg" id="showSwitch" role="group" aria-label="What is shown" title="The 3D model, the reference sheet, or both (V cycles)">
      <button class="btn sm" data-show="model" type="button">3D model</button>
      <button class="btn sm" data-show="quads" type="button" title="The quad topology of your curves, kept up to date as you edit">Quads</button>
      <button class="btn sm" data-show="reference" type="button">Reference</button>
      <button class="btn sm" data-show="both" type="button">Both</button>
    </div>
    <div class="tb-group seg" id="shadeSwitch" role="group" aria-label="Shading" title="Grey shading, or each component of the model in its own colour (Shift V)">
      <button class="btn sm active" data-shade="gray" type="button">Grey</button>
      <button class="btn sm" data-shade="parts" type="button">Colours</button>
    </div>
    <label class="check tb-check" title="The name of each component sits in its middle and follows the 3D view ; hidden when another part covers it (Shift N)"><input id="pTags" type="checkbox" checked> Names</label>
    <div class="tb-spacer"></div>
    <div id="saveState" class="savestate saved" role="status" aria-live="polite" title="Your edits are saved by themselves a moment after you stop">
      <svg class="spin" viewBox="0 0 20 20" aria-hidden="true"><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <line x1="10" y1="2.2" x2="10" y2="5.4" opacity="1"/><line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".92" transform="rotate(30 10 10)"/><line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".84" transform="rotate(60 10 10)"/><line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".76" transform="rotate(90 10 10)"/>
        <line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".68" transform="rotate(120 10 10)"/><line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".6" transform="rotate(150 10 10)"/><line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".52" transform="rotate(180 10 10)"/><line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".44" transform="rotate(210 10 10)"/>
        <line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".36" transform="rotate(240 10 10)"/><line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".28" transform="rotate(270 10 10)"/><line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".2" transform="rotate(300 10 10)"/><line x1="10" y1="2.2" x2="10" y2="5.4" opacity=".14" transform="rotate(330 10 10)"/></g></svg>
      <span id="saveText">Saved</span>
    </div>
    <button id="bSave" class="btn sm primary" type="button" title="Save now (Cmd S)">Save</button>
  </header>
  <nav id="gallery" aria-label="Components"></nav>
  <div id="projMenu" class="popover" hidden role="dialog" aria-label="Projects">
    <div class="pm-head"><b>Projects</b><button id="bProjClose" class="btn sm icon" type="button" aria-label="Close">&times;</button></div>
    <div id="projList" class="pm-list"></div>
    <div class="pm-new">
      <div class="pm-title">New project</div>
      <input id="projName" type="text" placeholder="Name (for example Coupe 2)" autocomplete="off" spellcheck="false">
      <input id="projObj" type="text" placeholder="Model .obj, one group per part (empty : an empty project)" autocomplete="off" spellcheck="false">
      <button id="bProjCreate" class="btn primary" type="button">Create and open</button>
      <div id="projMsg" class="hint"></div>
    </div>
  </div>
  <aside id="left" aria-label="Tools">
    <section class="block" id="blkAuto">
      <h2>Automatic</h2>
      <button id="bAutoBuild" class="btn primary wide big" type="button" title="A patch on every part of the model, the right side mirrored from the left, points merged, safe fixes, then the Quads view and the first problem. Cmd Z undoes it all.">Build the whole network</button>
      <div id="autoProgress" class="progress" hidden><i></i><span></span></div>
      <div class="buttons wrap">
        <button id="bAutoMerge" class="btn" type="button" title="Every group of points closer than the merge distance becomes one point, on the surface">Merge close points</button>
        <button id="bAutoStraight" class="btn" type="button" title="Every curve within the set distance of straight becomes exactly straight">Straighten near-straight</button>
        <button id="bAutoTrace" class="btn" type="button" title="Every crease of the model, seen from 18 directions, becomes a curve : the geometry draws the lines, you close them into components. Cmd Z removes them all.">Trace the creases</button>
        <button id="bAutoCreases" class="btn" type="button" title="Every curve seen from this camera (or the selected ones) is joined again along the creases, when it lies close to one. Look at the part from the front first.">Snap curves to creases</button>
      </div>
      <details class="more" id="dAuto"><summary>Automatic settings</summary>
        <label class="slider" title="Hard surface : big zones, long straight creases. Organic (face, body) : more, smaller zones, tighter welds, a crease is trusted only when sure. Both are only values of the controls below."><span>Style</span><select id="pStyle"><option value="hard">Hard surface</option><option value="organic">Organic</option></select></label>
        <label class="slider" title="How far two normals may differ inside one part : a high value takes the whole part"><span>Part zone angle</span><input id="pBuildDeg" type="range" min="25" max="90" step="1" value="70"><b id="pBuildDegVal">70</b></label>
        <label class="slider" title="Parts smaller than this are left out (bolts, slots)"><span>Smallest part (cm2)</span><input id="pBuildMin" type="range" min="0" max="400" step="5" value="40"><b id="pBuildMinVal">40</b></label>
        <label class="slider" title="Points closer than this are one point"><span>Merge distance (mm)</span><input id="pWeldMm" type="range" min="1" max="40" step="1" value="8"><b id="pWeldMmVal">8</b></label>
        <label class="slider" title="A curve whose control points lie within this of its chord is straightened"><span>Straight under (mm)</span><input id="pStraightMm" type="range" min="1" max="30" step="1" value="6"><b id="pStraightMmVal">6</b></label>
        <label class="slider" title="A drawn or snapped curve follows the creases only when at least this share of its path lies on one"><span>Crease lock needs (%)</span><input id="pCreaseMin" type="range" min="10" max="90" step="5" value="35"><b id="pCreaseMinVal">35</b></label>
        <label class="slider" title="A stroke is locked onto a crease only when the crease stays within this distance of what you drew"><span>Crease lock reach (mm)</span><input id="pLockReach" type="range" min="5" max="150" step="5" value="40"><b id="pLockReachVal">40</b></label>
        <label class="slider" title="Snap to creases never moves a curve more than this"><span>Snap moves at most (mm)</span><input id="pSnapMm" type="range" min="5" max="80" step="5" value="30"><b id="pSnapMmVal">30</b></label>
        <label class="check"><input id="pBuildMirror" type="checkbox" checked> Mirror the right side from the left</label>
        <label class="check"><input id="pAfterMerge" type="checkbox" checked> After building : merge close points</label>
        <label class="check"><input id="pAfterFix" type="checkbox" checked> After building : fix what is safe</label>
        <label class="check"><input id="pAfterQuads" type="checkbox" checked> After building : show the Quads view</label>
        <label class="check"><input id="pAfterJump" type="checkbox" checked> After building : go to the first problem</label>
      </details>
    </section>
    <section class="block">
      <h2>Draw</h2>
      <div id="tools" class="stack">
        <button class="btn wide tool" data-tool="select" type="button" title="Click a curve or a point ; drag a box ; drag a point to move it (Q)">Select and move <kbd>Q</kbd></button>
        <button class="btn wide tool" data-tool="autopatch" type="button" title="Click a zone : a four sided patch fitted on its contour (W)">Auto patch, click a zone <kbd>W</kbd></button>
        <button class="btn wide tool" data-tool="draw" type="button" title="Click points on the model, Enter finishes (D)">Draw a curve <kbd>D</kbd></button>
        <button class="btn wide tool" data-tool="isolate" type="button" title="Click a component : it stays alone to draw on it ; U toggles, Shift H shows everything">Isolate a component <kbd>U</kbd></button>
      </div>
      <label class="slider" title="An edge sharper than this stops the zone of the auto patch"><span>Zone angle (deg)</span><input id="pZoneDeg" type="range" min="8" max="60" step="1" value="25"><b id="pZoneDegVal">25</b></label>
      <label class="check" title="Magnet : a point you place or release goes onto the nearest sharp edge or part border within 2 cm, and onto a point close to it"><input id="pSnapEdge" type="checkbox" checked> Magnet to edges and points</label>
      <label class="check" title="Click along a fold or drag a stroke : the curve is joined along the creases of the model, when the path really lies on one"><input id="pCrease" type="checkbox" checked> Lock curves onto creases</label>
      <label class="check"><input id="pMirror" type="checkbox" checked> Mirror x to -x <kbd>M</kbd></label>
      <p id="toolHint" class="hint"></p>
      <details class="more" id="dMoreTools"><summary>More tools</summary>
        <div class="stack">
          <button class="btn wide tool" data-tool="patch" type="button" title="Click four corners on the model : four curves and a named component">Quad patch, 4 clicks <kbd>A</kbd></button>
          <button class="btn wide tool" data-tool="seed" type="button" title="Click on the model to place the component named in the Components field">Place a component <kbd>C</kbd></button>
          <button class="btn wide tool" data-tool="merge" type="button" title="Two points of the curves become one node in their middle, exactly the same coordinates">Merge two points <kbd>⇧M</kbd></button>
          <button class="btn wide tool" data-tool="insert" type="button">Insert point <kbd>I</kbd></button>
          <button class="btn wide tool" data-tool="split" type="button">Split curve <kbd>S</kbd></button>
          <button class="btn wide tool" data-tool="tweak" type="button">Tweak mesh <kbd>T</kbd></button>
          <button class="btn wide tool" data-tool="face" type="button">Pick a face <kbd>G</kbd></button>
          <button class="btn wide tool" data-tool="loop" type="button">Insert edge loop <kbd>L</kbd></button>
          <button class="btn wide tool" data-tool="extend" type="button">Extend a strip <kbd>E</kbd></button>
          <button class="btn wide tool" data-tool="rings" type="button" title="Click the middle of an opening : concentric rings and radial seams, by the conventions of a face archetype">Rings around a point</button>
          <button id="bRingsCurve" class="btn wide" type="button" title="The selected curve is the opening (the lip line, an eyelid, the edge of a wheel arch) : rings grow around it">Rings around the selected curve</button>
          <label class="slider" title="The conventions : eye 3 rings of 16, mouth 4 rings of 24, nostril 2 of 8, wheel arch 3 of 24"><span>Archetype</span><select id="pArch"><option value="eye">Eye</option><option value="mouth">Mouth</option><option value="nostril">Nostril</option><option value="arch">Wheel arch</option></select></label>
          <label class="slider" title="Distances of the rings from the opening in millimetres, empty for the archetype's own"><span>Rings (mm)</span><input id="pRingsMm" type="text" placeholder="archetype default" size="16"></label>
          <label class="slider" title="Radial divisions, empty for the archetype's own"><span>Divisions</span><input id="pRingsN" type="number" min="4" max="64" step="1" placeholder="auto" style="width:4.5em"></label>
        </div>
      </details>
    </section>
    <section class="block">
      <details class="more" id="dViewOpts"><summary>View options</summary>
        <p class="hint"><a href="index.html">The 2D views</a></p>
        <label class="check" title="Two fingers turn around the model, pinch zooms, Shift + two fingers pans (Blender on a Mac). A mouse wheel still zooms."><input id="pTrackpad" type="checkbox" checked> Trackpad like Blender</label>
        <label class="check"><input id="pXray" type="checkbox"> X-ray <kbd>X</kbd></label>
      </details>
      <details class="more" id="dDisplay"><summary>Display</summary>
        <div class="checks">
          <label class="check"><input id="pModel" type="checkbox" checked> Model</label>
          <label class="check"><input id="pHidden" type="checkbox" checked> Hidden curves, faint</label>
          <label class="check"><input id="pNodes" type="checkbox" checked> Nodes</label>
          <label class="check"><input id="pHandles" type="checkbox" checked> Control points</label>
          <label class="check"><input id="pMesh" type="checkbox" checked> Quad mesh</label>
          <label class="check"><input id="pSnap" type="checkbox" checked> Snap to surface</label>
          <label class="check"><input id="pSheet" type="checkbox" checked> Reference sheet in the views</label>
          <label class="check"><input id="pShowCreases" type="checkbox"> Show the creases (red)</label>
        </div>
      </details>
      <details class="more" id="dKeys"><summary>Keys and gestures</summary>
        <ul class="keys">
          <li>Two fingers : turn around ; pinch : zoom ; <kbd>Shift</kbd> + two fingers : pan</li>
          <li><kbd>Alt</kbd> + drag, or right drag : turn ; middle drag : pan ; wheel : zoom</li>
          <li>Draw tool : click points, or <b>drag a stroke</b> along a fold ; a curve ends on a point or a curve (<kbd>Shift</kbd> keeps going) ; <kbd>Shift</kbd> <kbd>C</kbd> snaps curves onto the creases</li>
          <li><kbd>Home</kbd> normal view ; <kbd>[</kbd> <kbd>]</kbd> previous or next view ; <kbd>0</kbd> to <kbd>6</kbd> views ; <kbd>F</kbd> frame ; <kbd>O</kbd> ortho</li>
          <li><kbd>W</kbd> auto patch ; <kbd>D</kbd> draw ; <kbd>A</kbd> quad patch ; <kbd>C</kbd> component</li>
          <li><kbd>Enter</kbd> finish a curve ; <kbd>Esc</kbd> cancel ; <kbd>Backspace</kbd> last point</li>
          <li><kbd>Del</kbd> delete ; <kbd>R</kbd> round ; <kbd>J</kbd> join ; <kbd>H</kbd> hide a part ; <kbd>Shift H</kbd> show all</li>
          <li><kbd>P</kbd> preview faces ; <kbd>U</kbd> isolate ; <kbd>B</kbd> best pattern ; <kbd>N</kbd> next problem ; <kbd>K</kbd> corner</li>
          <li><kbd>F2</kbd> rename the component ; <kbd>Cmd Z</kbd> undo ; <kbd>Shift Cmd Z</kbd> redo ; <kbd>Cmd S</kbd> save</li>
        </ul>
      </details>
    </section>
  </aside>

  <main id="center">
    <div id="stage3"><canvas id="cv"></canvas><div id="tags"></div><div id="boxSel"></div><div id="topoBadge" class="badge" hidden></div><button id="isoBadge" class="badge iso" type="button" hidden title="Show every part again (U, Shift H, Esc or Normal view)"></button></div>
    <div id="statusBar" role="status"><span id="status">Loading...</span><span id="coords" class="coords3"></span></div>
  </main>

  <aside id="right" aria-label="Edit">
    <section class="block" id="blkSel">
      <h2>Selection</h2>
      <div id="selTitle" class="sel-title">Nothing selected</div>
      <div id="selInfo" class="hint">Click a curve, a point or a name. Shift adds ; drag a box to select several ; click on empty space to deselect.</div>
      <div class="buttons wrap" id="selActions">
        <button id="bStraight" class="btn" data-for="curve" type="button" title="A straight line between its two ends, put on the surface">Straighten</button>
        <button id="bDuplicate" class="btn" data-for="curve" type="button" title="A copy next to it (Cmd D), mirrored too when Mirror is on">Duplicate</button>
        <button id="bSmooth" class="btn" data-for="curve" type="button">Smooth</button>
        <button id="bRound" class="btn" data-for="curve" type="button">Round <kbd>R</kbd></button>
        <button id="bSimplify" class="btn" data-for="curve" type="button">Simplify</button>
        <button id="bReverse" class="btn" data-for="curve" type="button">Reverse</button>
        <button id="bProject" class="btn" data-for="curve" type="button" title="Put its control points back on the surface">Snap to surface</button>
        <button id="bSnapCreases" class="btn" data-for="curve" type="button" title="Join it again along the creases of the model, when it lies close to one (look at it from the front) (Shift C)">Snap to creases <kbd>Shift C</kbd></button>
        <button id="bWeld" class="btn" data-for="curve" type="button" title="Its ends exactly on their points">Weld ends</button>
        <button id="bMergeSel" class="btn" data-for="nodes2" type="button" title="The two points become one, in their middle, on the surface (Shift M)">Merge the 2 points</button>
        <button id="bConnect" class="btn" data-for="nodes2" type="button" title="A straight curve between the two points, on the surface">Connect them</button>
        <button id="bJoin" class="btn" data-for="node" type="button" title="The two curves meeting at this point become one (J)">Join curves <kbd>J</kbd></button>
        <button id="bDelete" class="btn danger" data-for="any" type="button" title="Delete (Del or Backspace)">Delete</button>
      </div>
      <details class="more" id="dSelMore"><summary>Selection options</summary>
        <label class="slider"><span>Smooth amount</span><input id="pSmooth" type="range" min="0.05" max="1" step="0.05" value="0.5"></label>
        <label class="slider"><span>Control points (simplify)</span><input id="pCtrl" type="range" min="4" max="24" step="1" value="6"><b id="pCtrlVal">6</b></label>
        <div class="row">
          <input id="selText" type="search" placeholder="Select curves whose components contain..." autocomplete="off" spellcheck="false">
          <button id="bSelText" class="btn" type="button">Select</button>
        </div>
        <div class="buttons"><button id="bSelAll" class="btn" type="button">All</button><button id="bSelNone" class="btn" type="button">None</button><button id="bSelInvert" class="btn" type="button">Invert</button></div>
      </details>
    </section>
    <section class="block" id="blkProblems">
      <h2>Problems</h2>
      <div id="problemList" class="problems"></div>
      <div class="buttons wrap">
        <button id="bAutoFix" class="btn primary" type="button" title="Safe steps only : weld ends, remove doubles, repair, keep a step only when it measures better">Fix what is safe</button>
        <button id="bNextProblem" class="btn" type="button" title="Go to the next problem and frame it (N)">Next problem <kbd>N</kbd></button>
      </div>
    </section>
    <section class="block">
      <details class="more first" id="dComps"><summary>Components <span id="compCount" class="count"></span> : names, rename, delete</summary>
      <div class="row"><input id="compName" type="text" placeholder="Name of the next component" autocomplete="off" spellcheck="false"><button id="bCompAdd" class="btn" type="button">Place <kbd>C</kbd></button></div>
      <input id="compFilter" type="search" placeholder="Filter" autocomplete="off" spellcheck="false" class="filter">
      <div id="compList" class="list comps"></div>
      <details class="more" id="dCompOptions"><summary>Component options</summary>
        <div class="buttons wrap">
          <button id="bCompRename" class="btn" type="button">Rename</button>
          <button id="bCompDelete" class="btn" type="button">Remove name</button>
          <button id="bCompDeleteAll" class="btn" type="button">Delete with its curves</button>
          <button id="bCompCurves" class="btn" type="button">Its curves</button>
          <button id="bCompIsolate" class="btn" type="button">Isolate <kbd>U</kbd></button>
          <button id="bCompBest" class="btn" type="button">Best pattern <kbd>B</kbd></button>
          <button id="bPatternPrev" class="btn" type="button">Previous pattern</button>
          <button id="bCompRotate" class="btn" type="button">Next pattern</button>
          <button id="bCompDenser" class="btn" type="button">Denser</button>
          <button id="bCompCoarser" class="btn" type="button">Coarser</button>
          <button id="bCompSkip" class="btn" type="button">Skip or keep</button>
          <button id="bCompImport" class="btn" type="button">Import car components</button>
          <button id="bCompName" class="btn" type="button">Name faces from the model</button>
        </div>
      </details>
      </details>
    </section>
    <section class="block">
      <h2>Houdini</h2>
      <div class="buttons wrap">
        <button id="bChainBuild" class="btn primary" type="button" title="Curves (control point matrices), components and quads rebuilt as they are in /obj/ZRL_Chain">Build in Houdini</button>
        <button id="bChainPull" class="btn" type="button" title="The curves moved in Houdini (EDIT_curves) come back here, one undo step">Pull from Houdini</button>
      </div>
      <details class="more" id="dManual"><summary>Manual preview and numbers</summary>
        <div class="buttons wrap">
          <button id="bPreview" class="btn" type="button">Preview faces <kbd>P</kbd></button>
          <button id="bMesh" class="btn" type="button">Convert to mesh</button>
        </div>
        <div id="legend" class="legend"></div>
        <div id="doctorInfo" class="hint"></div>
        <div id="meshInfo" class="info"></div>
      </details>
    </section>
    <section class="block">
      <details class="more" id="dMesh"><summary>Mesh settings and repair</summary>
        <div class="checks">
          <label class="check"><input id="pLive" type="checkbox" checked> Live preview of the faces</label>
          <label class="check"><input id="pLiveMesh" type="checkbox"> Live wireframe of the quads</label>
          <label class="check"><input id="pFaces" type="checkbox" checked> Faces and corners</label>
          <label class="check"><input id="pDoctor" type="checkbox" checked> Loose curves in red</label>
          <label class="check"><input id="pSolo" type="checkbox"> Selected curves only</label>
          <label class="check"><input id="pCompColour" type="checkbox"> Colour the quads by component</label>
          <label class="check"><input id="pSymX" type="checkbox"> Exact symmetry across x = 0</label>
        </div>
        <label class="slider" title="The edge length of the quads : smaller means more, finer quads (1 mm for a character)"><span>Quad size (m)</span><input id="pEdge" type="range" min="0.001" max="0.08" step="0.0005" value="0.02"><b id="pEdgeVal">0.020</b></label>
        <label class="slider" title="LOD : Catmull-Clark levels on the quads (each level makes four quads of one, the surface smoother)"><span>Smoothness LOD</span><input id="pLod" type="range" min="0" max="3" step="1" value="0"><b id="pLodVal">0</b></label>
        <label class="check" title="Each level is fitted back onto the model, so the new quads follow its curvature"><input id="pLodFit" type="checkbox" checked> LOD fitted to the model</label>
        <label class="slider"><span>Corner angle (deg)</span><input id="pCorner" type="range" min="10" max="80" step="1" value="35"><b id="pCornerVal">35</b></label>
        <label class="slider"><span>Relax iterations</span><input id="pRelax" type="range" min="0" max="200" step="5" value="30"><b id="pRelaxVal">30</b></label>
        <div class="buttons wrap">
          <button id="bBestAll" class="btn" type="button">Best patterns, all faces</button>
          <button id="bDoctor" class="btn" type="button">Check network</button>
          <button id="bRepair" class="btn" type="button">Repair network</button>
          <button id="bSnapSurface" class="btn" type="button">Snap curves on surface</button>
          <button id="bBridge" class="btn" type="button">Bridge islands</button>
          <button id="bWeldAll" class="btn" type="button">Weld every end</button>
          <button id="bCorner" class="btn" type="button">Corner on or off <kbd>K</kbd></button>
          <button id="bRelaxMesh" class="btn" type="button">Relax mesh</button>
          <button id="bClearMesh" class="btn" type="button">Clear mesh</button>
          <button id="bCreaseAlign" class="btn" type="button">Edges on creases (this view)</button>
          <button id="bHoudini" class="btn" type="button">Send mesh only to Houdini</button>
        </div>
      </details>
      <details class="more" id="dFiles"><summary>Model and files</summary>
        <p class="hint">The six view sheet first, then the 3D model : a new version of the model replaces the reference and every curve follows its surface.</p>
        <div class="row"><input id="modelPath" type="text" placeholder="/path/to/model.obj, or original" autocomplete="off" spellcheck="false"></div>
        <label class="check"><input id="pModelViews" type="checkbox" checked> Also render the 2D views and warp the sheet</label>
        <div class="buttons wrap"><button id="bUseModel" class="btn" type="button">Use this model</button></div>
        <div id="modelInfo" class="info"></div>
        <div class="buttons wrap">
          <button id="bLoadSaved" class="btn" type="button">Load saved</button>
          <button id="bLoadOriginal" class="btn" type="button">Load original</button>
          <button id="bLoadMbo" class="btn" type="button">Load component network</button>
          <button id="bNewNet" class="btn" type="button">New empty network</button>
          <button id="bChainExport" class="btn" type="button">Export chain file</button>
          <button id="bExportJson" class="btn" type="button">Export JSON</button>
          <button id="bExportCode" class="btn" type="button" title="The curves as Python : one numpy matrix per curve and the mirror transform, the same numbers as the saved file">Export curves as code (.py)</button>
          <button id="bExportSvg" class="btn" type="button">Export SVG</button>
          <button id="bExportPng" class="btn" type="button">Export PNG</button>
          <button id="bExportObj" class="btn" type="button">Export OBJ</button>
        </div>
      </details>
    </section>
  </aside>
</div>
