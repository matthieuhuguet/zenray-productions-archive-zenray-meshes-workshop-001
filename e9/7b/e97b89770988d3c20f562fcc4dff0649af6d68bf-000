"""5 November 2026 : PARTSRESTORE, put the clean pre-sculpt vertices back for the thin parts (plates, wing skins) that the sculpt and the contour snap tear into shards : the vertices of the named tubes are found in the pre-sculpt mesh by exact position, then copied back into the final mesh. FR : remet les sommets propres d'avant sculpt pour les parties minces que le sculpt et l'accrochage déchirent.
Usage : python PartsRestore.py fit.json pre.obj final.obj out.obj name_prefixes(comma, e.g. plate_,skin_) [tol]"""
import sys, json, numpy as np
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts/Dracard"); sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts/Dracard/Comp")
import DragonShape as DS
from CompFit import load_quads
from scipy.spatial import cKDTree
D = json.load(open(sys.argv[1])); Vp, Fp = load_quads(sys.argv[2]); Vf, Ff = load_quads(sys.argv[3]); pref = tuple(sys.argv[5].split(",")); tol = float(sys.argv[6]) if len(sys.argv) > 6 else 2e-3
assert len(Vp) == len(Vf)
P = []
for t in D["tubes"]:
    if t["name"].startswith(pref):
        v, f = DS.tube_mesh(t); P.append(v)
        if t.get("mirror"): v2 = v.copy(); v2[:, 0] = -v2[:, 0]; P.append(v2)
P = np.vstack(P); d, i = cKDTree(Vp).query(P); ok = d < tol; idx = np.unique(i[ok]); print("plate points", len(P), "matched", int(ok.sum()), "median dist %.5f" % float(np.median(d)), "restored vertices", len(idx))
V = Vf.copy(); V[idx] = Vp[idx]
with open(sys.argv[4], "w") as o:
    for p in V: o.write("v %.6f %.6f %.6f\n" % tuple(p))
    for f in Ff: o.write("f " + " ".join(str(k + 1) for k in f) + "\n")
