# 25 October 2026 : ZenRay Meshes, CLEAN VIEW of ONE asset only (never the scene) : smooth shaded (vertex normals, cusp
# angle), four views (three quarter front, three quarter rear, side, front), optional part filter, one board. This is the
# judge of "is the surface clean" ; the orthographic sheet boards judge "is it the right shape".
# FR : rendu lissé de l'asset seul, quatre vues, pour juger la propreté de la surface.
# Usage: python CleanView.py <car.npz> <out.png> [exclude=sub1,sub2] [cusp_deg=30] [res=900]
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from PIL import Image
import Raster

VIEWS = {"three_quarter_front": ((0.70, 0, -0.71), (-0.25, 0.94, -0.25)), "three_quarter_rear": ((-0.70, 0, 0.71), (0.25, 0.94, 0.25)),
         "side": ((0, 0, -1), (0, 1, 0)), "front": ((1, 0, 0), (0, 1, 0))}
KEY = np.array([-0.35, 0.75, 0.55]); KEY /= np.linalg.norm(KEY)


def main(npz, out, exclude="", cusp=30, res=900):
    d = np.load(npz, allow_pickle=True); P, F = d["P"], d["F"]
    if "T" in d.files and exclude:
        subs = [s for s in exclude.split(",") if s]; N = d["names"]; keep = np.array([not any(s in n for s in subs) for n in N])[d["T"]]; F = F[keep]
    res = int(res); r = Raster.Renderer(P, F, smooth_deg=float(cusp)); V = P[np.unique(F)]
    c = (V.max(0) + V.min(0)) / 2; ext = np.linalg.norm(V.max(0) - V.min(0)); tiles = []
    for name, (rx, uy) in VIEWS.items():
        rx = np.array(rx, float); rx /= np.linalg.norm(rx); uy = np.array(uy, float); uy -= rx * (uy @ rx); uy /= np.linalg.norm(uy); tz = np.cross(rx, uy)
        M, _, N_, _ = r.render(c, res / (ext * 1.05), (rx.tolist(), uy.tolist(), tz.tolist()), res)
        Lc = np.array([KEY @ rx, KEY @ uy, KEY @ tz]); sh = np.clip(0.18 + 0.82 * np.clip((N_ * Lc).sum(-1), 0, 1), 0, 1)
        img = np.where(M, sh * 235, 92).astype(np.uint8); tiles.append(img)
    r.release()
    Image.fromarray(np.concatenate([np.concatenate(tiles[:2], 1), np.concatenate(tiles[2:], 1)], 0)).save(out); print(out)


if __name__ == "__main__":
    main(*sys.argv[1:])
