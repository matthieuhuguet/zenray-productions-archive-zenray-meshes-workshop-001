"""31 October 2026 : three oblique views of the wheel (front 3/4, back 3/4, top 3/4) in one image, to see the closed volumes the side view hides.
    python -I WheelViews.py model.obj out.png"""
import sys
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts")
import numpy as np, trimesh, Raster
from PIL import Image
P = dict(size=640, scale=640, views=[(40, 15), (-140, 15), (40, 70)])     # (yaw, pitch) in degrees
def rot(yaw, pitch):
    y, p = np.radians(yaw), np.radians(pitch)
    ry = np.array([[np.cos(y), 0, np.sin(y)], [0, 1, 0], [-np.sin(y), 0, np.cos(y)]]); rx = np.array([[1, 0, 0], [0, np.cos(p), -np.sin(p)], [0, np.sin(p), np.cos(p)]]); return rx @ ry
mesh = trimesh.load(sys.argv[1], force="mesh", process=False); tiles = []
key = np.array([-0.4, 0.55, 0.73]); key /= np.linalg.norm(key)
for yaw, pitch in P["views"]:
    v = mesh.vertices @ rot(yaw, pitch).T; mr = Raster.Renderer(v, mesh.faces)
    M, D, N, F = mr.render([0, 0, 0], P["scale"], ([1, 0, 0], [0, 1, 0], [0, 0, 1]), P["size"])
    val = np.clip(0.3 + 0.6 * np.clip((N * key).sum(-1), 0, 1) + 0.1 * N[..., 2], 0, 1); tiles.append(np.stack([np.where(M, val * 255, 118).astype(np.uint8)] * 3, -1))
Image.fromarray(np.hstack(tiles)).save(sys.argv[2]); print("ok")
