"""Rendu argile des vues de la voiture facettée : lumière ponctuelle + ambiante hémisphérique, déterministe. 30 October 2026."""
import numpy as np
def clay_from_views(views, light_rel=(-0.5, 0.8, 0.6), light_dist=6.0, amb=0.40, gain=0.55, hemi=0.12, bg=0.40, noise=0.0, rng=None):
    """Lumière ponctuelle placée RELATIVEMENT à chaque caméra (comme les planches générées : une lumière par vue). hemi : terme ciel/sol."""
    out = {}
    rng = rng or np.random.default_rng(0)
    for nm, v in views.items():
        a, b, d = v["frame"][:3]; x0, y1, px = v["frame"][3], v["frame"][4], v["frame"][5]
        H, W = v["mask"].shape
        xs = x0 + (np.arange(W) + 0.5) * px; ys = y1 - (np.arange(H) + 0.5) * px
        UU, VV = np.meshgrid(xs, ys)
        Zd = np.where(v["mask"], v["depth"], 0.0)
        X = UU[..., None] * a + VV[..., None] * b + (Zd - 20.0 + 20.0)[..., None] * d          # point 3D (depth = z le long de d)
        L = np.array(light_rel[0] * a + light_rel[1] * b + light_rel[2] * d, float); L /= np.linalg.norm(L)
        Lpos = L * light_dist
        l = Lpos[None, None, :] - X
        l /= np.linalg.norm(l, axis=2, keepdims=True)
        n = v["n"]
        ndl = np.clip((n * l).sum(2), 0, None)
        up = np.clip(n[..., 1], -1, 1)
        img = amb + gain * ndl + hemi * up
        if noise > 0: img = img + rng.normal(0, noise, img.shape)
        img = np.where(v["mask"], img, bg)
        out[nm] = np.clip(img, 0, 1)
    return out
