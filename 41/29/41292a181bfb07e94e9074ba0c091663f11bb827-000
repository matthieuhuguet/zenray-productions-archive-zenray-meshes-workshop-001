# 28 October 2026 00:15: Composite the editable one-line title over the enlarged Houdini wireframe.
from pathlib import Path
from PIL import Image, ImageDraw
root=Path(__file__).resolve().parents[1]
background=Image.open(root/'Car-V591-smoothwire.png').convert('RGB')
ImageDraw.Draw(background).rectangle((1880,0,2047,85),fill='black')
for i in range(1,61):
    output=background.copy()
    title=Image.open(root/'part-ii-frames'/f'frame_{i:06}.png').convert('RGB').crop((60,620,1020,800)).resize((1850,347),Image.Resampling.LANCZOS)
    output.paste(title,(99,165),title.convert('L'))
    output.save(root/'part-ii-composite'/f'frame_{i:06}.png')
    if i==60: output.save(root/'ZenRay-Modeling-Car-Part-II-V591.png')
