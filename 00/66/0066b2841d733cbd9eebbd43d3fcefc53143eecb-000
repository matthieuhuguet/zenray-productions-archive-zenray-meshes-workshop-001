# EN: thickness classes of a wood mask by morphological opening : thick = structures wider than 2 r1 (trunk, main limbs), medium = wider than 2 r2 (branches),
# thin = the rest (twigs) ; radii in metres from the trunk of the instance (thick_frac, med_frac of the trunk top radius), ppm = pixels per metre of the view.
# FR : classes d'épaisseur du bois par ouverture morphologique, relatives au tronc de l'instance.
import numpy as np
from scipy import ndimage as ndi


def disk(r):
    r = max(int(round(r)), 1); y, x = np.ogrid[-r: r + 1, -r: r + 1]; return (x * x + y * y) <= r * r


def wood_classes(mask, ppm, r1_m, r2_m):
    thick = ndi.binary_opening(mask, structure=disk(r1_m * ppm)); op2 = ndi.binary_opening(mask, structure=disk(r2_m * ppm))
    mid = op2 & ~ndi.binary_dilation(thick, iterations=1) & mask; thin = mask & ~op2 & ~thick
    return {"thick": thick, "med": mid, "thin": thin, "all": mask}


def radii(trunk_top_r, thick_frac=0.35, med_frac=0.12):
    return thick_frac * trunk_top_r, med_frac * trunk_top_r
