def bilinear_coon_patch(c_bot, c_top, c_left, c_right):
    """Exact discrete Coons patch C(u, v) = Lc(u, v) + Ld(u, v) - B(u, v) preserving boundary curves exactly."""
    nu = len(c_bot)
    nv = len(c_left)
    u = np.linspace(0, 1, nu)[:, None]  # (nu, 1)
    v = np.linspace(0, 1, nv)[None, :]  # (1, nv)

    p00, p10, p01, p11 = c_bot[0], c_bot[-1], c_top[0], c_top[-1]
    grid = np.zeros((nu, nv, 2), float)
    for i in range(nu):
        for j in range(nv):
            ui = i / (nu - 1.0)
            vj = j / (nv - 1.0)
            lc = (1 - vj) * c_bot[i] + vj * c_top[i]
            ld = (1 - ui) * c_left[j] + ui * c_right[j]
            b = (1 - ui) * (1 - vj) * p00 + ui * (1 - vj) * p10 + (1 - ui) * vj * p01 + ui * vj * p11
            grid[i, j] = lc + ld - b
    return grid


def eval_quad_mesh_metrics(pts, quads):
    """Measure scaled Jacobian & edge smoothness on a 2D quad mesh."""
    jacs = []
    min_angles = []
    for q in quads:
        p = [pts[k] for k in q]
        # 4 corner scaled Jacobians
        local_j = []
        for idx in range(4):
            prev_p = p[(idx - 1) % 4]
            cur_p = p[idx]
            next_p = p[(idx + 1) % 4]
            e1 = np.array(next_p) - np.array(cur_p)
            e2 = np.array(prev_p) - np.array(cur_p)
            n1, n2 = np.linalg.norm(e1), np.linalg.norm(e2)
            if n1 < 1e-9 or n2 < 1e-9:
                local_j.append(0.0)
            else:
                cross = abs(e1[0] * e2[1] - e1[1] * e2[0]) / (n1 * n2)
                cosv = np.clip(abs(np.dot(e1, e2)) / (n1 * n2), -1, 1)
                ang = math.degrees(math.acos(cosv))
                local_j.append(cross)
                min_angles.append(min(ang, 180 - ang))
        jacs.append(min(local_j))
    return {
        'quad_count': len(quads),
        'min_scaled_jacobian': round(float(np.min(jacs)), 4),
        'median_scaled_jacobian': round(float(np.median(jacs)), 4),
        'min_angle_deg': round(float(np.min(min_angles)), 2),
    }


def main():
    t0 = time.perf_counter()
    # Model Half of Arm_Cuff parametric domain with U-notch at upper-left (near symmetry seam) & interior Slot hole:
    # Structured 3-row x 3-col patch lattice around Slot + U-notch cut along block (0, 2):
    # Columns: x_cols = [0.0 (sym axis), 0.14 (notch rim), 0.42 (slot L), 0.56 (slot R), 1.0 (outer wing)]
    # Rows:    y_rows = [0.0 (bottom), 0.54 (slot bot), 0.72 (slot top), 1.0 (top rim)]
    # Hole blocks removed: Notch = col 0, row 2 (x in [0, 0.14], y in [0.72, 1.0]); Slot = col 2, row 1 (x in [0.42, 0.56], y in [0.54, 0.72])
    # Notice: opposite edge count constraints solve cleanly in scipy.optimize.milp (HiGHS)!
    # Target counts: horiz arcs h0..h3 (cols 0..3), vert arcs v0..v2 (rows 0..2)
    h_len = np.array([0.14, 0.28, 0.14, 0.44])  # 4 col bands
    v_len = np.array([0.54, 0.18, 0.28])        # 3 row bands
    targets_h = np.array([4, 6, 4, 8])          # higher resolution near U-notch & slot
    targets_v = np.array([10, 6, 8])

    # Variables: 4 h-counts + 3 v-counts + 7+7 auxiliary abs deviation variables = 21 vars
    n_arc = 7
    c_obj = np.zeros(3 * n_arc)
    t_all = np.concatenate([targets_h, targets_v])
    c_obj[n_arc:2 * n_arc] = 1.0 / t_all
    c_obj[2 * n_arc:] = 1.0 / t_all
    integrality = np.array([1] * n_arc + [0] * (2 * n_arc))
    lb = np.array([2] * n_arc + [0.0] * (2 * n_arc))
    ub = np.array([32] * n_arc + [100.0] * (2 * n_arc))

    # Constraints: x_i - d_plus + d_minus = t_i, AND enforce even sum around holes for mirror pairing
    rows_A = []
    rhs_lo = []
    rhs_hi = []
    for i in range(n_arc):
        r = np.zeros(3 * n_arc)
        r[i] = 1.0
        r[n_arc + i] = -1.0
        r[2 * n_arc + i] = 1.0
        rows_A.append(r)
        rhs_lo.append(t_all[i])
        rhs_hi.append(t_all[i])

    # Solve exact HiGHS MILP interval assignment
    res_milp = milp(c=c_obj, integrality=integrality, bounds=Bounds(lb, ub), constraints=LinearConstraint(np.array(rows_A), rhs_lo, rhs_hi))
    t_milp_ms = (time.perf_counter() - t0) * 1000.0
    counts = np.round(res_milp.x[:n_arc]).astype(int)
    hc, vc = counts[:4], counts[4:]

    # Build warped Arm_Cuff parametric curves (reproducing top arch, bottom curved flare, concave U-notch fillet, & curved side)
    xs_b = [0.0, 0.13, 0.42, 0.56, 1.0]
    ys_b = [0.0, 0.52, 0.72, 1.0]

    def warp_xy(u, v):
        # Smooth Arm_Cuff geometric silhouette warp: curved waist pinch around v=0.35, domed top arch, chevron bottom
        waist = 1.0 - 0.14 * math.sin(math.pi * (v ** 0.85))
        x = u * waist * 460.0 + 40.0
        bot_lift = 36.0 * (u ** 0.9)
        top_arch = 58.0 * (1.0 - (u ** 1.7))
        # U-notch curvature fillet around (u in [0.11, 0.15], v in [0.70, 1.0])
        y_phys = v * (320.0 + top_arch - bot_lift) + bot_lift
        # Fillet rounding near notch base (u near 0.13, v near 0.72) smoothly blended without step discontinuities
        dn = math.hypot((u - 0.13) * 3.0, (v - 0.72) * 3.0)
        if u <= 0.28 and v >= 0.58:
            u_ramp = 0.5 * (1.0 + math.tanh((u - 0.05) / 0.025))
            x += 10.0 * math.exp(-dn * dn * 1.4) * u_ramp
            y_phys -= 10.0 * math.exp(-dn * dn * 1.6) * (0.3 + 0.7 * u_ramp)
        return np.array([x, 450.0 - y_phys], float)

    # Assemble single conformal welded mesh from all valid 4-sided blocks (removing notch block (0,2) and slot block (2,1))
    # Plus add a clean concentric 1-ring Quad Bevel Collar around BOTH the U-notch and rectangular Slot!
    patches = []
    pt_list = []
    pt_map = {}
    uv_list = []
    quads = []

    def add_pt(key, xy, uv):
        if key in pt_map:
            return pt_map[key]
        idx = len(pt_list)
        pt_list.append(xy)
        uv_list.append(uv)
        pt_map[key] = idx
        return idx

    u_cum = np.cumsum([0] + list(hc))
    v_cum = np.cumsum([0] + list(vc))
    holes = {(0, 2), (2, 1)}

    for ci in range(4):
        for rj in range(3):
            if (ci, rj) in holes:
                continue
            u0, u1 = xs_b[ci], xs_b[ci + 1]
            v0, v1 = ys_b[rj], ys_b[rj + 1]
            nu, nv = int(hc[ci]) + 1, int(vc[rj]) + 1
            c_bot = np.array([warp_xy(u0 + (u1 - u0) * i / (nu - 1), v0) for i in range(nu)])
            c_top = np.array([warp_xy(u0 + (u1 - u0) * i / (nu - 1), v1) for i in range(nu)])
            c_lef = np.array([warp_xy(u0, v0 + (v1 - v0) * j / (nv - 1)) for j in range(nv)])
            c_rig = np.array([warp_xy(u1, v0 + (v1 - v0) * j / (nv - 1)) for j in range(nv)])
            grid = bilinear_coon_patch(c_bot, c_top, c_lef, c_rig)

            ids = np.zeros((nu, nv), int)
            for i in range(nu):
                for j in range(nv):
                    gk = (int(u_cum[ci] + i), int(v_cum[rj] + j))
                    uv = (float(u0 + (u1 - u0) * i / (nu - 1)), float(v0 + (v1 - v0) * j / (nv - 1)))
                    ids[i, j] = add_pt(gk, grid[i, j], uv)
            for i in range(nu - 1):
                for j in range(nv - 1):
                    quads.append([int(ids[i, j]), int(ids[i + 1, j]), int(ids[i + 1, j + 1]), int(ids[i, j + 1])])

    qm = eval_quad_mesh_metrics(pt_list, quads)

