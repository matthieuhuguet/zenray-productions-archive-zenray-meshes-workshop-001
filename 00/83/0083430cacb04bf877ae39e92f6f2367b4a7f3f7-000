#!/usr/bin/env python3
# 10 November 2026: chart of the 30 HDAs of the skill as they behave in Houdini 22 (data/hda_check.json, measured by hython).
import json, sys
from collections import Counter, defaultdict
sys.path.insert(0, '/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026/scripts'); import chartlib as C
A = '/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026'; R = json.load(open(A + '/data/hda_check.json'))
C.CATS = [('native', 'Marche, réseau de nœuds natifs', '#1f1f1e', None), ('button', 'Marche après un bouton et des scripts externes', '#6f6e69', None), ('python', 'Marche, un seul nœud Python dedans', '#b2b1ab', None), ('fail', 'Plante avec ses valeurs par défaut', '#f0efea', 45)]
def fam(f):
    if 'truck' in f: return 'Camion (12 pièces)'
    if 'hood' in f: return 'Capot de voiture'
    if f == 'zrm_component.hda': return 'Composant générique'
    return 'Dragon et créature'
t = defaultdict(Counter)
for r in R:
    ok = bool(r.get('prims')) and not r.get('errors')
    k = 'fail' if not ok else ('button' if r.get('needs_rebuild_button') else ('python' if r.get('native_nodes', 0) <= 2 else 'native'))
    if r.get('needs_rebuild_button') and ok: k = 'button'
    t[fam(r['file'])][k] += 1
rows = sorted(((f, dict(c)) for f, c in t.items()), key=lambda x: -sum(x[1].values()))
open(A + '/charts/10_hda_dans_houdini22.svg', 'w').write(C.hbar_stacked('Les 30 HDA du skill, ouverts dans Houdini 22', 'Chaque HDA créé sans interface (hython), valeurs par défaut, puis géométrie comptée ; mesuré le 10 November 2026.', rows, label_w=230,
    note="Les 12 pièces du camion donnent de vrais réseaux natifs (tubes, boîtes, chanfreins, booléens), mais seulement via un script rangé dans un dossier temporaire."))
print(rows)
