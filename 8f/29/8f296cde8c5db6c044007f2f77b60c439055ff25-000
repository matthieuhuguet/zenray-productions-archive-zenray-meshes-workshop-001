"""28 October 2026 : ZenRay Meshes SCHEMATIC MATCH (task KS2, the schematic as the source). Every curve of the curve rig is projected into the six
traced views (ViewTrace) and paired with the schematic line that covers it best ; the result says, curve by curve, which ref line carries it
and how far it sits from it, in pixels and in millimetres. A design curve that no ref line covers, or that sits more than far_px away, is
badly placed (the red fender of the first sheet) ; spokes are construction lines and only reported. Writes work/car/schematic/rig_match.json
and versions/views/Match_<view>.png : schematic lines grey, rig curves green (near), orange (off), red (far or not on any ref line).
python SchematicMatch.py [--rig work/car/curverig/RIG_car_hard.json]
FR : chaque courbe du réseau 3D appariée à la ligne de la ref qui la porte, avec son écart en millimètres."""
import argparse, json, os, sys
import numpy as np
from PIL import Image, ImageDraw, ImageFont
from scipy.spatial import cKDTree
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE); sys.path.insert(0, os.path.join(os.path.dirname(HERE), "retopo"))
import RigLib as RL
from Schematic import view_mapper
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"
PARAMS = {"construction_prefixes": ("sp", "up_", "ring_front_end", "ring_rear_end", "shelf_cut", "rad", "radA", "radC", "rear_q"), "views": ["left", "right", "top", "bottom", "front", "back"], "near_px": 3.0, "far_px": 8.0, "cover_px": 6.0, "min_len_px": 20, "min_cover": 0.5,
          "images": {"front": "00_front", "back": "01_back", "left": "02_left", "right": "03_right", "top": "04_top", "bottom": "05_bottom"},
          "scale": 3, "font": "/Users/zenray/Library/Fonts/GT-Standard-L-Standard-Regular.otf"}


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("--rig", default=W + "work/car/curverig/RIG_car_hard.json"); a = ap.parse_args()
    fr = json.load(open(W + "work/car/frame/frame.json")); lo = np.array(fr["lo"], float); hi = lo + np.array(fr["dims_m"], float); views = {v["name"]: v for v in fr["views"]}
    rig = json.load(open(a.rig)); C = np.array(rig["controls"], float); mirror = np.array([-1.0, 1, 1])
    def kind_of(n, c):   # construction curves (spokes, ring ends, band ends, cuts across a shelf) are not ref lines
        if n.startswith(PARAMS["construction_prefixes"]): return "construction"
        return "design" if (c.get("sharp") or c.get("fixed")) else "construction"
    curves = {n: (RL.evaluate(C[c["cvs"]], 160), kind_of(n, c)) for n, c in rig["curves"].items()}
    res = {n: {"kind": k, "views": {}} for n, (_, k) in curves.items()}
    for vn in PARAMS["views"]:
        d = json.load(open(W + "work/car/schematic/view_%s.json" % vn)); lines = [np.array(o["curve_px"]) for o in d["lines"]]
        trees = [cKDTree(L) for L in lines]; m = view_mapper(views[vn], lo, hi, 1.0); ppm = views[vn]["px_per_m"]
        for n, (E, kind) in curves.items():
            uv = m(E * (mirror if vn == "right" else 1))
            if np.linalg.norm(np.diff(uv, axis=0), axis=1).sum() < PARAMS["min_len_px"]: continue   # seen end on in this view
            best = None
            for li, T in enumerate(trees):
                dd = T.query(uv)[0]; cov = (dd <= PARAMS["cover_px"]).mean()
                if cov > 0 and (best is None or (cov, -dd[dd <= PARAMS["cover_px"]].mean()) > (best[1], -best[2])): best = (li, float(cov), float(dd[dd <= PARAMS["cover_px"]].mean()), float(np.median(dd)))
            if best: res[n]["views"][vn] = {"line": best[0], "component": d["lines"][best[0]]["component"], "cover": round(best[1], 3), "mean_px": round(best[2], 2), "median_px": round(best[3], 2), "mean_mm": round(best[2] / ppm * 1000, 1)}
    for n, r in res.items():   # the best view of a curve : the most covered one
        if r["views"]:
            bv = max(r["views"], key=lambda v: (r["views"][v]["cover"], -r["views"][v]["mean_px"])); b = r["views"][bv]; r["best"] = dict(view=bv, **b)
            r["state"] = "near" if b["cover"] >= PARAMS["min_cover"] and b["median_px"] <= PARAMS["near_px"] else ("off" if b["cover"] >= PARAMS["min_cover"] and b["median_px"] <= PARAMS["far_px"] else "far")
        else: r["state"] = "far"
    os.makedirs(W + "work/car/schematic", exist_ok=True); json.dump(res, open(W + "work/car/schematic/rig_match.json", "w"), indent=1)
    s = PARAMS["scale"]; col = {"near": (30, 160, 60), "off": (240, 140, 0), "far": (220, 30, 30)}; fnt = ImageFont.truetype(PARAMS["font"], 16)
    for vn in PARAMS["views"]:
        d = json.load(open(W + "work/car/schematic/view_%s.json" % vn)); I = Image.open(W + "work/car/views/%s_rgb.png" % PARAMS["images"][vn]).convert("RGB")
        img = Image.blend(I.resize((I.size[0] * s, I.size[1] * s), Image.LANCZOS), Image.new("RGB", (I.size[0] * s, I.size[1] * s), (255, 255, 255)), 0.55); dr = ImageDraw.Draw(img)
        for o in d["lines"]: dr.line([(x * s, y * s) for x, y in o["curve_px"]], fill=(150, 150, 150), width=1)
        m = view_mapper(views[vn], lo, hi, float(s))
        cnt = {k: 0 for k in col}
        for n, (E, kind) in curves.items():   # the colour says the match IN THIS VIEW (28 October 2026 : the best view of another panel misled)
            if kind != "design": continue
            uv = m(E * (mirror if vn == "right" else 1)); pv = res[n]["views"].get(vn)
            if np.linalg.norm(np.diff(uv / s, axis=0), axis=1).sum() < PARAMS["min_len_px"]: continue
            st = "far" if pv is None else ("near" if pv["cover"] >= PARAMS["min_cover"] and pv["median_px"] <= PARAMS["near_px"] else ("off" if pv["cover"] >= PARAMS["min_cover"] and pv["median_px"] <= PARAMS["far_px"] else "far"))
            cnt[st] += 1; dr.line([tuple(p) for p in uv], fill=col[st], width=3)
        dr.text((10, 8), "%s : courbes de design du réseau contre les lignes de la ref (gris), écart dans CETTE vue ; proches %d, décalées %d, loin ou sans ligne %d" % (vn, cnt["near"], cnt["off"], cnt["far"]), fill=(20, 20, 20), font=fnt)
        img.save(W + "versions/views/Match_%s.png" % vn)
    des = [r for r in res.values() if r["kind"] == "design"]
    print(json.dumps({"design": len(des), "near": sum(r["state"] == "near" for r in des), "off": sum(r["state"] == "off" for r in des), "far": sum(r["state"] == "far" for r in des),
                      "far_list": sorted([n for n, r in res.items() if r["kind"] == "design" and r["state"] == "far"])}))


if __name__ == "__main__":
    main()
