# 26 October 2026 : ZenRay Meshes, chart of History.py (silhouette and line scores per version), run under a venv with matplotlib.
# Usage: python HistoryPlot.py <history.json> <out.png>
import sys, json
import matplotlib; matplotlib.use("Agg"); import matplotlib.pyplot as plt
rows = json.load(open(sys.argv[1])); x = [r["v"] for r in rows]
fig, ax = plt.subplots(2, 1, figsize=(12, 7), sharex=True)
ax[0].plot(x, [r["sil"] for r in rows], label="silhouette (filled)"); ax[0].plot(x, [r["sil_raw"] for r in rows], label="silhouette (raw)", alpha=0.7)
ax[0].set_ylabel("IoU"); ax[0].legend(); ax[0].grid(alpha=0.3)
ax[1].plot(x, [r["lines"] for r in rows], label="lines (with steps)"); ax[1].plot(x, [r["lines_normal"] for r in rows], label="lines (normal only)", alpha=0.7)
ax[1].set_ylabel("F1"); ax[1].set_xlabel("version"); ax[1].legend(); ax[1].grid(alpha=0.3)
fig.suptitle("ZenRay Meshes car, scores per version, current measures (26 October 2026)")
fig.tight_layout(); fig.savefig(sys.argv[2], dpi=110); print(sys.argv[2])
