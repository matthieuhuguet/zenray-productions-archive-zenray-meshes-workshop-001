# 28 October 2026 15:28 Paris: provisional cuff from measured front and side contours.
import json, math
import hou

node = hou.pwd()
geo = node.geometry()
with open(node.evalParm('guide_file'), encoding='utf-8') as stream:
    curves = json.load(stream)['curves']
front = curves['front']
side = curves['side']

def x_at_y(points, y):
    points = sorted(points, key=lambda p: p[1])
    if y <= points[0][1]:
        return float(points[0][0])
    if y >= points[-1][1]:
        return float(points[-1][0])
    for a, b in zip(points, points[1:]):
        if a[1] <= y <= b[1]:
            t = (y - a[1]) / (b[1] - a[1])
            return a[0] + t * (b[0] - a[0])
    raise ValueError('No segment for measured height')

rows = node.evalParm('rows')
columns = node.evalParm('columns')
scale = node.evalParm('pixels_per_unit')
center_x = node.evalParm('front_axis')
center_z = node.evalParm('side_axis')
side_offset = node.evalParm('side_offset')
seam_angle = math.radians(node.evalParm('opening_degrees'))
points = []
for row in range(rows + 1):
    y_px = node.evalParm('top_y') + (node.evalParm('bottom_y') - node.evalParm('top_y')) * row / rows
    left = x_at_y(front['outer_left'], y_px)
    right = x_at_y(front['outer_right'], y_px)
    back = x_at_y(side['back'], y_px - side_offset)
    forward = x_at_y(side['front'], y_px - side_offset)
    for column in range(columns + 1):
        angle = seam_angle / 2 + (2 * math.pi - seam_angle) * column / columns
        xx = math.sin(angle)
        zz = math.cos(angle)
        x_px = center_x + xx * (right - center_x if xx >= 0 else center_x - left)
        z_px = center_z + zz * (forward - center_z if zz >= 0 else center_z - back)
        p = geo.createPoint()
        p.setPosition(((x_px-center_x)/scale, (node.evalParm('bottom_y')-y_px)/scale, (z_px-center_z)/scale))
        points.append(p)
for row in range(rows):
    for column in range(columns):
        q = geo.createPolygon()
        for idx in (row*(columns+1)+column, row*(columns+1)+column+1, (row+1)*(columns+1)+column+1, (row+1)*(columns+1)+column):
            q.addVertex(points[idx])
