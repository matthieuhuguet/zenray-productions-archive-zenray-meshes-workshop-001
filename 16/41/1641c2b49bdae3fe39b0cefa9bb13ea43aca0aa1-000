PARAMS = {   # 29 October 2026 : the interface of the whole car pass
    "edge_m": 0.02, "gap_m": 0.0035, "gap_parts": ["*door*", "*hood*", "*decklid*", "*glass*", "*bumper_front*"],
    "skip": ["*wheelwell*", "*under*", "*splitter*", "*grille*", "*fascia_front_band*"],
    "corner_snap_m": 0.035, "corner_scale": 0.04, "corner_sep": 0.12,
    "harmonic_cell_m": 0.004, "arc_weight": 0, "loop_join_m": 0.04,
