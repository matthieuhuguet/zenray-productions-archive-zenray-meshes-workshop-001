"""31 October 2026 : model part outlines drawn over the 3x zoomed reference wheel, same scale and same centre, to read every placement error by eye and by number (outline radius against the reference ring).
    python -I WheelOverlay.py parts_dir out.png"""
import sys, os
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts")
import numpy as np, trimesh, Raster
from PIL import Image, ImageEnhance
from scipy import ndimage
Z = 3; s = 391.8 * Z; R = 1400 * Z // 3; ox, oy = 290, 25                      # zoom 3, crop origin in the 960 x 524 reference crop
ref = Image.open("/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car/wheel_ref_front.png").convert("L").crop((ox, oy, ox + 310, oy + 310)).resize((930, 930), Image.LANCZOS)
img = np.stack([np.asarray(ImageEnhance.Contrast(ref).enhance(1.6))] * 3, -1).astype(np.uint8)
cxz, cyz = (443 - ox) * Z, (180 - oy) * Z                                      # hub centre in zoom pixels
colours = dict(tyre=(255, 80, 80), rim_band=(80, 255, 80), spokes=(80, 160, 255), hub=(255, 255, 0), dish=(255, 0, 255))
for name, col in colours.items():
    m = trimesh.load(os.path.join(sys.argv[1], name + ".obj"), force="mesh", process=False); mr = Raster.Renderer(m.vertices, m.faces); Rz = 930
    c = [(Rz / 2 - cxz) / s, -(Rz / 2 - cyz) / s, 0.0]                         # world point at the image centre, so the hub lands on (cxz, cyz)
    M, D, N, F = mr.render(c, s, ([1, 0, 0], [0, 1, 0], [0, 0, 1]), Rz)
    edge = M ^ ndimage.binary_erosion(M, iterations=2); img[edge] = col
Image.fromarray(img).save(sys.argv[2]); print("ok")
