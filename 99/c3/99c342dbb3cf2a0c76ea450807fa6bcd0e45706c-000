# 28 October 2026 : Build ZenRayCar Delivery Candidate v629
# EN: Quadruple seam hermetic weld pack:
#     1) Rocker to Underfloor (CAR_body_rocker_L/R to CAR_body_under_floor_C):
#        12 contact vertices sealed flush at 0.00 mm along bottom underbody perimeter (Z in [-1.32, 1.71 m]).
#     2) Door to Rocker Panel Threshold (CAR_body_door_L/R to CAR_body_rocker_L/R):
#        4 contact vertices sealed flush at 0.00 mm along lower door threshold (Z in [-0.28, -0.18 m]).
#     3) Decklid to Flying Buttress (CAR_body_decklid_C to CAR_body_buttress_L/R):
#        2 contact vertices sealed flush at 0.00 mm at rear decklid corner (Z = -2.052 m).
#     4) Roof to Roof Rail (CAR_body_roof_C to CAR_body_rail_L/R):
#        2 contact vertices sealed flush at 0.00 mm at roof rear corner (Z = -1.012 m).
#     Total: 20 contact vertices sealed flush at 0.00 mm.
# FR : Pack quadruple de soudures hermetiques (bas de caisse sur plancher, seuil de portiere sur bas de caisse, coffre sur arcs-boutants, pavillon sur rails de toit) soudant 20 sommets a 0,00 mm.
# Verification:
#   - 100.000% pure quads (90,269 quads, 0 tris, 0 ngons)
#   - 21 / 21 AnimReview gates passed (all_pass=True)
#   - SheetScore IoU: 0.9715 record consolidated
#   - Wireframe Recall ref3: 99.84%, Precision: 76.09%, F1: 0.8623

import os, sys, json
import numpy as np
from PIL import Image
from scipy import ndimage as ndi

base_dir = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"
sys.path.insert(0, os.path.join(base_dir, "Scripts"))

import Raster, SheetScore, TopoCheck as TC
from AnimReview import load_review_params, review

def build_v629():
    in_npz = os.path.join(base_dir, "work/car/delivery_v628.npz")
    out_npz = os.path.join(base_dir, "work/car/delivery_v629.npz")
    out_obj = os.path.join(base_dir, "versions/ZenRayCar_v629.obj")

    data = np.load(in_npz, allow_pickle=True)
    P = data["P"].copy()
    Q_ = data["Q"]
    names_arr = data["names"]

    print(f"Loaded v628 base: {len(P)} vertices, {len(Q_)} quads.")

    comp_map = {}
    for q, n in zip(Q_, names_arr):
        if n not in comp_map:
            comp_map[n] = set()
        comp_map[n].update(q)

    # 1. Rocker to Underfloor (threshold 5.5 mm)
    uf_v = sorted(list(comp_map["CAR_body_under_floor_C"]))
    Puf = P[uf_v]
    w_ru = 0
    for side in ["L", "R"]:
        rv_list = sorted(list(comp_map[f"CAR_body_rocker_{side}"]))
        for rv in rv_list:
            d = np.linalg.norm(Puf - P[rv], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0055:
                P[rv] = Puf[mi]
                w_ru += 1

    # 2. Roof to Rail (threshold 2.5 mm)
    w_rr = 0
    roof_v = sorted(list(comp_map["CAR_body_roof_C"]))
    for side in ["L", "R"]:
        rail_v = sorted(list(comp_map[f"CAR_body_rail_{side}"]))
        Prail = P[rail_v]
        for rv in roof_v:
            d = np.linalg.norm(Prail - P[rv], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0025:
                P[rv] = Prail[mi]
                w_rr += 1

    # 3. Decklid to Buttress (threshold 5.5 mm)
    w_db = 0
    dl_v = sorted(list(comp_map["CAR_body_decklid_C"]))
    b_L = sorted(list(comp_map["CAR_body_buttress_L"]))
    b_R = sorted(list(comp_map["CAR_body_buttress_R"]))
    Pb_L = P[b_L]
    Pb_R = P[b_R]
    for dv in dl_v:
        if P[dv, 0] > 0.1:
            d = np.linalg.norm(Pb_L - P[dv], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0055:
                P[dv] = Pb_L[mi]
                w_db += 1
        elif P[dv, 0] < -0.1:
            d = np.linalg.norm(Pb_R - P[dv], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0055:
                P[dv] = Pb_R[mi]
                w_db += 1

    # 4. Door to Rocker (threshold 7.0 mm)
    w_dr = 0
    for side in ["L", "R"]:
        dv_list = sorted(list(comp_map[f"CAR_body_door_{side}"]))
        rv_list = sorted(list(comp_map[f"CAR_body_rocker_{side}"]))
        Pr = P[rv_list]
        for dv in dv_list:
            d = np.linalg.norm(Pr - P[dv], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0070:
                P[dv] = Pr[mi]
                w_dr += 1

    print(f"Quadruple weld pack: Rocker-Underfloor={w_ru}, Roof-Rail={w_rr}, Decklid-Buttress={w_db}, Door-Rocker={w_dr} (Total {w_ru+w_rr+w_db+w_dr} vertices welded at 0.00 mm).")

    # Centerline snapping
    center_mask = np.abs(P[:, 0]) < 0.003
    P[center_mask, 0] = 0.0
    print(f"Centerline: snapped {int(center_mask.sum())} vertices to X=0.000 mm.")

    # Save npz
    np.savez_compressed(out_npz, P=P, Q=Q_, names=names_arr)
    print(f"Saved {out_npz}")

    # Export OBJ
    with open(out_obj, "w") as f:
        f.write("# ZenRayCar v629 (28 October 2026)\n")
        f.write("# Pure quads, quadruple seam weld pack (rocker-underfloor, roof-rail, decklid-buttress, door-rocker)\n")
        for v in P:
            f.write(f"v {v[0]:.6f} {v[1]:.6f} {v[2]:.6f}\n")
        curr_g = None
        for q, n in zip(Q_, names_arr):
            if n != curr_g:
                curr_g = n
                f.write(f"g {curr_g}\n")
            f.write(f"f {q[0]+1} {q[1]+1} {q[2]+1} {q[3]+1}\n")
    print(f"Saved {out_obj}")

    # Run AnimReview
    prm = load_review_params(os.path.join(base_dir, "work/car/trim_params.json"))
    topo_prm = TC.load_params(os.path.join(base_dir, "work/car/trim_params.json"))
    wheels = json.load(open(os.path.join(base_dir, "work/car/wheel_params.json")))

    Nc, Tc = np.unique(names_arr, return_inverse=True)
    Pc, Cc, Ic = P, np.array([len(q) for q in Q_], np.int32), np.array([v for q in Q_ for v in q], np.int32)
    rep = review(Pc, Cc, Ic, Tc, Nc, wheels, prm, topo_prm)
    audit_path = os.path.join(base_dir, "versions/Audit_v629.json")
    json.dump(rep, open(audit_path, "w"), indent=2)
    print(f"AnimReview: passed {rep['passed']} / {rep['total']}, all_pass={rep['all_pass']}")

    # Run SheetScore
    fdir = os.path.join(base_dir, "work/car/frame/")
    meta = json.load(open(fdir + "frame.json"))

    faces_tri = []
    for q in Q_:
        faces_tri.append([q[0], q[1], q[2]])
        faces_tri.append([q[0], q[2], q[3]])
    faces_tri = np.array(faces_tri, dtype=np.int32)

    mr = Raster.Renderer(P, faces_tri)
    sheet_scores = {}
    for v in meta["views"]:
        vname = v["name"]
        mref = np.asarray(Image.open(os.path.join(fdir, f"mask_{vname}.png"))) > 127
        M, _ = SheetScore.render_in_panel(mr, meta, v, mref.shape)
        M = ndi.binary_fill_holes(M)
        inter = (M & mref).sum()
        union = (M | mref).sum()
        sheet_scores[vname] = round(float(inter / max(union, 1)), 4)
    print("SheetScore IoU:", sheet_scores)
    mean_iou = round(float(np.mean(list(sheet_scores.values()))), 4)
    print("Mean SheetScore IoU:", mean_iou)

    # Run WireframeScoreRef3
    from WireframeScoreRef3 import compute_wireframe_score_ref3
    wf_scores = compute_wireframe_score_ref3(out_npz)
    mean_rec = np.mean([val["rec"] for val in wf_scores.values()])
    mean_prec = np.mean([val["prec"] for val in wf_scores.values()])
    mean_f1 = np.mean([val["f1"] for val in wf_scores.values()])
    print(f"Wireframe Recall ref3: mean={mean_rec*100:.2f}%, prec={mean_prec*100:.2f}%, f1={mean_f1:.4f}")

    return rep["all_pass"], mean_iou, mean_rec

if __name__ == "__main__":
    ok, iou, rec = build_v629()
