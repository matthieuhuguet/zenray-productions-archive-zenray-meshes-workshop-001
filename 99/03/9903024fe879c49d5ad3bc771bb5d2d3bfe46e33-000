# 26 October 2026 : ZenRay Meshes, EXPORT TOPOLOGY of a Houdini SOP : the real polygons (quads, triangles, n-gons) with
# their vertex counts, not the triangulated export of ExportNamed.py ; the input of TopoCheck.py (the senior review).
# Run in Houdini with g = {"SOP": "/obj/ZRM_Car/OUT_car", "OUT": "<topo.npz>"}.
# FR : export des vrais polygones (quads, triangles, n-gones) pour le juge de topologie.
import hou, numpy as np
geo = hou.node(globals()["SOP"]).geometry()
P = np.array(geo.pointFloatAttribValues("P"), np.float64).reshape(-1, 3)
polys = [p for p in geo.prims() if p.type() == hou.primType.Polygon and p.isClosed()]
na = geo.findPrimAttrib("name")
names = [p.attribValue(na) if na else "" for p in polys]
uniq = sorted(set(names)); idx = {n: i for i, n in enumerate(uniq)}
C, I, T = [], [], []
for p, n in zip(polys, names):
    vs = [v.point().number() for v in p.vertices()]
    C.append(len(vs)); I.extend(vs); T.append(idx[n])
np.savez(globals()["OUT"], P=P, C=np.array(C, np.int32), I=np.array(I, np.int32), T=np.array(T, np.int32), names=np.array(uniq))
result = {"points": len(P), "polys": len(C), "names": len(uniq), "skipped": len(geo.prims()) - len(polys)}
