# 28 October 2026 : Build ZenRayCar Delivery Candidate v628
# EN: Multi-seam hermetic weld pack:
#     1) Rear Flying Buttress to Roof Rail (CAR_body_buttress_L/R to CAR_body_rail_L/R):
#        10 contact vertices sealed flush at 0.00 mm across bilateral stations spanning Z in [-1.63, -1.23 m].
#     2) Door Glass Waistline to Shoulder (CAR_body_glass_door_L/R to CAR_body_shoulder_L/R):
#        18 contact vertices sealed flush at 0.00 mm across bilateral stations spanning Z in [-0.20, 0.50 m].
#     3) Front Fascia Panel to Front Band (CAR_body_fascia_panel_C to CAR_fascia_front_band_C):
#        5 contact vertices sealed flush at 0.00 mm across stations at Y ~ 0.53 m, Z ~ 2.18 m.
#     Total: 33 contact vertices sealed flush at 0.00 mm.
# FR : Pack multi-coutures hermetiques (arcs-boutants sur rails de toit, leches-vitres de portieres sur epaules, panneau avant sur bandeau de calandre) soudant 33 sommets de contact a 0,00 mm.
# Verification:
#   - 100.000% pure quads (90,269 quads, 0 tris, 0 ngons)
#   - 21 / 21 AnimReview gates passed (all_pass=True)
#   - SheetScore IoU: 0.9715 record consolidated
#   - Wireframe Recall ref3: 99.84%, Precision: 76.09%, F1: 0.8623

import os, sys, json
import numpy as np
from PIL import Image
from scipy import ndimage as ndi

base_dir = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"
sys.path.insert(0, os.path.join(base_dir, "Scripts"))

import Raster, SheetScore, TopoCheck as TC
from AnimReview import load_review_params, review

def build_v628():
    in_npz = os.path.join(base_dir, "work/car/delivery_v627.npz")
    out_npz = os.path.join(base_dir, "work/car/delivery_v628.npz")
    out_obj = os.path.join(base_dir, "versions/ZenRayCar_v628.obj")

    data = np.load(in_npz, allow_pickle=True)
    P = data["P"].copy()
    Q_ = data["Q"]
    names_arr = data["names"]

    print(f"Loaded v627 base: {len(P)} vertices, {len(Q_)} quads.")

    comp_map = {}
    for q, n in zip(Q_, names_arr):
        if n not in comp_map:
            comp_map[n] = set()
        comp_map[n].update(q)

    # 1. Buttress to Rail (CAR_body_buttress_L/R to CAR_body_rail_L/R, threshold 3.2 mm)
    w_b = 0
    for side in ["L", "R"]:
        bv_list = sorted(list(comp_map[f"CAR_body_buttress_{side}"]))
        rv_list = sorted(list(comp_map[f"CAR_body_rail_{side}"]))
        Pr = P[rv_list]
        for bv in bv_list:
            d = np.linalg.norm(Pr - P[bv], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0032:
                P[bv] = Pr[mi]
                w_b += 1

    # 2. Door Glass Waistline to Shoulder (CAR_body_glass_door_L/R to CAR_body_shoulder_L/R, threshold 3.0 mm)
    w_g = 0
    for side in ["L", "R"]:
        gv_list = sorted(list(comp_map[f"CAR_body_glass_door_{side}"]))
        sv_list = sorted(list(comp_map[f"CAR_body_shoulder_{side}"]))
        Ps = P[sv_list]
        for gv in gv_list:
            d = np.linalg.norm(Ps - P[gv], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0030:
                P[gv] = Ps[mi]
                w_g += 1

    # 3. Front Fascia Panel to Front Band (CAR_body_fascia_panel_C to CAR_fascia_front_band_C, threshold 2.0 mm)
    w_f = 0
    bp_list = sorted(list(comp_map["CAR_body_fascia_panel_C"]))
    fb_list = sorted(list(comp_map["CAR_fascia_front_band_C"]))
    Pfb = P[fb_list]
    for bp in bp_list:
        d = np.linalg.norm(Pfb - P[bp], axis=1)
        mi = np.argmin(d)
        if 0.0001 < d[mi] <= 0.0020:
            P[bp] = Pfb[mi]
            w_f += 1

    print(f"Multi-seam weld pack: Buttress={w_b}, Glass={w_g}, FrontFascia={w_f} (Total {w_b+w_g+w_f} vertices welded at 0.00 mm).")

    # Centerline snapping
    center_mask = np.abs(P[:, 0]) < 0.003
    P[center_mask, 0] = 0.0
    print(f"Centerline: snapped {int(center_mask.sum())} vertices to X=0.000 mm.")

    # Save npz
    np.savez_compressed(out_npz, P=P, Q=Q_, names=names_arr)
    print(f"Saved {out_npz}")

    # Export OBJ
    with open(out_obj, "w") as f:
        f.write("# ZenRayCar v628 (28 October 2026)\n")
        f.write("# Pure quads, multi-seam weld pack (buttress to rail, glass to shoulder, front fascia to band)\n")
        for v in P:
            f.write(f"v {v[0]:.6f} {v[1]:.6f} {v[2]:.6f}\n")
        curr_g = None
        for q, n in zip(Q_, names_arr):
            if n != curr_g:
                curr_g = n
                f.write(f"g {curr_g}\n")
            f.write(f"f {q[0]+1} {q[1]+1} {q[2]+1} {q[3]+1}\n")
    print(f"Saved {out_obj}")

    # Run AnimReview
    prm = load_review_params(os.path.join(base_dir, "work/car/trim_params.json"))
    topo_prm = TC.load_params(os.path.join(base_dir, "work/car/trim_params.json"))
    wheels = json.load(open(os.path.join(base_dir, "work/car/wheel_params.json")))

    Nc, Tc = np.unique(names_arr, return_inverse=True)
    Pc, Cc, Ic = P, np.array([len(q) for q in Q_], np.int32), np.array([v for q in Q_ for v in q], np.int32)
    rep = review(Pc, Cc, Ic, Tc, Nc, wheels, prm, topo_prm)
    audit_path = os.path.join(base_dir, "versions/Audit_v628.json")
    json.dump(rep, open(audit_path, "w"), indent=2)
    print(f"AnimReview: passed {rep['passed']} / {rep['total']}, all_pass={rep['all_pass']}")

    # Run SheetScore
    fdir = os.path.join(base_dir, "work/car/frame/")
    meta = json.load(open(fdir + "frame.json"))

    faces_tri = []
    for q in Q_:
        faces_tri.append([q[0], q[1], q[2]])
        faces_tri.append([q[0], q[2], q[3]])
    faces_tri = np.array(faces_tri, dtype=np.int32)

    mr = Raster.Renderer(P, faces_tri)
    sheet_scores = {}
    for v in meta["views"]:
        vname = v["name"]
        mref = np.asarray(Image.open(os.path.join(fdir, f"mask_{vname}.png"))) > 127
        M, _ = SheetScore.render_in_panel(mr, meta, v, mref.shape)
        M = ndi.binary_fill_holes(M)
        inter = (M & mref).sum()
        union = (M | mref).sum()
        sheet_scores[vname] = round(float(inter / max(union, 1)), 4)
    print("SheetScore IoU:", sheet_scores)
    mean_iou = round(float(np.mean(list(sheet_scores.values()))), 4)
    print("Mean SheetScore IoU:", mean_iou)

    # Run WireframeScoreRef3
    from WireframeScoreRef3 import compute_wireframe_score_ref3
    wf_scores = compute_wireframe_score_ref3(out_npz)
    mean_rec = np.mean([val["rec"] for val in wf_scores.values()])
    mean_prec = np.mean([val["prec"] for val in wf_scores.values()])
    mean_f1 = np.mean([val["f1"] for val in wf_scores.values()])
    print(f"Wireframe Recall ref3: mean={mean_rec*100:.2f}%, prec={mean_prec*100:.2f}%, f1={mean_f1:.4f}")

    return rep["all_pass"], mean_iou, mean_rec

if __name__ == "__main__":
    ok, iou, rec = build_v628()
