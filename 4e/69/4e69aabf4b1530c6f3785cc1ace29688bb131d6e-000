<script>
function flash(b,ok,label){const o=b.dataset.label||b.textContent;b.dataset.label=o;b.textContent=label;b.classList.add(ok?'good':'bad');setTimeout(()=>{b.textContent=o;b.classList.remove('good','bad')},1800)}
document.querySelectorAll('[data-copy-img]').forEach(b=>b.addEventListener('click',async()=>{const img=document.querySelector('#'+b.dataset.copyImg+' img.sheet');try{const blob=await (await fetch(img.src)).blob();await navigator.clipboard.write([new ClipboardItem({'image/png':blob})]);flash(b,true,'Image copiée')}catch(e){console.warn('clipboard image',e.name,e.message);const r=document.createRange();r.selectNode(img);const s=getSelection();s.removeAllRanges();s.addRange(r);let ok=false;try{ok=document.execCommand('copy')}catch(x){}s.removeAllRanges();flash(b,ok,ok?'Image copiée':'Copie refusée : glisser l\'image')}}));
document.querySelectorAll('[data-copy-txt]').forEach(b=>b.addEventListener('click',async()=>{const t=document.getElementById('t-'+b.dataset.copyTxt).value;try{await navigator.clipboard.writeText(t);flash(b,true,'Prompt copié')}catch(e){console.warn('clipboard text',e.name,e.message);const a=document.createElement('textarea');a.value=t;document.body.append(a);a.select();let ok=false;try{ok=document.execCommand('copy')}catch(x){}a.remove();flash(b,ok,ok?'Prompt copié':'Copie refusée')}}));
document.querySelectorAll('[data-dl]').forEach(a=>{a.href=document.querySelector('#'+a.dataset.dl+' img.sheet').src});
const lb=document.getElementById('lb');document.querySelectorAll('img.sheet').forEach(i=>i.addEventListener('click',()=>{lb.querySelector('img').src=i.src;lb.classList.add('on')}));lb.addEventListener('click',()=>lb.classList.remove('on'));
