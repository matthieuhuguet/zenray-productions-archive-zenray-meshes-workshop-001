#!/bin/zsh
# 25 October 2026 : ZenRay Meshes tree loop step : grow the skeleton (TreeGrow, k=v rules), rebuild /obj/ZRM_Tree in
# the live Houdini, export, score against the sheet and the hull. Usage: RunTree.sh <tag> [k=v ...]
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; TAG=$1; shift
cd $W
$PY -I Scripts/archetypes/TreeGrow.py work/tree/hull_B.npz work/tree/tree_v1_measure.json work/tree/tree_${TAG}_skeleton.json shell_clumps=3100 shell_depth_m=0.6 influence_m=2.6 root_flare=1.0 "$@" | tail -1
python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom "import hou, re
geo=hou.node('/obj/ZRM_Tree'); sk=geo.node('skeleton_chains'); code=sk.parm('python').eval()
code=re.sub(r\"json.load\(open\('[^']*'\)\)\", \"json.load(open('$W/work/tree/tree_${TAG}_skeleton.json'))\", code); sk.parm('python').set(code)
ex=geo.node('EXPORT_obj'); ex.parm('sopoutput').set('$W/work/tree/tree_${TAG}.obj'); ex.parm('execute').pressButton(); result='ok'" live > /dev/null
$PY -I Scripts/SheetScore.py work/tree/frame_B work/tree/views work/tree/tree_${TAG}.obj versions/Tree_${TAG}_board_25-October-2026.png | tail -1
$PY -I Scripts/HullScore.py work/tree/frame_B work/tree/hull.obj work/tree/tree_${TAG}.obj 0 | tail -1
