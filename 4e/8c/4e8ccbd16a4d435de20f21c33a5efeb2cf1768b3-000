#!/bin/zsh
# 25 October 2026 : ZenRay Meshes tree loop step : grow the skeleton (TreeGrow, k=v rules), rebuild /obj/ZRM_Tree in
# the live Houdini, export, score against the sheet and the hull. Usage: RunTree.sh <tag> [k=v ...]
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; TAG=$1; shift; OBJ=${OBJ:-tree}   # 26 October 2026: the object directory (work/$OBJ) is a parameter, tree by default
cd $W
$PY -I Scripts/archetypes/TreeGrow.py work/$OBJ/hull_B.npz work/$OBJ/tree_v1_measure.json work/$OBJ/tree_${TAG}_skeleton.json obj=$OBJ shell_clumps=3100 shell_depth_m=0.6 influence_m=2.6 root_flare=1.0 "$@" | tail -1
python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom "import hou, re
geo=hou.node('/obj/ZRM_Tree'); sk=geo.node('skeleton_chains'); code=sk.parm('python').eval()
code=re.sub(r\"json.load\(open\('[^']*'\)\)\", \"json.load(open('$W/work/$OBJ/tree_${TAG}_skeleton.json'))\", code); sk.parm('python').set(code)
ex=geo.node('EXPORT_obj'); ex.parm('sopoutput').set('$W/work/$OBJ/tree_${TAG}.obj'); ex.parm('execute').pressButton(); result='ok'" live > /dev/null
$PY -I Scripts/SheetScore.py work/$OBJ/frame_B work/$OBJ/views work/$OBJ/tree_${TAG}.obj versions/Tree_${OBJ}_${TAG}_board.png | tail -1
[ -f work/$OBJ/hull.obj ] && $PY -I Scripts/HullScore.py work/$OBJ/frame_B work/$OBJ/hull.obj work/$OBJ/tree_${TAG}.obj 0 | tail -1 || true
