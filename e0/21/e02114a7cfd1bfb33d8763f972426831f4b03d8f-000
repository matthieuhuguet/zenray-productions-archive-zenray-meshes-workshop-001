# Usage: python TopoToRender.py <topo.npz> <out.npz>
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np, ComponentScore as C
# 27 October 2026 13:14 Paris: accept both polygon encodings used by the delivery chain.
d = np.load(sys.argv[1], allow_pickle=True)
if 'Q' in d:
    names, part_ids = np.unique(d['names'], return_inverse=True)
    counts = np.array([len(q) for q in d['Q']], dtype=np.int32)
    d = {'P': d['P'], 'C': counts, 'I': np.concatenate(d['Q']).astype(np.int32), 'T': part_ids, 'names': names}
P, F, T, N = C.tri_render(d)
np.savez(sys.argv[2], P=P, F=F, T=T, names=N)
