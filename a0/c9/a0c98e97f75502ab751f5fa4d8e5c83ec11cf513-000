"""5 November 2026 : SMOOTHDISP, keep the low frequencies of the contour snap and drop its pixel noise : the displacement field (snapped mesh minus the mesh before the snap) is Laplacian smoothed on the mesh graph, then added back. FR : garde les basses fréquences de l'accrochage de contour et retire son bruit de pixel.
Usage : python SmoothDisp.py before.obj after.obj out.obj iterations [lambda]"""
import sys, numpy as np
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts/Dracard/Comp")
from CompFit import load_quads
import scipy.sparse as sp
V0, F0 = load_quads(sys.argv[1]); V1, F1 = load_quads(sys.argv[2]); n = len(V0); assert len(V1) == n, (len(V0), len(V1)); it = int(sys.argv[4]); lam = float(sys.argv[5]) if len(sys.argv) > 5 else 0.6
I, J = [], []
for f in F0:
    for k in range(len(f)): I += [f[k], f[(k + 1) % len(f)]]; J += [f[(k + 1) % len(f)], f[k]]
A = sp.coo_matrix((np.ones(len(I)), (I, J)), shape=(n, n)).tocsr(); A.data[:] = 1.0; deg = np.asarray(A.sum(1)).ravel(); P = sp.diags(1.0 / np.maximum(deg, 1)) @ A
D = V1 - V0
for _ in range(it): D = (1 - lam) * D + lam * (P @ D)
V = V0 + D
with open(sys.argv[3], "w") as o:
    for p in V: o.write("v %.6f %.6f %.6f\n" % tuple(p))
    for f in F0: o.write("f " + " ".join(str(i + 1) for i in f) + "\n")
print("ok", n, "moved", float(np.abs(V - V1).mean()))
