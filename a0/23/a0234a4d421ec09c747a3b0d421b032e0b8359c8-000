#!/usr/bin/env python3
# 6 November 2026, 01:25 Europe/Paris: rebuild the short project synthesis (Articles/index.html) after the truck
# components round: every visible part isolated by ChatGPT from one image, gathered and remeasured in one document.
# FR : reconstruit la synthèse courte du projet après le tour des composants du camion.
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROUND = HERE.parent / 'component-round-5-November-2026'
sys.path.insert(0, str(ROUND))
import build_audit as A
import build_index_v002 as V2

PASS = 0.90

PARAGRAPHS = [
    A.CONFIG['summary'][0],
    A.CONFIG['summary'][1],
    'Le camion sert de premier objet. Chaque pièce visible sur une seule de ses images est isolée par ChatGPT, puis '
    'dessinée en quatre vues ; un document rassemble toutes ces planches, chacune remesurée à part, pour servir de '
    'référence à la modélisation dans Houdini pièce par pièce. Le capot en est la première pièce reconstruite, '
    'et toutes attendent la validation visuelle.',
]


def rows():
    return json.loads((HERE / 'summary.json').read_text())


def diagram_round():
    data = rows()
    measured = [r for r in data if r.get('measure')]
    passed = [r for r in measured if min(r['measure']['agreements'].values()) >= PASS]
    steps = [
        ('Une image du camion', 'La seule donnée à ChatGPT'),
        ('Une conversation par pièce', f'{len(data)} pièces, effort High'),
        ('Isoler, corriger, quatre vues', 'Planche carrée, aucun texte'),
        ('Rapatrier les images', 'Formulaire vers un récepteur local'),
        ('Remesurer chaque planche', f'{len(passed)} sur {len(measured)} au-dessus de 0,90'),
        ('Document des composants', 'Modélisation pièce par pièce'),
    ]
    items = []
    for i, (title, sub) in enumerate(steps):
        y = 210 + i * 128
        items.append(f'<rect x="90" y="{y}" width="760" height="104" rx="18" fill="#eef1e9" stroke="#b6c9bc"/>'
                     f'<text x="120" y="{y + 46}" font-size="32">{A.escape(title)}</text><text x="120" y="{y + 86}" font-size="24" class="body">{A.escape(sub)}</text>')
        if i < len(steps) - 1:
            items.append(f'<path d="M470,{y + 106} v18" stroke="#286853" stroke-width="3" marker-end="url(#arrow3)"/>')
    rejected = [
        'Écartés : téléchargement direct, presse-papiers, lien signé sans session',
        'Écartées : vue isolée et quatre vues dans une même image',
    ]
    side = ''.join(f'<rect x="920" y="{250 + i * 100}" width="910" height="64" rx="14" fill="none" stroke="#9aa39d" stroke-dasharray="10 8"/>'
                   f'<text x="946" y="{291 + i * 100}" font-size="22" class="body" fill="#6b746f">{A.escape(t)}</text>' for i, t in enumerate(rejected))
    bars = []
    for i, r in enumerate(measured):
        low = min(r['measure']['agreements'].values())
        y = 500 + i * 30
        bars.append(f'<text x="920" y="{y + 20}" font-size="20" class="body">{A.escape(r["name"])}</text>'
                    f'<rect x="1180" y="{y + 4}" width="{int(560 * low)}" height="20" rx="4" fill="{"#286853" if low >= PASS else "#c08a4a"}"/>'
                    f'<text x="{1190 + int(560 * low)}" y="{y + 21}" font-size="18">{f"{low:.2f}".replace(".", ",")}</text>')
    return ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" role="img" aria-label="Composants du camion, de l’image au document">'
            '<defs><marker id="arrow3" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" fill="#286853"/></marker></defs>'
            '<style>' + A.fonts() + '</style><rect width="1920" height="1080" fill="#f7f5ef"/><g fill="#202b2a" font-family="GT Ultra">'
            '<text x="90" y="110" font-size="56">Tous les composants depuis une seule image</text>'
            '<text x="90" y="160" font-size="26" class="body">Barre : le plus faible des trois accords de la planche, remesuré à part.</text>'
            + ''.join(items) + side + f'<text x="920" y="480" font-size="24" class="body">Accord le plus faible par pièce</text>' + ''.join(bars) + '</g></svg>')


def build():
    body = '<h1>' + A.escape(A.CONFIG['title']) + '</h1>' + ''.join('<p>' + A.escape(p) + '</p>' for p in PARAGRAPHS)
    body += '<div class="diagram">' + diagram_round() + '</div>'
    body += '<div class="diagram">' + A.diagram() + '</div><div class="diagram">' + V2.diagram_v002() + '</div>'
    body += '<p><a href="truck-components-6-November-2026.html">Ouvrir le document des composants du camion</a></p>'
    body += '<p><a href="meshes-audit-5-November-2026.html">Ouvrir le bilan complet et les essais précédents</a></p>'
    target = A.ARTICLES / 'index.html'
    target.write_text(A.page('ZenRay Meshes', body))
    (A.ARTICLES / 'truck-components-chain.svg').write_text(diagram_round())
    return {'index': str(target), 'bytes': target.stat().st_size}


if __name__ == '__main__':
    print(json.dumps(build()))
