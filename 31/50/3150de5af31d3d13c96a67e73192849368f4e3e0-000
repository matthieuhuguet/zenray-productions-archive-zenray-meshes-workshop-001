from scipy.spatial import cKDTree
def loadobj(p):
    V = []; F = []
    for l in open(p):
        t = l.split()
        if t and t[0] == "v": V.append([float(x) for x in t[1:4]])
        elif t and t[0] == "f": F.append([int(x.split("/")[0]) - 1 for x in t[1:]])
    return np.array(V), F
def write_sharp(path, tris, gof, V):
    """edges between triangles of different groups -> .sharp (type,face,edge) ; type 1 convex, 0 concave by the dihedral sign."""
    ed = {}
    for i, t in enumerate(tris):
        for j in range(3):
            a, b = t[j], t[(j + 1) % 3]; ed.setdefault((min(a, b), max(a, b)), []).append((i, j))
    rows = []
    for k, L in ed.items():
        if len(L) == 2 and gof[L[0][0]] != gof[L[1][0]]:
            (i, j), (i2, _) = L; A = np.array(tris[i]); B = np.array(tris[i2])
            n = np.cross(V[A[1]] - V[A[0]], V[A[2]] - V[A[0]]); c2 = V[B].mean(0) - V[A].mean(0)
            rows.append((1 if float(n @ c2) < 0 else 0, i, j))
    open(path, "w").write(f"{len(rows)}\n" + "".join(f"{t},{i},{j},\n" for t, i, j in rows)); return len(rows)
def mirror_score(Q, axis, centre, edge):
    """share of vertices of Q having a mirror twin within 0.25 edge length (a measure of mirror symmetry of the vertex set)"""
    M = Q.copy(); M[:, axis] = 2 * centre - M[:, axis]; d = cKDTree(Q).query(M)[0]
    return dict(within_quarter_edge=round(float((d < 0.25 * edge).mean()), 4), within_half_edge=round(float((d < 0.5 * edge).mean()), 4), median_over_edge=round(float(np.median(d) / edge), 3))
