#!/usr/bin/env python3
"""Patches V_012 to V_020 of the car (10 November 2026): beltline, floor and wheels, grille bars and mirrors, splitter,
rear band, rear lamps and diffuser, underbody plates, bolts and arms, side marker. One patch = one measured iteration.
Sheet px (3 per view px) read on 00_graph/read_<view>.png. Run: python author_012_020.py  (writes p012.json ... here)."""
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
cage = json.loads((HERE.parent / '01_cage' / 'car.cage.V_011.json').read_text())
F = cage['faces']; kit = []


def face(loop, view, mat, **kw):
    d = {'loop': loop, 'view': view, 'mat': mat}; d.update(kw); return d


def over(loop, view, mat, comp, off=4, thick=6, **kw):
    return face(loop, view, mat, component=comp, overlay=True, offset_mm=off, thick_mm=thick, **kw)


def write(n, note, sets, dels=()):
    (HERE / ('p%03d.json' % n)).write_text(json.dumps({'note': note, 'set': sets, 'del': list(dels)}, indent=1, ensure_ascii=False) + '\n')


# --- 012 beltline: the door top is the crease, the shoulder leans in to the glass
s = {'vertices.door_tf': {'L': [708, 523], 'x': {'T': [717, 250]}},
     'vertices.door_cf': {'L': [708, 582], 'x': 'hull'},
     'vertices.door_bf': {'L': [708, 750], 'x': {'same': 'door_cf', 'add': -0.05}},
     'faces.door': dict(F['door'], loop=['door_cf', 'door_tr', '~dw', 'door_br', 'door_bf']),
     'faces.shoulder': dict(F['shoulder'], loop=['door_cf', 'door_tr', 'bp_b', '~fq_b', 'sg', 'door_tf']),
     'faces.fs_rear': dict(F['fs_rear'], loop=['crm', '~c_ap', 'door_tf', '~door_cf', 'door_bf', 'arch_r', 'arch_t']),
     'edges.door_cf|door_tr': {'view': 'L', 'depth': 'T'}, 'edges.door_cf|door_tf': 'straight'}
write(12, 'Ceinture de caisse : le haut de porte est l\'arête vive (lue vue de gauche), l\'épaule penche jusqu\'au vitrage', s, ['edges.door_tf|door_tr'])

# --- 013 floor at its real height, wheels calibrated on the front and back views
s = {'vertices.' + k: dict(v, y=0.118) for k, v in cage['vertices'].items() if k.startswith('fl_') and isinstance(v.get('y'), float)}
s.update({'kits.wheels.positions': {'F': [0.970, 0.3986, 1.310], 'R': [0.970, 0.3986, -1.713]},
          'kits.wheels.tyre': {'width': 0.272}, 'kits.wheels.axle': {'R': {'tyre': {'width': 0.325}}}})
write(13, 'Plancher à sa hauteur lue (118 mm) ; roues calées sur les vues avant et arrière (voie, pneus avant 272 mm, arrière 325 mm)', s)

# --- 014 grille bars and mirrors (real-world elements)
s = {'vertices.g1t': {'F': [1173, 811], 'z': {'on': 'grille', 'add': 0.012}}, 'vertices.g1b': {'F': [1173, 861], 'z': {'on': 'grille', 'add': 0.012}},
     'vertices.g0t': {'F': [957, 811], 'x': 0, 'z': {'on': 'grille', 'add': 0.012}}, 'vertices.g0b': {'F': [957, 861], 'x': 0, 'z': {'on': 'grille', 'add': 0.012}},
     'vertices.mir_base': {'F': [1408, 492, 'free'], 'z': 0.955}, 'vertices.mir_head': {'F': [1447, 476, 'free'], 'z': 0.93}}
kit += [{'id': 'K01', 'name': 'grille_bars', 'kind': 'bar', 'mat': 'plastic', 'pairs': [['g1t', 'g1b']], 'up': [0, 0, 1], 'w_mm': 14, 'd_mm': 44, 'assembly': 'Capot et face avant', 'show': ['F', 'L']},
        {'id': 'K02', 'name': 'grille_bar_centre', 'kind': 'bar', 'mat': 'plastic', 'side': 'C', 'pairs': [['g0t', 'g0b']], 'up': [0, 0, 1], 'w_mm': 14, 'd_mm': 44, 'assembly': 'Capot et face avant', 'show': ['F']},
        {'id': 'K03', 'name': 'mirror', 'kind': 'mirror', 'mat': 'paint', 'pairs': [['mir_base', 'mir_head']], 'head_mm': [105, 88, 190], 'assembly': 'Montants et epaules'}]
s['kits.parts'] = list(kit)
write(14, 'Éléments rapportés : trois barres de calandre et les deux rétroviseurs, posés par des points du plan', s)

# --- 015 front splitter blade
s = {'vertices.sp_fc': {'U': [117, 597], 'x': 0, 'y': 0.150}, 'vertices.sp_f': {'U': [142, 322], 'y': 0.150},
     'vertices.sp_r': {'U': [207, 320], 'y': 0.150}, 'vertices.sp_rc': {'U': [207, 597], 'x': 0, 'y': 0.150},
     'faces.splitter': face(['sp_fc', 'sp_f', 'sp_r', 'sp_rc'], 'U', 'plastic', centre=True, overlay=True, thick_mm=32, bevel_mm=4),
     'assembly.Capot et face avant': ['splitter']}
write(15, 'Lame avant : un panneau épais de 32 mm sous le bouclier, lu vue de dessous', s)

# --- 016 rear panel in three: strip, recessed band, beam
s = {'vertices.rs_bl': {'B': [455, 555], 'z': {'lerp': ['rp_tl', 'rp_bl']}}, 'vertices.rs_bc': {'B': [937, 555], 'x': 0, 'z': {'lerp': ['rp_tc', 'rp_bc']}},
     'vertices.rb_bl': {'B': [447, 690], 'z': {'lerp': ['rp_tl', 'rp_bl']}}, 'vertices.rb_bc': {'B': [937, 690], 'x': 0, 'z': {'lerp': ['rp_tc', 'rp_bc']}},
     'faces.rear_panel': dict(F['rear_panel'], loop=['rp_tc', 'rp_tl', 'rs_bl', 'rs_bc']),
     'faces.rear_band': face(['rs_bc', 'rs_bl', 'rb_bl', 'rb_bc'], 'B', 'dark', centre=True, offset_mm=-14),
     'faces.rear_beam': face(['rb_bc', 'rb_bl', 'rp_bl', '~rp_bm', 'rp_bc'], 'B', 'paint', centre=True),
     'faces.rear_quarter': dict(F['rear_quarter'], loop=['hc', 'rp_tl', '~rs_bl', '~rb_bl', 'rp_bl', 'rarch_r', '~wq']),
     'assembly.Poupe': ['rear_band', 'rear_beam']}
write(16, 'Panneau arrière en trois : bandeau haut, bande sombre en creux de 14 mm, poutre de bouclier', s)

# --- 017 rear lamps, diffuser recess, fins and bar
on = {'on': 'rear_lower'}
s = {'vertices.rlp_a': {'B': [690, 750], 'z': on}, 'vertices.rlp_b': {'B': [470, 750], 'z': on}, 'vertices.rlp_c': {'B': [480, 800], 'z': on}, 'vertices.rlp_d': {'B': [620, 800], 'z': on},
     'vertices.df_tc': {'B': [937, 772], 'x': 0, 'z': on}, 'vertices.df_tl': {'B': [705, 772], 'z': on}, 'vertices.df_bl': {'B': [705, 876], 'z': on}, 'vertices.df_bc': {'B': [937, 876], 'x': 0, 'z': on},
     'vertices.fin_t': {'B': [703, 720, 'free'], 'z': {'on': 'rear_lower', 'add': -0.02}}, 'vertices.fin_b': {'B': [703, 878, 'free'], 'z': {'on': 'rear_lower', 'add': -0.02}},
     'vertices.dfb_l': {'B': [705, 762, 'free'], 'z': {'on': 'rear_lower', 'add': -0.02}}, 'vertices.dfb_r': {'mirror': 'dfb_l'},
     'faces.rear_lamp': over(['rlp_a', 'rlp_b', 'rlp_c', 'rlp_d'], 'B', 'glass', 'rear_lamp', off=3, thick=8),
     'faces.diffuser': over(['df_tc', 'df_tl', 'df_bl', 'df_bc'], 'B', 'dark', 'diffuser', off=3, thick=8, centre=True),
     'assembly.Poupe': ['rear_lamp', 'diffuser']}
kit += [{'id': 'K04', 'name': 'diffuser_fins', 'kind': 'bar', 'mat': 'plastic', 'pairs': [['fin_t', 'fin_b']], 'up': [0, 0, -1], 'w_mm': 16, 'd_mm': 60, 'assembly': 'Poupe', 'show': ['B', 'L', 'U']},
        {'id': 'K05', 'name': 'diffuser_bar', 'kind': 'bar', 'mat': 'plastic', 'side': 'C', 'pairs': [['dfb_l', 'dfb_r']], 'up': [0, 0, -1], 'w_mm': 24, 'd_mm': 50, 'assembly': 'Poupe', 'show': ['B', 'U']}]
s['kits.parts'] = list(kit)
write(17, 'Poupe basse : feux en relief, fond de diffuseur sombre, deux ailettes et la barre du diffuseur', s)

# --- 018 underbody plates (applied on the floor plane)
fy = {'on': 'floor_mid'}
V = lambda u, v, c=False: ({'U': [u, v], 'x': 0, 'y': fy} if c else {'U': [u, v], 'y': fy})
pts = {'fp_fc': V(550, 597, 1), 'fp_f': V(550, 835), 'fp_r': V(1265, 835), 'fp_rr': V(1330, 790), 'fp_rc': V(1330, 597, 1),
       'tn_fc': V(556, 597, 1), 'tn_f': V(628, 668), 'tn_r': V(1268, 668), 'tn_rc': V(1268, 597, 1),
       'sl_a1': V(570, 880), 'sl_a2': V(700, 880), 'sl_a3': V(755, 932), 'sl_a4': V(1070, 932), 'sl_a5': V(1125, 880), 'sl_a6': V(1270, 880),
       'sl_b1': V(570, 947), 'sl_b3': V(755, 947), 'sl_b4': V(1070, 947), 'sl_b6': V(1270, 947),
       'ft_fc': V(292, 597, 1), 'ft_f': V(292, 712), 'ft_m': V(352, 752), 'ft_r': V(540, 772), 'ft_rc': V(540, 597, 1),
       'rt_fc': V(1378, 597, 1), 'rt_f': V(1378, 788), 'rt_m': V(1480, 748), 'rt_r': V(1520, 722), 'rt_rc': V(1520, 597, 1)}
s = {'vertices.' + k: v for k, v in pts.items()}
s.update({'faces.floor_plate': over(['fp_fc', 'fp_f', 'fp_r', 'fp_rr', 'fp_rc'], 'U', 'plastic', 'floor_plate', centre=True),
          'faces.tunnel': over(['tn_fc', 'tn_f', 'tn_r', 'tn_rc'], 'U', 'plastic', 'tunnel', off=9, centre=True),
          'faces.sill_a': over(['sl_a1', 'sl_a2', 'sl_a3', 'sl_b3', 'sl_b1'], 'U', 'plastic', 'sill_plate'),
          'faces.sill_b': over(['sl_a3', 'sl_a4', 'sl_b4', 'sl_b3'], 'U', 'plastic', 'sill_plate'),
          'faces.sill_c': over(['sl_a4', 'sl_a5', 'sl_a6', 'sl_b6', 'sl_b4'], 'U', 'plastic', 'sill_plate'),
          'faces.front_tray': over(['ft_fc', 'ft_f', 'ft_m', 'ft_r', 'ft_rc'], 'U', 'plastic', 'front_tray', centre=True),
          'faces.rear_tray': over(['rt_fc', 'rt_f', '~rt_m', 'rt_r', 'rt_rc'], 'U', 'plastic', 'rear_tray', centre=True),
          'assembly.Dessous': ['floor_plate', 'tunnel', 'sill_plate', 'front_tray', 'rear_tray']})
write(18, 'Dessous : plaque de plancher, tunnel, plaques de bas de caisse, carters avant et arrière, lus vue de dessous', s)

# --- 019 underbody bolts and suspension arms
B = lambda u, v: {'U': [u, v, 'free'], 'y': 0.112}
A = lambda u, v, y=0.235: {'U': [u, v, 'free'], 'y': y}
bolts = {'bf1': B(593, 820), 'bf2': B(755, 810), 'bf3': B(898, 808), 'bf4': B(1060, 808), 'bf5': B(1250, 802), 'bf6': B(590, 768), 'bf7': B(1265, 658)}
tray = {'bt1': B(368, 750), 'bt2': B(300, 710), 'bt3': B(1300, 710), 'bt4': B(1430, 740), 'bt5': B(758, 938), 'bt6': B(1070, 938)}
arms = {'fa_in1': A(358, 758), 'fa_in2': A(468, 802), 'fa_out': A(402, 858, 0.22), 'ra_in1': A(1400, 792), 'ra_in2': A(1478, 762), 'ra_out': A(1428, 852, 0.22)}
s = {'vertices.' + k: v for d in (bolts, tray, arms) for k, v in d.items()}
kit += [{'id': 'K06', 'name': 'floor_bolts', 'kind': 'bolt', 'mat': 'metal', 'at': list(bolts), 'axis': [0, -1, 0], 'assembly': 'Dessous', 'show': ['U']},
        {'id': 'K07', 'name': 'tray_bolts', 'kind': 'bolt', 'mat': 'metal', 'at': list(tray), 'axis': [0, -1, 0], 'assembly': 'Dessous', 'show': ['U']},
        {'id': 'K08', 'name': 'front_arms', 'kind': 'tube', 'mat': 'metal', 'pairs': [['fa_in1', 'fa_out'], ['fa_in2', 'fa_out']], 'r_mm': 17, 'eye_axis': [0, 0, 1], 'assembly': 'Dessous', 'show': ['U', 'F']},
        {'id': 'K09', 'name': 'rear_arms', 'kind': 'tube', 'mat': 'metal', 'pairs': [['ra_in1', 'ra_out'], ['ra_in2', 'ra_out']], 'r_mm': 17, 'eye_axis': [0, 0, 1], 'assembly': 'Dessous', 'show': ['U', 'B']}]
s['kits.parts'] = list(kit)
write(19, 'Dessous : 26 vis à embase et les bras de suspension avant et arrière (tubes à œillets)', s)

# --- 020 side marker on the front fender
s = {'vertices.sm_a': {'L': [622, 590], 'x': 'hull'}, 'vertices.sm_b': {'L': [704, 583], 'x': 'hull'}, 'vertices.sm_c': {'L': [704, 600], 'x': 'hull'}, 'vertices.sm_d': {'L': [642, 605], 'x': 'hull'},
     'faces.side_marker': over(['sm_a', 'sm_b', 'sm_c', 'sm_d'], 'L', 'glass', 'side_marker', off=2, thick=5),
     'assembly.Flanc': ['side_marker']}
write(20, 'Répétiteur de clignotant sur l\'aile avant (relief de 2 mm)', s)
print('patches written:', sorted(p.name for p in HERE.glob('p0*.json')))
