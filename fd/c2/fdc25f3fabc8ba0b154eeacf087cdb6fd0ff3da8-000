DEF = dict(bg_tol=26.0, line_share=0.8, gutter_search=0.1, min_blob=0.02, pad_px=2, axis_tol=0.06, mirror_min=0.85, ref_cover_min=0.85, grid=128, keep_small=0.02)      # 2 November 2026 : axis_tol as a share of the length, mirror_min and ref_cover_min as overlaps, the rest in pixels or shares of the image. FR : réglages du contrôle.
VIEWS = ("front", "back", "left", "right", "top", "bottom"); OPPOSITE = (("front", "back"), ("left", "right"), ("top", "bottom"))
