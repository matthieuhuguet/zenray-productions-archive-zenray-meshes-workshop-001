            y0, x0 = (H - m.shape[0]) // 2, (W - m.shape[1]) // 2; a[j * H + y0:j * H + y0 + m.shape[0], i * W + x0:i * W + x0 + m.shape[1]][m] = (170, 170, 172)
    return a


def selftest():
