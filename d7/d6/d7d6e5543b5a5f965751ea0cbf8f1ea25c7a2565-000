"""28 October 2026 : ZenRay Meshes SECTION BOARD. Cross sections z = const of the sculpt (outer skin, grey), of chosen delivery parts
(colours) and of a rig or cage (red), with the rig nodes near each plane, so a curve network is laid on the real shape and not guessed
from one view (lesson of the quarter band : a line seen in the side view lands 30 cm inboard on a nearly flat haunch top).
python SectionBoard.py <out.png> --z -0.77,-0.95,-1.13 [--box 0.5,1.15,0.75,1.3] [--delivery npz] [--parts CAR_body_belt_L,...] [--cage npz] [--rig json]
FR : coupes transversales de la sculpture, des pièces livrées et du rig, pour poser les lignes sur la vraie forme."""
import argparse, json, os, sys, fnmatch
import numpy as np
from PIL import Image, ImageDraw, ImageFont
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"
PARAMS = {"panel_px": 420, "cols": 3, "font": "/Users/zenray/Library/Fonts/GT-Standard-L-Standard-Regular.otf", "node_tol_m": 0.03,
          "palette": [(46, 134, 222), (230, 126, 34), (39, 174, 96), (142, 68, 173), (241, 196, 15), (26, 188, 156), (211, 84, 0), (127, 140, 141)]}


def section(P, F, z):
    """Segments of the quad or triangle mesh (P, F) cut by the plane z (returns (n, 2, 2) in x, y)."""
    F = np.asarray(F); Z = P[F, 2]; hit = (Z.min(1) < z) & (Z.max(1) > z); F = F[hit]
    if not len(F): return np.zeros((0, 2, 2))
    k = F.shape[1]; pts = [[] for _ in range(len(F))]; segs = []
    A = P[F]; B = P[np.roll(F, -1, 1)]; za, zb = A[..., 2], B[..., 2]; cross = (za - z) * (zb - z) < 0
    t = np.where(cross, (z - za) / np.where(cross, zb - za, 1), 0); X = A + t[..., None] * (B - A)
    for i in range(len(F)):
        c = X[i][cross[i]][:, :2]
        if len(c) >= 2: segs.append(c[:2])
    return np.array(segs)


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("out"); ap.add_argument("--z", required=True); ap.add_argument("--box", default="0.5,1.15,0.75,1.3")
    ap.add_argument("--delivery", default=W + "work/car/delivery_v752.npz"); ap.add_argument("--parts", default="CAR_body_belt_L,CAR_body_shoulder_L,CAR_body_shoulder_rear_L,CAR_body_buttress_L,CAR_body_glass_quarter_L,CAR_body_glass_door_L,CAR_body_quarter_L,CAR_body_door_L")
    ap.add_argument("--cage", default=""); ap.add_argument("--rig", default=""); ap.add_argument("--title", default="")
    a = ap.parse_args(); zs = [float(t) for t in a.z.split(",")]; x0, x1, y0, y1 = (float(t) for t in a.box.split(","))
    S = np.load(W + "work/car/retopo/sculpt_v752.npz"); SP, SF = S["P"], S["F"]
    D = np.load(a.delivery, allow_pickle=True); DP = D["P"]; DQ = D["Q"]; DN = np.array([str(n) for n in D["names"]])
    parts = [p for p in a.parts.split(",") if p]
    PQ = {p: [list(map(int, q)) for q, n in zip(DQ, DN) if fnmatch.fnmatch(n, p)] for p in parts}
    PQ = {p: np.array([q if len(q) == 4 else q + [q[-1]] for q in Qs if len(q) in (3, 4)]) for p, Qs in PQ.items() if Qs}
    cage = np.load(a.cage) if a.cage else None; rig = json.load(open(a.rig)) if a.rig else None
    n = PARAMS["panel_px"]; cols = PARAMS["cols"]; rows = (len(zs) + cols - 1) // cols; img = Image.new("RGB", (cols * n, rows * n + 40), (250, 250, 248)); dr = ImageDraw.Draw(img)
    fnt = ImageFont.truetype(PARAMS["font"], 15); sm = ImageFont.truetype(PARAMS["font"], 11); s = (n - 30) / max(x1 - x0, y1 - y0)
    dr.text((10, 10), a.title or os.path.basename(a.out), fill=(20, 20, 20), font=fnt)
    for i, z in enumerate(zs):
        ox, oy = (i % cols) * n, 40 + (i // cols) * n
        def tp(x, y): return (ox + 15 + (x - x0) * s, oy + n - 15 - (y - y0) * s)
        def inb(sg): return (sg[:, 0] >= x0).all() and (sg[:, 0] <= x1).all() and (sg[:, 1] >= y0).all() and (sg[:, 1] <= y1).all()   # clip to the panel
        dr.rectangle([ox + 2, oy + 2, ox + n - 2, oy + n - 2], outline=(200, 200, 200))
        for g in np.arange(np.ceil(x0 * 10) / 10, x1, 0.1): dr.line([tp(g, y0), tp(g, y1)], fill=(232, 232, 232))
        for g in np.arange(np.ceil(y0 * 10) / 10, y1, 0.1): dr.line([tp(x0, g), tp(x1, g)], fill=(232, 232, 232))
        for sg in section(SP, SF, z):
            if inb(sg): dr.line([tp(*sg[0]), tp(*sg[1])], fill=(90, 90, 90), width=3)
        for j, (p, F) in enumerate(PQ.items()):
            col = PARAMS["palette"][j % len(PARAMS["palette"])]
            for sg in section(DP, F, z):
                if inb(sg): dr.line([tp(*sg[0]), tp(*sg[1])], fill=col, width=2)
        if cage is not None:
            for sg in section(cage["P"], cage["Q"], z):
                if inb(sg): dr.line([tp(*sg[0]), tp(*sg[1])], fill=(220, 30, 30), width=2)
        if rig is not None:
            C = np.array(rig["controls"], float)
            for k, v in rig["nodes"].items():
                if abs(C[v][2] - z) < PARAMS["node_tol_m"] and x0 <= C[v][0] <= x1 and y0 <= C[v][1] <= y1:
                    u = tp(C[v][0], C[v][1]); dr.ellipse([u[0] - 4, u[1] - 4, u[0] + 4, u[1] + 4], fill=(220, 30, 30)); dr.text((u[0] + 5, u[1] - 12), k, fill=(150, 0, 0), font=sm)
        dr.text((ox + 10, oy + 8), "z = %.2f" % z, fill=(20, 20, 20), font=fnt)
    ly = rows * n + 40 - 16
    for j, p in enumerate(PQ):
        dr.text((10 + j * 150, 22), p.replace("CAR_body_", ""), fill=PARAMS["palette"][j % len(PARAMS["palette"])], font=sm)
    img.save(a.out); print(a.out)


if __name__ == "__main__":
    main()
