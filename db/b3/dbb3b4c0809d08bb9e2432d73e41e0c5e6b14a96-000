    board = overview(rows, out / 'overview.jpg')
    body += f'<img alt="Toutes les planches retenues" src="{esc(board.relative_to(DOC.parent))}"><p class="meta">Toutes les planches retenues, dans l’ordre du tableau.</p>'
    for r in rows:
        body += f'<section class="card" id="{esc(r["id"])}"><h2>{esc(r["name"])}</h2>'
        body += f'<p class="meta">{esc(r["component"])}</p>'
        if r.get('measure'):
            # 6 November 2026: every isolated view is shown, because the last one is not always the step 2 correction.
            views = [thumb(HERE / r['id'] / v, out / r['id'] / f'view-{i + 1}.jpg', 480) for i, v in enumerate(r.get('views', []))]
            sheet = thumb(HERE / r['id'] / r['sheet'], out / r['id'] / 'sheet.jpg', 900)
