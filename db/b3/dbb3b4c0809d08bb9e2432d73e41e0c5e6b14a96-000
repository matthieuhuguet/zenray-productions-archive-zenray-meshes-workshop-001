#!/usr/bin/env python3
# 6 November 2026, 00:40 Europe/Paris: gather every truck component isolated by ChatGPT into one document.
# FR : rassemble dans un seul document chaque composant du camion isolé par ChatGPT, avec une mesure indépendante.
#
# Input: components.json (the list, one place) and, per component, the folder written by ChatGptImageReceiver.py
# (gen-NN-WxH.png, conversation.json). Each image is classified as a four-view sheet or an isolated view; the
# retained sheet is measured again here, with the same rule as the prompt (pixels more than 18 grey levels from the
# median of the quadrant border), so ChatGPT's own numbers are checked, never trusted.
# Usage: BuildTruckComponents.py            build summary.json and the document
#        BuildTruckComponents.py --selftest  green on a coherent sheet, red on a stretched one
import base64
import json
import re
import sys
from pathlib import Path

import numpy as np
from PIL import Image

HERE = Path(__file__).resolve().parent
WORKSHOP = Path('/Users/zenray/.claude/tmp/tmp-zenray-meshes')
DOC = WORKSHOP / 'Articles' / 'truck-components-6-November-2026.html'
FONTS = Path('/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/public/fonts')
THRESHOLD = 18      # grey levels from the border median, the prompt's rule
MIN_ROW = 3         # a row or column counts as object when it holds at least this many object pixels
PASS = 0.90         # the prompt's retry threshold


def object_mask(pixels):
    border = np.concatenate([pixels[0], pixels[-1], pixels[:, 0], pixels[:, -1]])
    return np.abs(pixels - float(np.median(border))) > THRESHOLD


def extent(mask):
    rows = np.nonzero(mask.sum(1) >= MIN_ROW)[0]
    cols = np.nonzero(mask.sum(0) >= MIN_ROW)[0]
    if len(rows) == 0 or len(cols) == 0:
        return None
    return int(cols[-1] - cols[0] + 1), int(rows[-1] - rows[0] + 1)


def is_sheet(pixels):
    # A four-view sheet leaves both centre lines empty and fills all four quadrants.
    h, w = pixels.shape
    # 6 November 2026: the V4.1 sheet is a square image; wide images mix a large view with four small ones.
    if not 0.9 <= w / h <= 1.1:
        return False
    mask = object_mask(pixels)
    # 6 November 2026: a thin band and a 1 % tolerance, because large views often graze the centre lines (wheel).
    band = max(2, int(0.006 * min(w, h)))
    centre = mask[:, w // 2 - band:w // 2 + band].sum() + mask[h // 2 - band:h // 2 + band, :].sum()
    quads = [mask[:h // 2, :w // 2], mask[:h // 2, w // 2:], mask[h // 2:, :w // 2], mask[h // 2:, w // 2:]]
    return centre < 0.01 * mask.sum() and all(q.mean() > 0.005 for q in quads)


def measure_sheet(pixels):
    h, w = pixels.shape
    quads = {'front': pixels[:h // 2, :w // 2], 'side': pixels[:h // 2, w // 2:], 'top': pixels[h // 2:, :w // 2]}
    size = {k: extent(object_mask(q)) for k, q in quads.items()}
    if None in size.values():
        return None
    (fw, fh), (sw, sh), (tw, tl) = size['front'], size['side'], size['top']
    ratio = lambda a, b: round(min(a, b) / max(a, b), 4)
    return {'px': {'frontWidth': fw, 'frontHeight': fh, 'sideLength': sw, 'sideHeight': sh, 'topWidth': tw, 'topLength': tl},
            'agreements': {'width': ratio(fw, tw), 'height': ratio(fh, sh), 'length': ratio(sw, tl)}}


def grey(path):
    return np.asarray(Image.open(path).convert('L'), dtype=np.float32)


def chatgpt_numbers(texts):
    # The agreements ChatGPT printed in its last message, in order of appearance, for comparison only.
    last = texts[-1] if texts else ''
    return [float(v.replace(',', '.')) for v in re.findall(r'\b0[,.]\d{3,4}\b', last)]


def thumb(src, dst, width=900):
    image = Image.open(src).convert('RGB')
    image.thumbnail((width, width))
    dst.parent.mkdir(parents=True, exist_ok=True)
    image.save(dst, quality=86)
    return dst


def collect():
    config = json.loads((HERE / 'components.json').read_text())
    runs = json.loads((HERE / 'runs.json').read_text()) if (HERE / 'runs.json').exists() else {}
    rows = []
    for c in config['components']:
        folder = HERE / c['id']
        meta_path = folder / 'conversation.json'
        row = dict(c, state='en attente', conversation=c.get('conversation') or runs.get(c['id'], {}).get('conversation'))
        if meta_path.exists():
            meta = json.loads(meta_path.read_text())
            images = sorted(folder.glob('gen-*.png'))
            kinds = [(p, is_sheet(grey(p))) for p in images]
            sheets = [p for p, s in kinds if s]
            views = [p for p, s in kinds if not s]
            row.update(conversation=meta['conversation'], images=[p.name for p in images], sheets=[p.name for p in sheets])
            row['isolated'] = views[-1].name if views else None
            row['views'] = [v.name for v in views][-3:]  # the last three isolated views at most
            row['codeRuns'] = meta.get('pythonMessages')
            # 6 November 2026: the retained sheet is the best one remeasured (highest weakest agreement), as the prompt
            # keeps the best of its retries; every sheet's measure stays in summary.json.
            measured = [(p, measure_sheet(grey(p))) for p in sheets]
            measured = [(p, m) for p, m in measured if m]
            row['allSheets'] = {p.name: m['agreements'] for p, m in measured}
            best = max(measured, key=lambda item: min(item[1]['agreements'].values())) if measured else None
            row['sheet'] = best[0].name if best else None
            row['measure'] = best[1] if best else None
            row['chatgpt'] = chatgpt_numbers(meta.get('texts', []))
            row['retries'] = max(0, len(sheets) - 1)
            row['finalText'] = (meta.get('texts') or [''])[-1]
            if row['measure']:
                low = min(row['measure']['agreements'].values())
                row['state'] = 'accords au-dessus de 0,90' if low >= PASS else 'un accord sous 0,90'
            else:
                row['state'] = 'pas de planche lisible'
        rows.append(row)
    return config, rows


def overview(rows, path, cell=300, cols=6):
    # 6 November 2026: every retained sheet in one picture, the first thing to look at.
    rows = [r for r in rows if r.get('sheet')]
    out = Image.new('RGB', (cols * cell, ((len(rows) + cols - 1) // cols) * cell), (247, 245, 239))
    for i, r in enumerate(rows):
        im = Image.open(HERE / r['id'] / r['sheet']).convert('RGB'); im.thumbnail((cell - 8, cell - 8))
        out.paste(im, ((i % cols) * cell + 4, (i // cols) * cell + 4))
    path.parent.mkdir(parents=True, exist_ok=True)
    out.save(path, quality=84)
    return path


def fonts():
    return ''.join("@font-face{font-family:'%s';src:url(data:font/woff2;base64,%s);font-weight:100 900;}" %
                   (name, base64.b64encode((FONTS / file).read_bytes()).decode())
                   for name, file in [('GT Ultra', 'GT-Ultra-Regular.woff2'), ('Adobe Clean', 'AdobeClean-Regular.woff2')])


def esc(value):
    return str(value).replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')


def num(value):
    return f'<span class="n">{esc(f"{value:.3f}".replace(".", ","))}</span>'


