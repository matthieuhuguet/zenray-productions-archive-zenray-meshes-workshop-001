            a = r['measure']['agreements']
            cls = 'ok' if min(a.values()) >= PASS else 'low'
            body += (f'<p class="{cls}">Accords remesurés sur la planche : largeur {num(a["width"])}, hauteur {num(a["height"])}, longueur {num(a["length"])}. '
                     f'Reprises de la planche : <span class="n">{r["retries"]}</span>.</p>')
