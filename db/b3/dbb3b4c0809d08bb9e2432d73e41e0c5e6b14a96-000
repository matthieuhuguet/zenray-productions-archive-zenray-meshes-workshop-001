        config, rows = collect()
        (HERE / 'summary.json').write_text(json.dumps(rows, indent=1, ensure_ascii=False) + '\n')
        print(json.dumps({'document': str(render(config, rows)), 'arrived': sum(1 for r in rows if r.get('measure')),
