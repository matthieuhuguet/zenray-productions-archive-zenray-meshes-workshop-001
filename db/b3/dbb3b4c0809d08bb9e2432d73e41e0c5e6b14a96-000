    DOC.write_text('<!doctype html><html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
                   '<title>Composants du camion</title><style>' + css + '</style><main>' + body + '</main></html>')
    return DOC


def selftest():
    # Green: a coherent synthetic sheet scores 1 on all three agreements and is classified as a sheet.
    # Red: the top view stretched in length drops the length agreement under 0.90; a single object is not a sheet.
    canvas = np.full((800, 800), 120, np.float32)
    canvas[100:200, 60:340] = 200   # front: width 280, height 100
    canvas[100:200, 460:700] = 200  # side: length 240, height 100
    canvas[480:720, 60:340] = 200   # top: width 280, length 240
    canvas[480:700, 460:700] = 200  # three-quarter
    good = measure_sheet(canvas)
    stretched = canvas.copy(); stretched[400:480, 60:340] = 200
    bad = measure_sheet(stretched)
    single = np.full((800, 800), 120, np.float32); single[200:600, 200:600] = 200
    wide = np.full((800, 1600), 120, np.float32); wide[100:200, 60:340] = 200; wide[100:200, 900:1140] = 200; wide[480:720, 60:340] = 200; wide[480:700, 900:1140] = 200
    ok = (min(good['agreements'].values()) == 1.0 and bad['agreements']['length'] < PASS and is_sheet(canvas) and not is_sheet(single) and not is_sheet(wide))
    assert ok, (good, bad)
    return {'selftest': 'passed', 'good': good['agreements'], 'stretched': bad['agreements']}


if __name__ == '__main__':
    if '--selftest' in sys.argv:
        print(json.dumps(selftest()))
