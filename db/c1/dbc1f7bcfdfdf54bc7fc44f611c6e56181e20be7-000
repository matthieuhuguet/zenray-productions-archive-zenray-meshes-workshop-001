W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"
SPACE = {   # name : (kind, candidate values) ; kind "grow" goes to TreeGrow k=v, "ctrl" to the Houdini CTRL
    "shell_clumps": ("grow", [4500, 7000, 10000]), "leaf_size": ("ctrl", [0.3, 0.35, 0.4, 0.5]), "cards": ("ctrl", [2, 3]), "carve_tip_k": ("grow", [1, 2, 3]),
    "tip_radius_m": ("grow", [0.08, 0.12, 0.2, 0.3]), "pipe_exp": ("grow", [1.8, 2.0, 2.5, 3.0]), "trunk_tip_radius_scale": ("grow", [0.8, 1.0, 1.3]),
    "spur_m": ("grow", [1.2, 2.0, 3.0, 4.0]), "influence_m": ("grow", [2.2, 2.6, 3.2]), "kill_m": ("grow", [0.35, 0.45, 0.6]), "attractors": ("grow", [4000, 6000, 9000]), "limb_close": ("grow", [0, 1, 2]), "join_m": ("grow", [1.2, 3.0]), "min_radius": ("ctrl", [0.01, 0.02, 0.04]),
    "leaf_inset_m": ("grow", [0.05, 0.15, 0.3]), "trunk_clear_m": ("grow", [0.1, 0.35]), "trunk_clear_k": ("grow", [1.0, 1.6]), "clump_shell_m": ("grow", [0.0, 0.6, 1.2]), "skel_evidence": ("grow", ["work/{obj}/evidence10_wood_top.npz", "work/{obj}/evidence10_wood.npz", "work/{obj}/evidence10_wood_union.npz", "work/{obj}/evidence10_wood_k4.npz"]),
    "clump_evidence": ("grow", ["work/{obj}/evidence10_foliage_strict.npz", "work/{obj}/evidence_foliage_strict.npz", "work/{obj}/evidence10_foliage.npz"])}
STAGE_SPACES = {
    "2": {"spur_m": ("grow", [0.8, 1.2, 2.0, 3.0]), "limb_close": ("grow", [0, 1, 2]), "join_m": ("grow", [1.2, 3.0]), "floor_main_m": ("grow", [0.12, 0.18, 0.25, 0.35]), "pipe_exp": ("grow", [1.8, 2.0, 2.5]),
          "trunk_tip_radius_scale": ("grow", [0.8, 1.0, 1.3]), "thick_evidence": ("grow", ["work/{obj}/evidence10_wood_thick.npz", "work/{obj}/evidence10_wood_top.npz", "work/{obj}/evidence10_wood.npz"])},
    "3": {"med_attractors": ("grow", [1000, 2500, 5000]), "med_influence_m": ("grow", [1.0, 1.6, 2.4]), "med_kill_m": ("grow", [0.15, 0.25, 0.4]), "med_step_m": ("grow", [0.12, 0.2, 0.3]), "floor_branch_m": ("grow", [0.06, 0.1, 0.14, 0.2]),
          "twig_attractors": ("grow", [2000, 5000, 9000]), "twig_influence_m": ("grow", [0.6, 0.9, 1.4]), "twig_kill_m": ("grow", [0.1, 0.15, 0.25]), "twig_step_m": ("grow", [0.08, 0.12, 0.2]), "twig_fill": ("grow", [0.0, 0.5, 0.8]), "floor_twig_m": ("grow", [0.02, 0.03, 0.05])},
    "4": {"shell_clumps": ("grow", [4500, 7000, 10000]), "leaf_size": ("ctrl", [0.3, 0.35, 0.4, 0.5]), "cards": ("ctrl", [2, 3]), "carve_tip_k": ("grow", [1, 2, 3]), "tip_leaf_max": ("grow", [1000, 2500, 5000]), "leaf_inset_m": ("grow", [0.05, 0.15, 0.3]),
          "clump_evidence": ("grow", ["work/{obj}/evidence10_foliage_strict.npz", "work/{obj}/evidence_foliage_strict.npz", "work/{obj}/evidence10_foliage.npz"])}}
FIXED = {"clump_src": "evidence", "carve_tips": 1, "limb_src": os.environ.get("LIMB", "skeleton")}   # structure choices, not searched
BASE = {"shell_clumps": 7000, "leaf_size": 0.35, "cards": 2, "carve_tip_k": 2, "tip_radius_m": 0.12, "pipe_exp": 2.0, "trunk_tip_radius_scale": 1.0, "spur_m": 2.0, "limb_close": 1, "join_m": 1.2, "min_radius": 0.02,
        "leaf_inset_m": 0.15, "trunk_clear_m": 0.35, "trunk_clear_k": 1.6, "clump_shell_m": 0.0, "influence_m": 2.6, "kill_m": 0.45, "attractors": 6000, "skel_evidence": "work/{obj}/evidence10_wood_top.npz", "clump_evidence": "work/{obj}/evidence10_foliage_strict.npz"}
OBJ = os.environ.get("OBJ", "tree")
import time
RUN_ID = time.strftime("%H%M%S")
FROZEN_CTRL = {}
n_eval = [0]


def evaluate(v):
    n_eval[0] += 1; tag = "tf%s%03d" % (RUN_ID, n_eval[0]); stale = W + "work/%s/topo_%s.npz" % (OBJ, tag)
    if os.path.exists(stale): os.remove(stale)   # 26 October 2026: a failed build must not leave an old file of the same tag to be scored (stale scores of earlier fits)
    grow = ["%s=%s" % (k, v[k]) for k, (kind, _) in SPACE.items() if kind == "grow"] + ["%s=%s" % kv for kv in FIXED.items()]
    ctrl = ",".join(["%s=%s" % (k, v[k]) for k, (kind, _) in SPACE.items() if kind == "ctrl"] + ["%s=%s" % kv for kv in FROZEN_CTRL.items() if kv[0] not in SPACE])
    env = dict(os.environ, CTRL=ctrl, OBJ=OBJ); r = subprocess.run(["zsh", W + "Scripts/RunTreeScore.sh", tag] + [g_.replace("{obj}", OBJ) for g_ in grow], capture_output=True, text=True, env=env, cwd=W)
    try:
        js = json.loads(r.stdout.strip().splitlines()[-1]); comp = js["mean_completion"]
        if os.environ.get("STAGE"): comp = float(np.mean([js["stage_mean"][st] for st in os.environ["STAGE"].split(",")]))   # staged fit : only the components of the stage(s) count
    except Exception: return -1.0
    if os.environ.get("OBJECTIVE") == "limb":   # 26 October 2026: x-ray wood score of the class in env WCLASS (LimbScore.py) replaces the region completion
        r3 = subprocess.run([sys.executable, "-I", W + "Scripts/LimbScore.py", OBJ, tag, os.environ.get("WCLASS", "thick")], capture_output=True, text=True, cwd=W)
        try: return float(json.loads(r3.stdout.strip().splitlines()[-1])["score"])
        except Exception: return -1.0
    TR = os.environ.get("TRUTH")   # 26 October 2026: a synthetic instance has a known 3D truth ; the objective then mixes the 2D completion and the 3D chamfer F score
    if TR:
        r2 = subprocess.run([sys.executable, "-I", W + "Scripts/TruthScore.py", W + TR, W + "work/%s/topo_%s.npz" % (OBJ, tag)], capture_output=True, text=True, cwd=W)
        try: f3 = json.loads(r2.stdout.strip().splitlines()[-1])["mean_f"]; wt = float(os.environ.get("TRUTH_W", "0.5")); return (1 - wt) * comp + wt * f3
        except Exception: return -1.0
    return comp


def staged(stage, rounds=2):
    """26 October 2026: STAGED fit in the order of SpeedTree : only the parameters of this stage move, the frozen values of the earlier stages come from work/<obj>/tree_rules.txt and
    tree_ctrl.txt, the objective is the completion of this stage's components (env STAGE) ; the best values are written back to the rules file. FR : réglage par étage."""
    global SPACE, BASE, FIXED
    import importlib.util
    spec = importlib.util.spec_from_file_location("tg", W + "Scripts/archetypes/TreeGrow.py"); tg = importlib.util.module_from_spec(spec); spec.loader.exec_module(tg)
    rf, cf = W + "work/%s/tree_rules.txt" % OBJ, W + "work/%s/tree_ctrl.txt" % OBJ
    rules = dict(t.split("=", 1) for t in open(rf).read().split()) if os.path.exists(rf) else {}; ctrl = dict(t.split("=", 1) for t in open(cf).read().strip().split(",") if t) if os.path.exists(cf) else {}
    SPACE = STAGE_SPACES[str(stage)]; os.environ["STAGE"] = {"2": "2", "3": "3", "4": "4"}[str(stage)]
    FIXED = {k: v for k, v in rules.items() if k not in SPACE}; FIXED.setdefault("limb_src", "stages"); FROZEN_CTRL.update({k: v for k, v in ctrl.items() if k not in SPACE})
    BASE = {}
    for k, (kind, cands) in SPACE.items():
        v = rules.get(k, ctrl.get(k, tg.P.get(k, cands[len(cands) // 2]))); BASE[k] = type(cands[0])(v) if not isinstance(cands[0], str) else str(v)
    main(rounds)
    best = json.load(open(W + "work/%s/organic_fit.json" % OBJ))["values"]
    for k, v in best.items():
        if SPACE[k][0] == "grow": rules[k] = str(v).replace("{obj}", OBJ)
        else: ctrl[k] = str(v)
    open(rf, "w").write(" ".join("%s=%s" % kv for kv in rules.items()) + "\n"); open(cf, "w").write(",".join("%s=%s" % kv for kv in ctrl.items()) + "\n"); print("stage", stage, "frozen into", rf, flush=True)


def main(rounds=2):
    cur = dict(BASE); best = evaluate(cur); log = [{"values": dict(cur), "score": best}]; print("start", best, flush=True)
    for rd in range(int(rounds)):
        for k, (kind, cands) in SPACE.items():
            for c in cands:
                if c == cur[k]: continue
                t = dict(cur); t[k] = c; sc = evaluate(t); log.append({"values": t, "score": sc})
                if sc > best + 1e-4: best, cur = sc, t; print("round", rd, k, c, "->", round(best, 4), flush=True)
        json.dump({"_date": "26 October 2026", "best": best, "values": cur, "evaluations": n_eval[0], "log": log}, open(W + "work/%s/organic_fit.json" % OBJ, "w"), indent=1)
    open(W + "work/%s/organic_best_rules.txt" % OBJ, "w").write(" ".join("%s=%s" % (k, v) for k, v in cur.items() if SPACE[k][0] == "grow" and k not in FIXED) .replace("{obj}", OBJ) + " " + " ".join("%s=%s" % kv for kv in FIXED.items()) + "\n" + ",".join("%s=%s" % (k, v) for k, v in cur.items() if SPACE[k][0] == "ctrl") + "\n")
    print("best", best, cur, flush=True)


if __name__ == "__main__":
    if os.environ.get("STAGED"): staged(os.environ["STAGED"], *sys.argv[1:])
    else: main(*sys.argv[1:])
