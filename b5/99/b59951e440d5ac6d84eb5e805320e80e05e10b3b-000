"""30 October 2026 : a TOURNAMENT of Quad Remesh settings on one or several parts of an OBJ (hython).
    hython HouQuadVariants.py in.obj PART1,PART2,... edge_m out_dir
Writes out_dir/<PART>/<variant>.obj for every variant ; ZrlPartTournament.py ranks them with the judge and keeps the best per part. FR : un tournoi de reglages du Quad Remesh sur des pieces."""
import sys, os, hou
src, parts, edge, out = sys.argv[1], sys.argv[2].split(","), float(sys.argv[3]), sys.argv[4]; os.makedirs(out, exist_ok=True)
VARIANTS = {"default": {}, "noadapt": {"enableadaptivity": 0}, "adapt02": {"adaptivityweight": 0.2}, "nodecim": {"decimation": 0}, "global05": {"globalweight": 0.5}, "gw1": {"globalweight": 1.0}, "gw1_noadapt": {"globalweight": 1.0, "enableadaptivity": 0}, "gw1_nodecim": {"globalweight": 1.0, "decimation": 0}, "gw1_curv2": {"globalweight": 1.0, "localcurvatureweight": 2.0}, "gw1_dens12": {"globalweight": 1.0, "_scale": 1.2}, "gw1_dens08": {"globalweight": 1.0, "_scale": 0.8}, "dens15": {"_scale": 1.5}, "dens07": {"_scale": 0.7}}
g = hou.node("/obj").createNode("geo", "var"); f = g.createNode("file"); f.parm("file").set(src); f.cook(force=True)
for part in parts:
    d = os.path.join(out, part); os.makedirs(d, exist_ok=True)
    grp = f.geometry().findPrimGroup(part)
    if grp is None: continue
    b = g.createNode("blast"); b.setInput(0, f); b.parm("group").set(part); b.parm("negate").set(1); b.parm("grouptype").set(4)
    area = sum(p.intrinsicValue("measuredarea") for p in grp.prims()); n0 = max(8, int(area / (edge * edge)))
    for name, kv in VARIANTS.items():
        q = g.createNode("quadremesh"); q.setInput(0, b); kv = dict(kv); sc = kv.pop("_scale", 1.0); q.parm("targetquadcount").set(max(8, int(n0 * sc)))
        for k, v in kv.items(): q.parm(k).set(v)
        try: q.cook(force=True); q.geometry().saveToFile(os.path.join(d, name + ".obj"))
        except Exception as ex: pass
        q.destroy()
    b.destroy(); print("done", part)
