# 26 October 2026 : ZenRay Meshes, HISTORY of a night : silhouette (filled and raw) and line scores (with steps and normal only)
# recomputed with the CURRENT measures for every exported version in a range, cached per version in work/car/history/, and one
# chart (versions/History_<a>_<b>.png) with the notable steps annotated. FR : courbe de progression recalculée avec la mesure actuelle.
# Usage: python History.py <first> <last> [step=1]
import sys, os, json, subprocess
import numpy as np
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"; PY = "/Users/zenray/.venvs/zenray-uv/bin/python"; H = os.path.join(W, "work/car/history")


def score(v):
    out = os.path.join(H, "v%03d.json" % v)
    if os.path.exists(out): return json.load(open(out))
    obj = os.path.join(W, "work/car/car_v%d.obj" % v)
    if not os.path.exists(obj): return None
    s = json.loads(subprocess.run([PY, "-I", "Scripts/SheetScore.py", "work/car/frame", "work/car/views", obj, os.path.join(H, "s.png")], cwd=W, capture_output=True, text=True, check=True).stdout)
    l = json.loads(subprocess.run([PY, "-I", "Scripts/LineScore.py", "work/car/frame", "work/car/views", obj, os.path.join(H, "l.png")], cwd=W, capture_output=True, text=True, check=True).stdout)
    r = {"v": v, "sil": s["mean_kept"], "sil_raw": s.get("mean_raw"), "lines": l["mean_f1"], "lines_normal": l.get("mean_f1_normal_only"),
         "views": {k: s["silhouette_iou"][k] for k in s["silhouette_iou"]}}
    json.dump(r, open(out, "w")); return r


def main(a, b, step=1):
    a, b, step = int(a), int(b), int(step); rows = [r for v in range(a, b + 1, step) if (r := score(v))]
    # 26 October 2026: the scoring venv has no matplotlib ; the chart is drawn by HistoryPlot.py under a venv that has it
    js = os.path.join(H, "history_v%d_v%d.json" % (a, b)); json.dump(rows, open(js, "w"))
    out = os.path.join(W, "versions/History_v%d_v%d.png" % (a, b))
    subprocess.run([os.environ.get("PLOT_PY", "/Users/zenray/.venvs/voicefixer/bin/python"), "-I", os.path.join(W, "Scripts/HistoryPlot.py"), js, out], check=True)
    print(out, len(rows))



if __name__ == "__main__":
    main(*sys.argv[1:])
