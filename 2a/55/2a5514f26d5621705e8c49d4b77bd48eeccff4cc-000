import json, matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
R = json.load(open("real_arch_outputs/real_arch_results_30-October-2026.json"))
PR = json.load(open("real_arch_outputs/../primitive_outputs/prim_straighten_real_arch_30-October-2026.json"))["part"]
C = "#0072B2", "#E69F00", "#009E73", "#CC79A7", "#7f7f7f"
fig, ax = plt.subplots(1, 2, figsize=(11, 4), sharey=True)
for a, lab, t in zip(ax, ("raw", "smooth"), ("QuadWild brut", "QuadWild lissé")):
    v = [R[lab]["original"]["folded"], R[lab]["repair_only"]["folded"], PR[lab]["after"]["folded"], R[lab]["barrier_only"]["folded"], R[lab]["repair_then_barrier"]["folded"]]
    n = ["original", "réparation\nlocale", "résolution\ndans la carte", "barrière", "réparation\n+ barrière"]
    b = a.bar(n, v, color=[C[4], C[0], C[3], C[1], C[2]])
    for r, x in zip(b, v): a.text(r.get_x() + r.get_width() / 2, x + 1, str(x), ha="center")
    a.set_title(t); a.tick_params(axis="x", labelsize=8)
