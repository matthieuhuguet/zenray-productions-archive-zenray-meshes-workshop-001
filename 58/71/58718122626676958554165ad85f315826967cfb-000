"""28 October 2026 : replace a set of parts of a delivery by all the parts of a candidate npz. python ReplaceParts.py <delivery> <cand> <out> --remove A,B,C
FR : remplace un groupe de pièces par les pièces d'un candidat."""
import argparse, numpy as np
ap = argparse.ArgumentParser(); ap.add_argument("dl"); ap.add_argument("cand"); ap.add_argument("out"); ap.add_argument("--remove", required=True); a = ap.parse_args()
d = np.load(a.dl, allow_pickle=True); s = np.load(a.cand, allow_pickle=True); old = set(a.remove.split(","))
n = np.array([str(x) for x in d["names"]]); keep = [i for i, m in enumerate(n) if m not in old]
P = np.vstack([d["P"], s["P"]]); base = len(d["P"])
DQ = d["Q"]; SQ = s["Q"]
Q = [list(map(int, DQ[i])) for i in keep] + [[base + int(v) for v in q] for q in SQ]; N = list(n[keep]) + [str(x) for x in s["names"]]
np.savez(a.out, P=P.astype(np.float32), Q=np.array(Q, dtype=object), names=np.array(N)); print(len(Q), "faces,", len(set(n[keep])), "kept parts")
