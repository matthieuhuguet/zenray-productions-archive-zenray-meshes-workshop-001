FR : detection robuste des vrais coins (3 a 8) du bord d'une zone."""
import collections
import numpy as np

PARAMS = dict(n=360, eps_frac=(0.004, 0.008, 0.016, 0.032), cluster_frac=0.025, t_fine=28.0, t_coarse=35.0, ratio=0.55, spike_concave=150.0, max_corners=8)

def detect(P, normals, prm=PARAMS):
    """true corners of a closed boundary : Douglas-Peucker at four tolerances (scale space), the turns of the kept vertices are integrated inside clusters (a tip that is rounded gives two vertices), a cluster is a corner when
    its integrated turn is >= t_fine at the finest scale, >= t_coarse at the coarsest scale and the two are of the same order (turn_fine / turn_coarse >= ratio : a smooth arc gives a turn that grows like sqrt(tolerance), a corner does not).
    A concave turn above spike_concave is a slit and never a corner ; a convex turn up to 180 (the tip of a strip) is allowed. returns (indices in the resampled loop, integrated turns, resampled loop, perimeter)."""
    n = prm["n"]; X, Nr, per = resample_loop(P, normals, n); S = len(prm["eps_frac"]); verts = []                                  # (sample, scale, signed turn)
    for s, ef in enumerate(prm["eps_frac"]):
        K = dp_closed(X, ef * per)
        if len(K) == 2: verts += [(K[0], s, 180.0), (K[1], s, 180.0)]; continue                 # a strip or a lens collapses to two vertices : its two tips, convex U-turns
        if len(K) < 3: continue
        for a in range(len(K)): verts.append((K[a], s, tangent_turn(X, Nr, K[a - 1], K[a], K[(a + 1) % len(K)])))
    coarse = [t for (j, s, t) in verts if s == S - 1]; sign = 1.0 if sum(coarse) >= 0 else -1.0                                      # loop orientation : convex turns have the sign of the total turning
    # local width : distance from a sample to the boundary samples that are far away along the arc (the other side of a strip)
    far = max(3, int(prm.get("width_arc", 0.1) * n)); D = np.linalg.norm(X[:, None, :] - X[None, :, :], axis=2); idxs = np.arange(n); sep = np.minimum(np.abs(idxs[:, None] - idxs[None, :]), n - np.abs(idxs[:, None] - idxs[None, :])); W = np.where(sep >= far, D, np.inf).min(axis=1)
    gmax = prm.get("gap_max", 0.06) * n; pts = sorted({j for j, s, t in verts if sign * t > 5.0}); clusters = []
    def close(a, b): return min(abs(a - b), n - abs(a - b)) <= gmax and np.linalg.norm(X[a] - X[b]) <= prm.get("merge_width", 0.5) * min(W[a], W[b])
    for j in pts:
        if clusters and close(clusters[-1][-1], j): clusters[-1].append(j)
        else: clusters.append([j])
    if len(clusters) > 1 and close(clusters[-1][-1], clusters[0][0]): clusters[0] = clusters.pop() + clusters[0]
    out = []
    for c in clusters:
        cs = set(c); T = []
        for s in range(S): T.append(min(180.0, sum(sign * t for (j, ss, t) in verts if ss == s and j in cs and sign * t > 0)))
        # concave spikes are filtered because only convex (sign) turns are summed
        if T[0] >= prm["t_fine"] and T[-1] >= prm["t_coarse"] and T[0] / max(T[-1], 1e-9) >= prm["ratio"]:
            best = max(c, key=lambda j: max([sign * t for (jj, ss, t) in verts if jj == j] or [0])); out.append((best, T[-1]))
    out.sort(key=lambda r: -r[1]); out = out[:prm["max_corners"]]; out.sort(key=lambda r: r[0])
    return [r[0] for r in out], [r[1] for r in out], X, per

