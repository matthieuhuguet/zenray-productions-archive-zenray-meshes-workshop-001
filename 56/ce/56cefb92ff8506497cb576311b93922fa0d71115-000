def resample_loop(P, normals, n):
    """closed polyline P (k,3) with a normal per vertex -> n points equally spaced in arc length, with interpolated unit normals."""
    Y = np.vstack([P, P[:1]]); NN = np.vstack([normals, normals[:1]]); cum = np.r_[0, np.cumsum(np.linalg.norm(np.diff(Y, axis=0), axis=1))]
    t = np.linspace(0, cum[-1], n, endpoint=False); X = np.stack([np.interp(t, cum, Y[:, k]) for k in range(3)], 1); Nr = np.stack([np.interp(t, cum, NN[:, k]) for k in range(3)], 1)
    Nr /= np.maximum(np.linalg.norm(Nr, axis=1, keepdims=True), 1e-12); return X, Nr, cum[-1]

def tangent_turn(X, Nr, i, j, k):
    """signed turning angle (deg) at X[j] between the chords i->j and j->k, measured in the tangent plane of the normal at j."""
    u = X[j] - X[i]; v = X[k] - X[j]; n = Nr[j]; u = u - (u @ n) * n; v = v - (v @ n) * n
    a, b = np.linalg.norm(u), np.linalg.norm(v)
    if a < 1e-12 or b < 1e-12: return 0.0
    c = np.clip(u @ v / (a * b), -1, 1); s = np.cross(u, v) @ n / (a * b); return float(np.degrees(np.arctan2(s, c)))

# ------------------------------------------------------------ Douglas-Peucker on a closed loop
def dp_closed(X, eps):
    """indices of a Douglas-Peucker simplification of the closed polyline X with tolerance eps (distance in 3D)."""
    n = len(X); a = 0; d = np.linalg.norm(X - X[a], axis=1); b = int(np.argmax(d)); keep = {a, b}
    def rec(i, j):                                  # open arc i -> j (indices modulo n, going forward)
        idx = [(i + t) % n for t in range(1, ((j - i) % n))]
        if not idx: return
        p, q = X[i], X[j]; qq = q - p; L = max(np.linalg.norm(qq), 1e-12)
        dist = np.array([np.linalg.norm(np.cross(X[m] - p, qq)) / L if np.linalg.norm(qq) > 1e-12 else np.linalg.norm(X[m] - p) for m in idx])
        k = int(np.argmax(dist))
        if dist[k] > eps: m = idx[k]; keep.add(m); rec(i, m); rec(m, j)
    rec(a, b); rec(b, a); return sorted(keep)

