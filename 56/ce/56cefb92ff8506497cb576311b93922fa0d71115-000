def vertex_normals_on_loop(m, Z, B):
    acc = collections.defaultdict(lambda: np.zeros(3))
    A = np.linalg.norm(np.cross(m["P"][m["F"][Z, 1]] - m["P"][m["F"][Z, 0]], m["P"][m["F"][Z, 2]] - m["P"][m["F"][Z, 0]]), axis=1)
    for t, a in zip(Z, A):
        for v in m["F"][t]: acc[int(v)] += m["N"][t] * a
    N = np.array([acc[int(v)] for v in B]); return N / np.maximum(np.linalg.norm(N, axis=1, keepdims=True), 1e-12)

