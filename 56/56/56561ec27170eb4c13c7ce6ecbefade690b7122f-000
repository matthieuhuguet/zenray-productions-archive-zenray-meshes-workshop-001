import sys, os, collections
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); sys.dont_write_bytecode=True
import diag, numpy as np
def run(obj,o8=8):
    m=diag.AP.mesh(os.path.abspath(obj)); zones=diag.ANY.segment(m,25.0,max(4,int(0.002*len(m['F']))),merge_deg=35.0,log=lambda s:None)
    cnt=collections.Counter(); tris=collections.Counter(); jn=[]
    for k,(Z,seed) in enumerate(zones):
        Ls,ln=diag.AP.loops(m,Z)
        if len(Ls)!=1: cnt['loops%d'%len(Ls)]+=1; tris['loops%d'%len(Ls)]+=len(Z); continue
        B=np.asarray(Ls[0]); X,total=diag.AP.resample_closed(m['P'][B],diag.AP.PARAMS['step_m']); normal=m['N'][Z].mean(0); normal/=np.linalg.norm(normal)
        prm=dict(diag.AP.PARAMS,max_corners=o8); C,turn=diag.AP.corners(X,total,normal,prm)
        true=sum(1 for c in C if turn[c]>=35); cnt[true]+=1; tris[true]+=len(Z)
    return cnt,tris
for name,path in (('arch',sys.argv[1]),('lily',sys.argv[2])):
    c,t=run(path); print(name,'true corners (turn>=35 deg, up to 8 searched) : zones',dict(sorted(c.items(),key=lambda x:str(x[0]))),'| triangles',dict(sorted(t.items(),key=lambda x:str(x[0]))))
