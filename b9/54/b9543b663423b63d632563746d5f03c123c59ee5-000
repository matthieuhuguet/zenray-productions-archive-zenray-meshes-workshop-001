def palette(n):
    """n colours in the spirit of the legend, as far from each other as possible by eye (Lab)"""
    rgb = np.array([colorsys.hsv_to_rgb(h / HUES, s, v) for h in range(HUES) for s, v in SHADES]); lab = rgb2lab(rgb[None])[0]; pick = [0]; d = np.linalg.norm(lab - lab[0], axis=1)
    for _ in range(n - 1): k = int(d.argmax()); pick.append(k); d = np.minimum(d, np.linalg.norm(lab - lab[k], axis=1))
    return (rgb[pick] * 255).round().astype(int), lab[pick]


def main(params):
    p, home = C.load(params); alpha = float(p.get("cut_alpha", ALPHA)); sc = p["scale"]; mc = json.load(open(f"{home}/02_masks/mc.json"))["mc"]; atoms = json.load(open(f"{home}/02_masks/micro.json"))["atoms"]; nf = f"{home}/03_sheets/component_names.json"; given = json.load(open(nf)) if os.path.exists(nf) else {}; comps = []; by_name = {}; piece_of = np.full(len(atoms) + 1, -1)
    for m in mc:
