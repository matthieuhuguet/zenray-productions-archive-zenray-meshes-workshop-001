        else: c = comps[by_name[name]]; c["copies"] = max(c["copies"], m["instances"]); c["symmetric"] = c["symmetric"] or len(m["atoms"]) > 1; c["pieces"].append(m["mc"]); c["description"] = c["description"] or desc
        piece_of[m["atoms"]] = by_name[name]
    n = len(comps); labs = {v: np.load(f"{home}/02_masks/labels_{v}.npz")["labels"] for v in p["views"]}; maps = {v: np.where(L >= 0, piece_of[np.clip(L, 0, None)], -1) for v, L in labs.items()}; adj = np.zeros((n, n), bool); area = np.zeros(n)
    for M in maps.values():
        for a, b in ((M[:, 1:], M[:, :-1]), (M[1:, :], M[:-1, :])):
            k = (a != b) & (a >= 0) & (b >= 0); adj[a[k], b[k]] = True; adj[b[k], a[k]] = True
        ids, cnt = np.unique(M[M >= 0], return_counts=True); area[ids] += cnt
    rgb, lab = palette(n); free = list(range(n)); colour = np.full(n, -1)
    for k in np.argsort(-area):      # the largest components first, each takes the free colour furthest from its neighbours. FR : les plus grands d'abord, chacun prend la couleur libre la plus éloignée de ses voisins.
        done = [colour[j] for j in np.flatnonzero(adj[k]) if colour[j] >= 0]; score = [min((float(np.linalg.norm(lab[c] - lab[d])) for d in done), default=0.0) for c in free]; colour[k] = free.pop(int(np.argmax(score)))
    for k, c in enumerate(comps): c.update(n=k + 1, hex="#%02x%02x%02x" % tuple(rgb[colour[k]].tolist()))
    json.dump(dict(alpha=alpha, components=comps), open(f"{home}/03_sheets/cut_components.json", "w"), indent=1, ensure_ascii=False); col = rgb[colour].astype(np.float32); fn = ImageFont.truetype(FONT_NUM, 26); tiles = []
    spots = {v: {} for v in p["views"]}; best = {}
    for v in p["views"]:      # where each number goes : in every view where the piece can carry it, and once anyway for a piece too thin everywhere, so that every component can be validated. FR : où va chaque numéro ; une pièce trop fine partout le porte quand même une fois, pour pouvoir la valider.
        M = maps[v]
        for i in np.unique(M[M >= 0]):
            dt = ndi.distance_transform_edt(M == i); y, x = np.unravel_index(dt.argmax(), dt.shape); r = float(dt.max()); i = int(i)
            if r >= LABEL_MIN_PX: spots[v][i] = (x, y)
            if r > best.get(i, (0.0,))[0]: best[i] = (r, v, x, y)
    roomy = {i for s_ in spots.values() for i in s_}
    for i, (r, v, x, y) in best.items():
        if i not in roomy: spots[v][i] = (x, y)
    for k, c in enumerate(comps): c["visible"] = k in best
    json.dump(dict(alpha=alpha, components=comps), open(f"{home}/03_sheets/cut_components.json", "w"), indent=1, ensure_ascii=False); print("too thin, numbered once", sorted(i + 1 for i in best if i not in roomy), "absent from the 6 views", [c["n"] for c in comps if not c["visible"]])
    for v in p["views"]:      # exactly the rendering of the legend : the reference enlarged, soft colours, thin dark borders, the numbers. FR : exactement le rendu de la légende.
        M = maps[v]; H, W = M.shape; base = np.asarray(Image.fromarray(C.panel_rgb(p, v)).resize((W, H), Image.BICUBIC)).astype(np.float32); m = M >= 0; out = base.copy(); out[m] = base[m] * (1 - alpha) + col[M[m]] * alpha; e = np.zeros(M.shape, bool); e[:, 1:] |= M[:, 1:] != M[:, :-1]; e[1:, :] |= M[1:, :] != M[:-1, :]; out[e] = out[e] * 0.25; img = Image.fromarray(out.astype(np.uint8)); d = ImageDraw.Draw(img)
        for i, (x, y) in spots[v].items():
            t = str(i + 1); bb = d.textbbox((0, 0), t, font=fn); w_, h_ = bb[2] - bb[0], bb[3] - bb[1]; d.rectangle((x - w_ / 2 - 4, y - h_ / 2 - 5, x + w_ / 2 + 4, y + h_ / 2 + 5), fill=(255, 255, 255)); d.text((x - w_ / 2, y - h_ / 2 - bb[1]), t, font=fn, fill=(0, 0, 0))
        tiles.append(np.asarray(img))
    f = f"{home}/03_sheets/preview_components_lowres.png"; C.save_board(tiles, f); im = Image.open(f); im.resize((LOWRES_W, int(im.size[1] * LOWRES_W / im.size[0])), Image.LANCZOS).save(f); shutil.copyfile(C.abspath(p["sheet"]), f"{home}/03_sheets/cut_reference.png")
    lines = "\n".join(f"{c['n']}. {c['name']}{', ' + c['description'] if c['description'] else ''}{', x' + str(c['copies']) if c['copies'] > 1 else ''} : {c['hex']}" for c in comps); open(f"{home}/03_sheets/cut_prompt.txt", "w").write(PROMPT.format(cut_object=p["cut_object"], percent=int(round(alpha * 100)), table=lines)); L = lab[colour]; D = np.linalg.norm(L[:, None] - L[None], axis=2); np.fill_diagonal(D, 1e9); print("components", n, "closest two colours (delta E)", round(float(D.min()), 1), "closest two neighbours", round(float(D[adj].min()), 1) if adj.any() else None)


