ALPHA = 0.5; HUES = 96; SHADES = ((0.85, 0.95), (0.85, 0.72), (0.55, 0.95), (0.65, 0.6)); LOWRES_W = 1800; FONT_NUM = "/Users/zenray/Library/Fonts/GT-Ultra-Standard-Regular.otf"
