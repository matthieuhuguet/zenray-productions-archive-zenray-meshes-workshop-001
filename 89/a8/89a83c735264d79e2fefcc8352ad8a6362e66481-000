# 28 October 2026 00:06: Composite the editable Motion title layers over the Houdini capture.
from pathlib import Path
from PIL import Image, ImageDraw
root=Path(__file__).resolve().parents[1]
car=Image.open(root.parent/'thumbnail-v591-wireghost.png').convert('RGB')
ImageDraw.Draw(car).rectangle((1880,0,2047,85),fill='black')
for i in range(1,61):
    out=car.copy()
    for name,top in [('modeling',155),('part2',410)]:
        layer=Image.open(root/('final-'+name)/f'frame_{i:06}.png').convert('RGB').crop((180,620,900,800))
        layer=layer.resize((1365,341),Image.Resampling.LANCZOS)
        out.paste(layer,((2048-1365)//2,top),layer.convert('L'))
    out.save(root/'frames-composite'/f'frame_{i:06}.png')
    if i==60: out.save(root/'ZenRay-Modeling-Car-Part-2-V591.png')
