#!/usr/bin/env python3
# 5 November 2026, 17:32 Europe/Paris: implicit-field probe from declared circular-section assumptions, never hidden ground truth.
import json
import time
from pathlib import Path
import numpy as np
from scipy.spatial import cKDTree
from skimage.measure import marching_cubes

HERE=Path(__file__).resolve().parent
CFG=json.loads((HERE/'prototype-config.json').read_text())


def profile(t):
    p=CFG['horn']
    centers=np.column_stack((p['bend']*t*t,np.zeros_like(t),p['height']*(1.1*t-.1*t*t)))
    radius=p['baseRadius']*(1-t)**p['taperPower']+p['tipRadius']
    for station in np.linspace(.1,.86,p['grooves']):
        radius-=p['grooveDepth']*np.exp(-.5*((t-station)/p['grooveWidth'])**2)
    return centers,np.maximum(radius,p['tipRadius'])


if __name__=='__main__':
    started=time.perf_counter();centers,radius=profile(np.linspace(0,1,600))
    step=CFG['mesh']['voxel'];lo=centers.min(0)-radius.max()-step*3;hi=centers.max(0)+radius.max()+step*3
    axes=[np.arange(a,b,step) for a,b in zip(lo,hi)];grid=np.stack(np.meshgrid(*axes,indexing='ij'),-1)
    distance,index=cKDTree(centers).query(grid.reshape(-1,3),workers=2)
    field=(distance-radius[index]).reshape(grid.shape[:-1])
    vertices,faces,_,_=marching_cubes(field.astype('f4'),0,spacing=(step,)*3);vertices+=lo
    out=HERE/'prototypes';out.mkdir(exist_ok=True)
    with (out/'horn-implicit-zup.obj').open('w') as f:
        for x,y,z in vertices:f.write(f'v {x:.8f} {y:.8f} {z:.8f}\n')
        for a,b,c in faces:f.write(f'f {a+1} {b+1} {c+1}\n')
    print(json.dumps({'vertices':len(vertices),'triangles':len(faces),'seconds':round(time.perf_counter()-started,3),'voxel':step}))
