"""2 November 2026 : cameras between the two tools : CompFit and PartBoard write [yaw, pitch, px, py, dist], DragonFit writes [yaw, pitch, roll, dist, px, py] around its target. FR : les caméras entre les deux outils.
    python -I CamConvert.py to_fit in.json out.json   ;   python -I CamConvert.py to_comp in.json out.json"""
import sys, json, math
import numpy as np
T = np.array([0.0, 0.85, -0.1]); mode, a, b = sys.argv[1:4]; C = json.load(open(a)); C = C.get("cams", C); O = {}
for k, c in C.items():
    y, p = c[0], c[1]; A, B = math.radians(y), math.radians(p); fw = np.array([-math.sin(A) * math.cos(B), -math.sin(B), -math.cos(A) * math.cos(B)]); rt = np.cross(fw, [0, 1, 0]); rt /= np.linalg.norm(rt); up = np.cross(rt, fw); q = np.stack([rt, up, fw]) @ T
    if mode == "to_fit": O[k] = [y, p, 0.0, float(c[4] + q[2]), float(c[2] + q[0]), float(c[3] + q[1])]
    else: O[k] = [y, p, float(c[4] - q[0]), float(c[5] - q[1]), float(c[3] - q[2])]
json.dump(O, open(b, "w"), indent=0)
