# 27 October 2026 18:47: Generate a reversible hood-width candidate from a named delivery component.
import argparse
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from ReplaceComponents import read_mesh
from TopoFix import save

parser = argparse.ArgumentParser()
parser.add_argument('source')
parser.add_argument('output')
parser.add_argument('--width-scale', type=float, required=True)
parser.add_argument('--rear-inset', type=float, default=0.0)
parser.add_argument('--front-bow', type=float, default=0.0)
args = parser.parse_args()
points, faces, names = read_mesh(args.source)
points = points.copy()
ids = np.unique(np.concatenate([np.asarray(face, dtype=int) for face, name in zip(faces, names) if name == 'CAR_body_hood_C']))
assert len(ids)
points[ids, 0] *= args.width_scale
z = points[ids, 2]
span = float(z.max() - z.min())
points[ids, 2] += args.rear_inset * np.clip((z.max() - z) / span, 0, 1)
x = points[ids, 0]
front = np.clip((z - z.min()) / span, 0, 1) ** 3
points[ids, 2] += args.front_bow * front * np.maximum(0, 1 - (x / max(abs(x))) ** 2)
save(args.output, points, faces, names)
print('hood points', len(ids), 'width scale', args.width_scale)
