# 25 October 2026 : ZenRay Meshes, WHEEL component (clean quads) : tyre = revolved section (sidewall bulge, shoulder,
# tread, grooves), rim = lip ring + barrel + spokes as thick quad ribbons (straight or split pairs, concave toward the
# hub) + hub cap ; four instances placed at the measured axles. Parameters in work/car/wheel_params.json (HDA interface).
# Output npz (points, quads, name per quad) read by a Python SOP in Houdini.
# FR : roue en quads propres, pneu en révolution, jante à branches en rubans épais, quatre instances.
# Usage: python WheelBuild.py <wheel_params.json> <out.npz>
import sys, json, math
import numpy as np


class Mesh:
    def __init__(self): self.P, self.Q, self.N, self.PN = [], [], [], []
    def grid(self, G, name, close_u=False, flip=False, close_v=False):
        """G: (nu, nv, 3) point grid -> quads; close_u wraps the first axis, close_v the second (26 October 2026)."""
        b = len(self.P); nu, nv = G.shape[:2]; self.P.extend(G.reshape(-1, 3).tolist()); self.PN.extend([name] * (nu * nv))
        for i in range(nu if close_u else nu - 1):
            for j in range(nv if close_v else nv - 1):
                a, c = i * nv + j, ((i + 1) % nu) * nv + j; a1, c1 = i * nv + (j + 1) % nv, ((i + 1) % nu) * nv + (j + 1) % nv
                q = (b + a, b + c, b + c1, b + a1); self.Q.append(q[::-1] if flip else q); self.N.append(name)
    def quads(self, P, Qi, name, flip=False):
        """26 October 2026: explicit points and quads (local indices), for the hub disc."""
        b = len(self.P); self.P.extend(np.asarray(P).tolist()); self.PN.extend([name] * len(P))
        for q in Qi:
            q = tuple(b + i for i in q); self.Q.append(q[::-1] if flip else q); self.N.append(name)
    def weld(self, tol=1e-7):
        """26 October 2026: WELD ; points of the same part at the same place become one (TopoCheck counted 324 unwelded
        faces per wheel on the spokes) ; parts stay separate shells. FR : soudure des points confondus d'une même pièce."""
        key = {}; remap = []; P2, PN2 = [], []
        for p_, n_ in zip(self.P, self.PN):
            k = (n_,) + tuple(int(round(c / tol)) for c in p_)
            if k not in key: key[k] = len(P2); P2.append(p_); PN2.append(n_)
            remap.append(key[k])
        Q2, N2 = [], []
        for q, n_ in zip(self.Q, self.N):
            q2 = tuple(remap[i] for i in q)
            if len(set(q2)) == 4: Q2.append(q2); N2.append(n_)
        self.P, self.PN, self.Q, self.N = P2, PN2, Q2, N2


def quad_disc(segs, radius, x_of_r, inner=0.5, ring_steps=3):
    """26 October 2026: QUAD DISC as an INSET SQUARE and a RING (the classic cap) : a square grid of side 2 x inner x radius
    with segs / 4 edges per side, joined to the segs points of the revolve circle by ring_steps radial quads ; the four
    square corners are valence 3 poles on the flat centre, every corner angle near 90 or 135 degrees. The elliptical
    mapping of a square to the disc left 175 degree corners at the rim. Replaces a revolve from radius 0 (a pole of
    valence segs and collapsed quads). FR : disque en quads, carré intérieur et anneau, pôles sur la zone plate."""
    m = segs // 4 + 1; u = np.linspace(-1, 1, m) * inner; X, Y = np.meshgrid(u, u, indexing="ij")
    ring = []   # square boundary counter clockwise, starting at angle 0 like revolve
    for j in range(m // 2, m - 1): ring.append((m - 1, j))
    for i in range(m - 1, 0, -1): ring.append((i, m - 1))
    for j in range(m - 1, 0, -1): ring.append((0, j))
    for i in range(0, m - 1): ring.append((i, 0))
    for j in range(0, m // 2): ring.append((m - 1, j))
    ring = ring[:segs]; t = np.linspace(0, 2 * np.pi, segs, endpoint=False)
    sq = np.stack([X, Y], -1).reshape(-1, 2); P2 = [tuple(v) for v in sq]; Qi = [(i * m + j, (i + 1) * m + j, (i + 1) * m + j + 1, i * m + j + 1) for i in range(m - 1) for j in range(m - 1)]
    prev = [i * m + j for (i, j) in ring]
    for k in range(1, ring_steps + 1):
        f = k / ring_steps; cur = []
        for n_, (i, j) in enumerate(ring):
            a_ = np.array([X[i, j], Y[i, j]]); b_ = np.array([np.cos(t[n_]), np.sin(t[n_])]); cur.append(len(P2)); P2.append(tuple(a_ + (b_ - a_) * f))
        for n_ in range(segs):
            Qi.append((prev[n_], cur[n_], cur[(n_ + 1) % segs], prev[(n_ + 1) % segs]))
        prev = cur
    D = np.array(P2); r_ = np.linalg.norm(D, axis=1) * radius
    P = np.stack([np.vectorize(x_of_r)(r_), radius * D[:, 0], radius * D[:, 1]], -1)
    # orientation : the square quads and the ring quads must agree ; the ring above runs square to circle, (i, j) order
    return P, Qi


REFINE = {"max_aspect": 0}   # 26 October 2026: set from wheel_params "revolve_max_aspect" in build_wheel


def refine(profile, segs, max_aspect):
    """26 October 2026: insert points on a profile segment longer than max_aspect x the spacing around the wheel at its
    radius (a straight segment, the shape does not change) ; TopoCheck saw 2.7 cm x 25 cm quads on the barrel."""
    out = [profile[0]]
    for a_, b_ in zip(profile[:-1], profile[1:]):
        L = float(np.hypot(*(np.subtract(b_, a_)))); tang = 2 * np.pi * max(0.5 * (a_[1] + b_[1]), 1e-3) / segs
        n = max(1, int(np.ceil(L / (max_aspect * tang))))
        out += [tuple(np.add(a_, np.subtract(b_, a_) * k / n)) for k in range(1, n + 1)]
    return np.array(out)


def revolve(profile, segs):
    """profile: (n,2) of (axial x, radius) -> grid (segs, n, 3) around the x axis."""
    if REFINE["max_aspect"] > 0: profile = refine(np.asarray(profile, float), segs, REFINE["max_aspect"])
    t = np.linspace(0, 2 * np.pi, segs, endpoint=False)
    return np.stack([np.stack([np.full(segs, x), r * np.cos(t), r * np.sin(t)], 1) for x, r in profile], 1)


def tyre_profile(p):
    R, w, rr = p["tyre_r"], p["tyre_w"], p["rim_r"]; sh = p["shoulder_r"]; bu = p["bulge"]
    pts = []
    for k in range(7):                                    # inner sidewall, from the bead up to the shoulder, bulging out
        t = k / 6; r = rr + t * (R - sh - rr); pts.append((-w / 2 - bu * math.sin(math.pi * t), r))
    for k in range(1, 5):
        a = math.pi / 2 * k / 4; pts.append((-w / 2 + sh - sh * math.cos(a), R - sh + sh * math.sin(a)))
    n_t = 2 + 2 * p["grooves"]; xs = np.linspace(-w / 2 + sh, w / 2 - sh, n_t + 1)[1:-1]
    for i, x in enumerate(xs):                            # tread with grooves (alternate up and down points)
        pts.append((x, R - (p["groove_depth"] if (p["grooves"] and i % 2 == 1) else 0.0)))
    for k in range(0, 4):
        a = math.pi / 2 * (1 - k / 4); pts.append((w / 2 - sh + sh * math.cos(a), R - sh + sh * math.sin(a)))
    for k in range(0, 7):
        t = 1 - k / 6; r = rr + t * (R - sh - rr); pts.append((w / 2 + bu * math.sin(math.pi * t), r))
    return np.array(pts)


def spoke_ribbon(p, a_center, off):
    """one spoke: side curves at angle a_center +- half width (+ off for split pairs), from hub to lip ; concave in x."""
    rh, rl = p["hub_r"], p["rim_r"] - p["lip_w"]; n = p["spoke_steps"]; hw = p["spoke_w"] / 2
    r = np.linspace(rh, rl, n); xface = p["face_x"] - p["concave"] * (1 - (r - rh) / (rl - rh))   # sinks toward the hub
    tw = math.radians(p["twist_deg"]) * (r - rh) / (rl - rh)
    rows = []
    t = (r - rh) / (rl - rh); conv = p.get("split_converge", 1.0); offr = off * (conv + (1 - conv) * t)   # split pair opens as a V toward the lip (25 October 2026)
    # 26 October 2026: spoke_profile [[s, dx], ...] is the cross section across the spoke (s from -1 to 1, dx toward the
    # face) : chamfered edges and a centre groove break the normals where the sheet draws the spoke lines ; without it,
    # a ridge (spoke_ridge) on three samples (25 October 2026)
    prof = p.get("spoke_profile") or [[sv, p.get("spoke_ridge", 0.0) * (1 - abs(sv))] for sv in np.linspace(-1, 1, 3)]
    for s, dxp in prof:
        ang = a_center + tw + (offr + s * hw * (0.8 + 0.4 * t)) / r
        xr = xface + dxp
        rows.append(np.stack([xr, r * np.cos(ang), r * np.sin(ang)], 1))
    top = np.stack(rows, 1)                              # (n, k, 3)
    bot = top.copy(); bot[..., 0] -= p["spoke_depth"]
    return top, bot


def build_wheel(p):
    m = Mesh(); seg = p["segments"]; REFINE["max_aspect"] = float(p.get("revolve_max_aspect", 0))
    tp_ = tyre_profile(p)
    if p.get("tyre_close", 1):
        # 26 October 2026: CLOSED TYRE ; the profile ran bead to bead and left the rim side open (144 open edges per tyre, AnimReview
        # rig.closed_shells) ; the inner wall is added as points along the straight line from the last bead point back to the first
        # (spacing like the ring spacing x revolve_max_aspect), then the profile loop is closed. FR : pneu fermé par sa paroi intérieure.
        a0, a1 = tp_[-1], tp_[0]; L_ = float(np.hypot(*(a1 - a0))); tang_ = 2 * np.pi * max(0.5 * (a0[1] + a1[1]), 1e-3) / seg
        k_ = max(1, int(np.ceil(L_ / (max(float(p.get("revolve_max_aspect", 3.0)), 1.0) * tang_))))
        tp_ = np.vstack([tp_] + [a0 + (a1 - a0) * j / k_ for j in range(1, k_)])
    m.grid(revolve(tp_, seg), "tyre", close_u=True, close_v=bool(p.get("tyre_close", 1)))
    rl = p["rim_r"]; lw = p["lip_w"]; fx = p["face_x"]
    lip = [(fx - 0.01, rl), (fx, rl - 0.004), (fx, rl - lw), (fx - 0.015, rl - lw)]           # lip ring, face side
    # 27 October 2026 13:06 Paris: close each revolved component from its own profile, preserving the visible skin.
    closed = bool(p.get("rim_closed", 0))
    m.grid(revolve(np.array(lip), seg), "rim_lip", close_u=True, close_v=closed)
    barrel = [(fx - 0.015, rl - lw), (-p["tyre_w"] / 2 + 0.02, rl - lw), (-p["tyre_w"] / 2 + 0.02, rl)]
    if closed:
        thickness = float(p["rim_wall_m"])
        rear = barrel[-1][0]
        barrel += [(rear + thickness, rl), (rear + thickness, rl - lw + thickness),
                   (fx - 0.015, rl - lw + thickness)]
    original_aspect = REFINE["max_aspect"]
    if closed: REFINE["max_aspect"] = float(p["rim_max_aspect"])
    m.grid(revolve(np.array(barrel), seg), "rim_barrel", close_u=True, flip=True, close_v=closed)
    REFINE["max_aspect"] = original_aspect
    hub = [(fx - p["concave"] + 0.01, 0.0001), (fx - p["concave"] + 0.012, p["hub_r"] * 0.6), (fx - p["concave"], p["hub_r"]), (fx - p["concave"] - p["spoke_depth"], p["hub_r"])]
    if p.get("hub_disc", 1):   # 26 October 2026: quad disc centre, the revolve starts at its ring (welded)
        x0_, x1_, r1_ = hub[0][0], hub[1][0], hub[1][1]; dP, dQ = quad_disc(seg, r1_, lambda r: x0_ + (x1_ - x0_) * r / r1_)
        m.quads(dP, dQ, "rim_hub", flip=True); m.grid(revolve(np.array(hub[1:]), seg), "rim_hub", close_u=True)
    else:
        m.grid(revolve(np.array(hub), seg), "rim_hub", close_u=True)
    if closed and p.get("hub_disc", 1):
        back_x = hub[-1][0]
        cap_p, cap_q = quad_disc(seg, p["hub_r"], lambda r: back_x)
        m.quads(cap_p, cap_q, "rim_hub")
    offs = [-p["split_gap"] / 2 - p["spoke_w"] / 2, p["split_gap"] / 2 + p["spoke_w"] / 2] if p["split"] else [0.0]
    for k in range(p["spokes"]):
        a = 2 * math.pi * k / p["spokes"] + math.radians(p["phase_deg"])
        for o in offs:
            top, bot = spoke_ribbon(p, a, o)
            if p.get("spoke_tube", 1):
                # 26 October 2026: CLOSED TUBE ; section = top row then bottom row reversed (the long sides exist, the
                # four ribbons of before left them open), swept from hub to lip, two end caps as quad strips ; welded.
                sec = np.concatenate([top, bot[:, ::-1]], 1); m.grid(sec, "rim_spoke", close_v=True)
                k_ = top.shape[1]
                for e_, fl_ in ((0, True), (-1, False)): m.grid(np.stack([top[e_], bot[e_]], 1), "rim_spoke", flip=fl_)
            else:
                m.grid(top, "rim_spoke"); m.grid(bot, "rim_spoke", flip=True)
                m.grid(np.stack([top[:, 0], bot[:, 0]], 1), "rim_spoke", flip=True); m.grid(np.stack([top[:, -1], bot[:, -1]], 1), "rim_spoke")
    m.weld(p.get("weld_tol_m", 1e-7))   # 26 October 2026
    return m


def main(params, out):
    p = json.load(open(params)); w = build_wheel(p)
    P0 = np.array(w.P); allP, allQ, allN = [], [], []
    for inst in p["instances"]:
        s = 1 if inst["x"] > 0 else -1                   # mirror so the rim face looks outward
        P = P0.copy(); P[:, 0] *= s; P += [inst["x"], inst["y"], inst["z"]]
        b = sum(len(a) for a in allP); allP.append(P)
        for q, n in zip(w.Q, w.N):
            allQ.append(tuple(b + i for i in (q if s > 0 else q[::-1]))); allN.append("CAR_wheel_%s_%s" % (n, inst["tag"]))
    np.savez(out, P=np.concatenate(allP).astype(np.float32), Q=np.array(allQ, np.int32), names=np.array(allN))
    print(json.dumps({"points": int(sum(len(a) for a in allP)), "quads": len(allQ)}))


if __name__ == "__main__":
    main(*sys.argv[1:])
