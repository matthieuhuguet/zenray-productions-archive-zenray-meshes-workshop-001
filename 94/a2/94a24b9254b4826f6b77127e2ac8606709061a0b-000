<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ZenRay Meshes 2.0 : Matrice Unifiee des 14 Portes (Hard Surface + Organique -> UV -> Height)</title>
<style>
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Regular.woff2') format('woff2');font-weight:100 450;font-style:normal}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Medium.woff2') format('woff2');font-weight:451 599;font-style:normal}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Bold.woff2') format('woff2');font-weight:600 900;font-style:normal}
:root{
  --font:'Adobe Clean','Hiragino Sans W4',sans-serif;
  --paper:#f5f4f1; --ink:#15171c; --mute:#5c616b; --line:#dad8d2; --card:#ffffff; --soft:#ebe9e3;
  --stage:#161922; --ok:#16a34a; --ok-bg:rgba(22,163,74,.11); --warn:#d97706; --warn-bg:rgba(217,119,6,.12);
  --bad:#dc2626; --bad-bg:rgba(220,38,38,.12); --cyan:#0891b2; --mag:#db2777; --yel:#ca8a04; --accent:#2563eb;
  --r:14px; --t:.2s;
}
:root[data-theme="dark"]{
  --paper:#121317; --ink:#efeee9; --mute:#9aa0ab; --line:#292d36; --card:#1a1c22; --soft:#23262f; --stage:#101218;
  --ok:#4ade80; --ok-bg:rgba(74,222,128,.12); --warn:#fbbf24; --warn-bg:rgba(251,191,36,.12);
  --bad:#f87171; --bad-bg:rgba(248,113,113,.13); --cyan:#22d3ee; --mag:#f472b6; --yel:#facc15;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#121317; --ink:#efeee9; --mute:#9aa0ab; --line:#292d36; --card:#1a1c22; --soft:#23262f; --stage:#101218;
    --ok:#4ade80; --ok-bg:rgba(74,222,128,.12); --warn:#fbbf24; --warn-bg:rgba(251,191,36,.12);
    --bad:#f87171; --bad-bg:rgba(248,113,113,.13); --cyan:#22d3ee; --mag:#f472b6; --yel:#facc15;
  }
}
@media (prefers-reduced-motion: reduce){ :root{ --t:0s } }
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.48;font-synthesis:none;transition:background var(--t),color var(--t)}
main{max-width:1380px;margin:0 auto;padding:24px 20px 56px}
.head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:16px}
h1{font-size:clamp(22px,2.7vw,32px);font-weight:600;margin:0;line-height:1.15}
.sub{max-width:68ch;margin:6px 0 0;color:var(--mute)}
.actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
button.btn{border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit;font-size:13.5px;padding:8px 14px;border-radius:999px;cursor:pointer;min-height:38px;transition:all var(--t)}
button.btn:hover{border-color:var(--ink)}
button.btn.primary,button.btn[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink);font-weight:500}
.presets{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}
.kpi-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;margin:14px 0 18px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px}
.kpi-k{font-size:11.5px;color:var(--mute);text-transform:uppercase;letter-spacing:.05em}
.kpi-v{font-size:20px;font-weight:600;margin-top:2px}
.kpi-v.ok{color:var(--ok)} .kpi-v.warn{color:var(--warn)} .kpi-v.bad{color:var(--bad)}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 355px;gap:16px;align-items:start}
@media (max-width:1020px){ .layout{grid-template-columns:1fr} }
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:16px;display:flex;flex-direction:column;gap:14px}
.card h2{font-size:16px;font-weight:600;margin:0;padding-bottom:8px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:10px}
.svg-wrap{background:var(--stage);border-radius:12px;padding:12px;border:1px solid var(--line)}
.svg-wrap svg{width:100%;height:auto;display:block}
.gate-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:10px}
.gate-card{border:1px solid var(--line);border-radius:11px;padding:11px 12px;background:var(--soft);display:flex;flex-direction:column;gap:5px;transition:all var(--t)}
.gate-card.ok{border-color:var(--ok);background:var(--ok-bg)}
.gate-card.warn{border-color:var(--warn);background:var(--warn-bg)}
.gate-card.bad{border-color:var(--bad);background:var(--bad-bg)}
.g-top{display:flex;justify-content:space-between;align-items:center;gap:8px;font-weight:600;font-size:13.5px}
.pill{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;text-transform:uppercase;letter-spacing:.04em}
.pill.ok{background:var(--ok);color:#fff} .pill.warn{background:var(--warn);color:#fff} .pill.bad{background:var(--bad);color:#fff}
:root[data-theme="dark"] .pill.ok,:root[data-theme="dark"] .pill.warn,:root[data-theme="dark"] .pill.bad{color:#0f1116}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .pill{color:#0f1116} }
.g-meta{font-size:12.5px;color:var(--mute);line-height:1.38}
.g-fix{font-size:12px;font-weight:500;color:var(--ink)}
.ctrl{display:flex;flex-direction:column;gap:4px}
.ctrl label{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:13px;color:var(--mute)}
.ctrl output{color:var(--ink);font-weight:600;white-space:nowrap;flex:none}
input[type=range]{width:100%;accent-color:var(--ink);height:26px;cursor:pointer;margin:0}
.arch-pills{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.arch-pill{border:1px solid var(--line);background:var(--soft);color:var(--ink);border-radius:9px;padding:8px 10px;font-size:12.5px;text-align:left;cursor:pointer;transition:all var(--t)}
.arch-pill[aria-pressed="true"]{border-color:var(--ink);background:var(--ink);color:var(--paper);font-weight:600}
.note-box{background:var(--soft);border-radius:10px;padding:11px 12px;font-size:12.5px;color:var(--ink);line-height:1.45;border:1px solid var(--line)}
</style>
</head>
<body>
<main>
  <header class="head">
    <div>
      <h1>ZenRay Meshes 2.0 : Matrice Unifiee des 14 Portes (5 Vues -> Houdini -> UV -> Height)</h1>
      <p class="sub">Tableau de controle 10 secondes couvrant tout objet (hard surface + drapes organiques + personnages + arbres) : cliquez sur un incident reel mesure ou ajustez les curseurs HDA pour voir exactement quelle porte bloque la derive et quel module repare automatiquement le lot.</p>
    </div>
    <div class="actions">
      <button class="btn" id="themeBtn" type="button">Mode sombre</button>
      <button class="btn primary" id="copyBtn" type="button">Copier les valeurs pour le prompt</button>
    </div>
  </header>

  <nav class="presets" aria-label="Simulation d'incidents reels">
    <button class="btn" type="button" data-preset="clean" aria-pressed="true">Pipeline Any-Mesh 2.0 (14/14 Vert)</button>
    <button class="btn" type="button" data-preset="i008" aria-pressed="false">Incident I_008 (Ratio / Epipolaire)</button>
    <button class="btn" type="button" data-preset="a002" aria-pressed="false">Incident A_002 (Flottant + 891x + 639K)</button>
    <button class="btn" type="button" data-preset="organic" aria-pressed="false">Echec Miroir sur Organique / Drape</button>
    <button class="btn" type="button" data-preset="uv" aria-pressed="false">Echec UV Escalier + Ombre Cuite</button>
  </nav>

  <section class="kpi-strip">
    <div class="kpi"><div class="kpi-k">Statut Global</div><div class="kpi-v ok" id="kpiStatus">14 / 14 PORTES VERT</div></div>
    <div class="kpi"><div class="kpi-k">Erreur Surface P95</div><div class="kpi-v ok" id="kpiP95">0.14 mm (99.9 %)</div></div>
    <div class="kpi"><div class="kpi-k">Budget Triangles / Quads</div><div class="kpi-v ok" id="kpiPoly">3 600 quads (100 % Mannequin)</div></div>
    <div class="kpi"><div class="kpi-k">Pipeline UV + PBR 2K</div><div class="kpi-v ok" id="kpiPbr">M1 Droit + 5 Maps Delitees</div></div>
  </section>

  <div class="layout">
    <div style="display:flex;flex-direction:column;gap:16px">
      <section class="card">
        <h2>
          <span>Chaine Complete Bout en Bout (4 Phases, 0 Angle Mort)</span>
          <span style="font-size:12px;font-weight:500;color:var(--mute)" id="stageBadge">Archetype A : Coque Symetrique</span>
        </h2>
        <div class="svg-wrap">
          <svg viewBox="0 0 980 146" role="img" aria-label="Flux des 4 phases ZenRay Meshes 2.0">
            <defs>
              <marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                <path d="M 0 1 L 10 5 L 0 9 z" fill="#94a3b8"/>
              </marker>
            </defs>
            <rect x="6" y="14" width="222" height="118" rx="12" fill="#1e2432" stroke="#38bdf8" stroke-width="2" id="boxStage1"/>
            <text x="18" y="40" fill="#38bdf8" font-size="12.5" font-weight="700" font-family="Adobe Clean, sans-serif">PHASE 1 : 5 VUES &amp; ISOLATION</text>
            <text x="18" y="63" fill="#eef2f7" font-size="12" font-family="Adobe Clean, sans-serif">V0 OrthoIsoGate (aspect, IoU)</text>
            <text x="18" y="83" fill="#eef2f7" font-size="12" font-family="Adobe Clean, sans-serif">SAM2 Proxy + Prompt Grid4 V6</text>
            <text x="18" y="108" fill="#94a3b8" font-size="11.5" font-family="Adobe Clean, sans-serif" id="svgStage1Stat">PASS : IoU miroir 0.954</text>

            <path d="M232 73 L252 73" stroke="#94a3b8" stroke-width="2.2" marker-end="url(#arr)"/>
            <rect x="256" y="14" width="222" height="118" rx="12" fill="#1e2432" stroke="#f472b6" stroke-width="2" id="boxStage2"/>
            <text x="268" y="40" fill="#f472b6" font-size="12.5" font-weight="700" font-family="Adobe Clean, sans-serif">PHASE 2 : CMY 2.0 ATOMIQUE</text>
            <text x="268" y="63" fill="#eef2f7" font-size="12" font-family="Adobe Clean, sans-serif">C Dual-Flank / M Axe / Y Pli</text>
            <text x="268" y="83" fill="#eef2f7" font-size="12" font-family="Adobe Clean, sans-serif">4 Archetypes (A / B / C / D)</text>
            <text x="268" y="108" fill="#94a3b8" font-size="11.5" font-family="Adobe Clean, sans-serif" id="svgStage2Stat">PASS : P95 0.14 mm</text>

            <path d="M482 73 L502 73" stroke="#94a3b8" stroke-width="2.2" marker-end="url(#arr)"/>
            <rect x="506" y="14" width="222" height="118" rx="12" fill="#1e2432" stroke="#facc15" stroke-width="2" id="boxStage3"/>
            <text x="518" y="40" fill="#facc15" font-size="12.5" font-weight="700" font-family="Adobe Clean, sans-serif">PHASE 3 : HOUDINI &amp; CONTACT</text>
            <text x="518" y="63" fill="#eef2f7" font-size="12" font-family="Adobe Clean, sans-serif">B-Spline + ZRR + Mannequin 1.76m</text>
            <text x="518" y="83" fill="#eef2f7" font-size="12" font-family="Adobe Clean, sans-serif">GeoAudit + ContactGraph (1 mm)</text>
            <text x="518" y="108" fill="#94a3b8" font-size="11.5" font-family="Adobe Clean, sans-serif" id="svgStage3Stat">PASS : 0 ouvert, gap 0.08 mm</text>

            <path d="M732 73 L752 73" stroke="#94a3b8" stroke-width="2.2" marker-end="url(#arr)"/>
            <rect x="756" y="14" width="218" height="118" rx="12" fill="#1e2432" stroke="#4ade80" stroke-width="2" id="boxStage4"/>
            <text x="768" y="40" fill="#4ade80" font-size="12.5" font-weight="700" font-family="Adobe Clean, sans-serif">PHASE 4 : UV M1 &amp; HEIGHT PBR</text>
            <text x="768" y="63" fill="#eef2f7" font-size="12" font-family="Adobe Clean, sans-serif">HeadlessM1 + PerIslandAlign</text>
            <text x="768" y="83" fill="#eef2f7" font-size="12" font-family="Adobe Clean, sans-serif">DelightBaseColor + 5 Maps 2K</text>
            <text x="768" y="108" fill="#94a3b8" font-size="11.5" font-family="Adobe Clean, sans-serif" id="svgStage4Stat">PASS : UV droit, 5 maps PRET</text>
          </svg>
        </div>

        <div class="gate-grid" id="gateGrid"></div>
      </section>
    </div>

    <aside class="card">
      <h2>Parametres HDA du Pipeline</h2>

      <div>
        <div style="font-size:12.5px;color:var(--mute);margin-bottom:6px">Archetype CMY 2.0 cible :</div>
        <div class="arch-pills">
          <button class="arch-pill" type="button" data-arch="A" aria-pressed="true">A : Coque Symetrique</button>
          <button class="arch-pill" type="button" data-arch="B" aria-pressed="false">B : Tube / Membre / Corne</button>
          <button class="arch-pill" type="button" data-arch="C" aria-pressed="false">C : Drape / Pli Organique</button>
          <button class="arch-pill" type="button" data-arch="D" aria-pressed="false">D : Arbre / Branches</button>
        </div>
      </div>

      <div class="ctrl">
        <label><span>Seuil aspect carre V0 (+/-)</span><output id="outAspect">0.04</output></label>
        <input type="range" id="slAspect" min="0.01" max="0.20" step="0.01" value="0.04">
      </div>
      <div class="ctrl">
        <label><span>Tol. ecart ContactGraph (mm)</span><output id="outContact">1.0 mm</output></label>
        <input type="range" id="slContact" min="0.2" max="5.0" step="0.2" value="1.0">
      </div>
      <div class="ctrl">
        <label><span>Budget max Quads par Piece</span><output id="outQuads">12 000</output></label>
        <input type="range" id="slQuads" min="2000" max="50000" step="1000" value="12000">
      </div>
      <div class="ctrl">
        <label><span>Seuil erreur Surface P95 (mm)</span><output id="outErr">1.2 mm</output></label>
        <input type="range" id="slErr" min="0.2" max="5.0" step="0.1" value="1.2">
      </div>
      <div class="ctrl">
        <label><span>DelightBaseColor Seuil Span</span><output id="outDelight">0.20</output></label>
        <input type="range" id="slDelight" min="0.10" max="0.40" step="0.02" value="0.20">
      </div>

      <div class="note-box" id="actionBox">
        <strong>Synthese instantanee :</strong> Aucune porte bloquee. Tout composant produit sort en solide quad etanche calibre Mannequin 1.76 m avec UV M1 droites et 5 maps PBR 2K delitees.
      </div>
    </aside>
  </div>
</main>

<script>
const ARCH_INFO = {
  A: { title: 'Archetype A : Coque Symetrique', rule: 'BuildRimGrid.py + RunCmy.py (plaque + miroir exact)' },
  B: { title: 'Archetype B : Tube / Membre / Corne', rule: 'TubeLoft2D + anneaux elliptiques le long de M' },
  C: { title: 'Archetype C : Drape / Pli Asymetrique', rule: 'Dual-Flank B-spline + pli Y pondere (PoC 8 : P50 0.056 mm)' },
  D: { title: 'Archetype D : Arbre / Branches Hierarchiques', rule: 'Skeleton Graph L1 + couronnes jointes (PoC 4 : 0 trous)' },
};

const BASE_GATES = [
  { id:'g1', phase:1, name:'1. V0 Aspect & Cadrage', module:'V0_OrthoIsoGate_ref.py', detail:'Ratio carre 1:1 et marge >= 2 px sans rognage', fix:'Rejeter avant dessin et relancer Prompt Grid4 carre' },
  { id:'g2', phase:1, name:'2. V0 Epipolaire Front/Left/Top', module:'V0_OrthoIsoGate_ref.py', detail:'Hauteur Front=Left=Back, largeur Front=Top', fix:'Auto-zoom OrthoCompare ou rejet perspective 3/4' },
  { id:'g3', phase:1, name:'3. Mirror IoU Front vs Back', module:'V0_OrthoIsoGate_ref.py', detail:'IoU >= 0.85 apres miroir horizontal Back', fix:'Bloquer retour hallucine type I_008' },
  { id:'g4', phase:1, name:'4. Isolation Proxy & Coutures', module:'PromptGridV6 + OnePictureIsolate', detail:'Masque propre SAM2 + 100 % couverture', fix:'Utiliser gabarit proxy en guidage visuel Grid4 V6' },
  { id:'g5', phase:2, name:'5. Contrat CMY 2.0 par Archetype', module:'CMY2_ComponentContract_Schema.json', detail:'Choix A/B/C/D au lieu du miroir Z=-Z aveugle', fix:'Activer Dual-Flank C ou Skeleton D sur organique' },
  { id:'g6', phase:2, name:'6. Plis & Courbure Variable Y', module:'BuildRimLoft / RunCmy / PoC 8', detail:'Poids crease 0..1 le long des plis et aretes', fix:'Splitter B-spline pondere par poids kw local' },
  { id:'g7', phase:3, name:'7. Topologie Quad & Mannequin', module:'GeoAudit.py + Mannequin 1.76 m', detail:'0 aretes ouvertes, 0 non-manifold, echelle m', fix:'Appliquer facteur 0.001122 m/px + volume > 0' },
  { id:'g8', phase:3, name:'8. ContactGraph Assemblage', module:'ContactGraph.py + Snap Axial', detail:'Aucune piece flottante > seuil mm entre ilots', fix:'Aligner axialement Arm_Cuff sur Arm_Flare (<0.1 mm)' },
  { id:'g9', phase:3, name:'9. Budget Relief -> Map PBR', module:'ZenRayRetopology + HeightTo5Maps', detail:'Bas-poly <= budget quads + micro-relief en 2K', fix:'Basculer filigrane 639K faces en map Height/Normal 2K' },
  { id:'g10', phase:3, name:'10. Fidelite Silhouette & P95', module:'ZrlTopoJudge + Eval Chamfer', detail:'IoU >= 98 % et Chamfer P95 <= seuil mm', fix:'Ajuster guides C/M/Y dans Studio avant export' },
  { id:'g11', phase:4, name:'11. UV M1 Droites (0 Escalier)', module:'zenray-uv HeadlessM1.py', detail:'Bords droits sur aretes CMY + seams zrm_seam_suggest', fix:'Exporter groupes de coutures directement vers HeadlessM1' },
  { id:'g12', phase:4, name:'12. Alignement Ilots Height <-> UV', module:'PerIslandAlign.py (0.9994)', detail:'Recalage exact par ilot sur l UV M1', fix:'Passer par alignement membrane 8 passes' },
  { id:'g13', phase:4, name:'13. Delighting BaseColor', module:'DelightBaseColor.py', detail:'Suppression ombre cuite sans perdre le grain 0.999', fix:'Uniformiser macro shading avant HeightToBaseColor' },
  { id:'g14', phase:4, name:'14. CheckAiHeight & 5 Maps 2K', module:'CheckAiHeight + HeightTo5MapsCop', detail:'Coherence lumiere, bords sans jointure, ORM pack', fix:'Relancer passe Height avant bake Karma/Unreal' },
];

const PRESETS = {
  clean: {
    arch: 'A',
    statusText: '14 / 14 PORTES VERT', statusCls: 'ok',
    p95: '0.14 mm (99.9 %)', p95Cls: 'ok',
    poly: '3 600 quads (1.76 m)', polyCls: 'ok',
    pbr: 'M1 Droit + 5 Maps 2K', pbrCls: 'ok',
    s1: 'PASS : IoU 0.954, ratio 1.00', s2: 'PASS : CMY 2.0 adapte',
    s3: 'PASS : 0 ouvert, gap 0.08 mm', s4: 'PASS : M1 + 5 Maps PRET',
    note: 'Aucune porte bloquee. Tout composant produit sort en solide quad etanche calibre Mannequin 1.76 m avec UV M1 droites et 5 maps PBR 2K delitees.',
    faults: {}
  },
  i008: {
    arch: 'A',
    statusText: 'BLOQUE EN PHASE 1 (V0)', statusCls: 'bad',
    p95: 'STOPPE AVANT 3D', p95Cls: 'bad',
    poly: 'Non trace (gain 25 min)', polyCls: 'warn',
    pbr: 'En attente de Grid4 propre', pbrCls: 'warn',
    s1: 'KO : left=0.75, top=2.00', s2: 'EN ATTENTE', s3: 'EN ATTENTE', s4: 'EN ATTENTE',
    note: 'Incident reel I_008 : GeminiBridge / OnePictureIsolate a accepte des images non carrees (left 0.75, top 2.00) avec encoche teleportee en perspective 3/4. V0_OrthoIsoGate_ref.py score 0.537 -> REJECT_REDO immediat.',
    faults: {
      g1: { cls:'bad', detail:'REJETE : left ratio 0.750, top ratio 2.000 (hors +/-0.04)' },
      g2: { cls:'bad', detail:'REJETE : derive epipolaire left/front 1.189x, top/front 0.832x' },
      g3: { cls:'warn', detail:'ALERTE : divergence perspective avant dessin de contours' },
    }
  },
  a002: {
    arch: 'A',
    statusText: 'BLOQUE EN PHASE 3 (A_002)', statusCls: 'bad',
    p95: 'Gap 15.34 mm', p95Cls: 'bad',
    poly: '764 358 faces (161 MB)', polyCls: 'bad',
    pbr: 'Relief geometries vs 2K', pbrCls: 'warn',
    s1: 'PASS (V0 ok)', s2: 'PASS (3 pieces)', s3: 'KO : 891x + flottant + 639K', s4: 'BLOQUE PAR G7/G8/G9',
    note: 'Incident reel 14_ArmGuard A_002 : assembly.obj mesure 374.3 unites (891x trop grand vs 0.420 m), Arm_Cuff flotte de 15.34 mm sur Arm_Flare, et Arm_Forearm pese 639 184 faces (83.6 %). PoC 6 corrige tout en -99.53 % polygones et gap 0.083 mm.',
    faults: {
      g7: { cls:'bad', detail:'KO : repere pixels 374.3 m brut sans calibration Mannequin' },
      g8: { cls:'bad', detail:'KO : ContactGraph detecte Arm_Cuff flottant (+15.34 mm > 1 mm)' },
      g9: { cls:'bad', detail:'KO : Arm_Forearm 639 184 faces sculptees (83.6 % poids OBJ)' },
    }
  },
  organic: {
    arch: 'A',
    statusText: 'BLOQUE SI MIROIR Z=-Z', statusCls: 'bad',
    p95: 'Mirror 40.24 mm -> CMY2 1.03', p95Cls: 'bad',
    poly: '4 016 quads etanches', polyCls: 'ok',
    pbr: 'UV M1 bande droite ok', pbrCls: 'ok',
    s1: 'PASS (V0 ok)', s2: 'KO en v1 -> PASS en C', s3: 'KO (IoU Top 48 %) -> 98.2 %', s4: 'PRET apres Archetype C',
    note: 'PoC 8 sur drape organique asymetrique : le miroir naif A/v1 explose a P95 40.24 mm (IoU Top 48.0 %). Cliquez sur Archetype C a droite pour passer en Dual-Flank et tomber a P50 0.056 mm / P95 1.035 mm (38.9x mieux).',
    faults: {
      g5: { cls:'bad', detail:'KO : CmySym / BuildRimGrid force un miroir plan Z=-Z impossible' },
      g6: { cls:'warn', detail:'ALERTE : plis asymetriques perdus sans courbe M libre 3D + poids Y' },
      g10: { cls:'bad', detail:'KO : erreur P95 40.24 mm (corrige a 1.035 mm par Archetype C)' },
    }
  },
  uv: {
    arch: 'B',
    statusText: 'BLOQUE EN PHASE 4 (UV/PBR)', statusCls: 'bad',
    p95: 'Geometrie 3D OK', p95Cls: 'ok',
    poly: '4 200 quads propres', polyCls: 'ok',
    pbr: 'KO : Escalier + Ombre cuite', pbrCls: 'bad',
    s1: 'PASS', s2: 'PASS', s3: 'PASS', s4: 'KO : UV escalier & Delight 0.287',
    note: 'Sans coutures CMY transmises vers HeadlessM1.py ni DelightBaseColor.py : bords UV en escalier et ombre directionnelle cuite dans BaseColor (span 0.287). PoC 5 reduit ce span de 42.8 % (0.164) en gardant 99.97 % du grain.',
    faults: {
      g11: { cls:'bad', detail:'KO : UV unwraps en diagonale sans seams zrm_seam_suggest' },
      g12: { cls:'warn', detail:'ALERTE : PerIslandAlign requis sur ilots recalibles' },
      g13: { cls:'bad', detail:'KO : shading span 0.287 > 0.20 dans photo reference' },
      g14: { cls:'bad', detail:'KO : CheckAiHeight rejette lumiere directionnelle cuite' },
    }
  }
};

let state = { preset: 'clean', arch: 'A', aspectTol: 0.04, contactTol: 1.0, maxQuads: 12000, errTol: 1.2, delightTol: 0.20 };

function render(){
  const p = PRESETS[state.preset];
  const faults = Object.assign({}, p.faults);

  // Dynamic slider evaluation when tolerances tighten below real metrics
  if(state.preset === 'organic' && state.arch === 'C'){
    delete faults.g5; delete faults.g6;
    if(1.035 <= state.errTol) delete faults.g10;
  }
  if(state.preset === 'clean'){
    if(state.maxQuads < 3600) faults.g9 = { cls:'bad', detail:`KO : piece 3 600 quads > budget ${state.maxQuads.toLocaleString('fr-FR')}` };
    if(state.contactTol < 0.1) faults.g8 = { cls:'warn', detail:`LIMITE : gap mesure 0.083 mm proche de ${state.contactTol} mm` };
    if(state.delightTol < 0.16) faults.g13 = { cls:'warn', detail:`LIMITE : span apres delight 0.164 > ${state.delightTol.toFixed(2)}` };
  }

  // Update KPI strip
  const hasBad = Object.values(faults).some(x => x.cls === 'bad');
  const okCount = 14 - Object.keys(faults).length;
  const kStat = document.getElementById('kpiStatus');
  kStat.textContent = hasBad ? p.statusText : `${okCount} / 14 PORTES VERT`;
  kStat.className = 'kpi-v ' + (hasBad ? 'bad' : okCount < 14 ? 'warn' : 'ok');

  document.getElementById('kpiP95').textContent = (state.preset === 'organic' && state.arch === 'C') ? 'P50 0.056 / P95 1.03 mm' : p.p95;
  document.getElementById('kpiP95').className = 'kpi-v ' + ((state.preset === 'organic' && state.arch === 'C') ? 'ok' : p.p95Cls);
  document.getElementById('kpiPoly').textContent = p.poly;
  document.getElementById('kpiPoly').className = 'kpi-v ' + p.polyCls;
  document.getElementById('kpiPbr').textContent = p.pbr;
  document.getElementById('kpiPbr').className = 'kpi-v ' + p.pbrCls;

  document.getElementById('stageBadge').textContent = `${ARCH_INFO[state.arch].title} (${ARCH_INFO[state.arch].rule})`;
  document.getElementById('svgStage1Stat').textContent = p.s1;
  document.getElementById('svgStage2Stat').textContent = (state.preset === 'organic' && state.arch === 'C') ? 'PASS : Archetype C P50 0.056 mm' : p.s2;
  document.getElementById('svgStage3Stat').textContent = (state.preset === 'organic' && state.arch === 'C') ? 'PASS : Mean IoU 98.17 %' : p.s3;
  document.getElementById('svgStage4Stat').textContent = p.s4;
  document.getElementById('actionBox').innerHTML = `<strong>Synthese instantanee :</strong> ${(state.preset === 'organic' && state.arch === 'C') ? 'Archetype C active : erreur P95 chute de 40.24 mm a 1.035 mm (P50 0.056 mm, Mean IoU 98.17 %), 4 016 quads etanches prets pour HeadlessM1.' : p.note}`;

  const grid = document.getElementById('gateGrid');
  grid.innerHTML = BASE_GATES.map(g => {
    const f = faults[g.id];
    const cls = f ? f.cls : 'ok';
    const badge = cls === 'ok' ? 'PASS' : cls === 'warn' ? 'ALERTE' : 'BLOQUE';
    const detail = f ? f.detail : g.detail;
    return `
      <article class="gate-card ${cls}">
        <div class="g-top"><span>${g.name}</span><span class="pill ${cls}">${badge}</span></div>
        <div class="g-meta">${detail}</div>
        <div class="g-fix">${cls === 'ok' ? g.module : 'Correctif : ' + g.fix}</div>
      </article>`;
  }).join('');
}

document.querySelectorAll('[data-preset]').forEach(b => b.addEventListener('click', () => {
  document.querySelectorAll('[data-preset]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  state.preset = b.dataset.preset;
  state.arch = PRESETS[state.preset].arch;
  document.querySelectorAll('[data-arch]').forEach(a => a.setAttribute('aria-pressed', String(a.dataset.arch === state.arch)));
  render();
}));

document.querySelectorAll('[data-arch]').forEach(b => b.addEventListener('click', () => {
  document.querySelectorAll('[data-arch]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  state.arch = b.dataset.arch;
  render();
}));

[['slAspect','outAspect','aspectTol',v=>Number(v).toFixed(2)],
 ['slContact','outContact','contactTol',v=>Number(v).toFixed(1)+' mm'],
 ['slQuads','outQuads','maxQuads',v=>Number(v).toLocaleString('fr-FR')],
 ['slErr','outErr','errTol',v=>Number(v).toFixed(1)+' mm'],
 ['slDelight','outDelight','delightTol',v=>Number(v).toFixed(2)]
].forEach(([id, outId, key, fmt]) => {
  const el = document.getElementById(id), out = document.getElementById(outId);
  el.addEventListener('input', () => {
    state[key] = Number(el.value);
    out.textContent = fmt(el.value);
    render();
  });
});

document.getElementById('themeBtn').addEventListener('click', () => {
  const root = document.documentElement;
  const dark = root.getAttribute('data-theme') === 'dark';
  root.setAttribute('data-theme', dark ? 'light' : 'dark');
  document.getElementById('themeBtn').textContent = dark ? 'Mode sombre' : 'Mode clair';
});

document.getElementById('copyBtn').addEventListener('click', async () => {
  const txt = `zenray-meshes 2.0 gates: arch=${state.arch}, preset=${state.preset}, aspect_tol=${state.aspectTol}, contact_mm=${state.contactTol}, max_quads=${state.maxQuads}, p95_mm=${state.errTol}, delight_span=${state.delightTol}`;
  try { await navigator.clipboard.writeText(txt); } catch {}
  const btn = document.getElementById('copyBtn');
  btn.textContent = 'Valeurs copiees !';
  setTimeout(() => { btn.textContent = 'Copier les valeurs pour le prompt'; }, 1400);
});

render();
</script>
