#!/bin/zsh
# 27 October 2026 : ZenRay Meshes, the CLEANUP CHAIN of the car delivery (v479 on), on the delivery file after the floor remesh : work/car/delivery_<tag>_floor.npz is the anchor and the input,
# work/car/delivery_<tag>.npz the output (and the OBJ). Flatten the twisted quads, slide the free points, twice, regularise the worst corners, flatten ; each step keeps the guard (no face may become faulty)
# and the move cap is measured from the anchor. It runs without Houdini, so a variant is tested in a minute : zsh Scripts/CleanChain.sh <tag> then TopoCheck.
# FR : chaîne de nettoyage de la livraison, sans Houdini ; l'ancre est le fichier après le plancher.
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; TAG=$1
cd $W
# the parameters of the chain (HDA) : RELAX_MM the cap of every relax step, TOURS the number of flatten + slide tours, REG_DEV the corner deviation above which the regularise step acts (degrees), REG_MM its cap
RELAX_MM=${RELAX_MM:-8}; TOURS=${TOURS:-2}; REG_DEV=${REG_DEV:-25}; REG_MM=${REG_MM:-8}
A=work/car/delivery_${TAG}_floor.npz; G=(--guard work/car/topo_params.json --anchor $A); O=work/car/floor/chain_$TAG.json
IN=$A; : > $O
for k in $(seq 1 $TOURS); do
  $PY -I Scripts/PlanarizeQuads.py $IN work/car/delivery_${TAG}_p$k.npz ${G[@]} >> $O
  $PY -I Scripts/RelaxQuads.py work/car/delivery_${TAG}_p$k.npz work/car/delivery_${TAG}_r$k.npz ${G[@]} --max-mm $RELAX_MM >> $O
  IN=work/car/delivery_${TAG}_r$k.npz
done
$PY -I Scripts/RelaxQuads.py $IN work/car/delivery_${TAG}_g.npz ${G[@]} --max-mm $REG_MM --mode regular --dev-min $REG_DEV >> $O
$PY -I Scripts/PlanarizeQuads.py work/car/delivery_${TAG}_g.npz work/car/delivery_$TAG.npz ${G[@]} --obj versions/ZenRayCar_$TAG.obj >> $O
rm -f work/car/delivery_${TAG}_p[0-9]*.npz work/car/delivery_${TAG}_r[0-9]*.npz work/car/delivery_${TAG}_g.npz
