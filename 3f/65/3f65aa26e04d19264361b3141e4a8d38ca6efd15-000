import hou, json
res = json.load(open('/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026/data/hda_check.json'))
for r in res:
    if r.get('category') != 'Object': continue
    f = '/Users/zenray/.claude/skills/zenray-meshes/otls/' + r['file']; hou.hda.installFile(f); d = hou.hda.definitionsInFile(f)[0]; n = hou.node('/obj').createNode(d.nodeTypeName())
    pts = prs = qd = 0; errs = []; kids = []
    for c in n.allSubChildren():
        if c.type().category().name() == 'Sop' and c.isDisplayFlagSet() and c.parent().type().category().name() == 'Object':
            try:
                g = c.geometry(); pts += len(g.points()); prs += len(g.prims()); qd += sum(1 for p in g.prims() if len(p.vertices()) == 4); errs += [e[:120] for e in c.errors()]
            except Exception as e: errs.append(str(e)[:120])
            kids.append(c.parent().name())
    r.update({'points': pts, 'prims': prs, 'quads': qd, 'errors': errs[:3], 'geo_containers': len(set(kids))}); r.pop('cook_error', None)
    print(r['file'], 'containers', len(set(kids)), 'prims', prs, 'quads', qd, errs[:1], flush=True)
