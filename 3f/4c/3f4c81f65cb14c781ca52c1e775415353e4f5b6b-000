def border_report(Vq, Q, Vin, Tin, gin):
    """quads straddling the component border and share of the border covered by quad edges"""
    Tin = np.array(Tin); ed = {}
    for i, t in enumerate(Tin):
        for j in range(3): a, b = t[j], t[(j + 1) % 3]; ed.setdefault((min(a, b), max(a, b)), []).append(i)
    be = [k for k, L in ed.items() if len(L) == 2 and gin[L[0]] != gin[L[1]]]
    BS = np.concatenate([Vin[a][None] + (Vin[b] - Vin[a])[None] * np.linspace(0, 1, 6)[:, None] for a, b in be]) if be else np.zeros((0, 3))
    QS = q3run.seg_samples(Vq, Q, 12); el = float(np.mean([np.linalg.norm(Vq[q[k]] - Vq[q[(k + 1) % 4]]) for q in Q for k in range(4)]))
    d = cKDTree(QS).query(BS)[0] if len(BS) else np.array([0.0]); P, L = surf_samples(Vin, Tin, [g for g in gin])
    names = sorted(set(gin)); code = {g: i for i, g in enumerate(names)}; Lc = np.array([code[g] for g in L]); tr = cKDTree(P)
    lab = Lc[tr.query(Vq)[1]]; dB = cKDTree(BS).query(Vq)[0] if len(BS) else np.full(len(Vq), 9.0)
    mixed = 0
    for q in Q:
        ls = {lab[v] for v in q if dB[v] > 0.1 * el}
        mixed += len(ls) > 1
    # a quad is "crossing" when its centroid is farther than 0.1 edge from the border but its vertices lie on both sides ; also quads whose edge crosses the border (centre near border)
    cen = Vq[Q].mean(1); dc = cKDTree(BS).query(cen)[0] if len(BS) else np.full(len(Q), 9.0)
    return dict(border_edges=len(be), border_covered_01=round(float((d < 0.1 * el).mean()), 4), border_covered_03=round(float((d < 0.3 * el).mean()), 4), quads_with_vertices_on_both_sides=int(mixed), quads_centre_within_0_25_edge_of_border=int((dc < 0.25 * el).sum()), mean_edge=round(el, 5))
