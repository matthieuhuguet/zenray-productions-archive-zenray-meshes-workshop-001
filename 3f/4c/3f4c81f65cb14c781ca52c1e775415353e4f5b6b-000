def surf_samples(V, T, lab, n=200000, seed=1):
    rng = np.random.default_rng(seed); a, b, c = V[T[:, 0]], V[T[:, 1]], V[T[:, 2]]; ar = 0.5 * np.linalg.norm(np.cross(b - a, c - a), axis=1)
    i = rng.choice(len(T), n, p=ar / ar.sum()); u = rng.random((n, 2)); m = u.sum(1) > 1; u[m] = 1 - u[m]
    return a[i] + u[:, :1] * (b[i] - a[i]) + u[:, 1:] * (c[i] - a[i]), np.array(lab)[i]
def weld(V, tris, gof, tol=1e-7):
    key = {}; remap = np.zeros(len(V), int); nv = []
    for i, p in enumerate(V):
        k = tuple(np.round(p / tol).astype(np.int64))
        if k not in key: key[k] = len(nv); nv.append(p)
        remap[i] = key[k]
    T = [[remap[v] for v in t] for t in tris]; keep = [i for i, t in enumerate(T) if len(set(t)) == 3]
    return np.array(nv), [T[i] for i in keep], [gof[i] for i in keep]
def write_obj(path, V, T):
