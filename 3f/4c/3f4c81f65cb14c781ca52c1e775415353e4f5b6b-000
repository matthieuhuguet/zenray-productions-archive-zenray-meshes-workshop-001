def clip_half(V, F, axis=0):
    """triangles clipped to the half space x >= 0 (seam exactly on the plane)"""
    nv = [list(p) for p in V]; T = []
    def inter(i, j):
        a, b = V[i], V[j]; t = a[axis] / (a[axis] - b[axis]); p = a + t * (b - a); p[axis] = 0.0; nv.append(list(p)); return len(nv) - 1
    cache = {}
    def cut(i, j):
        k = (min(i, j), max(i, j))
        if k not in cache: cache[k] = inter(*k)
        return cache[k]
    for f in F:
        t = [f[0], f[1], f[2]]; s = [V[v][axis] >= 0 for v in t]; n = sum(s)
        if n == 3: T.append(t)
        elif n == 0: continue
        else:
            poly = []
            for k in range(3):
                a, b = t[k], t[(k + 1) % 3]; sa, sb = V[a][axis] >= 0, V[b][axis] >= 0
                if sa: poly.append(a)
                if sa != sb: poly.append(cut(a, b))
            for k in range(1, len(poly) - 1): T.append([poly[0], poly[k], poly[k + 1]])
    return np.array(nv), T
