"""2 November 2026 : a graduated ruler in the plane x = value, drawn on a frame from the camera of a part, to read the mouth line and the eye on the image. FR : une règle graduée dans le plan x = valeur, tracée sur une image depuis la caméra d'une partie, pour lire la ligne de bouche et l'œil sur l'image.
    python -I PartGrid.py <part folder> <frames folder> <frame> <x value> <out.png> [zoom] [step]"""
import sys, os, json
import numpy as np
from PIL import Image, ImageDraw
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE); from CompFit import cam_matrix, viewport, CF
part, frames, fr, xv, out = sys.argv[1], sys.argv[2], sys.argv[3], float(sys.argv[4]), sys.argv[5]; zoom = float(sys.argv[6]) if len(sys.argv) > 6 else 2.5; step = float(sys.argv[7]) if len(sys.argv) > 7 else 0.1
im = Image.open(f"{frames}/f_{int(fr):05d}.jpg").convert("RGB"); a = np.asarray(im); r = viewport(a.max(2).astype(np.float32)); v = im.crop(r); w, h = v.size; cam = json.load(open(f"{part}/cams.json"))[fr]; R, t, fp = cam_matrix(cam, w, h, CF["fov"]); v = v.resize((int(w * zoom), int(h * zoom)), Image.LANCZOS); d = ImageDraw.Draw(v)
def P(y, z):
    q = R @ np.array([xv, y, z]) + t; return (w / 2 + fp * q[0] / q[2]) * zoom, (h / 2 - fp * q[1] / q[2]) * zoom
zs = np.arange(-2.2, 2.6001, step); ys = np.arange(-1.4, 1.6001, step)
for z in zs:
    maj = abs(z / (step * 5) - round(z / (step * 5))) < 1e-6; d.line([P(ys[0], z), P(ys[-1], z)], fill=(255, 220, 0) if maj else (110, 100, 0), width=1)
    if maj: x_, y_ = P(ys[-1], z); d.text((x_ - 8, y_ - 12), f"{z:.1f}", fill=(255, 255, 0))
for y in ys:
    maj = abs(y / (step * 5) - round(y / (step * 5))) < 1e-6; d.line([P(y, zs[0]), P(y, zs[-1])], fill=(0, 220, 255) if maj else (0, 100, 110), width=1)
    if maj: x_, y_ = P(y, zs[-1]); d.text((x_ + 3, y_ - 5), f"{y:.1f}", fill=(0, 255, 255))
v.save(out); print(v.size)
