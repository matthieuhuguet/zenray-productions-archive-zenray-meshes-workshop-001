_REPL = {}
_tok = re.compile(r"(?<![A-Za-z0-9_À-ÿ.\-/])[A-Za-zÀ-ÿ]+(?![A-Za-z0-9_À-ÿ\-/])")
def _fix_tokens(t):
    def sub(m):
        w = m.group(0); lw = w.lower()
        if lw in PROTECT or w.isupper() and len(w) > 1:
            return w
        cand = OVERRIDE.get(lw) or _best.get(lw)
        if not cand:
            return w
        f0 = _freq.get(lw, 0); f1 = _freq.get(cand, 1)
        if lw not in OVERRIDE and f0 and f1 < 50 * f0:
            return w
        out = cand
        if w[0].isupper():
            out = out[0].upper() + out[1:]
        _REPL[(w, out)] = _REPL.get((w, out), 0) + 1
        return out
    return _tok.sub(sub, t)
def fr(t):
    for i, m in enumerate(MASKS):
        t = t.replace(m, f"\u00a7{i}\u00a7")
    for a, b in PHRASES + PHRASES2 + PHRASES3:
        t = t.replace(a, b)
    for pat, rp in REGEXES:
        t = re.sub(pat, rp, t)
    t = _fix_tokens(t)
    for i, m in enumerate(MASKS):
        t = t.replace(f"\u00a7{i}\u00a7", m)
    return t
_SKIP_KEYS = {"nom", "id", "sujet", "statut", "citation_courte", "fichier_citation", "ligne_source", "script", "sortie", "titre_en"}
def walk(o, key=None):
    if isinstance(o, dict):
        return {k: (v if k in _SKIP_KEYS else walk(v, k)) for k, v in o.items()}
    if isinstance(o, list):
        return [walk(v, key) for v in o]
    if isinstance(o, str):
        return fr(o)
    return o
