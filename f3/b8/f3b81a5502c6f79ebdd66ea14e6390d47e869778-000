def path(p):
    return p if p.startswith("/") else os.path.join(BASE, p)

_cache = {}
def lines_of(p):
    if p not in _cache:
        with open(path(p), errors="replace") as f:
            _cache[p] = f.read().split("\n")
    return _cache[p]

def norm(s):
    return re.sub(r"\s+", " ", s).strip()

errors = []

def find_quote(fichier, quote):
    """Retourne le numero de ligne (1-indexe) ou la citation commence, apres normalisation des espaces."""
    L = lines_of(fichier)
    full = norm(" ".join(L))
    if norm(quote) not in full:
        return None
    # numero de ligne: premiere ligne contenant les 25 premiers caracteres normalises
    head = norm(quote)[:25]
    for i, l in enumerate(L, 1):
        if head in norm(l):
            return i
    # citation a cheval sur deux lignes dont le debut est coupe: chercher 12 caracteres
    head = norm(quote)[:12]
    for i, l in enumerate(L, 1):
        if head in norm(l):
            return i
    return 0

def find_token(fichier, token):
    for i, l in enumerate(lines_of(fichier), 1):
        if token in l:
            return i
    return None

def E(id, sujet, nom, url, licence, statut, lu, quote, qfile, principe, reseau, alt, chiffres, utile, notes=None):
    ch = []
    for (valeur, f, token) in chiffres:
        if f is None:
            ch.append({"valeur": valeur, "ligne_source": token})
            continue
        n = find_token(f, token)
        if n is None:
            errors.append(f"[{id}] chiffre introuvable: {token!r} dans {f}")
            ch.append({"valeur": valeur, "ligne_source": f"INTROUVABLE {f}"})
        else:
            ch.append({"valeur": valeur, "ligne_source": f"{f}:{n}"})
    e = {
        "id": id, "sujet": sujet, "nom": nom, "url_ouverte": url, "licence": licence,
        "statut": statut, "ce_qui_a_ete_lu": lu,
        "citation_courte": None, "fichier_citation": None,
        "principe": principe, "reseau_de_neurones": reseau,
        "alternative_sans_reseau": alt, "chiffres": ch,
        "utile_pour_voiture_facettee": utile,
    }
    if quote:
        n = find_quote(qfile, quote)
        if n is None:
            errors.append(f"[{id}] citation introuvable: {quote!r} dans {qfile}")
            e["citation_courte"] = "INTROUVABLE"
        else:
            if len(quote.split()) > 20:
                errors.append(f"[{id}] citation trop longue ({len(quote.split())} mots)")
            e["citation_courte"] = '"' + quote + '"'
            e["fichier_citation"] = f"{qfile}:{n}"
    if notes:
        e["notes"] = notes
    return e

