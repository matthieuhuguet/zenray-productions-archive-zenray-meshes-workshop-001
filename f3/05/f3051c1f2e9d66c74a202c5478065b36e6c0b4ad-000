"""30 October 2026 : DRACARD episode 2 reproduced (A point is a joint) : line, resample, sweep, sculpt placeholder, rig doctor, joint capture biharmonic, bone deform. Nodes only, as read in notes/ep01_ep02.md.
    hython Ep02.py out_dir"""
import hou, sys, os
out = sys.argv[1]; os.makedirs(out, exist_ok=True)
geo = hou.node("/obj").createNode("geo", "dracard_ep02"); g = geo
line = g.createNode("line", "line1"); line.parm("dist").set(4.0); line.parm("points").set(2); line.parmTuple("dir").set((0, 0, 1))
rs = g.createNode("resample", "resample1"); rs.setInput(0, line); rs.parm("length").set(0.4)
sw = g.createNode("sweep::2.0", "sweep1"); sw.setInput(0, rs)
for n, v in (("surfaceshape", "tube"), ("surfacetype", "quads"), ("endcaptype", "grid")):
    try: sw.parm(n).set(v)
    except Exception as e: print("sweep parm", n, e)
sw.parm("tubeoutradius") and sw.parm("tubeoutradius").set(0.3) if sw.parm("tubeoutradius") else None
smooth = g.createNode("smooth", "sculpt_placeholder_smooth"); smooth.setInput(0, sw)    # the Sculpt SOP is a viewport state tool : placeholder in the chain
rd = g.createNode("rigdoctor", "rigdoctor1"); rd.setInput(0, rs); rd.parm("initmissingnames").set(1); rd.parm("nameprefix").set("parent_"); rd.parm("sanitizenames").set(1); rd.parm("inittransforms").set(1)    # f_00201 : Initialize Transforms, otherwise it does not work
jc = g.createNode("jointcapturebiharmonic", "jointcapturebiharmonic1"); jc.setInput(0, smooth); jc.setInput(1, rd)
bd = g.createNode("bonedeform", "bonedeform1"); bd.setInput(0, jc, 0); bd.setInput(1, rd)
bd.setDisplayFlag(True); bd.setRenderFlag(True)
res = {}
for n in g.children():
    try: n.cook(force=True); res[n.name()] = (len(n.geometry().points()), len(n.geometry().prims()), [e.message() for e in n.errors()][:1])
    except Exception as e: res[n.name()] = "ERR " + str(e)[:80]
for k, v in res.items(): print(k, v)
hou.hipFile.save(os.path.join(out, "Ep02.hip"))
bd.geometry().saveToFile(os.path.join(out, "ep02_result.obj"))
