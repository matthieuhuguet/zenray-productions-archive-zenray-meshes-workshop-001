"""29 October 2026 : ZenRay Retopology OBJ, the component surface written for Houdini : the left half (x >= -margin) as an OBJ with one
group per component region (g r_<id>), read back in Houdini by a File SOP (fast C++ reader) ; the region id becomes a prim attribute.
python ZrlObj.py [in.npz] [out.obj]        FR : la surface découpée écrite pour Houdini, un groupe par component."""
import sys, time
import numpy as np
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
PARAMS = {"in": f"{ROOT}/work/lines/mbo.npz", "out": f"{ROOT}/work/lines/mbo_left.obj", "half_margin_m": 0.02}   # 29 October 2026


def write(prm=PARAMS):
    d = np.load(prm["in"], allow_pickle=True); V, F, reg = d["V"], d["F"], d["region"]
    keep = (V[F][:, :, 0] >= -prm["half_margin_m"]).all(1); F = F[keep]; reg = reg[keep]
    used = np.unique(F); remap = -np.ones(len(V), np.int64); remap[used] = np.arange(len(used)); V = V[used]; F = remap[F] + 1
    with open(prm["out"], "w") as f:
        f.write("# 29 October 2026 ZenRay Retopology component surface, left half\n")
        np.savetxt(f, V, fmt="v %.6f %.6f %.6f")
        for r in np.unique(reg):
            f.write(f"g r_{r}\n"); np.savetxt(f, F[reg == r], fmt="f %d %d %d")
    print(time.strftime("%H:%M:%S"), "wrote", prm["out"], len(V), "verts", len(F), "faces", len(np.unique(reg)), "regions")


if __name__ == "__main__":
    if len(sys.argv) > 2: PARAMS.update({"in": sys.argv[1], "out": sys.argv[2]})
    write()
