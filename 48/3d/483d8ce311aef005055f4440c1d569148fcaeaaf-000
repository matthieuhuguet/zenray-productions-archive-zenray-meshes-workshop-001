PARAMS = {   # 29 October 2026 : every tunable value of the crease map and of the alignment score
    "view_axes": [[1, 0, 0], [0, 1, 0], [0, 0, 1]],   # front view : x right, y up, z toward the viewer
    "center": [0.0, 1.26, 0.0],                      # metres, centre of the window
    "px_per_m": 1000.0,                               # 1 mm per pixel
    "res": 560,                                       # square window, 0.56 m
    "sigma_mm": 2.5,                                  # smoothing of the depth before the Hessian
    "min_curv": 25.0,                                 # 1/m, curvature across the crease (radius 4 cm)
    "max_slope": 1.2,                                 # surfaces steeper than about 50 degrees to the view are ignored
    "edge_guard_px": 6,                               # pixels kept away from the silhouette
    "min_len_mm": 14.0,                               # shorter crease pieces are noise
    "tol_mm": 4.0,                                    # a crease point is carried when a mesh edge passes within this distance
    "edge_sample_mm": 0.75,
}


def pixel_to_world(prm, rows, cols):
    s, r = prm["px_per_m"], prm["res"]; c = np.asarray(prm["center"], float); rx, uy, _ = (np.asarray(a, float) for a in prm["view_axes"])
    u = (cols + 0.5 - r / 2) / s; v = (r / 2 - 0.5 - rows) / s
    return c[None, :] + u[:, None] * rx[None, :] + v[:, None] * uy[None, :]


def world_to_pixel(prm, P):
    s, r = prm["px_per_m"], prm["res"]; c = np.asarray(prm["center"], float); rx, uy, _ = (np.asarray(a, float) for a in prm["view_axes"])
    d = np.asarray(P, float) - c; return np.stack([(d @ rx) * s + r / 2 - 0.5, r / 2 - 0.5 - (d @ uy) * s], 1)   # (col, row)


def crease_map(V, F, prm=PARAMS):
    """depth, normals and the valley strength (1/m) with its direction ; returns a dict of images and the crease points."""
    import Raster
    R = Raster.Renderer(V, F); mask, depth, N, _ = R.render(prm["center"], prm["px_per_m"], prm["view_axes"], prm["res"]); R.release()
    h = 1.0 / prm["px_per_m"]; sig = prm["sigma_mm"] / 1000.0 / h
    W = mask.astype(float); D0 = np.where(mask, depth, 0.0); ws = ndimage.gaussian_filter(W, sig); D = ndimage.gaussian_filter(D0, sig) / np.maximum(ws, 1e-9)
    gr, gc = np.gradient(D, h); Hrr = np.gradient(gr, h, axis=0); Hcc = np.gradient(gc, h, axis=1); Hcr = np.gradient(gr, h, axis=1)
    half = (Hcc + Hrr) / 2; rad = np.sqrt(((Hcc - Hrr) / 2) ** 2 + Hcr ** 2); lam = half + rad          # largest eigenvalue, across the crease
    ec, er = Hcr, lam - Hcc; alt = np.abs(ec) + np.abs(er) < 1e-12; ec = np.where(alt, 1.0, ec); er = np.where(alt, 0.0, er)
    n = np.hypot(ec, er); ec, er = ec / n, er / n                                                     # (col, row) direction across the crease
    slope = np.hypot(gr, gc); curv = lam / (1 + slope ** 2) ** 1.5
    inner = ndimage.binary_erosion(mask, iterations=int(prm["edge_guard_px"])) & (ws > 0.98) & (slope < prm["max_slope"])
    rows, cols = np.mgrid[0:prm["res"], 0:prm["res"]].astype(float)
    a = ndimage.map_coordinates(curv, [rows + er, cols + ec], order=1, mode="nearest"); b = ndimage.map_coordinates(curv, [rows - er, cols - ec], order=1, mode="nearest")
    keep = inner & (curv >= prm["min_curv"]) & (curv >= a) & (curv >= b)
    lab, nlab = ndimage.label(keep, structure=np.ones((3, 3)))
    if nlab:
        size = ndimage.sum(np.ones_like(curv), lab, index=np.arange(1, nlab + 1))
        keep &= np.isin(lab, 1 + np.flatnonzero(size * prm["px_per_m"] ** -1 * 1000 >= prm["min_len_mm"]))
    rr, cc = np.nonzero(keep); Pw = pixel_to_world(prm, rr.astype(float), cc.astype(float)); Pw[:, 2] = depth[rr, cc] + np.asarray(prm["center"])[2]
    return {"mask": mask, "depth": depth, "normal": N, "curv": curv, "keep": keep, "rows": rr, "cols": cc, "points": Pw, "strength": curv[rr, cc],
            "dir": np.stack([ec[rr, cc], -er[rr, cc]], 1)}


def read_quads(path):
    V, Q = [], []
    for line in open(path):
        t = line.split()
        if not t: continue
        if t[0] == "v": V.append([float(x) for x in t[1:4]])
        elif t[0] == "f": Q.append([int(x.split("/")[0]) - 1 for x in t[1:]])
    return np.array(V, float), Q


def footprint(prm, P, faces):
    img = Image.new("L", (prm["res"], prm["res"]), 0); d = ImageDraw.Draw(img); px = world_to_pixel(prm, P)
    for f in faces: d.polygon([tuple(px[i]) for i in f], fill=255)
    return np.asarray(img) > 0


def alignment(cm, P, faces, prm=PARAMS):
    """share of the crease points inside the mesh footprint carried by a mesh edge (front view), strength weighted : an edge passes within tol_mm
    AND runs along the crease (within max_angle_deg of its tangent ; a grid line crossing the crease does not carry it). Random grid baseline about 0.3."""
    E = set()
    for f in faces:
        for k in range(len(f)): a, b = f[k], f[(k + 1) % len(f)]; E.add((min(a, b), max(a, b)))
    px = world_to_pixel(prm, P); step = prm["edge_sample_mm"] / 1000.0 * prm["px_per_m"]; S, D = [], []
    for a, b in E:
        seg = px[b] - px[a]; L = np.linalg.norm(seg); n = max(2, int(np.ceil(L / step)) + 1); t = np.linspace(0, 1, n)[:, None]
        S.append(px[a] * (1 - t) + px[b] * t); D.append(np.repeat((seg / max(L, 1e-9))[None, :], n, 0))
    S = np.concatenate(S); D = np.concatenate(D); tree = cKDTree(S); fp = footprint(prm, P, faces)
    inside = fp[cm["rows"], cm["cols"]]; pts = np.stack([cm["cols"], cm["rows"]], 1)[inside].astype(float); w = cm["strength"][inside]
    if not len(pts): return {"crease_points": 0, "aligned": None}
    across = np.stack([cm["dir"][inside][:, 0], -cm["dir"][inside][:, 1]], 1); tan = np.stack([-across[:, 1], across[:, 0]], 1)   # dir is (x, y up) across the crease ; tangent in (col, row)
    tol = prm["tol_mm"] / 1000.0 * prm["px_per_m"]; cmin = np.cos(np.radians(prm.get("max_angle_deg", 30.0)))
    d, idx = tree.query(pts, k=12, distance_upper_bound=tol); ok = np.zeros(len(pts), bool)
    for j in range(idx.shape[1]):
        hit = np.isfinite(d[:, j]); ii = np.where(hit, idx[:, j], 0)
        ok |= hit & (np.abs((D[ii] * tan).sum(1)) >= cmin)
    d0 = d[:, 0]; d_mm = np.where(np.isfinite(d0), d0, tree.query(pts)[0]) / prm["px_per_m"] * 1000
    return {"crease_points": int(len(pts)), "aligned": round(float((w * ok).sum() / w.sum()), 3), "aligned_unweighted": round(float(ok.mean()), 3),
            "median_gap_mm": round(float(np.median(d_mm)), 2), "tol_mm": prm["tol_mm"], "max_angle_deg": prm.get("max_angle_deg", 30.0), "far": pts[~ok], "far_strength": w[~ok]}


def crease_path(cm, prm, a_xy, b_xy, snap_mm=6.0, floor=0.15, full=80.0):
    """29 October 2026 : the cheapest path along the creases between two points of the view (x, y metres) : cost 1 / (floor + clip(curv / full, 0, 1)),
    so a crease costs about 0.9 per pixel and plain skin about 6.7 ; both ends first snap to the strongest crease pixel within snap_mm. Returns (n, 2) x, y."""
    from skimage.graph import route_through_array
    curv = np.nan_to_num(cm["curv"], nan=0.0); cost = 1.0 / (floor + np.clip(curv / full, 0, 1)); cost[~cm["mask"]] = 1e3
    ends = []
    for xy in (a_xy, b_xy):
        c, r = world_to_pixel(prm, np.array([[xy[0], xy[1], 0.0]]))[0]; rad = snap_mm / 1000.0 * prm["px_per_m"]
        r0, r1, c0, c1 = int(max(0, r - rad)), int(min(prm["res"] - 1, r + rad)), int(max(0, c - rad)), int(min(prm["res"] - 1, c + rad))
        win = curv[r0:r1 + 1, c0:c1 + 1].copy(); rr, cc = np.mgrid[r0:r1 + 1, c0:c1 + 1]; win[(rr - r) ** 2 + (cc - c) ** 2 > rad ** 2] = -1
        k = np.unravel_index(np.argmax(win), win.shape); ends.append((r0 + k[0], c0 + k[1]) if win[k] > prm["min_curv"] else (int(round(r)), int(round(c))))
    path, _ = route_through_array(cost, ends[0], ends[1], fully_connected=True, geometric=True); path = np.array(path, float)
    W = pixel_to_world(prm, path[:, 0], path[:, 1]); return W[:, :2]


def board(cm, prm, out, P=None, faces=None, arcs=None, far=None):
    """grey shading, red creases, green mesh edges, dark network curves, orange crease points no edge carries."""
    N = cm["normal"]; L = np.array([-0.35, 0.45, 0.82]); L /= np.linalg.norm(L); shade = np.clip((N * L).sum(2), 0, 1) * 0.75 + 0.2
    rgb = np.where(cm["mask"][..., None], (shade[..., None] * np.array([235, 235, 240])), np.array([246, 246, 244])).astype(np.uint8)
    img = Image.fromarray(rgb, "RGB").convert("RGBA"); lay = Image.new("RGBA", img.size, (0, 0, 0, 0)); d = ImageDraw.Draw(lay)
    if P is not None:
        px = world_to_pixel(prm, P)
        for f in faces: d.line([tuple(px[i]) for i in list(f) + [f[0]]], fill=(40, 150, 80, 200), width=1)
    if arcs is not None:
        for A in arcs: d.line([tuple(p) for p in world_to_pixel(prm, A)], fill=(20, 20, 30, 255), width=2)
    s = np.clip((cm["strength"] - prm["min_curv"]) / (4 * prm["min_curv"]), 0.25, 1.0)
    for r, c, a in zip(cm["rows"], cm["cols"], s): d.point((c, r), fill=(215, 40, 40, int(255 * a)))
    if far is not None:
        for c, r in far: d.ellipse((c - 1.5, r - 1.5, c + 1.5, r + 1.5), fill=(255, 140, 0, 255))
    Image.alpha_composite(img, lay).convert("RGB").save(out); return out


def main():
    if "--handle" in sys.argv:                                     # 29 October 2026 : POST /crease_path runs here, in its own process (an OpenGL context in a server thread can take the server down)
        req = json.loads(sys.stdin.read()); op = req.get("op"); print(json.dumps(handle_map(req) if op == "map" else handle_align(req) if op == "align" else handle(req))); return
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0]); ap.add_argument("--obj", required=True); ap.add_argument("--mesh"); ap.add_argument("--doc")
    ap.add_argument("--out", default=os.path.join(ROOT, "work/lines/creases/creases.png")); ap.add_argument("--min-curv", type=float, default=PARAMS["min_curv"]); a = ap.parse_args()
    import ZrlRefMesh as RM, ZrlSpline as SP
    prm = dict(PARAMS, min_curv=a.min_curv); V, F, _, _ = RM.from_obj(a.obj); cm = crease_map(V, F, prm)
    rep = {"crease_points": int(len(cm["rows"])), "curv_p50": round(float(np.median(cm["strength"])), 1) if len(cm["rows"]) else None}
    P = faces = arcs = far = None
    if a.mesh:
        P, faces = read_quads(a.mesh); al = alignment(cm, P, faces, prm); far = al.pop("far"); al.pop("far_strength"); rep["alignment"] = al
    if a.doc:
        doc = json.load(open(a.doc)); arcs = [SP.sample(np.array(A["ctrl"], float), 30) for A in doc["arcs"]]
    os.makedirs(os.path.dirname(a.out), exist_ok=True); rep["board"] = board(cm, prm, a.out, P, faces, arcs, far); print(json.dumps(rep, indent=1))



def handle(req, data_dir=os.path.join(ROOT, "lines/data")):
    """29 October 2026 : POST /crease_path : {"pts": [[x, y, z], ...] the clicked points, "view": {"rx", "uy", "tz"} the camera axes (tz toward the
    viewer), "ref": optional model (else the editor's source of truth, ref_mesh.json "source"), "ctrl_step_m": optional} -> {"ctrl": B-spline control
    points from the first to the last point, following the creases seen from that camera between each pair, "pts": the dense path, "crease_share"}.
    The model is rendered in a window around the points (any model, any view), then each pair is joined by crease_path and lifted by the depth."""
    import ZrlNetMesh as NM, ZrlSpline as SP
    pts = np.asarray(req["pts"], float); vw = req.get("view") or {}; ax = [np.asarray(vw.get(k, d), float) for k, d in (("rx", [1, 0, 0]), ("uy", [0, 1, 0]), ("tz", [0, 0, 1]))]
    ax = [a / max(np.linalg.norm(a), 1e-12) for a in ax]
    src = req.get("ref") or json.load(open(os.path.join(data_dir, "ref_mesh.json"))).get("source") or "v752"
    ref = NM.load_ref(src); tri = np.stack([ref.A, ref.B, ref.C], 1)
    c = pts.mean(0); uv = (pts - c) @ np.stack(ax[:2], 1); ext = max(0.06, float(np.abs(uv).max()) * 2 + 0.06); res = int(req.get("res", 640))
    prm = dict(PARAMS, view_axes=[a.tolist() for a in ax], center=c.tolist(), px_per_m=res / ext, res=res)
    keep_tri = np.abs(((tri.mean(1) - c) @ np.stack(ax[:2], 1))).max(1) < ext                          # only the triangles in the window
    cm = crease_map(tri[keep_tri].reshape(-1, 3), np.arange(int(keep_tri.sum()) * 3).reshape(-1, 3), prm)
    path = [pts[0]]; on = []
    for a, b in zip(pts[:-1], pts[1:]):
        pa, pb = world_to_pixel(prm, np.stack([a, b])); W = _pixel_path(cm, prm, pa, pb)
        for r, cc in W:
            d = cm["depth"][r, cc]
            if np.isfinite(d): path.append(pixel_to_world(prm, np.array([float(r)]), np.array([float(cc)]))[0] + d * ax[2]); on.append(bool(cm["curv"][r, cc] >= prm["min_curv"] * 0.5))
        path.append(b)
    S = SP.clean_polyline(np.array(path)); m = max(4, int(round(SP.polyline_length(S) / float(req.get("ctrl_step_m", 0.03)))) + 1)
    cum = np.r_[0, np.cumsum(np.linalg.norm(np.diff(S, axis=0), axis=1))]; t = np.linspace(0, cum[-1], max(4 * m, 16))    # 29 October 2026 : even sampling, so a short or off model path still fits
    S = np.stack([np.interp(t, cum, S[:, k]) for k in range(3)], 1); C = SP.fit(S, m); C[0], C[-1] = pts[0], pts[-1]
    return {"ok": True, "ctrl": np.round(C, 6).tolist(), "pts": np.round(S, 6).tolist(), "crease_share": round(float(np.mean(on)) if on else 0.0, 3), "ref": src}


def handle_map(req, data_dir=os.path.join(ROOT, "lines/data")):
    """29 October 2026 : POST /creases : {"view": camera axes, "center": the camera target, "extent_m": the visible width, "ref": optional,
    "max_points": optional} -> {"points": crease points on the surface seen from that camera, "strength": 1/m} for the editor's crease layer."""
    import ZrlNetMesh as NM
    vw = req.get("view") or {}; ax = [np.asarray(vw.get(k, d), float) for k, d in (("rx", [1, 0, 0]), ("uy", [0, 1, 0]), ("tz", [0, 0, 1]))]
    ax = [a / max(np.linalg.norm(a), 1e-12) for a in ax]; c = np.asarray(req.get("center", [0, 0, 0]), float); ext = float(req.get("extent_m", 1.0)); res = int(req.get("res", 720))
    src = req.get("ref") or json.load(open(os.path.join(data_dir, "ref_mesh.json"))).get("source") or "v752"
    ref = NM.load_ref(src); tri = np.stack([ref.A, ref.B, ref.C], 1); keep = np.abs(((tri.mean(1) - c) @ np.stack(ax[:2], 1))).max(1) < ext
    prm = dict(PARAMS, view_axes=[a.tolist() for a in ax], center=c.tolist(), px_per_m=res / ext, res=res, sigma_mm=max(PARAMS["sigma_mm"], 1.5 * 1000.0 * ext / res))
    cm = crease_map(tri[keep].reshape(-1, 3), np.arange(int(keep.sum()) * 3).reshape(-1, 3), prm)
    rr, cc = cm["rows"], cm["cols"]; W = pixel_to_world(prm, rr.astype(float), cc.astype(float)) + cm["depth"][rr, cc][:, None] * ax[2]
    n = int(req.get("max_points", 6000)); k = max(1, int(np.ceil(len(W) / n))) if len(W) else 1
    return {"ok": True, "points": np.round(W[::k], 5).tolist(), "strength": np.round(cm["strength"][::k], 1).tolist(), "ref": src, "sigma_mm": round(prm["sigma_mm"], 2)}


def handle_align(req, data_dir=os.path.join(ROOT, "lines/data")):
    """29 October 2026 : POST /crease_align : {"view", "center", "extent_m", "P" (flat or n x 3), "Q" (flat by 4), "ref"} -> the share of the creases
    seen from that camera that a visible mesh edge carries (alignment, parallel within 30 degrees, 4 mm) ; quads hidden behind the surface are left out."""
    import ZrlNetMesh as NM
    vw = req.get("view") or {}; ax = [np.asarray(vw.get(k, d), float) for k, d in (("rx", [1, 0, 0]), ("uy", [0, 1, 0]), ("tz", [0, 0, 1]))]
    ax = [a / max(np.linalg.norm(a), 1e-12) for a in ax]; c = np.asarray(req.get("center", [0, 0, 0]), float); ext = float(req.get("extent_m", 1.0)); res = int(req.get("res", 720))
    src = req.get("ref") or json.load(open(os.path.join(data_dir, "ref_mesh.json"))).get("source") or "v752"
    ref = NM.load_ref(src); tri = np.stack([ref.A, ref.B, ref.C], 1); keep = np.abs(((tri.mean(1) - c) @ np.stack(ax[:2], 1))).max(1) < ext
    prm = dict(PARAMS, view_axes=[a.tolist() for a in ax], center=c.tolist(), px_per_m=res / ext, res=res, sigma_mm=max(PARAMS["sigma_mm"], 1.5 * 1000.0 * ext / res))
    cm = crease_map(tri[keep].reshape(-1, 3), np.arange(int(keep.sum()) * 3).reshape(-1, 3), prm)
    P = np.asarray(req["P"], float).reshape(-1, 3); Q = np.asarray(req["Q"], int).reshape(-1, 4); cen = P[Q].mean(1); px = world_to_pixel(prm, cen)
    r = np.clip(np.round(px[:, 1]).astype(int), 0, res - 1); cc = np.clip(np.round(px[:, 0]).astype(int), 0, res - 1); inside = (px[:, 0] >= 0) & (px[:, 0] < res) & (px[:, 1] >= 0) & (px[:, 1] < res)
    seen = inside & cm["mask"][r, cc] & (np.abs((cen - c) @ ax[2] - np.nan_to_num(cm["depth"][r, cc], nan=-9)) < 0.01)    # the quad is on the visible surface
    if not seen.any(): return {"ok": True, "visible_quads": 0, "aligned": None}
    al = alignment(cm, P, Q[seen].tolist(), prm); al.pop("far", None); al.pop("far_strength", None)
    return dict(al, ok=True, visible_quads=int(seen.sum()), ref=src)


def _pixel_path(cm, prm, pa, pb, floor=0.15, full=80.0):
    """cheapest 8 connected pixel path between two pixel positions (col, row) on the crease cost of crease_path."""
    from skimage.graph import route_through_array
    curv = np.nan_to_num(cm["curv"], nan=0.0); cost = 1.0 / (floor + np.clip(curv / full, 0, 1)); cost[~cm["mask"]] = 1e3
    clip = lambda p: (int(np.clip(round(p[1]), 0, prm["res"] - 1)), int(np.clip(round(p[0]), 0, prm["res"] - 1)))
    path, _ = route_through_array(cost, clip(pa), clip(pb), fully_connected=True, geometric=True); return path


