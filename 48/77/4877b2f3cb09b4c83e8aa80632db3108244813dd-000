# 27 October 2026 19:08: Lift both glazing and roof near their shared front seam.
import hou
import math
node = hou.pwd()
geo = node.geometry()
lift = node.evalParm('lift_m')
center = node.evalParm('center_z')
radius = node.evalParm('radius_m')
width_scale = node.evalParm('width_scale')
front_width_scale = node.evalParm('front_width_scale')
front_start = node.evalParm('front_start_z')
front_end = node.evalParm('front_end_z')
if front_end <= front_start:
    raise hou.NodeError('Front width interval is invalid')
roof_start = node.evalParm('roof_fade_start')
roof_end = node.evalParm('roof_fade_end')
if roof_end <= roof_start:
    raise hou.NodeError('Roof fade interval is invalid')
names = ('CAR_body_glass_windshield_C', 'CAR_body_roof_C')
ids = set()
roof_ids = set()
for name in names:
    group = geo.findPrimGroup(name)
    if group is None:
        raise hou.NodeError('Missing primitive group: ' + name)
    selected = {v.point().number() for prim in group.prims() for v in prim.vertices()}
    ids.update(selected)
    if name == 'CAR_body_roof_C': roof_ids.update(selected)
for index in ids:
    point = geo.point(index)
    pos = point.position()
    t = max(0.0, 1.0 - abs(pos[2] - center) / radius)
    t = t * t * (3.0 - 2.0 * t)
    w = max(0.0, min(1.0, (pos[2] - front_start) / (front_end - front_start)))
    w = w * w * (3.0 - 2.0 * w)
    scale = width_scale + (front_width_scale - width_scale) * w
    if index in roof_ids:
        r = max(0.0, min(1.0, (pos[2] - roof_start) / (roof_end - roof_start)))
        r = r*r*(3.0 - 2.0*r)
        scale = 1.0 + (width_scale - 1.0)*r
    point.setPosition((pos[0] * scale, pos[1] + lift*t, pos[2]))
