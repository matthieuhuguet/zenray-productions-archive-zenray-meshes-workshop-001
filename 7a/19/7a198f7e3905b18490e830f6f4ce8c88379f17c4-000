"""30 October 2026 : ZenRay Retopology HYBRID CAR : the whole car in quads, every one of its 137 parts.
EN: the parts that have a ZenRay Retopology patch (the visible panels, perfect topology) keep it ; every other part goes through the Houdini Quad Remesh part by part (HouQuadParts.py) ; the two are merged in one OBJ with the component of every quad (parts.json) and judged by ZrlTopoJudge.
    python -I ZrlHybridCar.py --ours lines/data/car_panels_mesh.obj --doc lines/data/lines_car_patches.json --out work/lines/bench/hybrid_car [--edge 0.04]
FR : la voiture entiere en quads, les 137 pieces : les panneaux visibles gardent le patch ZenRay, les autres passent par le Quad Remesh de Houdini piece par piece."""
import argparse, json, os, subprocess, sys
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import numpy as np, ZrlAutoPatch as AP, ZrlTopoJudge as TJ
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"; HYTHON = "/Users/zenray/Create/Build/Houdini22/Houdini22.0.368/Frameworks/Houdini.framework/Versions/22.0/Resources/bin/hython"


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("--ours", required=True); ap.add_argument("--doc", required=True); ap.add_argument("--out", required=True); ap.add_argument("--edge", type=float, default=0.04); ap.add_argument("--ref", default=f"{ROOT}/versions/ZenRayCar_v752.obj"); a = ap.parse_args()
    os.makedirs(a.out, exist_ok=True); m = AP.mesh(os.path.abspath(a.ref)); doc = json.load(open(a.doc)); covered = set()
    for s in doc["component_seeds"]: covered.add(m["names"][int(m["G"][int(m["tree"].query(np.array(s["p"]))[1])])])
    skip = os.path.join(a.out, "skip.txt"); open(skip, "w").write("\n".join(sorted(covered))); hou = os.path.join(a.out, "hou_rest.obj")
    r = subprocess.run([HYTHON, os.path.join(HERE, "HouQuadParts.py"), os.path.abspath(a.ref), os.path.abspath(hou), str(a.edge), "8", skip], capture_output=True, text=True)
    if not os.path.exists(hou): print(r.stdout[-400:], r.stderr[-400:]); sys.exit(1)
    V1, F1 = TJ.load(a.ours); P1 = json.load(open(a.ours + ".parts.json")); V2, F2 = TJ.load(hou); L2 = json.load(open(hou + ".parts.json")); labels = list(P1)
    for name, n in L2: labels += [name] * n
    V = np.vstack([V1, V2]); F = [f for f in F1] + [[x + len(V1) for x in f] for f in F2]; obj = os.path.join(a.out, "hybrid_car.obj")
    with open(obj, "w") as f:
        f.write("".join("v %.6f %.6f %.6f\n" % tuple(p) for p in V)); f.write("".join("f " + " ".join(str(int(x) + 1) for x in q) + "\n" for q in F))
    json.dump(labels, open(obj + ".parts.json", "w")); j = TJ.judge(obj, a.ref); j.update({"parts_ours": len(covered), "parts_houdini": len(L2), "faces_ours": len(F1), "faces_houdini": len(F2)}); json.dump(j, open(os.path.join(a.out, "judge.json"), "w"), indent=1); print(json.dumps(j))


if __name__ == "__main__": main()
