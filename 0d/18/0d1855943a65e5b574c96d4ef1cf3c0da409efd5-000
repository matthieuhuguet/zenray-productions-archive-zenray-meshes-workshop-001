"""30 October 2026 : ZenRay Retopology FACE REPORT : per component, whether its face meshes, and why not (the complement faces, the other side of every closed loop, are left out).
    python -I ZrlFaceReport.py doc.json --ref model.obj [--edge 0.05]
FR : par component, sa face est-elle maillée, sinon pourquoi."""
import argparse, json, os, sys
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import numpy as np, ZrlNetMesh as NM


def report(doc, ref, edge=0.05):
    prm = {"ref": os.path.abspath(ref), "unit": doc.get("mesh_unit", 1.0), "edge_m": edge, "write_obj": False, "auto_fallback": True, "component_options": doc.get("component_options", {}), "corners_force": doc.get("corners_force", {})}; prm.update(doc.get("mesh_params", {}))
    net = NM.Net(doc, None, prm); net.trace(); net.corners(); rows = []
    for f in net.faces:
        if (f.get("reason") or "") == "complement" or not f.get("component"): continue
        rows.append({"component": f["component"], "status": f["status"], "reason": f.get("reason") or "", "area": round(f["area"], 3), "sides": len(f.get("sides") or [])})
    return rows


if __name__ == "__main__":
    ap = argparse.ArgumentParser(); ap.add_argument("doc"); ap.add_argument("--ref", required=True); ap.add_argument("--edge", type=float, default=0.05); a = ap.parse_args()
    rows = report(json.load(open(a.doc)), a.ref, a.edge)
    for r in sorted(rows, key=lambda r: (r["status"], r["component"])): print("%-34s %-8s %-28s area %.3f sides %d" % (r["component"], r["status"], r["reason"][:28], r["area"], r["sides"]))
    print("components with a face", len({r["component"] for r in rows}), "ok", sum(1 for r in rows if r["status"] in ("ok", "pending")))
