import sys, json, time, numpy as np
sys.path.insert(0, sys.argv[1]); import verifiers as VF
def load(p):
    V=[];F=[]
    for l in open(p):
        t=l.split()
        if t and t[0]=="v": V.append([float(x) for x in t[1:4]])
        elif t and t[0]=="f":
            f=[int(x.split("/")[0])-1 for x in t[1:]]
            for k in range(1,len(f)-1): F.append([f[0],f[k],f[k+1]])
    return np.array(V),np.array(F)
V,T=load(sys.argv[2]); print(len(V),len(T)); t=time.time()
r=VF.run_all(V,T); print(json.dumps(r,default=float,indent=1)[:3500]); print("sec",time.time()-t)
json.dump(r,open(sys.argv[3],"w"),default=float)
