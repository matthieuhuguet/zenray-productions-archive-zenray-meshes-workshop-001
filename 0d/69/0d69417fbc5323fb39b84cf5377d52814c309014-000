# 25 October 2026 : ZenRay Meshes, zoomed crop of a view with its edge pixels and a fine labelled grid, to trace guide
# curves precisely. FR : zoom d'une vue avec contours et grille fine, pour décalquer les courbes guides.
# Usage: python ZoomGrid.py <view_rgb.png> <edges.npy> <x0> <y0> <x1> <y1> <out.png> [scale=4] [grid=10]
import sys
import numpy as np
from PIL import Image, ImageDraw, ImageFont


def main(rgb, edges, x0, y0, x1, y1, out, scale="4", grid="10"):
    x0, y0, x1, y1, s, g = (int(v) for v in (x0, y0, x1, y1, scale, grid))
    a = np.asarray(Image.open(rgb).convert("L")).astype(float)[y0:y1, x0:x1]; E = np.load(edges)[y0:y1, x0:x1]
    im = np.stack([a * 0.6 + 50] * 3, -1); im[E] = (240, 90, 60)
    img = Image.fromarray(im.astype(np.uint8)).resize(((x1 - x0) * s, (y1 - y0) * s), Image.NEAREST); d = ImageDraw.Draw(img)
    f = ImageFont.truetype("/Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf", 12)
    for x in range((x0 // g + 1) * g, x1, g):
        d.line(((x - x0) * s, 0, (x - x0) * s, img.height), fill=(70, 120, 200) if x % 50 else (120, 190, 255), width=1)
        if x % 20 == 0: d.text(((x - x0) * s + 2, 2), str(x), font=f, fill=(170, 210, 255))
    for y in range((y0 // g + 1) * g, y1, g):
        d.line((0, (y - y0) * s, img.width, (y - y0) * s), fill=(70, 120, 200) if y % 50 else (120, 190, 255), width=1)
        if y % 20 == 0: d.text((2, (y - y0) * s + 2), str(y), font=f, fill=(170, 210, 255))
    img.save(out); print(out)


if __name__ == "__main__":
    main(*sys.argv[1:])
