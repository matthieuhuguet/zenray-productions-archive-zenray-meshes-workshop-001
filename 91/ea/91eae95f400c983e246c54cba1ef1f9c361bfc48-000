"""28 October 2026 : ZenRay Meshes finishing, SYM FIX, every vertex of the listed R parts whose mirror has no L point within --tol-mm is moved onto the
mirror of its nearest L point (and the same the other way). python SymFix.py <in> <out> --pairs CAR_body_shoulder [--tol-mm 3]
FR : recale sur le miroir les sommets d'une paire L/R qui n'ont pas de jumeau."""
import argparse, json
import numpy as np
from scipy.spatial import cKDTree
ap = argparse.ArgumentParser(); ap.add_argument("inp"); ap.add_argument("out"); ap.add_argument("--pairs", required=True); ap.add_argument("--tol-mm", type=float, default=3.0); a = ap.parse_args()
d = np.load(a.inp, allow_pickle=True); P = d["P"].astype(float); n = np.array([str(x) for x in d["names"]]); rep = {}; S = np.array([-1.0, 1, 1])
for b in a.pairs.split(","):
    VL = np.array(sorted({int(v) for q, m in zip(d["Q"], n) if m == b + "_L" for v in q})); VR = np.array(sorted({int(v) for q, m in zip(d["Q"], n) if m == b + "_R" for v in q}))
    for A, B in ((VR, VL), (VL, VR)):
        dd, k = cKDTree(P[B]).query(P[A] * S); bad = dd * 1000 > a.tol_mm
        P[A[bad]] = P[B[k[bad]]] * S; rep[b] = rep.get(b, 0) + int(bad.sum())
np.savez(a.out, P=P.astype(np.float32), Q=d["Q"], names=d["names"]); print(json.dumps(rep))
