    c, s, axes, R = ML.panel_camera(fr, V[vn], lab.shape, p["scale"]); rx, uy = np.array(axes[0]), np.array(axes[1]); du = float((c - c3) @ rx); dv = float((c - c3) @ uy); k = s / s_cell
