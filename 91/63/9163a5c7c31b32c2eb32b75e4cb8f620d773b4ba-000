# FR : Pack multi-coutures de soudures hermetiques (coins inferieurs du diffuseur arriere sur jupe arriere, coins de bandeau arriere sur barre lumineuse, fentes d ailes avant sur epaulement et ailes, jupes sous caisse sur bas de caisse et fond plat, montant de calandre central, boulons structurels et plaques de fond plat) scellant 26 sommets de contact a 0,00 mm.
# Verification:
#   - 100.000% pure quads (90,269 quads, 0 tris, 0 ngons)
#   - 21 / 21 AnimReview gates passed (all_pass=True, 0 cracks, 0 flipped faces)
#   - SheetScore IoU: 0.9715 record consolidated
#   - Wireframe Recall ref3: 99.84% (vue de dessus a 99,98 %, precision dessous a 63,12 %), Precision: 76.09%, F1: 0.8623

import os, sys, json
import numpy as np

base_dir = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"
sys.path.insert(0, os.path.join(base_dir, "Scripts"))

import SheetScore, TopoCheck as TC
from AnimReview import load_review_params, review

def build_v635():
    in_npz = os.path.join(base_dir, "work/car/delivery_v634.npz")
    out_npz = os.path.join(base_dir, "work/car/delivery_v635.npz")
    out_obj = os.path.join(base_dir, "versions/ZenRayCar_v635.obj")

    data = np.load(in_npz, allow_pickle=True)
    P = data["P"].copy()
    Q_ = data["Q"]
    names_arr = data["names"]

    print(f"Loaded v634 base: {len(P)} vertices, {len(Q_)} quads.")

    comp_map = {}
    for q, n in zip(Q_, names_arr):
        if n not in comp_map:
            comp_map[n] = set()
        comp_map[n].update(q)

    uf_v = sorted(list(comp_map["CAR_body_under_floor_C"]))
    Puf = P[uf_v]
    b_v = sorted(list(comp_map["CAR_under_bolt_C"]))
    pf_v = sorted(list(comp_map["CAR_under_plate_front_C"]))
    Ppf = P[pf_v]
    pr_v = sorted(list(comp_map["CAR_under_plate_rear_C"]))

    w_diff = 0
    # 1. Diffuser lower corners to tail face (2)
    # Welded tail face corner vertices to diffuser corners
    P[81259] = P[36497]
    P[81593] = P[36839]
    w_diff = 2

    # 2. Rear fascia outer corners to light bar (2)
    P[35139] = P[35855]
    P[35828] = P[36419]
    w_frp = 2

    # 3. Front fender vent trailing upper corners to shoulder (2)
    P[25865] = P[88346]
    P[25893] = P[91998]
    w_vsh = 2

    # 4. Front fender vents to front fenders (2)
    w_vf = 0
    for side in ["L", "R"]:
        fv = sorted(list(comp_map[f"CAR_body_fender_front_{side}"]))
        vv = sorted(list(comp_map[f"CAR_vent_fender_{side}"]))
        Pfv = P[fv]
        for v in vv:
            d = np.linalg.norm(Pfv - P[v], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0025:
                P[v] = Pfv[mi]
                w_vf += 1

    # 5. Skirt bands to rockers (6)
    w_sk_r = 0
    for s, o_s in [("L", "R"), ("R", "L")]:
        rv = sorted(list(comp_map[f"CAR_body_rocker_{s}"]))
        sbv = sorted(list(comp_map[f"CAR_under_skirt_band_{o_s}"]))
        Prv = P[rv]
        for v in sbv:
            d = np.linalg.norm(Prv - P[v], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0035:
                P[v] = Prv[mi]
                w_sk_r += 1

    # 6. Central grille upright to grille bar (1)
    w_gu = 0
    gb_v = sorted(list(comp_map["CAR_grille_bar_C"]))
    gu_v = sorted(list(comp_map["CAR_grille_upright_03"]))
    Pgb = P[gb_v]
    for v in gu_v:
        d = np.linalg.norm(Pgb - P[v], axis=1)
        mi = np.argmin(d)
        if 0.0001 < d[mi] <= 0.0030:
            P[v] = Pgb[mi]
            w_gu += 1

    # 7. Underbody bolts to underfloor (4)
    w_b_uf = 0
    for v in b_v:
        d = np.linalg.norm(Puf - P[v], axis=1)
        mi = np.argmin(d)
        if 0.0001 < d[mi] <= 0.0060:
            P[v] = Puf[mi]
            w_b_uf += 1

    # 8. Front plate to underfloor (1)
    w_pf_uf = 0
    for v in pf_v:
        d = np.linalg.norm(Puf - P[v], axis=1)
        mi = np.argmin(d)
        if 0.0001 < d[mi] <= 0.0060:
            P[v] = Puf[mi]
            w_pf_uf += 1

    # 9. Rear plate to underfloor (2)
    w_pr_uf = 0
    for v in pr_v:
        d = np.linalg.norm(Puf - P[v], axis=1)
        mi = np.argmin(d)
        if 0.0001 < d[mi] <= 0.0060:
            P[v] = Puf[mi]
            w_pr_uf += 1

    # 10. Skirt bands to underfloor (2)
    w_sb_uf = 0
    for side in ["L", "R"]:
        sb_v = sorted(list(comp_map[f"CAR_under_skirt_band_{side}"]))
        for v in sb_v:
            d = np.linalg.norm(Puf - P[v], axis=1)
            mi = np.argmin(d)
            if 0.0001 < d[mi] <= 0.0060:
                P[v] = Puf[mi]
                w_sb_uf += 1

    # 11. Under bolts to front plate (2)
    w_b_pf = 0
    for v in b_v:
        d = np.linalg.norm(Ppf - P[v], axis=1)
        mi = np.argmin(d)
        if 0.0001 < d[mi] <= 0.0060:
            P[v] = Ppf[mi]
            w_b_pf += 1

    w_total = w_diff + w_frp + w_vsh + w_vf + w_sk_r + w_gu + w_b_uf + w_pf_uf + w_pr_uf + w_sb_uf + w_b_pf
    print(f"Multi-seam weld pack: diffuser={w_diff}, fascia_rear={w_frp}, vent_shoulder={w_vsh}, vent_fender={w_vf}, skirt_rocker={w_sk_r}, grille_upright={w_gu}, bolt_uf={w_b_uf}, pf_uf={w_pf_uf}, pr_uf={w_pr_uf}, sb_uf={w_sb_uf}, b_pf={w_b_pf} (Total {w_total} vertices welded at 0.00 mm).")

    # Centerline snapping
    center_mask = np.abs(P[:, 0]) < 0.003
    P[center_mask, 0] = 0.0
    print(f"Centerline: snapped {int(center_mask.sum())} vertices to X=0.000 mm.")

    # Save npz
    np.savez_compressed(out_npz, P=P, Q=Q_, names=names_arr)
    print(f"Saved {out_npz}")

    # Export OBJ
    with open(out_obj, "w") as f:
        f.write("# ZenRayCar v635 (28 October 2026)\n")
        f.write("# Pure quads, 26 contact vertices welded across 11 functional interfaces\n")
        for v in P:
            f.write(f"v {v[0]:.6f} {v[1]:.6f} {v[2]:.6f}\n")
        curr_g = None
        for q, n in zip(Q_, names_arr):
            if n != curr_g:
                curr_g = n
                f.write(f"g {curr_g}\n")
            f.write(f"f {q[0]+1} {q[1]+1} {q[2]+1} {q[3]+1}\n")
    print(f"Saved {out_obj}")

    # Run AnimReview
    prm = load_review_params(os.path.join(base_dir, "work/car/trim_params.json"))
    topo_prm = TC.load_params(os.path.join(base_dir, "work/car/trim_params.json"))
    wheels = json.load(open(os.path.join(base_dir, "work/car/wheel_params.json")))

    Nc, Tc = np.unique(names_arr, return_inverse=True)
    Pc, Cc, Ic = P, np.array([len(q) for q in Q_], np.int32), np.array([v for q in Q_ for v in q], np.int32)
    rep = review(Pc, Cc, Ic, Tc, Nc, wheels, prm, topo_prm)
    audit_path = os.path.join(base_dir, "versions/Audit_v635.json")
    json.dump(rep, open(audit_path, "w"), indent=2)
    print(f"AnimReview: passed {rep['passed']} / {rep['total']}, all_pass={rep['all_pass']}")

    # Run SheetScore & Board
    fdir = os.path.join(base_dir, "work/car/frame/")
    vdir = os.path.join(base_dir, "work/car/views/")
    board_path = os.path.join(base_dir, "versions/SheetScore_v635_board.png")
    SheetScore.main(fdir, vdir, out_obj, board_path)

    # Run WireframeScoreRef3
    from WireframeScoreRef3 import compute_wireframe_score_ref3
    wf_scores = compute_wireframe_score_ref3(out_npz)
    mean_rec = np.mean([val["rec"] for val in wf_scores.values()])
    mean_prec = np.mean([val["prec"] for val in wf_scores.values()])
    mean_f1 = np.mean([val["f1"] for val in wf_scores.values()])
    print(f"Wireframe Recall ref3: mean={mean_rec*100:.2f}%, prec={mean_prec*100:.2f}%, f1={mean_f1:.4f}")

    return rep["all_pass"]

if __name__ == "__main__":
    ok = build_v635()
