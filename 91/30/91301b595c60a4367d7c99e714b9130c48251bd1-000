"""2 November 2026 : every part, fitted alone on its own frames, is gathered into one list for the frames of the whole dragon : shapes held, each part moves as a whole. FR : chaque partie, ajustée seule sur ses images, est rassemblée pour les images du dragon entier : formes tenues, chaque partie bouge d'un bloc.
    python -I Assemble.py <v3 folder> <out.json>"""
import sys, json, os
import numpy as np
os.chdir(sys.argv[1]); B = json.load(open("parts/T_body/fit.json"))["tubes"]; Pl = [t for t in json.load(open("parts/T_plates/fit.json"))["tubes"] if t["name"] != "body_ep05"]; W = json.load(open("parts/T_wing/fit_c.json"))["tubes"]; H = [t for t in json.load(open("parts/T_horn/fit3.json"))["tubes"] if t.get("kind") != "obj"]
foot = np.array([t for t in W if t["name"] == "stem"][0]["pts"][0]); d = np.array([0.32, 1.0, -0.8]) - foot
for t in W:
    t["pts"] = [[float(q[k] + d[k]) for k in range(3)] for q in t["pts"]]; t["mirror"] = True
for t in B + Pl + W + H: t["frozen"] = True
head = dict(name="head", kind="obj", file="parts/h4v/part.obj", pts=[[0, 0, 0]], ramp=[[0, 1]], radius=1.0, mirror=False, xform=[0.0, 0.0, 0.0, 1.0])
json.dump(dict(tubes=B + Pl + W + H + [head], groups=[[t["name"] for t in B], [t["name"] for t in Pl], [t["name"] for t in W], [t["name"] for t in H]]), open(sys.argv[2], "w"), indent=0); print("parts", len(B), len(Pl), len(W), len(H))
