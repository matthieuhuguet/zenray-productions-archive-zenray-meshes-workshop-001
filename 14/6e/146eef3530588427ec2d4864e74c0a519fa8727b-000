import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); sys.dont_write_bytecode=True
import diag, numpy as np
def run(obj,edge,o):
    m=diag.AP.mesh(os.path.abspath(obj)); zones=diag.ANY.segment(m,25.0,max(4,int(0.002*len(m['F']))),merge_deg=35.0,log=lambda s:None); rows=[]
    for k,(Z,seed) in enumerate(zones):
        try: r,err=diag.fill4(m,Z,edge,o)
        except Exception: continue
        if r is None: continue
        qm=diag.quad_metrics(r['P3r'],r['Q'],r['Nz'][r['tri_of']]); t=np.array(r['info']['turns']); defect=np.abs(t-90).max(); nstraight=int((t<35).sum())
        rows.append((defect,nstraight,len(r['Q']),int((qm['jmin']<0).sum()),int((qm['jmin']<0.3).sum())))
    return np.array(rows)
obj,edge=sys.argv[1],float(sys.argv[2]); R=run(obj,edge,dict(k=300,relax=0.0,snap='1',sag=0.001))
print('max corner defect |turn-90| (deg) : zones quads folded% squashed%')
for lo,hi in ((0,25),(25,50),(50,75),(75,100)):
    s=(R[:,0]>=lo)&(R[:,0]<hi)
    if s.sum(): print(f'[{lo},{hi}) zones {int(s.sum())} quads {int(R[s,2].sum())} folded {100*R[s,3].sum()/R[s,2].sum():.1f}% squashed {100*R[s,4].sum()/R[s,2].sum():.1f}%')
print('by number of fake corners (turn < 35 deg, i.e. a straight vertex used as a corner):')
for ns in range(0,5):
    s=R[:,1]==ns
    if s.sum(): print(f'  fake={ns}: zones {int(s.sum())} quads {int(R[s,2].sum())} folded {100*R[s,3].sum()/R[s,2].sum():.1f}% squashed {100*R[s,4].sum()/R[s,2].sum():.1f}%')
