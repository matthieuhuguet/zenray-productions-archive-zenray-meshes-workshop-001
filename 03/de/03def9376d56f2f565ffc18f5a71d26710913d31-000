ctrl=obj.node('CTRL_guides') or obj.createNode('null','CTRL_guides')
if not ctrl.parm('guide_file'):
    group=ctrl.parmTemplateGroup()
    group.append(hou.StringParmTemplate('guide_file','Guide control net',1,default_value=(config_path,),string_type=hou.stringParmType.FileReference))
