"""28 October 2026 : ZenRay Meshes RETOPO BENCH, shared measures of a retopology candidate (any mesh file or npz with P and Q/F) :
silhouette masks against the reference sheet (IoU per view, the reference is the threshold), shading noise (high frequency energy of a
smooth shaded render inside a window, against the same energy of the reference grey image), deviation to the sculpt (mm), topology
(quads, irregular interior vertices, min angle), boundary distance to the contour curves. FR : les mesures communes du tournoi de retopologie.
python Bench.py sil <mesh> [views]          IoU of the silhouettes, per view
python Bench.py selftest                    the reference against itself is green, its inverse is red"""
import json, os, sys
import numpy as np
from PIL import Image
from scipy import ndimage as ndi
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, os.path.dirname(HERE))
import Raster
from SheetScore import render_in_panel
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car/"
META = json.load(open(W + "frame/frame.json"))


def load(path):
    """Mesh file (obj, ply) or npz (P, Q or F) to (P float array, list of polygons)."""
    if path.endswith(".npz"):
        d = np.load(path, allow_pickle=True); P = d["P"].astype(float)
        Q = [list(map(int, q)) for q in d["Q"]] if "Q" in d.files else [list(map(int, f)) for f in d["F"]]
        return P, Q
    import trimesh
    m = trimesh.load(path, force="mesh", process=False); return np.asarray(m.vertices, float), [list(map(int, f)) for f in m.faces]


def tris(Q): return np.array([[q[0], q[k], q[k + 1]] for q in Q for k in range(1, len(q) - 1)], np.int64)


def silhouettes(P, Q, views=("left", "top", "front", "back", "right", "bottom")):
    r = Raster.Renderer(P.astype(np.float32), tris(Q)); out = {}
    for name in views:
        v = [v for v in META["views"] if v["name"] == name][0]; ref = np.asarray(Image.open(W + "frame/mask_%s.png" % name)) > 127
        M, _ = render_in_panel(r, META, v, ref.shape); out[name] = round(float((M & ref).sum() / max((M | ref).sum(), 1)), 4)
    r.release(); return out


def topology(Q, P):
    n = np.array([len(q) for q in Q]); E = {}
    for q in Q:
        for k in range(len(q)): e = (min(q[k], q[(k + 1) % len(q)]), max(q[k], q[(k + 1) % len(q)])); E[e] = E.get(e, 0) + 1
    bnd = {v for e, c in E.items() if c == 1 for v in e}; val = np.zeros(len(P), int)
    for e in E: val[e[0]] += 1; val[e[1]] += 1
    used = np.unique(np.concatenate([np.array(q) for q in Q])); inner = [v for v in used if v not in bnd]
    ang = []
    for q in Q:
        if len(q) != 4: continue
        for k in range(4):
            a, b, c = P[q[k - 1]], P[q[k]], P[q[(k + 1) % 4]]; u, w = a - b, c - b
            ang.append(np.degrees(np.arccos(np.clip(u @ w / (np.linalg.norm(u) * np.linalg.norm(w) + 1e-12), -1, 1))))
    return {"faces": len(Q), "quads_pct": round(100 * float((n == 4).mean()), 2), "irregular": int(sum(val[v] != 4 for v in inner)),
            "open_edges": int(sum(c == 1 for c in E.values())), "nonmanifold": int(sum(c > 2 for c in E.values())),
            "min_angle_p5": round(float(np.percentile(ang, 5)), 1) if ang else 0}


if __name__ == "__main__":
    if sys.argv[1] == "sil":
        P, Q = load(sys.argv[2]); print(json.dumps(silhouettes(P, Q)))
    elif sys.argv[1] == "selftest":
        ref = np.asarray(Image.open(W + "frame/mask_left.png")) > 127
        good = float((ref & ref).sum() / (ref | ref).sum()); bad = float((ref & ~ref).sum() / (ref | ~ref).sum())
        print(json.dumps({"ref_vs_ref": good, "ref_vs_inverse": bad})); sys.exit(0 if good == 1.0 and bad == 0.0 else 1)
