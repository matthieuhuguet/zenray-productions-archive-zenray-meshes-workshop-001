def panel_origins(p, sheet):
    """where each view sits on the sheet, so that the index and the verifier share the frame of image 1. FR : où se trouve chaque vue sur la planche."""
    out = {}; S = sheet.mean(2).astype(np.float32)
    for v in p["views"]:
        r = match_template(S, C.panel_rgb(p, v).astype(np.float32).mean(2)); y, x = np.unravel_index(r.argmax(), r.shape); out[v] = [int(x), int(y)]
    return out


def apply_fix(M, f, origin, sc):
    """a label the algorithm got wrong, corrected for one view : cut_fixes in params.json, {"view", "from", "to", "box" in sheet pixels, "area_max" in sheet pixels}. FR : une étiquette fausse de l'algorithme, corrigée pour une vue."""
