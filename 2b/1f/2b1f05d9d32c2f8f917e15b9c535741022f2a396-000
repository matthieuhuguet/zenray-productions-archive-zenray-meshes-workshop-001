    if "area_max" in f: cc, n = ndi.label(k); sz = ndi.sum(k, cc, range(1, n + 1)); k = np.isin(cc, 1 + np.flatnonzero(sz <= f["area_max"] * sc * sc))
    M[k] = f["to"] - 1


def plant_seeds(m, s):
    """the discs of one view, in panel pixels : the deepest point of each connected region, far from any border the algorithm may have wrong, then further points along long pieces. A region too thin to hold a disc is marked thin. FR : le point le plus profond de chaque région, loin des bords dont l'algorithme n'est pas sûr, puis d'autres le long des pièces longues ; une région trop fine est marquée."""
    seeds = []
    for i in np.unique(m[m >= 0]):
        cc = ndi.label(m == i)[0]
        for k, sl in enumerate(ndi.find_objects(cc)):
            R = cc[sl] == k + 1; dt = ndi.distance_transform_edt(np.pad(R, 1))[1:-1, 1:-1]; Y, X = np.mgrid[:R.shape[0], :R.shape[1]]
            for j in range(int(s["limit_per_region"])):
                y, x = np.unravel_index(dt.argmax(), dt.shape); d = float(dt[y, x])
                if d <= 0 or (j and d < s["depth_min_px"]): break
                seeds.append(dict(n=int(i) + 1, x=int(x + sl[1].start), y=int(y + sl[0].start), d=round(d, 2), r=round(float(np.clip(d * s["radius_ratio"], s["radius_min_px"], s["radius_max_px"])), 2))); dt[(Y - y) ** 2 + (X - x) ** 2 < s["spacing_px"] ** 2] = 0
    return seeds


def thin_out(seeds, s):
    """debris of the algorithm carries no disc, but every component keeps one, even a screw : its deepest ones if it has nothing thicker. FR : les débris de l'algorithme ne portent pas de pastille, mais chaque composant en garde une, même une vis."""
    keep = [q for q in seeds if q["d"] >= s["depth_min_px"]]; have = {q["n"] for q in keep}; rest = {}
    for q in seeds:
        if q["n"] not in have: rest.setdefault(q["n"], []).append(q)
    for L in rest.values(): keep += sorted(L, key=lambda q: -q["d"])[:int(s["thin_keep"])]
    return keep


def stamp_discs(sheet, seeds, hex_of, ring):
    """antialiased discs on a copy of the sheet : a white ring says it is a mark, the fill says the colour. FR : pastilles lissées : le cercle blanc dit que c'est une marque, le fond dit la couleur."""
    out = sheet.astype(np.float32).copy(); H, W = out.shape[:2]
    for q in sorted(seeds, key=lambda q: -q["r"]):
        R = q["r"] + ring + 1; x0, x1, y0, y1 = max(int(q["sx"] - R), 0), min(int(q["sx"] + R) + 2, W), max(int(q["sy"] - R), 0), min(int(q["sy"] + R) + 2, H); Y, X = np.mgrid[y0:y1, x0:x1]; dist = np.hypot(X - q["sx"], Y - q["sy"])
