# 25 October 2026 : ZenRay Meshes, write PLAN keypoints of a named row into work/car/lines/nose_rows.json : pairs (z, x) read on
# a zoomed top view, the height y taken from the current loft cage row at the same z, merged with the row's existing
# keypoints (points inside the new z range are replaced, those outside kept). FR : points clés en plan d'une rangée, y repris.
# Usage: python RowKeypoints.py <row> "z:x,z:x,..."  [cage_prefix=work/car/arch_loft]
import sys, os, json
import numpy as np
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"


def main(row, pairs, prefix=W + "work/car/arch_loft"):
    zx = sorted([tuple(map(float, p.split(":"))) for p in pairs.split(",")])
    c = json.load(open(prefix + "_cage.json")); st = np.array(c["stations"]); R = c["ring"]; E = c["exp_rows"]; nh = len(E)
    V = np.array([list(map(float, l.split()[1:])) for l in open(prefix + "_cage.obj") if l.startswith("v ")]).reshape(len(st), R, 3)
    j = nh - 1 + E.index(row); o = np.argsort(V[:, j, 2]); zr, yr = V[o, j, 2], V[o, j, 1]
    new = [[z, x, round(float(np.interp(z, zr, yr)), 4)] for z, x in zx]
    p = W + "work/car/lines/nose_rows.json"; N = json.load(open(p)); old = N["rows"].get(row, [])
    z0, z1 = zx[0][0], zx[-1][0]; kept = [k for k in old if not (z0 - 1e-6 <= k[0] <= z1 + 1e-6)]
    N["rows"][row] = sorted(kept + new); N.setdefault("_log", []).append("25 October 2026: %s plan keypoints %s" % (row, pairs))
    json.dump(N, open(p, "w"), indent=1); print(json.dumps({row: N["rows"][row]}))


if __name__ == "__main__":
    main(*sys.argv[1:])
