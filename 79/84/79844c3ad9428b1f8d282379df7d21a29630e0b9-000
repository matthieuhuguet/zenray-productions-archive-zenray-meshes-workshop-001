def contour(V, T, phi, level, branch=None):
    """the closed loops of phi == level on the surface (marching triangles) : list of (n, 3) arrays. With `branch` (a boolean mask of vertices) only the loop that belongs to it is kept :
    the one most of whose crossed edges touch the branch (above a saddle every finger has its own loop at a given distance)."""
    t = T; f = phi[t] - level; neg = f < 0; cnt = neg.sum(1); sel = np.nonzero((cnt > 0) & (cnt < 3))[0]; pts = {}; segs = []
    for fi in sel:
        a = t[fi]; pa = []
        for k in range(3):
            i, j = a[k], a[(k + 1) % 3]
            if (phi[i] - level) * (phi[j] - level) < 0:
                key = (min(i, j), max(i, j))
                if key not in pts: u = (level - phi[i]) / (phi[j] - phi[i]); pts[key] = V[i] + u * (V[j] - V[i])
                pa.append(key)
        if len(pa) == 2: segs.append((pa[0], pa[1]))
    nb = {}
    for a, b in segs: nb.setdefault(a, []).append(b); nb.setdefault(b, []).append(a)
    seen = set(); loops = []
    for start in nb:
        if start in seen: continue
        path = [start]; seen.add(start); cur = start; prev = None
        while True:
            nxt = [q for q in nb[cur] if q != prev and q not in seen]
            if not nxt: break
            prev, cur = cur, nxt[0]; seen.add(cur); path.append(cur)
        loops.append((np.array([pts[k] for k in path]), path))
    if branch is None: return [l for l, _ in loops]
    best, bs = None, 0.5
    for l, keys in loops:
        share = float(np.mean([branch[k[0]] or branch[k[1]] for k in keys]))
        if share >= bs: best, bs = l, share
    return [] if best is None else [best]


def frame(axis, front):
    e1 = np.asarray(front, float) - np.dot(front, axis) * axis
    if np.linalg.norm(e1) < 0.3: e1 = np.array([1.0, 0, 0]) - axis[0] * axis
    e1 /= np.linalg.norm(e1); return e1, np.cross(axis, e1)


def at_angles(loop, centre, e1, e2, n, polar=False):
    """the n corners of a closed loop and the loop split in n arcs, from the point of the loop most aligned with e1 (the front) and in the sense of the axis. When the loop is star shaped about its
    centre (the polar angle only grows along it : a limb ring) the corners are at equal POLAR angles, which keeps the corners of an oval ring near 90 degrees ; otherwise (the groove between two
    fingers, a thumb web) they are at equal ARC LENGTHS, which does not need the loop to be star shaped. The seam i of two rings is the corner i of both, so seams do not twist."""
    d = loop - centre; a = np.cross(e1, e2)
    area = float(np.sum(np.cross(d, np.roll(d, -1, axis=0)) @ a)) / 2.0
    if area < 0: loop = loop[::-1]; d = d[::-1]
    r = np.linalg.norm(d, axis=1) + 1e-12; ang0 = np.arctan2(d @ e2, d @ e1); nxt = np.roll(ang0, -1); idx = np.where((ang0 < 0) & (nxt >= 0) & (np.abs(ang0) < np.pi / 2) & (np.abs(nxt) < np.pi / 2))[0]
    if len(idx) == 1:                                                                        # 29 October 2026 : the start is the CONTINUOUS crossing of the loop with the direction e1, not the nearest vertex (one mesh edge of jitter, 5 degrees, made every seam wiggle)
        j = int(idx[0]); t = -ang0[j] / (nxt[j] - ang0[j]); p0 = loop[j] + t * (loop[(j + 1) % len(loop)] - loop[j]); loop = np.vstack([p0[None], np.roll(loop, -(j + 1), axis=0)]); d = loop - centre
    else:
        align = (d @ e1) / r; k0 = int(np.argmax(align - 0.02 * (r.max() - r) / r.max())); loop = np.roll(loop, -k0, axis=0); d = np.roll(d, -k0, axis=0)
    P = np.vstack([loop, loop[:1]]); cum = np.r_[0, np.cumsum(np.linalg.norm(np.diff(P, axis=0), axis=1))]; L = cum[-1]
    ang = np.unwrap(np.arctan2(d @ e2, d @ e1)); ang = np.r_[ang, ang[0] + 2 * np.pi]; blend = float(polar); star = blend > 0 and bool(np.all(np.diff(ang) > -1e-6)) and abs((ang[-1] - ang[0]) - 2 * np.pi) < 1e-3
    pos = [L * i / n for i in range(n)]                                                              # equal arc lengths : quads of one size, but an oval ring (an ankle bending into a foot) puts two corners 175 degrees apart
    if star: pos = [(1 - blend) * pos[i] + blend * float(np.interp(ang[0] + 2 * np.pi * i / n, ang, cum)) for i in range(n)]      # `polar` is the share (0 to 1) of the equal POLAR angle rule : 90 degrees between corners
    at = lambda s_: np.array([np.interp(s_, cum, P[:, c]) for c in range(3)]); corners = [at(q) for q in pos]; arcs = []
    for i in range(n):
        s0, s1 = pos[i], (pos[i + 1] if i + 1 < n else L); m = (cum > s0) & (cum < s1); arcs.append(np.vstack([corners[i][None], P[m], corners[(i + 1) % n][None]]))
    return corners, arcs


def girth(loop): return float(np.linalg.norm(np.diff(np.vstack([loop, loop[:1]]), axis=0), axis=1).sum())


def fit(Q, step):
    Q = SP.clean_polyline(np.asarray(Q)); L = SP.polyline_length(Q); m = max(4, int(round(L / step)) + 1); cum = np.r_[0, np.cumsum(np.linalg.norm(np.diff(Q, axis=0), axis=1))]
    if len(Q) < 2 or cum[-1] < 1e-9: return None
    t = np.linspace(0, cum[-1], max(4 * m, 16)); S = np.stack([np.interp(t, cum, Q[:, k]) for k in range(3)], 1); C = SP.fit(S, m); C[0], C[-1] = Q[0], Q[-1]; return C


def loop_centre(loop):
    """the centre of a closed loop weighted by arc length (the mean of the vertices leans towards where the contour has more vertices)."""
    P = np.asarray(loop, float); Q = np.roll(P, -1, axis=0); w = np.linalg.norm(Q - P, axis=1); s = float(w.sum())
    return P.mean(0) if s < 1e-12 else ((P + Q) / 2.0 * w[:, None]).sum(0) / s


def profile(V, T, phi, branch_mask, levels, front, planar=False, span=0.0, tilt=None):
    """the contour at every level, with its centre, its axis (toward the tip) and a frame carried from ring to ring (the angle zero of a seam never spins) : list of dicts, None when a level is not one loop."""
    out = []
    for lvl in levels:
        r = contour(V, T, phi, lvl, branch_mask); out.append(None if len(r) != 1 else {"level": lvl, "loop": r[0], "centre": loop_centre(r[0])})
    ok = [k for k, q in enumerate(out) if q is not None]; lv = np.array([out[k]["level"] for k in ok])
    for a, k in enumerate(ok):                                                            # 29 October 2026 : the axis over a baseline of `span` on each side, not between two levels 2 mm apart (the centre jitters by a millimetre and the frame of the seams spun by 60 degrees)
        lo = int(np.searchsorted(lv, lv[a] - span, side="right") - 1); hi = int(np.searchsorted(lv, lv[a] + span, side="left")); lo = max(min(lo, a - 1), 0) if a > 0 else 0; hi = min(max(hi, a + 1), len(ok) - 1) if a < len(ok) - 1 else len(ok) - 1
        ax = out[ok[hi]]["centre"] - out[ok[lo]]["centre"]; out[k]["axis"] = ax / max(np.linalg.norm(ax), 1e-12)
    if planar and tilt and tilt[0]:                                                        # 30 October 2026 : TILTED BASE. The armhole of a garment is not perpendicular to the bone : it runs from the armpit up over the top of the shoulder, a nearly vertical loop. The planes of the first rings of an arm are turned toward the horizontal outward direction, by tilt degrees at the base, fading to 0 over `blend` metres of the tube.
        deg, blend = float(tilt[0]), float(tilt[1])
        for k in ok:
            q = out[k]; w = max(0.0, 1.0 - (float(q["level"]) - float(levels[0])) / max(blend, 1e-6))
            if w <= 0: continue
            ax = q["axis"]; tgt = np.array([np.sign(q["centre"][0]) if abs(q["centre"][0]) > 1e-6 else 1.0, 0.0, 0.0]); sg = np.sign(np.cross(ax, tgt)[2]) or 1.0; a = np.radians(deg * w) * sg; c_, s_ = np.cos(a), np.sin(a)
            out[k]["axis"] = np.array([c_ * ax[0] - s_ * ax[1], s_ * ax[0] + c_ * ax[1], ax[2]]); out[k]["axis"] /= np.linalg.norm(out[k]["axis"])
    if planar:                                                                             # the ring becomes the planar cross section nearest to the centre, kept when its girth stays within 1.5 times the level's
        for k in ok:
            q = out[k]; f = (V - q["centre"]) @ q["axis"]; loops = contour(V, T, f, 0.0, None)
            if not loops: continue
            best = min(loops, key=lambda l: float(np.linalg.norm(l.mean(0) - q["centre"])))
            if np.linalg.norm(best.mean(0) - q["centre"]) < 0.5 * girth(q["loop"]) / (2 * np.pi) + 0.01 and girth(best) <= 1.5 * girth(q["loop"]): q["loop"] = best; q["centre"] = best.mean(0)
    prev = None
    for k in ok:
        a = out[k]["axis"]
        if prev is None: e1, _ = frame(a, front)
        else:
            e1 = prev - np.dot(prev, a) * a
            if np.linalg.norm(e1) < 1e-6: e1, _ = frame(a, front)
            e1 /= np.linalg.norm(e1)
        out[k]["e1"], out[k]["e2"] = e1, np.cross(a, e1); prev = e1
    return out


def ring_levels(prof, fine, c0, c1, step, prm):
    """where the rings of a tube go : the base, the tip side, the NECKS between (a minimum of the girth that the tube widens after by 25 %, or the last girth before a jump of 40 % : the rule of
    neck_candidates_band of ZenRay UV, rewritten for a loop of the distance), and evenly in between so that no gap is wider than `step`."""
    G = np.array([girth(q["loop"]) if q is not None else np.nan for q in prof]); ok = ~np.isnan(G); necks = []
    for k in range(1, len(fine) - 1):
        if not ok[k] or fine[k] <= c0 + prm["min_ring_gap"] * step or fine[k] >= c1 - prm["min_ring_gap"] * step: continue
        rho = G[k] / (2 * np.pi); w = max(rho, step); win = (np.abs(fine - fine[k]) <= w) & ok; af = G[(fine > fine[k]) & (fine <= fine[k] + prm["neck_window"] * w) & ok]; bf = G[(fine < fine[k]) & (fine >= fine[k] - 2 * w) & ok]
        if len(af) == 0: continue
        is_min = G[k] <= G[win].min() + 1e-12 and af.max() >= prm["neck_widen"] * G[k]; is_knee = len(bf) > 0 and af[:2].max() >= prm["neck_jump"] * G[k] and (bf.max() - bf.min()) <= 0.3 * G[k]
        if is_min or is_knee: necks.append(float(fine[k]))
    keep = []
    for c in necks:
        if not keep or c - keep[-1] >= prm["min_ring_gap"] * step: keep.append(c)
    for d_ in prm.get("joints_from_tip", ()):                                              # 29 October 2026 : a joint known by its distance from the tip (the ball of the foot, where the sole bends, 7.5 cm from the toe) joins the necks
        c_ = float(prm["tip_phi"]) - float(d_)
        if c0 + 1.5 * float(prm.get("joint_gap_m", 0.0)) < c_ < c1 - 1.5 * float(prm.get("joint_gap_m", 0.0)): keep.append(c_)
    keep = sorted(keep); marks = [c0] + keep + [c1]; out = [c0]
    for a, b in zip(marks[:-1], marks[1:]):
        m = max(1, int(np.ceil((b - a) / step - 1e-9)))
        for q in range(1, m + 1): out.append(a + (b - a) * q / m)
    gap = float(prm.get("joint_gap_m", 0.0))
    if gap > 0:                                                                            # 29 October 2026 : ANIMATION. A joint bends, so it gets a tight stack of rings (the knee, the ankle : a ring on the joint and one each side ; an elbow, a shoulder, a hip, a wrist : the shared ring and one beside it) and the evenly spaced rings step back
        pads = [c + s_ * gap for c in keep for s_ in (-1, 1)] + ([c0 + gap] if prm.get("pad_base") else []) + ([c1 - gap] if prm.get("pad_top") else [])
        pads = [round(p_, 6) for p_ in pads if c0 + 0.3 * gap < p_ < c1 - 0.3 * gap]; anchors = [round(a_, 6) for a_ in [c0, c1] + keep]; special = set(anchors) | set(pads)
        out = sorted({round(float(x), 6) for x in out} | set(pads)); out = [x for x in out if x in special or min(abs(x - y) for y in special) >= 0.6 * gap]
    return np.array(out), keep


def build_tube(V, T, phi, branch_mask, tip_vertex, saddle_phi, name, prm, doc, c_top=None, cap=True):
    """append the nodes, arcs, component seed and option of one tube to doc ; returns a report. c_top : the distance of the top ring (None : just under the tip) ; cap : close the tip."""
    tip_phi = phi[tip_vertex]; front = np.asarray(prm["front"], float); n = prm["seams"]
    c0 = saddle_phi + prm["base_margin_m"]; c1 = (tip_phi - prm["cap_m"]) if c_top is None else c_top
    if c1 - c0 < prm["ring_step_m"]: return {"name": name, "ok": False, "why": "tube too short for two rings"}
    fine = np.unique(np.round(np.r_[np.arange(c0, c1, prm["fine_step_m"]), c1] if not cap else np.r_[np.arange(c0, tip_phi - 0.0015, prm["fine_step_m"]), c1, tip_phi - 0.0015], 6)); prof = profile(V, T, phi, branch_mask, fine, front, planar=prm.get("planar_rings", False), span=prm.get("ring_step_m", 0.0), tilt=(prm.get("tilt_deg", 0.0), prm.get("tilt_blend_m", 0.07)))
    prm["tip_phi"] = float(tip_phi); levels, necks = ring_levels(prof, fine, c0, c1, prm["ring_step_m"], prm)
    at = {round(float(l), 6): k for k, l in enumerate(fine)}
    def nearest(l): return min(range(len(fine)), key=lambda k: abs(fine[k] - l))
    rk = []
    for l in levels:
        k = nearest(l)
        if prof[k] is None:                                                           # a level that is not one loop : the nearest one that is
            alt = [q for q in range(len(fine)) if prof[q] is not None and abs(fine[q] - l) <= prm["ring_step_m"] * 0.4]
            if not alt: return {"name": name, "ok": False, "why": "the ring at distance %.3f is not one loop" % l}
            k = min(alt, key=lambda q: abs(fine[q] - l))
        if not rk or k > rk[-1]: rk.append(k)
    rmin = float(prm.get("crown_min_radius_m", 0.0))                                       # 30 October 2026 : the last ring of a capped tube is never narrower than this radius (a crown of a head closed by a 4 cm cap, not a 2 cm one with 32 radial lines crowded into it)
    while cap and rmin > 0 and len(rk) > 2 and girth(prof[rk[-1]]["loop"]) / (2 * np.pi) < rmin: rk.pop()
    if len(rk) < 2: return {"name": name, "ok": False, "why": "fewer than two rings"}
    def add_node(p):
        doc["nodes"].append({"id": len(doc["nodes"]), "p": [round(float(x), 6) for x in p]}); return len(doc["nodes"]) - 1
    def add_arc(a, b, C):
        doc["arcs"].append({"id": len(doc["arcs"]), "a": a, "b": b, "closed": False, "pair": [name, name], "ctrl": np.round(C, 6).tolist(), "mirror": -1}); return len(doc["arcs"]) - 1
    x0m = prm.get("mirror_x0_m")                                                            # 30 October 2026 : a tube that straddles the plane of symmetry (the head and the neck) is built on one half and mirrored : the corner i and the corner n - i, the arcs i and n - 1 - i are images of each other, to the last digit, so the counts solver pairs them and the mesh is symmetric (the contours of a triangulated surface are not)
    def symm(cs, arcs=None):
        if x0m is None: return cs, arcs
        M = lambda P_: np.asarray(P_, float) * np.array([-1.0, 1.0, 1.0]) + np.array([2 * x0m, 0.0, 0.0]); cs = [np.asarray(c, float).copy() for c in cs]; h = n // 2
        for i in range(1, h): cs[n - i] = M(cs[i])
        cs[0][0] = x0m; cs[h][0] = x0m
        if arcs is not None:
            arcs = [np.asarray(a, float).copy() for a in arcs]
            for i in range(h): arcs[n - 1 - i] = M(arcs[i])[::-1]                                  # the arc i runs cs[i] to cs[i + 1], its image runs from cs[n - i] to cs[n - 1 - i] : the arc n - 1 - i read backwards
            for i in range(n): arcs[i][0] = cs[i]; arcs[i][-1] = cs[(i + 1) % n]
        return cs, arcs
    corner_nodes = []; ring_arcs = []
    for k in rk:
        q = prof[k]; cs, arcs = at_angles(q["loop"], q["centre"], q["e1"], q["e2"], n, prm.get("corner_polar_blend", 0.0)); cs, arcs = symm(cs, arcs); ring_arcs.append(arcs); corner_nodes.append([add_node(p) for p in cs])
    for r, arcs in enumerate(ring_arcs):                                                     # ring arcs
        for i in range(n):
            C = fit(arcs[i], prm["ctrl_step_m"])
            if C is not None: add_arc(corner_nodes[r][i], corner_nodes[r][(i + 1) % n], C)
    def seam(i, ka, kb):                                                                    # the seam i read at every fine level from index ka to index kb (inclusive)
        out = []
        for k in range(ka, kb + 1):
            q = prof[k]
            if q is None: continue
            cs, _ = at_angles(q["loop"], q["centre"], q["e1"], q["e2"], n, prm.get("corner_polar_blend", 0.0)); cs, _ = symm(cs); out.append(cs[i])
        return out
    seam_arcs = 0
    for r in range(len(rk) - 1):
        for i in range(n):
            mid = seam(i, rk[r], rk[r + 1]); mid = mid[1:-1] if len(mid) > 2 else []
            Q = [np.array(doc["nodes"][corner_nodes[r][i]]["p"])] + mid + [np.array(doc["nodes"][corner_nodes[r + 1][i]]["p"])]; C = fit(Q, prm["ctrl_step_m"])
            if C is not None: add_arc(corner_nodes[r][i], corner_nodes[r + 1][i], C); seam_arcs += 1
    if cap and prm.get("cap_mode", "quad") == "quad":                                          # 29 October 2026 : the end of a tube is ONE quad patch bounded by its last ring (four equal arcs : the corners are at quarter arc lengths), not four triangles round a tip ; a triangle needs an even sum of counts, which the columns of the tube do not give
        doc.setdefault("component_seeds", []).append({"name": name, "p": [round(float(x), 6) for x in V[tip_vertex]]})
    elif cap:
        tip = add_node(V[tip_vertex]); last = len(rk) - 1
        for i in range(n):                                                                  # the cap : from each last ring corner to the tip
            tail = seam(i, rk[last], len(fine) - 1); Q = [np.array(doc["nodes"][corner_nodes[last][i]]["p"])] + tail[1:] + [V[tip_vertex]]; C = fit(Q, prm["ctrl_step_m"])
            if C is not None: add_arc(corner_nodes[last][i], tip, C)
        for i in range(n):                                                                  # 29 October 2026 : one seed per cap triangle, so that the cap takes the name and the edge scale of its tube (a cap of three arcs of one edge each cannot close : odd count)
            mid = (np.array(doc["nodes"][corner_nodes[last][i]]["p"]) + np.array(doc["nodes"][corner_nodes[last][(i + 1) % n]]["p"]) + V[tip_vertex]) / 3.0
