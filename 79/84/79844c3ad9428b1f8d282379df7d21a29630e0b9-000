    if ring_mm: prm["ring_step_m"] = ring_mm / 1000.0
    doc = {"version": 1, "date": "29 October 2026", "units": "m", "spline": {"degree": 3, "knots": "clamped uniform : n control points, n-3 spans, parameter u in [0, n-3]"}, "nodes": [], "arcs": [], "components": [], "component_seeds": [], "model_ref": os.path.abspath(obj), "mesh_unit": 0.1 if kind == "fingers" else 1.0}
    reports = []
    for bid, (k, name) in names.items():
