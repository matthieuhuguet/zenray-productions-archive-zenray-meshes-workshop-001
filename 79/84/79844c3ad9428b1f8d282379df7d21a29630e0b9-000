def classify(V, br, recs):
    """name the branches : fingers (short, far out to the side ; the digit nearest to the body is the thumb), arms, head, legs ; the trunk (branch 0) is the torso and is not a tube. Returns {branch id: (kind, name)}."""
    out = {}; count = collections.Counter(); digits = {"L": [], "R": []}
    for r in sorted(recs, key=lambda z: (V[z["tip"]][0] > 0, -V[z["tip"]][1])):
        x, y = V[r["tip"]][0], V[r["tip"]][1]; side = "L" if x < 0 else "R"
        if r["reach_m"] < 0.1:
            if abs(x) > 0.35 and y > 0.7: count["f" + side] += 1; out[r["id"]] = ("finger", "finger_%s_%d" % (side, count["f" + side])); digits[side].append((abs(x), r["id"]))
        elif abs(x) > 0.35 and y > 0.7: out[r["id"]] = ("limb", "arm_" + side)
        elif y > 1.5: out[r["id"]] = ("limb", "head")
        elif y < 0.3: out[r["id"]] = ("limb", "leg_" + side)
    for side, d in digits.items():
        if len(d) >= 4:
            thumb = min(d)[1]; out[thumb] = ("finger", "thumb_" + side)
            for n, (_, b) in enumerate(sorted((q for q in d if q[1] != thumb), key=lambda q: -V[[r for r in recs if r["id"] == q[1]][0]["tip"]][1]), 1): out[b] = ("finger", "finger_%s_%d" % (side, n))
    return out


def rename_tube(doc, old, new):
    """30 October 2026 : a tube, its component options, its seeds and the pair names of its arcs take another name (the foot is cut from the leg : the toe segment becomes `foot_<side>_1`)."""
    for suffix in ("", "_joint"):
        o, n = old + suffix, new + suffix
        if o in doc.get("component_options", {}): doc["component_options"][n] = doc["component_options"].pop(o)
        for q in doc.get("component_seeds", []):
            if q["name"] == o: q["name"] = n
    if old in doc.get("tube_rings", {}): doc["tube_rings"][new] = doc["tube_rings"].pop(old)
    for a in doc["arcs"]:
        if a["pair"][0] in (old, old + "_joint"): a["pair"] = [a["pair"][0].replace(old, new, 1)] * 2


def link_mirrors(doc, tol=0.006):
    """link the curves that are images of each other through x -> -x : their sampled points agree within tol both ways. Sets arc["mirror"] on both."""
    from scipy.spatial import cKDTree
    arcs = doc["arcs"]; samp = [SP.sample(np.array(a["ctrl"]), 12) for a in arcs]; mir = lambda S_: S_ * np.array([-1.0, 1.0, 1.0]); n = 0
    trees = [cKDTree(x) for x in samp]
    for i, a in enumerate(arcs):
