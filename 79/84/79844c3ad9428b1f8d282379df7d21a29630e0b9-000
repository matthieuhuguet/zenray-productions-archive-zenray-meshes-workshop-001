            if len(later) and later.min() < prm["bump_keep"] * after.max() and later.min() < 1.15 * G[k]: continue                                         # the girth falls back to where it was : a bump
            return k, "jump"
    return len(lv) - 1, "end"


def tip_tubes(V, T, tip, name, prm, doc, cap=True, max_segments=4):
    """the tubes of a tip, measured FROM the tip as ZenRay UV does (neck_candidates_band) : the distance g from the tip, the girth of the loop of g = c at each level, a tube ends at the last
    girth before a lasting jump (the shoulder, the hip, the elbow bulge of a forearm) and the next tube starts there, sharing the ring. A tube without cap (an arm from its palm) starts at
    the first level that is one loop again beyond the fingers. Returns the reports."""
