def scan(g, G, lv, k0, prm):
    """from level index k0 find where the tube ends : the last girth before a lasting jump of the girth, or the end of the single loops. Returns (end index, why) ; why is 'jump' (more tubes may follow), 'loops' (the surface splits) or 'end'."""
    ok = ~np.isnan(G); step = prm["fine_step_m"]
    for k in range(k0 + max(3, int(round(2 * prm["ring_step_m"] / step))), len(lv) - 1):                          # a tube has at least two ring steps
        if not ok[k]: return max(k - 1, k0), "loops"
        rho = max(G[k] / (2 * np.pi), 0.02); ma = max(2, int(round(prm["jump_window"] * rho / step))); mb = max(2, int(round(2 * rho / step)))
        after = G[k + 1:k + 1 + ma]; after = after[~np.isnan(after)]; before = G[max(k0, k - mb):k]; before = before[~np.isnan(before)]
        if len(after) and after.max() >= prm["neck_jump"] * G[k] and (len(before) == 0 or before.max() - before.min() <= prm["jump_before_tol"] * G[k]):   # the last girth before a jump : the base of the tube
