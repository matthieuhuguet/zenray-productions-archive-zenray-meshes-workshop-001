            d = max(trees[j].query(M)[0].max(), tm.query(samp[j])[0].max())
            if d < tol and (best is None or d < best[0]): best = (d, j)
        if best: a["mirror"] = best[1]; arcs[best[1]]["mirror"] = i; n += 1
    return n


def limbs_from_tips(obj, out=None):
    """head, legs and arms of a mannequin, each measured from its own tip. Tips : the top of the head, the two toes, and for each hand the vertex nearest to the mean of its finger saddles."""
    prm = dict(PARAMS); prm.update(ring_step_m=0.04, fine_step_m=0.004, cap_m=0.02, base_margin_m=0.01, edge_scale=1.0, ctrl_step_m=0.04, planar_for=(("arm",) if PARAMS.get("planar_arms") else ()))      # 29 October 2026 : an arm ring is the cross section perpendicular to its axis (the level set of the distance from the hand has a lobe on the torso near the armpit)
    V, T = TB.load_welded(obj); root = int(np.argmin(np.linalg.norm(V - V.mean(0), axis=1))); phi = TB.heat_distance(V, T, root); br, recs, top = TB.branches(V, T, phi, TB.PARAMS["persistence_m"]); names = classify(V, br, recs)
    near = lambda p: int(np.argmin(np.linalg.norm(V - np.asarray(p), axis=1)))
    fingers = collections.defaultdict(list)
    for r in recs:
        if r["id"] in names and names[r["id"]][0] == "finger": fingers[names[r["id"]][1].split("_")[1]].append(V[r["saddle"]])
    right_foot = [V[r["tip"]] for r in recs if r["id"] in names and names[r["id"]][1] == "leg_R"]; rf = right_foot[0] if right_foot else V[top] * np.array([-1.0, 1.0, 1.0])
    tips = {"head": (int(np.argmax(V[:, 1])), True), "leg_R": (near(rf), True), "leg_L": (near(rf * np.array([-1.0, 1.0, 1.0])), True)}
    for side, pts in fingers.items(): tips["arm_" + side] = (near(np.mean(pts, axis=0)), False)
    doc = {"version": 1, "date": "29 October 2026", "units": "m", "spline": {"degree": 3, "knots": "clamped uniform : n control points, n-3 spans, parameter u in [0, n-3]"}, "nodes": [], "arcs": [], "components": [], "component_seeds": [], "model_ref": os.path.abspath(obj), "mesh_unit": 1.0}
    segs = prm["segments"]; reports = [r for name, (t, cap) in tips.items() for r in tip_tubes(V, T, t, name, prm, doc, cap, max_segments=segs.get(name.split("_")[0], 1))]
    for side in ("L", "R"):                                                                # 30 October 2026 : a leg cut in two segments : the first (toe to ankle) is the foot, the second is the leg
        if "leg_%s_2" % side in doc.get("tube_rings", {}):
            rename_tube(doc, "leg_%s_1" % side, "foot_%s_1" % side); rename_tube(doc, "leg_%s_2" % side, "leg_%s_1" % side)
    doc["mirrored_pairs"] = link_mirrors(doc, prm["mirror_m"])
    if out: json.dump(doc, open(out, "w"))
    return doc, reports


def network(obj, kind, ring_mm=None, out=None):
    prm = dict(PARAMS); V, T = TB.load_welded(obj); root = int(np.argmin(np.linalg.norm(V - V.mean(0), axis=1))); phi = TB.heat_distance(V, T, root)
    br, recs, _ = TB.branches(V, T, phi, TB.PARAMS["persistence_m"]); names = classify(V, br, recs); by_id = {r["id"]: r for r in recs}
