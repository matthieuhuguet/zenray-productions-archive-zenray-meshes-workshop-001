#!/usr/bin/env python3
# 10 November 2026: chart 11, the 160 methods of the registry by stage and by engine, coloured by status (grey levels, hatch = dropped).
import json, sys, collections, subprocess
A = '/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026'; sys.path.insert(0, A + '/scripts'); import chartlib as C
M = json.load(open(A + '/agents/methods.json'))['methods']
FOLD = {'validé par Matthieu': 'valide', 'gouverne': 'gouverne', 'écarté': 'ecarte', 'remplacé': 'ecarte', 'deprecated': 'ecarte', 'inconnu': 'inconnu'}
C.CATS = [('valide', 'Validé par Matthieu', '#1f1f1e', None), ('gouverne', 'Encore en vigueur, sans ta validation', '#6f6e69', None), ('ecarte', 'Écarté, remplacé ou déprécié', '#f0efea', 45), ('inconnu', 'Verdict coupé dans la source', '#dcdbd5', None)]
def rows(field, order=None):
    c = collections.defaultdict(collections.Counter)
    for m in M: c[m.get(field) or 'inconnu'][FOLD.get(m.get('status'), 'inconnu')] += 1
    keys = order or sorted(c, key=lambda k: -sum(c[k].values()))
    return [(k, dict(c[k])) for k in keys if k in c]
r1 = rows('stage'); r2 = rows('engine')
s1 = C.hbar_stacked('Le registre des méthodes, étape par étape', '%d méthodes distinctes relevées dans les références du skill (25 October au 10 November 2026), par étape et par statut.' % len(M), r1,
                    note='Source : agent Haiku sur un résumé de 1 439 lignes ; 74 verdicts sont dans des lignes coupées, d’où la part grise claire.')
s2 = C.hbar_stacked('Le registre des méthodes, moteur par moteur', 'Les mêmes méthodes, selon ce qui les exécute : Python maison, Houdini, les deux, ou une IA générative.', r2)
for n, s in (('11_methodes_par_etape', s1), ('12_methodes_par_moteur', s2)):
    open('%s/charts/%s.svg' % (A, n), 'w', encoding='utf-8').write(s); subprocess.run(['rsvg-convert', '-z', '1.6', '-o', '%s/charts/%s.png' % (A, n), '%s/charts/%s.svg' % (A, n)], check=True)
print(r1); print(r2)
