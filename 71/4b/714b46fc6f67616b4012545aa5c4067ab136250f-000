/* 29 October 2026 : ZenRay Lines styles. Tokens first (one place to restyle), layout second. Fonts are stacks only, nothing is embedded. */
:root {
  --bg: #efeee9;
  --panel: #fbfaf6;
  --panel-2: #ffffff;
  --ink: #1c1c20;
  --ink-2: #5c5c64;
  --line: #d8d5cc;
  --accent: #e8590c;
  --accent-ink: #ffffff;
  --ok: #0b8f6a;
  --warn: #b7791f;
  --err: #c92a2a;
  --stage: #ffffff;
  --font-title: 'GT Ultra', 'GT Ultra Regular', system-ui, -apple-system, 'Segoe UI', sans-serif;   /* titles, numbers, controls */
  --font-body: 'Literata', Georgia, 'Times New Roman', serif;                    /* running text */
  --radius: 8px;
  --pad: 12px;
  --left-w: 188px;
  --right-w: 372px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #151517; --panel: #1d1d20; --panel-2: #26262a; --ink: #ececf0; --ink-2: #a2a2ab; --line: #35353b;
  }
}
:root[data-theme="dark"] {
  --bg: #151517; --panel: #1d1d20; --panel-2: #26262a; --ink: #ececf0; --ink-2: #a2a2ab; --line: #35353b;
}

* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body { background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 14px; line-height: 1.45; }
h1, h2, button, input, .kv, .num, .len, .coords, kbd, .chip, .count, #status, label.slider span { font-family: var(--font-title); }

/* layout : left tools, centre stage, right network panel */
#app { display: grid; grid-template-columns: var(--left-w) minmax(0, 1fr) var(--right-w); grid-template-rows: minmax(0, 1fr); height: 100vh; }
#left, #right { background: var(--panel); overflow-y: auto; padding: var(--pad); min-height: 0; }
#left { border-right: 1px solid var(--line); }
#right { border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px; }
#center { display: flex; flex-direction: column; min-width: 0; min-height: 0; }

#stage { position: relative; flex: 1 1 auto; min-height: 0; background: var(--stage); overflow: hidden; cursor: default; }
#svg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; user-select: none; -webkit-user-select: none; touch-action: none; }
#stage.space { cursor: grab; }
#stage.over-arc { cursor: pointer; }
#stage.hot { cursor: move; }
#stage.mode-add { cursor: crosshair; }
#stage.panning { cursor: grabbing; }

#statusBar { padding: 7px var(--pad); border-top: 1px solid var(--line); background: var(--panel); min-height: 34px; display: flex; align-items: center; color: var(--ink-2); font-size: 13px; }
#status.error { color: var(--err); }
#status.warn { color: var(--warn); }
#status.ok { color: var(--ok); }

/* blocks */
.brand h1 { font-size: 20px; font-weight: 400; margin: 0 0 4px; }
.tagline { margin: 0 0 14px; color: var(--ink-2); font-size: 12.5px; }
.block { margin-bottom: 16px; }
#right .block { margin-bottom: 0; }
.block h2 { font-size: 11px; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 6px; }
.hint { margin: 6px 0 0; color: var(--ink-2); font-size: 12.5px; }
.count { color: var(--ink-2); text-transform: none; letter-spacing: 0; margin-left: 6px; }
.kv { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 2px 0; font-size: 13px; }
.kv span { color: var(--ink-2); }
.kv b { font-weight: 400; text-align: right; }
.coords { font-size: 13px; min-height: 20px; word-spacing: 0.4em; }
.help ul { list-style: none; margin: 0; padding: 0; font-size: 12.5px; color: var(--ink-2); }
.help li { margin: 0 0 5px; }
kbd { display: inline-block; border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; font-size: 11px; background: var(--panel-2); color: var(--ink); }

/* controls */
.stack { display: flex; flex-direction: column; gap: 6px; }
.buttons { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.btn { appearance: none; -webkit-appearance: none; border: 1px solid var(--line); background: var(--panel-2); color: var(--ink); border-radius: var(--radius); padding: 7px 11px; font-size: 13px; cursor: pointer; }
.btn.wide { width: 100%; }
.btn:hover:not(:disabled) { border-color: var(--accent); }
.btn:disabled { opacity: 0.45; cursor: default; }
.btn.on, .btn.view.on, .btn.primary { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
.btn.view { display: flex; justify-content: space-between; align-items: center; width: 100%; }
.btn.view.on kbd { color: var(--ink); }
.checks { display: grid; grid-template-columns: 1fr 1fr; gap: 0 10px; margin-bottom: 4px; }
.hover { min-height: 20px; }
.check { display: flex; align-items: center; gap: 8px; padding: 3px 0; font-size: 13px; cursor: pointer; }
.slider { display: grid; grid-template-columns: 112px 1fr; align-items: center; gap: 8px; padding: 3px 0; font-size: 13px; color: var(--ink-2); }
.slider input { width: 100%; }
input[type="search"] { width: 100%; padding: 7px 10px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel-2); color: var(--ink); font-size: 13px; }

/* components and arcs */
.chips { display: flex; flex-wrap: wrap; gap: 4px; max-height: 128px; overflow-y: auto; }
.chip { border: 1px solid var(--line); background: var(--panel-2); color: var(--ink); border-radius: 999px; padding: 2px 8px; font-size: 11.5px; cursor: pointer; }
.chip:hover { border-color: var(--ok); }
.chip.on { background: var(--ok); border-color: var(--ok); color: #ffffff; }
.block.grow { flex: 1 1 200px; min-height: 170px; display: flex; flex-direction: column; }
.list { flex: 1 1 auto; min-height: 0; overflow-y: auto; margin-top: 6px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel-2); }
.row { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 6px; padding: 4px 8px; border-bottom: 1px solid var(--line); cursor: pointer; font-size: 12.5px; }
.row:last-child { border-bottom: 0; }
.row:hover { background: rgba(232, 89, 12, 0.1); }
.row.sel { background: var(--accent); color: var(--accent-ink); }
.row .names { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row .len { color: inherit; opacity: 0.8; }
.info { font-size: 13px; }

@media (max-width: 980px) {
  #app { grid-template-columns: 1fr; grid-template-rows: auto 70vh auto; height: auto; }
  #left, #right { overflow-y: visible; }
}
