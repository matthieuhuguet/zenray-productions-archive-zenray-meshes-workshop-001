"""4 November 2026 : which part owns the wrong pixels : each wrong pixel (missing or too much) of every view is given to the nearest tube of the model, seen through the same camera. The ranking says where the next hour goes. FR : à quelle pièce appartiennent les pixels faux : chaque pixel faux de chaque vue est donné au tube le plus proche du modèle, vu par la même caméra. Le classement dit où va l'heure suivante.
    python -I ErrorByPart.py <mesh.obj> <fit.json> <frames> <cams comp.json> f1,f2,..."""
import sys, os, json
import numpy as np
from PIL import Image
from scipy.spatial import cKDTree
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE); sys.path.insert(0, os.path.dirname(HERE))
from CompFit import Ren, cam_matrix, viewport, part_mask, CF
from DragonShape import tube_mesh
mesh, fit, frames, camf, names = sys.argv[1:6]; names = names.split(","); C = json.load(open(camf)); V = []; F = []
for l in open(mesh):
    if l.startswith("v "): V.append([float(x) for x in l.split()[1:4]])
    elif l.startswith("f "):
        i = [int(q.split("/")[0]) - 1 for q in l.split()[1:]]; F += [(i[0], i[k], i[k + 1]) for k in range(1, len(i) - 1)]
ren = Ren(np.array(V), np.array(F, np.int32)); P = []; L = []
for t in json.load(open(fit))["tubes"]:
    if t.get("kind") == "obj": W = np.array([[float(x) for x in l.split()[1:4]] for l in open(t["file"]) if l.startswith("v ")]) * t.get("xform", [0, 0, 0, 1])[3] + np.array(t.get("xform", [0, 0, 0, 1])[:3]); W = W[::6]; lab = "head"
    else:
        W, _ = tube_mesh(t); lab = t["name"].split("_")[0] if t["name"].startswith("plate") else t["name"]
        if t.get("mirror"): W = np.vstack([W, W * np.array([-1, 1, 1], np.float32)])
    P.append(np.asarray(W, float)); L += [lab] * len(W)
P = np.vstack(P); L = np.array(L); tot = {}
for nm in names:
    im = np.asarray(Image.open(f"{frames}/f_{int(nm):05d}.jpg").convert("RGB")); rect = viewport(im.max(2).astype(np.float32)); m = part_mask(im, rect, "grey"); h, w = m.shape; mm = ren.mask(C[nm], w, h); R, t, fp = cam_matrix(C[nm], w, h, CF["fov"]); q = P @ R.T + t; uv = np.c_[w / 2 + fp * q[:, 0] / q[:, 2], h / 2 - fp * q[:, 1] / q[:, 2]]; T = cKDTree(uv)
    for kind, wrong in (("missing", m & ~mm), ("extra", mm & ~m)):
        ys, xs = np.nonzero(wrong)
        if len(xs) == 0: continue
        d, j = T.query(np.c_[xs, ys]); lab = np.where(d < 10, L[j], "unmodelled")
        for lb in np.unique(lab): tot[(lb, kind)] = tot.get((lb, kind), 0) + int((lab == lb).sum())
allw = sum(tot.values()); rows = sorted({k[0] for k in tot}, key=lambda a: -(tot.get((a, "missing"), 0) + tot.get((a, "extra"), 0)))
print("wrong pixels", allw, "over", len(names), "views")
for a in rows[:16]: print(f"  {a:12s} missing {tot.get((a, 'missing'), 0):6d} extra {tot.get((a, 'extra'), 0):6d}  share {100 * (tot.get((a, 'missing'), 0) + tot.get((a, 'extra'), 0)) / allw:5.1f} %")
