# 27 October 2026 13:44 Paris: export the edited native guide panels and their exact mirror instances for the assembly.
import hou,json,numpy as np
config=json.load(open(globals()['CONFIG']));points=[];faces=[];names=[]
for panel in config['panels']:
    node=hou.node(panel['sop'])
    if node is None:raise ValueError('Missing guide panel: '+panel['sop'])
    node.cook(force=True);geo=node.geometry()
    if node.errors():raise ValueError(str(node.errors()))
    p=np.array(geo.pointFloatAttribValues('P')).reshape(-1,3)
    q=[[v.point().number() for v in f.vertices()] for f in geo.prims() if f.type()==hou.primType.Polygon]
    if not q:raise ValueError('Empty guide panel: '+panel['sop'])
    for part,mirror in [(panel['part'],False)]+([(panel['mirror_part'],True)] if panel.get('mirror_part') else []):
        offset=sum(len(x) for x in points);current=p.copy()
        if mirror:current[:,0]*=-1
        points.append(current);faces.extend([[i+offset for i in (f[::-1] if mirror else f)] for f in q]);names.extend([part]*len(q))
np.savez(globals()['OUT'],P=np.vstack(points),Q=np.array(faces,np.int32),names=np.array(names))
result={'parts':sorted(set(names)),'faces':len(faces)}
