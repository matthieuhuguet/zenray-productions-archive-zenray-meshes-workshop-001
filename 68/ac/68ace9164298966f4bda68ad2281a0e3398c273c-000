"""29 October 2026 : ZenRay Lines TUTTE FILL, the interior of a four sided patch placed by a bijective map onto the unit square, so it cannot fold.
EN: Coons interpolation folds when a patch side bends inward (a reflex point that is not a corner, an apex in the middle of a side). Here the
patch domain, seen from one view (the front for a torso), is triangulated finely (boundary every lattice_mm, a lattice inside), mapped onto the
unit square by a Tutte embedding (uniform weights, boundary fixed : each border vertex of the grid at k/m, the points between them linearly), which
is one to one because the square is convex. Every interior grid node (i/m, j/n) is then found in that map, carried back to the view plane by its
barycentric coordinates and lifted onto the skin by `lift(x, y)`. The border vertices (shared with the neighbours) never move.
    import ZrlTutteFill as TF ; P2 = TF.refill(P, Q, res, lift)      grids from ZrlNetMesh.build's result (four sided faces only)
FR : l'intérieur d'un patch placé par une carte bijective vers le carré unité (plongement de Tutte) : un bord qui rentre ne peut plus plier les quads.
"""
import numpy as np
import scipy.sparse as sps
from scipy.sparse.linalg import spsolve
from scipy.spatial import Delaunay
from skimage.measure import points_in_poly

PARAMS = {"lattice_mm": 2.0, "keep_off_border": 0.9}   # 29 October 2026 : lattice step of the triangulation, interior points kept this many steps from the border


def face_grids(res):
    """(face, G) for every meshed four sided face of a ZrlNetMesh.build result : G[i, j] the vertex of grid node i (0..m), j (0..n)."""
    Q = np.array(res["Q"], int).reshape(-1, 4); foq = np.array(res["face_of_quad"], int); out = []
    for f in res["faces"]:
        e = f.get("side_counts") or []
        if not f.get("quads") or len(e) != 4: continue
        m, n = int(e[0]), int(e[3]); qs = np.flatnonzero(foq == f["id"])
        if len(qs) != m * n or not np.array_equal(qs, np.arange(qs[0], qs[0] + m * n)): continue
        G = np.zeros((m + 1, n + 1), int); q0 = qs[0]
        for i in range(m):
            for j in range(n):
                a, b, c, d = Q[q0 + i * n + j]; G[i, j], G[i + 1, j], G[i + 1, j + 1], G[i, j + 1] = a, b, c, d
        out.append((f, G))
    return out


def tutte_nodes(P2, G, prm=PARAMS):
    """view plane positions of the interior grid nodes of G (P2 : (N, 2) view plane positions of all vertices)."""
    m, n = G.shape[0] - 1, G.shape[1] - 1; h = prm["lattice_mm"] / 1000.0
    loop = [(G[i, 0], (i / m, 0.0)) for i in range(m)] + [(G[m, j], (1.0, j / n)) for j in range(n)] + \
           [(G[i, n], (i / m, 1.0)) for i in range(m, 0, -1)] + [(G[0, j], (0.0, j / n)) for j in range(n, 0, -1)]
    B, U = [], []
    for k in range(len(loop)):
        (va, ua), (vb, ub) = loop[k], loop[(k + 1) % len(loop)]; s = max(1, int(np.ceil(np.linalg.norm(P2[vb] - P2[va]) / h)))
        for t in np.arange(s) / s: B.append(P2[va] * (1 - t) + P2[vb] * t); U.append(np.array(ua) * (1 - t) + np.array(ub) * t)
    B, U = np.array(B), np.array(U); nb = len(B)
    lo, hi = B.min(0), B.max(0); xs = np.arange(np.floor(lo[0] / h) * h, hi[0] + h, h); ys = np.arange(np.floor(lo[1] / h) * h, hi[1] + h, h)
    L = np.stack(np.meshgrid(xs, ys), -1).reshape(-1, 2); L = L[points_in_poly(L, B)]
    if len(L):
        from scipy.spatial import cKDTree
        d, _ = cKDTree(B).query(L); L = L[d > prm["keep_off_border"] * h]
    X = np.vstack([B, L]); T = Delaunay(X).simplices; T = T[points_in_poly(X[T].mean(1), B)]
    used = np.unique(T); keep = np.union1d(np.arange(nb), used); remap = -np.ones(len(X), int); remap[keep] = np.arange(len(keep))   # a lattice point no kept triangle uses would make the system singular
    X = X[keep]; T = remap[T]
    E = np.concatenate([T[:, [0, 1]], T[:, [1, 2]], T[:, [2, 0]]]); E = np.unique(np.sort(E, 1), axis=0); N = len(X)
    W = sps.coo_matrix((np.ones(2 * len(E)), (np.r_[E[:, 0], E[:, 1]], np.r_[E[:, 1], E[:, 0]])), shape=(N, N)).tocsr()
    Lap = (sps.diags(np.asarray(W.sum(1)).ravel()) - W).tocsr(); free = np.arange(nb, N); UV = np.zeros((N, 2)); UV[:nb] = U
    if len(free): UV[free] = spsolve(Lap[free][:, free].tocsc(), -(Lap[free][:, :nb] @ U)).reshape(-1, 2)
    A, Bv, C = UV[T[:, 0]], UV[T[:, 1]], UV[T[:, 2]]; den = (Bv[:, 1] - C[:, 1]) * (A[:, 0] - C[:, 0]) + (C[:, 0] - Bv[:, 0]) * (A[:, 1] - C[:, 1])
    out = {}
    for i in range(1, m):
        for j in range(1, n):
            p = np.array([i / m, j / n]); l1 = ((Bv[:, 1] - C[:, 1]) * (p[0] - C[:, 0]) + (C[:, 0] - Bv[:, 0]) * (p[1] - C[:, 1])) / den
            l2 = ((C[:, 1] - A[:, 1]) * (p[0] - C[:, 0]) + (A[:, 0] - C[:, 0]) * (p[1] - C[:, 1])) / den; l3 = 1 - l1 - l2
            b = np.where(np.abs(den) > 1e-14, np.minimum(np.minimum(l1, l2), l3), -np.inf); k = int(np.argmax(np.nan_to_num(b, nan=-np.inf)))   # the containing triangle (or the nearest one at the border)
            out[(i, j)] = l1[k] * X[T[k, 0]] + l2[k] * X[T[k, 1]] + l3[k] * X[T[k, 2]]
    return out


def refill(P, res, lift, faces=None, prm=PARAMS):
    """new vertex positions : the interior nodes of every listed face (all four sided faces when None) placed by tutte_nodes, lifted by lift(x, y)."""
    P = np.array(P, float).reshape(-1, 3).copy(); done = []
    for f, G in face_grids(res):
        if faces is not None and f.get("component") not in faces: continue
        for (i, j), xy in tutte_nodes(P[:, :2], G, prm).items(): P[G[i, j]] = lift(float(xy[0]), float(xy[1]))
        done.append(f.get("component"))
    return P, done


def quad_jacobians(P, Q, normals):
    """minimum scaled Jacobian of every quad against the given per quad normals (negative = folded)."""
    X = P[Q]; J = np.full(len(Q), np.inf)
    for j in range(4):
        e1 = X[:, (j + 1) % 4] - X[:, j]; e2 = X[:, (j - 1) % 4] - X[:, j]
        J = np.minimum(J, (np.cross(e1, e2) * normals).sum(1) / np.maximum(np.linalg.norm(e1, axis=1) * np.linalg.norm(e2, axis=1), 1e-12))
    return J
