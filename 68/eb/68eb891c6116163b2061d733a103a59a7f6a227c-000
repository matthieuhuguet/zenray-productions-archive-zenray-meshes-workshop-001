# 25 October 2026 : ZenRay Meshes, component validation board : numbered markers of the component sheet drawn on the
# six view sheet, read from a JSON of (number, x, y) per marker so the placement is editable without touching code.
# FR : planche de validation des composants, positions dans un JSON modifiable.
# 25 October 2026 : a LEGEND column (number, Maya-like name, French name) is added on the right, read from components.json.
# Usage: python ComponentBoard.py <sheet.png> <markers.json> <out.png> [scale=2] [components.json]
import sys, json
from PIL import Image, ImageDraw, ImageFont
P = {"legend_w": 430, "legend_font": "/Users/zenray/Library/Fonts/InterVariable.ttf", "legend_px": 12, "legend_bg": (245, 244, 240), "legend_ink": (40, 40, 40), "radius": 11, "fill": (204, 124, 94), "text": (255, 255, 255), "font": "/Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf", "font_px": 13}


def main(sheet, markers, out, scale="2", components=None):
    s = int(scale); src = Image.open(sheet).convert("RGB"); src = src.resize((src.width * s, src.height * s), Image.LANCZOS)
    lw = P["legend_w"] * s if components else 0
    img = Image.new("RGB", (src.width + lw, src.height), P["legend_bg"]); img.paste(src, (0, 0))
    d = ImageDraw.Draw(img); f = ImageFont.truetype(P["font"], P["font_px"] * s); r = P["radius"] * s
    for m in json.load(open(markers))["markers"]:
        x, y = m["x"] * s, m["y"] * s
        d.ellipse((x - r, y - r, x + r, y + r), fill=P["fill"], outline=(255, 255, 255), width=s)
        d.text((x, y), str(m["n"]), font=f, fill=P["text"], anchor="mm")
    if components:
        comp = json.load(open(components))["components"]; fl = ImageFont.truetype(P["legend_font"], P["legend_px"] * s)
        n = len(comp); row = (src.height - 40 * s) / n; x0 = src.width + 16 * s
        for i, (k, name) in enumerate(sorted(comp.items(), key=lambda kv: int(kv[0]))):
            y = 20 * s + (i + 0.5) * row
            d.ellipse((x0, y - r * 0.8, x0 + 1.6 * r, y + r * 0.8), fill=P["fill"])
            d.text((x0 + 0.8 * r, y), k, font=f, fill=P["text"], anchor="mm")
            d.text((x0 + 2.2 * r, y), name, font=fl, fill=P["legend_ink"], anchor="lm")
    img.save(out)


if __name__ == "__main__":
    main(*sys.argv[1:])
