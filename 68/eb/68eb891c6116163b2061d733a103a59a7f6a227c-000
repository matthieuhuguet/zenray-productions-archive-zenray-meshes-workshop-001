# 25 October 2026 : ZenRay Meshes, component validation board : numbered markers of the component sheet drawn on the
# six view sheet, read from a JSON of (number, x, y) per marker so the placement is editable without touching code.
# FR : planche de validation des composants, positions dans un JSON modifiable.
# Usage: python ComponentBoard.py <sheet.png> <markers.json> <out.png> [scale=2]
import sys, json
from PIL import Image, ImageDraw, ImageFont
P = {"radius": 11, "fill": (204, 124, 94), "text": (255, 255, 255), "font": "/Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf", "font_px": 13}


def main(sheet, markers, out, scale="2"):
    s = int(scale); img = Image.open(sheet).convert("RGB"); img = img.resize((img.width * s, img.height * s), Image.LANCZOS)
    d = ImageDraw.Draw(img); f = ImageFont.truetype(P["font"], P["font_px"] * s); r = P["radius"] * s
    for m in json.load(open(markers))["markers"]:
        x, y = m["x"] * s, m["y"] * s
        d.ellipse((x - r, y - r, x + r, y + r), fill=P["fill"], outline=(255, 255, 255), width=s)
        d.text((x, y), str(m["n"]), font=f, fill=P["text"], anchor="mm")
    img.save(out)


if __name__ == "__main__":
    main(*sys.argv[1:])
