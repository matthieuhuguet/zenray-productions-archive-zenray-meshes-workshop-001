"""2 November 2026 : a crop of a frame with a labelled pixel grid, in the pixels of the viewport, so a feature can be read to one pixel and handed to Tri.py. FR : un recadrage d'une image avec une grille de pixels légendée, dans les pixels du viewport, pour lire un détail au pixel près et le donner à Tri.py.
    python -I PixelGrid.py <frames> <frame> <out.png> x0,y0,x1,y1 [zoom] [step]"""
import sys, os
import numpy as np
from PIL import Image, ImageDraw
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); from CompFit import viewport
frames, fr, out = sys.argv[1], sys.argv[2], sys.argv[3]; x0, y0, x1, y1 = [int(q) for q in sys.argv[4].split(",")]; zoom = int(sys.argv[5]) if len(sys.argv) > 5 else 6; step = int(sys.argv[6]) if len(sys.argv) > 6 else 10
im = Image.open(f"{frames}/f_{int(fr):05d}.jpg").convert("RGB"); r = viewport(np.asarray(im).max(2).astype(np.float32)); v = im.crop(r).crop((x0, y0, x1, y1)); v = v.resize((v.size[0] * zoom, v.size[1] * zoom), Image.LANCZOS); d = ImageDraw.Draw(v)
for x in range(x0 - x0 % step + step, x1, step):
    big = x % (step * 5) == 0; d.line([((x - x0) * zoom, 0), ((x - x0) * zoom, v.size[1])], fill=(255, 220, 0) if big else (120, 105, 0), width=1)
    if big: d.text(((x - x0) * zoom + 2, 1), str(x), fill=(255, 255, 0))
for y in range(y0 - y0 % step + step, y1, step):
    big = y % (step * 5) == 0; d.line([(0, (y - y0) * zoom), (v.size[0], (y - y0) * zoom)], fill=(0, 220, 255) if big else (0, 105, 120), width=1)
    if big: d.text((2, (y - y0) * zoom + 1), str(y), fill=(0, 255, 255))
v.save(out); print(out, v.size)
