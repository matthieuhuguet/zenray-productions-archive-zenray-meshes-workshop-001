"""Vérificateurs de finition hard surface (Q7), numpy + scipy seulement, déterministes, sortie JSON et code de sortie.
Chaque vérificateur renvoie {value, threshold, pass, unit}. Un maillage est (V (n,3) mètres, T (m,3) triangles).
Les seuils sont des réglages de départ, mesurés sur la voiture facettée de vérité connue (vert) et sur des cas cassés (rouge). 30 October 2026."""
import numpy as np, collections
from scipy.spatial import cKDTree

def tri_geom(V, T):
    a, b, c = V[T[:, 0]], V[T[:, 1]], V[T[:, 2]]
    n = np.cross(b - a, c - a); A = 0.5 * np.linalg.norm(n, axis=1)
    nn = np.linalg.norm(n, axis=1); nn[nn == 0] = 1
    return n / nn[:, None], A, (a + b + c) / 3

def edges_of(T):
    e = np.concatenate([T[:, [0, 1]], T[:, [1, 2]], T[:, [2, 0]]]); f = np.tile(np.arange(len(T)), 3)
    key = np.sort(e, axis=1)
    return key, f

def closure(V, T):
    key, f = edges_of(T)
    u, inv, cnt = np.unique(key, axis=0, return_inverse=True, return_counts=True)
    open_e = int((cnt == 1).sum()); nonman = int((cnt > 2).sum())
    return {"open_edges": open_e, "non_manifold_edges": nonman, "pass": bool(open_e == 0 and nonman == 0)}

def dihedrals(V, T):
    """Angle entre normales de triangles voisins, par arête intérieure. Retourne (arêtes (k,2), angle deg (k,), longueur (k,), faces (k,2))."""
    N, A, C = tri_geom(V, T)
    key, f = edges_of(T)
    order = np.lexsort((key[:, 1], key[:, 0]))
    ks = key[order]; fs = f[order]
    same = np.all(ks[1:] == ks[:-1], axis=1)
    i = np.where(same)[0]
    e = ks[i]; f1 = fs[i]; f2 = fs[i + 1]
    ang = np.degrees(np.arccos(np.clip((N[f1] * N[f2]).sum(1), -1, 1)))
    L = np.linalg.norm(V[e[:, 0]] - V[e[:, 1]], axis=1)
    return e, ang, L, np.c_[f1, f2]

def local_planarity(V, T, r=0.10, tol_mm=0.5, n_samples=6000, ndot=0.9, seed=1, mask_faces=None):
    """Part de l'aire dont le voisinage de rayon r (même orientation) s'ajuste à un plan à moins de tol_mm (RMS). Sous-échantillonnage déterministe."""
    N, A, C = tri_geom(V, T)
    if mask_faces is not None:
        keep = np.where(mask_faces)[0]
    else: keep = np.arange(len(T))
    rng = np.random.default_rng(seed)
    p = A[keep] / A[keep].sum()
    pick = rng.choice(keep, size=min(n_samples, len(keep)), replace=False, p=p) if len(keep) > n_samples else keep
    tr = cKDTree(C)
    rms = np.full(len(pick), np.nan)
    for j, fi in enumerate(pick):
        nb = np.array(tr.query_ball_point(C[fi], r))
        nb = nb[(N[nb] @ N[fi]) > ndot]
        if len(nb) < 8: continue
        P = C[nb]; w = A[nb]
        cen = (P * w[:, None]).sum(0) / w.sum()
        Mx = ((P - cen) * np.sqrt(w)[:, None]); u, s, vt = np.linalg.svd(Mx, full_matrices=False)
        d = (P - cen) @ vt[2]
        # étendue 2D suffisante (pas une bande)
        if s[1] / np.sqrt(w.sum()) < 0.25 * r * 0.5: continue
        rms[j] = np.sqrt((w * d ** 2).sum() / w.sum())
    ok = np.isfinite(rms)
    frac = float((rms[ok] < tol_mm / 1000).mean()) if ok.any() else float("nan")
    return {"planar_fraction": frac, "rms_median_mm": float(np.nanmedian(rms) * 1000) if ok.any() else None, "rms_p90_mm": float(np.nanpercentile(rms, 90) * 1000) if ok.any() else None,
            "samples_valid": int(ok.sum()), "tol_mm": tol_mm, "radius_m": r, "pass": bool(frac >= 0.95) if ok.any() else False}


def facet_planarity(V, T, edge_tol_deg=3.0, tol_mm=0.5, min_area=0.0005):
    """Régions de faces voisines dont le dièdre est < edge_tol_deg (union-find), puis RMS de chaque région à son plan moyen. Une surface lisse ou ondulée
    fusionne en une grande région courbe donc non plane ; un polyèdre rend exactement ses facettes. Retourne la part d'aire en régions planes à tol_mm."""
    N, A, C = tri_geom(V, T)
    e, ang, L, ff = dihedrals(V, T)
    parent = np.arange(len(T))
    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]; x = parent[x]
        return x
    for (f1, f2), a in zip(ff, ang):
        if a < edge_tol_deg:
            r1, r2 = find(int(f1)), find(int(f2))
            if r1 != r2: parent[r1] = r2
    roots = np.array([find(i) for i in range(len(T))])
    ur, inv = np.unique(roots, return_inverse=True)
    rms = np.zeros(len(ur)); area = np.zeros(len(ur))
    for k in range(len(ur)):
        fi = np.where(inv == k)[0]
        vs = np.unique(T[fi].ravel()); P = V[vs]
        c = P.mean(0); u, s, vt = np.linalg.svd(P - c, full_matrices=False)
        d = (P - c) @ vt[2]
        rms[k] = np.sqrt((d ** 2).mean()); area[k] = A[fi].sum()
    big = area > min_area
    ok = (rms < tol_mm / 1000) & big
    frac = float(area[ok].sum() / area[big].sum())
    return {"facet_regions": int(big.sum()), "planar_area_fraction": frac, "rms_area_weighted_mm": float((rms[big] * area[big]).sum() / area[big].sum() * 1000),
            "tol_mm": tol_mm, "pass": bool(frac >= 0.98)}

def douglas_peucker_count(P, tol):
    """Nombre de segments de la polyligne P pour une tolérance tol (itératif)."""
    stack = [(0, len(P) - 1)]; cnt = 0
    while stack:
        i, j = stack.pop()
        if j <= i + 1: cnt += 1; continue
        a, b = P[i], P[j]; ab = b - a; L = np.linalg.norm(ab)
        if L < 1e-12: d = np.linalg.norm(P[i + 1:j] - a, axis=1)
        else: d = np.linalg.norm(np.cross(P[i + 1:j] - a, ab / L), axis=1)
        k = int(np.argmax(d))
        if d[k] > tol: m = i + 1 + k; stack += [(i, m), (m, j)]
        else: cnt += 1
    return cnt

def crease_chains(V, T, thr_deg=35.0):
    e, ang, L, ff = dihedrals(V, T)
    sh = (ang > thr_deg) & (ang < 175)
    adj = collections.defaultdict(list)
    for u, v in e[sh]: adj[int(u)].append(int(v)); adj[int(v)].append(int(u))
    seen = set(); chains = []
    def walk(a, b):
        ch = [a, b]; seen.add((min(a, b), max(a, b))); prev, cur = a, b
        while len(adj[cur]) == 2:
            cand = [x for x in adj[cur] if x != prev]
            if not cand: break                                                                      # 30 October 2026 : a vertex listed twice towards the same neighbour (degenerate quad) is a dead end, not a crash
            nx = cand[0]; k = (min(cur, nx), max(cur, nx))
            if k in seen: break
            seen.add(k); ch.append(nx); prev, cur = cur, nx
        return ch
    for v0 in list(adj):
        if len(adj[v0]) != 2:
            for n0 in adj[v0]:
                if (min(v0, n0), max(v0, n0)) not in seen: chains.append(walk(v0, n0))
    for v0 in list(adj):
        for n0 in adj[v0]:
            if (min(v0, n0), max(v0, n0)) not in seen: chains.append(walk(v0, n0))
    return chains

def crease_straightness(V, T, tol_mm=1.0, min_len=0.15, thr_deg=35.0):
    """Segments de Douglas-Peucker par mètre de pli (tolérance tol_mm) : un pli de polyèdre est un petit nombre de droites, un pli ondulé en demande beaucoup."""
    ch = crease_chains(V, T, thr_deg)
    tot_len = 0.0; tot_seg = 0; per = []
    for c in ch:
        P = V[c]; Lc = np.linalg.norm(np.diff(P, axis=0), axis=1).sum()
        if Lc < min_len or len(c) < 4: continue
        n = douglas_peucker_count(P, tol_mm / 1000)
        per.append((Lc, n)); tot_len += Lc; tot_seg += n
    if not per: return {"chains": 0, "pass": False}
    spm = tot_seg / tot_len
    simple = sum(L for L, n in per if n / L <= 3.0) / tot_len
    return {"chains": len(per), "crease_length_m": float(tot_len), "segments_per_m": float(spm), "length_share_with_le3_segments_per_m": float(simple), "tol_mm": tol_mm,
            "pass": bool(spm <= 3.0)}

def undulation(V, T, lo=0.3, hi=5.0):
    """Part de la longueur d'arête dont le dièdre est dans [lo, hi) degrés : une facette plane n'en a aucune, une tôle ondulée en est pleine."""
    e, ang, L, ff = dihedrals(V, T)
    sel = (ang >= lo) & (ang < hi)
    return {"undulation_length_fraction": float(L[sel].sum() / L.sum()), "band_deg": [lo, hi], "pass": bool(L[sel].sum() / L.sum() < 0.02)}

def symmetry(V, T, axis=0, n=20000, seed=3):
    """Symétrie miroir mesurée par distance POINT-SURFACE (insensible à la tessellation) : points échantillonnés sur la surface, reflétés,
    distance au triangle le plus proche (trimesh.proximity, MIT)."""
    import trimesh
    rng = np.random.default_rng(seed)
    N_, A_, C_ = tri_geom(V, T)
    idx = rng.choice(len(T), size=n, p=A_ / A_.sum())
    r1 = np.sqrt(rng.random(n)); r2 = rng.random(n)
    a, b, c = V[T[idx, 0]], V[T[idx, 1]], V[T[idx, 2]]
    X = (1 - r1)[:, None] * a + (r1 * (1 - r2))[:, None] * b + (r1 * r2)[:, None] * c
    flip = np.ones(3); flip[axis] = -1
    m = trimesh.Trimesh(V, T, process=False)
    _, d, _ = trimesh.proximity.closest_point(m, X * flip)
    return {"mirror_p99_mm": float(np.percentile(d, 99) * 1000), "mirror_max_mm": float(d.max() * 1000), "pass": bool(np.percentile(d, 99) < 0.001)}

def reprojection_iou(V, T, ref_masks, px, views=("front", "back", "left", "right", "top", "bottom")):
    """IoU des silhouettes du maillage contre des masques de référence à la même échelle et au même cadre (dict nom -> (mask, bounds))."""
    from clay_render import render
    out = {}
    for nm in views:
        mask, bounds = ref_masks[nm]
        R = render(V, T, nm, px=px, bounds=bounds, margin=0)
        s = R["id"] >= 0
        H, W = mask.shape
        s = s[:H, :W]
        if s.shape != mask.shape:
            s2 = np.zeros_like(mask); s2[:s.shape[0], :s.shape[1]] = s; s = s2
        out[nm] = float((s & mask).sum() / max((s | mask).sum(), 1))
    mn = min(out.values())
    return {"iou": out, "iou_min": mn, "pass": bool(mn >= 0.995)}

def run_all(V, T, mesh_faces_mask=None, n_samples=6000):
    return {"closure": closure(V, T), "facet_planarity": facet_planarity(V, T), "planarity": local_planarity(V, T, mask_faces=mesh_faces_mask, n_samples=n_samples),
            "crease_straightness": crease_straightness(V, T), "undulation": undulation(V, T), "symmetry": symmetry(V, T)}
