"""E2b (variante enveloppe) : le calibrage de la lumière sur les normales de l'enveloppe visuelle et les coupes déduites des résidus. Résultat négatif mesuré. 30 October 2026."""
import sys, json
import numpy as np
sys.path.insert(0, ".")
from e2b_shading import *
case = make_case(); hull = visual_hull(case, 1.5); hb = hull_buffers(hull, case)
out = {"hull_normal_accuracy": {}, "calibration_sigma": {}}
for nm in VIEWS6:
    m = hb[nm]["mask"] & case["views"][nm]["mask"]
    ang = np.degrees(np.arccos(np.clip((hb[nm]["n"][m] * case["views"][nm]["n"][m]).sum(1), -1, 1)))
    out["hull_normal_accuracy"][nm] = {"share_under_2deg": float((ang < 2).mean()), "share_under_10deg": float((ang < 10).mean()), "pixels": int(m.sum())}
cuts, cal, hb = estimate_cuts(case, hull)
out["calibration_sigma"] = {nm: float(cal[nm][3]) for nm in VIEWS6}
f0 = fidelity(hull, case["truth"]); final, acc = apply_cuts(case, hull, cuts, cal); f1 = fidelity(final, case["truth"])
out.update({"cuts_candidates": len(cuts), "cuts_accepted": len(acc), "before": f0, "after": f1, "recovery": recovery(case, acc)})
json.dump(out, open("out/e2b_hull_failure.json", "w"), indent=1)
print(json.dumps({k: v for k, v in out.items() if k != "recovery"}, indent=1))
