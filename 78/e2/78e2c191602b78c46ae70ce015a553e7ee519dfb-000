# 25 October 2026 : ZenRay Meshes, which named parts occupy a pixel rectangle of a sheet view (rendered in the SheetScore
# panel camera with face ids) : the fastest way to know what hides what. Usage: RegionCensus.py <car.npz> <view> x0 y0 x1 y1
import sys, os, json, collections
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from PIL import Image
import Raster, SheetScore
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"
npz, view = sys.argv[1], sys.argv[2]; x0, y0, x1, y1 = map(int, sys.argv[3:7])
meta = json.load(open(W + "work/car/frame/frame.json")); v = [x for x in meta["views"] if x["name"] == view][0]
d = np.load(npz, allow_pickle=True); T, N = d["T"], d["names"]; r = Raster.Renderer(d["P"], d["F"]); cap = {}; o = r.render
def rr(*a, **k):
    out = o(*a, **k); cap["f"] = out[3]; return out
r.render = rr; m = np.asarray(Image.open(W + "work/car/frame/mask_%s.png" % view)) > 127
SheetScore.render_in_panel(r, meta, v, m.shape); r.release()
f = cap["f"][y0:y1, x0:x1].astype(int); f = f[(f >= 0) & (f < len(T))]
print(json.dumps(collections.Counter(N[T[f]].tolist()).most_common(10)))
