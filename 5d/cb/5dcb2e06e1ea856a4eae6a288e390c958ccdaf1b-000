        ref = np.asarray(Image.open(W + "work/car/views/%02d_%s_rgb.png" % (pan["index"], v["name"])).convert("L"))
        mref = np.asarray(Image.open(W + "work/car/frame/mask_%s.png" % v["name"])) > 127
