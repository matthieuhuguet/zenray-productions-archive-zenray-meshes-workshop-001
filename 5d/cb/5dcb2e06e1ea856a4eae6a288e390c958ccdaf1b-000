def comp_of_part(name, comps):
    """component number (str) of a part name, by the regex lists of the parameters file ; None when no component owns it."""
    base = re.sub(r"_[0-9]+$", "", str(name))   # 26 October 2026: instances carry a numeric suffix (CAR_grille_upright_01) ; the patterns name the family
    for k, c in comps.items():
        for pat in c.get("parts", []):
            if re.fullmatch(pat, base) or re.fullmatch(pat, str(name)): return k
    return None


def next_action(row, low):
    """the one thing to do for this component, from its weakest sub score (FR : le geste suivant)."""
    if row["completion"] >= 0.90: return "keep"
    if low == "topo":
        kinds = ", ".join("%s %d" % kv for kv in row.get("fault_kinds", {}).items()) or "none"
        return "retopology of %s : faults %s" % (row["tool"], kinds)
    if low == "line":
        r_, p_ = row.get("line_recall", 0), row.get("line_precision", 0)
        return ("model misses reference lines (recall %.2f < precision %.2f) : add the cuts, creases or joints in %s" if r_ < p_ else "model has extra lines (precision %.2f < recall %.2f) : remove or merge the loops in %s") % ((r_, p_, row["tool"]) if r_ < p_ else (p_, r_, row["tool"]))
    return "marker not on the component : check the placement and the hiding order in %s" % row["tool"]


def colour(p):
    return (70, 190, 90) if p >= 0.90 else (235, 170, 40) if p >= 0.75 else (225, 70, 60)


def tri_render(dl):
    """26 October 2026: a topology file (P, C, I, T, names) as a triangle mesh with the part id of every triangle ; FR : fichier de topologie en triangles."""
    C_, I_, T_, P_ = dl["C"].astype(int), dl["I"].astype(int), dl["T"], dl["P"].astype(np.float32); st = np.concatenate([[0], np.cumsum(C_)[:-1]]); F, TT = [], []
    for s0, c, t in zip(st, C_, T_):
        v = I_[s0:s0 + c]
        for k in range(1, c - 1): F.append((v[0], v[k], v[k + 1])); TT.append(t)
    return P_, np.array(F, np.int32), np.array(TT), dl["names"]


