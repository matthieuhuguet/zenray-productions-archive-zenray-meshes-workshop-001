        Dd, Nn, Fi = cap["D"][: sh[0], : sh[1]], cap["N"][: sh[0], : sh[1]], cap["F"][: sh[0], : sh[1]]
        fid = np.where(M & (Fi >= 0) & (Fi < len(T)), Fi, 0); cmap = np.where(M & (Fi >= 0) & (Fi < len(T)), lut[T[fid]], 0)
        inner = ndi.binary_erosion(mref, iterations=LineScore.P["erode_px"]) & ndi.binary_erosion(M, iterations=LineScore.P["erode_px"])
        Er = LineScore.ref_edges(ref) & inner; Em = LineScore.model_edges(Nn, M, Dd) & inner
        views[v["name"]] = {"pan": pan, "cmap": cmap, "M": M, "shade": shade, "Er": Er, "Em": Em, "mref": mref, "N": Nn, "D": Dd, "dm": ndi.distance_transform_edt(~Em),
                            "dr": ndi.distance_transform_edt(~Er), "ref": ref}
