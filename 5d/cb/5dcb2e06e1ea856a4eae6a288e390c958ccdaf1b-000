    COL = {"thick": (150, 90, 50), "med": (230, 150, 60), "thin": (250, 220, 90), "fol": (60, 140, 70)}
    tiles = []
    for vn, vw in views.items():
        sh = vw["M"].shape; base = np.stack([vw["ref"] // 3] * 3, -1).astype(np.uint8); a = base.copy()
        for cl in ("thin", "med", "thick"): a[vw["wood_cls"][cl]] = COL[cl]
        a[vw["fol"]] = COL["fol"]
        wm = np.zeros(sh, bool); fm = np.zeros(sh, bool)
        for k, c in (comps or {}).items():
            pass
        m_ = np.stack([vw["shade"]] * 3, -1).astype(np.uint8).copy(); b_ = np.full(sh + (3,), 60, np.uint8)
        # model classes : visible wood by thickness, visible leaves
        modw = vw.get("model_wood"); modf = vw.get("model_fol")
        if modw is not None:
            cls_m = vw["model_cls"]
            for cl in ("thin", "med", "thick"): b_[cls_m[cl]] = COL[cl]
            b_[modf] = COL["fol"]
        row = np.hstack([a, b_]); im = Image.fromarray(row); d = ImageDraw.Draw(im); d.text((6, 4), "%s %s : %s   reference | model" % (obj, ver, vn), font=fl, fill=(255, 255, 0))
        for k, (rf, md) in vw.get("masks", {}).items():
            if rf.sum() < 60 or (comps or {}).get(k, {}).get("stage", 1) == 0: continue
            ys, xs = np.nonzero(rf); cx, cy = int(xs.mean()), int(ys.mean()); cp = (out or {}).get(k, {}).get("completion")
            col = (70, 190, 90) if (cp or 0) >= 0.9 else (235, 170, 40) if (cp or 0) >= 0.75 else (225, 70, 60)
            for xo, fill in ((0, (204, 124, 94)), (sh[1], col)):
                d.ellipse((cx + xo - 10, cy - 10, cx + xo + 10, cy + 10), fill=fill, outline=(255, 255, 255)); d.text((cx + xo, cy), str(k), font=font, fill=(255, 255, 255) if xo == 0 else (20, 20, 20), anchor="mm")
        tiles.append(np.asarray(im))
    Wd = max(t.shape[1] for t in tiles); body = np.concatenate([np.pad(t, ((0, 0), (0, Wd - t.shape[1]), (0, 0))) for t in tiles], 0); H = body.shape[0]
    leg = Image.new("RGB", (330, H), (245, 244, 240)); d = ImageDraw.Draw(leg); d.text((12, 10), "completion, by stage (%s %s)" % (obj, ver), font=fl, fill=(40, 40, 40)); y = 40
    for k, v in sorted((out or {}).items(), key=lambda kv: (comps[kv[0]].get("stage", 9) or 9, int(kv[0]))):
        cp = v.get("completion")
        if cp is None: continue
        col = (70, 190, 90) if cp >= 0.9 else (235, 170, 40) if cp >= 0.75 else (225, 70, 60)
        d.ellipse((12, y - 9, 30, y + 9), fill=col); d.text((38, y), "%s  st %s  %s  %.0f %%" % (k, comps[k].get("stage", "-"), v["name"][:24], 100 * cp), font=font, fill=(40, 40, 40), anchor="lm"); y += 26
    Image.fromarray(np.hstack([body, np.asarray(leg)])).save(path)


def main(tag, board=True, prm=None, write=True):
