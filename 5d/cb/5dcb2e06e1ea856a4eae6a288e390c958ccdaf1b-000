def mask_board(views, path, out=None, comps=None, tag="", obj="", ver=""):
    """26 October 2026: the COMPONENT SHEET of an organic object, as for the car : per view, the reference classes | the model classes, with the component numbers
    placed by the algorithm on the centroid of each reference region (never by eye), coloured by completion on the model side, plus the ranked legend. The version
    is written on the image. FR : planche des composants d'un objet organique, marqueurs au centroïde des régions de référence."""
