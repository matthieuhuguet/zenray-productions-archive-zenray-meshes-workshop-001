def row_map(meta, v, shape, ys=(3.0, 4.0, 12.0, 13.0)):
    """26 October 2026: pixel row of a world height in a sheet view, calibrated by rendering two vertical quads of known height (side views only) ;
    the mask rows of the quad give py = a y + b. FR : ligne de pixels d'une hauteur du monde, calibrée par deux quads de hauteur connue."""
    lo = np.array(meta["lo"]); D = np.array(meta["dims_m"]); c0 = lo + D / 2; rx = np.array(v["rx"]); got = []
    for y0 in (ys[0], ys[2]):
        P_ = np.array([c0 + rx * 2 + np.array([0, y0 - c0[1], 0]), c0 - rx * 2 + np.array([0, y0 - c0[1], 0]), c0 - rx * 2 + np.array([0, y0 + 1 - c0[1], 0]), c0 + rx * 2 + np.array([0, y0 + 1 - c0[1], 0])], np.float32)
        r = Raster.Renderer(P_, np.array([[0, 1, 2], [0, 2, 3]], np.int32)); M, _ = SheetScore.render_in_panel(r, meta, v, shape); r.release(); rows = np.flatnonzero(M.any(1)); got.append((y0, rows.min(), rows.max()))
    (ya, ta, ba), (yb, tb, bb) = got; sl = ((ta + ba) / 2 - (tb + bb) / 2) / (ya - yb); b = (ta + ba) / 2 - sl * (ya + 0.5)
    return lambda y: sl * y + b


