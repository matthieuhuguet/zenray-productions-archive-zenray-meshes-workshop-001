# 25 October 2026 : create or refresh a Python SOP that reads an npz of quads (P, Q, names) with a "name" attribute,
# so components built in Python (wheels, trims) enter the Houdini network procedurally. Run with g = {"GEO", "NODE", "NPZ", "MERGE", "INPUT"}.
import hou
geo = hou.node(globals()["GEO"]); name = globals()["NODE"]; npz = globals()["NPZ"]
n = geo.node(name) or geo.createNode("python", name)
n.parm("python").set('''# 25 October 2026 : quads with names from %s
import hou, numpy as np
node = hou.pwd(); geo = node.geometry()
d = np.load(%r, allow_pickle=True)
pts = geo.createPoints([hou.Vector3(*p) for p in d["P"].tolist()])
na = geo.addAttrib(hou.attribType.Prim, "name", "")
for q, nm in zip(d["Q"].tolist(), d["names"].tolist()):
    pr = geo.createPolygon()
    for i in q: pr.addVertex(pts[i])
    pr.setAttribValue(na, nm)
''' % (npz, npz))
m = geo.node(globals()["MERGE"]); m.setInput(int(globals()["INPUT"]), n); n.moveToGoodPosition()
result = {"prims": len(n.geometry().prims()), "errors": n.errors()}
