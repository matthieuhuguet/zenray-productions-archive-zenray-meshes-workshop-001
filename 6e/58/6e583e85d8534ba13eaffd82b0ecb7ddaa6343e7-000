# 10 November 2026 (written 11 November 2026): draws a metric grid on a calibrated view of the car-2 sheet, to read shapes in metres by eye.
import sys, json
from PIL import Image, ImageDraw, ImageFont
V = '/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car2/views_ref/'
FR = json.load(open('/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car2/frame/frame.V1.json'))
lo, dims = FR['lo'], FR['dims_m']; hi = [lo[i] + dims[i] for i in range(3)]
def mapping(name):
    v = [x for x in FR['views'] if x['name'] == name][0]; bx0, by0, bx1, by1 = v['bbox']; sx, sy = v['sx'], v['sy']
    if name == 'front':  return (lambda a, b: (bx0 + (a - lo[0]) * sx, by0 + (hi[1] - b) * sy)), ('x', 'y')
    if name == 'left':   return (lambda a, b: (bx0 + (hi[2] - a) * sx, by0 + (hi[1] - b) * sy)), ('z', 'y')
    if name == 'top':    return (lambda a, b: (bx0 + (hi[2] - a) * sx, by0 + (hi[0] - b) * sy)), ('z', 'x')
name, out, crop, scale = sys.argv[1], sys.argv[2], [int(c) for c in sys.argv[3].split(',')], int(sys.argv[4])
f, (ha, hb) = mapping(name); files = {'front': '00_front_rgb.png', 'left': '02_left_rgb.png', 'top': '04_top_rgb.png'}
im = Image.open(V + files[name]).convert('RGB').crop(crop); im = im.resize((im.width * scale, im.height * scale), Image.LANCZOS); d = ImageDraw.Draw(im)
fnt = ImageFont.truetype('/Users/zenray/Library/Fonts/AdobeClean-Regular.otf', 16)
rng = {'x': (lo[0], hi[0]), 'y': (lo[1], hi[1]), 'z': (lo[2], hi[2])}
import math
def P(a, b): px, py = f(a, b); return ((px - crop[0]) * scale, (py - crop[1]) * scale)
for i in range(int(math.floor(rng[ha][0] * 10)) - 2, int(math.ceil(rng[ha][1] * 10)) + 3):
    a = i / 10; (x0, y0), (x1, y1) = P(a, rng[hb][0] - 0.3), P(a, rng[hb][1] + 0.3)
    d.line((x0, y0, x1, y1), fill=(0, 0, 0) if i % 5 == 0 else (90, 90, 90), width=1); (i % 5 == 0) and (d.rectangle((x0 + 2, 2, x0 + 62, 22), fill=(255, 255, 255)), d.text((x0 + 4, 3), '%s %.1f' % (ha, a), fill=(0, 0, 0), font=fnt))
for j in range(int(math.floor(rng[hb][0] * 10)) - 3, int(math.ceil(rng[hb][1] * 10)) + 3):
    b = j / 10; (x0, y0), (x1, y1) = P(rng[ha][0] - 0.3, b), P(rng[ha][1] + 0.3, b)
    d.line((x0, y0, x1, y1), fill=(0, 0, 0) if j % 5 == 0 else (90, 90, 90), width=1); (j % 5 == 0) and (d.rectangle((2, y0 + 2, 62, y0 + 22), fill=(255, 255, 255)), d.text((4, y0 + 3), '%s %.1f' % (hb, b), fill=(0, 0, 0), font=fnt))
im.save(out); print(out, im.size)
