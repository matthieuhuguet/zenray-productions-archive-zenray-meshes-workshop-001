"""28 October 2026, 15:10 : one view of a delivery against the reference mask : missing (red) and extra (blue) pixels on the reference image, x3, plus counts by row band.
python ViewDiff.py <obj> <view> <out.png>   FR : écart d'une vue, manque en rouge, surplus en bleu."""
import sys, os, json
import numpy as np, trimesh
from PIL import Image
from scipy import ndimage as ndi
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import Raster
from SheetScore import render_in_panel
obj, view, out = sys.argv[1:4]
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car/"
meta = json.load(open(W + "frame/frame.json")); sheet = json.load(open(W + "views/sheet.json"))
mesh = trimesh.load(obj, force="mesh", process=False); mr = Raster.Renderer(mesh.vertices, mesh.faces)
v = [v for v in meta["views"] if v["name"] == view][0]; pan = [p for p in sheet["panels"] if p["name"] == view][0]
ref = np.asarray(Image.open(W + "views/%02d_%s_rgb.png" % (pan["index"], view)).convert("RGB")).copy()
mref = np.asarray(Image.open(W + "frame/mask_%s.png" % view)) > 127
M, _ = render_in_panel(mr, meta, v, mref.shape); M = ndi.binary_fill_holes(M)
miss = mref & ~M; extra = M & ~mref
ref[miss] = [255, 0, 0]; ref[extra] = [0, 120, 255]
Image.fromarray(ref).resize((ref.shape[1] * 3, ref.shape[0] * 3), Image.NEAREST).save(out)
print("miss", int(miss.sum()), "extra", int(extra.sum()))
for r0 in range(0, mref.shape[0], 25):
    a, b = int(miss[r0:r0 + 25].sum()), int(extra[r0:r0 + 25].sum())
    if a + b > 40: print("rows", r0, r0 + 25, "miss", a, "extra", b)
