<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ZenRay Blueprints 3D 2.0 : Interface d'audit en 10 secondes</title>
<style>
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Regular.woff2') format('woff2');font-weight:100 450;font-style:normal}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Medium.woff2') format('woff2');font-weight:451 599;font-style:normal}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Bold.woff2') format('woff2');font-weight:600 900;font-style:normal}
:root{
  --font:'Adobe Clean','Hiragino Sans W4',sans-serif;
  --paper:#f5f4f1; --ink:#15171c; --mute:#5c616b; --line:#dad8d2; --card:#ffffff; --soft:#ebe9e3;
  --stage:#14171f; --bp:#0d3a80; --cyan:#28cdd8; --mag:#f45b9a; --yel:#ffd60a; --ok:#22c55e; --warn:#f59e0b; --bad:#ef4444;
  --r:14px; --t:.2s;
}
:root[data-theme="dark"]{
  --paper:#121317; --ink:#efeee9; --mute:#9aa0ab; --line:#292d36; --card:#1a1c22; --soft:#23262f; --stage:#0f1117;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#121317; --ink:#efeee9; --mute:#9aa0ab; --line:#292d36; --card:#1a1c22; --soft:#23262f; --stage:#0f1117;
  }
}
@media (prefers-reduced-motion: reduce){ :root{ --t:0s } }
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.5;font-synthesis:none;transition:background var(--t),color var(--t)}
main{max-width:1360px;margin:0 auto;padding:28px 20px 56px}
.head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:14px}
h1{font-size:clamp(26px,3.2vw,36px);font-weight:500;margin:0;line-height:1.15}
.prose{max-width:74ch;margin:0 0 18px;color:var(--mute)}
.prose p{margin:0 0 8px}
.top-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.save-pill{display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border-radius:999px;background:var(--card);border:1px solid var(--line);font-size:13px;font-weight:500}
.save-dot{width:8px;height:8px;border-radius:50%;background:var(--ok);transition:background var(--t)}
.save-dot.busy{background:var(--warn)}
button.btn{border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit;font-size:14px;padding:9px 14px;border-radius:999px;cursor:pointer;min-height:40px;transition:all var(--t)}
button.btn:hover{border-color:var(--ink)}
button.btn.primary{background:var(--ink);color:var(--paper);border-color:var(--ink);font-weight:500}
button.btn[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink);font-weight:500}

/* 4-Lamp Component Header Strip */
.comp-bar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:12px 16px;margin-bottom:16px}
.comp-tabs{display:flex;gap:8px;flex-wrap:wrap}
.lamps{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.lamp{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:var(--soft);font-size:13px;font-weight:500}
.l-dot{width:9px;height:9px;border-radius:50%}
.l-ok{background:var(--ok)} .l-warn{background:var(--warn)} .l-bad{background:var(--bad)} .l-info{background:var(--cyan)}

/* Main Workbench */
.bench{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px;align-items:start}
@media (max-width:960px){ .bench{grid-template-columns:1fr} }
.stage-card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:14px;display:flex;flex-direction:column;gap:12px}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}
.seg{display:flex;flex-wrap:wrap;gap:6px}
.viewport{position:relative;background:var(--stage);border-radius:12px;overflow:hidden;aspect-ratio:540/447;max-height:495px;margin:0 auto;width:100%;border:1px solid var(--line);touch-action:none}
.viewport.blueprint{background:var(--bp)}
.viewport canvas{display:block;width:100%;height:100%;cursor:crosshair}
.hud{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding-top:2px}
.hud-chip{background:var(--soft);color:var(--ink);border:1px solid var(--line);padding:6px 12px;border-radius:999px;font-size:13px;font-weight:500}
.hud-chip.bad{border-color:rgba(239,68,68,.55);color:var(--bad)}
.hud-chip.ok{border-color:rgba(34,197,94,.55);color:var(--emerald, #16a34a)}

/* Inspector Sidebar */
.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:16px;display:flex;flex-direction:column;gap:14px}
.panel h2{font-size:16px;font-weight:500;margin:0;padding-bottom:8px;border-bottom:1px solid var(--line)}
.ctrl-row{display:flex;flex-direction:column;gap:4px}
.ctrl-row label{display:flex;justify-content:space-between;font-size:13px;color:var(--mute)}
.ctrl-row output{color:var(--ink);font-weight:500}
input[type=range]{width:100%;accent-color:var(--ink);margin:0;height:28px;cursor:pointer}
.edit-tools{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.small-btn{border:1px solid var(--line);background:var(--soft);color:var(--ink);font:inherit;font-size:13px;padding:8px 10px;border-radius:10px;cursor:pointer;text-align:center;transition:all var(--t)}
.small-btn[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.maps-row{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.map-tile{aspect-ratio:1;border-radius:8px;border:1px solid var(--line);display:flex;align-items:flex-end;padding:4px;font-size:10px;font-weight:500;color:#fff;text-shadow:0 1px 2px #000}
.post-log{font-size:12px;color:var(--mute);background:var(--soft);border-radius:10px;padding:9px 11px;min-height:46px;line-height:1.4}
</style>
</head>
<body>
<main>
  <header class="head">
    <div>
      <h1>ZenRay Blueprints 3D 2.0 : comprendre et corriger en 10 secondes</h1>
    </div>
    <div class="top-actions">
      <div class="save-pill"><span class="save-dot" id="saveDot"></span><span id="saveTxt">Enregistré · Historique : 0 action</span></div>
      <button class="btn" id="undoBtn" type="button">Annuler (Ctrl+Z)</button>
      <button class="btn" id="themeBtn" type="button">Clair / Sombre</button>
      <button class="btn primary" id="applyBtn" type="button">Appliquer sans copier-coller</button>
    </div>
  </header>

  <section class="prose">
    <p>Cette maquette montre comment le cockpit de retouche peut supprimer les allers-retours manuels entre vos captures et Houdini. Au lieu de copier un texte technique dans le chat, vous comparez instantanément la pièce générée à sa référence, sélectionnez n'importe quelle courbe jaune ou magenta, et lancez la reconstruction en un clic.</p>
  </section>

  <!-- 4-Lamp Component Rail -->
  <section class="comp-bar" aria-label="Sélection du composant et feux d'étape">
    <div class="comp-tabs">
      <button class="btn" data-comp="cuff_front" aria-pressed="true">Arm_Cuff · Vue Face</button>
      <button class="btn" data-comp="cuff_bottom" aria-pressed="false">Arm_Cuff · Vue Dessous (Alerte)</button>
      <button class="btn" data-comp="arm_flare" aria-pressed="false">Arm_Flare · Édition CMY 2.0</button>
    </div>
    <div class="lamps" id="lamps">
      <span class="lamp"><span class="l-dot l-ok"></span>1. Isoler</span>
      <span class="lamp"><span class="l-dot l-info"></span>2. CMY 2.0</span>
      <span class="lamp"><span class="l-dot l-bad" id="houdiniLamp"></span>3. Houdini (<span id="houdiniScore">Bas 0,48</span>)</span>
      <span class="lamp"><span class="l-dot l-ok"></span>4. UV & Height 5 Maps</span>
    </div>
  </section>

  <section class="bench">
    <div class="stage-card">
      <div class="toolbar">
        <div class="seg" role="group" aria-label="Mode visuel 10 secondes">
          <button class="btn" data-mode="onion" aria-pressed="true">Pelure d'oignon</button>
          <button class="btn" data-mode="heatmap" aria-pressed="false">Erreur Rouge / Vert</button>
          <button class="btn" data-mode="zebra" aria-pressed="false">Zebra Reflets</button>
          <button class="btn" data-mode="cmy" aria-pressed="false">Éditeur CMY 2.0</button>
        </div>
        <div class="seg">
          <button class="small-btn" id="symBtn" aria-pressed="true">Symétrie fantôme</button>
          <button class="small-btn" id="keepBtn" aria-pressed="false">+ Garder / - Exclure</button>
        </div>
      </div>

      <div class="viewport" id="viewportWrap">
        <canvas id="stageCanvas" width="720" height="596"></canvas>
      </div>
      <div class="hud">
        <div class="hud-chip" id="hudLeft">Glissez le curseur Pelure d'oignon ou cliquez sur une courbe jaune</div>
        <div class="hud-chip bad" id="hudRight">Mesure instantanée</div>
      </div>
    </div>

    <aside class="panel" aria-label="Paramètres interactifs">
      <h2>Inspection 10 secondes</h2>
      <div class="ctrl-row">
        <label><span>Mélange Référence ↔ Modèle</span><output id="outOnion">50 %</output></label>
        <input id="slOnion" type="range" min="0" max="100" value="50">
      </div>
      <div class="ctrl-row">
        <label><span>Seuil d'alerte écart (Heatmap)</span><output id="outThresh">22</output></label>
        <input id="slThresh" type="range" min="10" max="55" value="22">
      </div>

      <h2>Outils CMY 2.0 (Magenta + Jaune)</h2>
      <div class="edit-tools">
        <button class="small-btn" id="sharpBtn" type="button">Point sélectionné : Net (G)</button>
        <button class="small-btn" id="pinModeBtn" type="button">Mode : Déplacer points</button>
      </div>
      <div class="ctrl-row">
        <label><span>Force de l'arête jaune (FWHM)</span><output id="outCrease">0,78</output></label>
        <input id="slCrease" type="range" min="15" max="95" value="78">
      </div>

      <h2>Houdini → UV M1 → 5 Maps Height</h2>
      <div class="ctrl-row">
        <label><span>Épaisseur coque simulée</span><output id="outThick">100 %</output></label>
        <input id="slThick" type="range" min="85" max="115" value="100">
      </div>
      <div class="ctrl-row">
        <label><span>Micro-contraste Height PBR</span><output id="outRelief">0,65</output></label>
        <input id="slRelief" type="range" min="10" max="100" value="65">
      </div>
      <div class="maps-row" id="mapsPreview">
        <div class="map-tile" style="background:linear-gradient(135deg,#787d86,#4f535b)">Base</div>
        <div class="map-tile" style="background:linear-gradient(135deg,#8488ff,#66c2ff)">Normal</div>
        <div class="map-tile" style="background:linear-gradient(135deg,#e2e4e8,#30333a)">Height</div>
        <div class="map-tile" style="background:linear-gradient(135deg,#999,#444)">Rough</div>
        <div class="map-tile" style="background:radial-gradient(circle,#eee,#222)">AO</div>
      </div>

      <div class="post-log" id="postLog">Prêt : aucune chaîne texte à copier. Cliquez sur une courbe ou modifiez un curseur pour voir la sauvegarde immédiate.</div>
    </aside>
  </section>
</main>

<script>
const root = document.documentElement;
document.getElementById('themeBtn').addEventListener('click', () => {
  const darkNow = root.getAttribute('data-theme') === 'dark' ||
    (!root.getAttribute('data-theme') && matchMedia('(prefers-color-scheme: dark)').matches);
  root.setAttribute('data-theme', darkNow ? 'light' : 'dark');
});

const imgs = {};
const sources = {"cuff_front_ref": "data:image/jpeg;base64,", "cuff_front_mod": "data:image/jpeg;base64,", "cuff_bottom_ref": "data:image/jpeg;base64,", "cuff_bottom_mod": "data:image/jpeg;base64,", "arm_flare": "data:image/jpeg;base64,"};
let loadedCount = 0;
Object.entries(sources).forEach(([k, src]) => {
  const im = new Image();
  im.onload = () => { loadedCount++; draw(); };
  im.src = src;
  imgs[k] = im;
});

const cv = document.getElementById('stageCanvas');
const ctx = cv.getContext('2d', { willReadFrequently: true });
const offA = document.createElement('canvas'); offA.width = 360; offA.height = 298;
const offB = document.createElement('canvas'); offB.width = 360; offB.height = 298;
const cA = offA.getContext('2d', { willReadFrequently: true });
const cB = offB.getContext('2d', { willReadFrequently: true });
const paramsQS = new URLSearchParams(location.search);

function drawContain(targetCtx, im, W, H, extraScale = 1) {
  const ir = im.naturalWidth / Math.max(im.naturalHeight, 1), wr = W / H;
  let dw = W, dh = H;
  if (ir > wr) { dh = W / ir; } else { dw = H * ir; }
  dw *= extraScale; dh *= extraScale;
  targetCtx.drawImage(im, (W - dw) * 0.5, (H - dh) * 0.5, dw, dh);
}

// Initial editable Yellow + Magenta vertices (fractional 0..1)
let state = {
  comp: 'cuff_front',
  mode: 'onion',
  onion: 50,
  thresh: 22,
  creaseWeight: 0.78,
  thickScale: 1.0,
  relief: 0.65,
  symGhost: true,
  pinMode: false,
  selectedPt: { curve: 'yellow1', idx: 2 },
  yellow1: [
    { x: 0.195, y: 0.445, sharp: false },
    { x: 0.365, y: 0.405, sharp: false },
    { x: 0.55, y: 0.415, sharp: true },
    { x: 0.72, y: 0.47, sharp: false },
    { x: 0.855, y: 0.525, sharp: true },
  ],
  yellow2: [
    { x: 0.43, y: 0.585, sharp: false },
    { x: 0.635, y: 0.555, sharp: false },
    { x: 0.855, y: 0.525, sharp: true },
  ],
  pins: [
    { x: 0.245, y: 0.57, kind: 'keep' },
    { x: 0.248, y: 0.615, kind: 'drop' },
  ]
};
let undoStack = [];
let saveTimer = null;

function pushUndo(label) {
  undoStack.push(JSON.stringify({ y1: state.yellow1, y2: state.yellow2, pins: state.pins, cw: state.creaseWeight, th: state.thickScale }));
  if (undoStack.length > 40) undoStack.shift();
  const dot = document.getElementById('saveDot');
  const txt = document.getElementById('saveTxt');
  dot.classList.add('busy');
  txt.textContent = 'Sauvegarde… · Historique : ' + undoStack.length + ' action' + (undoStack.length > 1 ? 's' : '');
  clearTimeout(saveTimer);
  saveTimer = setTimeout(() => {
    dot.classList.remove('busy');
    txt.textContent = 'Enregistré · Historique : ' + undoStack.length + ' action' + (undoStack.length > 1 ? 's' : '');
  }, 240);
  if (label) document.getElementById('postLog').textContent = label;
}

function doUndo() {
  if (!undoStack.length) return;
  const snap = JSON.parse(undoStack.pop());
  state.yellow1 = snap.y1; state.yellow2 = snap.y2; state.pins = snap.pins;
  state.creaseWeight = snap.cw; state.thickScale = snap.th;
  document.getElementById('slCrease').value = Math.round(state.creaseWeight * 100);
  document.getElementById('outCrease').textContent = state.creaseWeight.toFixed(2).replace('.', ',');
  document.getElementById('slThick').value = Math.round(state.thickScale * 100);
  document.getElementById('outThick').textContent = Math.round(state.thickScale * 100) + ' %';
  document.getElementById('saveTxt').textContent = 'Annulé · Historique : ' + undoStack.length;
  draw();
}

document.getElementById('undoBtn').addEventListener('click', doUndo);
window.addEventListener('keydown', (e) => {
  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'z') { e.preventDefault(); doUndo(); }
  if (e.key.toLowerCase() === 'g' && state.mode === 'cmy') { toggleSharp(); }
});

function toggleSharp() {
  const arr = state[state.selectedPt.curve];
  if (!arr || !arr[state.selectedPt.idx]) return;
  pushUndo('Tangente basculée sur point ' + (state.selectedPt.idx + 1) + ' (' + state.selectedPt.curve + ')');
  arr[state.selectedPt.idx].sharp = !arr[state.selectedPt.idx].sharp;
  document.getElementById('sharpBtn').textContent = 'Point sélectionné : ' + (arr[state.selectedPt.idx].sharp ? 'Net (Losange)' : 'Doux (Cercle)');
  draw();
}
document.getElementById('sharpBtn').addEventListener('click', toggleSharp);

function drawSmoothCurve(pts, color, width) {
  ctx.save();
  ctx.strokeStyle = color;
  ctx.lineWidth = width;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.beginPath();
  const W = cv.width, H = cv.height;
  ctx.moveTo(pts[0].x * W, pts[0].y * H);
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i], p1 = pts[i + 1];
    if (p0.sharp || p1.sharp) {
      ctx.lineTo(p1.x * W, p1.y * H);
    } else {
      const mx = (p0.x + p1.x) * 0.5 * W, my = (p0.y + p1.y) * 0.5 * H;
      ctx.quadraticCurveTo(p0.x * W, p0.y * H, mx, my);
    }
  }
  const last = pts[pts.length - 1];
  ctx.lineTo(last.x * W, last.y * H);
  ctx.stroke();
  ctx.restore();
}

function draw() {
  const W = cv.width, H = cv.height;
  ctx.clearRect(0, 0, W, H);
  document.getElementById('viewportWrap').classList.toggle('blueprint', state.mode === 'cmy');

  let refIm = imgs.cuff_front_ref, modIm = imgs.cuff_front_mod;
  if (state.comp === 'cuff_bottom') { refIm = imgs.cuff_bottom_ref; modIm = imgs.cuff_bottom_mod; }
  if (state.comp === 'arm_flare') { refIm = imgs.arm_flare; modIm = imgs.arm_flare; }
  if (!refIm || !refIm.complete || !refIm.naturalWidth) return;

  if (state.mode === 'onion') {
    drawContain(ctx, refIm, W, H);
    const t = state.onion / 100;
    if (t > 0 && state.comp !== 'arm_flare') {
      ctx.save();
      ctx.globalAlpha = t;
      drawContain(ctx, modIm, W, H, state.thickScale);
      ctx.restore();
    }
    const label = state.comp === 'cuff_bottom'
      ? 'Vue Dessous · Basculez le curseur : les ailes pointues dépassent de 38 px'
      : (state.comp === 'arm_flare' ? 'Arm_Flare · Passez en Éditeur CMY 2.0 pour toucher les courbes jaunes' : 'Glissez le mélange pour voir l’écart de courbe et l’encoche en escalier');
    document.getElementById('hudLeft').textContent = label;
    const hr = document.getElementById('hudRight');
    hr.textContent = state.comp === 'cuff_bottom' ? 'IoU Dessous : 0,484 (Critique)' : (state.comp === 'cuff_front' ? 'IoU Face : 0,900' : 'Réf CMY prête');
    hr.className = 'hud-chip ' + (state.comp === 'cuff_bottom' ? 'bad' : 'ok');
  } else if (state.mode === 'heatmap') {
    cA.fillStyle = '#5a5a5a'; cA.fillRect(0, 0, offA.width, offA.height);
    cB.fillStyle = '#181818'; cB.fillRect(0, 0, offB.width, offB.height);
    drawContain(cA, refIm, offA.width, offA.height);
    drawContain(cB, modIm, offB.width, offB.height);
    const dA = cA.getImageData(0, 0, offA.width, offA.height);
    const dB = cB.getImageData(0, 0, offB.width, offB.height);
    const bgA = 0.3 * dA.data[40] + 0.59 * dA.data[41] + 0.11 * dA.data[42];
    const bgB = 0.3 * dB.data[40] + 0.59 * dB.data[41] + 0.11 * dB.data[42];
    const out = cA.createImageData(offA.width, offA.height);
    let okPx = 0, badPx = 0;
    const th = state.thresh;
    for (let i = 0; i < dA.data.length; i += 4) {
      const lA = 0.3 * dA.data[i] + 0.59 * dA.data[i + 1] + 0.11 * dA.data[i + 2];
      const lB = 0.3 * dB.data[i] + 0.59 * dB.data[i + 1] + 0.11 * dB.data[i + 2];
      const mA = Math.abs(lA - bgA) > 13, mB = Math.abs(lB - bgB) > 16;
      if (state.comp === 'arm_flare') {
        const edge = Math.abs(lA - bgA) > 16;
        out.data[i] = edge ? 55 : 22; out.data[i + 1] = edge ? 165 : 24; out.data[i + 2] = edge ? 85 : 30; out.data[i + 3] = 255;
      } else if (mA || mB) {
        const diff = Math.abs(lA - lB);
        if (mA !== mB) {
          out.data[i] = 238; out.data[i + 1] = 62; out.data[i + 2] = 62; badPx++;
        } else if (diff > th * 2.1) {
          out.data[i] = 245; out.data[i + 1] = 178; out.data[i + 2] = 45; okPx++;
        } else {
          out.data[i] = Math.round(lA * 0.4 + 28); out.data[i + 1] = Math.round(lA * 0.55 + 68); out.data[i + 2] = Math.round(lA * 0.38 + 28); okPx++;
        }
        out.data[i + 3] = 255;
      } else {
        out.data[i] = 22; out.data[i + 1] = 24; out.data[i + 2] = 30; out.data[i + 3] = 255;
      }
    }
    cA.putImageData(out, 0, 0);
    ctx.drawImage(offA, 0, 0, W, H);
    const pctBad = ((100 * badPx) / Math.max(okPx + badPx, 1)).toFixed(1).replace('.', ',');
    document.getElementById('hudLeft').textContent = 'Vert = silhouette conforme · Rouge = dépassement ou manque au seuil ' + th;
    const hr = document.getElementById('hudRight');
    hr.textContent = 'Silhouette hors écart : ' + pctBad + ' %';
    hr.className = 'hud-chip ' + (parseFloat(pctBad.replace(',', '.')) > 14 ? 'bad' : 'ok');
  } else if (state.mode === 'zebra') {
    cB.fillStyle = '#181818'; cB.fillRect(0, 0, offB.width, offB.height);
    drawContain(cB, modIm, offB.width, offB.height);
    const dB = cB.getImageData(0, 0, offB.width, offB.height);
    const bgZ = dB.data[40];
    const out = cB.createImageData(offB.width, offB.height);
    const w = offB.width, h = offB.height;
    const freq = 0.16 * (0.7 + state.relief);
    for (let y = 1; y < h - 1; y++) {
      for (let x = 1; x < w - 1; x++) {
        const idx = (y * w + x) * 4;
        const lC = dB.data[idx];
        if (Math.abs(lC - bgZ) < 14) {
          out.data[idx] = 20; out.data[idx + 1] = 22; out.data[idx + 2] = 28; out.data[idx + 3] = 255; continue;
        }
        const gx = dB.data[idx + 4] - dB.data[idx - 4];
        const gy = dB.data[idx + w * 4] - dB.data[idx - w * 4];
        const v = Math.sin((gx * 0.25 + gy * 0.14 + x * freq) * 1.1) > 0 ? 236 : 34;
        out.data[idx] = v; out.data[idx + 1] = v; out.data[idx + 2] = v + 6; out.data[idx + 3] = 255;
      }
    }
    cB.putImageData(out, 0, 0);
    ctx.drawImage(offB, 0, 0, W, H);
    document.getElementById('hudLeft').textContent = 'Reflets Zebra : chaque cassure montre un pli dur ou un défaut de surface';
    const hr = document.getElementById('hudRight');
    hr.textContent = 'Contraste relief : ' + state.relief.toFixed(2).replace('.', ',');
    hr.className = 'hud-chip ok';
  } else if (state.mode === 'cmy') {
    ctx.save();
    ctx.globalAlpha = 0.42;
    drawContain(ctx, imgs.arm_flare, W, H);
    ctx.restore();
    // Draw Symmetry Ghost Mirror Preview
    if (state.symGhost) {
      ctx.save();
      ctx.globalAlpha = 0.14;
      ctx.translate(W, 0);
      ctx.scale(-1, 1);
      drawContain(ctx, imgs.arm_flare, W, H);
      ctx.restore();
    }
    // Non-crossing harmonic Cyan Laplace guides
    ctx.save();
    ctx.strokeStyle = 'rgba(40,205,216,0.72)';
    ctx.lineWidth = 2;
    for (let k = 1; k <= 9; k++) {
      const gx = W * (0.20 + k * 0.072);
      ctx.beginPath();
      ctx.moveTo(gx, H * 0.24);
      ctx.quadraticCurveTo(gx - 8, H * 0.50, gx + 4, H * 0.72);
      ctx.stroke();
    }
    ctx.restore();

    // Draw BOTH Editable Yellow Crease curves (line width scales by FWHM crease weight)
    const yw = 3 + state.creaseWeight * 4.5;
    drawSmoothCurve(state.yellow1, '#ffd60a', yw);
    drawSmoothCurve(state.yellow2, '#ff9f1c', yw * 0.85);

    // Draw selectable handles (Diamond = Sharp / Circle = Smooth)
    ['yellow1', 'yellow2'].forEach(cname => {
      state[cname].forEach((pt, idx) => {
        const px = pt.x * W, py = pt.y * H;
        const isSel = state.selectedPt.curve === cname && state.selectedPt.idx === idx;
        ctx.save();
        ctx.translate(px, py);
        if (pt.sharp) ctx.rotate(Math.PI / 4);
        ctx.fillStyle = isSel ? '#ffffff' : '#ffd60a';
        ctx.strokeStyle = '#14161a';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        if (pt.sharp) { ctx.rect(-7, -7, 14, 14); } else { ctx.arc(0, 0, 7, 0, Math.PI * 2); }
        ctx.fill(); ctx.stroke();
        ctx.restore();
      });
    });

    // Draw +Keep / -Drop mask pins
    state.pins.forEach(p => {
      const px = p.x * W, py = p.y * H;
      ctx.save();
      ctx.fillStyle = p.kind === 'keep' ? '#22c55e' : '#ef4444';
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(px, py, 9, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#fff'; ctx.font = 'bold 12px Adobe Clean, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(p.kind === 'keep' ? '+' : '×', px, py);
      ctx.restore();
    });

    document.getElementById('hudLeft').textContent = 'Déplacez un point jaune ou basculez Net/Doux (G) · Cliquez pour poser +Garder / -Exclure';
    const hr = document.getElementById('hudRight');
    hr.textContent = 'Losange = Angle Net · Cercle = Courbe Douce';
    hr.className = 'hud-chip ok';
  }
}

// Drag & Drop directly on Yellow curve points + Keep/Drop Pins!
let dragging = null;
cv.addEventListener('pointerdown', (e) => {
  if (state.mode !== 'cmy') return;
  const r = cv.getBoundingClientRect();
  const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
  if (state.pinMode) {
    pushUndo('Pin ' + (e.shiftKey ? '- Exclure' : '+ Garder') + ' posé');
    state.pins.push({ x, y, kind: e.shiftKey ? 'drop' : 'keep' });
    draw();
    return;
  }
  for (const cname of ['yellow1', 'yellow2']) {
    for (let i = 0; i < state[cname].length; i++) {
      const p = state[cname][i];
      if (Math.hypot(p.x - x, p.y - y) < 0.03) {
        pushUndo('Déplacement point jaune ' + (i + 1));
        state.selectedPt = { curve: cname, idx: i };
        document.getElementById('sharpBtn').textContent = 'Point sélectionné : ' + (p.sharp ? 'Net (Losange)' : 'Doux (Cercle)');
        dragging = state.selectedPt;
        cv.setPointerCapture(e.pointerId);
        draw();
        return;
      }
    }
  }
});
cv.addEventListener('pointermove', (e) => {
  if (!dragging) return;
  const r = cv.getBoundingClientRect();
  const pt = state[dragging.curve][dragging.idx];
  pt.x = Math.min(0.96, Math.max(0.04, (e.clientX - r.left) / r.width));
  pt.y = Math.min(0.96, Math.max(0.04, (e.clientY - r.top) / r.height));
  draw();
});
cv.addEventListener('pointerup', () => { dragging = null; });

// Controls wiring
document.querySelectorAll('[data-comp]').forEach(btn => {
  btn.addEventListener('click', () => {
    state.comp = btn.dataset.comp;
    if (state.comp === 'arm_flare') state.mode = 'cmy';
    else if (state.mode === 'cmy') state.mode = 'heatmap';
    document.querySelectorAll('[data-comp]').forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
    document.querySelectorAll('[data-mode]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.mode === state.mode)));
    const lamp = document.getElementById('houdiniLamp'), sc = document.getElementById('houdiniScore');
    if (state.comp === 'cuff_bottom') { lamp.className = 'l-dot l-bad'; sc.textContent = 'Bas 0,48'; }
    else if (state.comp === 'arm_flare') { lamp.className = 'l-dot l-warn'; sc.textContent = '2e pli à cuire'; }
    else { lamp.className = 'l-dot l-warn'; sc.textContent = 'Encoche à lisser'; }
    draw();
  });
});

document.querySelectorAll('[data-mode]').forEach(btn => {
  btn.addEventListener('click', () => {
    state.mode = btn.dataset.mode;
    if (state.mode === 'cmy' && state.comp !== 'arm_flare') {
      state.comp = 'arm_flare';
      document.querySelectorAll('[data-comp]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.comp === 'arm_flare')));
    }
    document.querySelectorAll('[data-mode]').forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
    draw();
  });
});

document.getElementById('slOnion').addEventListener('input', (e) => { state.onion = +e.target.value; document.getElementById('outOnion').textContent = state.onion + ' %'; draw(); });
document.getElementById('slThresh').addEventListener('input', (e) => { state.thresh = +e.target.value; document.getElementById('outThresh').textContent = state.thresh; draw(); });
document.getElementById('slCrease').addEventListener('input', (e) => {
  state.creaseWeight = +e.target.value / 100;
  document.getElementById('outCrease').textContent = state.creaseWeight.toFixed(2).replace('.', ',');
  draw();
});
document.getElementById('slThick').addEventListener('input', (e) => {
  state.thickScale = +e.target.value / 100;
  document.getElementById('outThick').textContent = e.target.value + ' %';
  draw();
});
document.getElementById('slRelief').addEventListener('input', (e) => {
  state.relief = +e.target.value / 100;
  document.getElementById('outRelief').textContent = state.relief.toFixed(2).replace('.', ',');
  draw();
});

document.getElementById('symBtn').addEventListener('click', (e) => {
  state.symGhost = !state.symGhost; e.target.setAttribute('aria-pressed', String(state.symGhost)); draw();
});
document.getElementById('keepBtn').addEventListener('click', (e) => {
  state.pinMode = !state.pinMode;
  e.target.setAttribute('aria-pressed', String(state.pinMode));
  document.getElementById('pinModeBtn').textContent = state.pinMode ? 'Mode : Poser +Garder/-Exclure' : 'Mode : Déplacer points';
});
document.getElementById('pinModeBtn').addEventListener('click', () => document.getElementById('keepBtn').click());

document.getElementById('applyBtn').addEventListener('click', () => {
  const payload = {
    component: state.comp === 'arm_flare' ? 'Arm_Flare' : 'Arm_Cuff',
    crease_fwhm_weight: state.creaseWeight,
    yellow_curves_edited: state.yellow1.length + state.yellow2.length,
    mask_pins: state.pins.length,
    thickness_scale: state.thickScale,
    trigger_downstream: ['ZenRayUV_M1', 'ZenRayHeight_5Maps']
  };
  document.getElementById('postLog').textContent = 'Envoyé au serveur (POST /api/apply) · ' + JSON.stringify(payload);
});

// Apply initial query string presets for inspection (?comp=...&mode=...)
if (paramsQS.get('theme')) root.setAttribute('data-theme', paramsQS.get('theme'));
if (paramsQS.get('comp')) {
  const b = document.querySelector(`[data-comp="${paramsQS.get('comp')}"]`);
  if (b) b.click();
}
if (paramsQS.get('mode')) {
  const b = document.querySelector(`[data-mode="${paramsQS.get('mode')}"]`);
  if (b) b.click();
}
</script>
</body>
