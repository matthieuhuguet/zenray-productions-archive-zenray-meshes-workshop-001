"""29 October 2026 : ZenRay Lines FACE DIAGNOSTIC : trace the faces of a document and list the ones that are not simple (a face with more than 6 arcs, or that uses an arc or a node twice), with the tube, ring and corner of the repeated nodes.
    python -I ZrlJunctionDiag.py doc.json --ref model.obj [--unit 0.1] [--feature-unit 1.0]
FR : liste les faces qui ne sont pas simples pour trouver où l'ordre de rotation des arcs est faux."""
import argparse, collections, json, os, sys
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import ZrlNetMesh as NM


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("doc"); ap.add_argument("--ref", required=True); ap.add_argument("--unit", type=float, default=0.1); ap.add_argument("--feature-unit", type=float, default=1.0); a = ap.parse_args()
    doc = json.load(open(a.doc)); A = {x["id"]: x for x in doc["arcs"]}; where = {}
    for nm, t in doc.get("tube_rings", {}).items():
        for ri, r in enumerate(t["rings"]):
            for ci, i in enumerate(r["nodes"]): where[i] = (nm, ri, ci)
    res = NM.build(doc, {"ref": os.path.abspath(a.ref), "unit": a.unit, "feature_unit": a.feature_unit, "edge_m": 0.02, "write_obj": False, "auto_fallback": True}); fs = res["faces"]
    print("faces", len(fs), "arcs per face", dict(sorted(collections.Counter(len(f["arcs"]) for f in fs).items())), "euler", res["stats"].get("euler_network"))
    for f in fs:
        ids = [x[0] for x in f["arcs"]]; nodes = [A[i]["a"] if s > 0 else A[i]["b"] for i, s in f["arcs"] if i in A]; rep = [n for n, c in collections.Counter(nodes).items() if c > 1]
        if len(ids) > 6 or len(set(ids)) < len(ids) or rep:
            print("face", f["id"], f["status"], f["reason"], f.get("component"), "arcs", len(ids), "distinct", len(set(ids)), "repeated nodes", [(n, where.get(n, "pole")) for n in rep][:8])


if __name__ == "__main__":
    main()
