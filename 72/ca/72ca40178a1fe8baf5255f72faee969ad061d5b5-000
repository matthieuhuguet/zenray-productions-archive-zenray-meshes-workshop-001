# 26 October 2026 : ZenRay Meshes, wood of an organic model SEEN ALONE (leaves removed) against the reference wood mask : recall, precision and IoU per
# view. It separates "the limbs are not where the sheet shows them" (low) from "the leaves hide them" (high here, low in ComponentScore). Shared organic tool.
# Usage: python UnoccludedWood.py <obj=tree> <tag> [part=branches]
import sys, os, json
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from PIL import Image
import ComponentScore as C, Raster, SheetScore
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"


def main(obj, tag, part="branches"):
    prm = json.load(open(W + "work/%s/component_params.json" % obj)); Pt = prm["paths"]; meta = json.load(open(W + Pt["frame"] + "/frame.json"))
    dl = np.load(W + Pt["topo"].format(tag=tag), allow_pickle=True); P, F, T, N = C.tri_render(dl); m = T == list(N).index(part); r = Raster.Renderer(P, F[m]); out = {}
    for v in meta["views"]:
        if v["name"] in prm.get("skip_views", []): continue
        mref = np.asarray(Image.open(W + Pt["frame"] + "/mask_%s.png" % v["name"])) > 127; w = np.asarray(Image.open(W + Pt["views"] + "/wood_%s.png" % v["name"])) > 127
        M, _ = SheetScore.render_in_panel(r, meta, v, mref.shape); out[v["name"]] = {"recall": round(float((M & w).sum() / w.sum()), 3), "precision": round(float((M & w).sum() / max(M.sum(), 1)), 3), "iou": round(float((M & w).sum() / (M | w).sum()), 3)}
    r.release(); out["mean_iou"] = round(float(np.mean([x["iou"] for x in out.values() if isinstance(x, dict)])), 3); print(json.dumps(out))


if __name__ == "__main__":
    main(*sys.argv[1:])
