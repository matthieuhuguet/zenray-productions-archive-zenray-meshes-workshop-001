"""31 October 2026 : LIGHTWEIGHT VOLUME PREVIEW of a guide pack, no Houdini : numpy only. revolve curves -> quad grids around the axis, extrude curves -> side quads + fan caps ; every part is flipped outward by its signed volume.
Writes parts/{tyre,rim_band,spokes,hub,dish}.obj (the names WheelOverlay.py reads) and wheel.obj, in the view frame, so the SAME overlay, comparison and render judge it in a second.
    python -I GuidePreview.py guides.json out_dir        FR : l'aperçu volumique léger d'un paquet de guides, sans Houdini."""
import sys, os, json, time
import numpy as np
t0 = time.time(); G = json.load(open(sys.argv[1])); out = sys.argv[2]; os.makedirs(out + "/parts", exist_ok=True)
def revolve(c):
    pr = np.array(c["points"])[:, [0, 2]]; n = len(pr); div = c["divisions"]; t = np.linspace(0, 2 * np.pi, div, endpoint=False)
    V = np.array([[r * np.cos(a), r * np.sin(a), z] for a in t for r, z in pr]); F = []
    for i in range(div):
        for j in range(n): F.append([i * n + j, ((i + 1) % div) * n + j, ((i + 1) % div) * n + (j + 1) % n, i * n + (j + 1) % n])
    return V, F
def extrude(c):
    P = np.array(c["points"]); n = len(P); T = P + [0, 0, c["depth"]]; V = np.vstack([P, T, P.mean(0, keepdims=True), T.mean(0, keepdims=True)]); F = []
    for i in range(n): F.append([i, (i + 1) % n, n + (i + 1) % n, n + i])
    for i in range(n): F.append([2 * n, (i + 1) % n, i]); F.append([2 * n + 1, n + i, n + (i + 1) % n])
    return V, F
def outward(V, F):
    vol = sum(np.dot(V[f[0]], np.cross(V[f[k]], V[f[k + 1]])) / 6 for f in F for k in range(1, len(f) - 1))
    return [f[::-1] for f in F] if vol < 0 else F
def write(path, parts):
    with open(path, "w") as fh:
        off = 0
        for V, F in parts:
            for v in V: fh.write("v %.6f %.6f %.6f\n" % tuple(v))
            for f in F: fh.write("f " + " ".join(str(k + off + 1) for k in f) + "\n")
            off += len(V)
parts = {"tyre": [], "rim_band": [], "spokes": [], "hub": [], "dish": []}
for c in G["curves"]:
    V, F = revolve(c) if c["role"] == "revolve" else extrude(c); F = outward(V, F)
    parts[{"rim": "rim_band"}.get(c["name"], "spokes" if c["name"].startswith("spoke_") else c["name"])].append((V, F))
for k, v in parts.items(): write(f"{out}/parts/{k}.obj", v)
write(f"{out}/wheel.obj", [p for v in parts.values() for p in v])
print("preview %.3f s" % (time.time() - t0), {k: sum(len(F) for _, F in v) for k, v in parts.items()})
