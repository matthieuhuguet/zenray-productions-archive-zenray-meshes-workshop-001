# 25 October 2026 : ZenRay Meshes, candidate methods run on the benchmark views (each returns a mesh in world space).
# EN: one function per method principle; inputs are only what a reference sheet gives (view masks, shading, px/m).
# Depth maps are never read by a method (they are diagnosis only).
# FR : une fonction par méthode, entrées = ce que donne une planche de vues, jamais la profondeur.
# Usage: python Methods.py <method> <views_dir> <out.obj> [k=v ...]
import sys, os, json
import numpy as np
from PIL import Image
from scipy import ndimage as ndi
from skimage import measure
import trimesh

LP_TIE = 0.005   # tolerance on the LP optimum when choosing the most balanced spans
VIEWS_ORDER = ["front", "back", "right", "left", "top", "bottom"]


def load_views(vdir):
    meta = json.load(open(os.path.join(vdir, "meta.json")))
    masks = {v: np.asarray(Image.open(os.path.join(vdir, "mask_%s.png" % v))) > 127 for v in VIEWS_ORDER}
    shade = {v: np.asarray(Image.open(os.path.join(vdir, "shade_%s.png" % v))).astype(float) / 255 for v in VIEWS_ORDER}
    return meta, masks, shade


def grid(meta, n):
    R, s = meta["res"], meta["px_per_m"]
    half = R / 2 / s
    c = np.array(meta["center"])
    ax = np.linspace(-half, half, n)
    X, Y, Z = np.meshgrid(ax, ax, ax, indexing="ij")
    return c, half, ax, np.stack([X, Y, Z], -1)


def project(meta, pts, view):
    R, s = meta["res"], meta["px_per_m"]
    rx, uy, tz = (np.array(a, float) for a in meta["views"][view])
    px = pts @ rx * s + R / 2
    py = R / 2 - pts @ uy * s
    return px, py


def to_mesh(occ, ax, c, out, smooth=0):
    f = occ.astype(float)
    if smooth:
        f = ndi.gaussian_filter(f, smooth)
    f = np.pad(f, 1)
    step = ax[1] - ax[0]
    verts, faces, _, _ = measure.marching_cubes(f, 0.5, spacing=(step, step, step))
    verts = verts - step + ax[0] + c
    m = trimesh.Trimesh(verts, faces[:, ::-1], process=False)
    m.export(out)
    return m


def m02_visual_hull(vdir, out, n=192, views=None, smooth=0.8):
    """M02: intersection of the six silhouette prisms (visual hull)."""
    meta, masks, _ = load_views(vdir)
    c, half, ax, G = grid(meta, int(n))
    pts = G.reshape(-1, 3)
    occ = np.ones(len(pts), bool)
    for v in (views or VIEWS_ORDER):
        px, py = project(meta, pts, v)
        ix, iy = np.clip(px.astype(int), 0, meta["res"] - 1), np.clip(py.astype(int), 0, meta["res"] - 1)
        occ &= masks[v][iy, ix]
    return to_mesh(occ.reshape(G.shape[:3]), ax, c, out, float(smooth))


def m01_inflate_front(vdir, out, n=192, ratio=1.0):
    """M01: single front view, round inflation by the distance transform (no other view used)."""
    meta, masks, _ = load_views(vdir)
    c, half, ax, G = grid(meta, int(n))
    s, R = meta["px_per_m"], meta["res"]
    m = masks["front"]
    dt = ndi.distance_transform_edt(m) / s
    Rr = np.maximum(ndi.maximum_filter(dt, size=25), dt)
    h = float(ratio) * np.sqrt(np.clip(Rr * Rr - (Rr - dt) ** 2, 0, None))
    pts = G.reshape(-1, 3)
    px, py = project(meta, pts, "front")
    ix, iy = np.clip(px.astype(int), 0, R - 1), np.clip(py.astype(int), 0, R - 1)
    zc = 0.0
    occ = m[iy, ix] & (np.abs(pts[:, 2] - zc) <= h[iy, ix])
    return to_mesh(occ.reshape(G.shape[:3]), ax, c, out, 0.8)


def m03_hull_shading_carve(vdir, out, n=192, thresh=0.06, smooth=0.8):
    """M03: visual hull, then carve voxels whose predicted Lambert shade disagrees with the reference shading
    in the views that see them (a light photo-consistency test, for concavities)."""
    meta, masks, shade = load_views(vdir)
    c, half, ax, G = grid(meta, int(n))
    pts = G.reshape(-1, 3)
    occ = np.ones(len(pts), bool)
    for v in VIEWS_ORDER:
        px, py = project(meta, pts, v)
        ix, iy = np.clip(px.astype(int), 0, meta["res"] - 1), np.clip(py.astype(int), 0, meta["res"] - 1)
        occ &= masks[v][iy, ix]
    occ = occ.reshape(G.shape[:3])
    for it in range(6):
        f = ndi.gaussian_filter(occ.astype(float), 1.0)
        gx, gy, gz = np.gradient(f)
        nrm = -np.stack([gx, gy, gz], -1); ln = np.linalg.norm(nrm, axis=-1) + 1e-9; nrm /= ln[..., None]
        surf = occ & ~ndi.binary_erosion(occ)
        idx = np.argwhere(surf)
        carve = np.zeros(len(idx), int); seen = np.zeros(len(idx), int)
        P = pts.reshape(G.shape)[surf]
        N = nrm[surf]
        for v in VIEWS_ORDER:
            tz = np.array(meta["views"][v][2], float)
            facing = N @ tz > 0.3
            px, py = project(meta, P, v)
            ix, iy = np.clip(px.astype(int), 0, meta["res"] - 1), np.clip(py.astype(int), 0, meta["res"] - 1)
            pred = 0.25 + 0.7 * np.abs(N @ tz)
            ref = shade[v][iy, ix]
            bad = facing & masks[v][iy, ix] & (np.abs(pred - ref) > 0.25)
            carve += bad; seen += facing
        kill = (seen > 0) & (carve >= np.maximum(1, seen * 0.67))
        if kill.sum() < 10:
            break
        occ[tuple(idx[kill].T)] = False
    return to_mesh(occ, ax, c, out, float(smooth))


METHODS = {"M01": m01_inflate_front, "M02": m02_visual_hull, "M03": m03_hull_shading_carve}


def m02b_hull_separable(vdir, out, n=512, smooth=0.8):
    """M02b: same visual hull, computed exactly at the mask resolution: orthographic axis views make the hull
    separable, occ(x,y,z) = AND over views of the mask at the voxel's two coordinates (no per voxel projection)."""
    meta, masks, _ = load_views(vdir)
    n = int(n); R = meta["res"]
    c, half, ax, _ = grid(meta, 2)
    ax = np.linspace(-half, half, n)
    pix = np.clip(((ax * meta["px_per_m"]) + R / 2).astype(int), 0, R - 1)       # coordinate -> column (right = +)
    pixd = np.clip((R / 2 - ax * meta["px_per_m"]).astype(int), 0, R - 1)         # coordinate -> row (up = +)
    occ = np.ones((n, n, n), bool)
    for v in VIEWS_ORDER:
        rx, uy, tz = (np.array(a, float) for a in meta["views"][v])
        ia = int(np.argmax(np.abs(rx))); ib = int(np.argmax(np.abs(uy)))
        cols = pix if rx[ia] > 0 else pix[::-1]
        rows = pixd if uy[ib] > 0 else pixd[::-1]
        m2 = masks[v][np.ix_(rows, cols)]            # m2[j over axis ib, i over axis ia]
        shape = [1, 1, 1]; shape[ib] = n; shape[ia] = n
        occ &= (m2.T if ia < ib else m2).reshape(shape)
    return to_mesh(occ, ax, c, out, float(smooth))

METHODS["M02b"] = m02b_hull_separable


def m04_hull_shading_eikonal(vdir, out, n=384, light_floor=0.25, light_gain=0.7, max_slope=6.0, smooth=0.8):
    """M04: visual hull, then each view's shading is read as |n . view| (viewport headlight), turned into a slope,
    and the eikonal equation |grad h| = slope with h = 0 on the silhouette gives a relief height per view.
    A voxel survives only if, for every view, it lies within the ray's mid depth + h toward that viewer."""
    import skfmm
    meta, masks, shade = load_views(vdir)
    n = int(n); R = meta["res"]; s = meta["px_per_m"]
    c, half, ax, _ = grid(meta, 2)
    ax = np.linspace(-half, half, n)
    X, Y, Z = np.meshgrid(ax, ax, ax, indexing="ij")
    P = np.stack([X, Y, Z], -1)
    hull = np.ones((n, n, n), bool)
    proj = {}
    for v in VIEWS_ORDER:
        px, py = project(meta, P.reshape(-1, 3), v)
        ix, iy = np.clip(px.astype(int), 0, R - 1), np.clip(py.astype(int), 0, R - 1)
        proj[v] = (ix, iy)
        hull &= masks[v][iy, ix].reshape(n, n, n)
    occ = hull.copy()
    for v in VIEWS_ORDER:
        m = masks[v]
        nz = np.clip((shade[v] - light_floor) / light_gain, 1.0 / np.sqrt(1 + max_slope ** 2), 1.0)
        slope = np.sqrt(1.0 / nz ** 2 - 1.0)
        phi = np.where(m, -1.0, 1.0)
        speed = 1.0 / np.maximum(slope, 1e-3)
        try:
            h = np.asarray(skfmm.travel_time(np.ma.MaskedArray(phi, ~m), speed, dx=1.0 / s).filled(0))
        except Exception:
            continue
        h = np.where(m, np.abs(h), 0)
        tz = np.array(meta["views"][v][2], float)
        d = (P.reshape(-1, 3) @ tz).reshape(n, n, n)     # depth toward the viewer
        ix, iy = proj[v]
        # mid depth of the hull along each ray of this view
        dh = np.where(hull, d, np.nan)
        key = iy * R + ix
        flat_d = dh.reshape(-1)
        okk = ~np.isnan(flat_d)
        mn = np.full(R * R, np.inf); mx = np.full(R * R, -np.inf)
        np.minimum.at(mn, key[okk], flat_d[okk]); np.maximum.at(mx, key[okk], flat_d[okk])
        mid = ((mn + mx) / 2)[key].reshape(n, n, n)
        occ &= d <= mid + h[iy, ix].reshape(n, n, n) + 1.0 / s
    return to_mesh(occ, ax, c, out, float(smooth))

METHODS["M04"] = m04_hull_shading_eikonal


def m00_oracle_depth(vdir, out, n=384, smooth=0.8):
    """M00 (oracle, diagnosis only): carve with the TRUE depth of each of the six views. It is the ceiling of any
    method that reads only six orthographic views; it is not a method."""
    meta, masks, _ = load_views(vdir)
    n = int(n); R = meta["res"]; s = meta["px_per_m"]
    c, half, ax, _ = grid(meta, 2)
    ax = np.linspace(-half, half, n)
    X, Y, Z = np.meshgrid(ax, ax, ax, indexing="ij"); P = np.stack([X, Y, Z], -1).reshape(-1, 3)
    occ = np.ones(len(P), bool)
    for v in VIEWS_ORDER:
        dm = np.load(os.path.join(vdir, "depth_%s.npy" % v))
        px, py = project(meta, P, v)
        ix, iy = np.clip(px.astype(int), 0, R - 1), np.clip(py.astype(int), 0, R - 1)
        tz = np.array(meta["views"][v][2], float)
        dd = dm[iy, ix]
        occ &= ~np.isnan(dd) & (P @ tz <= np.nan_to_num(dd, nan=-1e9) + 1.5 / s)
    return to_mesh(occ.reshape(n, n, n), ax, c, out, float(smooth))

METHODS["M00"] = m00_oracle_depth


def integrate_normals(nrm, mask, px_per_m, min_nz=0.08, jump=0.6):
    """Least squares integration of a camera space normal map into depth (metres, toward viewer), per region.
    Gradient equations are dropped across normal jumps (depth discontinuities) and where the surface is grazing."""
    import scipy.sparse as sp
    from scipy.sparse.linalg import lsqr
    H, W = mask.shape
    idx = -np.ones((H, W), int); ys, xs = np.nonzero(mask); idx[ys, xs] = np.arange(len(ys))
    nz = np.clip(nrm[..., 2], min_nz, None)
    gx = -nrm[..., 0] / nz / px_per_m        # d depth / d column, metres per pixel
    gy = nrm[..., 1] / nz / px_per_m         # d depth / d row (rows go down, y up)
    rows, cols, vals, rhs = [], [], [], []
    r = 0
    for dy, dx, g in ((0, 1, gx), (1, 0, gy)):
        a = idx[: H - dy, : W - dx]; b = idx[dy:, dx:]
        ok = (a >= 0) & (b >= 0)
        na, nb = nrm[: H - dy, : W - dx], nrm[dy:, dx:]
        ok &= (np.abs(na - nb).sum(-1) < jump) & (nrm[: H - dy, : W - dx, 2] > min_nz) & (nrm[dy:, dx:, 2] > min_nz)
        ga = 0.5 * (g[: H - dy, : W - dx] + g[dy:, dx:])
        aa, bb, gg = a[ok], b[ok], ga[ok]
        k = np.arange(r, r + len(aa)); r += len(aa)
        rows += [k, k]; cols += [bb, aa]; vals += [np.ones(len(aa)), -np.ones(len(aa))]; rhs.append(gg)
    # weak anchor to zero so every region is defined
    k = np.arange(r, r + len(ys)); r += len(ys)
    rows.append(k); cols.append(np.arange(len(ys))); vals.append(np.full(len(ys), 1e-3)); rhs.append(np.zeros(len(ys)))
    A = sp.csr_matrix((np.concatenate(vals), (np.concatenate(rows), np.concatenate(cols))), shape=(r, len(ys)))
    z = lsqr(A, np.concatenate(rhs), atol=1e-8, btol=1e-8, iter_lim=4000)[0]
    D = np.full((H, W), np.nan); D[ys, xs] = z
    # regions = connected parts of the gradient graph, each gets its own unknown offset
    import scipy.ndimage as nd
    edges_ok = mask.copy()
    return D


def m05_normal_integration(vdir, out, n=320, smooth=0.8, tol_px=2.0):
    """M05: the sheet gives a camera space NORMAL map per view (input contract to request from the image prompt).
    Each view is integrated into a depth map; its unknown offset (per connected region) is fixed by the visual hull's
    nearest depth on that region; then voxels are carved exactly like the depth oracle."""
    meta, masks, _ = load_views(vdir)
    n = int(n); R = meta["res"]; s = meta["px_per_m"]
    c, half, ax, _ = grid(meta, 2)
    ax = np.linspace(-half, half, n)
    X, Y, Z = np.meshgrid(ax, ax, ax, indexing="ij"); P = np.stack([X, Y, Z], -1).reshape(-1, 3)
    hull = np.ones(len(P), bool); proj = {}
    for v in VIEWS_ORDER:
        px, py = project(meta, P, v)
        ix, iy = np.clip(px.astype(int), 0, R - 1), np.clip(py.astype(int), 0, R - 1)
        proj[v] = (ix, iy); hull &= masks[v][iy, ix]
    occ = hull.copy()
    for v in VIEWS_ORDER:
        nimg = np.asarray(Image.open(os.path.join(vdir, "normal_%s.png" % v))).astype(float) / 255 * 2 - 1
        m = masks[v]
        D = integrate_normals(nimg, m, s)
        tz = np.array(meta["views"][v][2], float)
        ix, iy = proj[v]
        d = P @ tz
        key = iy * R + ix
        mx = np.full(R * R, -np.inf)
        np.maximum.at(mx, key[hull], d[hull])
        hullfront = mx.reshape(R, R)
        # offset per region: regions = connected components of mask where normals are continuous
        jumps = np.zeros_like(m)
        jumps[:, 1:] |= np.abs(nimg[:, 1:] - nimg[:, :-1]).sum(-1) > 0.6
        jumps[1:, :] |= np.abs(nimg[1:] - nimg[:-1]).sum(-1) > 0.6
        lab, nl = ndi.label(m & ~jumps)
        Dfix = np.full_like(D, np.nan)
        for i in range(1, nl + 1):
            reg = lab == i
            ok = reg & np.isfinite(hullfront) & np.isfinite(D)
            if ok.sum() < 3:
                continue
            off = np.percentile((hullfront - D)[ok], 5)   # surface lies at or behind the hull front: smallest gap
            Dfix[reg] = D[reg] + off
        Dfix = ndi.generic_filter(np.nan_to_num(Dfix, nan=-1e9), np.max, size=3)
        dd = Dfix[iy, ix]
        occ &= d <= dd + tol_px / s
    return to_mesh(occ.reshape(n, n, n), ax, c, out, float(smooth))

METHODS["M05"] = m05_normal_integration


def xs_map(meta, va, vb, R):
    ra = np.array(meta["views"][va][0], float); rb = np.array(meta["views"][vb][0], float)
    ua = np.array(meta["views"][va][1], float); ub = np.array(meta["views"][vb][1], float)
    return (ra @ rb > 0, ua @ ub > 0)


def span_lp(ia, ib, ma, mb, ha, hb, same, R, pct=1.0, erode=0, max_grad=0.0):
    """Opposite views a, b: thickness at every common pixel is (ha - sa (1 - a)) + (hb - sb (1 - b)) >= 0.
    The true spans are the largest that keep every thickness non negative (thin parts and rims touch zero):
    maximise sa * sum(1 - a) + sb * sum(1 - b) under those constraints (2 variable linear program).
    pct trims the tightest constraints as noise."""
    from scipy.optimize import linprog
    if erode:
        ma = ndi.binary_erosion(ma, iterations=int(erode)); mb = ndi.binary_erosion(mb, iterations=int(erode))
    if max_grad:
        # only smooth regions: blurred depth discontinuities give false tight constraints
        for im, mm in ((ia, ma), (ib, mb)):
            gy, gx = np.gradient(im)
            mm &= ~ndi.binary_dilation(np.hypot(gx, gy) > max_grad, iterations=3)
    ys, xs = np.nonzero(ma)
    xb = xs if same[0] else R - 1 - xs
    yb = ys if same[1] else R - 1 - ys
    ok = mb[yb, xb]
    a = 1 - ia[ys[ok], xs[ok]]; b = 1 - ib[yb[ok], xb[ok]]
    H = ha + hb
    A = np.stack([a, b], 1)
    bnd = [(0, 4 * H), (0, 4 * H)]
    if pct > 0 and len(a) > 200:
        # noise and quantisation: drop the pct percent of pixels that bind first at the balanced solution
        r0 = linprog(c=[-a.sum(), -b.sum()], A_ub=A, b_ub=np.full(len(a), H), bounds=bnd, method="highs")
        slack = H - A @ r0.x
        keep = slack > np.percentile(slack, pct)
        A = A[keep]; a = a[keep]; b = b[keep]
    r1 = linprog(c=[-a.sum(), -b.sum()], A_ub=A, b_ub=np.full(len(a), H), bounds=bnd, method="highs")
    best = -r1.fun
    # tie break: among optimal solutions (same objective), the most balanced spans (symmetric pairs are degenerate)
    c2 = [0, 0, 1]
    A2 = np.vstack([np.hstack([A, np.zeros((len(A), 1))]), [1, -1, -1], [-1, 1, -1], [-a.sum(), -b.sum(), 0]])
    b2 = np.concatenate([np.full(len(A), H), [0, 0, -best * (1 - LP_TIE)]])
    r2 = linprog(c=c2, A_ub=A2, b_ub=b2, bounds=bnd + [(0, None)], method="highs")
    x = r2.x if r2.success else r1.x
    return float(x[0]), float(x[1])


def m06_depth_sheet(vdir, out, n=320, bits=8, blur=0.0, noise=0.0, smooth=0.8, tol_px=1.5, seed=0, affine="oracle", lp_pct=1.0, lp_erode=0, lp_grad=0.0):
    """M06: the sheet gives a DEPTH map per view, as an image generator would: normalised per view to 0..1 over the
    object (near = white), quantised to `bits`, optionally blurred and noisy. The per view affine is recovered exactly
    from the visual hull's extent along the view axis (the other views fix it), then voxels are carved like M00."""
    meta, masks, _ = load_views(vdir)
    rng = np.random.default_rng(int(seed))
    n = int(n); R = meta["res"]; s = meta["px_per_m"]
    c, half, ax, _ = grid(meta, 2)
    ax = np.linspace(-half, half, n)
    X, Y, Z = np.meshgrid(ax, ax, ax, indexing="ij"); Pp = np.stack([X, Y, Z], -1).reshape(-1, 3)
    hull = np.ones(len(Pp), bool); proj = {}
    for v in VIEWS_ORDER:
        px, py = project(meta, Pp, v)
        ix, iy = np.clip(px.astype(int), 0, R - 1), np.clip(py.astype(int), 0, R - 1)
        proj[v] = (ix, iy); hull &= masks[v][iy, ix]
    occ = hull.copy()
    imgs, spans = {}, {}
    for v in VIEWS_ORDER:
        dt = np.load(os.path.join(vdir, "depth_%s.npy" % v)); mm = masks[v]
        lo_, hi_ = np.nanmin(dt), np.nanmax(dt)
        im = np.where(mm, (dt - lo_) / (hi_ - lo_), 0)
        if blur:
            w = ndi.gaussian_filter(mm.astype(float), float(blur)); im = ndi.gaussian_filter(im, float(blur)) / np.maximum(w, 1e-6)
        if noise:
            im = im + rng.normal(0, float(noise), im.shape)
        qq = (2 ** int(bits)) - 1
        imgs[v] = np.round(np.clip(im, 0, 1) * qq) / qq
    if affine in ("rim", "lp"):
        # opposite views share their silhouette rim (mirrored); there the front and back surfaces meet:
        # hhi_a - span_a (1 - a) = -(hhi_b - span_b (1 - b)), linear in the two spans, solved by least squares.
        pairs = [("front", "back"), ("right", "left"), ("top", "bottom")]
        for va, vb in pairs:
            tza = np.array(meta["views"][va][2], float); tzb = np.array(meta["views"][vb][2], float)
            da = Pp[hull] @ tza; db = Pp[hull] @ tzb
            ha, hb = da.max(), db.max()
            ma = masks[va]; rim = ma & ~ndi.binary_erosion(ma, iterations=2)
            ys, xs = np.nonzero(rim)
            # pixel (x, y) of view a is pixel (R-1-x, y) of view b when the right axis flips (front/back, left/right), (x, R-1-y) for top/bottom
            ra = np.array(meta["views"][va][0], float); rb = np.array(meta["views"][vb][0], float)
            ua = np.array(meta["views"][va][1], float); ub = np.array(meta["views"][vb][1], float)
            xb = xs if ra @ rb > 0 else R - 1 - xs
            yb = ys if ua @ ub > 0 else R - 1 - ys
            ok = masks[vb][yb, xb]
            a = imgs[va][ys[ok], xs[ok]]; b = imgs[vb][yb[ok], xb[ok]]
            spans[va], spans[vb] = span_lp(imgs[va], imgs[vb], masks[va], masks[vb], ha, hb, xs_map(meta, va, vb, R), R, float(lp_pct), int(lp_erode), float(lp_grad))
    for v in VIEWS_ORDER:
        tz = np.array(meta["views"][v][2], float)
        dtrue = np.load(os.path.join(vdir, "depth_%s.npy" % v))
        m = masks[v]
        lo, hi = np.nanmin(dtrue), np.nanmax(dtrue)
        img = np.where(m, (dtrue - lo) / (hi - lo), 0)          # what a generator would draw
        if blur:
            w = ndi.gaussian_filter(m.astype(float), float(blur)); img = ndi.gaussian_filter(img, float(blur)) / np.maximum(w, 1e-6)
        if noise:
            img = img + rng.normal(0, float(noise), img.shape)
        q = (2 ** int(bits)) - 1
        img = np.round(np.clip(img, 0, 1) * q) / q
        # recover the affine from the hull: depth range of the hull along tz
        d = Pp @ tz
        hhi = d[hull].max()                     # front extreme: known from the hull (equals the object's)
        if affine == "oracle":
            hlo = lo                            # diagnosis: true deepest visible depth
        elif affine in ("rim", "lp"):
            hlo = hhi - spans[v]
        else:
            # estimate the depth span: the largest span whose carving keeps every perpendicular silhouette whole
            best = None
            for frac in np.linspace(0.15, 1.0, 18):
                span = frac * (hhi - d[hull].min())
                dd0 = np.where(m, hhi - span + img * span, np.nan)[proj[v][1], proj[v][0]]
                keep = hull & ~np.isnan(dd0) & (d <= np.nan_to_num(dd0, nan=-1e9) + tol_px / s + span / q)
                worst = 1.0
                for w in VIEWS_ORDER:
                    if abs(np.dot(np.array(meta["views"][w][2], float), tz)) > 0.5:
                        continue
                    ix2, iy2 = proj[w]
                    cov = np.zeros(R * R, bool); cov[(iy2 * R + ix2)[keep]] = True
                    mw = masks[w].ravel(); worst = min(worst, (cov & mw).sum() / max(mw.sum(), 1))
                if worst > 0.995:
                    best = span; break
            hlo = hhi - (best if best is not None else (hhi - d[hull].min()))
        dep = np.where(m, hlo + img * (hhi - hlo), np.nan)
        ix, iy = proj[v]
        dd = dep[iy, ix]
        occ &= ~np.isnan(dd) & (d <= np.nan_to_num(dd, nan=-1e9) + tol_px / s + (hhi - hlo) / q)
    return to_mesh(occ.reshape(n, n, n), ax, c, out, float(smooth))

METHODS["M06"] = m06_depth_sheet

