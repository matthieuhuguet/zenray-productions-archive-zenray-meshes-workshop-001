"""28 October 2026 : ZenRay Meshes RETOPO, tuning of the winner R07 : contour fairing sigma (samples) and bending stiffness lambda.
python Tune07.py   FR : réglage du vainqueur, lissage des contours et raideur de flexion."""
import json, sys, os, itertools
import numpy as np
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import Common as C
import RetopoMethods as M
rows = []
for sg, lam in itertools.product((0, 3, 6), (2, 4, 8, 16)):
    C.PARAMS["contour_sigma"] = sg; C.PARAMS["r07_lambda"] = lam; C._CT = None
    P, Q = M.R07(); P, Q = C.compact(np.asarray(P, float), [list(map(int, q)) for q in Q]); m = C.measure(P, Q)
    rows.append({"sigma": sg, "lambda": lam, **{k: m[k] for k in ("dev_p95_mm", "fair_p95_deg", "shading_ratio", "outline_top_mm", "crease_on_edges", "weld_ready")}})
    C.save_cand(C.RT + "fender/meshes/R07_s%d_l%d.npz" % (sg, lam), P, Q); print(json.dumps(rows[-1]), flush=True)
json.dump(rows, open(C.RT + "fender/Tune07.json", "w"), indent=1)
