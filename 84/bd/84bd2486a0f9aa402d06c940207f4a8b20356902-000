#!/bin/zsh
# 2 November 2026 : the head kept as it is, its sculpt relaxed then refitted, ending on the used views and the views never seen. FR : la tête gardée telle quelle, son sculpt relâché puis réajusté, avec les vues utilisées et les vues jamais vues à la fin.
# Usage : HeadPolish.sh <v3 folder> <relax> <minutes> <fair> <brushes>
cd "$1" || exit 1
HY=/Applications/Houdini/Current/Frameworks/Houdini.framework/Versions/Current/Resources/bin/hython; PY=/Users/zenray/.venvs/zenray-meshes/bin/python; C=../../../Scripts/Dracard/Comp; V=$(cat parts/head_views.txt)
cp parts/h4/sculpt.json parts/h4/sculpt_before_polish.json; cp parts/h4/cams_after_fit.json parts/h4/cams.json
$PY -I $C/CompFit.py parts/h4 full/ep04 "" --assembled $V --symmetric 1 --fixed parts/h3/out_ears.obj,parts/h3/out_teeth.obj --levels 0 --minutes $3 --cam-range 8 --protect parts/h3/report.json --centers 200 --grey 6 --relax $2 --brushes $5 --fair $4 --landmarks parts/read/lm.json --lm 14 2>&1 | grep -E '^score|relaxed|Traceback' | cut -c1-260
perl -e 'alarm 200; exec @ARGV' $HY $C/ChainBuild.py parts/head_s4.json parts/h4 2>&1 | grep -E 'Error|Traceback' | cut -c1-200
python3 - <<'PY'
out = open("parts/h4/all.obj", "w"); off = 0
for f in ("parts/h4/part.obj", "parts/h3/out_teeth.obj", "parts/h3/out_ears.obj"):
    n = 0
    for l in open(f):
        if l.startswith("v "): out.write(l); n += 1
        elif l.startswith("f "): out.write("f " + " ".join(str(int(x.split("/")[0]) + off) for x in l.split()[1:]) + "\n")
    off += n
out.close()
PY
cp parts/h4/all.obj parts/h4v/part.obj; cp parts/h4/cams.json parts/h4v/cams.json; $PY -I $C/PartBoard.py parts/h4v full/ep04 ${V} parts/h4v/board.png --mask grey --tile 300 2>&1 | tail -2 | cut -c1-420; $PY -I $C/LandmarkDist.py parts/h4/part.obj parts/read/lm.json | tail -1
U=$(cat parts/head_unseen.txt); cp parts/h4/cams.json parts/h4/cams_after_fit.json; echo UNSEEN; $PY -I $C/CompFit.py parts/h4 full/ep04 "" --symmetric 1 --fixed parts/h3/out_ears.obj,parts/h3/out_teeth.obj --assembled $U --levels 0 --check 1 --cam-range 8 2>&1 | grep -E '^score|Traceback' | cut -c1-300; cp parts/h4/cams_after_fit.json parts/h4/cams.json; echo POLISH_DONE
