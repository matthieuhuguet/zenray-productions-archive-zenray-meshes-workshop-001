# 29 October 2026 : ZenRay Lines SERVER, serves lines/ on 127.0.0.1 and takes the edited network from the editor.
# EN: static files from lines/ plus one endpoint, POST /save : the body (the editor's lines JSON) is validated and written to
#     lines/data/lines_edit.json (atomic write). A previous lines_edit.json is first copied to lines/data/backups/ with a timestamp.
#     lines.json, the exporter's file, is never touched. Loopback only, no external dependency.
#     python ZrlServe.py [--port 8765] [--auto-port] [--port-file lines/server.port]
#     Background :  nohup python ZrlServe.py > lines/server.log 2>&1 & echo $! > lines/server.pid
# FR : serveur local du dossier lines/, avec POST /save qui écrit lines_edit.json (sauvegarde horodatée de la version précédente).
import time, argparse, datetime, json, os, shutil, sys
sys.dont_write_bytecode = True
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
PARAMS = {   # 29 October 2026 : the interface of the server, every tunable value lives here
    "root": f"{ROOT}/lines",
    "host": "127.0.0.1",
    "port": 8765,
    "auto_port_tries": 20,               # with --auto-port : how many consecutive ports are tried when the first one is busy
    "save_path": "/save",
    "edit_file": "data/lines_edit.json",
    "backup_dir": "data/backups",
    "auto_backup_s": 600,                # 29 October 2026 : autosaves keep one backup per this many seconds
    "protected": ["data/lines.json"],    # files that /save can never write
    "max_body_mb": 24,
    "mesh_paths": {"/doctor": "doctor", "/mesh": "mesh", "/faces": "faces", "/houdini": "houdini", "/project": "project", "/model": "model", "/crease_path": "crease_path", "/creases": "creases", "/crease_align": "crease_align", "/chain": "chain", "/auto_patch": "auto_patch", "/crease_net": "crease_net", "/lod": "lod", "/openings": "openings"},   # 29 October 2026 : netmesh endpoints (body {"lines": doc, "params": {...}})
    "lines_dir": f"{ROOT}/Scripts/lines",
    "export_path": "/export",            # 29 October 2026 : the editor's exports (PNG, SVG, OBJ, JSON) land in the atelier, never in Downloads
    "export_dir": f"{ROOT}/work/lines/exports",
    "export_exts": [".png", ".svg", ".obj", ".json", ".py"],
}
MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]


def stamp(now=None):
    now = now or datetime.datetime.now()
    return "%d-%s-%d_%s" % (now.day, MONTHS[now.month - 1], now.year, now.strftime("%H%M%S"))     # 29-October-2026_104217


def _no_constant(c):
    raise ValueError("a non finite number (%s) cannot be saved" % c)


def check_document(doc):
    """29 October 2026 : a document is refused before it touches the disk when it is not made of finite control point matrices, when an id repeats, when an arc
    ends on a point that does not exist or when a mirror points at nothing. A curve is a matrix (n x 3, metres) : nothing else is ever saved (no SVG, no PNG)."""
    import math
    if not isinstance(doc, dict) or not isinstance(doc.get("nodes"), list) or not isinstance(doc.get("arcs"), list):
        raise ValueError("not a lines document (nodes and arcs expected)")
    ids = set()
    for n in doc["nodes"]:
        p = n.get("p") if isinstance(n, dict) else None
        if not isinstance(n, dict) or not isinstance(n.get("id"), int) or n["id"] in ids: raise ValueError("node id missing or repeated : %s" % (n.get("id") if isinstance(n, dict) else "?"))
        if not (isinstance(p, list) and len(p) == 3 and all(isinstance(x, (int, float)) and math.isfinite(x) for x in p)): raise ValueError("node %s has a bad position" % n["id"])
        ids.add(n["id"])
    arc_ids = set()
    for a in doc["arcs"]:
        c = a.get("ctrl") if isinstance(a, dict) else None
        if not isinstance(a, dict) or not isinstance(a.get("id"), int) or a["id"] in arc_ids: raise ValueError("arc id missing or repeated : %s" % (a.get("id") if isinstance(a, dict) else "?"))
        if not isinstance(c, list) or len(c) < 2 or not all(isinstance(p, list) and len(p) == 3 and all(isinstance(x, (int, float)) and math.isfinite(x) for x in p) for p in c):
            raise ValueError("arc %s has bad control points" % a["id"])
        for k in ("a", "b"):
            if isinstance(a.get(k), int) and a[k] >= 0 and a[k] not in ids: raise ValueError("arc %s ends on point %s, which does not exist" % (a["id"], a[k]))
        arc_ids.add(a["id"])
    for a in doc["arcs"]:
        m = a.get("mirror")
        if isinstance(m, int) and m >= 0 and m not in arc_ids: raise ValueError("arc %s is mirrored by arc %s, which does not exist" % (a["id"], m))


def save_edit(body, root, prm=PARAMS, auto=False, project=None):
    """Validate the posted document and write it atomically to the edit file. Returns the answer of the endpoint.
    29 October 2026 : an autosave (?auto=1) copies the previous file to backups/ only when the newest backup is older than auto_backup_s : an editing session does not bury the folder."""
    doc = json.loads(body.decode("utf-8"), parse_constant=_no_constant)       # NaN and Infinity are refused here
    check_document(doc)
    import hashlib, ZrlProjects as PR                                      # 29 October 2026 : the edit file of the open project ; the car is lines/data as before
    pdir = PR.data_dir(project); edit_rel = prm["edit_file"] if pdir == PR.PARAMS["car_dir"] else os.path.relpath(os.path.join(pdir, "lines_edit.json"), root)
    target = os.path.realpath(os.path.join(root, edit_rel))
    if os.path.relpath(target, os.path.realpath(root)) in [os.path.normpath(p) for p in prm["protected"]]:
        raise ValueError("refusing to write a protected file")
    os.makedirs(os.path.dirname(target), exist_ok=True)
    backup = None
    bdir = os.path.join(os.path.dirname(target), "backups")
    recent = auto and os.path.isdir(bdir) and any(time.time() - os.path.getmtime(os.path.join(bdir, f)) < prm["auto_backup_s"] for f in os.listdir(bdir))
    if os.path.exists(target) and not recent:
        os.makedirs(bdir, exist_ok=True)
        backup = os.path.join(bdir, "lines_edit_%s.json" % stamp())
        n = 1
        while os.path.exists(backup):                       # two saves inside the same second
            n += 1
            backup = os.path.join(bdir, "lines_edit_%s_%d.json" % (stamp(), n))
        shutil.copy2(target, backup)
    tmp = target + ".tmp"
    with open(tmp, "wb") as f:
        f.write(body); f.flush(); os.fsync(f.fileno())                      # 29 October 2026 : on the disk, not only in the cache, before the old file is replaced
    os.replace(tmp, target)
    try:
        fd = os.open(os.path.dirname(target), os.O_RDONLY); os.fsync(fd); os.close(fd)
    except OSError: pass
    want = hashlib.sha256(body).hexdigest()
    with open(target, "rb") as f: got = hashlib.sha256(f.read()).hexdigest()  # read back : the answer says ok only when the file on the disk is the document that was posted
    if got != want: raise IOError("the saved file does not match the posted document (sha256 %s against %s) ; the previous version is in %s" % (got[:12], want[:12], backup or "backups"))
    return {"ok": True, "path": target, "bytes": len(body), "arcs": len(doc["arcs"]), "nodes": len(doc["nodes"]), "backup": backup, "sha256": got}


def save_export(body, prm=PARAMS):
    """29 October 2026 : POST /export {"name": "view.png", "data": data URL or text} : written to work/lines/exports/<stem>_<date>.<ext>."""
    import base64, re
    req = json.loads(body.decode("utf-8")); name = os.path.basename(str(req.get("name") or "export")); data = req.get("data")
    stem, ext = os.path.splitext(name); ext = ext.lower()
    if ext not in prm["export_exts"]: raise ValueError("extension %s refused" % (ext or "(none)"))
    stem = re.sub(r"[^A-Za-z0-9_.-]+", "_", stem)[:80] or "export"
    if isinstance(data, str) and data.startswith("data:"): raw = base64.b64decode(data.split(",", 1)[1])
    elif isinstance(data, str): raw = data.encode("utf-8")
    else: raise ValueError("data must be a string")
    os.makedirs(prm["export_dir"], exist_ok=True); path = os.path.join(prm["export_dir"], "%s_%s%s" % (stem, stamp(), ext))
    with open(path, "wb") as f: f.write(raw)
    return {"ok": True, "path": path, "bytes": len(raw)}


def run_netmesh(kind, body, prm=PARAMS):
    """29 October 2026 : POST /doctor, /mesh, /faces (body {"lines": doc, "params": {...}}) and /houdini (body of ZrlHoudiniLink.handle).
    The python -I server has no script folder on sys.path : the Scripts/lines folder is added here. Raises on any error (the caller answers 500)."""
    if prm["lines_dir"] not in sys.path: sys.path.insert(0, prm["lines_dir"])
    req = json.loads(body.decode("utf-8"))
    if kind == "houdini":
        import ZrlHoudiniLink
        return ZrlHoudiniLink.handle(req)
    if kind == "auto_patch":                                # 29 October 2026 : a click gives the four sided patch of the zone, or a point snapped to a contour (ZrlAutoPatch.py)
        import ZrlAutoPatch
        return ZrlAutoPatch.handle(req)
    if kind == "chain":                                     # 29 October 2026 : the chain file, its build in Houdini and the pull of its curves (ZrlChain.py)
        import ZrlChain
        return ZrlChain.handle(req)
    if kind == "openings":                                  # 29 October 2026 : concentric rings around an opening, a face convention (ZrlOpenings.py)
        import ZrlOpenings
        return ZrlOpenings.handle(req)
    if kind == "lod":                                       # 29 October 2026 : Catmull-Clark levels of a quad mesh, fitted back to the model (ZrlLod.py)
        import ZrlLod
        return ZrlLod.handle(req)
    if kind == "crease_net":                                # 29 October 2026 : every crease of the model as curves (ZrlCreaseNet.py), in a child process like the other crease endpoints
        import subprocess
        r = subprocess.run([sys.executable, "-I", "-B", os.path.join(prm["lines_dir"], "ZrlCreaseNet.py"), "--handle"], input=json.dumps(req), capture_output=True, text=True, timeout=600)
        if r.returncode != 0: raise RuntimeError("crease net failed : " + (r.stderr or r.stdout)[-400:])
        return json.loads(r.stdout.strip().splitlines()[-1])
    if kind == "creases": req = dict(req, op="map"); kind = "crease_path"   # 29 October 2026 : the crease layer, same child process
    if kind == "crease_align": req = dict(req, op="align"); kind = "crease_path"   # 29 October 2026 : edges of the mesh on the creases, same child process
    if kind == "crease_path":                               # 29 October 2026 : a drawn curve that follows the creases seen from the camera (ZrlCreases.py), in a child process
        import subprocess
        r = subprocess.run([sys.executable, "-I", "-B", os.path.join(prm["lines_dir"], "ZrlCreases.py"), "--handle"], input=json.dumps(req), capture_output=True, text=True, timeout=180)
        if r.returncode != 0: raise RuntimeError("crease path failed : " + (r.stderr or r.stdout)[-400:])
        return json.loads(r.stdout.strip().splitlines()[-1])
    if kind == "model":                                     # 29 October 2026 : a new model version becomes the source of truth (ZrlUseModel.py)
        import ZrlUseModel
        import ZrlProjects as PR
        return ZrlUseModel.run(req["obj"], prm=dict(ZrlUseModel.PARAMS, data=PR.data_dir(req.get("project"))), views=req.get("views", True))
    import ZrlNetMesh as NM
    if not isinstance(req, dict) or "lines" not in req: raise ValueError('body must be {"lines": document, "params": {...}}')
    doc = req["lines"]; check_document(doc); params = req.get("params") or {}
    return {"doctor": NM.doctor, "mesh": NM.build, "faces": NM.faces_report, "project": NM.project_doc}[kind](doc, params)


def code_version(root, lines_dir):
    """29 October 2026 : the version of the code on disk : the page (html, js, css of lines/) and the Python modules of Scripts/lines, from their
    names, sizes and modification times ; cheap enough to be asked every 3 s, and it moves as soon as a file is saved."""
    import hashlib
    def h(folder, exts):
        parts = []
        for f in sorted(os.listdir(folder)):
            if f.endswith(exts):
                st = os.stat(os.path.join(folder, f)); parts.append("%s:%d:%d" % (f, st.st_size, int(st.st_mtime * 1000)))
        return hashlib.sha1("|".join(parts).encode()).hexdigest()[:12]
    return h(root, (".html", ".js", ".css")), h(lines_dir, (".py",))


PY_AT_START = {}


def make_handler(root, prm):
    class Handler(SimpleHTTPRequestHandler):
        server_version = "ZenRayLines/1"

        def __init__(self, *a, **kw):
            super().__init__(*a, directory=root, **kw)

        def end_headers(self):
            self.send_header("Cache-Control", "no-store")     # the editor and its data are edited while the server runs
            super().end_headers()

        def reply(self, code, obj):
            data = json.dumps(obj).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            path = self.path.split("?")[0]
            if path == "/api/lines/version":                   # 29 October 2026 : the page and the launcher ask which code runs (see version-guard.js, ZenRayLines.sh)
                web, py = code_version(root, prm["lines_dir"]); PY_AT_START.setdefault("py", py)
                return self.reply(200, {"app": "zenray-lines", "web": web, "py_loaded": PY_AT_START["py"], "py_now": py, "pid": os.getpid()})
            if path == "/api/projects":                         # 29 October 2026 : the projects (one folder of work per model)
                import ZrlProjects as PR
                return self.reply(200, PR.handle({"op": "list"}))
            return super().do_GET()

        def do_POST(self):
            path = self.path.split("?")[0]
            if path == "/api/lines/restart":                   # 29 October 2026 : the Python code changed : the server relaunches itself (ZrlServeRestart.sh, detached)
                import subprocess
                script = os.path.join(prm["lines_dir"], "ZrlServeRestart.sh")
                subprocess.Popen(["/bin/zsh", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                return self.reply(200, {"ok": True, "restarting": True})
            if path == "/api/projects":
                try:
                    import ZrlProjects as PR
                    n = int(self.headers.get("Content-Length", "0")); req = json.loads(self.rfile.read(n).decode("utf-8") or "{}")
                    self.reply(200, PR.handle(req))
                except BaseException as e:
                    import traceback; traceback.print_exc(); sys.stderr.flush()
                    try: self.reply(500, {"ok": False, "error": "%s: %s" % (type(e).__name__, e)})
                    except Exception: pass
                return
            if path in prm["mesh_paths"]:                       # netmesh endpoints : any failure is a JSON 500, the server never crashes
                try:
                    n = int(self.headers.get("Content-Length", ""))
                    if n <= 0 or n > prm["max_body_mb"] * 1024 * 1024: raise ValueError("body size out of range")
                    self.reply(200, run_netmesh(prm["mesh_paths"][path], self.rfile.read(n), prm))
                except BaseException as e:
                    import traceback; traceback.print_exc(); sys.stderr.flush()
                    try: self.reply(500, {"ok": False, "error": "%s: %s" % (type(e).__name__, e)})
                    except Exception: pass
                return
            if path == prm["export_path"]:
                try:
                    n = int(self.headers.get("Content-Length", ""))
                    if n <= 0 or n > prm["max_body_mb"] * 1024 * 1024: raise ValueError("body size out of range")
                    self.reply(200, save_export(self.rfile.read(n), prm))
                except BaseException as e:
                    try: self.reply(500, {"ok": False, "error": "%s: %s" % (type(e).__name__, e)})
                    except Exception: pass
                return
            if path != prm["save_path"]:
                return self.reply(404, {"ok": False, "error": "unknown endpoint"})
            try:
                n = int(self.headers.get("Content-Length", ""))
            except ValueError:
                return self.reply(411, {"ok": False, "error": "Content-Length required"})
            if n <= 0 or n > prm["max_body_mb"] * 1024 * 1024:
                return self.reply(413, {"ok": False, "error": "body size out of range"})
            try:
                self.reply(200, save_edit(self.rfile.read(n), root, prm, auto="auto=1" in self.path, project=(parse_qs(urlparse(self.path).query).get("project") or [None])[0]))
            except (ValueError, UnicodeDecodeError) as e:       # json.JSONDecodeError is a ValueError
                self.reply(400, {"ok": False, "error": str(e)})
            except OSError as e:
                self.reply(500, {"ok": False, "error": "cannot write: %s" % e})

    return Handler


def main():
    ap = argparse.ArgumentParser(description="ZenRay Lines server (static files and POST /save)")
    ap.add_argument("--root", default=PARAMS["root"], help="folder to serve (default lines/)")
    ap.add_argument("--host", default=PARAMS["host"], help="bind address (default 127.0.0.1, loopback only)")
    ap.add_argument("--port", type=int, default=PARAMS["port"])
    ap.add_argument("--auto-port", action="store_true", help="when the port is busy, try the next ones instead of failing")
    ap.add_argument("--port-file", default=None, help="write the port actually used to this file")
    a = ap.parse_args()
    root = os.path.realpath(a.root)
    handler = make_handler(root, PARAMS)
    httpd = None
    for port in range(a.port, a.port + (PARAMS["auto_port_tries"] if a.auto_port else 1)):
        try:
            httpd = ThreadingHTTPServer((a.host, port), handler)
            break
        except OSError as e:
            print("port %d busy (%s)" % (port, e.strerror), flush=True)
    if httpd is None:
        print("no free port, nothing started", flush=True)
        sys.exit(2)
    port = httpd.server_address[1]
    if a.port_file:
        with open(a.port_file, "w") as f:
            f.write(str(port) + "\n")
    print("ZenRay Lines serving %s at http://%s:%d/  (POST %s writes %s)" % (root, a.host, port, PARAMS["save_path"], PARAMS["edit_file"]), flush=True)
    try:
        PY_AT_START["py"] = code_version(root, PARAMS["lines_dir"])[1]   # 29 October 2026 : the Python this process loaded
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()


if __name__ == "__main__":
    main()
