"""30 October 2026 : self test of ZenRayFinish in both directions (rule of the verifiers) : a rippled gable roof (two planes, 2.5 mm waves) must be ACCEPTED, flattened and keep its ridge ; a clean subdivided box must be REFUSED (the output equals the input).
    python -I ZenRayFinishSelfTest.py
FR : auto-test dans les deux sens : toit bosselé accepté et aplati, boîte propre refusée."""
import json, os, subprocess, sys, tempfile
import numpy as np
HERE = os.path.dirname(os.path.abspath(__file__))


def write(path, V, Q, name):
    with open(path, "w") as f:
        for v in V: f.write("v %.6f %.6f %.6f\n" % tuple(v))
        f.write("g %s\n" % name)
        for q in Q: f.write("f %d %d %d %d\n" % tuple(int(i) + 1 for i in q))


def grid(nx, ny):
    Q = []
    for i in range(nx):
        for j in range(ny): a = i * (ny + 1) + j; Q.append([a, a + ny + 1, a + ny + 2, a + 1])
    return Q


def roof(path, ripple_mm):
    nx, ny, s = 60, 40, 0.025; V = []
    for i in range(nx + 1):
        for j in range(ny + 1):
            x = (i - nx / 2) * s; y = (j - ny / 2) * s; z = -0.6 * abs(x)                          # gable ridge along y, slope 31 degrees
            z += ripple_mm / 1000.0 * np.cos(x * 40) * np.cos(y * 33)
            V.append([x, y, z])
    write(path, np.array(V), grid(nx, ny), "ROOF_panel")


def box(path):
    n = 20; s = 0.025; V = []; Q = []
    for i in range(n + 1):
        for j in range(n + 1): V.append([i * s, j * s, 0.0])
    write(path, np.array(V), grid(n, n), "FLAT_plate")


def run(src, dst):
    r = subprocess.run([sys.executable, "-I", os.path.join(HERE, "ZenRayFinish.py"), src, dst, "--preset", "car", "--bilan", dst + ".json"], capture_output=True, text=True)
    return json.load(open(dst + ".json")) if os.path.exists(dst + ".json") else {"error": r.stderr[-300:]}


def main():
    d = tempfile.mkdtemp(prefix="zrfinish_test_"); roof(d + "/roof.obj", 2.5); box(d + "/flat.obj")
    a = run(d + "/roof.obj", d + "/roof_out.obj"); b = run(d + "/flat.obj", d + "/flat_out.obj")
    ok1 = a.get("accepted") is True and a["after"]["verifiers"]["soft_dihedral_share"] < 0.9 * a["before"]["verifiers"]["soft_dihedral_share"]
    ok2 = b.get("accepted") is False
    print("rippled roof accepted and flattened :", "GREEN" if ok1 else "RED", a.get("before", {}).get("verifiers", {}).get("soft_dihedral_share"), "->", a.get("after", {}).get("verifiers", {}).get("soft_dihedral_share"))
    print("clean plate refused :", "GREEN" if ok2 else "RED", b.get("note", b.get("error", "")))
    sys.exit(0 if ok1 and ok2 else 1)


if __name__ == "__main__": main()
