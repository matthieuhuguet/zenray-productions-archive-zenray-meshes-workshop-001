#!/bin/zsh
# 25 October 2026 : ZenRay Meshes car, one review board per tag : front, side, back strips (reference | materials) and the
# three quarter view, stacked. Usage: Board.sh <tag>
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; cd $W
for v in front left back; do $PY -I Scripts/CompareFace.py $1 $v > /dev/null; done
$PY -c "
from PIL import Image
W='versions/'
ims=[Image.open(W+'Car_$1_%s_cmp.png'%v) for v in ('front','left','back')]+[Image.open(W+'Car_$1_materials.png').crop((1000,1150,1700,1560))]
w=max(i.width for i in ims);o=Image.new('RGB',(w,sum(i.height for i in ims)),(96,96,96));y=0
for i in ims: o.paste(i,(0,y)); y+=i.height
o.save(W+'Car_$1_board.png'); print(W+'Car_$1_board.png')"
