"""2 November 2026 : how far is the skin from the features triangulated on the frames : this is a depth error the silhouette cannot see, and no finished file is needed to measure it. FR : à quelle distance la peau est-elle des détails triangulés sur les images : une erreur de profondeur que la silhouette ne voit pas, mesurée sans aucun fichier fini.
    python -I LandmarkDist.py <mesh.obj> <points_3d.json> [--mirror]"""
import sys, json
import numpy as np
from scipy.spatial import cKDTree
V = []; F = []
for l in open(sys.argv[1]):
    if l.startswith("v "): V.append([float(x) for x in l.split()[1:4]])
    elif l.startswith("f "):
        i = [int(q.split("/")[0]) - 1 for q in l.split()[1:]]; F += [(i[0], i[k], i[k + 1]) for k in range(1, len(i) - 1)]
V = np.array(V); F = np.array(F); s = np.concatenate([V, V[F].mean(1)]); T = cKDTree(s); P = json.load(open(sys.argv[2])); D = []
for k, p in P.items():
    p = np.array(p); d, j = T.query(p); o = s[j] - p; D.append(d); print(f"{k:16s} {d:6.3f}  skin - point  x {o[0]:+.3f} y {o[1]:+.3f} z {o[2]:+.3f}")
print("mean distance", round(float(np.mean(D)), 4), "max", round(float(np.max(D)), 4))
