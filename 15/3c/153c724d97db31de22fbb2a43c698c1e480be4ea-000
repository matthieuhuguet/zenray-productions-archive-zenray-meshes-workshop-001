# 28 October 2026 15:18 Paris: project traced reference curves onto two independent measurement planes.
import json
import hou

node = hou.pwd()
geo = node.geometry()
with open(node.evalParm('guide_file'), encoding='utf-8') as stream:
    data = json.load(stream)['views']
name_attr = geo.addAttrib(hou.attribType.Prim, 'name', '')
scale = node.evalParm('pixels_per_metre')
for view in ('back', 'side'):
    for label, points in data[view]['guides'].items():
        line = geo.createPolygon(is_closed=False)
        line.setAttribValue(name_attr, view + '_' + label)
        for px, py in points:
            height = (node.evalParm(view + '_ground') - py) / scale
            if view == 'back':
                position = ((node.evalParm('back_axis') - px) / scale, height, node.evalParm('back_plane'))
            else:
                position = (node.evalParm('side_plane'), height, (px - node.evalParm('side_axis')) / scale)
            point = geo.createPoint()
            point.setPosition(position)
            line.addVertex(point)
