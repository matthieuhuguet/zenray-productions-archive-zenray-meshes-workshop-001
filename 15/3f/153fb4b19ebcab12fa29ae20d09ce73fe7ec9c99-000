"""29 October 2026 : the icon of ZenRay Lines : a dark tile, a quad grid bent by an orange curve network (what the app does), every size of the .icns.
FR : l'icône de ZenRay Lines, une grille de quads courbée par un réseau orange."""
import os, subprocess, tempfile
from PIL import Image, ImageDraw
HERE = os.path.dirname(os.path.abspath(__file__)); OUT = os.path.join(HERE, "icon"); os.makedirs(OUT, exist_ok=True)
PARAMS = {"bg": (24, 26, 31), "grid": (120, 200, 160), "curve": (232, 120, 52), "size": 1024}
S = PARAMS["size"]; im = Image.new("RGBA", (S, S), (0, 0, 0, 0)); d = ImageDraw.Draw(im)
d.rounded_rectangle((40, 40, S - 40, S - 40), radius=210, fill=PARAMS["bg"])
bend = lambda x, y: (x + 60 * ((y - S / 2) / (S / 2)) ** 2, y - 50 * ((x - S / 2) / (S / 2)) ** 2)
for k in range(1, 8):
    t = 160 + k * (S - 320) / 8
    d.line([bend(t, 160 + i * (S - 320) / 40) for i in range(41)], fill=PARAMS["grid"], width=10)
    d.line([bend(160 + i * (S - 320) / 40, t) for i in range(41)], fill=PARAMS["grid"], width=10)
for t in (160, S - 160):
    d.line([bend(t, 160 + i * (S - 320) / 40) for i in range(41)], fill=PARAMS["curve"], width=34)
    d.line([bend(160 + i * (S - 320) / 40, t) for i in range(41)], fill=PARAMS["curve"], width=34)
for x in (160, S - 160):
    for y in (160, S - 160): cx, cy = bend(x, y); d.ellipse((cx - 38, cy - 38, cx + 38, cy + 38), fill=(255, 255, 255))
tmp = tempfile.mkdtemp(); iconset = os.path.join(tmp, "AppIcon.iconset"); os.makedirs(iconset)
for n in (16, 32, 128, 256, 512):
    im.resize((n, n), Image.LANCZOS).save(os.path.join(iconset, "icon_%dx%d.png" % (n, n))); im.resize((2 * n, 2 * n), Image.LANCZOS).save(os.path.join(iconset, "icon_%dx%d@2x.png" % (n, n)))
subprocess.run(["iconutil", "-c", "icns", iconset, "-o", os.path.join(OUT, "AppIcon.icns")], check=True); im.save(os.path.join(OUT, "AppIcon.png")); print(os.path.join(OUT, "AppIcon.icns"))
