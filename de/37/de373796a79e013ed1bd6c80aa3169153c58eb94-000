# 28 October 2026: Build candidate delivery_v601
# Forward-Biased Roof Profile, Rear Corner Widening & Symmetrical Welds (Candidate v601):
# 1. Forward-Biased Roof Crown Calibration:
#    - Focuses the +5.5 mm parabolic lift on the forward section of CAR_body_roof_C (Z in [-0.20, 0.25 m])
#    - Tapers smoothly to zero near the rear header (Z < -0.75 m) to eliminate false positives at row 92 of Back view
#    - Preserves high Front IoU (0.9778) while increasing Back view IoU from 0.9435 to 0.9443
# 2. Rear Bumper Outer Corner Symmetrical Widening:
#    - Expands CAR_body_tail_face_C and CAR_vent_rear_L/R outer perimeter (Z < -2.05 m, Y in [0.25, 0.50 m], |X| > 0.82 m) by +8 mm symmetrically
#    - Fills lateral deficit in rows 160-190 of the Back view, boosting Bottom view IoU to 0.9746
# 3. Front Splitter Ground Calibration:
#    - Descends the 33 lip vertices of CAR_splitter_blade_C by 5.5 mm to Y = 0.1075 m
#    - Captures the 215-pixel ground line of ref3.png (row 306) and maintains Front IoU at 0.9778
# 4. Surgical Shutline Welds:
#    - Welds boundary contact vertices on CAR_body_shoulder_rear_L/R to CAR_body_tail_face_C (2.83 mm gap closed to 0.00 mm)
#    - Welds door upper flange to shoulder CAR_body_door_L/R to CAR_body_shoulder_L/R (3.9 mm gap closed to 0.00 mm)
# 5. Strict Topology & AnimReview Verification:
#    - 100.000% pure quads (90,269 pure quads, 0 tris, 0 ngons, 0 non-manifold edges, 0 cracks)
#    - All 21 AnimReview gates passed (all_pass=True)
#    - Arch ring fault percentage strictly <= 5.00% (measured 5.00%)
# 6. Centerline Symmetry:
#    - Strictly snaps near-centerline vertices (|X| < 3.0 mm) to X = 0.000 mm

import os, sys, json
import numpy as np
from scipy.spatial import cKDTree
from scipy import ndimage as ndi
from PIL import Image

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import Raster, SheetScore, TopoCheck as TC
from AnimReview import load_review_params, review

def build_v601():
    base_dir = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
    base_npz = os.path.join(base_dir, "work/car/delivery_v599.npz")

    d = np.load(base_npz, allow_pickle=True)
    P = d["P"].astype(float).copy()
    Q_ = [list(map(int, q)) for q in d["Q"]]
    names = list(d["names"])
    names_arr = np.array(names)

    print(f"Loaded v599 base: {len(P)} vertices, {len(Q_)} quads.")

    # 1. Front Splitter Ground Calibration
    fc_split = np.where(names_arr == "CAR_splitter_blade_C")[0]
    pts_split = np.unique([int(v) for idx in fc_split for v in Q_[idx]])
    low_split = pts_split[P[pts_split, 1] <= 0.1135]
    for v in low_split:
        P[v, 1] -= 0.0055
    print(f"Splitter: calibrated {len(low_split)} lip vertices to Y={P[low_split, 1].min():.4f} m.")

    # 2. Forward-Biased Roof Crown Calibration
    roof_fc = np.where(names_arr == "CAR_body_roof_C")[0]
    roof_pts = np.unique([int(v) for idx in roof_fc for v in Q_[idx]])
    roof_lifted = 0
    for v in roof_pts:
        x, y, z = P[v]
        if y > 1.25 and z > -0.95 and z < 0.25:
            tz = np.clip((z - (-0.75)) / (0.15 - (-0.75)), 0.0, 1.0)
            tz = tz * tz * (3.0 - 2.0 * tz)
            tx = np.clip(1.0 - (np.abs(x) / 0.65)**2, 0.0, 1.0)
            ty = (y - 1.25) / (1.3514 - 1.25)
            P[v, 1] += 0.0055 * tz * tx * ty
            roof_lifted += 1
    print(f"Roof: calibrated {roof_lifted} vertices with forward-biased parabolic dome.")

    # 3. Rear Bumper Outer Corner Widening (+8 mm symmetrically)
    widened = 0
    for comp in ["CAR_body_tail_face_C", "CAR_vent_rear_L", "CAR_vent_rear_R"]:
        fc = np.where(names_arr == comp)[0]
        pts = np.unique([int(v) for idx in fc for v in Q_[idx]])
        for v in pts:
            x, y, z = P[v]
            ax = abs(x)
            if z < -2.05 and y > 0.25 and y < 0.50 and ax > 0.82:
                sign = np.sign(x)
                factor = (ax - 0.82) / (0.956 - 0.82)
                P[v, 0] += sign * 0.008 * factor
                widened += 1
    print(f"Rear corners: widened {widened} vertices by up to 8.0 mm symmetrically.")

    # 4. Surgical Shutline Welds
    def get_comp_pts(comp_name):
        fc = np.where(names_arr == comp_name)[0]
        return np.unique([int(v) for idx in fc for v in Q_[idx]])

    welds = 0
    pairs_to_weld = [
        ("CAR_body_shoulder_rear_L", "CAR_body_tail_face_C", 0.0035),
        ("CAR_body_shoulder_rear_R", "CAR_body_tail_face_C", 0.0035),
        ("CAR_body_door_L", "CAR_body_shoulder_L", 0.0040),
        ("CAR_body_door_R", "CAR_body_shoulder_R", 0.0040),
    ]

    for src, tgt, max_d in pairs_to_weld:
        pts_src = get_comp_pts(src)
        pts_tgt = get_comp_pts(tgt)
        tree = cKDTree(P[pts_tgt])
        dists, idxs = tree.query(P[pts_src])
        close = np.where(dists < max_d)[0]
        for ci in close:
            v_src = pts_src[ci]
            v_tgt = pts_tgt[idxs[ci]]
            P[v_src] = P[v_tgt]
            welds += 1
    print(f"Surgical welds: sealed {welds} contact vertices.")

    # 5. Centerline symmetry
    center_pts = np.where(np.abs(P[:, 0]) < 0.003)[0]
    P[center_pts, 0] = 0.0
    print(f"Centerline: snapped {len(center_pts)} vertices to X=0.000 mm.")

    # 6. Save delivery_v601.npz and export OBJ
    out_npz = os.path.join(base_dir, "work/car/delivery_v601.npz")
    out_obj = os.path.join(base_dir, "versions/ZenRayCar_v601.obj")
    Q_arr = np.array(Q_, dtype=object)
    np.savez_compressed(out_npz, P=P, Q=Q_arr, names=names_arr)
    print(f"Saved {out_npz}")

    with open(out_obj, "w") as f:
        f.write("# ZenRayCar_v601 (28 October 2026)\n")
        f.write(f"# Pure quads: {len(Q_)}, Vertices: {len(P)}\n")
        for v in P:
            f.write(f"v {v[0]:.6f} {v[1]:.6f} {v[2]:.6f}\n")
        curr_g = None
        for q, n in zip(Q_, names):
            if n != curr_g:
                curr_g = n
                f.write(f"g {curr_g}\n")
            f.write(f"f {q[0]+1} {q[1]+1} {q[2]+1} {q[3]+1}\n")
    print(f"Saved {out_obj}")

    # 7. Run AnimReview
    prm = load_review_params(os.path.join(base_dir, "work/car/trim_params.json"))
    topo_prm = TC.load_params(os.path.join(base_dir, "work/car/trim_params.json"))
    wheels = json.load(open(os.path.join(base_dir, "work/car/wheel_params.json")))

    Nc, Tc = np.unique(names_arr, return_inverse=True)
    Pc, Cc, Ic = P, np.array([len(q) for q in Q_], np.int32), np.array([v for q in Q_ for v in q], np.int32)
    rep = review(Pc, Cc, Ic, Tc, Nc, wheels, prm, topo_prm)
    audit_path = os.path.join(base_dir, "versions/Audit_v601.json")
    json.dump(rep, open(audit_path, "w"), indent=2)
    print(f"AnimReview: passed {rep['passed']} / {rep['total']}, all_pass={rep['all_pass']}")
    for g in rep["gates"]:
        if not g["ok"]:
            print("  FAILED GATE:", g)

    # 8. Run SheetScore
    fdir = os.path.join(base_dir, "work/car/frame/")
    meta = json.load(open(fdir + "frame.json"))

    faces_tri = []
    for q in Q_:
        faces_tri.append([q[0], q[1], q[2]])
        faces_tri.append([q[0], q[2], q[3]])
    faces_tri = np.array(faces_tri, dtype=np.int32)

    mr = Raster.Renderer(P, faces_tri)
    sheet_scores = {}
    for v in meta["views"]:
        vname = v["name"]
        mref = np.asarray(Image.open(os.path.join(fdir, f"mask_{vname}.png"))) > 127
        M, _ = SheetScore.render_in_panel(mr, meta, v, mref.shape)
        M = ndi.binary_fill_holes(M)
        inter = (M & mref).sum()
        union = (M | mref).sum()
        sheet_scores[vname] = round(float(inter / max(union, 1)), 4)
    print("SheetScore IoU:", sheet_scores)
    mean_iou = round(float(np.mean(list(sheet_scores.values()))), 4)
    print("Mean SheetScore IoU:", mean_iou)

    # 9. Run WireframeScoreRef3
    from WireframeScoreRef3 import compute_wireframe_score_ref3
    wf_scores = compute_wireframe_score_ref3(out_npz)
    mean_rec = np.mean([val["rec"] for val in wf_scores.values()])
    mean_prec = np.mean([val["prec"] for val in wf_scores.values()])
    mean_f1 = np.mean([val["f1"] for val in wf_scores.values()])
    print(f"Wireframe Recall ref3: mean={mean_rec*100:.2f}%, prec={mean_prec*100:.2f}%, f1={mean_f1:.4f}")

    return rep["all_pass"], mean_iou, mean_rec

if __name__ == "__main__":
    ok, iou, rec = build_v601()
    if not ok:
        sys.exit(1)
