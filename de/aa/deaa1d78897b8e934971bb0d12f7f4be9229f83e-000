#!/usr/bin/env python3
# 5 November 2026, 20:32 Europe/Paris: fit the hood's longitudinal profile to the sheet's side silhouette, without Houdini.
# FR : ajuste le profil longitudinal du capot sur la silhouette de profil de la planche, sans Houdini.
#
# The side silhouette of the generator is analytic: for each row, the top is the centre line and the bottom is the
# turned-down flange, plus the front bead. It is rasterised, normalised to its own box and compared to the sheet's side
# mask by IoU. Only the shape exponents and the flange depth are searched; rise and length stay set by the cross-view
# ratios (CompareSheetViews.py). The result is a proposal printed as JSON; nothing is written unless --write is given.
# Usage: FitHoodProfile.py <sheet-check.json> [--write]
import itertools
import json
import math
import sys
from pathlib import Path

import numpy as np
from PIL import Image, ImageDraw

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import HoodPanelGeometry as G
from CompareSheetViews import mask, normalised, views_from_sheet

SIZE = 512
SEARCH = {
    'profile_power': [1.6, 1.8, 2.0, 2.2, 2.4, 2.6, 2.9],
    'profile_round': [1.0, 1.2, 1.4, 1.6, 1.8, 2.0, 2.3],
    'side_drop': [0.03, 0.045, 0.06, 0.075, 0.09],
    'side_drop_rear': [0.15, 0.3, 0.5, 0.8],
}


def flat(config):
    return {k: v for c, d in config.items() if isinstance(d, dict) and c != 'provenance' for k, v in d.items()}


def side_mask(p, rows=120):
    top, bottom = [], []
    for i in range(rows + 1):
        v = i / float(rows)
        h = v * p['length']
        top.append((h, G.position(('core', 0.0, 1), v, p)[1]))
        bottom.append((h, G.position(('flange', 1.0, 1), v, p)[1]))
    # Front bead: a disc at the front centre, pushed below the surface along its local normal.
    a, b = np.array(top[0]), np.array(top[1])
    tangent = (b - a) / max(1e-9, np.linalg.norm(b - a))
    normal = np.array([-tangent[1], tangent[0]])
    if normal[1] < 0:
        normal = -normal
    bead = a - normal * p['front_roll'] * 0.55
    points = np.array(top + bottom[::-1])
    lo = np.minimum(points.min(0), bead - p['front_roll']); hi = np.maximum(points.max(0), bead + p['front_roll'])
    scale = (SIZE - 4) / float((hi - lo).max())
    def px(q):
        return (2 + (q[0] - lo[0]) * scale, SIZE - 2 - (q[1] - lo[1]) * scale)
    image = Image.new('L', (SIZE, SIZE), 0)
    draw = ImageDraw.Draw(image)
    draw.polygon([px(q) for q in points], fill=255)
    c = px(bead); r = p['front_roll'] * scale
    draw.ellipse((c[0] - r, c[1] - r, c[0] + r, c[1] + r), fill=255)
    return np.asarray(image) > 127


def score(p, reference):
    model = normalised(side_mask(p))
    return float((model & reference).sum() / max(1, (model | reference).sum()))


def fit(check_path, write=False):
    check_path = Path(check_path)
    check = json.loads(check_path.read_text())
    sheet = Image.open(check_path.parent / check['image']).convert('RGB')
    reference = normalised(mask(views_from_sheet(sheet, check)['side']))
    config_path = HERE / 'HoodPanel.json'
    config = json.loads(config_path.read_text())
    p = flat(config)
    start = score(p, reference)
    best = (start, {k: p[k] for k in SEARCH})
    for values in itertools.product(*SEARCH.values()):
        trial = dict(p, **dict(zip(SEARCH, values)))
        s = score(trial, reference)
        if s > best[0]:
            best = (s, dict(zip(SEARCH, values)))
    result = {'startIoU': round(start, 4), 'bestIoU': round(best[0], 4), 'best': best[1], 'evaluated': math.prod(len(v) for v in SEARCH.values())}
    if write:
        for category, values in config.items():
            if isinstance(values, dict):
                for key in values:
                    if key in best[1]:
                        values[key] = best[1][key]
        config_path.write_text(json.dumps(config, indent=2, ensure_ascii=False) + '\n')
        result['written'] = str(config_path)
    return result


if __name__ == '__main__':
    print(json.dumps(fit(sys.argv[1], '--write' in sys.argv), indent=1))
