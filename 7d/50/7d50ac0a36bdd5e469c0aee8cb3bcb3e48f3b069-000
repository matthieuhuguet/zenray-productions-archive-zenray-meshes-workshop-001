# 27 October 2026: Pure Transformers/Lego Component_Windshield built from 3D reference curves
import hou, numpy as np
from scipy.interpolate import PchipInterpolator

geo = hou.pwd().geometry()
geo.clear()

# 1. Measured 3D Profile Curves from 6 views
z_ctrl = np.array([0.380, 0.540, 0.740, 0.945, 1.147, 1.350, 1.5515])
x_ctrl = np.array([0.525, 0.690, 0.740, 0.786, 0.795, 0.740, 0.640])
yc_ctrl = np.array([1.225, 1.206, 1.130, 1.046, 0.961, 0.903, 0.858])
ye_ctrl = np.array([1.205, 1.143, 1.062, 0.992, 0.934, 0.888, 0.851])

fx = PchipInterpolator(z_ctrl, x_ctrl)
fyc = PchipInterpolator(z_ctrl, yc_ctrl)
fye = PchipInterpolator(z_ctrl, ye_ctrl)

num_u = 9 # 9 rows along Z
z_pts = np.linspace(0.380, 1.5515, num_u)
num_v = 5 # 5 control columns across X

surf = geo.createNURBSSurface(num_v, num_u)

for i in range(num_u):
    z = float(z_pts[i])
    xe = float(fx(z))
    yc = float(fyc(z))
    ye = float(fye(z))
    xc = float(xe * 0.5)
    y_mid = float(yc + (ye - yc) * 0.25)
    v_pts = [
        (-xe, ye, z),
        (-xc, y_mid, z),
        (0.0, yc, z),
        (xc, y_mid, z),
        (xe, ye, z)
    ]
    for j in range(num_v):
        surf.vertex(i, j).point().setPosition(hou.Vector3(*v_pts[j]))
