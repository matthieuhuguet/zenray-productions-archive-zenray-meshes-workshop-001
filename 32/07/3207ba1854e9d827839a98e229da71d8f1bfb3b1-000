"""4 November 2026 : the final mesh alone in clay, from several angles, to judge it as an object and not against one frame. FR : le maillage final seul en argile, sous plusieurs angles, pour le juger comme un objet et non contre une image.
    python -I ClayTurn.py <mesh.obj> <out.png> [n angles] [tile px] [ppm]"""
import sys, os
import numpy as np
from PIL import Image
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts"); import Raster
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__)))); from DragonBoard import load_obj, axes
mesh, out = sys.argv[1], sys.argv[2]; n = int(sys.argv[3]) if len(sys.argv) > 3 else 6; RES = int(sys.argv[4]) if len(sys.argv) > 4 else 640; PPM = float(sys.argv[5]) if len(sys.argv) > 5 else 120.0
V, F, pid, sides = load_obj(mesh); r = Raster.Renderer(V, F, smooth_deg=70.0); c = (0.0, 0.25, 0.0); L1 = np.array([0.35, 0.55, 0.76]); L2 = np.array([-0.6, 0.2, 0.4]); tiles = []
for k in range(n):
    yaw = 360.0 * k / n + 30; pitch = 8.0 if k % 2 == 0 else 14.0; A = axes(yaw, pitch); m, d, nr, fid = r.render(c, PPM, A, RES); img = np.full((RES, RES, 3), (58, 58, 62), np.float32)
    shade = 0.22 + 0.62 * np.clip(nr @ L1, 0, 1) + 0.16 * np.clip(nr @ L2, 0, 1); img[m] = (np.array([0.80, 0.78, 0.76]) * shade[m][:, None] * 255).clip(0, 255); tiles.append(img.astype(np.uint8))
r.release(); cols = 3; rows = (n + cols - 1) // cols; page = Image.new("RGB", (cols * RES, rows * RES))
for i, t in enumerate(tiles): page.paste(Image.fromarray(t), ((i % cols) * RES, (i // cols) * RES))
page.save(out); print(page.size)
