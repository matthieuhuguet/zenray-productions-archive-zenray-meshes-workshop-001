collar.update({'name': 'PipeCollarL', 'id': 'Car2_Turbo__back__PipeCollarL', 'role': 'detail', 'mirror_about': ['x', AX], 'note': "2 (Matthieu): the collar around the pipe, the small step of the turbo"})
