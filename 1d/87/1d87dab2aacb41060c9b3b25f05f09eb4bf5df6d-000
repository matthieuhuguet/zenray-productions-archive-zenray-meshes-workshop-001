def anchors(pts, simplify=0.4, closed=False):
    q = cv2.approxPolyDP(np.asarray(pts, np.float32).reshape(-1, 1, 2), simplify, closed).reshape(-1, 2)
    return [{'x': float(x), 'y': float(y), 'ix': float(x), 'iy': float(y), 'ox': float(x), 'oy': float(y), 't': 'corner'} for x, y in q]

def path(name, pts, closed, why, role='detail'):
    return {'kind': 'path', 'closed': closed, 'prim': None, 'anchors': anchors(pts, 0.4, closed), 'name': name, 'id': 'Car2_Turbo__back__' + name, 'role': role,
            'how': 'snapped', 'stage': 'global form', 'read': ['step', 0], 'mirror_about': ['x', AX], 'unread': [], 'note': why}

def order(blob):
    """The skeleton of a hand stroke as an ordered polyline: thin it, then walk from one end."""
    x0, y0 = blob.min(0) - 3
    w, h = (blob.max(0) - blob.min(0) + 7).astype(int)
    m = np.zeros((h * 4, w * 4), np.uint8)
    for x, y in blob:
        cv2.circle(m, (int((x - x0) * 4), int((y - y0) * 4)), 3, 255, -1)
    sk = cv2.ximgproc.thinning(m) if hasattr(cv2, 'ximgproc') else m
    ys, xs = np.nonzero(sk)
    pts = np.c_[xs / 4 + x0, ys / 4 + y0]
    # walk: start at the point farthest from the centroid, then nearest neighbour
    cur = pts[np.argmax(np.linalg.norm(pts - pts.mean(0), axis=1))]; left = list(range(len(pts))); out = []
    while left:
        dd = np.linalg.norm(pts[left] - cur, axis=1); j = int(np.argmin(dd))
        if dd[j] > 3 and out: break
        cur = pts[left.pop(j)]; out.append(cur)
    o = np.array(out)
    return Snap.resample(o[::4] if len(o) > 40 else o, 1.0, False)

curves = []
