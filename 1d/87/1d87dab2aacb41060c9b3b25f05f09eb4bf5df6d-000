# 3: the inner edge of the hollow: Matthieu's stroke at the tip, the lip moved inward elsewhere, closed along the collar
n = Snap.normals(Snap.resample(hol, 1.0, True), True); b = Snap.resample(hol, 1.0, True)
inward = np.sign(((hol.mean(0) - b) * n).sum(1))[:, None] * n
inner_guide = b + inward * 4.0
tipstroke = order(G[4])
keep = inner_guide[inner_guide[:, 0] > tipstroke[:, 0].max() - 2]
# put the tip stroke in the loop: top branch end -> tip -> bottom branch end, then the kept points ordered around
c0 = inner_guide.mean(0)
allp = np.vstack([keep, tipstroke]); ang = np.arctan2(allp[:, 1] - c0[1], allp[:, 0] - c0[0])
loop = allp[np.argsort(ang)]
inner, st3, off3 = Snap.snap(g, loop, 'edge', True, radius=3)
