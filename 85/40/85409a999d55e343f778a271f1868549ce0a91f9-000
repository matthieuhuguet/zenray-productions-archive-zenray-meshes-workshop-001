<script>
const S = {{ snapMm: 0, tuckPct: 0, calibrated: 0, pbrSplit: 0, view: 'front', showOverlay: true }};
const root = document.documentElement;
const themeBtn = document.getElementById('themeBtn');
themeBtn.onclick = () => {{
  const dark = root.getAttribute('data-theme') === 'dark';
  root.setAttribute('data-theme', dark ? 'light' : 'dark');
  themeBtn.textContent = dark ? 'Mode sombre' : 'Mode clair';
}};

function update() {{
  const gap = Math.max(0.0, 15.34 - S.snapMm);
  const tuckShift = S.tuckPct * 0.4;
  const totalPxShift = ((S.snapMm + tuckShift) / 15.34) * 18.0; // visual pixel displacement matching 15.34mm gap in 640px stage
  const isFront = S.view === 'front';

  document.getElementById('imgLower').style.display = isFront ? 'block' : 'none';
  document.getElementById('imgCuff').style.display = isFront ? 'block' : 'none';
  document.getElementById('imgQFront').style.display = isFront ? 'none' : 'block';
  document.getElementById('imgCuff').style.transform = `translateY(${{totalPxShift.toFixed(1)}}px)`;
  document.getElementById('svgOverlay').style.display = (S.showOverlay && isFront) ? 'block' : 'none';

  document.getElementById('btnFront').setAttribute('aria-pressed', isFront ? 'true' : 'false');
  document.getElementById('btnQFront').setAttribute('aria-pressed', isFront ? 'false' : 'true');
  document.getElementById('btnOverlay').setAttribute('aria-pressed', S.showOverlay ? 'true' : 'false');

  document.getElementById('oSnap').textContent = `-${{S.snapMm.toFixed(1)}} mm`;
  document.getElementById('oTuck').textContent = `${{S.tuckPct}} %`;
  document.getElementById('oScale').textContent = S.calibrated ? '0.420 m (OK)' : 'Brut 374.3 m';
  document.getElementById('oSplit').textContent = S.pbrSplit ? '3 600 q + 2K PBR' : 'Brut (764k f)';

  const contactOk = gap <= 1.0;
  const kpiGap = document.getElementById('kpiGap');
  kpiGap.textContent = contactOk ? `${{gap.toFixed(2)}} mm (ASSEMBLE)` : `${{gap.toFixed(2)}} mm (FLOTTANT)`;
  kpiGap.className = 'kpi-v ' + (contactOk ? 'ok' : 'bad');

  const kpiConn = document.getElementById('kpiConn');
  kpiConn.textContent = contactOk ? '1 bloc soude (OK)' : '2 ilots (Arm_Cuff isole)';
  kpiConn.className = 'kpi-v ' + (contactOk ? 'ok' : 'bad');

  const kpiScale = document.getElementById('kpiScale');
  kpiScale.textContent = S.calibrated ? '0.420 m (Mannequin OK)' : '374.3 m (891x trop grand!)';
  kpiScale.className = 'kpi-v ' + (S.calibrated ? 'ok' : 'bad');

  const kpiPoly = document.getElementById('kpiPoly');
  kpiPoly.textContent = S.pbrSplit ? '3 600 quads (-99.5%) + 2K PBR' : '764 358 faces (161 MB)';
  kpiPoly.className = 'kpi-v ' + (S.pbrSplit ? 'ok' : 'warn');

  const gapRect = document.getElementById('gapRect');
  const gapText = document.getElementById('gapText');
  gapRect.setAttribute('y', (188 + totalPxShift * 0.5).toFixed(1));
  gapRect.setAttribute('stroke', contactOk ? '#22c55e' : '#ef4444');
  gapRect.setAttribute('fill', contactOk ? 'rgba(34,197,94,0.16)' : 'rgba(220,38,38,0.18)');
  gapText.textContent = contactOk ? 'Contact <= 1 mm OK' : `Ecart ${{gap.toFixed(2)}} mm`;
  gapText.setAttribute('y', (207 + totalPxShift * 0.5).toFixed(1));
  gapText.setAttribute('fill', contactOk ? '#86efac' : '#fef08a');

  document.getElementById('hiddenText').textContent = S.pbrSplit ? '1 200 q + 2K Height (PBR)' : '639 184 f relief (83.6%)';
  document.getElementById('hiddenRect').setAttribute('stroke', S.pbrSplit ? '#22c55e' : '#f59e0b');

  document.getElementById('manText').textContent = S.calibrated
    ? 'Echelle 0.001122 m/px appliquee : avant-bras + coude = 0.420 m sur Mannequin 1.76 m.'
    : 'Sans calibration, 374.3 pixels valent 374.3 m en Houdini (891x trop grand).';
  document.getElementById('armBox').setAttribute('fill', S.calibrated ? 'rgba(34,197,94,0.22)' : 'rgba(239,68,68,0.25)');
  document.getElementById('armBox').setAttribute('stroke', S.calibrated ? '#22c55e' : '#ef4444');
  document.getElementById('armLbl').textContent = S.calibrated ? '0.420 m OK' : '374 m BRUT';
  document.getElementById('armLbl').setAttribute('fill', S.calibrated ? '#16a34a' : '#ef4444');
  document.getElementById('pbrNote').textContent = (S.calibrated && S.pbrSplit)
    ? 'Pret pour HeadlessM1 (2048 px/m) + HeightTo5Maps (relief 10 mm).'
    : 'Activez calibration 1.76 m + split PBR pour lancer M1 sans saturation.';

  const gates = [
    ['Manifold OBJ (open=0, nonman=0)', true, 'OK'],
    ['ContactGraph <= 1.0 mm', contactOk, contactOk ? '0.08 mm' : `${{gap.toFixed(1)}} mm KO`],
    ['Scale zenray_mannequin (1.76m)', !!S.calibrated, S.calibrated ? '0.420 m' : '374.3 m'],
    ['Split Relief -> 2K HeightTo5Maps', !!S.pbrSplit, S.pbrSplit ? '3 600 q' : '764k f'],
    ['HiddenFaces (minor_density=0.25)', !!S.pbrSplit, S.pbrSplit ? 'Actif' : 'Inactif'],
    ['Pret HeadlessM1 (score >= 0.999)', contactOk && S.calibrated && S.pbrSplit, (contactOk && S.calibrated && S.pbrSplit) ? 'PRET' : 'BLOQUE'],
  ];
  document.getElementById('gatesList').innerHTML = gates.map(([n, ok, tag]) =>
    `<div class="gate"><span class="g-l"><span class="dot ${{ok ? 'ok' : 'bad'}}"></span>${{n}}</span><strong>${{tag}}</strong></div>`
  ).join('');
}}

['rSnap', 'rTuck', 'rScale', 'rSplit'].forEach(id => {{
  document.getElementById(id).oninput = e => {{
    if (id === 'rSnap') S.snapMm = parseFloat(e.target.value);
    if (id === 'rTuck') S.tuckPct = parseFloat(e.target.value);
    if (id === 'rScale') S.calibrated = parseInt(e.target.value, 10);
    if (id === 'rSplit') S.pbrSplit = parseInt(e.target.value, 10);
    update();
  }};
}});
document.getElementById('btnFront').onclick = () => {{ S.view = 'front'; update(); }};
document.getElementById('btnQFront').onclick = () => {{ S.view = 'qfront'; update(); }};
document.getElementById('btnOverlay').onclick = () => {{ S.showOverlay = !S.showOverlay; update(); }};
document.getElementById('btnAutoSnap').onclick = () => {{
  S.snapMm = 17.5; S.tuckPct = 5; S.calibrated = 1; S.pbrSplit = 1;
  document.getElementById('rSnap').value = 17.5;
  document.getElementById('rTuck').value = 5;
  document.getElementById('rScale').value = 1;
  document.getElementById('rSplit').value = 1;
  update();
}};
document.getElementById('btnReset').onclick = () => {{
  S.snapMm = 0; S.tuckPct = 0; S.calibrated = 0; S.pbrSplit = 0;
  document.getElementById('rSnap').value = 0;
  document.getElementById('rTuck').value = 0;
  document.getElementById('rScale').value = 0;
  document.getElementById('rSplit').value = 0;
  update();
}};
document.getElementById('copyBtn').onclick = async () => {{
  const payload = JSON.stringify({{
    snap_axial_mm: -S.snapMm,
    socket_overlap_pct: S.tuckPct,
    mannequin_calibrated: !!S.calibrated,
    target_height_m: 0.42,
    split_relief_to_2k_pbr: !!S.pbrSplit,
    texel_density_px_per_m: 2048
  }}, null, 2);
  try {{ await navigator.clipboard.writeText(payload); document.getElementById('copyBtn').textContent = 'Valeurs copiees!'; }}
  catch (_) {{ document.getElementById('copyBtn').textContent = 'Pret (voir console)'; }}
  setTimeout(() => {{ document.getElementById('copyBtn').textContent = 'Copier les valeurs pour le prompt'; }}, 1400);
}};
update();
