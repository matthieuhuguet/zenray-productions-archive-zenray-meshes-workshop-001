import base64
import io
from pathlib import Path

import numpy as np
from PIL import Image
from scipy import ndimage as ndi

A002_VIEWS = Path('/Users/zenray/.claude/tmp/tmp-zenray-meshes/Projects/14_ArmGuard_13-November-2026/assembly/A_002/views')
OUT_DIR = Path('/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_14-November-2026/proposals/06_assembly_scale_contact_10s')


def pil_to_data_url(im, fmt='WEBP', quality=86):
    buf = io.BytesIO()
    im.save(buf, format=fmt, quality=quality)
    b64 = base64.b64encode(buf.getvalue()).decode('ascii')
    return f'data:image/{fmt.lower()};base64,{b64}'


def extract_cuff_and_lower_layers(front_path, out_size=640):
    rgb = np.asarray(Image.open(front_path).convert('RGB'))
    # Background is uniform (96, 96, 96); allow small AA margin
    dist_bg = np.abs(rgb.astype(np.int16) - 96).max(axis=2)
    fg = dist_bg > 5
    lab, n = ndi.label(fg)

    # Components overlapping top half (y_min < 495) belong to Arm_Cuff; remaining bottom components belong to Flare+Forearm
    cuff_mask = np.zeros_like(fg)
    lower_mask = np.zeros_like(fg)
    for i in range(1, n + 1):
        m = (lab == i)
        ys = np.nonzero(m)[0]
        if int(ys.min()) < 495 and int(ys.max()) <= 545:
            cuff_mask |= m
        else:
            lower_mask |= m

    # Smooth 1.5px alpha feather for clean anti-aliased composite
    def make_rgba(mask):
        # dilate 1px to catch edge shading, soft feather
        edge = ndi.binary_dilation(mask, iterations=1)
        alpha = np.where(mask, 255, np.where(edge, 140, 0)).astype(np.uint8)
        rgba = np.dstack([rgb, alpha])
        return Image.fromarray(rgba, mode='RGBA').resize((out_size, out_size), Image.LANCZOS)

    return make_rgba(cuff_mask), make_rgba(lower_mask)


def main():
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    cuff_rgba, lower_rgba = extract_cuff_and_lower_layers(A002_VIEWS / 'front.png', out_size=640)
    qfront_rgb = Image.open(A002_VIEWS / 'q_front.png').convert('RGB').resize((640, 640), Image.LANCZOS)

    cuff_uri = pil_to_data_url(cuff_rgba, fmt='WEBP', quality=88)
    lower_uri = pil_to_data_url(lower_rgba, fmt='WEBP', quality=88)
    qfront_uri = pil_to_data_url(qfront_rgb, fmt='WEBP', quality=84)

    # Read fonts existence or link relative/system cleanly (note file-design copies local assets)
