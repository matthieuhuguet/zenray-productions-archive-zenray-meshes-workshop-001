def load_mod(name, path):
    spec = importlib.util.spec_from_file_location(name, str(path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def nearest_pad_rgb(rgb, fg):
    """Pad background pixels with nearest foreground RGB so global blur filters never smear bg gray into rims."""
    dist, idx = ndi.distance_transform_edt(~fg, return_indices=True)
    padded = rgb[idx[0], idx[1]]
    return padded


def measure_bilateral_luma_asym(lin_rgb, fg):
    """Find best reflection axis near centroid and compute normalized bilateral Luma MAE inside fg & flip(fg)."""
    lum = 0.2126 * lin_rgb[..., 0] + 0.7152 * lin_rgb[..., 1] + 0.0722 * lin_rgb[..., 2]
    ys, xs = np.nonzero(fg)
    cx = int(round(xs.mean()))
    h, w = fg.shape
    best_cx, best_err = cx, 1e9
    for shift in range(-18, 19, 2):
        c = cx + shift
        flip_lum = np.zeros_like(lum)
        flip_fg = np.zeros_like(fg)
        x_src = np.arange(w)
        x_dst = 2 * c - x_src
        valid = (x_dst >= 0) & (x_dst < w)
        flip_lum[:, x_dst[valid]] = lum[:, x_src[valid]]
        flip_fg[:, x_dst[valid]] = fg[:, x_src[valid]]
        both = fg & flip_fg
        if both.sum() < 1000:
            continue
        err = float(np.mean(np.abs(lum[both] - flip_lum[both])) / max(np.mean(lum[both]), 1e-5))
        if err < best_err:
            best_err = err
            best_cx = c
    return best_cx, best_err


def sobel_yellow_response(gray, fg):
    """Extract normalized Sobel ridge response inside interior mask (shrunk 4 px so outer silhouette is excluded)."""
    interior = ndi.binary_erosion(fg, iterations=5)
    gx = ndi.sobel(gray, axis=1)
    gy = ndi.sobel(gray, axis=0)
    mag = np.hypot(gx, gy)
    mag = np.where(interior, mag, 0.0)
    p95 = np.percentile(mag[interior], 95) if interior.sum() > 0 else 1.0
    return np.clip(mag / max(p95, 1e-6), 0.0, 1.0), interior


def geo_audit_py(verts, quads):
    """Pure-Python equivalent of zenray-houdini GeoAudit.audit() for structured quad meshes."""
    edge_counts = {}
    dir_edges = {}
    zero_area = 0
    signed_vol6 = 0.0
    for q in quads:
        pts = [verts[i] for i in q]
        a1 = np.linalg.norm(np.cross(pts[1] - pts[0], pts[2] - pts[0]))
        a2 = np.linalg.norm(np.cross(pts[2] - pts[0], pts[3] - pts[0]))
        if 0.5 * (a1 + a2) < 1e-12:
            zero_area += 1
        # Signed volume of quad split into two tris
        signed_vol6 += float(np.dot(pts[0], np.cross(pts[1], pts[2])))
        signed_vol6 += float(np.dot(pts[0], np.cross(pts[2], pts[3])))
        for k in range(4):
            u, v = q[k], q[(k + 1) % 4]
            e = (min(u, v), max(u, v))
            edge_counts[e] = edge_counts.get(e, 0) + 1
            dir_edges[(u, v)] = dir_edges.get((u, v), 0) + 1
    open_edges = sum(1 for c in edge_counts.values() if c == 1)
    nonmanifold = sum(1 for c in edge_counts.values() if c > 2)
    inconsistent_winding = sum(1 for c in dir_edges.values() if c > 1)
    vol = signed_vol6 / 6.0
    return {
        'verts': len(verts),
        'quads': len(quads),
        'open_edges_by_id': open_edges,
        'nonmanifold_edges_by_id': nonmanifold,
        'inconsistent_winding_edges': inconsistent_winding,
        'zero_area_faces': zero_area,
        'volume_m3': round(vol, 6),
        'ok_manifold': (nonmanifold == 0 and inconsistent_winding == 0 and zero_area == 0),
    }


def build_arm_cuff_3d_shell(nu=28, nv=14):
    """Build closed thin-shell quad Arm_Cuff (watertight manifold + inner wall + rim caps) with (gu, gv) UV & seam flags."""
    verts = []
    quads = []
    # Open half-cuff extruded cleanly along radial thickness (closed box-topology manifold grid!)
    u_grid = np.linspace(-0.78 * math.pi, 0.78 * math.pi, nu)
    v_grid = np.linspace(-0.11, 0.11, nv)  # metres (scaled next to 1.76m mannequin)
    thick = 0.008  # 8 mm armor plate thickness

    # Create outer layer (0) and inner layer (1) sharing rim skirts
    def pt_at(iu, iv, layer):
        ang = u_grid[iu]
        vv = v_grid[iv]
        # Flared cuff contour
        r = 0.068 + 0.012 * (vv / 0.11) ** 2 - (0.014 if (abs(ang) < 0.25 and vv > 0.055) else 0.0)
        r_eff = r if layer == 0 else r - thick
        x = r_eff * math.sin(ang)
        z = r_eff * math.cos(ang)
        y = vv
        return np.array([x, y, z], dtype=np.float64)

    grid_idx = {}
    for layer in range(2):
        for iu in range(nu):
            for iv in range(nv):
                grid_idx[(layer, iu, iv)] = len(verts)
                verts.append(pt_at(iu, iv, layer))

    uv_strips = []
    # Outer faces (CCW viewed from outside: +R normal)
    for iu in range(nu - 1):
        for iv in range(nv - 1):
            a = grid_idx[(0, iu, iv)]
            b = grid_idx[(0, iu + 1, iv)]
            c = grid_idx[(0, iu + 1, iv + 1)]
            d = grid_idx[(0, iu, iv + 1)]
            quads.append((a, b, c, d))
            uv_strips.append(('outer', iu / (nu - 1), iv / (nv - 1), (iu + 1) / (nu - 1), (iv + 1) / (nv - 1)))
    # Inner faces (reversed orientation so outward normal points toward center arm hole)
    for iu in range(nu - 1):
        for iv in range(nv - 1):
            a = grid_idx[(1, iu, iv)]
            b = grid_idx[(1, iu + 1, iv)]
            c = grid_idx[(1, iu + 1, iv + 1)]
            d = grid_idx[(1, iu, iv + 1)]
            quads.append((a, d, c, b))
            uv_strips.append(('inner', iu / (nu - 1), iv / (nv - 1), (iu + 1) / (nu - 1), (iv + 1) / (nv - 1)))
    # Top & bottom rims
    for iu in range(nu - 1):
        quads.append((grid_idx[(0, iu, nv - 1)], grid_idx[(0, iu + 1, nv - 1)], grid_idx[(1, iu + 1, nv - 1)], grid_idx[(1, iu, nv - 1)]))
        uv_strips.append(('rim_top', iu / (nu - 1), 0.0, (iu + 1) / (nu - 1), 1.0))
        quads.append((grid_idx[(0, iu + 1, 0)], grid_idx[(0, iu, 0)], grid_idx[(1, iu, 0)], grid_idx[(1, iu + 1, 0)]))
        uv_strips.append(('rim_bot', iu / (nu - 1), 0.0, (iu + 1) / (nu - 1), 1.0))
    # Left & right end caps
    for iv in range(nv - 1):
        quads.append((grid_idx[(0, 0, iv)], grid_idx[(0, 0, iv + 1)], grid_idx[(1, 0, iv + 1)], grid_idx[(1, 0, iv)]))
        uv_strips.append(('cap_l', iv / (nv - 1), 0.0, (iv + 1) / (nv - 1), 1.0))
        quads.append((grid_idx[(0, nu - 1, iv + 1)], grid_idx[(0, nu - 1, iv)], grid_idx[(1, nu - 1, iv)], grid_idx[(1, nu - 1, iv + 1)]))
        uv_strips.append(('cap_r', iv / (nv - 1), 0.0, (iv + 1) / (nv - 1), 1.0))

    return np.array(verts), quads, uv_strips


def synth_5maps_for_sheet(res=512, px_per_m=1024.0, relief_depth_m=0.01):
    """Synthesize aligned UV island sheet + compute exact HeightTo5MapsCop.py BaseColor, Normal, Height, Roughness, AO."""
    y, x = np.mgrid[0:res, 0:res] / float(res)
    # 2 upright aligned islands: Outer plate [0.06..0.94]x[0.06..0.54] and Trim strip [0.06..0.94]x[0.62..0.92]
    m_outer = (x >= 0.06) & (x <= 0.94) & (y >= 0.06) & (y <= 0.54)
    m_trim = (x >= 0.06) & (x <= 0.94) & (y >= 0.62) & (y <= 0.92)
    islands = m_outer | m_trim

    # Relief Height: base plate + beveled ribs + rivets inside outer + parallel groove in trim
    h = np.zeros((res, res), dtype=np.float64)
    h[m_outer] = 0.52
    h[m_trim] = 0.48
    # Central chevron ridge on outer plate
    u_rel = (x - 0.5) * 2.0
    v_rel = (y - 0.30) / 0.24
    chevron = np.exp(-((np.abs(u_rel) * 0.45 - (v_rel + 0.15)) ** 2) / (2 * 0.035 ** 2))
    h[m_outer] += 0.34 * chevron[m_outer]
    # Border recess groove
    groove = m_outer & ((np.abs(x - 0.09) < 0.01) | (np.abs(x - 0.91) < 0.01) | (np.abs(y - 0.09) < 0.01) | (np.abs(y - 0.51) < 0.01))
    h[groove] -= 0.24
    # Trim bevel groove
    trim_g = m_trim & (np.abs(y - 0.77) < 0.025)
    h[trim_g] -= 0.26
    h = ndi.gaussian_filter(h, 1.2)
    h = np.clip(h, 0.0, 1.0)

    # Exact HeightTo5MapsCop.py scaling: derivative scale = relief_depth_m * px_per_m * 2 / W
    deriv_scale = relief_depth_m * px_per_m * 2.0 / float(res)
    dhdx = np.gradient(h, axis=1) * (deriv_scale * res * 0.5)
    dhdy = np.gradient(h, axis=0) * (deriv_scale * res * 0.5)
    nx = -dhdx
    ny = dhdy  # OpenGL +V green
    nz = np.ones_like(h)
    n_len = np.sqrt(nx ** 2 + ny ** 2 + nz ** 2)
    normal = np.stack([(nx / n_len) * 0.5 + 0.5, (ny / n_len) * 0.5 + 0.5, (nz / n_len) * 0.5 + 0.5], axis=-1)

    # AO from height cavity contrast (local smoothed height minus h)
    ao = np.clip(1.0 - np.maximum(ndi.gaussian_filter(h, 8.0) - h, 0.0) * 3.2, 0.25, 1.0)
    # Delit metallic/leather BaseColor tied to height features & cavities
    bc = np.zeros((res, res, 3), dtype=np.float64)
    bc[..., :] = np.array([0.14, 0.16, 0.19])  # bg dark neutral
    bc[m_outer] = np.array([0.28, 0.31, 0.36])
    bc[m_trim] = np.array([0.46, 0.36, 0.24])
    bc[chevron > 0.35] = np.array([0.52, 0.55, 0.61])
    bc[groove | trim_g] *= 0.62
    bc = np.clip(bc * (0.85 + 0.15 * ao[..., None]), 0.0, 1.0)

    # Exact HeightTo5MapsCop.py Roughness formula:
    # rough = clamp(rough_base + rough_ao * (1 - AO) - rough_lum * (lum - rough_lum_ref), 0, 1)
    lum = 0.2126 * bc[..., 0] + 0.7152 * bc[..., 1] + 0.0722 * bc[..., 2]
    rough = np.clip(0.38 + 0.28 * (1.0 - ao) - 0.30 * (lum - 0.45), 0.08, 0.95)
    return islands, m_outer, m_trim, h, normal, ao, bc, rough


