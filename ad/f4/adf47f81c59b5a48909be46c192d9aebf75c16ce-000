          <rect width="405" height="690" rx="22" fill="var(--surface)" stroke="var(--line)" stroke-width="2"/>
          <rect x="24" y="24" width="146" height="36" rx="18" fill="var(--p0bg)"/>
          <text x="97" y="48" text-anchor="middle" font-family="Adobe Clean, sans-serif" font-size="18" font-weight="700" fill="var(--p0)">&lt; 1 HEURE</text>
          <text x="24" y="102" font-family="Adobe Clean, sans-serif" font-size="28" font-weight="700" fill="var(--ink)">Débloquer l'atelier</text>
          <text x="24" y="136" font-family="Adobe Clean, sans-serif" font-size="19" fill="var(--mute)">UI &amp; serveur locaux</text>
          <line x1="24" y1="162" x2="381" y2="162" stroke="var(--line)" stroke-width="2"/>
          <text x="24" y="205" font-family="Adobe Clean, sans-serif" font-size="20" font-weight="700" fill="var(--ink)">1. Bouton Save réparé</text>
          <text x="24" y="233" font-family="Adobe Clean, sans-serif" font-size="17" fill="var(--mute)">Parenthèses JS sur !S.edits.size</text>
