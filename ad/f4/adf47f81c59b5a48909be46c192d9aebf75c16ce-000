          <text x="24" y="102" font-family="Adobe Clean, sans-serif" font-size="28" font-weight="700" fill="var(--ink)">Pur Quad &amp; Cockpit</text>
          <text x="24" y="136" font-family="Adobe Clean, sans-serif" font-size="19" fill="var(--mute)">Houdini robuste + feedback 10 s</text>
