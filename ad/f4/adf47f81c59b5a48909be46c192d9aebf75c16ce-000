          <text x="24" y="323" font-family="Adobe Clean, sans-serif" font-size="17" fill="var(--mute)">Voir l'erreur bas 0,48 en un coup d'oeil</text>
          <text x="24" y="385" font-family="Adobe Clean, sans-serif" font-size="20" font-weight="700" fill="var(--ink)">10. Bishop Organique &amp; Cartes</text>
          <text x="24" y="413" font-family="Adobe Clean, sans-serif" font-size="17" fill="var(--mute)">0 vrille Frenet · -99,89 % tris feuillage</text>
          <rect x="24" y="565" width="357" height="96" rx="14" fill="var(--soft)"/>
          <text x="44" y="603" font-family="Adobe Clean, sans-serif" font-size="18" font-weight="700" fill="var(--ink)">Preuve mesurée (PoC 2 &amp; 4) :</text>
          <text x="44" y="633" font-family="Adobe Clean, sans-serif" font-size="17" fill="var(--mute)">472 quads purs (6,99 ms), 0 triangle.</text>
        </g>

        <!-- Phase P3 -->
        <g transform="translate(1415,295)">
          <circle cx="80" cy="-50" r="22" fill="var(--p3)"/>
          <text x="80" y="-43" text-anchor="middle" font-family="Adobe Clean, sans-serif" font-size="18" font-weight="700" fill="#ffffff">P3</text>
          <rect width="425" height="690" rx="22" fill="var(--surface)" stroke="var(--line)" stroke-width="2"/>
