          <rect x="24" y="565" width="357" height="96" rx="14" fill="var(--soft)"/>
          <text x="44" y="603" font-family="Adobe Clean, sans-serif" font-size="18" font-weight="700" fill="var(--ink)">Preuve immédiate :</text>
          <text x="44" y="633" font-family="Adobe Clean, sans-serif" font-size="17" fill="var(--mute)">Chaque projet s'ouvre et sauve en direct.</text>
        </g>

        <!-- Phase P1 -->
        <g transform="translate(525,295)">
          <circle cx="80" cy="-50" r="22" fill="var(--p1)"/>
          <text x="80" y="-43" text-anchor="middle" font-family="Adobe Clean, sans-serif" font-size="18" font-weight="700" fill="#ffffff">P1</text>
          <rect width="405" height="690" rx="22" fill="var(--surface)" stroke="var(--line)" stroke-width="2"/>
          <rect x="24" y="24" width="128" height="36" rx="18" fill="var(--p1bg)"/>
          <text x="88" y="48" text-anchor="middle" font-family="Adobe Clean, sans-serif" font-size="18" font-weight="700" fill="var(--p1)">JOUR 1</text>
          <text x="24" y="102" font-family="Adobe Clean, sans-serif" font-size="28" font-weight="700" fill="var(--ink)">5 vues &amp; CMY 2.0</text>
          <text x="24" y="136" font-family="Adobe Clean, sans-serif" font-size="19" fill="var(--mute)">Vues verrouillées + extraction</text>
          <line x1="24" y1="162" x2="381" y2="162" stroke="var(--line)" stroke-width="2"/>
          <text x="24" y="205" font-family="Adobe Clean, sans-serif" font-size="20" font-weight="700" fill="var(--ink)">5. Proxy 3D avant Gemini</text>
          <text x="24" y="233" font-family="Adobe Clean, sans-serif" font-size="17" fill="var(--mute)">Bloque les dérives d'échelle et d'axe</text>
          <text x="24" y="295" font-family="Adobe Clean, sans-serif" font-size="20" font-weight="700" fill="var(--ink)">6. Crêtes jaunes + encoches</text>
          <text x="24" y="323" font-family="Adobe Clean, sans-serif" font-size="17" fill="var(--mute)">+63 % de longueur, 0 point rouge bruité</text>
          <text x="24" y="385" font-family="Adobe Clean, sans-serif" font-size="20" font-weight="700" fill="var(--ink)">7. Routeur à 4 archétypes</text>
          <text x="24" y="413" font-family="Adobe Clean, sans-serif" font-size="17" fill="var(--mute)">A Coque · B Creux · C Organique · D Arbre</text>
          <rect x="24" y="565" width="357" height="96" rx="14" fill="var(--soft)"/>
          <text x="44" y="603" font-family="Adobe Clean, sans-serif" font-size="18" font-weight="700" fill="var(--ink)">Preuve mesurée (PoC 1) :</text>
          <text x="44" y="633" font-family="Adobe Clean, sans-serif" font-size="17" fill="var(--mute)">1612 px continus vs 989 px V1 (Arm_Flare).</text>
        </g>

        <!-- Phase P2 -->
        <g transform="translate(970,295)">
          <circle cx="80" cy="-50" r="22" fill="var(--p2)"/>
          <text x="80" y="-43" text-anchor="middle" font-family="Adobe Clean, sans-serif" font-size="18" font-weight="700" fill="#ffffff">P2</text>
          <rect width="405" height="690" rx="22" fill="var(--surface)" stroke="var(--line)" stroke-width="2"/>
          <rect x="24" y="24" width="144" height="36" rx="18" fill="var(--p2bg)"/>
