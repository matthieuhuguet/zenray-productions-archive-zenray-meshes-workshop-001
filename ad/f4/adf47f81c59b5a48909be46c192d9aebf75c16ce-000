<script>
const root = document.documentElement;
document.getElementById('themeBtn').addEventListener('click', () => {
  const darkNow = root.getAttribute('data-theme') === 'dark';
  root.setAttribute('data-theme', darkNow ? 'light' : 'dark');
});

const filterBtns = [...document.querySelectorAll('[data-filter]')];
const cards = [...document.querySelectorAll('.fix-card')];
filterBtns.forEach(btn => btn.addEventListener('click', () => {
  const f = btn.dataset.filter;
  filterBtns.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
  cards.forEach(c => {
    const show = (f === 'all' || c.dataset.prio === f);
    c.classList.toggle('hidden', !show);
  });
}));

const slTarget = document.getElementById('slTarget');
const slTol = document.getElementById('slTol');
function updateSim() {
  const t = parseInt(slTarget.value, 10);
  const tol = parseInt(slTol.value, 10) * 0.1;
  const labels = ['', 'Hard Surface seul (A+B)', 'HS + Personnage (A+B+C)', 'Tous (A+B+C+D)'];
  document.getElementById('outTarget').textContent = labels[t];
  document.getElementById('outTol').textContent = tol.toFixed(1).replace('.', ',') + ' %';
  const score = Math.max(96.0, 100 - tol).toFixed(1).replace('.', ',') + ' %';
  document.getElementById('kpiScore').textContent = score;
  const effortDays = t === 1 ? '2,5 jours' : t === 2 ? '3,5 jours' : '4 jours';
  document.getElementById('kpiEffort').textContent = effortDays;
  const lineW = t === 1 ? 1050 : t === 2 ? 1420 : 1800;
  document.getElementById('svgProgressLine').setAttribute('x2', String(lineW));
}
slTarget.addEventListener('input', updateSim);
slTol.addEventListener('input', updateSim);
updateSim();
</script>
