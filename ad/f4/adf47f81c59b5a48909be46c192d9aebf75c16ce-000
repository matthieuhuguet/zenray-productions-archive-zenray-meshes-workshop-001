<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Plan d'action P0 à P3 : Corrections exactes & feuille de route ZenRay Meshes 2.0</title>
<style>
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Regular.woff2') format('woff2');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Medium.woff2') format('woff2');font-weight:500;font-style:normal;font-display:swap}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Bold.woff2') format('woff2');font-weight:700;font-style:normal;font-display:swap}

:root{
  --paper:#f5f4f1;
  --surface:#ffffff;
  --soft:#eceae4;
  --ink:#16171a;
  --mute:#5b5f69;
  --line:#dcd9d0;
  --accent:#111317;
  --p0:#b42318;
  --p0bg:#fef3f2;
  --p1:#026aa2;
  --p1bg:#f0f9ff;
  --p2:#6941c6;
  --p2bg:#f9f5ff;
  --p3:#027a48;
  --p3bg:#ecfdf3;
  --t:0.2s cubic-bezier(.22,.61,.36,1);
}
[data-theme="dark"]{
  --paper:#121317;
  --surface:#1a1c22;
  --soft:#23262f;
  --ink:#f3f4f6;
  --mute:#a1a7b3;
  --line:#2e323d;
  --accent:#ffffff;
  --p0:#f97066;
  --p0bg:rgba(180,35,24,.18);
  --p1:#36bffa;
  --p1bg:rgba(2,106,162,.2);
  --p2:#b692f6;
  --p2bg:rgba(105,65,198,.2);
  --p3:#32d583;
  --p3bg:rgba(2,122,72,.2);
}
@media (prefers-reduced-motion:reduce){:root{--t:0s}}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--paper);color:var(--ink);font-family:'Adobe Clean',-apple-system,BlinkMacSystemFont,sans-serif;font-synthesis:none;-webkit-font-smoothing:antialiased;transition:background var(--t),color var(--t)}
main{max-width:1400px;margin:0 auto;padding:28px 32px 56px}
.head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:14px}
h1{font-size:28px;font-weight:700;letter-spacing:-0.02em;margin:0}
.sub{color:var(--mute);font-size:15px;line-height:1.55;max-width:78ch;margin:8px 0 0}
.actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.btn{border:1px solid var(--line);background:var(--surface);color:var(--ink);font:inherit;font-size:13px;font-weight:500;padding:8px 14px;border-radius:999px;cursor:pointer;transition:all var(--t)}
.btn:hover{border-color:var(--ink)}
.btn[aria-pressed="true"]{background:var(--accent);color:var(--paper);border-color:var(--accent)}

/* Top KPI Strip */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:20px 0 22px}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.kpi .lbl{font-size:12px;color:var(--mute);font-weight:500;margin-bottom:4px}
.kpi .val{font-size:26px;font-weight:700;letter-spacing:-0.02em}
.kpi .hint{font-size:12px;color:var(--mute);margin-top:4px}

/* SVG Roadmap Card */
.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:20px 22px;margin-bottom:24px}
.card-head{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:14px}
.card-title{font-size:17px;font-weight:700;margin:0}
.hda-panel{display:flex;gap:18px;align-items:center;flex-wrap:wrap;background:var(--soft);padding:10px 14px;border-radius:12px}
.hda-ctrl{display:flex;flex-direction:column;gap:4px;min-width:210px}
.hda-ctrl label{display:flex;justify-content:space-between;gap:12px;font-size:12px;font-weight:500;color:var(--ink)}
.hda-ctrl output{color:var(--mute);font-variant-numeric:tabular-nums}
input[type=range]{width:100%;accent-color:var(--ink);margin:0;cursor:pointer}
.svg-wrap{width:100%;overflow:hidden;border-radius:12px;border:1px solid var(--line);background:var(--paper)}
.svg-wrap svg{display:block;width:100%;height:auto}

/* Filter Rail */
.filters{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0 18px;align-items:center}
.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.02em}
.p0{color:var(--p0);background:var(--p0bg)}
.p1{color:var(--p1);background:var(--p1bg)}
.p2{color:var(--p2);background:var(--p2bg)}
.p3{color:var(--p3);background:var(--p3bg)}

/* Roadmap Cards Grid */
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.fix-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:12px;transition:border-color var(--t),transform var(--t)}
.fix-card:hover{border-color:var(--mute)}
.fix-card.hidden{display:none}
.fix-top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.fix-title{font-size:16px;font-weight:700;margin:0}
.fix-meta{font-size:12px;color:var(--mute)}
.ba{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.box{border-radius:10px;padding:10px 12px;font-size:13px;line-height:1.45;border:1px solid var(--line)}
.box.before{background:var(--soft)}
.box.after{background:var(--paper)}
.box strong{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;color:var(--mute)}
.src-ref{font-size:11.5px;color:var(--mute);border-top:1px solid var(--line);padding-top:8px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;background:var(--soft);padding:1px 5px;border-radius:5px}

@media (max-width:960px){
  .kpis{grid-template-columns:repeat(2,1fr)}
  .grid{grid-template-columns:1fr}
}
</style>
</head>
<body>
<main>
  <header class="head">
    <div>
