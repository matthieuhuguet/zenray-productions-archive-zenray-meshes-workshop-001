## 7. Code complet (numpy/scipy), testé le 30 October 2026

Chargement : python -I, venv /Users/zenray/.venvs/zenray-meshes/bin/python ; dépendances : numpy, scipy. Il contient les fonctions boundary_loop, polygon_regular, polygon_cyclic, boundary_uv, mean_value_system, tutte_mv, uv_check, lift, grid_quads, quad_fold_stats. Banc de la section 0 : bande de sphère lat-lon, 120 x 60 cellules.

```python
"""30 October 2026 : intrinsic patch fill (mean value Tutte embedding of a surface region onto a convex polygon, barycentric lift). Self-contained numpy/scipy. python -I intrinsic_fill.py (runs a self-test)."""
import numpy as np
import scipy.sparse as sp
import scipy.sparse.linalg as spla

# ---------------------------------------------------------------- 1. boundary loop and sides
def boundary_loop(F):
    """ordered boundary vertex loop of a disk-like triangle set F (n,3) (one loop expected)."""
    E = {}
    for a, b, c in F:
        for u, v in ((a, b), (b, c), (c, a)):
            E[(u, v)] = E.get((u, v), 0) + 1
    nxt = {u: v for (u, v), n in E.items() if (v, u) not in E}
    if not nxt: raise ValueError("no boundary: region is closed")
    start = next(iter(nxt)); loop = [start]
    while nxt[loop[-1]] != start:
        loop.append(nxt[loop[-1]])
        if len(loop) > len(nxt): raise ValueError("boundary is not a single simple loop")
    if len(loop) != len(nxt): raise ValueError("several boundary loops: region is not a disk")
    return loop

# ---------------------------------------------------------------- 2. target polygon
def polygon_regular(N):
    th = 2 * np.pi * np.arange(N) / N - np.pi / 2 - np.pi / N
    return np.c_[np.cos(th), np.sin(th)]

def polygon_cyclic(l):
    """strictly convex polygon inscribed in a circle, side i has length proportional to l[i]; None if max(l) >= sum(others).
    Two cases: circle centre inside the polygon (sum of central angles = 2 pi) or outside (longest side subtends the sum of the others)."""
    l = np.asarray(l, float); N = len(l); im = int(np.argmax(l))
    if N < 3 or l[im] >= l.sum() - l[im]: return None
    others = np.delete(l, im); lo0 = l[im] / 2 * (1 + 1e-12)
    f_in = lambda R: np.sum(2 * np.arcsin(np.clip(l / (2 * R), 0, 1))) - 2 * np.pi
    h_out = lambda R: np.arcsin(np.clip(l[im] / (2 * R), 0, 1)) - np.sum(np.arcsin(np.clip(others / (2 * R), 0, 1)))
    def bis(g, lo, hi):
        if g(lo) * g(hi) > 0: return None
        for _ in range(200):
            m = 0.5 * (lo + hi)
            lo, hi = (m, hi) if g(lo) * g(m) > 0 else (lo, m)
        return 0.5 * (lo + hi)
    R = bis(f_in, lo0, 1e6 * l.sum())
    if R is not None: ang = 2 * np.arcsin(np.clip(l / (2 * R), 0, 1))
    else:
        R = bis(h_out, lo0, 1e6 * l.sum()); ang = 2 * np.arcsin(np.clip(l / (2 * R), 0, 1)); ang[im] = -(ang.sum() - ang[im])
    th = np.concatenate([[0], np.cumsum(ang)[:-1]]); th -= th.mean()
    return R * np.c_[np.cos(th), np.sin(th)]

def boundary_uv(X, loop, corners, l, poly, bulge=1e-3):
    """UV of boundary vertices: arc-length fraction along each side mapped on the polygon side; a small bulge makes the polygon strictly convex.
    corners: indices IN loop (increasing) of the N corners; l: edge counts; poly: (N,2) corners."""
    N = len(corners); uv = np.zeros((len(loop), 2)); P = X[loop]
    seg = np.r_[np.linalg.norm(np.diff(P, axis=0), axis=1), np.linalg.norm(P[0] - P[-1])]
    for i in range(N):
        a, b = corners[i], corners[(i + 1) % N]
        idx = list(range(a, b + 1)) if b > a else list(range(a, len(loop))) + list(range(0, b + 1))
        s = np.r_[0, np.cumsum([seg[k % len(loop)] for k in idx[:-1]])]; t = s / s[-1]
        p0, p1 = poly[i], poly[(i + 1) % N]; d = p1 - p0; nrm = np.array([d[1], -d[0]])  # outward for ccw polygon
        for j, k in enumerate(idx[:-1] if True else idx):
            uv[k] = p0 + t[j] * d + bulge * np.linalg.norm(d) * 4 * t[j] * (1 - t[j]) * nrm / (np.linalg.norm(nrm) + 1e-30)
    return uv

# ---------------------------------------------------------------- 3. mean value weights and solve
def mean_value_system(X, F, loop):
    n = len(X); nb = set(loop)
    # neighbours in cyclic order per interior vertex via the triangle fan
    fan = {}
    for a, b, c in F:
        for u, v, w in ((a, b, c), (b, c, a), (c, a, b)):
            fan.setdefault(u, {})[v] = w  # in triangle (u,v,w) ccw: next neighbour after v is w
    rows, cols, vals = [], [], []
    for i in range(n):
        if i in nb: continue
        nbr = fan[i]; v0 = next(iter(nbr)); order = [v0]
        while nbr[order[-1]] != v0:
            order.append(nbr[order[-1]])
            if len(order) > len(nbr): break
        p = X[order] - X[i]; r = np.linalg.norm(p, axis=1)
        q = np.roll(p, -1, axis=0); cosang = np.einsum('ij,ij->i', p, q) / (r * np.roll(r, -1))
        al = np.arccos(np.clip(cosang, -1, 1)); al *= 2 * np.pi / al.sum()           # angles rescaled to 2 pi (shape preserving)
        t = np.tan(np.minimum(al, np.pi - 1e-6) / 2)                                  # tan(alpha_j/2), alpha_j between neighbour j and j+1
        w = (np.roll(t, 1) + t) / r                                                  # (tan(alpha_{j-1}/2)+tan(alpha_j/2))/r_j
        w /= w.sum()
        rows += [i] * len(order); cols += order; vals += (-w).tolist(); rows.append(i); cols.append(i); vals.append(1.0)
    A = sp.csr_matrix((vals, (rows, cols)), shape=(n, n))
    return A

def tutte_mv(X, F, loop, uv_b):
    n = len(X); A = mean_value_system(X, F, loop); isb = np.zeros(n, bool); isb[loop] = True
    # boundary rows: identity
    A = A.tolil()
    for k in loop: A[k, :] = 0; A[k, k] = 1.0
    A = A.tocsc(); rhs = np.zeros((n, 2)); rhs[loop] = uv_b
    lu = spla.splu(A); return np.c_[lu.solve(rhs[:, 0]), lu.solve(rhs[:, 1])]

def uv_check(uv, F):
    a, b, c = uv[F[:, 0]], uv[F[:, 1]], uv[F[:, 2]]
    area = 0.5 * ((b[:, 0] - a[:, 0]) * (c[:, 1] - a[:, 1]) - (b[:, 1] - a[:, 1]) * (c[:, 0] - a[:, 0]))
    return area  # all > 0 for a valid embedding (ccw faces)

# ---------------------------------------------------------------- 4. locate and lift
def lift(points_uv, uv, F, X):
    """barycentric lift of 2D points into 3D through the triangles of the uv map (uniform grid for point location)."""
    from scipy.spatial import cKDTree
    cen = uv[F].mean(axis=1); tree = cKDTree(cen); out = np.zeros((len(points_uv), 3)); miss = 0
    a, b, c = uv[F[:, 0]], uv[F[:, 1]], uv[F[:, 2]]
    det = (b[:, 0] - a[:, 0]) * (c[:, 1] - a[:, 1]) - (b[:, 1] - a[:, 1]) * (c[:, 0] - a[:, 0])
    for k, p in enumerate(points_uv):
        _, cand = tree.query(p, k=min(24, len(F)))
        best, bb = -1e9, None
        for f in np.atleast_1d(cand):
            l1 = ((b[f, 0] - p[0]) * (c[f, 1] - p[1]) - (b[f, 1] - p[1]) * (c[f, 0] - p[0])) / det[f]
            l2 = ((c[f, 0] - p[0]) * (a[f, 1] - p[1]) - (c[f, 1] - p[1]) * (a[f, 0] - p[0])) / det[f]
            l3 = 1 - l1 - l2; m = min(l1, l2, l3)
            if m > best: best, bb = m, (f, l1, l2, l3)
            if m >= -1e-12: break
        if best < -1e-9: miss += 1
        f, l1, l2, l3 = bb; l = np.clip([l1, l2, l3], 0, None); l /= l.sum()
        out[k] = l[0] * X[F[f, 0]] + l[1] * X[F[f, 1]] + l[2] * X[F[f, 2]]
    return out, miss

# ---------------------------------------------------------------- 5. pattern grid (N = 4 regular grid) and the quality judge
def grid_quads(nx, ny):
    idx = lambda i, j: j * (nx + 1) + i
    return [[idx(i, j), idx(i + 1, j), idx(i + 1, j + 1), idx(i, j + 1)] for j in range(ny) for i in range(nx)]

def quad_fold_stats(Pq, Q, normals_at):
    """signed Jacobian per quad corner against the surface normal (corner folds: any negative)."""
    bad = 0; sq = 0
    for q in Q:
        pts = Pq[q]; nrm = normals_at(pts.mean(axis=0)); js = []
        for k in range(4):
            e1 = pts[(k + 1) % 4] - pts[k]; e2 = pts[(k - 1) % 4] - pts[k]
            js.append(np.dot(np.cross(e1, e2), nrm) / (np.linalg.norm(e1) * np.linalg.norm(e2) + 1e-30))
        if min(js) <= 0: bad += 1
        if min(js) < 0.3: sq += 1
    return bad, sq
```

Appel type (région d'un patch à N côtés ; F = triangles (n,3) numpy entiers orientés de manière cohérente, X = sommets 3D) :

```python
loop = boundary_loop(F)                              # une boucle, sinon ValueError
corners = [index in loop of the N corner vertices, increasing]
l = [edge counts of the N sides]                     # from the MILP, sum even
poly = polygon_cyclic(l)
if poly is None: poly = polygon_regular(len(l))      # fallback when max(l) >= sum of others
uvb = boundary_uv(X, loop, corners, l, poly, bulge=1e-3)
uv = tutte_mv(X, F, loop, uvb)                       # mean value Tutte embedding, no flip
assert (uv_check(uv, F) * np.sign(uv_check(uv, F).sum()) > 0).all()
# pattern_uv = 2D coordinates of the pattern vertices (Takayama topology relaxed by a Laplace solve with the polygon boundary)
P3, miss = lift(pattern_uv, uv, F, X)                # points on the reference surface
```
