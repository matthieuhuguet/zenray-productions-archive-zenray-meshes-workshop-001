"""29 October 2026 : ZenRay Retopology SEEDS, one named seed per component : the most interior point of its region in the clean MBO cut
(work/lines/mbo.npz), i.e. the region vertex farthest from the region border, written as lines/data/seeds_v752.json
[{"name", "p"}]. The editor imports them as the component registry ; the server names every face by the seed it contains.
python ZrlSeeds.py        FR : une graine nommée par component, au point le plus intérieur de sa région."""
import json, sys
import numpy as np
from scipy.spatial import cKDTree
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
PARAMS = {"mbo": f"{ROOT}/work/lines/mbo.npz", "out": f"{ROOT}/lines/data/seeds_v752.json"}   # 29 October 2026

if __name__ == "__main__":
    d = np.load(PARAMS["mbo"], allow_pickle=True); V, F, reg, names = d["V"], d["F"], d["region"], [str(n) for n in d["region_names"]]
    vreg = np.full(len(V), -1); vreg[F[:, 0]] = reg; vreg[F[:, 1]] = reg; vreg[F[:, 2]] = reg
    E = np.unique(np.sort(np.r_[F[:, [0, 1]], F[:, [1, 2]], F[:, [2, 0]]], axis=1), axis=0)
    ef = {}
    for k in range(3): pass
    border = np.zeros(len(V), bool); fr = np.r_[reg, reg, reg]; T = np.r_[F[:, [0, 1]], F[:, [1, 2]], F[:, [2, 0]]]; key = np.sort(T, axis=1)
    o = np.lexsort((key[:, 1], key[:, 0])); ks = key[o]; same = (ks[1:] == ks[:-1]).all(1); diff = same & (fr[o][1:] != fr[o][:-1])
    border[ks[1:][diff].ravel()] = True
    cnt = np.bincount(np.r_[ks[:, 0], ks[:, 1]], minlength=len(V))
    seeds = []
    for r in np.unique(reg):
        fv = np.unique(F[reg == r]); bv = fv[border[fv]]
        if len(bv) == 0: bv = fv[:1]
        dist, _ = cKDTree(V[bv]).query(V[fv]); k = int(np.argmax(dist)); seeds.append({"name": names[r], "p": [round(float(x), 5) for x in V[fv[k]]], "depth_m": round(float(dist[k]), 3)})
    json.dump(seeds, open(PARAMS["out"], "w"), indent=0); print(len(seeds), "seeds ;", min(s["depth_m"] for s in seeds), "to", max(s["depth_m"] for s in seeds), "m from their border")
