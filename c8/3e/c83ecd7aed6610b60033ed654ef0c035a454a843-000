# 26 October 2026 : ZenRay Meshes, PROCEDURAL TREE by orders, the SpeedTree way (Weber and Penn style), shared by every tree like object.
# EN: trunk (frozen, TrunkFit) then order 1 main limbs, order 2 branches, order 3 twigs, each order a handful of numbers (count, angle from the parent, length, bend toward
# the light, radius ratio) instead of thousands of evidence voxels ; the tips receive the leaf cards. The numbers are fitted on the reference by the X-ray wood score of each
# thickness class, order by order. Returns nodes, parents, order of every node (2 limbs, 3 branches, 4 twigs). FR : arbre procédural par ordres, quelques nombres par ordre.
# Usage (module) : N, par, order = TreeWP.build(root, trunk_dir, trunk_top_r, p, rng)
import numpy as np

DEFAULT = {"n1": 4, "phi0": 0.0, "theta1": 35.0, "len1": 4.5, "bend1": 0.35, "start1": 0.6, "n2": 4, "theta2": 45.0, "len2r": 0.55, "bend2": 0.25, "t2_lo": 0.25, "t2_hi": 0.9,
           "n3": 5, "theta3": 50.0, "len3r": 0.5, "bend3": 0.1, "t3_lo": 0.3, "t3_hi": 0.95, "step": 0.45, "jitter": 0.15, "seed": 3}


def _dir(theta_deg, phi_deg):
    t, f = np.radians(theta_deg), np.radians(phi_deg); return np.array([np.sin(t) * np.cos(f), np.cos(t), np.sin(t) * np.sin(f)])


def _branch(nodes, parent, order, start, d0, length, step, bend, rng, jitter, ordr):
    """grow one branch from node index `start` along d0 ; the direction turns toward +y by `bend` per metre (gravity free, light seeking) and wiggles by `jitter` ; returns its node indices."""
    idx = [start]; d = d0 / np.linalg.norm(d0); pos = nodes[start].copy(); n = max(int(length / step), 1)
    for _ in range(n):
        d = d + np.array([0.0, bend * step, 0.0]) + rng.normal(0, jitter * 0.3, 3) * step; d /= np.linalg.norm(d); pos = pos + d * step
        nodes.append(pos.copy()); parent.append(idx[-1]); order.append(ordr); idx.append(len(nodes) - 1)
    return idx


def build(root, trunk_dir, p, hull_check=None, seed=None):
    q = dict(DEFAULT); q.update(p); rng = np.random.default_rng(int(q["seed"]) if seed is None else seed)
    nodes = [np.asarray(root, float)]; parent = [-1]; order = [2]; step = float(q["step"])
    # order 1 : main limbs spread around the trunk top, polar angle from the vertical, golden azimuth spacing
    limbs = []
    for i in range(int(q["n1"])):
        phi = q["phi0"] + i * 360.0 / max(int(q["n1"]), 1) + rng.normal(0, 8); th = q["theta1"] * (0.8 + 0.4 * rng.random())
        # the first nodes climb along the trunk axis so the limb leaves the trunk at start1 x its length
        base = 0; up = int(q["start1"] * q["len1"] / step * (i / max(int(q["n1"]) - 1, 1)))
        for _ in range(up): nodes.append(nodes[base] + np.asarray(trunk_dir, float) * step); parent.append(base); order.append(2); base = len(nodes) - 1
        idx = _branch(nodes, parent, order, base, _dir(th, phi), q["len1"] * (0.8 + 0.4 * rng.random()), step, q["bend1"], rng, q["jitter"], 2); limbs.append(idx)
    br = []
    for idx in limbs:   # order 2 along each limb
        for j in range(int(q["n2"])):
            t = q["t2_lo"] + (q["t2_hi"] - q["t2_lo"]) * (j + rng.random()) / max(int(q["n2"]), 1); s = idx[min(int(t * (len(idx) - 1)), len(idx) - 1)]
            dpar = nodes[idx[min(int(t * (len(idx) - 1)) + 1, len(idx) - 1)]] - nodes[s]; dpar = dpar / (np.linalg.norm(dpar) + 1e-9)
            side = np.cross(dpar, [0, 1, 0]); side = side / (np.linalg.norm(side) + 1e-9) if np.linalg.norm(side) > 1e-6 else np.array([1.0, 0, 0]); sgn = 1 if (j % 2) else -1
            ang = np.radians(q["theta2"]); d = np.cos(ang) * dpar + np.sin(ang) * sgn * (np.cos(rng.random() * 6.28) * side + np.sin(rng.random() * 6.28) * np.cross(dpar, side))
            L = q["len2r"] * len(idx) * step * (1 - 0.5 * t) * (0.7 + 0.6 * rng.random()); br.append(_branch(nodes, parent, order, s, d, L, step, q["bend2"], rng, q["jitter"], 3))
    for idx in br:   # order 3 twigs along each branch
        for j in range(int(q["n3"])):
            t = q["t3_lo"] + (q["t3_hi"] - q["t3_lo"]) * (j + rng.random()) / max(int(q["n3"]), 1); s = idx[min(int(t * (len(idx) - 1)), len(idx) - 1)]
            dpar = nodes[idx[min(int(t * (len(idx) - 1)) + 1, len(idx) - 1)]] - nodes[s]; dpar = dpar / (np.linalg.norm(dpar) + 1e-9)
            rnd = rng.normal(0, 1, 3); rnd -= dpar * (rnd @ dpar); rnd /= np.linalg.norm(rnd) + 1e-9; ang = np.radians(q["theta3"]); d = np.cos(ang) * dpar + np.sin(ang) * rnd
            _branch(nodes, parent, order, s, d, q["len3r"] * len(idx) * step * (0.6 + 0.8 * rng.random()), step * 0.7, q["bend3"], rng, q["jitter"], 4)
    return np.array(nodes), np.array(parent), np.array(order)
