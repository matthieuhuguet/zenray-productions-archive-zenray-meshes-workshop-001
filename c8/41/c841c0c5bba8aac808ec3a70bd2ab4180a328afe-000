"""Rendu argile orthographique (numpy + numba, déterministe, sans GPU) : tampon de profondeur, identifiants de faces,
ombrage de Lambert avec une lumière clé et une ambiante. Convention : caméra à +d regardant vers -d ; a = up x d (droite
de l'image), b = d x a (haut de l'image), z = P.d (plus grand = plus proche). 30 October 2026."""
import numpy as np
from numba import njit

VIEWS = {   # direction de la caméra (vers la caméra), haut
    "front": ((0, 0, 1), (0, 1, 0)), "back": ((0, 0, -1), (0, 1, 0)),
    "left": ((1, 0, 0), (0, 1, 0)), "right": ((-1, 0, 0), (0, 1, 0)),
    "top": ((0, 1, 0), (-1, 0, 0)), "bottom": ((0, -1, 0), (-1, 0, 0)),
}

def view_basis(name_or_d, up=None):
    if isinstance(name_or_d, str):
        d, up = VIEWS[name_or_d]
    else:
        d = name_or_d
        up = up if up is not None else (0, 1, 0)
    d = np.array(d, float); d /= np.linalg.norm(d)
    up = np.array(up, float)
    a = np.cross(up, d)
    if np.linalg.norm(a) < 1e-9:
        a = np.cross((1, 0, 0), d)
    a /= np.linalg.norm(a)
    b = np.cross(d, a)
    return a, b, d

@njit(cache=True)
def _raster(sx, sy, sz, W, H):
    T = sx.shape[0]
    zbuf = np.full((H, W), -1e18)
    idb = np.full((H, W), -1, np.int64)
    for t in range(T):
        x0, y0, x1, y1, x2, y2 = sx[t, 0], sy[t, 0], sx[t, 1], sy[t, 1], sx[t, 2], sy[t, 2]
        den = (y1 - y2) * (x0 - x2) + (x2 - x1) * (y0 - y2)
        if abs(den) < 1e-12:
            continue
        xmin = max(int(np.floor(min(x0, x1, x2))), 0); xmax = min(int(np.ceil(max(x0, x1, x2))), W - 1)
        ymin = max(int(np.floor(min(y0, y1, y2))), 0); ymax = min(int(np.ceil(max(y0, y1, y2))), H - 1)
        for yy in range(ymin, ymax + 1):
            for xx in range(xmin, xmax + 1):
                px = xx + 0.5; py = yy + 0.5
                l0 = ((y1 - y2) * (px - x2) + (x2 - x1) * (py - y2)) / den
                l1 = ((y2 - y0) * (px - x2) + (x0 - x2) * (py - y2)) / den
                l2 = 1.0 - l0 - l1
                if l0 >= -1e-9 and l1 >= -1e-9 and l2 >= -1e-9:
                    z = l0 * sz[t, 0] + l1 * sz[t, 1] + l2 * sz[t, 2]
                    if z > zbuf[yy, xx]:
                        zbuf[yy, xx] = z
                        idb[yy, xx] = t
    return zbuf, idb

def render(V, tris, view, px=0.004, bounds=None, margin=8):
    """tris : (T,3) indices. Retourne dict(z, id, W, H, frame) ; frame = (a,b,d,x0,y1,px) pour repasser du pixel au monde."""
    a, b, d = view_basis(view) if not isinstance(view, tuple) else view_basis(*view)
    u = V @ a; v = V @ b; z = V @ d
    if bounds is None:
        x0, x1, y0, y1 = u.min(), u.max(), v.min(), v.max()
    else:
        x0, x1, y0, y1 = bounds
    x0 -= margin * px; x1 += margin * px; y0 -= margin * px; y1 += margin * px
    W = int(np.ceil((x1 - x0) / px)); H = int(np.ceil((y1 - y0) / px))
    sx = (u[tris] - x0) / px
    sy = (y1 - v[tris]) / px
    sz = z[tris]
    zbuf, idb = _raster(sx.astype(np.float64), sy.astype(np.float64), sz.astype(np.float64), W, H)
    return {"z": zbuf, "id": idb, "W": W, "H": H, "frame": (a, b, d, x0, y1, px)}

def shade(R, face_normals, key=(-0.4, 0.7, 0.6), amb=0.42, key_gain=0.58, bg=0.40, vertex_normals=None, tris=None, headlight=0.0):
    """Ombrage de Lambert. key est donné DANS LE MONDE (lumière fixe) ; amb + key_gain*max(0,n.l) (+ headlight*max(0,n.d))."""
    idb = R["id"]; a, b, d, *_ = R["frame"]
    l = np.array(key, float); l /= np.linalg.norm(l)
    n = face_normals[np.where(idb >= 0, idb, 0)]
    ndl = np.clip(n @ l, 0, None)
    ndv = np.clip(n @ d, 0, None)
    img = amb + key_gain * ndl + headlight * ndv
    img = np.where(idb >= 0, img, bg)
    return np.clip(img, 0, 1)

def tri_normals(V, tris, flip=None):
    n = np.cross(V[tris[:, 1]] - V[tris[:, 0]], V[tris[:, 2]] - V[tris[:, 0]])
    nn = np.linalg.norm(n, axis=1); nn[nn == 0] = 1
    n = n / nn[:, None]
    return n

def quads_to_tris(Q):
    return np.concatenate([Q[:, [0, 1, 2]], Q[:, [0, 2, 3]]], axis=0)
