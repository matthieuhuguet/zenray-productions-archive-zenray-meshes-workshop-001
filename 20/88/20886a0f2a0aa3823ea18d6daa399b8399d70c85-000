"""Pass 9 : detection of the hard edge regime. For a triangle mesh : sharp segmentation (35 degrees), then the dihedral angle of every crease edge
(angle between the two triangle normals, 0 = flat), histogram weighted by crease length, and the share of crease length that sits on right angle
(90 +- 3), chamfer (45 +- 3 and 135 +- 3 turned angle) or other values. Written 30 October 2026.
Usage : python3 -I hard_edge_regime.py base=WORK names=hard:chamfer_box,... ; prints one JSON line per mesh.
FR : detection du regime hard edge par l'histogramme des angles diedres des aretes vives."""
import sys, json, collections
sys.path.insert(0, ".")
import numpy as np
import zr8_io as IO, zr8_regions as R


def dihedral_report(V, F, angle_deg=35.0):
    pid, n = R.sharp_segmentation(V, F, angle_deg)
    nrm = np.cross(V[F[:, 1]] - V[F[:, 0]], V[F[:, 2]] - V[F[:, 0]]); nrm /= np.maximum(np.linalg.norm(nrm, axis=1, keepdims=True), 1e-30)
    ef = collections.defaultdict(list)
    for fi, t in enumerate(F):
        for k in range(3):
            a, b = int(t[k]), int(t[(k + 1) % 3]); ef[(min(a, b), max(a, b))].append(fi)
    ang = []; ln = []
    for (a, b), fl in ef.items():
        if len(fl) == 2 and pid[fl[0]] != pid[fl[1]]:
            c = np.clip(nrm[fl[0]] @ nrm[fl[1]], -1, 1); ang.append(np.degrees(np.arccos(c))); ln.append(np.linalg.norm(V[a] - V[b]))
    ang = np.array(ang); ln = np.array(ln)
    if len(ang) == 0:
        return {"regions": int(n), "crease_length": 0.0}
    tot = ln.sum(); out = {"regions": int(n), "crease_length": round(float(tot), 4)}
    out["share_turn_90_pm3"] = round(float(ln[np.abs(ang - 90) <= 3].sum() / tot), 3)
    out["share_turn_45_pm3"] = round(float(ln[np.abs(ang - 45) <= 3].sum() / tot), 3)
    out["share_other"] = round(float(ln[(np.abs(ang - 90) > 3) & (np.abs(ang - 45) > 3)].sum() / tot), 3)
    h, edges = np.histogram(ang, bins=np.arange(0, 181, 15), weights=ln)
    out["histogram_15deg_share"] = {"%d-%d" % (edges[i], edges[i + 1]): round(float(h[i] / tot), 3) for i in range(len(h)) if h[i] > 0}
    out["regime"] = "hard_edge_right_angles" if out["share_turn_90_pm3"] + out["share_turn_45_pm3"] >= 0.8 else ("hard_edge_mixed" if out["share_other"] < 0.5 else "free_form_creases")
    return out


if __name__ == "__main__":
    a = dict(kv.split("=", 1) for kv in sys.argv[1:])
    for spec in a["names"].split(","):
        d, n = spec.split(":"); V, F = IO.read_obj_tri_or_quad("%s/%s/%s.obj" % (a["base"], d, n))
        r = dihedral_report(np.array(V), np.array(F)); r["mesh"] = n; print(json.dumps(r))
