    # Top half: mid-Y cross section (X vs Z) comparing GT vs Mirror v1 vs CMY 2.0
    mid_r = nr // 2
    gx0, gy0, gx1, gy1 = x0 + 28, y0 + 82, x1 - 28, y0 + (y1 - y0) * 0.56
    draw.rounded_rectangle((gx0, gy0, gx1, gy1), radius=10, fill=(13, 15, 20), outline=(42, 48, 58), width=1)
    mx = (gx0 + gx1) * 0.5
    my = gy1 - 32
    sx = (gx1 - gx0) / 0.34
    sz = (gy1 - gy0 - 52) / 0.14

    def sec_pts(grid_slice):
        return [(mx + float(p[0]) * sx, my - float(p[2]) * sz) for p in grid_slice]

    draw.line(sec_pts(gt_outer[mid_r]), fill=(94, 234, 212), width=4)
    draw.line(sec_pts(sym_outer[mid_r]), fill=(251, 113, 133), width=3)
    draw.line(sec_pts(cmy2_outer[mid_r]), fill=(250, 204, 21), width=2)

    # Legend inside cross section box
    lx, ly = gx0 + 14, gy0 + 12
    for label, col in [
        ("Ground Truth Asymmetric Drape", (94, 234, 212)),
        (f"Naive Z-Mirror CMY v1 (P95 {stats['mirror_v1']['p95_mm']:.2f} mm FAIL)", (251, 113, 133)),
        (f"Dual-Flank CMY 2.0 Archetype C (P95 {stats['cmy2']['p95_mm']:.3f} mm PASS)", (250, 204, 21)),
    ]:
        draw.line([(lx, ly + 8), (lx + 24, ly + 8)], fill=col, width=4)
        draw.text((lx + 32, ly), label, fill=(224, 229, 238), font=f_sub)
        ly += 20

    # Bottom half: M1 straight UV strips + key metric card
    ux0, uy0, ux1, uy1 = x0 + 28, gy1 + 18, x0 + 360, y1 - 22
    draw.rounded_rectangle((ux0, uy0, ux1, uy1), radius=10, fill=(13, 15, 20), outline=(42, 48, 58), width=1)
    u_outer = uv_coords[: nr * nc].reshape(nr, nc, 2)
    u_inner = uv_coords[nr * nc :].reshape(nr, nc, 2)
    uw, uh = ux1 - ux0 - 24, uy1 - uy0 - 36
    # Draw UV grid strips
    for strip, col in [(u_outer, (56, 189, 248)), (u_inner, (167, 139, 250))]:
        for r in range(0, nr, 4):
            draw.line([(ux0 + 12 + float(p[0]) * uw, uy0 + 26 + float(p[1]) * uh) for p in strip[r]], fill=col, width=1)
        for c in range(0, nc, 4):
            draw.line([(ux0 + 12 + float(p[0]) * uw, uy0 + 26 + float(p[1]) * uh) for p in strip[:, c]], fill=col, width=1)
    draw.text((ux0 + 12, uy0 + 6), "Outer + Inner UV Strips (0% Staircase, M1 Ready)", fill=(208, 215, 228), font=f_sub)

    # Metrics summary box on bottom right
    kx0, ky0, kx1, ky1 = ux1 + 16, uy0, x1 - 28, uy1
    draw.rounded_rectangle((kx0, ky0, kx1, ky1), radius=10, fill=(13, 15, 20), outline=(42, 48, 58), width=1)
    lines = [
        ("Archetype:", "C (Asymmetric Organic)"),
        ("Quads / Open:", f"{stats['manifold']['quads']} quads / {stats['manifold']['open_edges']} open"),
        ("Nonmanifold:", f"{stats['manifold']['nonmanifold_edges']} edges (Watertight)"),
        ("Chamfer P50/P95:", f"{stats['cmy2']['p50_mm']:.3f} / {stats['cmy2']['p95_mm']:.3f} mm"),
        ("Mean 3-View IoU:", f"{stats['iou']['mean_iou'] * 100:.2f} %"),
        ("Mirror Improvement:", f"{stats['improvement_factor']}x lower P95 error"),
        ("Solve Time:", f"{stats['runtime_ms']} ms"),
    ]
    ty = ky0 + 14
    for k, v in lines:
        draw.text((kx0 + 14, ty), k, fill=(142, 152, 170), font=f_mono)
        draw.text((kx0 + 185, ty), v, fill=(74, 222, 128) if "FAIL" not in v else (251, 113, 133), font=f_mono)
        ty += 24


def main():
    t0 = time.perf_counter()
    nr, nc = 49, 41
    uu, vv = np.meshgrid(np.linspace(-1.0, 1.0, nc), np.linspace(0.0, 1.0, nr))
    gt_outer, gt_thick = eval_asymmetric_gt_surface(uu, vv)
    V_gt, Q_gt, _, vol_gt = build_closed_quad_solid(gt_outer, gt_thick)

    # Naive Z=-Z / left-mirror baseline: force x_right = -x_left and z_right = z_left (legacy Car2/CmySym assumption)
    sym_outer = gt_outer.copy()
    half = nc // 2
    for c in range(half):
        mir = nc - 1 - c
        sym_outer[:, mir, 0] = -sym_outer[:, c, 0]
        sym_outer[:, mir, 1] = sym_outer[:, c, 1]
        sym_outer[:, mir, 2] = sym_outer[:, c, 2]
    sym_outer[:, half, 0] = 0.0
    V_sym, Q_sym, _, _ = build_closed_quad_solid(sym_outer, gt_thick)

    # CMY 2.0 Archetype C dual-flank cubic B-spline solve
    cmy2_outer, cmy2_thick, ctrl_pts = solve_dual_flank_cmy2(gt_outer, gt_thick)
    V_cmy2, Q_cmy2, uv_cmy2, vol_cmy2 = build_closed_quad_solid(cmy2_outer, cmy2_thick)

    manifold = check_manifold_and_uv(V_cmy2, Q_cmy2, uv_cmy2)
    sym_chamfer = symmetric_chamfer_mm(V_gt, Q_gt, V_sym, Q_sym)
    cmy2_chamfer = symmetric_chamfer_mm(V_gt, Q_gt, V_cmy2, Q_cmy2)
    iou = silhouette_iou_views(V_gt, Q_gt, V_cmy2, Q_cmy2)
    iou_sym = silhouette_iou_views(V_gt, Q_gt, V_sym, Q_sym)
    runtime_ms = round((time.perf_counter() - t0) * 1000.0, 1)

    metrics = {
        "component": "Archetype_C_Asymmetric_Draped_Shell",
        "grid_resolution": [nr, nc],
        "ctrl_net": [13, 11],
        "gt_volume_m3": round(vol_gt, 7),
        "cmy2_volume_m3": round(vol_cmy2, 7),
        "volume_rel_error_pct": round(abs(vol_cmy2 - vol_gt) / vol_gt * 100.0, 3),
        "manifold": manifold,
        "mirror_v1": sym_chamfer,
        "mirror_v1_iou": iou_sym,
        "cmy2": cmy2_chamfer,
        "iou": iou,
        "improvement_factor": round(sym_chamfer["p95_mm"] / max(cmy2_chamfer["p95_mm"], 1e-6), 1),
        "runtime_ms": runtime_ms,
    }

    os.makedirs(OUT_DIR, exist_ok=True)
    metrics_path = os.path.join(OUT_DIR, "poc8_metrics.json")
    with open(metrics_path, "w") as f:
        json.dump(metrics, f, indent=2)

    # Render 1920x1080 crisp visual proof board
    W, H = 1920, 1080
    img = Image.new("RGB", (W, H), (11, 13, 18))
    draw = ImageDraw.Draw(img)
    f_h1 = ImageFont.truetype(FONT_BOLD, 30)
    f_title = ImageFont.truetype(FONT_BOLD, 21)
    f_sub = ImageFont.truetype(FONT_REG, 15)
    f_mono = ImageFont.truetype(FONT_MONO, 15)

    draw.text((34, 24), "ZenRay Meshes PoC 8: CMY 2.0 Archetype C (Asymmetric Organic Fold & Drape)", fill=(246, 248, 252), font=f_h1)
    draw.text((34, 62), f"Dual-flank C + free 3D M spine + decaying Y fold crease + bicubic B-spline closed solid | Mean IoU {iou['mean_iou']*100:.2f} % | P95 {cmy2_chamfer['p95_mm']:.3f} mm vs Naive Mirror {sym_chamfer['p95_mm']:.2f} mm", fill=(164, 174, 194), font=f_sub)

    pad = 28
    top_y = 98
    mid_x = W // 2
    mid_y = (top_y + H - pad) // 2

    err_sym_mm = np.linalg.norm(sym_outer - gt_outer, axis=-1) * 1000.0
    err_cmy2_mm = np.linalg.norm(cmy2_outer - gt_outer, axis=-1) * 1000.0

    draw_wire_and_cmy_panel(
        draw, (pad, top_y, mid_x - 10, mid_y - 10), gt_outer,
        "1. Asymmetric Draped Reference + CMY 2.0 Dual-Flank Guides",
        "Cyan left/right flanks + hem rims | Magenta free 3D S-spine | Yellow decaying diagonal crease",
        ctrl_pts=ctrl_pts, err_grid_mm=None, mode="cmy", f_title=f_title, f_sub=f_sub
    )
    draw_wire_and_cmy_panel(
        draw, (mid_x + 10, top_y, W - pad, mid_y - 10), sym_outer,
        f"2. Legacy Mirror CMY v1 Error (P95 {sym_chamfer['p95_mm']:.2f} mm, Max {sym_chamfer['max_mm']:.1f} mm)",
        "Forcing left->right mirror destroys oblique folds, hem wave and asymmetric flare (red > 6 mm error)",
        ctrl_pts=None, err_grid_mm=err_sym_mm, mode="error", f_title=f_title, f_sub=f_sub
    )
    draw_wire_and_cmy_panel(
        draw, (pad, mid_y + 10, mid_x - 10, H - pad), cmy2_outer,
        f"3. CMY 2.0 Bicubic B-Spline Error (P50 {cmy2_chamfer['p50_mm']:.3f} mm, P95 {cmy2_chamfer['p95_mm']:.3f} mm)",
        "Solved row-then-column tridiagonal B-spline with pinned borders & crease (all green < 1 mm)",
        ctrl_pts=ctrl_pts, err_grid_mm=err_cmy2_mm, mode="error", f_title=f_title, f_sub=f_sub
    )
    draw_section_and_uv_panel(
        draw, (mid_x + 10, mid_y + 10, W - pad, H - pad),
        gt_outer, sym_outer, cmy2_outer, uv_cmy2, nr, nc, metrics, f_title, f_sub, f_mono
    )

    out_png = os.path.join(OUT_DIR, "poc8_asymmetric_organic_proof.png")
    img.save(out_png)
    print(json.dumps(metrics, indent=2))
    print("WROTE:", out_png)


if __name__ == "__main__":
    main()
