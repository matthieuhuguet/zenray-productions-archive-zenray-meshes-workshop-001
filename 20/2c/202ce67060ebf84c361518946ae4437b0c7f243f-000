def tridiagonal_bspline_solve(pts: np.ndarray, fixed_mask: np.ndarray) -> np.ndarray:
    """
    Solve open uniform cubic B-spline interpolation:
      (1/6)*C[i-1] + (4/6)*C[i] + (1/6)*C[i+1] = pts[i]
    for interior unfixed points, keeping pinned/creased/border indices exact (matches BuildRimLoft.py math).
    pts shape: (N, D)
    """
    n, d = pts.shape
    if n < 3:
        return pts.copy()
    ab = np.zeros((3, n), dtype=np.float64)
    rhs = np.zeros((n, d), dtype=np.float64)
    for i in range(n):
        if i == 0 or i == n - 1 or fixed_mask[i]:
            ab[1, i] = 1.0
            rhs[i] = pts[i]
        else:
            ab[0, i + 1] = 1.0 / 6.0  # superdiagonal at col i+1 for row i
            ab[1, i] = 4.0 / 6.0
            ab[2, i - 1] = 1.0 / 6.0  # subdiagonal at col i-1 for row i
            rhs[i] = pts[i]
    out = np.zeros_like(pts)
    for col_d in range(d):
        out[:, col_d] = solve_banded((1, 1), ab, rhs[:, col_d])
    return out


def eval_uniform_cubic_bspline_curve(ctrl: np.ndarray, n_samples: int) -> np.ndarray:
    """Evaluate open uniform cubic B-spline with clamped/double endpoints along parameter t in [0, 1]."""
    n = len(ctrl)
    if n < 4:
        t = np.linspace(0, 1, n_samples)
        idx = t * (n - 1)
        i0 = np.clip(np.floor(idx).astype(int), 0, n - 2)
        f = (idx - i0)[:, None]
        return ctrl[i0] * (1.0 - f) + ctrl[i0 + 1] * f

    # Triple pad endpoints so open B-spline interpolates endpoints cleanly
    P = np.vstack([ctrl[0], ctrl[0], ctrl, ctrl[-1], ctrl[-1]])
    ts = np.linspace(0.0, float(n + 1), n_samples, endpoint=False)
    segs = np.clip(np.floor(ts).astype(int), 0, n)
    u = ts - segs
    u2 = u * u
    u3 = u2 * u
    b0 = ((1.0 - u) ** 3) / 6.0
    b1 = (3.0 * u3 - 6.0 * u2 + 4.0) / 6.0
    b2 = (-3.0 * u3 + 3.0 * u2 + 3.0 * u + 1.0) / 6.0
    b3 = u3 / 6.0
    res = (
        b0[:, None] * P[segs]
        + b1[:, None] * P[segs + 1]
        + b2[:, None] * P[segs + 2]
        + b3[:, None] * P[segs + 3]
    )
    res[-1] = ctrl[-1]
    return res


def eval_asymmetric_gt_surface(u_grid: np.ndarray, v_grid: np.ndarray):
    """
    Ground Truth Archetype C surface in meters (shoulder cowl / draped hood panel ~ 0.34m tall x 0.28m wide):
      u in [-1, 1] across width (flank_left at -1, spine near +0.14*sin(...), flank_right at +1)
      v in [0, 1] bottom hem -> top crest
    Asymmetries:
      - Curved S-axis center offset u0(v) = 0.22 * sin(2.6 * v - 0.5)
      - Larger left drape flare than right (1.18 vs 0.84)
      - Diagonal crisp-to-smooth Y ridge running obliquely with decaying sharpness
      - Non-planar wavy bottom scallop + twist in Y/Z around spine
    Returns outer surface points P(nu, nv, 3) and variable hem-tapered thickness T(nu, nv).
    """
    s = (v_grid - 0.5) * 0.32  # vertical span Y in [-0.16, +0.16] m
    spine_u = 0.16 * np.sin(2.5 * v_grid - 0.4)
    rel_u = u_grid - spine_u

    # Asymmetric lateral flare (left flank extends farther and sweeps down)
    half_w = np.where(u_grid < 0.0, 0.145 * (1.0 + 0.16 * np.cos(3.0 * v_grid)), 0.115 * (1.0 - 0.12 * v_grid))
    x = u_grid * half_w + 0.028 * np.sin(3.4 * v_grid - 0.6)

    # Bottom hem wave & arched top crest (asymmetric height left vs right)
    hem_wave = 0.022 * np.sin(3.2 * u_grid + 0.8) - 0.014 * (u_grid > 0.2) * u_grid
    y = s + hem_wave * (1.0 - 0.65 * v_grid) + 0.018 * (1.0 - u_grid ** 2) * np.sin(np.pi * v_grid)

    # Z depth: convex wrap + oblique diagonal Y crease fold whose sharpness decays smoothly toward top
    # Crease line along rel_u = 0.18 * (v - 0.3)
    fold_dist = np.abs(rel_u - 0.12 * (v_grid - 0.35))
    crease_strength = 0.022 * (1.0 - 0.72 * v_grid ** 1.4)  # crisp near lower drape, smooth near top crown
    ridge = crease_strength * np.exp(-fold_dist / 0.18) * (1.0 - 0.35 * np.tanh(fold_dist * 6.0))
    # Main Z bowl + twist torsion
    wrap_z = 0.075 * (1.0 - 0.82 * u_grid ** 2) * (0.72 + 0.36 * np.sin(np.pi * v_grid))
    asym_lobe_z = 0.024 * np.sin(1.9 * u_grid + 1.1 * v_grid) * (1.0 - 0.4 * u_grid ** 2)
    z = wrap_z + asym_lobe_z + ridge

    # Tapered organic thickness: thickest along center drape (4.5 mm), feathering to 1.4 mm at hems
    edge_blend = np.sin(np.pi * np.clip((u_grid + 1.0) * 0.5, 0.0, 1.0)) * np.sin(np.pi * np.clip(0.08 + 0.84 * v_grid, 0.0, 1.0))
    thickness = 0.0014 + 0.0031 * edge_blend

    return np.stack([x, y, z], axis=-1), thickness


def build_closed_quad_solid(outer_grid: np.ndarray, thickness_grid: np.ndarray):
    """
    From surface point grid P[nr, nc, 3] (nr rows along v, nc cols along u), construct a watertight,
    positively oriented, 100% pure-quad closed solid with inward offset and rounded border hem loop.
    Returns (V, Q, uv_coords) where uv_coords are straight strip M1-ready planar UVs per vertex.
    """
    nr, nc, _ = outer_grid.shape
    # Compute smooth vertex normals
    du = np.zeros_like(outer_grid)
    dv = np.zeros_like(outer_grid)
    du[:, 1:-1] = outer_grid[:, 2:] - outer_grid[:, :-2]
    du[:, 0] = outer_grid[:, 1] - outer_grid[:, 0]
    du[:, -1] = outer_grid[:, -1] - outer_grid[:, -2]
    dv[1:-1, :] = outer_grid[2:, :] - outer_grid[:-2, :]
    dv[0, :] = outer_grid[1, :] - outer_grid[0, :]
    dv[-1, :] = outer_grid[-1, :] - outer_grid[-2, :]

    nrm = np.cross(du, dv)
    nlen = np.linalg.norm(nrm, axis=-1, keepdims=True)
    nrm = nrm / np.maximum(nlen, 1e-12)
    # Orient normals toward +Z on average
    if nrm[..., 2].mean() < 0:
        nrm = -nrm

    inner_grid = outer_grid - nrm * thickness_grid[..., None]

    # Flatten outer + inner vertices; stitch boundary loop directly between outer perimeter & inner perimeter
    # Outer: 0 .. nr*nc - 1
    # Inner: nr*nc .. 2*nr*nc - 1
    V = np.vstack([outer_grid.reshape(-1, 3), inner_grid.reshape(-1, 3)])

    # Straight M1-ready planar strip UVs (0% staircase boundaries)
    uu, vv = np.meshgrid(np.linspace(0.0, 1.0, nc), np.linspace(0.0, 1.0, nr))
    uv_outer = np.stack([uu * 0.48 + 0.01, vv * 0.94 + 0.03], axis=-1).reshape(-1, 2)
    uv_inner = np.stack([uu * 0.48 + 0.51, vv * 0.94 + 0.03], axis=-1).reshape(-1, 2)
    uv_coords = np.vstack([uv_outer, uv_inner])

    def o_idx(r, c):
        return r * nc + c

    def i_idx(r, c):
        return nr * nc + r * nc + c

    quads = []
    # Outer skin (+nrm outward)
    for r in range(nr - 1):
        for c in range(nc - 1):
            quads.append([o_idx(r, c), o_idx(r, c + 1), o_idx(r + 1, c + 1), o_idx(r + 1, c)])

    # Inner skin (reversed winding so normals point inward-away-from-solid)
    for r in range(nr - 1):
        for c in range(nc - 1):
            quads.append([i_idx(r, c), i_idx(r + 1, c), i_idx(r + 1, c + 1), i_idx(r, c + 1)])

    # Boundary hem quads around perimeter in CCW order (outer boundary edges oriented cleanly)
    # Bottom edge (r = 0, c = 0 -> nc-1)
    for c in range(nc - 1):
        quads.append([o_idx(0, c), i_idx(0, c), i_idx(0, c + 1), o_idx(0, c + 1)])
    # Right edge (c = nc-1, r = 0 -> nr-1)
    for r in range(nr - 1):
        quads.append([o_idx(r, nc - 1), i_idx(r, nc - 1), i_idx(r + 1, nc - 1), o_idx(r + 1, nc - 1)])
    # Top edge (r = nr-1, c = nc-1 -> 0)
    for c in range(nc - 1, 0, -1):
        quads.append([o_idx(nr - 1, c), i_idx(nr - 1, c), i_idx(nr - 1, c - 1), o_idx(nr - 1, c - 1)])
    # Left edge (c = 0, r = nr-1 -> 0)
    for r in range(nr - 1, 0, -1):
        quads.append([o_idx(r, 0), i_idx(r, 0), i_idx(r - 1, 0), o_idx(r - 1, 0)])

    Q = np.array(quads, dtype=np.int64)
    # Verify closed signed volume; flip if negative
    vol = mesh_signed_volume(V, Q)
    if vol < 0:
        Q = Q[:, ::-1]
        vol = -vol
    return V, Q, uv_coords, vol


def mesh_signed_volume(V: np.ndarray, Q: np.ndarray) -> float:
    tris = np.vstack([Q[:, [0, 1, 2]], Q[:, [0, 2, 3]]])
    v0 = V[tris[:, 0]]
    v1 = V[tris[:, 1]]
    v2 = V[tris[:, 2]]
    return float(np.sum(np.einsum("ij,ij->i", v0, np.cross(v1, v2))) / 6.0)


def check_manifold_and_uv(V: np.ndarray, Q: np.ndarray, UV: np.ndarray):
    from collections import defaultdict
    directed = defaultdict(int)
    undirected = defaultdict(int)
    for q in Q:
        for k in range(4):
            a, b = int(q[k]), int(q[(k + 1) % 4])
            directed[(a, b)] += 1
            undirected[(min(a, b), max(a, b))] += 1
    open_edges = sum(1 for c in undirected.values() if c == 1)
    nonmanifold_edges = sum(1 for c in undirected.values() if c > 2)
    flipped_pairs = sum(1 for (a, b), c in directed.items() if directed.get((b, a), 0) != c)
    # UV straightness on seam strips (check axis alignment of boundary segments)
    u_rng = float(UV[:, 0].max() - UV[:, 0].min())
    v_rng = float(UV[:, 1].max() - UV[:, 1].min())
    return {
        "vertices": int(len(V)),
        "quads": int(len(Q)),
        "pure_quad_share": 1.0,
        "open_edges": int(open_edges),
        "nonmanifold_edges": int(nonmanifold_edges),
        "orientation_mismatches": int(flipped_pairs),
        "watertight": bool(open_edges == 0 and nonmanifold_edges == 0 and flipped_pairs == 0),
        "uv_bbox_u": round(u_rng, 4),
        "uv_bbox_v": round(v_rng, 4),
    }


def sample_quad_surface(V: np.ndarray, Q: np.ndarray, n_pts: int = 18000, seed: int = 7) -> np.ndarray:
    rng = np.random.default_rng(seed)
    tris = np.vstack([Q[:, [0, 1, 2]], Q[:, [0, 2, 3]]])
    a, b, c = V[tris[:, 0]], V[tris[:, 1]], V[tris[:, 2]]
    areas = 0.5 * np.linalg.norm(np.cross(b - a, c - a), axis=1)
    probs = areas / np.maximum(areas.sum(), 1e-12)
    idx = rng.choice(len(tris), size=n_pts, p=probs)
    r1 = np.sqrt(rng.random((n_pts, 1)))
    r2 = rng.random((n_pts, 1))
    return (1.0 - r1) * a[idx] + r1 * (1.0 - r2) * b[idx] + r1 * r2 * c[idx]


def symmetric_chamfer_mm(V1, Q1, V2, Q2):
    P1 = sample_quad_surface(V1, Q1, 16000, 11)
    P2 = sample_quad_surface(V2, Q2, 16000, 17)
    d1, _ = cKDTree(P2).query(P1)
    d2, _ = cKDTree(P1).query(P2)
    both = np.concatenate([d1, d2]) * 1000.0
    return {
        "p50_mm": round(float(np.percentile(both, 50)), 4),
        "p95_mm": round(float(np.percentile(both, 95)), 4),
        "max_mm": round(float(np.max(both)), 4),
        "mean_mm": round(float(np.mean(both)), 4),
    }


def silhouette_iou_views(V1, Q1, V2, Q2, size: int = 240):
    P1 = sample_quad_surface(V1, Q1, 24000, 23)
    P2 = sample_quad_surface(V2, Q2, 24000, 29)
    all_pts = np.vstack([P1, P2])
    bmin = all_pts.min(0) - 0.015
    bmax = all_pts.max(0) + 0.015
    span = float((bmax - bmin).max())

    def proj_mask(pts, ax0, ax1):
        img = np.zeros((size, size), dtype=bool)
        gx = np.clip(((pts[:, ax0] - bmin[ax0]) / span * (size - 1)).astype(int), 0, size - 1)
        gy = np.clip(((pts[:, ax1] - bmin[ax1]) / span * (size - 1)).astype(int), 0, size - 1)
        img[gy, gx] = True
        # Dilate 1 px to bridge point rasterization cleanly
        from scipy import ndimage as ndi
        return ndi.binary_dilation(img, iterations=2)

    ious = {}
    for name, (a0, a1) in [("front_xy", (0, 1)), ("left_zy", (2, 1)), ("top_xz", (0, 2))]:
        m1 = proj_mask(P1, a0, a1)
        m2 = proj_mask(P2, a0, a1)
        inter = int(np.logical_and(m1, m2).sum())
        union = int(np.logical_or(m1, m2).sum())
        ious[name] = round(inter / max(union, 1), 4)
    ious["mean_iou"] = round(float(np.mean(list(ious.values()))), 4)
    return ious


def solve_dual_flank_cmy2(target_outer: np.ndarray, target_thick: np.ndarray):
    """
    CMY 2.0 Archetype C Reconstruction:
    Simulate reading sparse CMY annotations from orthographic views:
      - Control net NR=13 rows x NC=11 columns sampled along left flank, asymmetric ridge Y, and right flank
      - Per-vertex ridge pin along central crease column (c=5) so Y fold is explicitly honored
      - Row-then-column tridiagonal cubic B-spline interpolation -> dense evaluation grid -> dual-skin pure-quad solid
    """
    nr_full, nc_full, _ = target_outer.shape
    row_ix = np.linspace(0, nr_full - 1, 13, dtype=int)
    col_ix = np.linspace(0, nc_full - 1, 11, dtype=int)
    ctrl_targets = target_outer[np.ix_(row_ix, col_ix)]  # (13, 11, 3)
    ctrl_thick = target_thick[np.ix_(row_ix, col_ix)]

    # Step 1: solve cubic B-spline control points across each row (pin borders and center Y fold column 5)
    nr_c, nc_c, _ = ctrl_targets.shape
    fix_col = np.zeros(nc_c, dtype=bool)
    fix_col[0] = fix_col[-1] = True
    fix_col[nc_c // 2] = True  # pin diagonal Y crease column
    c_mid = np.zeros_like(ctrl_targets)
    for r in range(nr_c):
        c_mid[r] = tridiagonal_bspline_solve(ctrl_targets[r], fix_col)

    # Step 2: solve cubic B-spline control points along each column (pin top/bottom hem borders)
    fix_row = np.zeros(nr_c, dtype=bool)
    fix_row[0] = fix_row[-1] = True
    c_final = np.zeros_like(c_mid)
    for c in range(nc_c):
        c_final[:, c] = tridiagonal_bspline_solve(c_mid[:, c], fix_row)

    # Evaluate upsampled grid at GT resolution via uniform cubic B-spline + smooth thickness
    up_cols = np.zeros((nr_full, nc_c, 3))
    for c in range(nc_c):
        up_cols[:, c] = eval_uniform_cubic_bspline_curve(c_final[:, c], nr_full)
    recon_outer = np.zeros((nr_full, nc_full, 3))
    for r in range(nr_full):
        recon_outer[r] = eval_uniform_cubic_bspline_curve(up_cols[r], nc_full)

    # Tapered thickness bilinearly upsampled smoothly
    from scipy.ndimage import zoom
    recon_thick = zoom(ctrl_thick, (nr_full / nr_c, nc_full / nc_c), order=1)
    return recon_outer, recon_thick, ctrl_targets


def project_3d(pts: np.ndarray, yaw_deg: float, pitch_deg: float):
    yaw = np.radians(yaw_deg)
    pitch = np.radians(pitch_deg)
    Ry = np.array([[np.cos(yaw), 0, np.sin(yaw)], [0, 1, 0], [-np.sin(yaw), 0, np.cos(yaw)]])
    Rx = np.array([[1, 0, 0], [0, np.cos(pitch), -np.sin(pitch)], [0, np.sin(pitch), np.cos(pitch)]])
    P = pts @ Ry.T @ Rx.T
    return P


def draw_wire_and_cmy_panel(draw: ImageDraw.ImageDraw, box, P_grid: np.ndarray, title: str, subtitle: str,
                            ctrl_pts: np.ndarray = None, err_grid_mm: np.ndarray = None,
                            mode: str = "cmy", yaw: float = 28.0, pitch: float = 16.0,
                            f_title=None, f_sub=None):
    x0, y0, x1, y1 = box
    draw.rounded_rectangle(box, radius=14, fill=(19, 22, 28), outline=(48, 55, 68), width=2)
    draw.text((x0 + 18, y0 + 14), title, fill=(242, 244, 248), font=f_title)
    draw.text((x0 + 18, y0 + 40), subtitle, fill=(154, 164, 182), font=f_sub)

    px0, py0, px1, py1 = x0 + 22, y0 + 68, x1 - 22, y1 - 22
    cx, cy = (px0 + px1) * 0.5, (py0 + py1) * 0.52
    scale = min(px1 - px0, py1 - py0) * 2.15

    R = project_3d(P_grid.reshape(-1, 3), yaw, pitch).reshape(P_grid.shape)
    nr, nc, _ = R.shape

    def to_px(pt):
        return (cx + float(pt[0]) * scale, cy - float(pt[1]) * scale)

    # Sort quad faces painter-style back to front
    faces = []
    for r in range(nr - 1):
        for c in range(nc - 1):
            pts2 = [to_px(R[r, c]), to_px(R[r, c + 1]), to_px(R[r + 1, c + 1]), to_px(R[r + 1, c])]
            z_avg = float((R[r, c, 2] + R[r, c + 1, 2] + R[r + 1, c + 1, 2] + R[r + 1, c, 2]) * 0.25)
            # Lighting from key + side normal
            v1 = R[r, c + 1] - R[r, c]
            v2 = R[r + 1, c] - R[r, c]
            n = np.cross(v1, v2)
            n = n / max(float(np.linalg.norm(n)), 1e-9)
            if n[2] < 0:
                n = -n
            ndotl = max(0.25, min(1.0, float(0.45 + 0.55 * abs(n[2] * 0.8 + n[0] * 0.4 + n[1] * 0.3))))
            err_val = float(err_grid_mm[r, c]) if err_grid_mm is not None else 0.0
            faces.append((z_avg, pts2, ndotl, err_val, r, c))
    faces.sort(key=lambda t: t[0])

    for _, pts2, ndotl, err_val, r, c in faces:
        if mode == "error":
            t = min(1.0, err_val / 6.0)
            col = (
                int((42 + 205 * t) * ndotl),
                int((202 - 140 * t) * ndotl),
                int((155 - 110 * t) * ndotl),
            )
            outline = (28, 34, 42)
        else:
            base = int(85 + 115 * ndotl)
            col = (base - 12, base - 4, base + 12)
            outline = (45, 52, 64) if (r % 3 == 0 or c % 3 == 0) else col
        draw.polygon(pts2, fill=col, outline=outline)

    # Overlay CMY curves cleanly
    if mode in ("cmy", "dual_wire"):
        # Cyan border rims & flank bounds
        for pts_line in [R[0, :], R[-1, :], R[:, 0], R[:, -1]]:
            poly = [to_px(p) for p in pts_line]
            draw.line(poly, fill=(0, 224, 245), width=3)
        # Magenta free asymmetric dorsal spine (offset slightly off center row-by-row)
        spine_cols = [R[r, int(np.clip(round(nc * 0.5 + nc * 0.08 * np.sin(2.5 * (r / nr) - 0.4)), 0, nc - 1))] for r in range(nr)]
        draw.line([to_px(p) for p in spine_cols], fill=(248, 64, 210), width=4)
        # Yellow Y diagonal crease line with decaying dot weights
        ymid = [R[r, nc // 2] for r in range(nr)]
        draw.line([to_px(p) for p in ymid], fill=(250, 214, 46), width=4)

    if ctrl_pts is not None:
        Rc = project_3d(ctrl_pts.reshape(-1, 3), yaw, pitch).reshape(ctrl_pts.shape)
        for c in (0, Rc.shape[1] // 2, Rc.shape[1] - 1):
            for r in range(Rc.shape[0]):
                px, py = to_px(Rc[r, c])
                draw.ellipse((px - 3, py - 3, px + 3, py + 3), fill=(255, 255, 255), outline=(20, 20, 24))


def draw_section_and_uv_panel(draw: ImageDraw.ImageDraw, box, gt_outer, sym_outer, cmy2_outer, uv_coords,
                              nr, nc, stats, f_title, f_sub, f_mono):
