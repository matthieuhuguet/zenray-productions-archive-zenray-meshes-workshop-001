def solve_open_bspline_span(pts: np.ndarray) -> np.ndarray:
    """
    Solve open uniform cubic B-spline control points C[0..n-1] such that with phantom endpoints
    C[-1] = 2*C[0] - C[1] and C[n] = 2*C[n-1] - C[n-2], the evaluated B-spline passes
    EXACTLY through every target pts[i] at integer parameter t = i.
    """
    n, d = pts.shape
    if n < 3:
        return pts.copy()
    ab = np.zeros((3, n), dtype=np.float64)
    rhs = pts.copy()
    ab[1, 0] = 1.0
    ab[1, n - 1] = 1.0
    for i in range(1, n - 1):
        ab[0, i + 1] = 1.0 / 6.0
        ab[1, i] = 4.0 / 6.0
        ab[2, i - 1] = 1.0 / 6.0
    C = np.zeros_like(pts)
    for col_d in range(d):
        C[:, col_d] = solve_banded((1, 1), ab, rhs[:, col_d])
    return C


def eval_open_bspline_span(C: np.ndarray, n_samples: int) -> np.ndarray:
    """
    Evaluate uniform cubic B-spline on parameter t in [0, n-1] using phantom endpoints
    C[-1] = 2*C[0] - C[1], C[n] = 2*C[n-1] - C[n-2] so every segment i in [0..n-2]
    interpolates C[i]..C[i+1] smoothly and hits pts[k] at t=k.
    """
    n = len(C)
    if n == 1:
        return np.repeat(C, n_samples, axis=0)
    if n == 2:
        t = np.linspace(0.0, 1.0, n_samples)[:, None]
        return C[0] * (1.0 - t) + C[1] * t
    c_prev = 2.0 * C[0] - C[1]
    c_next = 2.0 * C[-1] - C[-2]
    P = np.vstack([c_prev, C, c_next])  # length n + 2; P[k+1] == C[k]
    ts = np.linspace(0.0, float(n - 1), n_samples)
    segs = np.clip(np.floor(ts).astype(int), 0, n - 2)
    u = ts - segs
    u2 = u * u
    u3 = u2 * u
    b0 = ((1.0 - u) ** 3) / 6.0
    b1 = (3.0 * u3 - 6.0 * u2 + 4.0) / 6.0
    b2 = (-3.0 * u3 + 3.0 * u2 + 3.0 * u + 1.0) / 6.0
    b3 = u3 / 6.0
    out = (
        b0[:, None] * P[segs]
        + b1[:, None] * P[segs + 1]
        + b2[:, None] * P[segs + 2]
        + b3[:, None] * P[segs + 3]
    )
    return out


def eval_asymmetric_gt_surface(u_grid: np.ndarray, v_grid: np.ndarray):
    """
    Ground Truth Archetype C surface in meters (draped cowl / folded shoulder mantle ~0.34m tall x 0.28m wide):
      - Curved S-axis dorsal spine in 3D (offset left/right along Y)
      - Asymmetric left drape flare (wider, lower hem wave) vs tighter right flank
      - Diagonal Y ridge fold along center column whose crispness decays smoothly toward top crown
      - Tapered organic thickness: 4.5 mm central body feathering smoothly to 1.4 mm hems
    """
    s = (v_grid - 0.5) * 0.32
    spine_u = 0.16 * np.sin(2.5 * v_grid - 0.4)
    rel_u = u_grid - spine_u

    half_w = np.where(
        u_grid < 0.0,
        0.145 * (1.0 + 0.16 * np.cos(3.0 * v_grid)),
        0.115 * (1.0 - 0.12 * v_grid),
    )
    x = u_grid * half_w + 0.028 * np.sin(3.4 * v_grid - 0.6)

    hem_wave = 0.022 * np.sin(3.2 * u_grid + 0.8) - 0.014 * (u_grid > 0.2) * u_grid
    y = s + hem_wave * (1.0 - 0.65 * v_grid) + 0.018 * (1.0 - u_grid ** 2) * np.sin(np.pi * v_grid)

    # Fold crease exactly along u = 0 (aligned with center column of grid -> exact CMY yellow crease line)
    fold_dist = np.abs(u_grid)
    crease_weight = np.clip(1.0 - 0.72 * v_grid ** 1.4, 0.22, 1.0)
    crease_strength = 0.022 * crease_weight
    ridge = crease_strength * np.exp(-fold_dist / 0.20) * (1.0 - 0.32 * np.tanh(fold_dist * 5.0))

    wrap_z = 0.075 * (1.0 - 0.82 * u_grid ** 2) * (0.72 + 0.36 * np.sin(np.pi * v_grid))
    asym_lobe_z = 0.024 * np.sin(1.9 * u_grid + 1.1 * v_grid) * (1.0 - 0.4 * u_grid ** 2)
    z = wrap_z + asym_lobe_z + ridge

    edge_blend = np.sin(np.pi * np.clip((u_grid + 1.0) * 0.5, 0.0, 1.0)) * np.sin(np.pi * np.clip(0.08 + 0.84 * v_grid, 0.0, 1.0))
    thickness = 0.0014 + 0.0031 * edge_blend
    return np.stack([x, y, z], axis=-1), thickness, crease_weight


def solve_dual_flank_cmy2(target_outer: np.ndarray, target_thick: np.ndarray, crease_weights: np.ndarray):
    """
    CMY 2.0 Archetype C Reconstruction:
      - Sample uniform CMY grid readings: NR=13 rows x NC=11 columns dividing (48, 40) evenly
      - Each row: blend between smooth global cubic B-spline and piecewise split cubic B-spline across center Y ridge
        controlled by local crease_weight in [0, 1] (directly matching BuildRimLoft/RunCmy variable crease weights!)
      - Each column: solve smooth open cubic B-spline across rows -> dense NR x NC closed solid
    """
    nr_full, nc_full, _ = target_outer.shape
    nr_c, nc_c = 13, 11
    row_ix = np.linspace(0, nr_full - 1, nr_c, dtype=int)
    col_ix = np.linspace(0, nc_full - 1, nc_c, dtype=int)
    ctrl_targets = target_outer[np.ix_(row_ix, col_ix)]
    ctrl_thick = target_thick[np.ix_(row_ix, col_ix)]
    mid_c = nc_c // 2
    mid_full = nc_full // 2

    # Evaluate across columns first on sparse rows (weighted crisp/smooth along Y crease)
    row_dense = np.zeros((nr_c, nc_full, 3))
    for r in range(nr_c):
        pts_r = ctrl_targets[r]
        kw = float(crease_weights[row_ix[r], mid_full])
        # Smooth continuous curve
        c_smooth = solve_open_bspline_span(pts_r)
        ev_smooth = eval_open_bspline_span(c_smooth, nc_full)
        # Split across crease mid_c for sharp C0 fold ridge
        c_left = solve_open_bspline_span(pts_r[: mid_c + 1])
        c_right = solve_open_bspline_span(pts_r[mid_c:])
        ev_left = eval_open_bspline_span(c_left, mid_full + 1)
        ev_right = eval_open_bspline_span(c_right, nc_full - mid_full)
        ev_crisp = np.vstack([ev_left[:-1], ev_right])
        row_dense[r] = kw * ev_crisp + (1.0 - kw) * ev_smooth

    # Solve vertically along every column of dense grid using open cubic B-spline through row_dense
    recon_outer = np.zeros((nr_full, nc_full, 3))
    for c in range(nc_full):
        col_c = solve_open_bspline_span(row_dense[:, c])
        recon_outer[:, c] = eval_open_bspline_span(col_c, nr_full)

    recon_thick = zoom(ctrl_thick, (nr_full / nr_c, nc_full / nc_c), order=1)
    return recon_outer, recon_thick, ctrl_targets


def mesh_signed_volume(V: np.ndarray, Q: np.ndarray) -> float:
    tris = np.vstack([Q[:, [0, 1, 2]], Q[:, [0, 2, 3]]])
    v0, v1, v2 = V[tris[:, 0]], V[tris[:, 1]], V[tris[:, 2]]
    return float(np.sum(np.einsum("ij,ij->i", v0, np.cross(v1, v2))) / 6.0)


def build_closed_quad_solid(outer_grid: np.ndarray, thickness_grid: np.ndarray):
    nr, nc, _ = outer_grid.shape
    du = np.zeros_like(outer_grid)
    dv = np.zeros_like(outer_grid)
    du[:, 1:-1] = outer_grid[:, 2:] - outer_grid[:, :-2]
    du[:, 0] = outer_grid[:, 1] - outer_grid[:, 0]
    du[:, -1] = outer_grid[:, -1] - outer_grid[:, -2]
    dv[1:-1, :] = outer_grid[2:, :] - outer_grid[:-2, :]
    dv[0, :] = outer_grid[1, :] - outer_grid[0, :]
    dv[-1, :] = outer_grid[-1, :] - outer_grid[-2, :]

    nrm = np.cross(du, dv)
    nrm = nrm / np.maximum(np.linalg.norm(nrm, axis=-1, keepdims=True), 1e-12)
    if nrm[..., 2].mean() < 0:
        nrm = -nrm

    inner_grid = outer_grid - nrm * thickness_grid[..., None]
    V = np.vstack([outer_grid.reshape(-1, 3), inner_grid.reshape(-1, 3)])

    uu, vv = np.meshgrid(np.linspace(0.0, 1.0, nc), np.linspace(0.0, 1.0, nr))
    uv_outer = np.stack([uu * 0.46 + 0.02, vv * 0.92 + 0.04], axis=-1).reshape(-1, 2)
    uv_inner = np.stack([uu * 0.46 + 0.52, vv * 0.92 + 0.04], axis=-1).reshape(-1, 2)
    uv_coords = np.vstack([uv_outer, uv_inner])

    def o_idx(r, c):
        return r * nc + c

    def i_idx(r, c):
        return nr * nc + r * nc + c

    quads = []
    for r in range(nr - 1):
        for c in range(nc - 1):
            quads.append([o_idx(r, c), o_idx(r, c + 1), o_idx(r + 1, c + 1), o_idx(r + 1, c)])
            quads.append([i_idx(r, c), i_idx(r + 1, c), i_idx(r + 1, c + 1), i_idx(r, c + 1)])
    for c in range(nc - 1):
        quads.append([o_idx(0, c), i_idx(0, c), i_idx(0, c + 1), o_idx(0, c + 1)])
        quads.append([o_idx(nr - 1, nc - 1 - c), i_idx(nr - 1, nc - 1 - c), i_idx(nr - 1, nc - 2 - c), o_idx(nr - 1, nc - 2 - c)])
    for r in range(nr - 1):
        quads.append([o_idx(r, nc - 1), i_idx(r, nc - 1), i_idx(r + 1, nc - 1), o_idx(r + 1, nc - 1)])
        quads.append([o_idx(nr - 1 - r, 0), i_idx(nr - 1 - r, 0), i_idx(nr - 2 - r, 0), o_idx(nr - 2 - r, 0)])

    Q = np.array(quads, dtype=np.int64)
    vol = mesh_signed_volume(V, Q)
    if vol < 0:
        Q = Q[:, ::-1]
        vol = -vol
    return V, Q, uv_coords, vol


def check_manifold_and_uv(V: np.ndarray, Q: np.ndarray, UV: np.ndarray):
    from collections import defaultdict
    directed = defaultdict(int)
    undirected = defaultdict(int)
    for q in Q:
        for k in range(4):
            a, b = int(q[k]), int(q[(k + 1) % 4])
            directed[(a, b)] += 1
            undirected[(min(a, b), max(a, b))] += 1
    open_edges = sum(1 for c in undirected.values() if c == 1)
    nonmanifold_edges = sum(1 for c in undirected.values() if c > 2)
    flipped_pairs = sum(1 for (a, b), c in directed.items() if directed.get((b, a), 0) != c)
    return {
        "vertices": int(len(V)),
        "quads": int(len(Q)),
        "pure_quad_share": 1.0,
        "open_edges": int(open_edges),
        "nonmanifold_edges": int(nonmanifold_edges),
        "orientation_mismatches": int(flipped_pairs),
        "watertight": bool(open_edges == 0 and nonmanifold_edges == 0 and flipped_pairs == 0),
        "uv_bbox_u": round(float(UV[:, 0].max() - UV[:, 0].min()), 4),
        "uv_bbox_v": round(float(UV[:, 1].max() - UV[:, 1].min()), 4),
    }


def sample_quad_surface(V: np.ndarray, Q: np.ndarray, n_pts: int = 18000, seed: int = 7) -> np.ndarray:
    rng = np.random.default_rng(seed)
    tris = np.vstack([Q[:, [0, 1, 2]], Q[:, [0, 2, 3]]])
    a, b, c = V[tris[:, 0]], V[tris[:, 1]], V[tris[:, 2]]
    areas = 0.5 * np.linalg.norm(np.cross(b - a, c - a), axis=1)
    probs = areas / np.maximum(areas.sum(), 1e-12)
    idx = rng.choice(len(tris), size=n_pts, p=probs)
    r1 = np.sqrt(rng.random((n_pts, 1)))
    r2 = rng.random((n_pts, 1))
    return (1.0 - r1) * a[idx] + r1 * (1.0 - r2) * b[idx] + r1 * r2 * c[idx]


def symmetric_chamfer_mm(V1, Q1, V2, Q2):
    import trimesh
    T1 = np.vstack([Q1[:, [0, 1, 2]], Q1[:, [0, 2, 3]]])
    T2 = np.vstack([Q2[:, [0, 1, 2]], Q2[:, [0, 2, 3]]])
    m1 = trimesh.Trimesh(V1, T1, process=False)
    m2 = trimesh.Trimesh(V2, T2, process=False)
    P1 = sample_quad_surface(V1, Q1, 12000, 11)
    P2 = sample_quad_surface(V2, Q2, 12000, 17)
    _, d1, _ = trimesh.proximity.closest_point(m2, P1)
    _, d2, _ = trimesh.proximity.closest_point(m1, P2)
    both = np.concatenate([d1, d2]) * 1000.0
    return {
        "p50_mm": round(float(np.percentile(both, 50)), 4),
        "p95_mm": round(float(np.percentile(both, 95)), 4),
        "max_mm": round(float(np.max(both)), 4),
        "mean_mm": round(float(np.mean(both)), 4),
    }


def silhouette_iou_views(V1, Q1, V2, Q2, size: int = 240):
    P1 = sample_quad_surface(V1, Q1, 24000, 23)
    P2 = sample_quad_surface(V2, Q2, 24000, 29)
    all_pts = np.vstack([P1, P2])
    bmin = all_pts.min(0) - 0.015
    bmax = all_pts.max(0) + 0.015
    span = float((bmax - bmin).max())

    def proj_mask(pts, ax0, ax1):
        img = np.zeros((size, size), dtype=bool)
        gx = np.clip(((pts[:, ax0] - bmin[ax0]) / span * (size - 1)).astype(int), 0, size - 1)
        gy = np.clip(((pts[:, ax1] - bmin[ax1]) / span * (size - 1)).astype(int), 0, size - 1)
        img[gy, gx] = True
        return binary_dilation(img, iterations=2)

    ious = {}
    for name, (a0, a1) in [("front_xy", (0, 1)), ("left_zy", (2, 1)), ("top_xz", (0, 2))]:
        m1 = proj_mask(P1, a0, a1)
        m2 = proj_mask(P2, a0, a1)
        ious[name] = round(int(np.logical_and(m1, m2).sum()) / max(int(np.logical_or(m1, m2).sum()), 1), 4)
    ious["mean_iou"] = round(float(np.mean(list(ious.values()))), 4)
    return ious


def project_3d(pts: np.ndarray, yaw_deg: float, pitch_deg: float):
    yaw, pitch = np.radians(yaw_deg), np.radians(pitch_deg)
    Ry = np.array([[np.cos(yaw), 0, np.sin(yaw)], [0, 1, 0], [-np.sin(yaw), 0, np.cos(yaw)]])
    Rx = np.array([[1, 0, 0], [0, np.cos(pitch), -np.sin(pitch)], [0, np.sin(pitch), np.cos(pitch)]])
    return pts @ Ry.T @ Rx.T


def draw_wire_and_cmy_panel(draw: ImageDraw.ImageDraw, box, P_grid: np.ndarray, title: str, subtitle: str,
                            ctrl_pts: np.ndarray = None, err_grid_mm: np.ndarray = None,
                            mode: str = "cmy", yaw: float = 28.0, pitch: float = 16.0,
                            f_title=None, f_sub=None):
    x0, y0, x1, y1 = box
    draw.rounded_rectangle(box, radius=14, fill=(19, 22, 28), outline=(48, 55, 68), width=2)
    draw.text((x0 + 18, y0 + 14), title, fill=(242, 244, 248), font=f_title)
    draw.text((x0 + 18, y0 + 40), subtitle, fill=(154, 164, 182), font=f_sub)

    px0, py0, px1, py1 = x0 + 22, y0 + 70, x1 - 22, y1 - 18
    cx, cy = (px0 + px1) * 0.49, (py0 + py1) * 0.50
    scale = min(px1 - px0, py1 - py0) * 2.15

    R = project_3d(P_grid.reshape(-1, 3), yaw, pitch).reshape(P_grid.shape)
    nr, nc, _ = R.shape

    def to_px(pt):
        return (cx + float(pt[0]) * scale, cy - float(pt[1]) * scale)

    faces = []
    for r in range(nr - 1):
        for c in range(nc - 1):
            pts2 = [to_px(R[r, c]), to_px(R[r, c + 1]), to_px(R[r + 1, c + 1]), to_px(R[r + 1, c])]
            z_avg = float((R[r, c, 2] + R[r, c + 1, 2] + R[r + 1, c + 1, 2] + R[r + 1, c, 2]) * 0.25)
            v1 = R[r, c + 1] - R[r, c]
            v2 = R[r + 1, c] - R[r, c]
            n = np.cross(v1, v2)
            n = n / max(float(np.linalg.norm(n)), 1e-9)
            if n[2] < 0:
                n = -n
            ndotl = max(0.30, min(1.0, float(0.46 + 0.54 * abs(n[2] * 0.78 + n[0] * 0.42 + n[1] * 0.28))))
            err_val = float(err_grid_mm[r, c]) if err_grid_mm is not None else 0.0
            faces.append((z_avg, pts2, ndotl, err_val))
    faces.sort(key=lambda t: t[0])

    for _, pts2, ndotl, err_val in faces:
        if mode == "error":
            # Color ramp: <= 0.3 mm emerald green, 1.5 mm amber, >= 4.0 mm coral red
            t = min(1.0, err_val / 4.0)
            if t < 0.35:
                k = t / 0.35
                rgb = (38 + 165 * k, 212 - 20 * k, 130 - 70 * k)
            else:
                k = (t - 0.35) / 0.65
                rgb = (203 + 42 * k, 192 - 128 * k, 60 - 15 * k)
            col = tuple(int(c * ndotl) for c in rgb)
        else:
            base = int(95 + 110 * ndotl)
            col = (base - 14, base - 4, base + 14)
        draw.polygon(pts2, fill=col, outline=col)

    # Crisp viewport quad isoparms (drawn after fill for zero Z-fighting artifacts)
    line_col = (54, 64, 78) if mode == "cmy" else (24, 34, 42)
    for r in range(0, nr, 4):
        draw.line([to_px(R[r, c]) for c in range(nc)], fill=line_col, width=1)
    for c in range(0, nc, 4):
        draw.line([to_px(R[r, c]) for r in range(nr)], fill=line_col, width=1)

    if mode == "cmy":
        for pts_line in [R[0, :], R[-1, :], R[:, 0], R[:, -1]]:
            draw.line([to_px(p) for p in pts_line], fill=(0, 224, 245), width=3)
        spine_cols = [R[r, int(np.clip(round(nc * 0.5 + nc * 0.08 * np.sin(2.5 * (r / nr) - 0.4)), 0, nc - 1))] for r in range(nr)]
        draw.line([to_px(p) for p in spine_cols], fill=(248, 64, 210), width=4)
        draw.line([to_px(p) for p in R[:, nc // 2]], fill=(250, 214, 46), width=4)

    if ctrl_pts is not None:
        Rc = project_3d(ctrl_pts.reshape(-1, 3), yaw, pitch).reshape(ctrl_pts.shape)
        for c in (0, Rc.shape[1] // 2, Rc.shape[1] - 1):
            for r in range(0, Rc.shape[0], 2):
                px, py = to_px(Rc[r, c])
                draw.ellipse((px - 3, py - 3, px + 3, py + 3), fill=(255, 255, 255), outline=(18, 20, 24))


