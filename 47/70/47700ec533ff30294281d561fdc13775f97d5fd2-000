def extract_fg_mask(im_rgb):
    """Estimate background from border ring median and segment main object mask."""
    arr = np.asarray(im_rgb, dtype=np.float32)
    h, w, _ = arr.shape
    border = np.concatenate([arr[0:6, :].reshape(-1, 3), arr[-6:, :].reshape(-1, 3), arr[:, 0:6].reshape(-1, 3), arr[:, -6:].reshape(-1, 3)], axis=0)
    bg_col = np.median(border, axis=0)
    bg_std = float(np.mean(np.std(border, axis=0)))
    dist = np.linalg.norm(arr - bg_col, axis=2)
    raw = dist > max(8.0, 4.0 * bg_std)
    raw = ndi.binary_closing(raw, iterations=2)
    raw = ndi.binary_fill_holes(raw)
    lab, n = ndi.label(raw)
    if n == 0:
        return np.zeros((h, w), dtype=bool), bg_col, bg_std, (0, 0, 0, 0), 0
    sizes = np.bincount(lab.ravel())
    sizes[0] = 0
    best = int(np.argmax(sizes))
    significant_islands = int((sizes[1:] > 0.01 * sizes[best]).sum())
    mask = (lab == best)
    ys, xs = np.nonzero(mask)
    bbox = (int(xs.min()), int(ys.min()), int(xs.max()) + 1, int(ys.max()) + 1)
    return mask, bg_col, bg_std, bbox, significant_islands


def normalize_bbox_mask(mask, bbox, side=128):
    """Resize cropped silhouette bbox preserving aspect inside a side x side normalized canvas for mirror comparison."""
    x0, y0, x1, y1 = bbox
    if x1 <= x0 or y1 <= y0:
        return np.zeros((side, side), dtype=bool)
    crop = Image.fromarray(mask[y0:y1, x0:x1].astype(np.uint8) * 255).resize((side, side), Image.NEAREST)
    return np.asarray(crop) > 127


def audit_view_set(name, imgs):
    """imgs = {'front': PIL, 'back': PIL, 'left': PIL, 'top': PIL}"""
    res = {}
    masks = {}
    aspect_errs = {}
    for k, im in imgs.items():
        w, h = im.size
        aspect = w / float(max(h, 1))
        aspect_errs[k] = round(abs(aspect - 1.0), 4)
        mask, bg_col, bg_std, bbox, islands = extract_fg_mask(im.convert('RGB'))
        x0, y0, x1, y1 = bbox
        masks[k] = {
            'mask': mask,
            'size': (w, h),
            'aspect': round(aspect, 4),
            'bg_std': round(bg_std, 2),
            'islands': islands,
            'bbox': bbox,
            'w_frac': (x1 - x0) / float(w),
            'h_frac': (y1 - y0) / float(h),
        }

    # Mirror IoU: Front vs horizontally flipped Back (normalized by foreground bounding box)
    mf = normalize_bbox_mask(masks['front']['mask'], masks['front']['bbox'], side=160)
    mb = normalize_bbox_mask(masks['back']['mask'], masks['back']['bbox'], side=160)[:, ::-1]
    inter = float((mf & mb).sum())
    union = float((mf | mb).sum())
    mirror_iou = inter / max(union, 1.0)

    # Row-wise & Col-wise epipolar height/width consistency
    f_h = masks['front']['h_frac']
    b_h = masks['back']['h_frac']
    l_h = masks['left']['h_frac']
    f_w = masks['front']['w_frac']
    t_w = masks['top']['w_frac']

    height_ratio_back = b_h / max(f_h, 1e-6)
    height_ratio_left = l_h / max(f_h, 1e-6)
    width_ratio_top = t_w / max(f_w, 1e-6)

    # Auto-zoom factors to align Left height -> Front height & Top width -> Front width
    auto_zoom_left = 1.0 / max(height_ratio_left, 1e-6)
    auto_zoom_top = 1.0 / max(width_ratio_top, 1e-6)

    gates = {
        'aspect_ok': all(v <= 0.03 for v in aspect_errs.values()),
        'mirror_iou_ok': mirror_iou >= 0.78,
        'epipolar_left_h_ok': 0.88 <= height_ratio_left <= 1.14,
        'epipolar_top_w_ok': 0.88 <= width_ratio_top <= 1.14,
        'single_island_ok': all(masks[k]['islands'] == 1 for k in imgs),
    }
    score = sum(1 for v in gates.values() if v) / float(len(gates))

    return {
        'name': name,
        'score': round(score, 2),
        'verdict': 'PASS' if all(gates.values()) else 'REJECT_REDO',
        'gates': gates,
        'aspects': {k: masks[k]['aspect'] for k in imgs},
        'mirror_iou_front_vs_flip_back': round(mirror_iou, 4),
        'height_ratio_back_vs_front': round(height_ratio_back, 4),
        'height_ratio_left_vs_front': round(height_ratio_left, 4),
        'width_ratio_top_vs_front': round(width_ratio_top, 4),
        'auto_zoom_left_needed': round(auto_zoom_left, 4),
        'auto_zoom_top_needed': round(auto_zoom_top, 4),
        'masks': masks,
        'mf_norm': mf,
        'mb_norm': mb,
    }


def split_grid2x2(path):
    im = Image.open(path).convert('RGB')
    w, h = im.size
    hw, hh = w // 2, h // 2
    # Verified quadrant layout from neighbor_crown/forearm: TL=front, TR=back, BL=left, BR=top; 12px border trim removes grid crosshairs
    m = 12
    return {
        'front': im.crop((m, m, hw - m, hh - m)),
        'back': im.crop((hw + m, m, w - m, hh - m)),
        'left': im.crop((m, hh + m, hw - m, h - m)),
        'top': im.crop((hw + m, hh + m, w - m, h - m)),
    }


