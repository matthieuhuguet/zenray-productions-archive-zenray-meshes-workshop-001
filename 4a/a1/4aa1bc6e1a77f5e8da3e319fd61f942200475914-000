import sys, os, json, numpy as np, concurrent.futures as cf
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); import qw6, density
def go(a):
    m, p, N = a; s12 = json.load(open(f"{qw6.WORK}/{m}__{p}/stage12.json")); A = density.area(f"{qw6.GT}/{m}.obj")[0]; e0 = density.mean_edge(s12["rem"])
    out = dict(mesh=m, prep=p, target=N, e0=round(e0, 6)); s1 = float(np.sqrt(1.1 * A / N) / e0); out["scale_1shot"] = round(s1, 3)
    r1 = qw6.stage3(s12, f"m1_{p}_{N}", dict(scaleFact=round(s1, 4)), f"{qw6.GT}/{m}.obj", 600 + len(p))
    out["quads_1shot"] = r1.get("quads"); out["err_1shot_pct"] = round(100 * (r1["quads"] / N - 1), 1) if r1.get("quads") else None
    if r1.get("quads"):
        s2 = s1 * (r1["quads"] / N) ** 0.5; r2 = qw6.stage3(s12, f"m2_{p}_{N}", dict(scaleFact=round(s2, 4)), f"{qw6.GT}/{m}.obj", 650 + len(p))
        out["scale_2shot"] = round(s2, 3); out["quads_2shot"] = r2.get("quads"); out["err_2shot_pct"] = round(100 * (r2["quads"] / N - 1), 1) if r2.get("quads") else None
        out["judge_2shot"] = {k: r2.get(k) for k in ("folded_share", "squashed_share", "poles_per_1000_quads", "dev_mean_frac_diag")}
    return out
jobs = [(m, p, 10000) for m in ("arch_hard", "lily_plant", "eucalyptus_tree", "manny_character") for p in ("basic", "organic", "thr20", "thr70")]
with cf.ThreadPoolExecutor(8) as ex:
    for o in ex.map(go, jobs): print(json.dumps(o), flush=True)
