#!/usr/bin/env python3
# 5 November 2026, 17:57 Europe/Paris: regression checks for lost tips, without rerunning the reconstruction.
import json
import sys
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).resolve().parent))
from ZenRayRetopology import PARAMS,envelope_deviation,preserve_raw_envelope,gate_score

reference=np.array([[0.,0.,0.],[1.,1.,1.]])
shortened=reference*np.array([1.,1.,.89])
limit=PARAMS['gate_envelope_frac']
assert envelope_deviation(reference,reference)[0]==0
assert envelope_deviation(reference,shortened)[0]>limit
assert preserve_raw_envelope(reference,shortened,reference,limit)
assert not preserve_raw_envelope(reference,reference,reference,limit)
assert not preserve_raw_envelope(reference,shortened,shortened,limit)
bad={'gates':{'envelope':{'pass':False},'coverage':{'pass':True},'density':{'pass':True},'folded':{'pass':True}},'measures':{'straight_iso_mean_deg':1.0}}
good={'gates':{'envelope':{'pass':True},'coverage':{'pass':True},'density':{'pass':False},'folded':{'pass':False}},'measures':{'straight_iso_mean_deg':3.0}}
assert gate_score(good)>gate_score(bad)
print(json.dumps({'identityAccepted':True,'shorteningRejected':True,'faithfulRawPreserved':True,'invalidRawNotAccepted':True,'shapeRanksBeforeOtherGates':True}))
