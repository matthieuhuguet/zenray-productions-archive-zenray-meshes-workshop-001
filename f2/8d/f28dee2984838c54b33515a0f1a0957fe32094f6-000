#!/bin/zsh
# 25 October 2026 : ZenRay Meshes, one row-loft trial : loft params overrides -> npz, obj, sheet score. Usage: LoftTry.sh <tag> '<json overrides>'
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; cd $W
$PY -c "import json,sys; p=json.load(open('work/car/loft_params.json')); p.update(json.loads(sys.argv[1])); json.dump(p, open('work/car/loft_try.json','w'))" "$2"
$PY -I Scripts/RowLoft.py work/car/loft_try.json work/car/arch_loft work/car/loft_$1.npz > /dev/null
$PY -c "
import numpy as np, trimesh
d=np.load('work/car/loft_$1.npz',allow_pickle=True); Q=d['Q']; F=np.concatenate([Q[:,[0,1,2]],Q[:,[0,2,3]]])
trimesh.Trimesh(d['P'],F,process=False).export('work/car/loft_$1.obj')"
$PY -I Scripts/SheetScore.py work/car/frame work/car/views work/car/loft_$1.obj versions/Loft_$1_vs_ref.png
