#!/bin/zsh
# 26 October 2026 : ZenRay Meshes tree loop step with the ORGANIC component score : TreeGrow + Houdini rebuild (RunTree.sh), then the real polygons
# (ExportTopo.py, shared with the car), the shared judge (TopoCheck.py) and the component completion (ComponentScore.py --obj tree).
# Houdini CTRL values : env CTRL="leaf_size=0.45,cards=3". Usage: RunTreeScore.sh <tag> [k=v ...]   FR : un pas de boucle de l'arbre avec la complétion par composant.
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; TAG=$1; cd $W
if [ -n "$CTRL" ]; then python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom "c=hou.node('/obj/ZRM_Tree/CTRL_zrm'); [c.parm(kv.split('=')[0]).set(float(kv.split('=')[1])) for kv in '$CTRL'.split(',')]; result=1" live > /dev/null; fi
zsh Scripts/RunTree.sh $TAG "${@:2}" > /tmp/claude-501/tree_$TAG.log 2>&1
python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom "g={'SOP':'/obj/ZRM_Tree/OUT_tree','OUT':'$W/work/tree/topo_$TAG.npz'}; exec(open('$W/Scripts/ExportTopo.py').read(), g); result=g['result']" live > /dev/null
$PY -I Scripts/ComponentScore.py $TAG --obj tree --no-board
