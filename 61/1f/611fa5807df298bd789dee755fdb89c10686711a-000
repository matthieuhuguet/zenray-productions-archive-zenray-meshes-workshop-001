import re
def fr(line):
    parts = line.split("`")
    for i in range(0, len(parts), 2):
        parts[i] = re.sub(r"(?<![\d.])(\d+)\.(\d+)(?![\d.])", r"\1,\2", parts[i])
    return "`".join(parts)
