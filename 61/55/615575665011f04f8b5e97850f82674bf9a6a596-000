def R05():
    """Houdini isotropic Remesh (triangles, 2 cm), then greedy pairing of triangles into quads (best squareness first)."""
    body = ("r = net.createNode('remesh::2.0','RM'); r.setInput(0, src['reg']); r.parm('targetsize').set(0.02)\n"
            "o = net.createNode('null','OUT'); o.setInput(0, r)")
    P, T = _hou_run("R05", body, _reg_inputs()); return pair_tris(P, T)


def pair_tris(P, T):
    from collections import defaultdict
    ef = defaultdict(list)
    for i, t in enumerate(T):
        for k in range(3): ef[(min(t[k], t[(k + 1) % 3]), max(t[k], t[(k + 1) % 3]))].append(i)
    cand = []
    for e, f in ef.items():
        if len(f) != 2: continue
        a, b = f; o1 = [v for v in T[a] if v not in e][0]; o2 = [v for v in T[b] if v not in e][0]
        q = [e[0], o2, e[1], o1] if True else None
        ang = []
        for k in range(4):
            u, w = P[q[k - 1]] - P[q[k]], P[q[(k + 1) % 4]] - P[q[k]]; ang.append(np.degrees(np.arccos(np.clip(u @ w / (np.linalg.norm(u) * np.linalg.norm(w) + 1e-12), -1, 1))))
        cand.append((max(abs(x - 90) for x in ang), a, b, q))
    cand.sort(); used = set(); Q = []
    for s, a, b, q in cand:
        if a in used or b in used or s > 50: continue
        used |= {a, b}; Q.append(q)
    Q += [list(t) for i, t in enumerate(T) if i not in used]
    # consistent winding with the first triangle of each quad
    return P, Q


def R12():
    """Houdini Planar Patch from Curves on the contour loop (best fit plane), rays back onto the sculpt region, then a relax."""
    Ct = C.contours(); loop = Ct["P"][Ct["loop"]]; C.write_obj(HOU_DIR + "loop.obj", loop, [list(range(len(loop)))])
    body = ("cv = src['loop']\n"
            "pp = net.createNode('planarpatchfromcurves','PP'); pp.setInput(0, cv)\n"
            "pn = [p.name() for p in pp.parms()]\n"
            "for nm in ('edgelength','targetedgelength','seglength'):\n    if nm in pn: pp.parm(nm).set(0.02)\n"
            "ry = net.createNode('ray','RAY'); ry.setInput(0, pp); ry.setInput(1, src['reg']); ry.parm('method').set('minimum')\n"
            "o = net.createNode('null','OUT'); o.setInput(0, ry)")
    return _hou_run("R12", body, {"loop": HOU_DIR + "loop.obj", "reg": FD + "reg.obj"})


def R13():
    """Houdini Topo Transfer : the clean template grid (contours sheet before projection) transferred onto the sculpt region, no landmarks."""
    Pc, gc = coarse(); Q = [q for g in gc for q in quads_from_grid(g["G"])]; C.write_obj(HOU_DIR + "template.obj", Pc, Q)
    body = ("t = net.createNode('topotransfer','TT'); t.setInput(0, src['tpl']); t.setInput(1, src['reg'])\n"
            "pn = [p.name() for p in t.parms()]\n"
            "if 'enablelandmarks' in pn: t.parm('enablelandmarks').set(0)\n"
            "o = net.createNode('null','OUT'); o.setInput(0, t)")
    return _hou_run("R13", body, {"tpl": HOU_DIR + "template.obj", "reg": FD + "reg.obj"})


def R14():
    """Houdini Topo Slide by Curve References : the template grid slid so its border and crease rows land on the contours drawn on the sculpt."""
    Pc, gc = coarse(); Q = [q for g in gc for q in quads_from_grid(g["G"])]; C.write_obj(HOU_DIR + "template.obj", Pc, Q)
    Ct = C.contours(); cr = Ct["crease"]; lp = Ct["loop"]
    C.write_obj(HOU_DIR + "src_curves.obj", np.vstack([Pc[lp], Pc[cr]]), [list(range(len(lp))), list(range(len(lp), len(lp) + len(cr)))])
    C.write_obj(HOU_DIR + "tgt_curves.obj", np.vstack([Ct["P"][lp], Ct["P"][cr]]), [list(range(len(lp))), list(range(len(lp), len(lp) + len(cr)))])
    body = ("s = net.createNode('toposlidebycurverefs','TS'); s.setInput(0, src['tpl']); s.setInput(1, src['src']); s.setInput(2, src['tgt'])\n"
            "ry = net.createNode('ray','RAY'); ry.setInput(0, s); ry.setInput(1, src['reg']); ry.parm('method').set('minimum')\n"
            "o = net.createNode('null','OUT'); o.setInput(0, ry)")
    return _hou_run("R14", body, {"tpl": HOU_DIR + "template.obj", "src": HOU_DIR + "src_curves.obj", "tgt": HOU_DIR + "tgt_curves.obj", "reg": FD + "reg.obj"})


def R15():
    """Box cage conformed : every other row and column of the template, Houdini Subdivide (one level), rays onto the sculpt region, Surface Relax."""
    Pc, gc = coarse(); Qc = []
    for g in gc:
        G = g["G"]; cols = sorted(set(range(0, G.shape[0], 2)) | {G.shape[0] - 1}); rows = sorted(set(range(0, G.shape[1], 2)) | {G.shape[1] - 1})
        Qc += quads_from_grid(G[np.ix_(cols, rows)])
    Pk, Qk = C.compact(Pc, Qc); C.write_obj(HOU_DIR + "cage.obj", Pk, Qk)
    body = ("sd = net.createNode('subdivide','SD'); sd.setInput(0, src['cage']); sd.parm('iterations').set(1)\n"
            "ry = net.createNode('ray','RAY'); ry.setInput(0, sd); ry.setInput(1, src['reg']); ry.parm('method').set('minimum')\n"
            "rl = net.createNode('surfacerelax','RLX'); rl.setInput(0, ry); rl.setInput(1, src['reg']); rl.parm('iterations').set(10)\n"
            "o = net.createNode('null','OUT'); o.setInput(0, rl)")
    return _hou_run("R15", body, {"cage": HOU_DIR + "cage.obj", "reg": FD + "reg.obj"})


