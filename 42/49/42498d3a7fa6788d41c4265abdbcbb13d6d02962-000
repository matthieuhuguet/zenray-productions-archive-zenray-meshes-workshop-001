#!/usr/bin/env python3
# 5 November 2026, 18:43 Europe/Paris: show geometry without an infographic.
import base64
import hashlib
import json
from datetime import datetime
from html import escape
from pathlib import Path
from zoneinfo import ZoneInfo

from build_audit import fonts


HERE = Path(__file__).resolve().parent
WORKSHOP = HERE.parents[1]
INPUT = HERE / "chatgpt-hood-chain"
OUTPUT = WORKSHOP / "Articles/components-chatgpt-chain-5-November-2026.html"


def embed(path):
    return "data:image/png;base64," + base64.b64encode(path.read_bytes()).decode()


def build():
    record = json.loads((INPUT / "execution.json").read_text())
    display = record["display"]
    now = datetime.now(ZoneInfo("Europe/Paris")).isoformat(timespec="seconds")
    style = fonts() + """
    :root { --paper: #f5f5f2; --ink: #242624; --space: 32px; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 20px/1.5 'Adobe Clean',sans-serif; }
    main { max-width: 1680px; margin: auto; padding: 56px var(--space); }
    h1 { font: 400 clamp(36px,5vw,64px)/1.1 'GT Ultra',sans-serif; margin: 0 0 22px; }
    p { max-width: 780px; margin: 14px 0 30px; }
    figure { margin: 32px 0; }
    img { display: block; width: 100%; height: auto; }
    figcaption { font-size: 16px; margin-top: 10px; color: #606560; }
    a { color: inherit; }
    .source { max-width: 700px; }
    @media (max-width: 640px) { :root { --space: 18px; } main { padding-top: 32px; } }
    """
    body = "<h1>Capot</h1><p>" + escape(display["summary"]) + "</p>"
    if display.get("downloads"):
        body += "<p>" + " · ".join('<a href="' + escape(item["href"], quote=True) + '">' + escape(item["label"]) + "</a>" for item in display["downloads"]) + "</p>"
    for item in display["images"]:
        image_path = INPUT / item["file"]
        body += '<figure' + (' class="source"' if item.get("source") else "") + '><img alt="' + escape(item["label"], quote=True) + '" src="' + embed(image_path) + '"><figcaption>' + escape(item["label"]) + '</figcaption></figure>'
    body += '<p><a href="' + escape(record["chatUrl"], quote=True) + '">Conversation ChatGPT</a> · <a href="meshes-audit-5-November-2026.html">Bilan ZenRay Meshes</a></p><p style="font-size:14px;color:#606560">' + escape(now) + '</p>'
    html = '<!doctype html><html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Capot</title><style>' + style + '</style><main>' + body + '</main></html>'
    OUTPUT.write_text(html)
    print(json.dumps({"path":str(OUTPUT),"images":len(display["images"]),"sha256":hashlib.sha256(OUTPUT.read_bytes()).hexdigest()}))


if __name__ == "__main__":
    build()
