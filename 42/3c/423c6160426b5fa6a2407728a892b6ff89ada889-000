#!/bin/zsh
# 27 October 2026 : ZenRay Meshes, ONE LOOP STEP on the delivery file of the last kept version.
# Usage: LoopStep.sh <base_tag> <candidate_tag> <seed>
# 1 hill climb on the delivery (judge = TopoCheck, guard per face, mirror pairs, fold cap, cap 10 mm from the base)
# 2 topology judge and senior review on the candidate ; 3 six-view silhouette and lines of the candidate OBJ ; 4 gate against the base.
# FR : une itération de boucle sur la livraison ; porte finale = GateCandidate.py.
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; B=$1; C=$2; SEED=${3:-1}
cd $W; mkdir -p versions/Audit_$C
$PY -I Scripts/HillClimb.py work/car/delivery_$B.npz work/car/delivery_$C.npz --guard work/car/topo_params.json --anchor work/car/delivery_$B.npz --passes ${PASSES:-300} --sigma-mm ${SIGMA:-12} --max-mm 10 --fold-cap-deg 5.5 --fold-grow-deg 0.3 --seed $SEED --obj versions/ZenRayCar_$C.obj | tail -1
$PY -I Scripts/TopoCheck.py work/car/delivery_$C.npz work/car/topo_params.json versions/Topo_$C --no-board > /dev/null
$PY -I Scripts/AnimReview.py work/car/delivery_$C.npz work/car/topo_params.json work/car/wheel_params.json versions/Review_$C > /dev/null 2>&1 || true
$PY -I Scripts/SheetScore.py work/car/frame work/car/views versions/ZenRayCar_$C.obj versions/Audit_$C/vs.png > versions/Audit_$C/silhouette.json
$PY -I Scripts/LineScore.py work/car/frame work/car/views versions/ZenRayCar_$C.obj versions/Audit_$C/lines.png > versions/Audit_$C/lines.json
$PY -I Scripts/GateCandidate.py $B $C
