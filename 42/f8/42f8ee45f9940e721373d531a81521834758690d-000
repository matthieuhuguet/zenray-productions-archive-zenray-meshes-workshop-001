#!/usr/bin/env python3
# 10 November 2026: worst parts per quad gate of one version (left and centre parts only, the right ones are mirrors).
# usage: worst.py <version> [n]
import json, sys
ver = int(sys.argv[1]); n = int(sys.argv[2]) if len(sys.argv) > 2 else 10
q = json.load(open('04_checks/V_%03d-qa/qa.json' % ver)); P = q['parts']
rows = [(nm, p) for nm, p in P.items() if not nm.endswith(('_R', '_FR', '_RR'))]
def show(key, lim, low=True, fmt=lambda v: v):
    r = [(fmt(p[key]), nm.replace('CAR_', ''), p.get('skin_quads')) for nm, p in rows if p.get(key) is not None]
    bad = [t for t in r if (t[0] < lim if low else t[0] > lim)]
    bad.sort(key=lambda t: t[0], reverse=not low)
    print('%-18s %2d bad | ' % (key, len(bad)) + ' | '.join('%s %s (%s)' % (nm, v, qd) for v, nm, qd in bad[:n]))
show('angle_ok_share', 0.99); show('aspect_ok_share', 0.99); show('warp_ok_share', 0.99); show('folded', 0, low=False)
show('edge_mm_p5_p50_p95', 2.5, low=False, fmt=lambda v: round(v[2] / max(v[1], 1e-9), 2)); show('sagitta_p95_mm', 0.15, low=False); show('regular_share', 0.95)
