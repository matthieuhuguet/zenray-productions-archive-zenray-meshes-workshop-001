    print(json.dumps({'moved':int((m>1e-6).sum()),'max_mm':float(m.max()),'clearance_mm':args.clearance_mm,'full_mm':args.full_mm,'fade_mm':args.fade_mm,'cap_mm':args.cap_mm}))

