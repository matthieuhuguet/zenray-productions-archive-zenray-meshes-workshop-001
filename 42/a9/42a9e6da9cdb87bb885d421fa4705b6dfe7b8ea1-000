    ap=argparse.ArgumentParser();ap.add_argument('assembly');ap.add_argument('panel');ap.add_argument('output');ap.add_argument('--support',default='CAR_body_liner_C');ap.add_argument('--grid',type=int,nargs=2,default=[41,17]);ap.add_argument('--clearance-mm',type=float,default=2);ap.add_argument('--full-mm',type=float,default=8);ap.add_argument('--fade-mm',type=float,default=30);ap.add_argument('--cap-mm',type=float,default=30);ap.add_argument('--max-slope',type=float,default=0);ap.add_argument('--passes',type=int,default=60);ap.add_argument('--settings');ap.add_argument('--normal-axis',type=int,default=0);ap.add_argument('--projection',type=int,nargs=2,default=[2,1]);ap.add_argument('--symmetric',type=int,default=1);ap.add_argument('--side',type=int,default=1);main(ap.parse_args())
