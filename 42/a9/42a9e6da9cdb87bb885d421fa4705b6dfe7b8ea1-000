        for key,value in settings.items():
            if hasattr(args,key):setattr(args,key,value)
    p,q,n=read_mesh(args.assembly);source,_,_=read_mesh(args.panel);nu,nv=args.grid
    inner=source[nu*nv:nu*nv*2];yz=inner[:,args.projection];x=(np.abs(inner[:,args.normal_axis]) if args.symmetric else inner[:,args.normal_axis]*args.side);hull=ConvexHull(yz)
