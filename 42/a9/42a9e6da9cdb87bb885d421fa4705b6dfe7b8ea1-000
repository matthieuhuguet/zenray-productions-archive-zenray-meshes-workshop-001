    before=p.copy();values=p[ids];xy=values[:,args.projection];distance=np.maximum(np.max(xy@hull.equations[:,:2].T+hull.equations[:,2],axis=1),0)
    wanted=linear(xy);outside=~np.isfinite(wanted);wanted[outside]=near(xy[outside]);wanted-=args.clearance_mm/1000
