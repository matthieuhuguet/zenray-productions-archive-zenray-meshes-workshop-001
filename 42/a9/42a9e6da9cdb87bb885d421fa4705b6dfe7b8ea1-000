    coordinate=(np.abs(values[:,args.normal_axis]) if args.symmetric else values[:,args.normal_axis]*args.side)
    inset=np.maximum(coordinate-wanted,0)*weight
    inset=np.minimum(inset,args.cap_mm/1000)
