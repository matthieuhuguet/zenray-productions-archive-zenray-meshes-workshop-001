def font(path, size): return ImageFont.truetype(path, size)


def wrap(d, text, f, width):
    words = text.split(); lines = []; cur = ""
    for w in words:
        t = (cur + " " + w).strip()
        if d.textlength(t, font=f) <= width: cur = t
        else: lines.append(cur); cur = w
    if cur: lines.append(cur)
    return lines


def box(d, xy, title, body, col, ft, fb, tag=None):
    x0, y0, x1, y1 = xy; d.rounded_rectangle(xy, radius=14, fill=SOFT[col], outline=col, width=3)
    d.rectangle((x0 + 3, y0 + 18, x0 + 12, y1 - 18), fill=col)
    d.text((x0 + 26, y0 + 14), title, font=ft, fill=INK); y = y0 + 14 + ft.size + 10
    for ln in wrap(d, body, fb, x1 - x0 - 44):
        if y > y1 - fb.size - 8: break
        d.text((x0 + 26, y), ln, font=fb, fill=INK); y += fb.size + 6
    if tag: d.text((x1 - 16 - d.textlength(tag, font=fb), y0 + 14), tag, font=fb, fill=col)


def arrow(d, a, b, col=MUTE, w=4):
    d.line((a, b), fill=col, width=w); ax, ay = a; bx, by = b; import math
    ang = math.atan2(by - ay, bx - ax); s = 14
    d.polygon([(bx, by), (bx - s * math.cos(ang - 0.4), by - s * math.sin(ang - 0.4)), (bx - s * math.cos(ang + 0.4), by - s * math.sin(ang + 0.4))], fill=col)


def header(d, W, title, sub):
    d.text((60, 40), title, font=font(FT, 54), fill=INK); d.text((60, 112), sub, font=font(FB, 26), fill=MUTE); d.line((60, 160, W - 60, 160), fill=LINE, width=2)


def legend(d, x, y, fb):
    for col, lab in ((GREEN, "fait et mesuré"), (AMBER, "partiel"), (RED, "bloqué ou échoué"), (BLUE, "décision ou entrée"), (GREY, "pas commencé")):
        d.rounded_rectangle((x, y, x + 26, y + 26), radius=6, fill=col); d.text((x + 36, y - 1), lab, font=fb, fill=INK); x += 36 + d.textlength(lab, font=fb) + 34


