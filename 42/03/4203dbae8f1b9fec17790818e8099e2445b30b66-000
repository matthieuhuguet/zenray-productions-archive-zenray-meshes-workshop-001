def bars(d, x0, y0, w, h, groups, series, vmax, unit, fb, fn, title):
    """grouped bars : groups = [name], series = [(label, colour, [values])]"""
    d.text((x0, y0 - 44), title, font=fn, fill=INK); d.line((x0, y0 + h, x0 + w, y0 + h), fill=INK, width=2)
    gw = w / len(groups); bw = gw * 0.78 / len(series)
    for gi, g in enumerate(groups):
        gx = x0 + gi * gw + gw * 0.11
        for si, (lab, col, vals) in enumerate(series):
            v = vals[gi]
            if v is None: continue
            bh = min(h, h * v / vmax); bx = gx + si * bw; d.rectangle((bx, y0 + h - bh, bx + bw - 6, y0 + h), fill=col)
            t = ("%g" % v) + unit; d.text((bx, y0 + h - bh - fb.size - 6), t, font=fb, fill=INK)
        d.text((gx, y0 + h + 10), g, font=fb, fill=INK)


