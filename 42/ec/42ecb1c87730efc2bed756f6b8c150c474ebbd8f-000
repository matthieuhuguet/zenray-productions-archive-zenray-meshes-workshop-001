<script>
const root = document.documentElement;
document.getElementById('themeBtn').addEventListener('click', () => {
  const darkNow = root.getAttribute('data-theme') === 'dark' ||
    (!root.getAttribute('data-theme') && matchMedia('(prefers-color-scheme: dark)').matches);
  root.setAttribute('data-theme', darkNow ? 'light' : 'dark');
});

let mat = 'metal', texel = 2048, relief = 0.70, aoStr = 0.65, wear = 0.40;
const contracts = {
  metal: '<strong>Arm_Cuff (Coque symétrique A) :</strong><br>· UV : M1 droit symétrique + colliers trous<br>· Normal + AO centrés sur l’encoche U<br>· ORM prêt pour Unreal et Karma Métal',
  flare: '<strong>Arm_Flare (Plaque courbe B) :</strong><br>· UV : M1 contour externe + bord net<br>· Usure portée par les 2 plis jaunes CMY<br>· BaseColor nettoyée sans ombre portée',
  scale: '<strong>Dracard (Organique C) :</strong><br>· UV : cylindre déroulé couture ventrale<br>· Relief Directionnel d’écailles dorsales<br>· Roughness modulée crête contre ventre',
  bark: '<strong>Arbre (Ramification D) :</strong><br>· UV : bandes répétables M2 sur tronc<br>· Écorce Copernicus + atlas alpha feuilles<br>· Économie 99,89 % de polygones'
};

function patternHeight(u, v) {
  if (mat === 'metal') {
    const brush = 0.14 * Math.sin(u * 48) + 0.08 * Math.cos(u * 120 + v * 6);
    const bevel = Math.min(u, 1 - u, v, 1 - v) < 0.14 ? 0.55 : 0.78;
    const groove = Math.exp(-Math.pow((v - 0.52) / 0.04, 2)) * -0.45;
    return Math.max(0, Math.min(1, bevel + brush + groove));
  }
  if (mat === 'flare') {
    const ridge = Math.exp(-Math.pow((v - 0.45 - 0.08 * Math.sin(u * 4)) / 0.05, 2)) * 0.65;
    const fold2 = Math.exp(-Math.pow((v - 0.70 + 0.12 * u) / 0.04, 2)) * -0.4;
    return Math.max(0, Math.min(1, 0.55 + ridge + fold2 + 0.06 * Math.sin(u * 70)));
  }
  if (mat === 'scale') {
    const su = (u * 8) % 1, sv = ((v * 7) + (Math.floor(u * 8) % 2) * 0.5) % 1;
    const d = Math.hypot(su - 0.5, sv - 0.35);
    return Math.max(0, Math.min(1, 0.88 - d * 1.15));
  }
  // bark vertical fissures
  const fis = Math.sin(u * 26 + Math.sin(v * 9) * 1.4) * 0.35 + Math.cos(u * 52) * 0.15;
  return Math.max(0, Math.min(1, 0.56 + fis));
}

function renderMaps() {
  const ids = ['cBase', 'cNorm', 'cHeight', 'cRough', 'cAO', 'cORM'];
  const ctxs = Object.fromEntries(ids.map(id => [id, document.getElementById(id).getContext('2d')]));
  const W = 240, H = 170;
  const Hbuf = new Float32Array(W * H);
  for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) Hbuf[y * W + x] = patternHeight(x / W, y / H);

  const imgs = Object.fromEntries(ids.map(id => [id, ctxs[id].createImageData(W, H)]));
  for (let y = 0; y < H; y++) {
    for (let x = 0; x < W; x++) {
      const idx = y * W + x, p = idx * 4;
      const h = Hbuf[idx];
      const hx = Hbuf[y * W + Math.min(W - 1, x + 1)] - Hbuf[y * W + Math.max(0, x - 1)];
      const hy = Hbuf[Math.min(H - 1, y + 1) * W + x] - Hbuf[Math.max(0, y - 1) * W + x];
      const slope = Math.hypot(hx, hy) * relief * 6.5;

      // Height
      const hv = Math.round(h * 255);
      imgs.cHeight.data.set([hv, hv, hv, 255], p);

      // Normal
      const nx = -hx * relief * 11, ny = -hy * relief * 11, nz = 1.0;
      const nl = Math.hypot(nx, ny, nz);
      imgs.cNorm.data.set([
        Math.round(((nx / nl) * 0.5 + 0.5) * 255),
        Math.round(((ny / nl) * 0.5 + 0.5) * 255),
        Math.round(((nz / nl) * 0.5 + 0.5) * 255), 255
      ], p);

      // AO
      const ao = Math.max(0.08, Math.min(1.0, 1.0 - (1.0 - h) * aoStr * 1.15 - slope * 0.15));
      const aov = Math.round(ao * 255);
      imgs.cAO.data.set([aov, aov, aov, 255], p);

      // Roughness (wear brightens/polishes ridges vs matte valleys)
      const baseR = mat === 'bark' ? 0.82 : (mat === 'scale' ? 0.45 : 0.28);
      const rough = Math.max(0.08, Math.min(0.95, baseR + (1 - h) * 0.35 - (h > 0.72 ? wear * 0.22 : 0)));
      const rv = Math.round(rough * 255);
      imgs.cRough.data.set([rv, rv, rv, 255], p);

      // BaseColor
      let br = 152, bg = 158, bb = 166;
      if (mat === 'scale') { br = 72; bg = 104; bb = 92; }
      if (mat === 'bark') { br = 112; bg = 84; bb = 62; }
      const wBoost = (h > 0.72 ? wear * 55 : 0);
      imgs.cBase.data.set([
        Math.min(255, Math.round(br * (0.75 + 0.25 * ao) + wBoost)),
        Math.min(255, Math.round(bg * (0.75 + 0.25 * ao) + wBoost)),
        Math.min(255, Math.round(bb * (0.75 + 0.25 * ao) + wBoost)), 255
      ], p);

      // ORM Packed (R=AO, G=Roughness, B=Metalness)
      const metV = (mat === 'metal' || mat === 'flare') ? 235 : 15;
      imgs.cORM.data.set([aov, rv, metV, 255], p);
    }
  }
  ids.forEach(id => ctxs[id].putImageData(imgs[id], 0, 0));
}

document.querySelectorAll('[data-mat]').forEach(b => b.addEventListener('click', () => {
  mat = b.dataset.mat;
  document.querySelectorAll('[data-mat]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  document.getElementById('contractBox').innerHTML = contracts[mat];
  renderMaps();
}));
document.getElementById('sTexel').addEventListener('input', e => { texel = +e.target.value; document.getElementById('oTexel').textContent = texel + ' px/m'; });
document.getElementById('sRelief').addEventListener('input', e => { relief = +e.target.value / 100; document.getElementById('oRelief').textContent = relief.toFixed(2).replace('.', ','); renderMaps(); });
document.getElementById('sAO').addEventListener('input', e => { aoStr = +e.target.value / 100; document.getElementById('oAO').textContent = aoStr.toFixed(2).replace('.', ','); renderMaps(); });
document.getElementById('sWear').addEventListener('input', e => { wear = +e.target.value / 100; document.getElementById('oWear').textContent = wear.toFixed(2).replace('.', ','); renderMaps(); });

const qs = new URLSearchParams(location.search);
if (qs.get('theme')) root.setAttribute('data-theme', qs.get('theme'));
if (qs.get('mat')) document.querySelector(`[data-mat="${qs.get('mat')}"]`)?.click();
renderMaps();
</script>
</body>
</html>
