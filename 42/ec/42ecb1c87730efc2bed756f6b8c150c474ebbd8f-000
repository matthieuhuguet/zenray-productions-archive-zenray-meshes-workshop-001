<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pont direct Composant : Houdini, ZenRay UV et ZenRay Height</title>
<style>
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Regular.woff2') format('woff2');font-weight:100 450;font-style:normal}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Medium.woff2') format('woff2');font-weight:451 599;font-style:normal}
@font-face{font-family:'Adobe Clean';src:url('./fonts/AdobeClean-Bold.woff2') format('woff2');font-weight:600 900;font-style:normal}
:root{
  --font:'Adobe Clean','Hiragino Sans W4',sans-serif;
  --paper:#f5f4f1; --ink:#15171c; --mute:#5c616b; --line:#dad8d2; --card:#ffffff; --soft:#eceae4;
  --cyan:#0ea5b5; --ok:#16a34a; --yel:#d99a00; --blue:#2563eb; --r:14px; --t:.2s;
}
:root[data-theme="dark"]{
  --paper:#121317; --ink:#f0efe9; --mute:#9aa0ab; --line:#292d36; --card:#1a1c22; --soft:#23262f;
  --cyan:#38d9e8; --ok:#4ade80; --yel:#ffd60a; --blue:#60a5fa;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#121317; --ink:#f0efe9; --mute:#9aa0ab; --line:#292d36; --card:#1a1c22; --soft:#23262f;
    --cyan:#38d9e8; --ok:#4ade80; --yel:#ffd60a; --blue:#60a5fa;
  }
}
@media (prefers-reduced-motion: reduce){ :root{ --t:0s } }
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:16px;line-height:1.55;font-synthesis:none;transition:background var(--t),color var(--t)}
main{max-width:1320px;margin:0 auto;padding:34px 22px 64px}
header.top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap;margin-bottom:18px}
h1{font-size:clamp(28px,3.4vw,40px);font-weight:500;line-height:1.12;margin:0}
.stamp{font-size:13px;color:var(--mute);margin-top:6px}
.theme-btn{border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit;font-size:14px;padding:9px 15px;border-radius:999px;cursor:pointer;min-height:40px}
.prose{max-width:74ch;margin-bottom:24px}
.prose p{margin:0 0 12px}
.bench{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:16px;margin-bottom:26px;align-items:start}
@media (max-width:960px){ .bench{grid-template-columns:1fr} }
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:16px}
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.tab{border:1px solid var(--line);background:transparent;color:var(--ink);font:inherit;font-size:14px;padding:8px 14px;border-radius:999px;cursor:pointer;min-height:38px;transition:all var(--t)}
.tab[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink);font-weight:500}
.channels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
@media (max-width:680px){ .channels{grid-template-columns:repeat(2,minmax(0,1fr))} }
.ch-box{background:var(--soft);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}
.ch-box canvas{width:100%;height:auto;display:block}
.ch-label{padding:8px 10px;font-size:13px;font-weight:500;display:flex;justify-content:space-between}
.ch-sub{font-size:12px;color:var(--mute);font-weight:400}
.ctrl{display:flex;flex-direction:column;gap:5px;margin-bottom:14px}
.ctrl label{display:flex;justify-content:space-between;font-size:13px;color:var(--mute)}
.ctrl output{color:var(--ink);font-weight:500}
input[type=range]{width:100%;accent-color:var(--ink);margin:0}
.contract{background:var(--soft);border-radius:12px;padding:12px;font-size:13px;line-height:1.5;margin-top:8px}
.schema-card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:14px}
.schema-card svg{width:100%;height:auto;display:block;border-radius:10px}
svg text{font-family:var(--font)}
</style>
