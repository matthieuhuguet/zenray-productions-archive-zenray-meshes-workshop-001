"""2 November 2026 : DRACARD, one body part as the series builds it, node for node : Otto line or drawn curve, transform from centroid, OUT_SKEL, attribute delete, polypath, resample, sweep with Apply Scale Along Curve, smooth, sculpt in red, subdivide, OUT. One part, one chain, one folder : the part is judged alone before the next one starts.
The sculpt holds its moves in sculpt.json, one offset per point of the coarse cage ; a wrangle named sculpt_<part> applies them, since the real Sculpt node keeps brush strokes that a script cannot write.
    hython ChainBuild.py <part.json> <out folder>      writes cage.obj (before the sculpt), part.obj (after it), Part.hip, report.json
FR : une partie du corps telle que la série la construit, node pour node. Une partie, une chaîne, un dossier : la partie est jugée seule avant de passer à la suivante. Le sculpt garde ses mouvements dans sculpt.json, un décalage par point de la cage grossière."""
import sys, os, json, time
import numpy as np, hou
spec = json.load(open(sys.argv[1])); OUT = sys.argv[2]; os.makedirs(OUT, exist_ok=True); name = spec["name"]; RED = hou.Color((0.9, 0.15, 0.15)); GREEN = hou.Color((0.2, 0.7, 0.25)); hou.hipFile.clear(suppress_save_prompt=True); geo = hou.node("/obj").createNode("geo", f"Mad_Villain_{name}")


def mk(t, label, *inputs, **parms):
    n = geo.createNode(t, label)
    for i, x in enumerate(inputs):
        if x is not None: n.setInput(i, x)
    for k, v in parms.items(): n.parm(k).set(v)
    return n


def piece(tag, L, S, smooth):
    if "otto_group" in L:
        otto = mk("testgeometry_otto", f"testgeometry_otto_{tag}"); skel = geo.createNode("null", f"null_{tag}"); skel.setInput(0, otto, 1); src = mk("blast", f"blast_{tag}", skel, grouptype=0, group=L["otto_group"], negate=1)
    else:
        a = mk("add", f"curve_{tag}", keep=0); a.parm("points").set(len(L["pts"]))
        for i, q in enumerate(L["pts"]):
            a.parm(f"usept{i}").set(1)
            for k, ax in enumerate("xyz"): a.parm(f"pt{i}{ax}").set(float(q[k]))
        a.parm("prims").set(1); a.parm("prim0").set(f"0-{len(L['pts']) - 1}"); a.parm("closed0").set(0); src = a
    x = mk("xform", f"transform_from_centroid_{tag}", src); G = src.geometry(); P = np.array(G.pointFloatAttribValues("P")).reshape(-1, 3); c = P.mean(0)
    for k, ax in enumerate("xyz"): x.parm(f"p{ax}").set(float(c[k])); x.parm(f"t{ax}").set(float(L.get("move", [0, 0, 0])[k]) - float(c[k]) if L.get("center") else float(L.get("move", [0, 0, 0])[k])); x.parm(f"s{ax}").set(float(L.get("scale", [1, 1, 1])[k]))
    o = mk("null", f"OUT_SKEL_{tag.upper()}", x); o.setColor(GREEN); d = mk("attribdelete", f"attribdelete_{tag}", o, ptdel="* ^P", primdel="*", vtxdel="*", dtldel="*"); p = mk("polypath", f"polypath_{tag}", d); r = mk("resample", f"resample_{tag}", p, dolength=0, dosegs=1, segs=S["segments"])
    s_ = mk("sweep::2.0", f"sweep_{tag}", r, surfaceshape="tube", surfacetype="quads", endcaptype="grid", radius=S["radius"], cols=S["cols"], applyscale=1); keys = S["ramp"]; s_.parm("scaleramp").set(hou.Ramp([hou.rampBasis.CatmullRom] * len(keys), [float(k[0]) for k in keys], [float(k[1]) for k in keys]))
    for k_, v_ in S.get("parms", {}).items(): s_.parm(k_).set(v_)
    last_ = s_
    if S.get("flatten"): k0 = np.array(L["pts"]).mean(0) if "pts" in L else c; last_ = mk("xform", f"flatten_{tag}", s_, sx=S["flatten"][0], sy=S["flatten"][1], sz=S["flatten"][2], px=float(k0[0]), py=float(k0[1]), pz=float(k0[2]))
    return mk("smooth::2.0", f"smooth_{tag}", last_, strength=smooth)


m = None
if not spec.get("base"):
    pieces = spec.get("pieces") or [dict(tag=name, line=spec["line"], sweep=spec["sweep"])]; ends = []
    for q in pieces:
        e0 = piece(q.get("tag", name), q["line"], q["sweep"], spec.get("smooth", 1)); ends.append(mk("mirror", f"mirror_{q['tag']}", e0, dirx=1, diry=0, dirz=0) if q.get("mirror") else e0)
    m = ends[0] if len(ends) == 1 else mk("merge", f"merge_{name}", *ends)
if spec.get("base"): b_ = mk("file", f"file_{name}_previous", file=spec["base"]); b_.setColor(GREEN); m = b_      # 2 November 2026 : the previous stage feeds this one, as sculpt, Quad Remesh, sculpt in ep04. FR : l'étape précédente nourrit celle-ci, comme sculpt, Quad Remesh, sculpt dans l'ep04.
if spec.get("volume"):
    Vv = spec["volume"]; v_ = mk("vdbfrompolygons", f"vdbfrompolygons_{name}", m, voxelsize=Vv["voxel"], fillinterior=1); sm_ = mk("vdbsmoothsdf", f"vdbsmooth_{name}", v_, iterations=Vv.get("smooth", 2)); cv_ = mk("convertvdb", f"convertvdb_{name}", sm_, conversion="poly", adaptivity=Vv.get("adaptivity", 0.2)); m = mk("quadremesh", f"quadremesh_{name}", cv_, targetquadcount=Vv["quads"], xaxis=1)
cage = mk("null", f"CAGE_{name}", m); cage.setColor(GREEN); cg = cage.geometry(); cg.saveToFile(f"{OUT}/cage.obj"); last = cage; moves = None
if os.path.exists(f"{OUT}/sculpt.json"):
    moves = json.load(open(f"{OUT}/sculpt.json")); assert len(moves) == len(cg.points()), f"sculpt has {len(moves)} moves, the cage has {len(cg.points())} points"; w = mk("attribwrangle", f"sculpt_{name}", cage); w.parm("snippet").set("vector d[] = {" + ",".join("{%.6f,%.6f,%.6f}" % tuple(q) for q in moves) + "};\nv@P += d[@ptnum];"); w.setColor(RED); last = w
if spec.get("post_smooth"): last = mk("smooth::2.0", f"smooth_after_sculpt_{name}", last, strength=spec["post_smooth"])      # 2 November 2026 : the light Smooth brush the author passes after a sculpt. FR : la légère brosse Smooth que l'auteur passe après un sculpt.
sub = mk("subdivide", f"subdivide_{name}", last, iterations=spec.get("subdivide", 2)); out = mk("null", f"OUT_{name.upper()}", sub); out.setColor(GREEN); out.setDisplayFlag(True); out.setRenderFlag(True); geo.layoutChildren(); g = out.geometry(); g.saveToFile(f"{OUT}/part.obj"); errs = [n.path() + " : " + n.errors()[0][:100] for n in geo.children() if n.errors()]; hou.hipFile.save(f"{OUT}/Part.hip"); rep = dict(part=name, nodes=[n.name() for n in geo.children()], cage_points=len(cg.points()), cage_prims=len(cg.prims()), points=len(g.points()), errors=errs, sculpted=moves is not None); json.dump(rep, open(f"{OUT}/report.json", "w"), indent=0); print(json.dumps(rep))
