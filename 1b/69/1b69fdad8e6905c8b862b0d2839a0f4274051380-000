# 10 November 2026: every HDA of the skill's otls folder loaded in Houdini 22 without interface: definitions, parameters
# visible on the node, cook, points and primitives, errors. Run with hython. Writes data/hda_check.json.
import hou, json, glob, os, time
out = []; geo = hou.node('/obj').createNode('geo', 'audit')
for f in sorted(glob.glob('/Users/zenray/.claude/skills/zenray-meshes/otls/*.hda')):
    row = {'file': os.path.basename(f)}
    try:
        hou.hda.installFile(f); defs = hou.hda.definitionsInFile(f); row['definitions'] = [d.nodeTypeName() for d in defs]
        d = defs[0]; cat = d.nodeTypeCategory().name(); row['category'] = cat
        if cat != 'Sop':
            row['note'] = 'not a SOP'; out.append(row); continue
        t0 = time.time(); n = geo.createNode(d.nodeTypeName())
        parms = [p for p in n.parms() if not p.isHidden() and p.parmTemplate().type().name() not in ('Folder', 'FolderSet', 'Label', 'Separator')]
        row['visible_parms'] = len(parms); row['parm_names'] = [p.name() for p in parms][:24]
        try:
            g = n.geometry(); row['points'] = len(g.points()); row['prims'] = len(g.prims())
            row['quads'] = sum(1 for p in g.prims() if p.type() == hou.primType.Polygon and len(p.vertices()) == 4)
        except Exception as e:
            row['cook_error'] = str(e)[:200]
        row['errors'] = [e[:160] for e in n.errors()]; row['warnings'] = [w[:160] for w in n.warnings()][:3]; row['cook_s'] = round(time.time() - t0, 2)
        n.destroy()
    except Exception as e:
        row['load_error'] = str(e)[:200]
    out.append(row); print(row['file'], row.get('visible_parms'), row.get('prims'), row.get('errors') or row.get('cook_error') or row.get('load_error') or '', flush=True)
json.dump(out, open('/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026/data/hda_check.json', 'w'), indent=1)
print('license', hou.licenseCategory())
