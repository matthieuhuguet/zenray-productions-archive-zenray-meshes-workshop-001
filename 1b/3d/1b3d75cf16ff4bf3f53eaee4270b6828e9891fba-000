      return `<option value="${x.v}"${cur ? ' selected' : ''}${off ? ' disabled' : ''}>${x.v}${x.date ? ' · ' + hhmm(when(x.date)) : ''}${x.v === c.drawing ? ' (dernière)' : off ? ' (app locale)' : ''}</option>`; }).join('')}</select></label>` : '';
  const where = [past ? `Version ${version} affichée, la dernière est ${c.drawing}` : '', c.drawing && !past ? 'Dessin ' + c.drawing : (!c.drawing ? 'Pas encore de dessin' : ''), c.built ? '3D construite' : '', (c.instances || []).length ? 'Copié sur ' + c.instances.join(', ') : '', NEXT[c.state] ? 'Prochaine étape : ' + NEXT[c.state] : ''].filter(Boolean).join(' · ');
  let h = `<div class="hd"><div class="crumb">${esc(R.project)} › ${GROUP[c.site]}</div><h2>${esc(c.name)}</h2>${tag(c, true)}
    <div class="right">${verSel}${modes(c)}
      <button class="quiet" data-more="1">${more ? 'Moins' : 'Détails'}</button><button class="btn" data-copy="${esc(c.resume)}">Reprendre ce composant</button></div>
    <div class="where">${esc(where)}</div></div>
  <div class="more ${more ? 'on' : ''}"><div>${esc(cap(c.note))}</div>
    <div><b>Identifiant</b> <span class="mono">${esc(c.id)}</span> · <b>code court</b> <span class="mono">${esc(c.short_id)}</span> · ${c.gates.green ? 'contrôles automatiques verts' : (c.gates.red.length ? 'contrôles rouges : ' + esc(c.gates.red.join(', ')) : 'contrôles non passés')}</div>
    <div class="acts"><button data-copy="${esc(RETURN_URL + (c.short_id || c.id))}">Copier le lien de retour</button><button data-copy="${esc(c.id)}">Copier l'identifiant</button><button data-copy="${esc(f.record)}">Copier le chemin de la fiche</button>${f.blueprint ? `<button data-copy="${esc(f.blueprint)}">Copier le chemin du blueprint</button>` : ''}</div></div>
  <div class="views ${kinds(c).length === 1 ? 'single' : ''}">`;
  for (const v of R.views.filter(k => VV[k] && VV[k].drawn)){
    h += `<section class="vrow"><h3>${VIEW[v]}</h3>${pair(VV[v], c.name, v, c, past ? 'la 3D suit la dernière version' : '')}</section>`;
  }
  const absent = R.views.filter(k => !(VV[k] && VV[k].drawn)).map(k => VIEW[k]);
  const ev = c.timeline.map((e, k) => ({d: when(e.date), what: short(e.what), k})).sort((a, b) => b.d - a.d || b.k - a.k).slice(0, 8);
  h += `</div>${absent.length ? `<p class="absent">Pas de dessin sur ${absent.length > 1 ? 'les vues' : 'la vue'} ${esc(absent.join(', '))} : le composant n'y est pas visible.</p>` : ''}
  <div class="strip">${c.built
    ? `<div class="box"><h3>Modèle 3D</h3>${f.shaded ? `<button class="pic" data-wide="${esc(f.shaded)}"><img loading="lazy" alt="rendu ombré" src="${WIDE[f.shaded]}"></button>` : '<p class="empty">Construit, pas encore de rendu.</p>'}</div>
       <div class="box"><h3>Modèle reposé sur les vues</h3>${f.sheet ? `<button class="pic" data-wide="${esc(f.sheet)}"><img loading="lazy" alt="feuille stricte" src="${WIDE[f.sheet]}"></button>` : '<p class="empty">Pas encore de feuille.</p>'}</div>`
    : '<div class="box wide"><h3>Modèle 3D</h3><p class="empty">Pas encore construit : le dessin se valide d\'abord.</p></div>'}
    <div class="box wide"><h3>Dernières étapes</h3><ul class="tl">${ev.map(e => `<li><time>${hhmm(e.d)}</time><span>${esc(cap(e.what))}</span></li>`).join('') || '<li class="empty">Rien encore.</li>'}</ul></div></div>`;
  document.getElementById('view-a').innerHTML = h;
}
function renderB(){
  let h = `<div class="hd"><div class="crumb">${esc(R.project)}</div><h2>Chantiers</h2><div class="where">La photo, le blueprint, puis les cinq vues de chaque composant. Cliquer ouvre sa planche.</div></div>`, i = 0;
  for (const g of groups){
    const list = R.components.filter(c => c.site === g);
    h += `<div class="gh"><h3><button data-scope="${g}" title="Voir tous les dessins du groupe">${GROUP[g]}</button></h3><span>${plural(list.length, 'composant', 'composants')}, ${plural(list.filter(c => statusOf(c) === 'done').length, 'fini', 'finis')}</span></div><div class="gal">` + list.map(c => card(c, i++)).join('') + '</div>';
  }
  document.getElementById('view-b').innerHTML = h;
}
function renderC(){
  // one card per component and per hour: its steps of that hour gathered (five drawings in two minutes are one line, not five)
  const buckets = new Map();
  for (const c of R.components) if (filter === 'all' || c.site === filter) for (const e of c.timeline){
    const d = when(e.date), k = d.toDateString() + ' ' + d.getHours();
    if (!buckets.has(k)) buckets.set(k, {d, cards: new Map()});
    const b = buckets.get(k);
    if (!b.cards.has(c.id)) b.cards.set(c.id, {c, ev: []});
    b.cards.get(c.id).ev.push({d, what: e.what});
  }
  const hours = [...buckets.values()].sort((a, b) => b.d - a.d);
  let h = `<div class="hd"><div class="crumb">${esc(R.project)}</div><h2>Chronologie</h2>
    <div class="right"><div class="filters">${[['all', 'Tout le projet']].concat(groups.map(g => [g, GROUP[g]])).map(([k, t]) => `<button data-filter="${k}" aria-pressed="${filter === k}">${t}</button>`).join('')}</div></div>
    <div class="where">Heure par heure, ce qui a bougé sur chaque composant. Cliquer ouvre sa planche.</div></div>`, i = 0;
  for (const b of hours){
    const cards = [...b.cards.values()].sort((x, y) => Math.max(...y.ev.map(e => +e.d)) - Math.max(...x.ev.map(e => +e.d)));
    h += `<div class="hour"><time>${b.d.getHours()} h<small>${b.d.toLocaleDateString('fr-FR', {day: 'numeric', month: 'long'})}</small></time><div class="feed">` + cards.map(({c, ev}) => {
      const draws = ev.filter(e => e.what.startsWith('dessin')).map(e => e.what.replace('dessin ', '')).sort();
      // in the order things happen: created, drawn, judged, built
      const rank = w => w.startsWith('composant') ? 0 : w.startsWith('verdict') ? 2 : 3;
      const rest = ev.filter(e => !e.what.startsWith('dessin')).map(e => short(e.what)).sort((x, y) => rank(x) - rank(y));
      const drawn = draws.length ? [draws.length > 1 ? `${draws.length} dessins, ${draws[0]} à ${draws[draws.length - 1]}` : 'dessin ' + draws[0]] : [];
      const lines = rest.filter(w => rank(w) === 0).concat(drawn, rest.filter(w => rank(w) > 0));
      const v = mainView(c), t0 = new Date(Math.min(...ev.map(e => +e.d))), t1 = new Date(Math.max(...ev.map(e => +e.d)));
      return `<button class="ec" style="--i:${i++}" data-open="${c.id}" data-go="a"><span class="th">${v ? `<img loading="lazy" alt="" src="${IMG[c.views[v].ref]}">` : ''}</span><span class="th bp">${v ? `<img loading="lazy" alt="" src="${IMG[c.views[v].blueprint]}">` : ''}</span>
        <span class="txt"><b>${esc(c.name)}</b>${tag(c)}<span class="g">${GROUP[c.site]} · ${hhmm(t0)}${+t1 !== +t0 ? ' à ' + hhmm(t1) : ''}</span><span class="ls">${esc(lines.map(cap).join(' · '))}</span></span></button>`;
    }).join('') + '</div></div>';
  }
  document.getElementById('view-c').innerHTML = h;
}
function mark(){
  for (const b of document.querySelectorAll('.item')) b.setAttribute('aria-current', !scope && b.dataset.open === current);
  for (const b of document.querySelectorAll('summary[data-scope-of]')) b.setAttribute('aria-current', b.dataset.scopeOf === scope);
}
function toast(t){ const el = document.getElementById('toast'); el.textContent = t; el.classList.add('on'); clearTimeout(toast.t); toast.t = setTimeout(() => el.classList.remove('on'), 1700); }
async function copy(text){
  try { await navigator.clipboard.writeText(text); toast('Copié : à coller dans une conversation'); }
  catch (e) { more = true; show('a'); const host = document.querySelector('.more'); const ta = document.createElement('textarea'); ta.className = 'fallback'; ta.readOnly = true; host.appendChild(ta); ta.value = text; ta.focus(); ta.select(); toast('Copie impossible ici : le texte est sélectionné'); }
}
function show(v){
  if (!['a', 'b', 'c'].includes(v)) v = 'a';
  for (const b of document.querySelectorAll('.tabs button')) b.setAttribute('aria-pressed', b.dataset.view === v);
  for (const s of document.querySelectorAll('.view')) s.classList.toggle('on', s.id === 'view-' + v);
  store.set('zrb3d-view', v);
  ({a: renderA, b: renderB, c: renderC})[v]();                            // drawn when shown: the cards come in
}
document.addEventListener('click', e => {
  const t = e.target.closest('[data-scope],[data-view],[data-open],[data-copy],[data-zoom],[data-wide],[data-filter],[data-show],[data-look],[data-more],[data-cover]');
  if (!t) return;
  if (t.dataset.scope){ e.preventDefault(); scope = t.dataset.scope; store.set('zrb3d-scope', scope); more = false; mark(); show('a'); return window.scrollTo(0, 0); }   // preventDefault: the name selects, only the chevron folds
  if (t.dataset.view){ show(t.dataset.view); return window.scrollTo(0, 0); }
  if (t.dataset.copy) return copy(t.dataset.copy);
  if (t.dataset.zoom || t.dataset.wide) return openLight(t.dataset.zoom ? srcOf(t.dataset.zoom) : WIDE[t.dataset.wide], t.dataset.full ? JSON.parse(t.dataset.full) : null);
  if (t.dataset.filter){ filter = t.dataset.filter; return renderC(); }
  if (t.dataset.show){ if (t.disabled) return; const k = t.dataset.show; shown = shown.includes(k) ? shown.filter(x => x !== k) : SHOWS.filter(x => x === k || shown.includes(x));
    if (!shown.length) shown = [k]; store.set('zrb3d-show', shown.join(',')); renderSide(); return renderA(); }
  if (t.dataset.look){ look = t.dataset.look; store.set('zrb3d-look', look); return renderA(); }
  if (t.dataset.more){ more = !more; return renderA(); }
  if (t.dataset.cover){ cover = t.dataset.cover; store.set('zrb3d-cover', cover); const im = document.getElementById('cover'), nu = im.cloneNode(); nu.src = COVER[cover]; nu.alt = R.project + ', ' + VIEW[cover]; im.replaceWith(nu);
    for (const b of document.querySelectorAll('[data-cover]')) b.setAttribute('aria-pressed', b.dataset.cover === cover); return; }
  if (t.dataset.open){ current = t.dataset.open; more = false; scope = ''; version = null; store.set('zrb3d-scope', ''); store.set('zrb3d-component', current); mark(); show(t.dataset.go || 'a'); window.scrollTo(0, 0); }
});
// 12 November 2026 (Matthieu: « un clic gauche sur l'image : pleine résolution et zoom, la résolution maximale »): the picture opens fitted to the
// window, then is replaced by its full-resolution twin made by the local server; wheel or pinch zooms around the pointer, drag pans,
// double click toggles fitted and 1:1, Escape or the cross closes. FR : visionneuse plein écran, pleine résolution, zoom et déplacement.
const LB = {el: document.getElementById('light'), s: 1, x: 0, y: 0, fit: 1, req: 0};
LB.img = LB.el.querySelector('img'); LB.info = LB.el.querySelector('.info');
const lbApply = () => { LB.img.style.transform = `translate(${LB.x}px,${LB.y}px) scale(${LB.s})`; LB.info.textContent = `${LB.img.naturalWidth} × ${LB.img.naturalHeight} px · ${Math.round(LB.s * 100)} % · molette pour zoomer, double clic 1:1`; };
const lbFit = () => { const W = innerWidth, H = innerHeight, w = LB.img.naturalWidth || 1, h = LB.img.naturalHeight || 1; LB.fit = Math.min((W - 40) / w, (H - 80) / h); LB.s = LB.fit; LB.x = (W - w * LB.s) / 2; LB.y = (H - h * LB.s) / 2; lbApply(); };
function openLight(src, full){
  const req = ++LB.req;
  LB.img.onload = () => lbFit(); LB.img.src = src; LB.el.classList.add('on');
  if (!full || !D.live) return;
  const q = new URLSearchParams({v: full.v, ...(full.c ? {c: full.c} : {}), ...(full.ver ? {ver: full.ver} : {}), ...(full.scope ? {scope: full.scope} : {})});
  fetch('/api/full?' + q, {cache: 'no-store'}).then(r => r.json()).then(g => {
    if (req !== LB.req || !g[full.k]) return;
    const im = new Image(); im.onload = () => {
      if (req !== LB.req) return;
      const was = LB.img.naturalWidth || 1, onScreen = LB.s * was, fitScreen = LB.fit * was;     // keep the place: same size on screen, sharper
      LB.img.onload = null; LB.img.src = im.src; LB.s = onScreen / im.naturalWidth; LB.fit = fitScreen / im.naturalWidth; lbApply(); };
    im.src = g[full.k];
  }).catch(() => {});
}
const lbClose = () => { LB.el.classList.remove('on'); LB.req++; };
LB.el.querySelector('.close').addEventListener('click', lbClose);
LB.el.addEventListener('click', e => { if (e.target === LB.el) lbClose(); });
LB.el.addEventListener('wheel', e => { e.preventDefault(); const f = Math.exp(-e.deltaY * 0.0015), ns = Math.min(Math.max(LB.s * f, LB.fit * 0.5), 12);
  LB.x = e.clientX - (e.clientX - LB.x) * ns / LB.s; LB.y = e.clientY - (e.clientY - LB.y) * ns / LB.s; LB.s = ns; lbApply(); }, {passive: false});
LB.img.addEventListener('dblclick', e => { const ns = Math.abs(LB.s - 1) < 0.01 ? LB.fit : 1; LB.x = e.clientX - (e.clientX - LB.x) * ns / LB.s; LB.y = e.clientY - (e.clientY - LB.y) * ns / LB.s; LB.s = ns; lbApply(); });
LB.img.addEventListener('pointerdown', e => { const sx = e.clientX - LB.x, sy = e.clientY - LB.y; LB.img.classList.add('drag'); LB.img.setPointerCapture(e.pointerId);
  const mv = (m) => { LB.x = m.clientX - sx; LB.y = m.clientY - sy; lbApply(); }; const up = () => { LB.img.classList.remove('drag'); LB.img.removeEventListener('pointermove', mv); LB.img.removeEventListener('pointerup', up); };
  LB.img.addEventListener('pointermove', mv); LB.img.addEventListener('pointerup', up); });
addEventListener('resize', () => { if (LB.el.classList.contains('on')) lbFit(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') lbClose(); });
const Q = new URLSearchParams(location.search);
const cycle = (key, list, labels, apply) => { const el = document.getElementById(key); const set = v => { if (!list.includes(v)) v = list[0]; apply(v); el.textContent = labels[v]; store.set('zrb3d-' + key, v); }; el.addEventListener('click', () => set(list[(list.indexOf(store.get('zrb3d-' + key, list[0])) + 1) % list.length])); set(Q.get(key) || store.get('zrb3d-' + key, document.documentElement.getAttribute('data-default-' + key) || list[0])); };   // 12 November 2026: inside the site the frame has no storage, the site hands its theme
cycle('theme', ['auto', 'light', 'dark'], {auto: 'Thème : auto', light: 'Thème : clair', dark: 'Thème : sombre'}, v => v === 'auto' ? document.documentElement.removeAttribute('data-theme') : document.documentElement.setAttribute('data-theme', v));
cycle('palette', ['neutre', 'encre', 'papier'], {neutre: 'Couleurs : neutre', encre: 'Couleurs : encre', papier: 'Couleurs : papier'}, v => document.documentElement.setAttribute('data-palette', v));
if (Q.has('still')) document.documentElement.classList.add('still');
// 12 November 2026: the page says which registry it shows, so that nobody wonders how fresh it is. FR : la page dit de quand date son registre.
document.querySelector('.brand').textContent = `ZenRay Blueprints 3D · ${R.project} · registre du ${R.date}`;
// 12 November 2026: the local application (HubServe.py) asks its server every two seconds; a new registry or a new page reloads the window,
// the choices (component, group, mode, view) come back from storage. FR : l'application locale se recharge seule quand le registre change.
if (D.live) {
  let seen = null;
  const brand = document.querySelector('.brand');
  const poll = async () => {
    try {
      const v = await (await fetch('/api/version', {cache: 'no-store'})).json();
      if (seen && v.token !== seen){                                       // keep the place: version shown and scroll come back after the reload
        store.set('zrb3d-keep', JSON.stringify({c: current, v: version, y: window.scrollY}));
        return location.reload();
      }
      seen = v.token;
      brand.textContent = `ZenRay Blueprints 3D · ${R.project} · en direct · registre du ${R.date}` + (v.busy ? ' · mise à jour…' : '') + (v.error ? ' · erreur : ' + v.error.slice(0, 80) : '');
    } catch (e) { brand.textContent = `ZenRay Blueprints 3D · ${R.project} · serveur local injoignable · registre du ${R.date}`; }
    setTimeout(poll, 2000);
  };
  poll();
}
// 12 November 2026: the RETURN link of a component (HubReturn.py, /c/<key> on the local server): ?open= takes its identifier, its short code (R12)
// or its simple name, in any case, and opens it on the Planche. FR : le lien de retour ouvre le composant par son identifiant, son code court ou son nom.
const norm = s => String(s || '').toLowerCase().replace(/[\s_\-]+/g, '');
const findKey = k => { if (!k) return null; const n = norm(k);
  return byId(k) || R.components.find(c => norm(c.short_id) === n) || R.components.find(c => norm(c.id) === n) || R.components.find(c => norm(c.name) === n) || null; };
const opened = findKey(Q.get('open'));
if (opened){ current = opened.id; scope = ''; }
else if (Q.get('open')) setTimeout(() => toast('Composant introuvable : ' + Q.get('open')), 300);
if (R.scopes[Q.get('scope')]) scope = Q.get('scope');
if (COVER[Q.get('cover')]) cover = Q.get('cover');
if (Q.get('show')) shown = Q.get('show').split(',').filter(k => SHOWS.includes(k));
if (Q.get('look') === 'wire') look = 'wire';
// a past version: the local server makes its tiles once and keeps them (Hub.version_tiles); the archived page in the cloud has only the latest
async function chooseVersion(v){
  const c = byId(current);
  if (!v || v === c.drawing){ version = null; return renderA(); }
  const key = c.id + '|' + v;
  if (!verTiles[key]){
    try { const r = await fetch('/api/version-tiles?c=' + encodeURIComponent(c.id) + '&v=' + encodeURIComponent(v), {cache: 'no-store'}); verTiles[key] = await r.json(); }
    catch (e) { toast('Version illisible : ' + e.message); return; }
  }
  if (verTiles[key].error){ toast(verTiles[key].error); delete verTiles[key]; return; }
  version = v; renderA();
}
document.addEventListener('change', (e) => { if (e.target.matches('[data-version]')) chooseVersion(e.target.value); });
if (Q.get('version')) setTimeout(() => chooseVersion(Q.get('version')), 0);
try { const keep = JSON.parse(store.get('zrb3d-keep', 'null')); store.set('zrb3d-keep', 'null');
  if (keep && keep.c === current){ (keep.v ? chooseVersion(keep.v) : Promise.resolve()).then(() => setTimeout(() => window.scrollTo(0, keep.y || 0), 60)); }
} catch (e) { /* nothing kept */ }
renderSide(); show(opened ? 'a' : (location.hash.slice(1) || store.get('zrb3d-view', 'a')));
if (Q.has('probe')) document.documentElement.dataset.width = document.documentElement.scrollWidth + ' of ' + innerWidth;   // the verifier reads this: no sideways overflow
</script>
