<title>ZenRay Blueprints 3D</title>
<!-- 12 November 2026 (date read from `date`): second round of the design proposals of the hub ZenRay Blueprints 3D, after Matthieu's
     feedback (the project shown as a project, names before codes, one ink and one accent, the five views seen at once, galleries
     with many pictures, 0.2 s animations). Built by Scripts/BuildMockups.py from the real registry of Car2.
     FR : deuxième tour des propositions, d'après le retour de Matthieu. -->
<style>
@font-face{font-family:'Adobe Clean';src:url(data:font/woff2;base64,) format('woff2');font-weight:100 450;font-display:block}
@font-face{font-family:'Adobe Clean';src:url(data:font/woff2;base64,) format('woff2');font-weight:451 900;font-display:block}
@font-face{font-family:'AnthropicMono';src:url(data:font/ttf;base64,) format('truetype');font-display:block}
/* every value of the design lives here: change a token, the three views follow. One ink, one accent (the blue of the blueprints). */
:root{
  --font:'Adobe Clean','Hiragino Sans W4',sans-serif; --mono:'AnthropicMono',ui-monospace,monospace;
  --bg:#f6f6f5; --panel:#ffffff; --well:#ececea; --ink:#161616; --soft:#6c6c69; --faint:#a9a9a5; --line:#e4e4e1; --accent:#1d4fa8; --blue:#103a80;
  --radius:14px; --radius-s:9px; --gap:18px; --tile-gap:10px; --side:272px; --t:.2s; --cell:4 / 3;
  --size:15px; --size-s:13px; --size-xs:11.5px; --h1:34px; --h2:15px; --project:30px;
  --lift:0 1px 2px rgba(0,0,0,.04),0 10px 28px rgba(0,0,0,.07);
}
:root[data-palette="encre"]{--bg:#f1f3f6; --panel:#ffffff; --well:#e6e9ee; --line:#dde1e7; --soft:#646b76; --faint:#a2a8b2}
:root[data-palette="papier"]{--bg:#f5f3ee; --panel:#fffefb; --well:#ebe8e0; --line:#e4e0d6; --soft:#716d64; --faint:#aba69b}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#121212; --panel:#1b1b1b; --well:#242424; --ink:#ededeb; --soft:#9c9c98; --faint:#666663; --line:#2c2c2b; --accent:#7fb0ff; --lift:0 1px 2px rgba(0,0,0,.5),0 10px 28px rgba(0,0,0,.4)}}
:root[data-theme="dark"]{--bg:#121212; --panel:#1b1b1b; --well:#242424; --ink:#ededeb; --soft:#9c9c98; --faint:#666663; --line:#2c2c2b; --accent:#7fb0ff; --lift:0 1px 2px rgba(0,0,0,.5),0 10px 28px rgba(0,0,0,.4)}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);font-size:var(--size);line-height:1.4;font-synthesis:none;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;text-align:left}
input{font:inherit;color:inherit}
.mono{font-family:var(--mono);font-size:.84em}
.top{position:sticky;top:0;z-index:20;display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;padding:9px 20px;background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.brand{font-size:var(--size-s);color:var(--soft)}
.tabs{display:flex;gap:2px;margin-left:auto}
.tabs button{padding:6px 14px;border-radius:999px;color:var(--soft);font-size:var(--size-s);transition:background var(--t),color var(--t)}
.tabs button:hover{color:var(--ink)}
.tabs button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.quiet{padding:6px 12px;border-radius:999px;font-size:var(--size-s);color:var(--soft);transition:color var(--t),background var(--t)}
.quiet:hover{color:var(--ink);background:var(--well)}
.view{display:none;padding:var(--gap) 20px 44px}
.view.on{display:block}
/* the state of a component: three small bars (drawn, validated, built), one ink, no colour code to learn */
.meter{display:inline-flex;gap:3px;vertical-align:middle;flex:none}
.meter i{width:13px;height:4px;border-radius:2px;background:var(--line)}
.meter i.on{background:var(--ink)}
.meter i.half{background:linear-gradient(90deg,var(--ink) 50%,var(--line) 50%)}
/* the project, shown as a project */
.proj{display:grid;gap:12px}
.cover{display:block;width:100%;aspect-ratio:16/9;border-radius:var(--radius-s);overflow:hidden;background:#3a3b40}
.cover img{width:100%;height:100%;object-fit:cover;display:block}
.proj h1{margin:0;font-size:var(--project);font-weight:500;letter-spacing:-.02em;line-height:1}
.proj p{margin:4px 0 0;color:var(--soft);font-size:var(--size-s)}
.prog{display:flex;height:5px;border-radius:999px;overflow:hidden;background:var(--line);gap:2px}
.prog i{display:block;height:100%;background:var(--ink)}
.prog i.b{opacity:.55}.prog i.c{opacity:.25}
.legend{display:flex;flex-wrap:wrap;gap:2px 12px;font-size:var(--size-xs);color:var(--soft)}
/* ---------- Planche ---------- */
.bench{display:grid;grid-template-columns:var(--side) minmax(0,1fr);gap:var(--gap);align-items:start}
.side{position:sticky;top:60px;max-height:calc(100vh - 76px);overflow:auto;padding:14px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius)}
.side input{width:100%;padding:7px 11px;border-radius:var(--radius-s);border:1px solid transparent;background:var(--well);margin:14px 0 4px;outline:none;font-size:var(--size-s);transition:border-color var(--t)}
.side input:focus{border-color:var(--accent)}
details.grp{margin-top:8px}
details.grp>summary{list-style:none;display:flex;align-items:center;gap:8px;padding:7px 6px;font-size:var(--size-s);font-weight:500;cursor:pointer;border-radius:var(--radius-s)}
details.grp>summary::-webkit-details-marker{display:none}
details.grp>summary::before{content:'';width:6px;height:6px;border-right:1.5px solid var(--soft);border-bottom:1.5px solid var(--soft);transform:rotate(-45deg);transition:transform var(--t)}
details.grp[open]>summary::before{transform:rotate(45deg)}
details.grp>summary span{margin-left:auto;color:var(--faint);font-weight:400;font-size:var(--size-xs)}
.item{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;padding:6px 8px 6px 22px;border-radius:var(--radius-s);font-size:var(--size-s);color:var(--soft);transition:background var(--t),color var(--t)}
.item:hover{background:var(--well);color:var(--ink)}
.item[aria-current="true"]{background:var(--ink);color:var(--bg)}
.item[aria-current="true"] .meter i{background:color-mix(in srgb,var(--bg) 28%,transparent)}
.item[aria-current="true"] .meter i.on{background:var(--bg)}
.item[aria-current="true"] .meter i.half{background:linear-gradient(90deg,var(--bg) 50%,color-mix(in srgb,var(--bg) 28%,transparent) 50%)}
.sheet{display:grid;gap:var(--gap)}
.hd{display:flex;flex-wrap:wrap;align-items:flex-end;gap:10px 22px}
.hd .crumb{width:100%;color:var(--soft);font-size:var(--size-s);margin-bottom:-4px}
.hd h2{margin:0;font-size:var(--h1);font-weight:500;letter-spacing:-.02em;line-height:1.05}
.steps{display:flex;gap:18px;padding-bottom:5px;font-size:var(--size-s);color:var(--faint)}
.steps span{display:flex;align-items:center;gap:7px}
.steps span::before{content:'';width:8px;height:8px;border-radius:50%;border:1.5px solid var(--faint)}
.steps span.on{color:var(--ink)}
.steps span.on::before{background:var(--ink);border-color:var(--ink)}
.steps span.half{color:var(--ink)}
.steps span.half::before{border-color:var(--ink);background:linear-gradient(90deg,var(--ink) 50%,transparent 50%)}
.hd .right{margin-left:auto;display:flex;align-items:center;gap:6px;padding-bottom:1px}
.btn{padding:8px 16px;border-radius:999px;background:var(--ink);color:var(--bg);font-size:var(--size-s);transition:opacity var(--t),transform var(--t)}
.btn:hover{opacity:.85}.btn:active{transform:scale(.97)}
.seg{display:inline-flex;padding:2px;border-radius:999px;background:var(--well)}
.seg button{padding:5px 12px;border-radius:999px;font-size:var(--size-xs);color:var(--soft);transition:background var(--t),color var(--t)}
.seg button[aria-pressed="true"]{background:var(--panel);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08)}
.more{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px 18px;display:none;font-size:var(--size-s);color:var(--soft)}
.more.on{display:grid;gap:8px;animation:rise var(--t) both}
.more b{color:var(--ink);font-weight:500}
.more .acts{display:flex;flex-wrap:wrap;gap:6px}
.more .acts button{padding:5px 12px;border-radius:999px;background:var(--well);font-size:var(--size-xs);color:var(--ink)}
.five{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:var(--tile-gap)}
.five .lab{font-size:var(--size-s);color:var(--soft);padding:0 2px 2px;display:flex;justify-content:space-between}
.five .lab em{font-style:normal;color:var(--faint);font-size:var(--size-xs)}
.cell{display:block;width:100%;aspect-ratio:var(--cell);border-radius:var(--radius-s);overflow:hidden;background:var(--well);transition:transform var(--t),box-shadow var(--t)}
.cell.bp{background:var(--blue)}
.cell img{width:100%;height:100%;object-fit:contain;display:block}
button.cell:hover{transform:translateY(-2px);box-shadow:var(--lift)}
.cell.none{display:flex;align-items:center;justify-content:center;background:none;border:1px dashed var(--line);color:var(--faint);font-size:var(--size-xs)}
.col{display:grid;gap:var(--tile-gap);align-content:start}
.strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--gap)}
.box{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px;min-width:0}
.box h3{margin:0 0 10px;font-size:var(--h2);font-weight:500}
.box .pic{display:block;width:100%;aspect-ratio:16/9;border-radius:var(--radius-s);overflow:hidden;background:#161616;transition:transform var(--t)}
.box .pic:hover{transform:scale(1.01)}
.box .pic img{width:100%;height:100%;object-fit:cover;display:block}
.tl{list-style:none;margin:0;padding:0;display:grid;gap:7px;font-size:var(--size-s)}
.tl li{display:flex;gap:10px}
.tl time{color:var(--faint);white-space:nowrap;min-width:38px}
.empty{color:var(--faint);font-size:var(--size-s);margin:0}
/* ---------- Chantiers: a gallery, group after group ---------- */
.band{display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px;margin-bottom:8px}
.band .cover{width:176px;flex:none}
.band h1{margin:0;font-size:44px;font-weight:500;letter-spacing:-.025em;line-height:1}
.band .n{color:var(--soft);font-size:var(--size-s);margin:6px 0 9px}
.band .prog{width:240px}
.band .aside{margin-left:auto;display:grid;gap:8px;justify-items:end;max-width:100%}
.gh{display:flex;align-items:baseline;gap:12px;margin:26px 2px 12px}
.gh h3{margin:0;font-size:22px;font-weight:500;letter-spacing:-.01em}
.gh span{color:var(--soft);font-size:var(--size-s)}
.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:var(--gap)}
.gc{display:block;width:100%;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:transform var(--t),box-shadow var(--t);animation:rise var(--t) both;animation-delay:calc(min(var(--i),14) * 16ms)}
.gc:hover{transform:translateY(-3px);box-shadow:var(--lift)}
.gc .main{display:grid;grid-template-columns:1fr 1fr;gap:3px;padding:3px 3px 0;background:var(--well)}
.gc .main span{display:block;aspect-ratio:var(--cell);overflow:hidden;border-radius:6px;background:var(--well)}
.gc .main span.bp{background:var(--blue)}
.gc .main img{width:100%;height:100%;object-fit:contain;display:block;transition:transform var(--t)}
.gc:hover .main img{transform:scale(1.04)}
.gc .thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;padding:3px;background:var(--well)}
.gc .thumbs span{display:block;aspect-ratio:var(--cell);border-radius:4px;overflow:hidden;background:var(--panel)}
.gc .thumbs span.no{background:none;border:1px dashed var(--line)}
.gc .thumbs img{width:100%;height:100%;object-fit:contain;display:block}
.gc .ft{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 13px 12px}
.gc .ft b{font-weight:500}
/* ---------- Chronologie: hour after hour, pictures first ---------- */
.filters{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}
.filters button{padding:6px 14px;border-radius:999px;font-size:var(--size-s);color:var(--soft);background:var(--panel);border:1px solid var(--line);transition:background var(--t),color var(--t),border-color var(--t)}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.hour{display:grid;grid-template-columns:76px minmax(0,1fr);gap:var(--gap);margin-top:22px}
.hour>time{position:sticky;top:64px;align-self:start;font-size:26px;font-weight:500;letter-spacing:-.02em;line-height:1}
.hour>time small{display:block;font-size:var(--size-xs);font-weight:400;color:var(--soft);letter-spacing:0;margin-top:5px}
.feed{display:grid;grid-template-columns:repeat(auto-fill,minmax(430px,1fr));gap:12px}
.ec{display:grid;grid-template-columns:124px 124px minmax(0,1fr);gap:6px;align-items:center;width:100%;padding:6px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);transition:transform var(--t),box-shadow var(--t);animation:rise var(--t) both;animation-delay:calc(min(var(--i),14) * 16ms)}
.ec>span:last-child{padding-left:9px}
.ec:hover{transform:translateY(-2px);box-shadow:var(--lift)}
.ec .th{display:block;aspect-ratio:var(--cell);border-radius:var(--radius-s);overflow:hidden;background:var(--well)}
.ec .th.bp{background:var(--blue)}
.ec .th img{width:100%;height:100%;object-fit:contain;display:block}
.ec b{font-weight:500;display:block}
.ec .g{color:var(--faint);font-size:var(--size-xs);display:block}
.ec .ls{display:block;margin-top:5px;font-size:var(--size-s);color:var(--soft)}
.ec .ls span{display:block}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
/* ---------- lightbox, toast ---------- */
.light{position:fixed;inset:0;z-index:60;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.88);padding:24px;cursor:zoom-out;opacity:0;pointer-events:none;transition:opacity var(--t)}
.light.on{opacity:1;pointer-events:auto}
.light img{max-width:100%;max-height:100%;border-radius:8px}
.toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);opacity:0;background:var(--ink);color:var(--bg);padding:9px 16px;border-radius:999px;font-size:var(--size-s);transition:opacity var(--t),transform var(--t);z-index:70;pointer-events:none;max-width:92vw}
.toast.on{opacity:1;transform:translate(-50%,0)}
.fallback{width:100%;min-height:70px;padding:10px;border-radius:var(--radius-s);border:1px solid var(--line);background:var(--well);font-family:var(--mono);font-size:12px}
@media (max-width:1100px){.five{grid-template-columns:repeat(3,minmax(0,1fr))}.strip{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
@media (max-width:760px){.top{padding:9px 16px}.tabs{margin-left:0;width:100%}.tabs button{flex:1;text-align:center;padding:6px 4px}.view{padding:14px 16px 40px}.bench,.band{grid-template-columns:minmax(0,1fr)}.side{position:static;max-height:none}.five{grid-template-columns:repeat(2,minmax(0,1fr))}.strip{grid-template-columns:minmax(0,1fr)}.hd h2{font-size:26px}.hd .right{margin-left:0;width:100%;flex-wrap:wrap}.steps{gap:12px;flex-wrap:wrap}.hour{grid-template-columns:minmax(0,1fr);gap:8px}.hour>time{position:static}.feed{grid-template-columns:minmax(0,1fr)}.ec{grid-template-columns:84px 84px minmax(0,1fr)}.gal{grid-template-columns:minmax(0,1fr);gap:12px}.band h1{font-size:34px}.band .cover{width:120px}.band .aside{margin-left:0;justify-items:start}}
@media (prefers-reduced-motion: reduce){*{transition:none !important;animation:none !important}}
:root.still *{transition:none !important;animation:none !important}
</style>
</head>
