    }).join('') + '</div></div>';
  }
  document.getElementById('view-c').innerHTML = h;
}
function toast(t){ const el = document.getElementById('toast'); el.textContent = t; el.classList.add('on'); clearTimeout(toast.t); toast.t = setTimeout(() => el.classList.remove('on'), 1700); }
async function copy(text){
  try { await navigator.clipboard.writeText(text); toast('Copié : à coller dans une conversation'); }
  catch (e) { more = true; renderSheet(); const host = document.querySelector('.more'); const ta = document.createElement('textarea'); ta.className = 'fallback'; ta.readOnly = true; host.appendChild(ta); ta.value = text; ta.focus(); ta.select(); toast('Copie impossible ici : le texte est sélectionné'); }
}
function show(v){
  if (!['a', 'b', 'c'].includes(v)) v = 'a';
  for (const b of document.querySelectorAll('.tabs button')) b.setAttribute('aria-pressed', b.dataset.view === v);
  for (const s of document.querySelectorAll('.view')) s.classList.toggle('on', s.id === 'view-' + v);
  store.set('zrb3d-view', v);
  if (v === 'b') renderB(); if (v === 'c') renderC();                    // drawn when shown: the cards come in
  window.scrollTo(0, 0);
}
document.addEventListener('click', e => {
  const t = e.target.closest('[data-view],[data-open],[data-copy],[data-zoom],[data-wide],[data-filter],[data-mode],[data-more]');
  if (!t) return;
  if (t.dataset.view) return show(t.dataset.view);
  if (t.dataset.copy) return copy(t.dataset.copy);
  if (t.dataset.zoom || t.dataset.wide){ const l = document.getElementById('light'); l.querySelector('img').src = t.dataset.zoom ? IMG[t.dataset.zoom] : WIDE[t.dataset.wide]; return l.classList.add('on'); }
  if (t.dataset.filter){ filter = t.dataset.filter; return renderC(); }
  if (t.dataset.mode){ mode = t.dataset.mode; store.set('zrb3d-mode', mode); return renderSheet(); }
  if (t.dataset.more){ more = !more; return renderSheet(); }
  if (t.dataset.open){ current = t.dataset.open; more = false; store.set('zrb3d-component', current); renderSide(); renderSheet(); if (t.dataset.go) show(t.dataset.go); }
});
document.getElementById('light').addEventListener('click', e => e.currentTarget.classList.remove('on'));
document.addEventListener('keydown', e => { if (e.key === 'Escape') document.getElementById('light').classList.remove('on'); });
const cycle = (key, list, labels, apply) => { const el = document.getElementById(key); const set = v => { if (!list.includes(v)) v = list[0]; apply(v); el.textContent = labels[v]; store.set('zrb3d-' + key, v); }; el.addEventListener('click', () => set(list[(list.indexOf(store.get('zrb3d-' + key, list[0])) + 1) % list.length])); set(new URLSearchParams(location.search).get(key) || store.get('zrb3d-' + key, list[0])); };
cycle('theme', ['auto', 'light', 'dark'], {auto: 'Thème : auto', light: 'Thème : clair', dark: 'Thème : sombre'}, v => v === 'auto' ? document.documentElement.removeAttribute('data-theme') : document.documentElement.setAttribute('data-theme', v));
cycle('palette', ['neutre', 'encre', 'papier'], {neutre: 'Couleurs : neutre', encre: 'Couleurs : encre', papier: 'Couleurs : papier'}, v => document.documentElement.setAttribute('data-palette', v));
if (new URLSearchParams(location.search).has('still')) document.documentElement.classList.add('still');
const open0 = new URLSearchParams(location.search).get('open'); if (open0 && byId(open0)) current = open0;
renderSide(); renderSheet(); show(location.hash.slice(1) || store.get('zrb3d-view', 'a'));
</script>
</body>
