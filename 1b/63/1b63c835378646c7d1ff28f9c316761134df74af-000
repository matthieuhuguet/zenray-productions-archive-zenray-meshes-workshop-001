"""5 November 2026 : build a fit json into one obj with the pure numpy builder (no Houdini), mirrors included. FR : construit un json d'ajustement en un obj avec le constructeur numpy, sans Houdini.
Usage : python PyBuild.py fit.json out.obj"""
import sys, os, json
import numpy as np
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import DragonShape as DS
D = json.load(open(sys.argv[1])); V, F, off = [], [], 0
for t in D["tubes"]:
    v, f = DS.tube_mesh(t); V.append(v); F.append(f + off); off += len(v)
    if t.get("mirror"): v2 = v.copy(); v2[:, 0] = -v2[:, 0]; V.append(v2); F.append(f[:, ::-1] + off); off += len(v2)
V = np.vstack(V); F = np.vstack(F)
with open(sys.argv[2], "w") as o:
    for p in V: o.write("v %.5f %.5f %.5f\n" % tuple(p))
    for t in F: o.write("f %d %d %d\n" % tuple(t + 1))
print(len(V), len(F))
