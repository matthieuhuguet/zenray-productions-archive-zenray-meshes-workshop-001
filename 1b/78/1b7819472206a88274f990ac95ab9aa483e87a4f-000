# 29 October 2026 : ZenRay Lines HOUDINI, the constrained quad remesh of the component surface, run inside Houdini (MCP houdini_hom).
# EN: builds /obj/ZRL_Car : load the embedded surface (work/lines/embed.npz : faces, region per face) on the left half, mirror it
# (exact symmetry), mark the line edges (two faces of different regions) and the opening borders as constrained edges, quad remesh
# with the lines held, transfer the region to every quad, write work/lines/car_<tag>.npz (P, Q, region, region names).
# FR : remaillage quad contraint par les lignes dans Houdini ; chaque quad garde son component ; symétrie exacte par miroir.
# Use : exec(open(this).read()); result = build(tag="v001", quad_m=0.025)
import json, os, time
import numpy as np
import hou

ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
PARAMS = {   # 29 October 2026 : the interface of the Houdini pass, one place
    "embed": f"{ROOT}/work/lines/mbo.npz", "obj": f"{ROOT}/work/lines/mbo_left.obj", "half_margin_m": 0.02, "quad_m": 0.025, "net": "/obj/ZRL_Car",
    "curvature_weight": 1.0, "adaptivity": 0.0, "decimation_level": 2,
}

LOAD_CODE = r'''
# 29 October 2026 : load the left half of the embedded component surface (numpy -> Houdini, one call per array)
import numpy as np
geo = hou.pwd().geometry()
d = np.load(hou.pwd().parm("embed_path").eval(), allow_pickle=True)
V, F, reg = d["V"], d["F"], d["region"].astype(np.int32)
m = hou.pwd().parm("half_margin").eval()
keep = (V[F][:, :, 0] >= -m).all(1); F = F[keep]; reg = reg[keep]
used = np.unique(F); remap = -np.ones(len(V), np.int64); remap[used] = np.arange(len(used)); V = V[used]; F = remap[F]
geo.createPoints(V.astype(np.float64).tolist())
geo.createPolygons(F.tolist(), True)
geo.addAttrib(hou.attribType.Prim, "region", 0)
geo.setPrimIntAttribValuesFromString("region", reg.astype(np.int32).tobytes(), hou.numericData.Int32)
'''

GROUP_VEX = r'''
// 29 October 2026 : an edge between two faces of different components is a line : constrained ; borders (openings) too
int h0 = primhedge(0, @primnum); int h = h0;
do {
    int e = hedge_nextequiv(0, h); int o = hedge_prim(0, e);
    int p0 = hedge_srcpoint(0, h), p1 = hedge_dstpoint(0, h);
    if (e == h || o < 0) setedgegroup(0, "constrained", p0, p1, 1);
    else if (prim(0, "region", o) != i@region) setedgegroup(0, "constrained", p0, p1, 1);
    h = hedge_next(0, h);
} while (h != h0);
'''

EXPORT_CODE = r'''
# 29 October 2026 : write the quad car to numpy (points, polygons, region per polygon)
import numpy as np
geo = hou.pwd().geometry()
P = np.array(geo.pointFloatAttribValues("P"), np.float64).reshape(-1, 3)
polys = [tuple(v.point().number() for v in pr.vertices()) for pr in geo.prims()]
n = np.array([len(p) for p in polys]); reg = np.array(geo.primIntAttribValues("region"), np.int64)
Q = np.array([p if len(p) == 4 else (p + (p[-1],) * 4)[:4] for p in polys], np.int64)
np.savez(hou.pwd().parm("out_path").eval(), P=P, Q=Q, nverts=n, region=reg, region_names=np.load(hou.pwd().parm("embed_path").eval(), allow_pickle=True)["region_names"])
'''


REGION_VEX = r'''
// 29 October 2026 : the OBJ group r_<id> of every face becomes its component id
string gs[] = detailintrinsic(0, "primitivegroups"); i@region = -1;
foreach (string g; gs) { if (startswith(g, "r_") && inprimgroup(0, g, @primnum)) { i@region = atoi(g[2:]); break; } }
'''

MISSING = []


def setp(node, name, value):
    p = node.parm(name)
    if p is None: MISSING.append(f"{node.name()}.{name}"); return
    p.set(value)


def _python_sop(parent, name, code, parms):
    n = parent.createNode("python", name)
    tg = n.parmTemplateGroup()
    for k, v in parms.items():
        tg.append(hou.StringParmTemplate(k, k, 1, default_value=(str(v),)) if isinstance(v, str) else hou.FloatParmTemplate(k, k, 1, default_value=(float(v),)))
    n.setParmTemplateGroup(tg); n.parm("python").set(code)
    return n


def build(tag="v001", quad_m=None, prm=PARAMS, cook=True):
    """29 October 2026 : creates /obj/ZRL_Car ; cook=False only builds the network (the cook can outlast the bridge timeout)."""
    quad_m = quad_m or prm["quad_m"]; out = f"{ROOT}/work/lines/car_{tag}.npz"; MISSING.clear()
    old = hou.node(prm["net"])
    if old: old.destroy()
    g = hou.node("/obj").createNode("geo", prm["net"].split("/")[-1])
    fl = g.createNode("file", "load_left_half"); setp(fl, "file", prm["obj"])
    rg = g.createNode("attribwrangle", "region_from_groups"); rg.setInput(0, fl); setp(rg, "class", "primitive"); setp(rg, "snippet", REGION_VEX)
    clip = g.createNode("clip", "clip_left_half"); clip.setInput(0, rg)
    clip.parmTuple("dir").set((1, 0, 0)) if clip.parmTuple("dir") else MISSING.append("clip.dir"); setp(clip, "dist", 0.0); setp(clip, "clipop", "above")
    mir = g.createNode("mirror", "mirror_right"); mir.setInput(0, clip)
    mir.parmTuple("dir").set((1, 0, 0)) if mir.parmTuple("dir") else MISSING.append("mirror.dir"); setp(mir, "consolidatepts", 1)
    grp = g.createNode("attribwrangle", "constrained_lines"); grp.setInput(0, mir); setp(grp, "class", "primitive"); setp(grp, "snippet", GROUP_VEX)
    qr = g.createNode("quadremesh", "quad_remesh"); qr.setInput(0, grp)
    setp(qr, "resolution", 1); setp(qr, "targetquadarea", quad_m * quad_m); setp(qr, "constrainededgesgroup", "constrained")
    setp(qr, "featureboundaries", 1); setp(qr, "xaxis", 1); setp(qr, "mirroroutput", 1); setp(qr, "enableadaptivity", 0)
    tr = g.createNode("attribtransfer", "region_to_quads"); tr.setInput(0, qr); tr.setInput(1, grp)
    setp(tr, "primitiveattribs", 1); setp(tr, "primattriblist", "region"); setp(tr, "pointattribs", 0)
    ex = _python_sop(g, "export_numpy", EXPORT_CODE, {"embed_path": prm["embed"], "out_path": out}); ex.setInput(0, tr)
    ex.setDisplayFlag(True); ex.setRenderFlag(True); g.layoutChildren()
    info = {"missing_parms": list(MISSING), "out": out}
    if cook:
        t0 = time.time()
        for n in (fl, rg, clip, mir, grp, qr, tr, ex):
            t = time.time(); geo = n.geometry(); info[n.name()] = {"s": round(time.time() - t, 2), "points": len(geo.points()), "prims": len(geo.prims()), "errors": list(n.errors())[:2], "warnings": list(n.warnings())[:2]}
        info["total_s"] = round(time.time() - t0, 1)
    return info
