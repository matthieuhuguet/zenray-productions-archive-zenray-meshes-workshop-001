"""2 November 2026 : the final Dracard scene : the node chains of every part (TubeBuild), then the sculpted and smoothed whole as a green File node, displayed. The chains stay editable, the sculpt is the last layer, as in the series. FR : la scène finale de Dracard : les chaînes de nodes de chaque pièce, puis l'ensemble sculpté et lissé en node File vert, affiché. Les chaînes restent modifiables, le sculpt est la dernière couche, comme dans la série.
    hython FinalScene.py <Tubes.hip> <sculpted.obj> <out.hip>"""
import sys, json
import hou
tubes, sculpted, out = sys.argv[1:4]; hou.hipFile.load(tubes, suppress_save_prompt=True); geo = [n for n in hou.node("/obj").children() if n.type().name() == "geo"][0]; f = geo.createNode("file", "file_sculpted_whole"); f.parm("file").set(sculpted); f.setColor(hou.Color((0.2, 0.7, 0.25))); o = geo.createNode("null", "OUT_DRACARD"); o.setInput(0, f); o.setColor(hou.Color((0.2, 0.7, 0.25))); o.setDisplayFlag(True); o.setRenderFlag(True); geo.layoutChildren(); g = o.geometry(); hou.hipFile.save(out)
print(json.dumps(dict(scene=out, points=len(g.points()), polygons=len(g.prims()), quads=round(sum(len(p.vertices()) == 4 for p in g.prims()) / max(len(g.prims()), 1), 4), nodes=len(geo.children()), errors=[n.path() for n in geo.children() if n.errors()])))
