import sys
from PIL import Image, ImageDraw, ImageFont
C = '/Users/zenray/.claude/tmp/tmp-zenray-meshes/Projects/12_Car2Cage/04_checks/'
tag, title = sys.argv[1], sys.argv[2]
r = Image.open(C + 'tyre_T_001_ref_only.png').convert('RGB'); t = Image.open(C + tag + '_side.png').convert('RGB'); p = Image.open(C + tag + '_persp_wire.png').convert('RGB')
W = 600; ims = [x.resize((W, W)) for x in (r, Image.blend(r, t, 0.5), t, p)]
