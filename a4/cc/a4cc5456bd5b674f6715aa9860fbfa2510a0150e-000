for i, (im, lab) in enumerate(zip(ims, ['Référence (vue de profil)', 'Modèle sur la référence, fondu 50 %', 'Modèle sur la référence', title])):
    s.paste(im, (10 + i * (W + 10), 60)); d.text((10 + i * (W + 10), 20), lab, fill=(11, 11, 11), font=fnt)
s.save(C + tag + '_board.png'); print(C + tag + '_board.png')
