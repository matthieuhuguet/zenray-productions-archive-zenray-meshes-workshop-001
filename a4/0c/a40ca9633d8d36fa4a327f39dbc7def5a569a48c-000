"""28 October 2026 : ZenRay Meshes FENDER NET, the front fender as a PatchNet instance (task T4 : a ring of quads that follows the arch).
Curves : door cut, sill, hood seam (top), front edge and front bottom edge, taken from the coarse FenderPatch3 sheet and laid on the sculpt
(normal offset smoothed along the curve) ; the shoulder crease (sharp) ; the arch lip (sharp, x of the arch part) ; a ring of ring_w
around the lip with its support row at support_m ; two vertical spokes from the ring to the crease at spoke_deg. Five four sided
patches : RING, A (rear), B (over the arch), C (front), D (above the crease). Then R07 (PatchNet.fit), the 2.5 mm shell, the mirror.
python FenderNet.py [--out work/car/retopo/fender/fendernet.npz]   FR : l'aile en réseau de patchs, anneau autour de l'arche."""
import argparse, json, os, sys
import numpy as np
from scipy.ndimage import gaussian_filter1d
from scipy.spatial import cKDTree
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import Common as C
import RetopoMethods as M
from PatchNet import Net

PARAMS = {   # 28 October 2026 : the interface of the fender net
    "spacing_m": 0.025, "ring_w": 0.05, "support_m": 0.012, "y_sill": 0.27,
    "contour_sigma": 3.0, "side_x_radius": 0.008, "side_x_sigma": 4.0, "lambda": 8.0, "iters": 5, "schematic_crease": False,   # 28 October 2026 : off, the nearest traced line was the arch lip, not the crease
}


def add_fender(net):
    """Adds the fender nodes, edges and patches to a Net ; returns the helpers (side_x, lay, crease, door, ...) for the neighbours (28 October 2026)."""
    S = C.sculpt(); Pt, gs = M.grids(C.RT + "fender/sheet_coarse.npz"); Qt = [q for g in gs for q in M.quads_from_grid(g["G"])]
    NT = C.vnormals(Pt, Qt); proj = S.project(Pt, nref=NT); off = ((proj - Pt) * NT).sum(1)
    cz, cy, R, xarch = np.load(C.RT + "fender/sheet_coarse.npz")["arch"]; w = PARAMS["ring_w"]; ys = PARAMS["y_sill"]

    def lay(ids):   # template chain laid on the sculpt : normal offset smoothed along the chain
        o = gaussian_filter1d(off[ids], PARAMS["contour_sigma"], mode="nearest") if len(ids) > 3 else off[ids]
        return Pt[ids] + o[:, None] * NT[ids]

    m = S.P[:, 0] > 0.3; kd2 = cKDTree(S.P[m][:, 1:3]); SX = S.P[m][:, 0]
    def side_x(y, z):
        out_ = []
        for yy, zz in zip(np.atleast_1d(y), np.atleast_1d(z)):
            k = []; r_ = PARAMS["side_x_radius"]
            for _ in range(4):   # widen the search (x2, three times) before giving up (28 October 2026)
                k = kd2.query_ball_point([yy, zz], r_)
                if k: break
                r_ *= 2
            out_.append(SX[k].max() if k else np.nan)
        x = np.array(out_); ok = ~np.isnan(x)
        if not ok.any(): raise ValueError("side_x : no sculpt skin near y %.3f z %.3f (outside the sculpt crop ?)" % (float(np.atleast_1d(y)[0]), float(np.atleast_1d(z)[0])))
        if (~ok).any(): x[~ok] = np.interp(np.nonzero(~ok)[0], np.nonzero(ok)[0], x[ok])
        return gaussian_filter1d(x, PARAMS["side_x_sigma"], mode="nearest") if len(x) > 5 else x

    G0, G1, G2 = gs[0]["G"], gs[1]["G"], gs[2]["G"]; c0, c1, c2 = gs[0]["crease"], gs[1]["crease"], gs[2]["crease"]
    door = lay(G0[0, :]); front = lay(G2[-1, :]); sill = lay(G0[:, 0]); fbot = lay(G2[:, 0])
    crease_ids = np.concatenate([G0[:, c0], G1[1:, c1], G2[1:, c2]]); crease = lay(crease_ids)
    if PARAMS["schematic_crease"]:   # 28 October 2026, KS2b-2 : the shoulder crease reads the traced ref line BEFORE XA, XC, LA, LC are computed from it
        sys.path.insert(0, os.path.join(os.path.dirname(HERE), "curverig")); import SchematicLines as SL
        crease, rep_ = SL.snap_polyline(crease, "left"); print(json.dumps({"fender_crease_schematic": rep_}), file=sys.stderr)
    top_ids = np.concatenate([G0[:, -1], G1[1:, -1], G2[1:, -1]]); top = lay(top_ids)
    # ring geometry in the side view (z, y), angle phi from +z toward +y (28 October 2026, layout v2 : the ring reaches the crease over the arch)
    def ring_pt(r, phi): return cz + r * np.cos(phi), cy + r * np.sin(phi)
    def arc(r, p0, p1, xfun, n=160):
        ph = np.linspace(p0, p1, n); z, y = ring_pt(r, ph); return np.stack([xfun(y, z), y, z], 1)
    def lipx(y, z):   # the fender skin 1 cm outside the lip
        ph = np.arctan2(np.asarray(y) - cy, np.asarray(z) - cz); zz, yy = ring_pt(R + 0.01, ph); return side_x(yy, zz)
    phr_in = np.pi + np.arcsin((cy - ys) / R); phr_out = np.pi + np.arcsin((cy - ys) / (R + w))
    zrri, _ = ring_pt(R, phr_in); zrro, _ = ring_pt(R + w, phr_out)
    ycr = lambda z: np.interp(z, crease[:, 2], crease[:, 1])
    ph = np.linspace(phr_out, 0.0, 4000); zz, yy = ring_pt(R + w, ph); above = yy > ycr(zz)
    if not above.any(): raise ValueError("the ring outer circle never reaches the crease : lower ring_w or use the spoke layout")
    iA = int(np.argmax(above)); iC = len(above) - 1 - int(np.argmax(above[::-1])); phA, phC = ph[iA], ph[iC]
    zA, yA = ring_pt(R + w, phA); zC, yC = ring_pt(R + w, phC)
    def crease_at(z): return np.array([np.interp(z, crease[:, 2], crease[:, k]) for k in range(3)])
    N = net.node
    N("dc_sill", door[0]); N("dc_crease", door[c0]); N("dc_top", door[-1])
    N("fr_bot", front[0]); N("fr_crease", front[c2]); N("fr_top", front[-1])
    N("rr_in", [lipx([ys], [zrri])[0], ys, zrri]); N("rr_out", [side_x([ys], [zrro])[0], ys, zrro])
    N("rf_in", [lipx([cy], [cz + R])[0], cy, cz + R]); N("rf_out", [side_x([cy], [cz + R + w])[0], cy, cz + R + w])
    N("XA", crease_at(zA)); N("XC", crease_at(zC))
    E = net.edge
    E("dc_lower", "dc_sill", "dc_crease", door[: c0 + 1], fixed=True); E("dc_upper", "dc_crease", "dc_top", door[c0:], fixed=True)
    E("fr_lower", "fr_bot", "fr_crease", front[: c2 + 1], fixed=True); E("fr_upper", "fr_crease", "fr_top", front[c2:], fixed=True)
    k = sill[:, 2] < zrro; E("sill", "dc_sill", "rr_out", np.vstack([sill[k], net.nodes["rr_out"]]), fixed=True)
    k = fbot[:, 2] > cz + R + w; E("fr_bottom", "rf_out", "fr_bot", np.vstack([net.nodes["rf_out"], fbot[k]]), fixed=True)
    rr = np.array([net.nodes["rr_out"] + (net.nodes["rr_in"] - net.nodes["rr_out"]) * s for s in (0, 1 - PARAMS["support_m"] / w, 1)])
    E("ring_rear_end", "rr_out", "rr_in", rr, fixed=True, samples=rr)
    rf = np.array([net.nodes["rf_in"] + (net.nodes["rf_out"] - net.nodes["rf_in"]) * s for s in (0, PARAMS["support_m"] / w, 1)])
    E("ring_front_end", "rf_in", "rf_out", rf, fixed=True, samples=rf)
    # 28 October 2026 : the ring is three patches ; its outer border bends where the ring meets the crease (XA, XC), so those points are
    # real corners joined to the lip by radial curves (a Coons side that bends in its middle folds the patch there : the pinch)
    zLA, yLA = ring_pt(R, phA); zLC, yLC = ring_pt(R, phC)
    N("LA", [lipx([yLA], [zLA])[0], yLA, zLA]); N("LC", [lipx([yLC], [zLC])[0], yLC, zLC])
    E("lip_r", "rr_in", "LA", arc(R, phr_in, phA, lipx), fixed=True, sharp=True); E("lip_t", "LA", "LC", arc(R, phA, phC, lipx), fixed=True, sharp=True)
    E("lip_f", "LC", "rf_in", arc(R, phC, 0.0, lipx), fixed=True, sharp=True)
    sm_ = PARAMS["support_m"]
    for nm, a_, b_ in (("radA", "LA", "XA"), ("radC", "LC", "XC")):
        A_, B_ = net.nodes[a_], net.nodes[b_]; d_ = np.linalg.norm(B_ - A_); sp = np.array([A_ + (B_ - A_) * t_ for t_ in (0.0, min(sm_ / max(d_, 1e-6), 0.45), 1.0)])
        E(nm, a_, b_, sp, samples=sp)
    E("out_rear", "rr_out", "XA", arc(R + w, phr_out, phA, side_x)); E("out_front", "XC", "rf_out", arc(R + w, phC, 0.0, side_x))
    cut = lambda z0, z1: crease[(crease[:, 2] > z0) & (crease[:, 2] < z1)]
    E("crease1", "dc_crease", "XA", np.vstack([net.nodes["dc_crease"], cut(door[c0, 2], zA), net.nodes["XA"]]), fixed=True, sharp=True)
    E("crease2", "XA", "XC", np.vstack([net.nodes["XA"], cut(zA, zC), net.nodes["XC"]]), fixed=True, sharp=True)
    E("crease3", "XC", "fr_crease", np.vstack([net.nodes["XC"], cut(zC, front[c2, 2]), net.nodes["fr_crease"]]), fixed=True, sharp=True)
    zc_ = float(np.load(C.W + "finish/hood_side_L.npy")[:, 2].min()); ic_ = int(np.argmin(np.abs(top[:, 2] - zc_)))   # the hood rear corner is a node : the top seam turns there (28 October 2026)
    N("cowl", top[ic_]); E("top_rear", "dc_top", "cowl", top[: ic_ + 1], fixed=True); E("top_front", "cowl", "fr_top", top[ic_:], fixed=True)
    # patches : S0 bottom (left to right), S1 right (bottom to top), S2 top (left to right), S3 left (bottom to top)
    net.patch("RING_R", ["lip_r"], ["radA"], ["out_rear"], ["-ring_rear_end"])
    net.patch("RING_T", ["lip_t"], ["radC"], ["crease2"], ["radA"])
    net.patch("RING_F", ["lip_f"], ["ring_front_end"], ["out_front"], ["radC"])
    net.patch("A", ["sill"], ["out_rear"], ["crease1"], ["dc_lower"])
    net.patch("C", ["fr_bottom"], ["fr_lower"], ["crease3"], ["-out_front"])
    net.patch("D", ["crease1", "crease2", "crease3"], ["fr_upper"], ["top_rear", "top_front"], ["dc_upper"])
    return {"side_x": side_x, "lay": lay, "crease": crease, "top": top, "door": door, "sill": sill, "c0": c0, "arch": (cz, cy, R)}


def main(out):
    net = Net(PARAMS["spacing_m"], PARAMS["support_m"]); add_fender(net)
    it = net.solve_counts(); P, Q = net.build(); X = net.fit(PARAMS["lambda"], PARAMS["iters"])
    C._CT = net.as_contours(); m_ = C.measure(X, Q)
    counts = {k: e["n"] for k, e in net.edges.items()}
    np.savez(out, P=X, Q=np.array(Q), P0=P); json.dump({"counts": counts, "iterations": it, "measure": m_}, open(out.replace(".npz", ".json"), "w"), indent=1)
    print(json.dumps({"faces": len(Q), "counts_iter": it, **{k: m_[k] for k in ("dev_p95_mm", "fair_p95_deg", "shading_ratio", "crease_on_edges", "weld_ready", "quads_pct", "irregular", "min_angle_p5")}}))
    return net, X, Q


if __name__ == "__main__":
    ap = argparse.ArgumentParser(); ap.add_argument("--out", default=C.RT + "fender/fendernet.npz"); a = ap.parse_args(); main(a.out)
