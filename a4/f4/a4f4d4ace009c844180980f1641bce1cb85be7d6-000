    {
      "name": "QuadWild (Reliable Feature-Line Driven Quad-Remeshing)",
      "family": "field-aligned, feature-driven patch layout + integer quantization",
      "year": 2021,
      "source_url": "https://github.com/nicopietroni/quadwild/",
      "license": "GPL-3.0 (DOCUMENTED)",
      "inputs": "triangle mesh OBJ/PLY; optional setup .txt (sharp_feature_thr dihedral angle, alpha regularity vs isometry, scaleFact quad size), optional .rosy cross field and .sharp edge list with convex/concave flag",
      "handles_organic": "yes (CoMISo optional, recommended for organic)",
      "handles_hardsurface": "yes, sharp features become patch boundaries by construction (DOCUMENTED)",
      "respects_feature_edges": "guaranteed as patch boundaries; border edges are sharp by default",
      "user_guidance": "sharp edge list, cross field file, quad size scale, regularity weight; no sketch guides",
      "output_quality": "semi-regular pure quads; authors report under 0.5 percent failure on Thingi10K (DOCUMENTED, author claim); valence 4 percent not published in the pages read",
      "failure_modes": "Gurobi required for the original quantization (build burden); result may differ from paper (README warning); NeurCross paper says QuadWild smooths away detail and its patching can create singularities at patch junctions and malformed quads on free-form models",
      "open_source": true,
      "applicability_to_ZenRayLines": "Closest published analogue of our pipeline (feature curves -> patches -> integer edge counts); its patch decomposition + quantization can serve as a concurrent in the per-component tournament and as a reference for the MILP side conditions."
    },
