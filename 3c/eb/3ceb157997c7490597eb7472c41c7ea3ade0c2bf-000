#!/bin/zsh
# 26 October 2026 : ZenRay Meshes, TOPOLOGY AUDIT of the built car : export the real polygons of OUT_car (ExportTopo.py,
# Houdini live) then the senior review (TopoCheck.py) : versions/Topo_<tag>.md, .json and _wire.png.
# FR : audit de topologie de la voiture construite, export Houdini puis juge.
# Usage: TopoAudit.sh <tag> [--no-board]
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; PY=/Users/zenray/.venvs/zenray-uv/bin/python; TAG=$1
cd $W
python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom "g={'SOP':'/obj/ZRM_Car/OUT_car','OUT':'$W/work/car/topo_$TAG.npz'}; exec(open('$W/Scripts/ExportTopo.py').read(), g); result=g['result']" live > /dev/null
# 26 October 2026: the DELIVERY file (what a buyer gets) : the polygons of OUT_car, the hood and decklid closed by a ladder of quads
# (cap_ladder) and a grouped polygon OBJ ; the judge and the senior review run on it. FR : fichier de livraison.
$PY -I Scripts/TopoFix.py work/car/topo_$TAG.npz work/car/delivery_$TAG.npz --nofix --split5 --cap=CAR_body_hood_C,CAR_body_decklid_C --obj=versions/ZenRayCar_$TAG.obj > /dev/null
# 27 October 2026: the hidden underbody is rebuilt as one clean sheet of quads (FloorRemesh.py, v471) ; the raw delivery is kept beside it and the OBJ is rewritten from the rebuilt file.
# FR : le plancher caché est reconstruit en une nappe de quads propres, la livraison brute est gardée à côté.
mkdir -p work/car/floor
cp work/car/delivery_$TAG.npz work/car/delivery_${TAG}_raw.npz
$PY -I Scripts/FloorRemesh.py work/car/delivery_${TAG}_raw.npz work/car/delivery_$TAG.npz --tol-mm 4 --min-div 3 --obj versions/ZenRayCar_$TAG.obj > work/car/floor/floor_$TAG.json
# 27 October 2026: the cleanup chain on the delivery (Scripts/CleanChain.sh : flatten, slide, regularise, flatten, each step guarded and capped from the anchor) ; the anchor is the file after the floor.
# FR : chaîne de nettoyage de la livraison (CleanChain.sh), l'ancre est le fichier après le plancher.
cp work/car/delivery_$TAG.npz work/car/delivery_${TAG}_floor.npz
zsh Scripts/CleanChain.sh $TAG
# 27 October 2026 13:44 Paris: independent NURBS panels replace only their named components after delivery polishing.
if [ -f work/car/assembly_guides.json ]; then
  cp work/car/delivery_$TAG.npz work/car/delivery_${TAG}_unguided.npz
  python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom "g={'CONFIG':'$W/work/car/assembly_guides.json','OUT':'$W/work/car/guided_$TAG.npz'}; exec(open('$W/Scripts/ExportGuidePanels.py').read(),g); result=g['result']" live > /dev/null
  $PY -I Scripts/ReplaceComponents.py work/car/delivery_${TAG}_unguided.npz work/car/guided_$TAG.npz work/car/delivery_$TAG.npz > work/car/floor/guides_$TAG.json
  cp work/car/delivery_$TAG.npz work/car/delivery_${TAG}_before_recess.npz
  $PY -I Scripts/LinerRecess.py work/car/delivery_${TAG}_before_recess.npz work/car/guided_$TAG.npz work/car/delivery_$TAG.npz --settings work/car/assembly_guides.json > work/car/floor/recess_$TAG.json
  $PY -I Scripts/AssemblyCheck.py work/car/delivery_$TAG.npz work/car/assembly_guides.json work/car/assembly_check_$TAG.json > work/car/floor/assembly_$TAG.json
  $PY -I Scripts/TopoFix.py work/car/delivery_$TAG.npz work/car/delivery_$TAG.npz --nofix --obj=versions/ZenRayCar_$TAG.obj > /dev/null
fi
$PY -I Scripts/TopoCheck.py work/car/delivery_$TAG.npz work/car/topo_params.json versions/Topo_$TAG $2
# 26 October 2026: the senior review gates (AnimReview.py) after the judge
$PY -I Scripts/AnimReview.py work/car/delivery_$TAG.npz work/car/topo_params.json work/car/wheel_params.json versions/Review_$TAG
$PY -I Scripts/ComponentScore.py $TAG $2 > /dev/null   # 26 October 2026: component completion (ComponentScore.py) after the review ; FR : complétion par composant
