#!/usr/bin/env python3
# 5 November 2026, 17:40 Europe/Paris: check shared axes without rescaling away generated-view contradictions.
import argparse
import hashlib
import json
from pathlib import Path

import numpy as np
from PIL import Image, ImageDraw
from scipy import ndimage


def foreground(image, crop):
    pixels = np.asarray(image.convert('RGB').crop(crop), dtype=float)
    gray = pixels.mean(axis=2)
    border = np.concatenate([pixels[:8].reshape(-1, 3), pixels[-8:].reshape(-1, 3),
                             pixels[:, :8].reshape(-1, 3), pixels[:, -8:].reshape(-1, 3)])
    background = np.median(border, axis=0)
    noise = np.median(np.abs(border - background), axis=0).max()
    threshold = max(8.0 * float(noise), 10.0)
    # Ignore black drafting labels/lines, then detach their antialiasing before selecting the object.
    mask = (np.max(np.abs(pixels - background), axis=2) > threshold) & (gray > 55)
    mask = ndimage.binary_opening(mask, iterations=2)
    labels, count = ndimage.label(mask)
    if count == 0:
        raise ValueError('No component separated from the background; supply explicit masks instead.')
    sizes = np.bincount(labels.ravel()); sizes[0] = 0
    mask = labels == sizes.argmax()
    mask = ndimage.binary_fill_holes(mask)
    return mask, {'background':background.tolist(), 'noiseMAD':float(noise), 'threshold':threshold,
                  'segmentation':'largest non-black contrast region, opened by 2 pixels; visual review required'}


def analyze_masks(masks, axes, tolerance, landmarks=None):
    dimensions = {}
    views = {}
    for name, mask in masks.items():
        y, x = np.where(mask)
        if not len(x):
            raise ValueError('Empty mask: ' + name)
        box = [int(x.min()), int(y.min()), int(x.max()) + 1, int(y.max()) + 1]
        views[name] = {'box':box, 'widthPx':box[2]-box[0], 'heightPx':box[3]-box[1]}
        for axis, size in zip(axes[name], [box[2]-box[0], box[3]-box[1]]):
            dimensions.setdefault(axis, []).append({'view':name, 'pixels':size})
    checks = []
    for axis, values in dimensions.items():
        if len(values) < 2:
            continue
        sizes = [v['pixels'] for v in values]
        deviation = (max(sizes)-min(sizes))/max(float(np.mean(sizes)),1)
        checks.append({'axis':axis, 'observations':values, 'relativeDeviation':deviation,
                       'consistentAtDeclaredTolerance':bool(deviation <= tolerance)})
    landmark_checks = []
    for landmark in landmarks or []:
        values = np.array(landmark['observations'], dtype=float)
        deviation = float(values.max() - values.min())
        landmark_checks.append({'name':landmark['name'], 'normalizedSpread':deviation,
                                'consistentAtDeclaredTolerance':bool(deviation <= tolerance)})
    return {'views':views, 'sharedAxes':checks, 'landmarks':landmark_checks,
            'axisTolerance':tolerance, 'commonScaleAssumed':True, 'perViewRescalingApplied':False,
            'axisConsistency':all(c['consistentAtDeclaredTolerance'] for c in checks) and bool(checks),
            'geometricIdentity':'NOT_PROVEN', 'styleAndDetailFidelity':'HUMAN_REVIEW_REQUIRED',
            'warning':'Matching extents do not prove shared geometry, matching details, camera calibration, or hidden surfaces.'}


def selftest():
    def rectangle(width,height):
        a=np.zeros((180,180),bool);a[20:20+height,20:20+width]=True;return a
    axes={'front':['X','Z'],'side':['Y','Z'],'top':['X','Y']}
    masks={'front':rectangle(80,120),'side':rectangle(50,120),'top':rectangle(80,50)}
    good=analyze_masks(masks,axes,.03)
    bad=analyze_masks({**masks,'top':rectangle(80,90)},axes,.03)
    notch=masks['front'].copy();notch[45:65,20:50]=False
    same_box=analyze_masks({**masks,'front':notch},axes,.03)
    landmarks=analyze_masks(masks,axes,.03,[{'name':'groove_A','observations':[.2,.48]}])
    assert good['axisConsistency'] and not bad['axisConsistency']
    assert same_box['axisConsistency'] and same_box['geometricIdentity']=='NOT_PROVEN'
    assert not landmarks['landmarks'][0]['consistentAtDeclaredTolerance']
    return {'positive':True,'stretchedTopRejected':True,'sameBoxDifferentDetailNotClaimedValid':True,
            'wrongLandmarkRejected':True}


def main():
    parser=argparse.ArgumentParser();parser.add_argument('config',nargs='?');parser.add_argument('--selftest',action='store_true')
    args=parser.parse_args()
    if args.selftest:
        print(json.dumps(selftest()));return
    if not args.config:
        parser.error('config is required')
    config_path=Path(args.config);cfg=json.loads(config_path.read_text());root=config_path.parent
    path=root/cfg['image'];image=Image.open(path);masks={};meta={}
    for name,view in cfg['views'].items():
        masks[name],meta[name]=foreground(image,view['crop'])
    result=analyze_masks(masks,{k:v['axes'] for k,v in cfg['views'].items()},cfg['axisTolerance'],cfg.get('landmarks'))
    result.update({'source':str(path),'sourceSha256':hashlib.sha256(path.read_bytes()).hexdigest(),
                   'segmentation':meta,'selftest':selftest()})
    out=root/cfg['output'];out.mkdir(exist_ok=True)
    result['status']='AXIS_CONTRADICTION' if not result['axisConsistency'] else 'AXES_COMPATIBLE_ONLY'
    for name,mask in masks.items():
        Image.fromarray(mask.astype('uint8')*255).save(out/(name+'-mask.png'))
    (out/'report.json').write_text(json.dumps(result,indent=2))
    print(json.dumps({'status':result['status'],'sharedAxes':result['sharedAxes'],'selftest':result['selftest']}))


if __name__=='__main__':main()
