"""2 November 2026 : a test of SculptForge on a part : one command line, the time it takes, and what it changes : silhouette, grey correlation, roughness (mean distance of a point to the mean of its neighbours), and the points moved. FR : un test de SculptForge sur une pièce : une ligne de commande, son temps, et ce qu'elle change : silhouette, gris, rugosité, points déplacés.
    python -I SfTest.py <name> "<sculptforge commands, with $IN and $OUT>" <in.obj> <extra parts obj,...> <frames folder> <cams.json> f1,f2,..."""
import sys, os, subprocess, time, shutil, json
import numpy as np
from scipy import sparse
CLI = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/tools/sculptforge/build/sculptforge-cli"; HERE = os.path.dirname(os.path.abspath(__file__)); PY = sys.executable
name, cmd, src, extra, frames, cams, views = sys.argv[1:8]; D = f"parts/sf/{name}"; os.makedirs(D, exist_ok=True); out = f"{D}/skin.obj"
def load(f):
    V, F = [], []
    for l in open(f):
        if l.startswith("v "): V.append([float(x) for x in l.split()[1:4]])
        elif l.startswith("f "): F.append([int(q.split("/")[0]) - 1 for q in l.split()[1:]])
    return np.array(V), F
def rough(V, F):
    n = len(V); r, c = [], []
    for f in F:
        for i, a in enumerate(f): r.append(a); c.append(f[(i + 1) % len(f)])
    A = sparse.coo_matrix((np.ones(len(r)), (r, c)), shape=(n, n)).tocsr(); A = ((A + A.T) > 0).astype(float); d = np.maximum(np.asarray(A.sum(1)).ravel(), 1)[:, None]; return float(np.linalg.norm(A @ V / d - V, axis=1).mean())
t0 = time.time(); p = subprocess.run([CLI, "-q", "-c", cmd.replace("$IN", os.path.abspath(src)).replace("$OUT", os.path.abspath(out))], capture_output=True, text=True, timeout=600); dt = time.time() - t0
if p.returncode or not os.path.exists(out): print("FAILED", p.returncode, p.stdout[-400:], p.stderr[-400:]); sys.exit(1)
V0, F0 = load(src); V1, F1 = load(out); print(f"{name}: {dt:.1f}s points {len(V0)} -> {len(V1)} faces {len(F0)} -> {len(F1)} roughness {rough(V0, F0):.5f} -> {rough(V1, F1):.5f}" + (f" moved max {np.linalg.norm(V1 - V0, axis=1).max():.4f} mean {np.linalg.norm(V1 - V0, axis=1).mean():.4f}" if len(V0) == len(V1) else ""))
w = open(f"{D}/part.obj", "w"); off = 0
for f in [out] + [x for x in extra.split(",") if x]:
    V, F = load(f)
    for v in V: w.write("v %f %f %f\n" % tuple(v))
    for q in F: w.write("f " + " ".join(str(i + 1 + off) for i in q) + "\n")
    off += len(V)
w.close(); shutil.copy(cams, f"{D}/cams.json"); r = subprocess.run([PY, "-I", f"{HERE}/PartBoard.py", D, frames, views, f"{D}/board.png", "--mask", "grey", "--tile", "480"], capture_output=True, text=True); print(" ", r.stdout.strip().splitlines()[-1][:120] if r.stdout.strip() else r.stderr[-300:])
