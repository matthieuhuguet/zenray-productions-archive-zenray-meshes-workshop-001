"""28 October 2026, 16:15 : ZenRay Meshes finishing, method A2 : PARAM GRID, a new clean quad shell for one panel, rebuilt on top of the frozen target.
1 outer skin of the target part = the largest face region bounded by sharp edges (> --sharp-deg) whose mean normal points up (or --skin-axis) ;
2 Tutte embedding of that skin on the unit square (boundary arc length on the 4 sides, 4 corners at the sharpest turns of the outline) ;
3 regular grid in (u, v) with counts = mean side length / --edge-m (even), mapped back to 3D by barycentric lookup ;
4 fairing : least squares tensor B-spline (cubic, --ctrl-u x --ctrl-v control points) of the mapped grid, border rows kept ;
5 inner skin offset by --thick along the normal, walls with --support loops. Same part name, closed shell, quads only.
python ParamGrid.py <target.npz> <part> <out.npz> [--edge-m 0.02] [--thick 0.012] [--ctrl-u 14] [--ctrl-v 8]
FR : grille paramétrique (Tutte) projetée sur la forme gelée, lissée par B-spline, coque fermée en quads.
"""
import argparse
import json
from collections import defaultdict

import numpy as np
import scipy.sparse as sp
import scipy.sparse.linalg as spl
from scipy.spatial import cKDTree


def part(npz, name):
    d = np.load(npz, allow_pickle=True); n = np.array([str(x) for x in d["names"]])
    return d["P"].astype(float), [list(map(int, q)) for q, m in zip(d["Q"], n) if m == name]


def fnormal(P, q):
    v = P[q]; nn = np.cross(v[2] - v[0], v[3 % len(q)] - v[1]); return nn / (np.linalg.norm(nn) + 1e-12)


def skin(P, Q, sharp, axis, sign=1.0):
    N = np.array([fnormal(P, q) for q in Q])
    ef = defaultdict(list)
    for i, q in enumerate(Q):
        for k in range(len(q)):
            a, b = q[k], q[(k + 1) % len(q)]; ef[(min(a, b), max(a, b))].append(i)
    cs = np.cos(np.radians(sharp)); lab = -np.ones(len(Q), int); c = 0
    for s in range(len(Q)):
        if lab[s] >= 0:
            continue
        st = [s]; lab[s] = c
        while st:
            f = st.pop(); q = Q[f]
            for k in range(len(q)):
                a, b = q[k], q[(k + 1) % len(q)]
                for g in ef[(min(a, b), max(a, b))]:
                    if lab[g] < 0 and N[f] @ N[g] > cs:
                        lab[g] = c; st.append(g)
        c += 1
    best = max(range(c), key=lambda k: ((lab == k).sum() * (N[lab == k].mean(0)[axis] * sign > 0.2)))
    return [Q[i] for i in np.flatnonzero(lab == best)]


def boundary_loop(P, S):
    cnt = defaultdict(int)
    for q in S:
        for k in range(len(q)):
            a, b = q[k], q[(k + 1) % len(q)]; cnt[(min(a, b), max(a, b))] += 1
    out = defaultdict(list)
    for q in S:
        for k in range(len(q)):
            a, b = q[k], q[(k + 1) % len(q)]
            if cnt[(min(a, b), max(a, b))] == 1:
                out[a].append(b)
    loops = []
    while any(out.values()):
        s0 = next(k for k, v in out.items() if v); loop = [s0]; c = out[s0].pop()
        while c != s0 and out[c]:
            loop.append(c); c = out[c].pop()
        loops.append(loop)
    return max(loops, key=lambda l: np.linalg.norm(np.diff(P[l + l[:1]], axis=0), axis=1).sum())


def bspline_basis(t, n_ctrl, deg=3):
    kn = np.concatenate([[0] * deg, np.linspace(0, 1, n_ctrl - deg + 1), [1] * deg])
    B = np.zeros((len(t), n_ctrl))
    for i in range(n_ctrl):
        c = np.zeros(n_ctrl); c[i] = 1
        from scipy.interpolate import BSpline
        B[:, i] = BSpline(kn, c, deg)(np.clip(t, 0, 1 - 1e-12))
    return B


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("target"); ap.add_argument("part"); ap.add_argument("out")
    ap.add_argument("--edge-m", type=float, default=0.02)
    ap.add_argument("--thick", type=float, default=0.012)
    ap.add_argument("--support", type=int, default=1)
    ap.add_argument("--sharp-deg", type=float, default=50.0)
    ap.add_argument("--skin-axis", type=int, default=1)
    ap.add_argument("--ctrl-u", type=int, default=14)
    ap.add_argument("--ctrl-v", type=int, default=8)
    ap.add_argument("--corners", default="plan")
    ap.add_argument("--skin-sign", type=float, default=1.0, help="-1 : the outer skin faces the negative axis (the tail faces -z, 28 October 2026)")
    ap.add_argument("--keep-border-rows", type=int, default=0, help="0 : the borders are smoothed too (section 215, 28 October 2026)")
    ap.add_argument("--border-per-m", type=float, default=0.0, help="control points per metre of the border splines on the target outline (0 : off)")
    ap.add_argument("--crease-deg", type=float, default=0.0)
    ap.add_argument("--crease-curve", default="")
    ap.add_argument("--crease-file", default="/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car/loft_params.json")
    ap.add_argument("--rotate", type=int, default=0)
    ap.add_argument("--crease-band", type=float, default=0.08)
    ap.add_argument("--pin-curve", default="")
    ap.add_argument("--pin-falloff", type=float, default=2.0)
    ap.add_argument("--pin-band", type=int, default=8)
    ap.add_argument("--pin-full", type=int, default=1)
    ap.add_argument("--nu", type=int, default=0)
    ap.add_argument("--nv", type=int, default=0)
    ap.add_argument("--fair", type=int, default=1)
    ap.add_argument("--sym", type=int, default=0, help="1 : average the grid with its x mirror (index flipped across), exact symmetry (28 October 2026)")
    a = ap.parse_args()
    P, Q = part(a.target, a.part)
    S = skin(P, Q, a.sharp_deg, a.skin_axis, a.skin_sign)
    loop = boundary_loop(P, S)
    L = P[loop]; m = len(L)
    if a.corners == "plan":   # plan extremes of +-x +-z (hood, roof, decklid) (28 October 2026)
        Lp = L[:, [0, 2]] if a.skin_axis == 1 else (L[:, [0, 1]] if a.skin_axis == 2 else L[:, [2, 1]])
        cor = [int(np.argmax(Lp @ np.array(w, float))) for w in ([1, 1], [1, -1], [-1, -1], [-1, 1])]
    else:
        tang = [(L[(i + 1) % m] - L[i]) for i in range(m)]
        turn = np.array([np.degrees(np.arccos(np.clip(np.dot(tang[i - 1], tang[i]) / (np.linalg.norm(tang[i - 1]) * np.linalg.norm(tang[i]) + 1e-12), -1, 1))) for i in range(m)])
        tw = sum(np.roll(turn, k) for k in range(-2, 3)); cor = []
        for i in np.argsort(-tw):
            if all(min(abs(i - j), m - abs(i - j)) > m // 8 for j in cor):
                cor.append(int(i))
            if len(cor) == 4:
                break
    cor.sort()
    if a.rotate:
        cor = cor[a.rotate:] + cor[:a.rotate]   # u along the other pair of sides (28 October 2026)
    # boundary parameters on the square
    seg = np.linalg.norm(np.diff(np.vstack([L, L[:1]]), axis=0), axis=1)
    uv = np.zeros((m, 2)); sq = [np.array(x, float) for x in ([0, 0], [1, 0], [1, 1], [0, 1])]
    sides = []
    for k in range(4):
        i0, i1 = cor[k], cor[(k + 1) % 4]
        ids = list(range(i0, i1 + 1)) if i1 > i0 else list(range(i0, m)) + list(range(0, i1 + 1))
        ln = np.concatenate([[0], np.cumsum([seg[i % m] for i in ids[:-1]])]); t = ln / ln[-1]
        for idx, tt in zip(ids, t):
            uv[idx] = sq[k] * (1 - tt) + sq[(k + 1) % 4] * tt
        sides.append(ln[-1])
    # Tutte on the skin vertices
    V = sorted({v for q in S for v in q}); r = {v: i for i, v in enumerate(V)}; nV = len(V)
    nb = defaultdict(set)
    for q in S:
        for k in range(len(q)):
            x, y = r[q[k]], r[q[(k + 1) % len(q)]]; nb[x].add(y); nb[y].add(x)
    bmap = {r[v]: uv[i] for i, v in enumerate(loop)}
    rows, cols, vals = [], [], []; rhs = np.zeros((nV, 2))
    for i in range(nV):
        if i in bmap:
            rows.append(i); cols.append(i); vals.append(1.0); rhs[i] = bmap[i]
        else:
            rows.append(i); cols.append(i); vals.append(float(len(nb[i])))
            for j in nb[i]:
                rows.append(i); cols.append(j); vals.append(-1.0)
    A = sp.csr_matrix((vals, (rows, cols)), shape=(nV, nV))
    UV = np.stack([spl.spsolve(A, rhs[:, 0]), spl.spsolve(A, rhs[:, 1])], 1)
    X = P[V]
    tris = np.array([[r[q[0]], r[q[k]], r[q[k + 1]]] for q in S for k in range(1, len(q) - 1)])
    nu = max(4, int(round((sides[0] + sides[2]) / 2 / a.edge_m / 2)) * 2)
    nv = max(4, int(round((sides[1] + sides[3]) / 2 / a.edge_m / 2)) * 2)
    if a.nu > 0: nu = a.nu
    if a.nv > 0: nv = a.nv
    gu, gv = np.meshgrid(np.linspace(0, 1, nu + 1), np.linspace(0, 1, nv + 1))
    krow = None
    if a.crease_curve:   # character line from the design curves of the sheet (loft_params row_y_target : [z, y] pairs), 28 October 2026
        import json as _j
        pts = np.array(_j.load(open(a.crease_file))["row_y_target"][a.crease_curve]["pts"], float)
        from scipy.spatial import cKDTree as _K
        kd2 = _K(X[:, [2, 1]]); dd, ii = kd2.query(pts)
        ok = dd < 0.03
        mids = UV[ii[ok]]
        if len(mids) >= 4:
            ax = 0 if np.ptp(mids[:, 0]) >= np.ptp(mids[:, 1]) else 1
            if ax == 1:
                print("crease runs along v : use --rotate")
            cf = np.polyfit(mids[:, 0], mids[:, 1], 2); vc = np.clip(np.polyval(cf, np.linspace(0, 1, nu + 1)), 0.05, 0.95)
            krow = int(round(np.median(vc) * nv)); krow = min(max(krow, 2), nv - 2)
            gv = np.array([np.concatenate([np.linspace(0, vc[i], krow + 1), np.linspace(vc[i], 1, nv - krow + 1)[1:]]) for i in range(nu + 1)]).T
            print("crease curve", a.crease_curve, "points", int(ok.sum()), "row", krow, "v", round(float(vc.min()), 3), round(float(vc.max()), 3))
    elif a.crease_deg > 0:   # character line : one grid row follows it, the two sides are fitted apart (section 215 step 4, 28 October 2026)
        Ns = np.array([fnormal(P, q) for q in S]); ef = defaultdict(list)
        for i, q in enumerate(S):
            for k in range(len(q)):
                x0, y0 = q[k], q[(k + 1) % len(q)]; ef[(min(x0, y0), max(x0, y0))].append(i)
        mids = []
        for (x0, y0), fs in ef.items():
            if len(fs) == 2 and np.degrees(np.arccos(np.clip(Ns[fs[0]] @ Ns[fs[1]], -1, 1))) > a.crease_deg:
                mids.append((UV[r[x0]] + UV[r[y0]]) / 2)
        mids = np.array(mids)
        if len(mids) > 8 and np.ptp(mids[:, 0]) > 0.5:
            mids = mids[(mids[:, 1] > 0.08) & (mids[:, 1] < 0.92)]
            hh, ed = np.histogram(mids[:, 1], bins=24, range=(0, 1)); mode = 0.5 * (ed[np.argmax(hh)] + ed[np.argmax(hh) + 1])
            mids = mids[np.abs(mids[:, 1] - mode) < a.crease_band]   # the dominant line only, not the crumple noise
            cf = np.polyfit(mids[:, 0], mids[:, 1], 2); vc = np.clip(np.polyval(cf, np.linspace(0, 1, nu + 1)), 0.1, 0.9)
            krow = int(round(np.median(vc) * nv)); krow = min(max(krow, 2), nv - 2)
            col = []
            for i in range(nu + 1):
                lo = np.linspace(0, vc[i], krow + 1); hi = np.linspace(vc[i], 1, nv - krow + 1)[1:]
                col.append(np.concatenate([lo, hi]))
            gv = np.array(col).T
            print("crease row", krow, "v range", round(float(vc.min()), 3), round(float(vc.max()), 3), "edges", len(mids))
    eps = 1e-6; Pq = np.stack([np.clip(gu.ravel(), eps, 1 - eps), np.clip(gv.ravel(), eps, 1 - eps)], 1)
    cen = UV[tris].mean(1); kd = cKDTree(cen)
    G = np.zeros((len(Pq), 3))
    for k, p in enumerate(Pq):   # barycentric lookup among the 12 nearest triangles, nearest one if none contains p (28 October 2026)
        best = None
        for ti in kd.query(p, k=12)[1]:
            t = tris[ti]; a0, a1, a2 = UV[t[0]], UV[t[1]], UV[t[2]]
            M = np.array([a0 - a2, a1 - a2]).T
            try:
                l = np.linalg.solve(M, p - a2)
            except np.linalg.LinAlgError:
                continue
            w = np.array([l[0], l[1], 1 - l.sum()]); err = -min(w.min(), 0)
            if best is None or err < best[0]:
                best = (err, t, np.clip(w, 0, None) / np.clip(w, 0, None).sum())
            if err == 0:
                break
        G[k] = best[2] @ X[best[1]]
    G = G.reshape(nv + 1, nu + 1, 3)
    if a.fair:
        Bu = bspline_basis(np.linspace(0, 1, nu + 1), a.ctrl_u); Bv = bspline_basis(np.linspace(0, 1, nv + 1), a.ctrl_v)
        def fit(Gb, cv):
            Bv_ = bspline_basis(np.linspace(0, 1, Gb.shape[0]), min(cv, Gb.shape[0]))
            return np.stack([Bv_ @ np.linalg.lstsq(Bv_, (np.linalg.lstsq(Bu, Gb[..., c].T, rcond=None)[0]).T, rcond=None)[0] @ Bu.T for c in range(3)], -1)
        if krow is None:
            Fit = fit(G, a.ctrl_v)
        else:
            cv0 = max(4, int(round(a.ctrl_v * krow / nv))); cv1 = max(4, a.ctrl_v - cv0 + 2)
            F0 = fit(G[: krow + 1], cv0); F1 = fit(G[krow:], cv1)
            Cr = 0.5 * (F0[-1] + F1[0])   # the shared crease row
            F0 += np.linspace(0, 1, krow + 1)[:, None, None] * (Cr - F0[-1])[None]
            F1 += np.linspace(1, 0, nv - krow + 1)[:, None, None] * (Cr - F1[0])[None]
            Fit = np.concatenate([F0, F1[1:]], 0)
        if a.keep_border_rows:
            Fit[0], Fit[-1], Fit[:, 0], Fit[:, -1] = G[0], G[-1], G[:, 0], G[:, -1]
        G = Fit
    if a.border_per_m > 0:   # borders on the target outline, lightly smoothed (1D B-spline), interior shifted by a Coons blend of the border deltas (joints, 28 October 2026)
        Lc = np.vstack([L, L[:1]])
        def side_pts(k, n):
            i0, i1 = cor[k], cor[(k + 1) % 4]
            ids = list(range(i0, i1 + 1)) if i1 > i0 else list(range(i0, m)) + list(range(0, i1 + 1))
            S3 = L[[i % m for i in ids]]
            ln = np.concatenate([[0], np.cumsum(np.linalg.norm(np.diff(S3, axis=0), axis=1))]); t = ln / ln[-1]
            nc = max(4, int(round(ln[-1] * a.border_per_m)) + 3)
            Bs = bspline_basis(t, nc); co = np.linalg.lstsq(Bs, S3, rcond=None)[0]
            tt = np.linspace(0, 1, 400); C = bspline_basis(tt, nc) @ co
            C[0], C[-1] = S3[0], S3[-1]
            cl = np.concatenate([[0], np.cumsum(np.linalg.norm(np.diff(C, axis=0), axis=1))]); u = np.linspace(0, cl[-1], n + 1)
            return np.stack([np.interp(u, cl, C[:, j]) for j in range(3)], 1)
        nvv, nuu = G.shape[0] - 1, G.shape[1] - 1
        b0 = side_pts(0, nuu); b1 = side_pts(1, nvv); b2 = side_pts(2, nuu)[::-1]; b3 = side_pts(3, nvv)[::-1]
        D0 = b0 - G[0]; D2 = b2 - G[-1]; D3 = b3 - G[:, 0]; D1 = b1 - G[:, -1]
        U_ = np.linspace(0, 1, nuu + 1)[None, :, None]; V_ = np.linspace(0, 1, nvv + 1)[:, None, None]
        corner = (1 - U_) * (1 - V_) * D0[0] + U_ * (1 - V_) * D0[-1] + U_ * V_ * D2[-1] + (1 - U_) * V_ * D2[0]
        G = G + (1 - V_) * D0[None] + V_ * D2[None] + (1 - U_) * D3[:, None] + U_ * D1[:, None] - corner
    if a.sym:   # BEFORE the pins, so a pinned side stays exactly on its curve (28 October 2026) ; the lateral index is the one whose ends differ in x
        Sx = np.array([-1.0, 1.0, 1.0])
        Gf = G[::-1] if abs(G[0, :, 0].mean() - G[-1, :, 0].mean()) > abs(G[:, 0, 0].mean() - G[:, -1, 0].mean()) else G[:, ::-1]
        G = 0.5 * (G + Gf * Sx)
    for _pc in [c for c in a.pin_curve.split(',') if c]:   # shared joint curves ; 'path@band' gives a band per curve (28 October 2026)
        _tok = _pc.split('@'); _band = int(_tok[1]) if len(_tok) > 1 else a.pin_band; _full = int(_tok[2]) if len(_tok) > 2 else a.pin_full; _pc = _tok[0]   # 'path@band@full', full per curve (28 October 2026)   # the grid side nearest to the curve is moved onto it, the move fades out
        C = np.load(_pc)
        sides4 = {"v0": G[0], "v1": G[-1], "u0": G[:, 0], "u1": G[:, -1]}
        from scipy.spatial import cKDTree as _K
        kc = _K(C); best = min(sides4, key=lambda k: kc.query(sides4[k])[0].mean())
        Sd = sides4[best]
        cl = np.concatenate([[0], np.cumsum(np.linalg.norm(np.diff(C, axis=0), axis=1))])
        t0 = cl[kc.query(Sd[0])[1]]; t1 = cl[kc.query(Sd[-1])[1]]
        if _full:   # the side spans the whole shared curve : same points on both parts
            t0, t1 = (0.0, cl[-1]) if t0 < t1 else (cl[-1], 0.0)
        tt = np.linspace(t0, t1, len(Sd)); New = np.stack([np.interp(tt, cl, C[:, j]) for j in range(3)], 1)
        if _pc.endswith("_partial.npy"):   # partial joint : only the side points inside the curve x range move, faded to 0 over 10 cm at its ends
            New = np.stack([Sd[:, 0], np.interp(Sd[:, 0], C[:, 0], C[:, 1]), np.interp(Sd[:, 0], C[:, 0], C[:, 2])], 1)
            fx = np.clip((C[:, 0].max() - np.abs(Sd[:, 0])) / 0.10, 0, 1); fx = fx * fx * (3 - 2 * fx)
            New = Sd + fx[:, None] * (New - Sd)
        D = New - Sd; n_ = G.shape[0] if best[0] == "v" else G.shape[1]
        w = np.linspace(1, 0, n_) if best.endswith("0") else np.linspace(0, 1, n_)
        if _band > 0:   # local : the move fades out over the band rows (smoothstep)
            dist = (1 - w) * (n_ - 1); tt_ = np.clip(1 - dist / _band, 0, 1); w = tt_ * tt_ * (3 - 2 * tt_)
        else:
            w = w ** a.pin_falloff
        if best[0] == "v":
            G = G + w[:, None, None] * D[None]
        else:
            G = G + w[None, :, None] * D[:, None]
        print("pinned side", best, "move max mm", round(float(np.linalg.norm(D, axis=1).max() * 1000), 1))
    T = G; nb_, na_ = T.shape[:2]
    du = np.gradient(T, axis=1); dv = np.gradient(T, axis=0); Nn = np.cross(du, dv)
    Nn /= np.linalg.norm(Nn, axis=-1, keepdims=True) + 1e-12
    if (Nn[..., a.skin_axis].mean()) * a.skin_sign < 0:
        Nn = -Nn
    B = T - a.thick * Nn
    pts = list(T.reshape(-1, 3)) + list(B.reshape(-1, 3)); off = nb_ * na_; faces = []
    gid = lambda j, i: j * na_ + i
    flip = Nn[..., a.skin_axis].mean() < 0
    for j in range(nb_ - 1):
        for i in range(na_ - 1):
            q = [gid(j, i), gid(j, i + 1), gid(j + 1, i + 1), gid(j + 1, i)]
            faces.append(q); faces.append([off + x for x in q[::-1]])
    ring = [gid(0, i) for i in range(na_)] + [gid(j, na_ - 1) for j in range(1, nb_)] + \
           [gid(nb_ - 1, i) for i in range(na_ - 2, -1, -1)] + [gid(j, 0) for j in range(nb_ - 2, 0, -1)]
    layers = [ring]
    for s in range(a.support):
        t = (s + 1) / (a.support + 1); base = len(pts)
        for v in ring:
            pts.append(T.reshape(-1, 3)[v] * (1 - t) + B.reshape(-1, 3)[v] * t)
        layers.append(list(range(base, base + len(ring))))
    layers.append([off + v for v in ring])
    for l0, l1 in zip(layers[:-1], layers[1:]):
        mm = len(l0)
        for k in range(mm):
            faces.append([l0[k], l1[k], l1[(k + 1) % mm], l0[(k + 1) % mm]])
    # orientation : outward on the top skin
    tq = np.array(faces[0]); n0 = fnormal(np.array(pts), list(tq))
    if n0[a.skin_axis] * a.skin_sign < 0:
        faces = [f[::-1] for f in faces]
    np.savez(a.out, P=np.array(pts, np.float32), Q=np.array(faces, dtype=object), names=np.array([a.part] * len(faces)), skin=np.array([i < 2 * (nb_ - 1) * (na_ - 1) and i % 2 == 0 for i in range(len(faces))]))
    print(json.dumps({"skin_faces": len(S), "loop": m, "corners": cor, "side_len_m": [round(x, 3) for x in sides], "grid": [nv, nu], "faces": len(faces)}))


if __name__ == "__main__":
    main()
