class Views:
    def __init__(self, obj="tree"):
        self.obj = obj; prm = json.load(open(W + "work/%s/component_params.json" % obj)); self.Pt = prm["paths"]; self.meta = json.load(open(W + self.Pt["frame"] + "/frame.json"))
        self.cal = json.load(open(W + self.Pt["cal"].format(obj=obj))); self.ms = json.load(open(W + self.Pt["measure"].format(obj=obj))); sh = json.load(open(W + self.Pt["views"] + "/sheet.json"))
        self.idx = {p["name"]: p["index"] for p in sh["panels"]}; self.vm = {v["name"]: v for v in self.meta["views"]}
        self.gray = {}; self.mask = {}
        for vn in self.vm:
            self.gray[vn] = np.asarray(Image.open(W + self.Pt["views"] + "/%02d_%s_rgb.png" % (self.idx[vn], vn)).convert("L")).astype(np.float32) / 255.0
            self.mask[vn] = np.asarray(Image.open(W + self.Pt["frame"] + "/mask_%s.png" % vn)) > 127
        self.crown_base = self.ms["trunk"]["crown_base_y"]; self.ppm = {vn: abs(self.cal[vn][0][0]) for vn in self.vm}

    def project(self, vn, P):
        P = np.asarray(P, float); v = self.vm[vn]; u = P @ np.array(v["rx"]); w = P @ np.array(v["uy"]); a, b = np.array(self.cal[vn][0]), np.array(self.cal[vn][1])
        return a[0] * u + b[0], a[1] * w + b[1]

    def ridge(self, vn, sigmas=(1.2, 2.0, 3.2, 5.0, 8.0, 12.0)):
        # soft bright-ridge map in 0..1 inside the object mask, plus the sigma index of the best scale (thickness cue). FR : crêtes claires, multi échelle.
        from skimage.filters import sato
        g = self.gray[vn]; m = self.mask[vn]; g = np.where(m, g, np.median(g[m])); best = np.zeros_like(g); arg = np.zeros(g.shape, np.int8)
        for i, s in enumerate(sigmas):
            r = sato(g, sigmas=[s], black_ridges=False) * s ** 0.5; sel = r > best; best[sel] = r[sel]; arg[sel] = i
        best = best * m; hi = np.percentile(best[m], 99.0); return np.clip(best / max(hi, 1e-6), 0, 1), arg


