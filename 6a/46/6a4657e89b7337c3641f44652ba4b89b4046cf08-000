def diagram():
    labels = [('Référence', 'Images d’origine conservées'), ('Composant', 'Forme, creux et détails'),
              ('Planches', 'Le composant, sans infographie'), ('Construction', 'Géométrie déterministe éditable'),
              ('Validation', 'Gros plans et vues à part'), ('Production', 'Retopo, UV, textures, essai')]
    items = []
    for i, (title, subtitle) in enumerate(labels):
        x = 90 + (i % 3) * 605
        y = 240 + (i // 3) * 340
        items.append(f'<rect x="{x}" y="{y}" width="540" height="220" rx="22" fill="#eef1e9" stroke="#b6c9bc"/><text x="{x+32}" y="{y+70}" font-size="38">{title}</text><text x="{x+32}" y="{y+128}" font-size="26" class="body">{subtitle}</text>')
        if i % 3 < 2:
            items.append(f'<path d="M{x+550},{y+110} h44" stroke="#286853" stroke-width="3" marker-end="url(#arrow)"/>')
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" role="img" aria-label="De la référence au composant prêt à tester"><defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" fill="#286853"/></marker></defs><style>' + fonts() + '</style><rect width="1920" height="1080" fill="#f7f5ef"/><g fill="#202b2a" font-family="GT Ultra"><text x="90" y="110" font-size="56">Une pièce fidèle avant l’assemblage</text><text x="90" y="172" font-size="28" class="body">Contrat corrigé le 5 November 2026. La fidélité finale reste à vérifier.</text>' + ''.join(items) + '<path d="M1570,470 v65 H360 v35" fill="none" stroke="#286853" stroke-width="3" marker-end="url(#arrow)"/><text x="90" y="985" font-size="28" class="body">Le contour contrôle les proportions. Les surfaces et les détails se regardent en 3D.</text></g></svg>'


