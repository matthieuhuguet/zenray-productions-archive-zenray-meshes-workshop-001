        body += '</table></div></details>'
        for item in data.get('experiments', []):
            body += '<article class="card"><h3>' + escape(item['name']) + '</h3><p>' + escape(item['result']) + '</p>'
            for picture in item.get('pictures', []):
                p = HERE / picture
                mime = 'image/png' if p.suffix == '.png' else 'image/jpeg'
                body += '<figure><img alt="' + escape(item['name']) + '" src="data:' + mime + ';base64,' + base64.b64encode(p.read_bytes()).decode() + '"><figcaption>' + escape(item.get('caption','Essai local, sans validation humaine de fidélité.')) + '</figcaption></figure>'
            body += '</article>'
    else:
        body += '<p>Audit produit avant les nouvelles constructions. Les essais du nouveau tour ne sont pas encore exécutés à cet instant ; aucune case de tournoi n’est gagnée.</p>'
    body += '<h2>Logiciels et recherches vérifiés</h2><div class="grid">'
    for item in CONFIG['research']:
        body += '<article class="card"><h3><a href="' + escape(item['url']) + '">' + escape(item['name']) + '</a></h3><p>' + escape(item['finding']) + '</p></article>'
    body += '</div><h2 id="sources">Toutes les sections recensées</h2><p>Chaque titre est conservé dans son ordre d’origine avec son numéro de ligne. Les textes ci-dessous sont les originaux historiques, qui peuvent se corriger ou se contredire. Leur présence ne signifie pas que leurs conclusions sont validées aujourd’hui. Le catalogue est complet pour les documents listés ; les scènes binaires et les conversations ne sont pas présentées comme intégralement relues.</p>'
    for source in sources:
        body += f'<details class="source"><summary>{escape(source["name"])} · {len(source["sections"])} titres</summary><p class="meta">{escape(source["path"])}<br>SHA256 {source["sha256"]}<br>Modification mesurée : {escape(source["modifiedAt"])}</p><div class="section-list">'
        if source['preamble'].strip():
            body += '<details><summary>Préambule</summary>' + markdown_blocks(source['preamble']) + '</details>'
        for section in source['sections']:
            body += f'<details id="s-{section["id"]}"><summary>{escape(section["title"])} <small>· ligne {section["line"]}</small></summary>' + markdown_blocks(section['body']) + '</details>'
        body += '</div></details>'
    body += '<p class="meta">Inventaire des sources généré automatiquement ; analyse et limites rédigées pour ce bilan. Le journal des prompts reste dans le feedback canonique, sans duplication de ses conversations dans ce document.</p>'
    ARTICLES.mkdir(exist_ok=True)
    (ARTICLES / 'meshes-audit-5-November-2026.html').write_text(page(CONFIG['title'], body))
    # The short project synthesis stays separate from the explicitly requested complete audit.
    (ARTICLES / 'index.html').write_text(page('ZenRay Meshes', intro + '<p><a href="meshes-audit-5-November-2026.html">Ouvrir le bilan complet et les essais du nouveau tour</a></p>'))
    (ARTICLES / 'value-chain.svg').write_text(diagram())
    catalogue = {'generatedAt':NOW, 'sourceCount':len(sources), 'headingCount':count, 'coreSectionCount':top_count, 'sources':sources}
    (HERE / 'source-catalogue.json').write_text(json.dumps(catalogue,ensure_ascii=False,indent=2))
    assert count == sum(len(re.findall(r'^#{1,6}\s+.+', Path(s['path']).read_text(), re.M)) for s in sources)
    assert len(set(s['id'] for source in sources for s in source['sections'])) == count
    changed = [s['path'] for s in sources if digest(Path(s['path']).read_bytes()) != s['sha256']]
    assert not changed, changed
    print(json.dumps({'sources':len(sources),'headings':count,'coreSections':top_count,'changedDuringBuild':changed,'auditBytes':(ARTICLES/'meshes-audit-5-November-2026.html').stat().st_size},ensure_ascii=False))


