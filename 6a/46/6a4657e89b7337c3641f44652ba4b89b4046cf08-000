def escape(value):
    return html.escape(str(value), quote=True)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def markdown_blocks(text):
    # Keep source text exact behind a disclosure; it is an archive, not a fresh claim.
    return '<pre class="original">' + escape(text) + '</pre>'


def collect():
    paths = [SKILL / 'SKILL.md', MEMORY / 'ZenRayMeshes1.md', MEMORY / 'Playbook.md',
             MEMORY / 'FailedMethods_Car.md', MEMORY / 'Components_latest.md', MEMORY / 'Components_v760.md']
    paths += sorted((SKILL / 'references').rglob('*.md'))
    paths += sorted((SKILL / 'templates/component-chain').glob('*.md'))
    paths += [
              Path('/Users/zenray/.claude/skills/zenray-houdini/templates/zenray-height-basecolor/prompt_basecolor_chain.md')]
    sources = []
    for path in dict.fromkeys(paths):
        raw = path.read_bytes()
        text = raw.decode('utf-8-sig')
        lines = text.splitlines(keepends=True)
        starts = [(i, m.group(1), m.group(2)) for i, line in enumerate(lines)
                  if (m := re.match(r'^(#{1,6})\s+(.+?)\s*$', line))]
        sections = []
        for index, (line, level, title) in enumerate(starts):
            end = starts[index + 1][0] if index + 1 < len(starts) else len(lines)
            identifier = digest((str(path) + ':' + str(line + 1) + ':' + title).encode())[:16]
            body = ''.join(lines[line + 1:end])
            sections.append({'id': identifier, 'line': line + 1, 'title': title, 'level': len(level), 'body': body})
        sources.append({'path': str(path), 'name': path.name, 'bytes': len(raw), 'sha256': digest(raw),
                        'modifiedAt': datetime.fromtimestamp(path.stat().st_mtime, ZoneInfo('Europe/Paris')).isoformat(),
                        'lineCount': len(lines), 'sections': sections, 'preamble': ''.join(lines[:starts[0][0]]) if starts else text})
    return sources


