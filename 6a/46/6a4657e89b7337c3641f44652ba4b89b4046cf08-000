def render(sources):
    count = sum(len(source['sections']) for source in sources)
    core = sources[0]
    top_count = sum(s['level'] == 2 for s in core['sections'])
    intro = '<h1>' + escape(CONFIG['title']) + '</h1>' + ''.join('<p>' + escape(p) + '</p>' for p in CONFIG['summary'])
    intro += '<div class="diagram">' + diagram() + '</div>'
    body = intro + f'<p class="meta">État documentaire du {escape(NOW)}. {len(sources)} documents, {count} titres recensés, dont {top_count} sections principales dans le skill.</p>'
    body += '<p>' + escape(CONFIG['scope']) + '</p><p><a href="#sources">Toutes les sections et leurs textes</a> · <a href="#round">Nouveau tour</a> · <a href="#evidence">Essais réellement exécutés</a></p>'
    body += '<h2>Ce que l’audit établit</h2><div class="grid">'
    for finding in CONFIG['findings']:
        refs = []
        for prefix in finding['sections']:
            match = next((s for s in core['sections'] if s['title'].startswith(prefix)), None)
            if match:
                refs.append(f'<a href="#s-{match["id"]}">§ {escape(prefix[:-1])}</a>')
        body += f'<article class="card"><h3>{escape(finding["title"])}</h3><p>{escape(finding["text"])}</p><small>{" · ".join(refs)}</small></article>'
    body += '</div><h2>Les objets en cours</h2><div class="grid">'
    for asset in CONFIG['assets']:
        body += '<article class="card"><h3>' + escape(asset['name']) + '</h3>' + ''.join('<p>' + escape(asset[k]) + '</p>' for k in ['state','evidence','next']) + '</article>'
    body += '</div>'
    media_path=WORKSHOP/'references/artstation-5-November-2026/references.json'
    if media_path.exists():
        body += '<h2>Les nouvelles références</h2><p>Les images confirment que 4805XY correspond au talkie radio et EL93Ge à la caisse. Les médias publics sont conservés à leur définition disponible, avec l’attribution à Wizix. Les quatre vidéos donnent 281 images à une seconde d’intervalle, dont 256 en 4K. ZenRay Edit vérifie les temps et relit chaque séquence entière.</p><div class="grid">'
        for project in json.loads(media_path.read_text())['projects']:
            image_file=next(f for f in project['files'] if f['name'].endswith('.jpg'))
            photo=media_path.parent/project['id']/image_file['name']
