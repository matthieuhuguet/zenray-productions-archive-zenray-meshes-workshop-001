#!/usr/bin/env python3
# 10 November 2026: the two charts that need only measured numbers: effort per day, and the score of the cage car per version.
import json, sys, re
sys.path.insert(0, '/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026/scripts')
import chartlib as C
from datetime import date, timedelta
A = '/Users/zenray/.claude/tmp/tmp-zenray-meshes/Audit_10-November-2026'; N = json.load(open(A + '/data/numbers.json'))
t = open('/Users/zenray/.claude/PROGRESS.md', encoding='utf-8').read(); ents = re.split(r'\n(?=\d{4}-\d{2}-\d{2} \d{2}:\d{2})', t)
jd = {}
for e in ents:
    if 'Projet : zenray-meshes' in e or 'zenray-meshes' in e[:400]: jd[e[:10]] = jd.get(e[:10], 0) + 1
days = [(date(2026, 10, 25) + timedelta(d)).isoformat() for d in range(17)]; lab = lambda d: d[8:] + (' oct' if d[5:7] == '10' else ' nov')
img = {d: sum(v.values()) for d, v in N['versions_by_day'].items()}; hou = {}
for d, e, n in N['houdini_by_day']: hou[d] = hou.get(d, 0) + n
panels = [('Entrées du journal de travail', jd, 'entrées'), ("Images de contrôle enregistrées (dossier versions)", img, 'images'), ('Scripts Python modifiés pour la dernière fois ce jour-là', N['scripts_by_day'], 'scripts'), ('Fichiers Houdini (HDA et scènes) modifiés pour la dernière fois ce jour-là', hou, 'fichiers')]
svg = C.columns_multiples("Où est passé l'effort, jour par jour", 'Du 25 October au 10 November 2026. Chaque panneau a sa propre échelle.', [(a, {lab(k): v for k, v in b.items()}, u) for a, b, u in panels], [lab(d) for d in days],
                          note="Lecture : 333 des 368 entrées du journal et 19 711 images datent des six premiers jours ; ensuite le travail continue surtout dans le code.")
open(A + '/charts/01_effort_par_jour.svg', 'w').write(svg)
rows = [r for r in N['cage_car_versions'] if r['gates_passed'] > 0]; pts = [(r['version'].replace('V_', 'V'), r['gates_passed']) for r in rows]      # runs that crashed (0 passed) are left out
from datetime import datetime
def when(r):
    try: return datetime.strptime(r['when'], '%d %B %Y %H:%M')
    except Exception: return None
REJ = [('02:11', 'toit hors blueprint'), ('11:10', 'coffre crénelé'), ('11:14', 'ondulations'), ('13:46', 'finition, roues'), ('14:10', '« foutage de gueule »'), ('18:52', 'toujours pas ça')]      # Matthieu's rejections of the car on 10 November 2026 (words_B.json)
marks = []
for hm, txt in REJ:
    t = datetime.strptime('10 November 2026 ' + hm, '%d %B %Y %H:%M'); idx = [i for i, r in enumerate(rows) if when(r) and when(r) <= t]
    if idx: marks.append((idx[-1], txt))
svg = C.step_series('Les contrôles automatiques montaient, ton verdict non', 'Voiture 1, projet 11_CarCage : nombre de contrôles automatiques passés sur 27, à chaque version de la cage (V_010 à V_140, exécutions plantées retirées).', pts, 27, 'contrôles passés sur 27', marks=marks, ref_line=(27, 'tous les contrôles'),
                    h=480, note="Points numérotés : tes rejets de la voiture le 10 November 2026, chacun placé sur la dernière version calculée avant ton message.")
open(A + '/charts/04_controles_par_version.svg', 'w').write(svg)
print('ok', len(pts), max(p[1] for p in pts))
