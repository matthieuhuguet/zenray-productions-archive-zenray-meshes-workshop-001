"""1 November 2026 : M22 step 2d, the LINK between the reference regions (MicroRegions.py) and the dataset of micro-components (MicroShells.py) : each reference region takes the shell that covers it most (hidden families excluded), with the share of the vote ; a region under link_min_share is flagged ; a shell with visible pixels and no region is absorbed by the region that contains it, and keeps its template mask. Writes 02_masks/link.json.
    python -I MicroLink.py Projects/<id>/params.json        FR : le lien entre les régions de la référence et le dataset : chaque région prend la coque qui la couvre le plus."""
import sys, json, fnmatch
import numpy as np
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
sys.path.insert(0, ROOT + "/Scripts/micro"); import MicroCommon as C
DEF = dict(hidden_families=["CAR_closer*", "CAR_liner*"], link_min_share=0.5)


def main(params):
    p, home = C.load(params); r = {k: p.get(k, v) for k, v in DEF.items()}; S = json.load(open(f"{home}/02_masks/shells.json")); shells = S["shells"]; defs = S["definitions"]; n = len(shells)
    def_of = np.full(n, -1); [def_of.__setitem__(s, D["id"]) for D in defs for s in D["shells"]]; hidden = np.array([any(fnmatch.fnmatch(x["family"], h) for h in r["hidden_families"]) for x in shells])
    views = {}; px_visible = np.zeros(n, np.int64); px_won = np.zeros(n, np.int64)
    for name in p["views"]:
        lab = np.load(f"{home}/02_masks/raw_{name}.npz")["labels"]; R = np.load(f"{home}/02_masks/regions_{name}.npz")["regions"]; assert lab.shape == R.shape; nr = int(R.max()) + 1; inside = R >= 0
        ok = inside & (lab >= 0) & ~hidden[np.clip(lab, 0, None)]; H = np.zeros((nr, n), np.int64); np.add.at(H, (R[ok], lab[ok]), 1); area = np.bincount(R[inside], minlength=nr); rows = []
        px_visible += np.bincount(lab[(lab >= 0)], minlength=n)
        for k in range(nr):
            t = int(H[k].argmax()) if H[k].sum() else -1; share = float(H[k, t] / max(area[k], 1)) if t >= 0 else 0.0; rows.append(dict(region=k, area=int(area[k]), shell=t, share=round(share, 3), others=[[int(j), int(H[k, j])] for j in np.argsort(-H[k])[1:4] if H[k, j] > 0]))
            if t >= 0: px_won[t] += area[k]
        views[name] = rows; low = sum(x["area"] for x in rows if x["share"] < r["link_min_share"]); print(name, "regions", nr, "area under min share %.3f" % (low / max(area.sum(), 1)), "no shell", sum(1 for x in rows if x["shell"] < 0))
    absorbed = []
    for s in range(n):
        if px_visible[s] > 0 and px_won[s] == 0 and not hidden[s]: absorbed.append(s)
    json.dump(dict(views=views, px_visible=px_visible.tolist(), px_won=px_won.tolist(), absorbed=absorbed, hidden=np.flatnonzero(hidden).tolist(), def_of=def_of.tolist()), open(f"{home}/02_masks/link.json", "w"), indent=0)
    won_d = {}; vis_d = {}
    for s in range(n): won_d[def_of[s]] = won_d.get(def_of[s], 0) + int(px_won[s]); vis_d[def_of[s]] = vis_d.get(def_of[s], 0) + int(px_visible[s])
    fam = {D["id"]: D["family"] + (" x%d" % D["instances"]) for D in defs}
    print("definitions visible", sum(1 for d in vis_d if vis_d[d] > 0), "with a reference region", sum(1 for d in won_d if won_d[d] > 0), "absorbed shells", len(absorbed), "hidden shells", int(hidden.sum()))
    print("WON :", ", ".join(sorted(fam[d] for d in won_d if won_d[d] > 0)))
    print("ABSORBED defs :", ", ".join(sorted(fam[d] for d in vis_d if vis_d[d] > 0 and won_d.get(d, 0) == 0 and not hidden[defs[d]["shells"][0]])))


if __name__ == "__main__": main(sys.argv[1])
