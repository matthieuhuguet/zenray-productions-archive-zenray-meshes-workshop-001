def bishop_frames(pts):
    """Compute Rotation-Minimizing Bishop Frames along a 3D polyline (zero Frenet inflection flips)."""
    n = len(pts)
    tangents = np.zeros((n, 3), dtype=np.float64)
    for i in range(n):
        if i == 0:
            t = pts[1] - pts[0]
        elif i == n - 1:
            t = pts[-1] - pts[-2]
        else:
            t = pts[i + 1] - pts[i - 1]
        tangents[i] = t / max(np.linalg.norm(t), 1e-9)

    ref = np.array([0.0, 0.0, 1.0]) if abs(tangents[0, 2]) < 0.9 else np.array([1.0, 0.0, 0.0])
    n0 = np.cross(tangents[0], ref)
    n0 /= max(np.linalg.norm(n0), 1e-9)
    b0 = np.cross(tangents[0], n0)

    normals = np.zeros((n, 3), dtype=np.float64)
    binormals = np.zeros((n, 3), dtype=np.float64)
    normals[0], binormals[0] = n0, b0

    for i in range(n - 1):
        t0, t1 = tangents[i], tangents[i + 1]
        v = np.cross(t0, t1)
        c = float(np.dot(t0, t1))
        if np.linalg.norm(v) < 1e-8:
            normals[i + 1] = normals[i]
        else:
            axis = v / np.linalg.norm(v)
            ang = math.atan2(np.linalg.norm(v), c)
            # Rodrigues parallel transport (double reflection / axis-angle preserves twist-free roll)
            n_cur = normals[i]
            normals[i + 1] = (
                n_cur * math.cos(ang)
                + np.cross(axis, n_cur) * math.sin(ang)
                + axis * float(np.dot(axis, n_cur)) * (1.0 - math.cos(ang))
            )
            normals[i + 1] /= max(np.linalg.norm(normals[i + 1]), 1e-9)
        binormals[i + 1] = np.cross(tangents[i + 1], normals[i + 1])
    return tangents, normals, binormals


def frenet_frames(pts):
    """Standard Frenet-Serret frames for comparison showing inflection point 180-deg twist flips."""
    n = len(pts)
    normals = np.zeros((n, 3), dtype=np.float64)
    flips = 0
    for i in range(n):
        t0 = pts[min(n - 1, i + 1)] - pts[max(0, i - 1)]
        t0 /= max(np.linalg.norm(t0), 1e-9)
        d2 = pts[min(n - 1, i + 1)] - 2.0 * pts[i] + pts[max(0, i - 1)]
        d2 -= np.dot(d2, t0) * t0
        if np.linalg.norm(d2) < 1e-7:
            normals[i] = normals[max(0, i - 1)] if i > 0 else np.array([1.0, 0.0, 0.0])
        else:
            normals[i] = d2 / np.linalg.norm(d2)
        if i > 0 and np.dot(normals[i], normals[i - 1]) < 0.0:
            flips += 1
    return flips


def eval_quads_3d(pts_arr, quads):
    jacs = []
    edge_cnt = {}
    for q in quads:
        for k in range(4):
            e = tuple(sorted((q[k], q[(k + 1) % 4])))
            edge_cnt[e] = edge_cnt.get(e, 0) + 1
        corners = pts_arr[np.array(q)]
        vj = []
        for idx in range(4):
            e1 = corners[(idx + 1) % 4] - corners[idx]
            e2 = corners[(idx - 1) % 4] - corners[idx]
            n1, n2 = np.linalg.norm(e1), np.linalg.norm(e2)
            if n1 < 1e-9 or n2 < 1e-9:
                vj.append(0.0)
            else:
                vj.append(float(np.linalg.norm(np.cross(e1, e2)) / (n1 * n2)))
        jacs.append(min(vj))
    non_man = sum(1 for c in edge_cnt.values() if c > 2)
    return {
        'quad_count': len(quads),
        'min_scaled_jacobian': round(float(np.min(jacs)), 4),
        'median_scaled_jacobian': round(float(np.median(jacs)), 4),
        'non_manifold_edges': non_man,
    }


def build_organic_limb(n_rings=24, n_radial=18):
    """Build Archetype C: S-curved dorsal-crested Dracard tail/limb tube with seam edgegroup & creaseweight."""
    ts = np.linspace(0.0, 1.0, n_rings)
    # 3D S-curve spine with inflection point at t=0.5 (where Frenet flips!)
    spine = np.column_stack([
        0.55 * np.sin(2.0 * math.pi * ts),
        ts * 2.4,
        0.28 * np.cos(1.5 * math.pi * ts) - 0.1 * ts,
    ])
    _, N, B = bishop_frames(spine)
    frenet_flips = frenet_frames(spine)

    # Check Bishop step dot products (0 flips!)
    bishop_flips = sum(1 for i in range(n_rings - 1) if float(np.dot(N[i], N[i + 1])) < 0.0)

    pts, uvs, creases, seams = [], [], [], []
    thetas = np.linspace(0.0, 2.0 * math.pi, n_radial, endpoint=False)
    for i, t in enumerate(ts):
        rx = 0.24 * (1.0 - 0.65 * (t ** 1.15)) * (1.0 + 0.18 * math.sin(math.pi * t))
        ry = 0.30 * (1.0 - 0.58 * (t ** 1.15))
        # Variable yellow FWHM crease weight peaks along mid-dorsal crest (theta=0), smooth near base/tip
        keel_pinch = 0.38 * math.sin(math.pi * t)
        for j, th in enumerate(thetas):
            c, s = math.cos(th), math.sin(th)
            crest = keel_pinch * (max(c, 0.0) ** 4.0)
            p = spine[i] + N[i] * ((rx + crest) * c) + B[i] * (ry * s)
            pts.append(p)
            # Ventral seam at j == n_radial // 2 -> unwrapped straight U in [0, 1] without seam wrap fold
            u = ((j - (n_radial // 2)) % n_radial) / float(n_radial - 1)
            uvs.append([u, float(t)])
            cw = (0.78 * math.sin(math.pi * t)) if j == 0 else 0.0
            creases.append(cw)

    quads = []
    for i in range(n_rings - 1):
        for j in range(n_radial):
            jn = (j + 1) % n_radial
            a = i * n_radial + j
            b = i * n_radial + jn
            c = (i + 1) * n_radial + jn
            d = (i + 1) * n_radial + j
            quads.append([a, b, c, d])
            if j == n_radial // 2:
                seams.append((a, d))

    pts_arr = np.array(pts)
    qm = eval_quads_3d(pts_arr, quads)
    qm['frenet_twist_flips'] = frenet_flips
    qm['bishop_twist_flips'] = bishop_flips
    qm['ventral_seam_edges'] = len(seams)
    return pts_arr, np.array(uvs), quads, creases, qm, spine


def build_branch_tree():
    """Build Archetype D: Multi-level branching tree with Da Vinci radius conservation + straight bark UVs + leaf cards."""
    # Level 0 trunk + Level 1 bifurcation into L/R boughs + Level 2 twigs
    def sample_tube(spine_pts, r_start, r_end, n_rad=10):
        _, N, B = bishop_frames(spine_pts)
        ns = len(spine_pts)
        pts, uvs, quads = [], [], []
        arc = np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(spine_pts, axis=0), axis=1))])
        arc /= max(arc[-1], 1e-9)
        thetas = np.linspace(0.0, 2.0 * math.pi, n_rad, endpoint=False)
        for i in range(ns):
            r = r_start * (1.0 - arc[i]) + r_end * arc[i]
            for j, th in enumerate(thetas):
                p = spine_pts[i] + r * (math.cos(th) * N[i] + math.sin(th) * B[i])
                pts.append(p)
                uvs.append([j / float(n_rad), float(arc[i])])
        for i in range(ns - 1):
            for j in range(n_rad):
                jn = (j + 1) % n_rad
                quads.append([i * n_rad + j, i * n_rad + jn, (i + 1) * n_rad + jn, (i + 1) * n_rad + j])
        return np.array(pts), np.array(uvs), quads

    # Da Vinci law: r_trunk^2.1 = r_b1^2.1 + r_b2^2.1 (check bifurcation conservation!)
    r_trunk_top = 0.145
    r_b1 = 0.112
    r_b2 = (max(r_trunk_top ** 2.1 - r_b1 ** 2.1, 1e-5)) ** (1.0 / 2.1)
    da_vinci_err = abs((r_b1 ** 2.1 + r_b2 ** 2.1) - (r_trunk_top ** 2.1)) / (r_trunk_top ** 2.1)

    t_tr = np.linspace(0, 1, 12)
    s_trunk = np.column_stack([0.08 * np.sin(1.4 * t_tr), t_tr * 1.15, 0.04 * np.cos(2.0 * t_tr)])
    t_b = np.linspace(0, 1, 10)
    top = s_trunk[-1]
    s_b1 = np.column_stack([top[0] - 0.65 * (t_b ** 0.9), top[1] + 0.85 * t_b, top[2] + 0.14 * np.sin(2.5 * t_b)])
    s_b2 = np.column_stack([top[0] + 0.72 * (t_b ** 0.9), top[1] + 0.78 * t_b, top[2] - 0.12 * np.sin(2.2 * t_b)])
    mid1 = s_b1[5]
    s_t1 = np.column_stack([mid1[0] - 0.35 * t_b, mid1[1] + 0.45 * t_b + 0.08 * np.sin(3 * t_b), mid1[2] + 0.22 * t_b])
    mid2 = s_b2[5]
    s_t2 = np.column_stack([mid2[0] + 0.32 * t_b, mid2[1] + 0.48 * t_b, mid2[2] - 0.25 * t_b])

    all_branches = []
    all_qm = []
    for sp, rs, re, nrad in [
        (s_trunk, 0.22, r_trunk_top, 12),
        (s_b1, r_b1, 0.055, 10),
        (s_b2, r_b2, 0.048, 10),
        (s_t1, 0.058, 0.022, 8),
        (s_t2, 0.052, 0.020, 8),
    ]:
        p, u, q = sample_tube(sp, rs, re, nrad)
        qm = eval_quads_3d(p, q)
        all_branches.append((sp, p, u, q))
        all_qm.append(qm)

    # Generate Foliage Cross-Card quads at terminal twig anchors (compared to heavy raw leaf geo)
    twig_tips = [s_b1[-1], s_b2[-1], s_t1[-1], s_t2[-1], s_b1[7], s_b2[7]]
    rng = np.random.default_rng(14)
    cards = []
    for tip in twig_tips:
        for _ in range(5):
            off = rng.normal(0.0, 0.12, 3)
            center = tip + off
            sz = 0.22 + 0.06 * rng.random()
            ang = rng.uniform(0, math.pi)
            dx = np.array([math.cos(ang), 0.25 * rng.normal(), math.sin(ang)]) * sz * 0.5
            dy = np.array([0.0, sz * 0.65, 0.12])
            cards.append([center - dx, center + dx, center + dx + dy, center - dx + dy])

    total_quads = sum(q['quad_count'] for q in all_qm) + len(cards)
    min_jac = min(q['min_scaled_jacobian'] for q in all_qm)
    med_jac = float(np.median([q['median_scaled_jacobian'] for q in all_qm]))
    raw_equiv_tris = len(cards) * 1800  # realistic per-cluster modeled leaf polycount vs 2-tri alpha card
    card_tris = len(cards) * 2
    reduction_pct = round(100.0 * (1.0 - card_tris / raw_equiv_tris), 2)

    tree_metrics = {
        'branches': len(all_branches),
        'bark_quad_count': sum(q['quad_count'] for q in all_qm),
        'foliage_cards': len(cards),
        'total_quads': total_quads,
        'min_scaled_jacobian': round(min_jac, 4),
        'median_scaled_jacobian': round(med_jac, 4),
        'da_vinci_area_conservation_err': round(da_vinci_err, 5),
        'foliage_draw_reduction_pct': reduction_pct,
        'non_manifold_edges': sum(q['non_manifold_edges'] for q in all_qm),
    }
    return all_branches, cards, tree_metrics


def project_3d(pts, yaw_deg=-28, pitch_deg=18, cx=0, cy=0, scale=180.0):
    ry, rp = math.radians(yaw_deg), math.radians(pitch_deg)
    Rx = np.array([[1, 0, 0], [0, math.cos(rp), -math.sin(rp)], [0, math.sin(rp), math.cos(rp)]])
    Ry = np.array([[math.cos(ry), 0, math.sin(ry)], [0, 1, 0], [-math.sin(ry), 0, math.cos(ry)]])
    R = Rx @ Ry
    p = pts @ R.T
    # Flips Y for screen coordinates
    return np.column_stack([cx + p[:, 0] * scale, cy - p[:, 1] * scale]), p[:, 2]


