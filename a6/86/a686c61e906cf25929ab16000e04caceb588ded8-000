"""Douze instances de la même définition (FacetCar) : trois styles de carrosserie, quatre jeux de paramètres tirés avec une graine fixe. 30 October 2026."""
import numpy as np
STYLES = {
    "wedge": {},
    "notch": dict(deck_y=1.05, rw_pitch=52.0, deck_z=-1.85, roof_y=1.30, rear_lean=6.0, hood_pitch=5.0),
    "fastback": dict(rw_pitch=14.0, deck_z=-2.00, roof_y=1.22, ws_pitch=24.0, deck_y=0.92, hood_pitch=9.0),
}
def instance(i):
    style = list(STYLES)[i % 3]
    rng = np.random.default_rng(100 + i)
    p = dict(STYLES[style])
    p.update(W=float(rng.uniform(1.85, 2.05)), zf=float(rng.uniform(2.15, 2.35)), zr=float(-rng.uniform(2.15, 2.35)), tumble=float(rng.uniform(7, 13)), cab_tumble=float(rng.uniform(11, 17)),
             hood_pitch=float(p.get("hood_pitch", 7.5) + rng.uniform(-2, 2)), ws_pitch=float(p.get("ws_pitch", 28.0) + rng.uniform(-3, 3)))
    return style, p
