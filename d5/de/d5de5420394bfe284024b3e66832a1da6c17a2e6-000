"""29 October 2026 : ZenRay Lines BUILD ALL, every component of work/lines/components_table.json built once by ZrlBuildOne.py, in
parallel (8 processes), into the cache the mini HDA reads (work/lines/hda/<component>_<hash>.npz). Prints one line per component.
python ZrlBuildAll.py [table.json]        FR : tous les components construits une fois, en parallèle, dans le cache du mini HDA."""
import json, subprocess, sys
from concurrent.futures import ThreadPoolExecutor
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
PARAMS = {"table": f"{ROOT}/work/lines/components_table.json", "workers": 8, "python": "/Users/zenray/.venvs/zenray-meshes/bin/python"}   # 29 October 2026


def one(item):
    name, prm = item
    r = subprocess.run([PARAMS["python"], "-I", f"{ROOT}/Scripts/lines/ZrlBuildOne.py", name, json.dumps(prm)], capture_output=True, text=True)
    try: d = json.loads(r.stdout.strip().splitlines()[-1]); return f"{name:30s} {d['score']['percent']:5.1f} %  failed {d['failed']}"
    except Exception: return f"{name:30s} BUILD FAILED {(r.stderr or r.stdout)[-300:]!r}"


if __name__ == "__main__":
    table = json.load(open(sys.argv[1] if len(sys.argv) > 1 else PARAMS["table"]))
    with ThreadPoolExecutor(PARAMS["workers"]) as ex:
        for line in ex.map(one, table.items()): print(line, flush=True)
