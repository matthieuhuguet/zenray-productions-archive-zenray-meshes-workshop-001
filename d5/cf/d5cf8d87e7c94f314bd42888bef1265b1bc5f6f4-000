"""2 November 2026 : the folder DragonFit.py reads, made from any frames of the series : masks, frames, viewport rectangles and gizmo angles. FR : le dossier que DragonFit.py lit, fait depuis n'importe quelles images de la série.
    python -I PrepViews.py <frames folder> <out folder> f1,f2,... [--mask grey]"""
import sys, os, json, shutil
import numpy as np
from PIL import Image
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE); sys.path.insert(0, os.path.dirname(HERE))
from CompFit import viewport, part_mask, CF; import GizmoRead
frames, out, names = sys.argv[1], sys.argv[2], sys.argv[3].split(","); mode = sys.argv[5] if len(sys.argv) > 5 else "grey"; os.makedirs(f"{out}/masks", exist_ok=True); os.makedirs(f"{out}/refs", exist_ok=True); tb = CF["toolbar_px"]
V = json.load(open(f"{out}/views.json")) if os.path.exists(f"{out}/views.json") else {}; G = json.load(open(f"{out}/gizmo_cams.json")) if os.path.exists(f"{out}/gizmo_cams.json") else {}
for n in names:
    im = np.asarray(Image.open(f"{frames}/f_{int(n):05d}.jpg").convert("RGB")); r = viewport(im.max(2).astype(np.float32)); m = part_mask(im, r, mode); g = GizmoRead.read(im); pad = np.zeros((m.shape[0], m.shape[1] + tb), np.uint8); pad[:, :m.shape[1]] = m * 255; Image.fromarray(pad).save(f"{out}/masks/{n}.png"); Image.fromarray(im).save(f"{out}/refs/{n}.png"); V[n] = dict(size=[m.shape[1] + tb, m.shape[0]], rect=[r[0], r[1], r[2] + tb, r[3]]); G[n] = dict(yaw=g[0], pitch=g[1]) if g else None
json.dump(V, open(f"{out}/views.json", "w"), indent=0); json.dump(G, open(f"{out}/gizmo_cams.json", "w"), indent=0); print(len(names), "views in", out)
