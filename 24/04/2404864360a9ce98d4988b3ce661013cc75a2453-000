# 27 October 2026: Setup orthogonal reference image planes in Houdini /obj/ZRM_ReferenceViews
import hou, os

views_dir = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/car/views"

obj = hou.node("/obj")
ref_node = obj.node("ZRM_ReferenceViews")
if not ref_node:
    ref_node = obj.createNode("geo", "ZRM_ReferenceViews")
ref_node.moveToGoodPosition()

# Clear existing children
for c in ref_node.children():
    c.destroy()

# 1. Front View Reference Grid
front_grid = ref_node.createNode("grid", "ref_front")
front_grid.parm("sizex").set(2.10)
front_grid.parm("sizey").set(1.40)
front_grid.parm("rows").set(2)
front_grid.parm("cols").set(2)
front_grid.parm("orient").set(0) # XY plane

front_xform = ref_node.createNode("xform", "xform_front")
front_xform.setNextInput(front_grid)
front_xform.parm("ty").set(0.68)
front_xform.parm("tz").set(2.45)
front_xform.parm("ry").set(180) # Face towards car

front_mat = ref_node.createNode("texture", "uv_front")
front_mat.setNextInput(front_xform)

# 2. Back View Reference Grid
back_grid = ref_node.createNode("grid", "ref_back")
back_grid.parm("sizex").set(2.10)
back_grid.parm("sizey").set(1.40)
back_grid.parm("rows").set(2)
back_grid.parm("cols").set(2)
back_grid.parm("orient").set(0)

back_xform = ref_node.createNode("xform", "xform_back")
back_xform.setNextInput(back_grid)
back_xform.parm("ty").set(0.68)
back_xform.parm("tz").set(-2.45)

back_mat = ref_node.createNode("texture", "uv_back")
back_mat.setNextInput(back_xform)

# 3. Top View Reference Grid
top_grid = ref_node.createNode("grid", "ref_top")
top_grid.parm("sizex").set(2.10)
top_grid.parm("sizey").set(4.65)
top_grid.parm("rows").set(2)
top_grid.parm("cols").set(2)
top_grid.parm("orient").set(1) # ZX plane

top_xform = ref_node.createNode("xform", "xform_top")
top_xform.setNextInput(top_grid)
top_xform.parm("ty").set(-0.02)
top_xform.parm("tz").set(0.0)

top_mat = ref_node.createNode("texture", "uv_top")
top_mat.setNextInput(top_xform)

# 4. Right Side View Reference Grid
right_grid = ref_node.createNode("grid", "ref_right")
right_grid.parm("sizex").set(4.65)
right_grid.parm("sizey").set(1.40)
right_grid.parm("rows").set(2)
right_grid.parm("cols").set(2)
right_grid.parm("orient").set(0)

right_xform = ref_node.createNode("xform", "xform_right")
right_xform.setNextInput(right_grid)
right_xform.parm("tx").set(-1.35)
right_xform.parm("ty").set(0.68)
right_xform.parm("ry").set(90)

right_mat = ref_node.createNode("texture", "uv_right")
right_mat.setNextInput(right_xform)

# 5. Left Side View Reference Grid
left_grid = ref_node.createNode("grid", "ref_left")
left_grid.parm("sizex").set(4.65)
left_grid.parm("sizey").set(1.40)
left_grid.parm("rows").set(2)
left_grid.parm("cols").set(2)
left_grid.parm("orient").set(0)

left_xform = ref_node.createNode("xform", "xform_left")
left_xform.setNextInput(left_grid)
left_xform.parm("tx").set(1.35)
left_xform.parm("ty").set(0.68)
left_xform.parm("ry").set(-90)

left_mat = ref_node.createNode("texture", "uv_left")
left_mat.setNextInput(left_xform)

# Merge all reference planes
merge = ref_node.createNode("merge", "merge_views")
merge.setNextInput(front_mat)
merge.setNextInput(back_mat)
merge.setNextInput(top_mat)
merge.setNextInput(right_mat)
merge.setNextInput(left_mat)

out_views = ref_node.createNode("null", "OUT_reference_views")
out_views.setNextInput(merge)
out_views.setDisplayFlag(True)
out_views.setRenderFlag(True)

ref_node.layoutChildren()
print("Successfully created /obj/ZRM_ReferenceViews with 5 orthogonal reference cards!")
