"""28 October 2026 : one row of the sheet board (reference view next to the model in the same camera) for a delivery npz, cropped and enlarged.
python BoardRow.py <delivery.npz> <view: front|back|left|right|top|bottom> <out.png>  FR : une ligne de la planche, référence à côté du modèle."""
import os, subprocess, sys
import numpy as np
from PIL import Image
W = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/"; d = np.load(sys.argv[1], allow_pickle=True); view, out = sys.argv[2], sys.argv[3]
Q = [list(map(int, q)) for q in d["Q"]]; n = [str(x) for x in d["names"]]; N = sorted(set(n)); ix = {m: i for i, m in enumerate(N)}; F = []; T = []
for q, m in zip(Q, n):
    for k in range(1, len(q) - 1):
        F.append([q[0], q[k], q[k + 1]]); T.append(ix[m])
tmp = W + "work/car/_board_tmp.npz"; np.savez(tmp, P=d["P"], F=np.array(F), T=np.array(T), names=np.array(N))
subprocess.run([sys.executable, "-I", W + "Scripts/SheetBoard.py", W + "work/car/frame", W + "work/car/views", tmp, W + "work/car/_board_tmp.png", "10"], check=True, capture_output=True)
im = Image.open(W + "work/car/_board_tmp.png"); h = im.height / 6; k = ["front", "back", "left", "right", "top", "bottom"].index(view)
r = im.crop((0, int(k * h), im.width, int((k + 1) * h))); r.resize((r.width * 2, r.height * 2)).save(out); print(out)
