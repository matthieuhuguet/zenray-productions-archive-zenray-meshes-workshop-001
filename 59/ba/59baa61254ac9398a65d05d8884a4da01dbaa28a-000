"""5 November 2026 : RUNPARTS, builds every component of ZrmParts (or the named ones), one board each (reference on the left, four views of the model on the right), and the registry json for the HTML sheet. FR : construit chaque composant, une planche chacun, et le registre pour la feuille HTML.
Usage : python RunParts.py out_dir [part ...]"""
import sys, os, json, subprocess
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import ZrmParts as Z
out = sys.argv[1]; os.makedirs(out, exist_ok=True); names = sys.argv[2:] or list(Z.REGISTRY); REFS = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/dracard/v3/lib/refs"; PY = sys.executable
for n in names:
    objs, P = Z.build_part(n); fo = os.path.join(out, n + ".obj"); Z.write_obj(fo, objs); json.dump(P, open(fo + ".params.json", "w"), indent=1)
    ref = os.path.join(REFS, Z.REGISTRY[n]["ref"] + ".png")
    r = subprocess.run([PY, "-I", os.path.join(HERE, "FootBoard.py"), fo, os.path.join(out, "board_" + n + ".png"), ref, "--tile", "380"], capture_output=True, text=True); print(n, r.stdout.strip()[-40:], r.stderr.strip()[-120:])
