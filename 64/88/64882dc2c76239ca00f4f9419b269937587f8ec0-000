#!/bin/zsh
# 1 November 2026 : M22, the whole detection and preparation chain of one project, in order. FR : toute la chaîne de détection et de préparation d'un projet, dans l'ordre.
# Usage : zsh Scripts/micro/MicroAll.sh Projects/<id>/params.json ["note of the version"]
set -e
cd /Users/zenray/.claude/tmp/tmp-zenray-meshes
PY=/Users/zenray/.venvs/zenray-meshes/bin/python
P=$1
$PY -I Scripts/micro/MicroShells.py $P | head -1
$PY -I Scripts/micro/MicroRegions.py $P | tail -1
$PY -I Scripts/micro/MicroZones.py $P
$PY -I Scripts/micro/MicroLabels.py $P | tail -1
$PY -I Scripts/micro/MicroMasks.py $P
$PY -I Scripts/micro/MicroLegend.py $P
$PY -I Scripts/micro/MicroOutline.py $P board
# 1 November 2026 : no sheet is ever made from the masks of the algorithm : they only give the preview ; the sheets come after the real cut sheet is read, on the validated components. FR : aucune feuille depuis les masques de l'algorithme, seulement la preview ; les feuilles viennent après la vraie découpe.
find $(dirname $P)/03_sheets -maxdepth 1 \( -name "S*" -o -name "sheets.json" \) -delete
find $(dirname $P)/04_received -maxdepth 1 -type d -name "*_sim*" -exec rm -rf {} +
find $(dirname $P)/06_checks -maxdepth 1 \( -name "sim_*" -o -name "selftest.json" \) -delete
$PY -I Scripts/micro/MicroCutPrompt.py $P
$PY -I Scripts/micro/MicroCutCheck.py $P || echo "no generation passes the gates yet"      # 1 November 2026 : the verifier of the cut sheets received. FR : le vérificateur des planches reçues.
if [ -n "$2" ]; then $PY -I Scripts/micro/MicroVersions.py $P snapshot "$2"; fi      # 1 November 2026 : a note makes a version, labels unchanged add nothing. FR : une note crée une version, des masques inchangés n'ajoutent rien.
$PY -I Scripts/micro/MicroDoc.py $P
