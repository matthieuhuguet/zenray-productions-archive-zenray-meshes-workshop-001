import sys, json, collections, numpy as np
sys.path.insert(0,'.'); import WELD7 as W, TF7 as T
mesh, edge, mf = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]); opts = json.loads(sys.argv[4])
obj = W.GT+mesh+".obj"; m = T.AP.mesh(obj); zones = T.ANY.segment(m, 25.0, max(1,int(mf*len(m["F"]))), merge_deg=35.0, log=lambda s: None)
prs = W.corner_preps(m, zones, opts); lay, sa, poly = W.build_layout(m, prs); sol, lay2, dr, secs = W.solve_global(lay, edge); prsC = W.apply_counts(prs, sa, sol, lay2)
def cls(pr): return ("strip" if pr["strip"] else "true")+str(pr["K"] if pr["K"] in (3,4) else "n")+("_tiny" if len(pr["Z"])<=4 else "")
for tag, P_ in (("A", {z: T.prep(m, pr["Z"], edge, dict(T.OPTS, **opts)) for z, pr in prs.items()}), ("C", prsC)):
    agg = collections.defaultdict(lambda: [0,0,0,0,0.0])
    for z, pr in P_.items():
        if "fail" in pr: continue
        P3, Q, rep = T.fill(m, pr["Z"], edge, dict(T.OPTS, **opts), pr=pr); j = T.QS.stats(P3, Q)[2]; a = agg[cls(pr)]; a[0]+=1; a[1]+=len(Q); a[2]+=int((j<0).sum()); a[3]+=int((j<0.3).sum())
        a[4]+= np.mean([abs(sum(pr["e"][k:k+1]) - pr["sl"][k]/edge) / max(pr["sl"][k]/edge,1) for k in range(pr["K"])])
    print(tag, {k: "z%d q%d f%d s%d dev%.2f"%(a[0],a[1],a[2],a[3],a[4]/max(a[0],1)) for k,a in sorted(agg.items())})
