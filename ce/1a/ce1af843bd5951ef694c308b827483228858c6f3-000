    hidden = np.array([a["hidden"] for a in atoms]); V = {}
    for name in p["views"]:
        raw = np.load(f"{home}/02_masks/raw_{name}.npz")["labels"]; D = np.load(f"{home}/02_masks/regions_{name}.npz"); R, E = D["regions"], D["edges"].astype(np.float32) / 255; rawA = atom_of[np.clip(raw, 0, None)] * (raw >= 0) - (raw < 0); inside = R >= 0; rA, _ = M.align(rawA, inside, r, p["scale"]); Tr = np.load(f"{home}/02_masks/truth_{name}.npz")["labels"]; Tr = atom_of[np.clip(Tr, 0, None)] * (Tr >= 0) - (Tr < 0); Tr = np.where((Tr >= 0) & hidden[np.clip(Tr, 0, None)], -1, Tr); V[name] = (rA, E, inside, Tr, R)
    CACHE[params] = (p, r, hidden, V); return CACHE[params]
def one(a):
    params, over = a; p, r0, hidden, V = load(params); r = dict(r0); r.update(over); sc = p["scale"]; good = tot = 0; per = {}; bp = []; br = []; miss = 0
    wide = [0, 0]
