from concurrent.futures import ProcessPoolExecutor
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
sys.path.insert(0, ROOT + "/Scripts/micro"); import MicroCommon as C, MicroMasks as M, MicroTruth as T
CACHE = {}


def load(params):
    if params in CACHE: return CACHE[params]
    p, home = C.load(params); r = {k: p.get(k, v) for k, v in M.DEF.items()}; S = json.load(open(f"{home}/02_masks/shells.json")); atoms, defs = M.build_atoms(S, r); n = len(S["shells"]); atom_of = np.full(n + 1, -1)
