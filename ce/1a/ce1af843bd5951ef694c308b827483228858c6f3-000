        lab = M.snap(rA, E, ins, r, sc, hidden); ne = M.ndi.binary_dilation(E > r["edge_on"], iterations=int(round(p["support_tol_px"] * sc))); lab = M.clean_by_regions(lab, R, E, r, sc, ne); o, _ = T.score(lab, Tr, sc, direct=True); good += o["_good"]; tot += o["_total"]; bb = M.ndi.binary_dilation(T.bounds(Tr), iterations=2 * sc); m_ = (lab >= 0) & (Tr >= 0) & ~bb; wide[0] += int((lab[m_] == Tr[m_]).sum()); wide[1] += int(m_.sum()); per[name] = round(o["_good"] / max(o["_total"], 1), 4); bp.append(o["bd_precision"]); br.append(o["bd_recall"]); miss += len(o["parts_missed"])
    return dict(over=over, accuracy=round(good / max(tot, 1), 5), acc2=round(wide[0] / max(wide[1], 1), 5), per=per, prec=round(float(np.mean(bp)), 3), rec=round(float(np.mean(br)), 3), missed=miss)


if __name__ == "__main__":
