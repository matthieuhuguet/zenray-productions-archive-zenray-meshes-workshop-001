"""Extract OBJ groups of the car (triangulated, reindexed) ; FR : extrait des groupes OBJ de la voiture, tries en triangles.
python carx.py out.obj GROUP [GROUP ...]   (regex allowed with re:PATTERN)"""
import re, sys, collections
SRC = "/Users/zenray/.claude/tmp/tmp-zenray-meshes/versions/ZenRayCar_v752.obj"
def load(src=SRC):
    V = []; G = collections.OrderedDict(); cur = None
    for l in open(src):
        t = l.split()
        if not t: continue
        if t[0] == "v": V.append([float(x) for x in t[1:4]])
        elif t[0] in ("g", "o"): cur = t[1]; G.setdefault(cur, [])
        elif t[0] == "f": G.setdefault(cur, []).append([int(x.split("/")[0]) - 1 for x in t[1:]])
    return V, G
def extract(V, G, names, out, tag_groups=False):
    sel = []
    for n in names:
        sel += [g for g in G if (re.fullmatch(n[3:], g) if n.startswith("re:") else g == n)]
    remap = {}; vs = []; lines = []; gof = []
    for g in sel:
        for f in G[g]:
            for k in range(1, len(f) - 1):
                tri = [f[0], f[k], f[k + 1]]
                for v in tri:
                    if v not in remap: remap[v] = len(vs); vs.append(V[v])
                lines.append([remap[v] for v in tri]); gof.append(g)
    with open(out, "w") as o:
        for v in vs: o.write("v %.9g %.9g %.9g\n" % tuple(v))
        for tr, g in zip(lines, gof): o.write("f %d %d %d\n" % (tr[0] + 1, tr[1] + 1, tr[2] + 1))
    return sel, vs, lines, gof
if __name__ == "__main__":
    V, G = load(); sel, vs, lines, gof = extract(V, G, sys.argv[2:], sys.argv[1]); print(len(sel), "groups", len(vs), "verts", len(lines), "tris")
