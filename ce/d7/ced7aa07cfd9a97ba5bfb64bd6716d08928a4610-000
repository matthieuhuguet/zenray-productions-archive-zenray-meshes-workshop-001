def truth_view(a):
    home, v, r, sc, methods = a; T = np.load(f"{home}/02_masks/truth_{v}.npz")["labels"]; E, inside = load_view(home, v, r, sc); h, w = min(T.shape[0], E.shape[0]), min(T.shape[1], E.shape[1]); T = T[:h, :w].astype(np.int32); E = E[:h, :w]; inside = inside[:h, :w]; af = f"{home}/02_masks/ambig_{v}.npz"; amb = np.load(af)["ambig"][:h, :w] if os.path.exists(af) else np.zeros(T.shape, bool); D = degrade(T, r, sc, r["F_sim_seed"] + sum(map(ord, v))); out = {}
