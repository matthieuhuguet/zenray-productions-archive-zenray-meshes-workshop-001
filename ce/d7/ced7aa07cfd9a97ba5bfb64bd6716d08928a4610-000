def degrade(T, r, sc, seed):
    """a mask as a model draws it, from a true one : the view shifted, each cell shifted and sheared, the borders wavering. FR : un masque tel qu'un modèle le dessine : vue décalée, cellules déplacées, bords qui ondulent."""
    rng = np.random.default_rng(seed); H, W = T.shape; cells, piece = split_cells(T); dv = rng.uniform(-1, 1, 2) * r["F_sim_view_px"] * sc; best = np.full(T.shape, -1e9, np.float32); out = np.zeros(T.shape, np.int32); pad = int((r["F_sim_view_px"] + r["F_sim_cell_px"] + 2) * sc)
    for i, sl in enumerate(ndi.find_objects(cells)):
        if sl is None: continue
        y0, y1, x0, x1 = max(sl[0].start - pad, 0), min(sl[0].stop + pad, H), max(sl[1].start - pad, 0), min(sl[1].stop + pad, W); m = cells[y0:y1, x0:x1] == i + 1; sdf = (ndi.distance_transform_edt(m) - ndi.distance_transform_edt(~m)).astype(np.float32); t = dv + rng.uniform(-1, 1, 2) * r["F_sim_cell_px"] * sc; Mi = np.eye(2) + rng.uniform(-1, 1, (2, 2)) * r["F_sim_matrix"]; c = np.array(m.shape) / 2.0; Inv = np.linalg.inv(Mi); sdf = ndi.affine_transform(sdf, Inv, offset=c - Inv @ (c + t), order=1, mode="nearest"); crop = best[y0:y1, x0:x1]; k = sdf > crop; crop[k] = sdf[k]; out[y0:y1, x0:x1][k] = i + 1
    res = np.where(best > 0, out, 0); wav = r["F_sim_wave_px"] * sc; yy, xx = np.mgrid[:H, :W]; dy = r["F_sim_wobble_px"] * sc * np.sin(xx / wav * 2 * np.pi + rng.uniform(0, 6)) * np.cos(yy / wav * 1.3 + rng.uniform(0, 6)); dx = r["F_sim_wobble_px"] * sc * np.sin(yy / wav * 2 * np.pi + rng.uniform(0, 6)) * np.cos(xx / wav * 1.7 + rng.uniform(0, 6)); res = ndi.map_coordinates(res, [yy + dy, xx + dx], order=0, mode="nearest"); pc = piece.copy(); pc[0] = -1; return pc[res]


def truth_accuracy(R, T, amb, sc, band):
    """share of the true pieces found, away from a band of the sheet around the true borders ; pixels shared by two pieces are not judged. FR : part de la vérité retrouvée, hors d'une bande autour des vrais bords."""
