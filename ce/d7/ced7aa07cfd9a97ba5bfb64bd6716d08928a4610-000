DEF = dict(F_method="snap", F_line=0.3, F_reach_px=5.0, F_view_shift_px=8.0, F_cell_rounds=4, F_cell_reach_px=4.0, F_cell_area_px=30.0, F_cell_identity=0.04, F_cell_shift_max_px=5.0, F_cell_matrix_max=0.05, F_band_px=2.0, F_prior=1.0, F_prior_sigma_px=1.2, F_smooth_px=1.0, F_sil_smooth_px=1.5, F_thin_keep_px=2.0, F_gate=0.999, F_gate_band_px=2, F_sim_view_px=3.0, F_sim_cell_px=2.0, F_sim_matrix=0.01, F_sim_wobble_px=1.0, F_sim_wave_px=40.0, F_sim_seed=7)
