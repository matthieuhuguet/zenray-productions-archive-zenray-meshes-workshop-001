def settings(p): return {k: p.get(k, v) for k, v in DEF.items()}
def borders(L):
    b = np.zeros(L.shape, bool); h = L[:, 1:] != L[:, :-1]; v = L[1:, :] != L[:-1, :]; b[:, 1:] |= h; b[:, :-1] |= h; b[1:, :] |= v; b[:-1, :] |= v; return b


def line_map(E, inside, r, sc):
    """the lines of the sheet, one pixel wide, with the silhouette, which is a line too. FR : les traits de la planche, avec la silhouette."""
    L = thin(E > r["F_line"]); return L | (inside ^ ndi.binary_erosion(inside))


def calage(L, lines, inside, r, sc):
    """the fitting score : of the inner borders of the mask, the share lying on a line of the sheet, among those with a line within reach ; the others have no line to lie on, they are counted apart. FR : le score de calage, part des bords posés sur un trait, parmi ceux qui ont un trait à portée."""
    bd = borders(L) & ndi.binary_erosion(inside, iterations=2 * sc) & (L >= 0); d = ndi.distance_transform_edt(~lines)[bd]; near = d <= r["F_reach_px"] * sc
    if not len(d): return dict(on_1px=0.0, on_half_px=0.0, shown=0.0, points=0)
    return dict(on_1px=round(float((d[near] <= sc).mean()), 5) if near.any() else 0.0, on_half_px=round(float((d[near] <= sc / 2).mean()), 5) if near.any() else 0.0, shown=round(float(near.mean()), 4), points=int(bd.sum() / sc))


def split_cells(L):
    """connected cells of the mask, each with its piece. FR : les cellules connexes du masque, chacune avec sa pièce."""
    cells = np.zeros(L.shape, np.int32); piece = [-1]; nxt = 1
    for a in np.unique(L[L >= 0]):
        cc, n = ndi.label(L == a)
        if n: k = cc > 0; cells[k] = cc[k] + nxt - 1; piece += [int(a)] * n; nxt += n
    return cells, np.array(piece)


def view_shift(L, d, r, sc):
    """one shift for the whole view : the model moves a view as a block. FR : un décalage pour toute la vue."""
    ys, xs = np.nonzero(borders(L) & (L >= 0))
    if not len(ys): return 0, 0
    rng = np.random.default_rng(1); k = rng.choice(len(ys), min(len(ys), 12000), replace=False); ys, xs = ys[k], xs[k]; H, W = L.shape; cap = r["F_reach_px"] * sc; best = (1e18, 0, 0); R = int(r["F_view_shift_px"] * sc); step = max(sc // 2, 1)
    for dy in range(-R, R + 1, step):
        for dx in range(-R, R + 1, step):
            v = np.minimum(d[np.clip(ys + dy, 0, H - 1), np.clip(xs + dx, 0, W - 1)], cap).mean() + 1e-3 * (abs(dy) + abs(dx)) / sc
            if v < best[0]: best = (v, dy, dx)
    return best[1], best[2]


def move_labels(L, dy, dx):
    if not dy and not dx: return L
    return ndi.shift(L, (dy, dx), order=0, cval=-1, mode="constant", prefilter=False).astype(L.dtype)


def fit_cell(q, iy, ix, d, r, sc):
    """robust closest point on the lines : a shift and a 2 x 2 matrix pulled to identity. FR : point le plus proche, robuste : un décalage et une matrice tirés vers l'identité."""
    c = q.mean(0); M = np.eye(2); t = np.zeros(2); H, W = d.shape; lam = r["F_cell_identity"] * len(q) * 100.0 / max(np.ptp(q, axis=0).max(), 1.0)
    for it in range(int(r["F_cell_rounds"])):
        p = (q - c) @ M.T + c + t; pi = np.clip(np.round(p).astype(int), 0, [H - 1, W - 1]); dist = d[pi[:, 0], pi[:, 1]]; reach = r["F_cell_reach_px"] * sc * (1.0 - 0.15 * it); ok = dist <= reach
        if ok.sum() < 6: break
        tgt = np.stack([iy[pi[ok, 0], pi[ok, 1]], ix[pi[ok, 0], pi[ok, 1]]], 1).astype(float); w = (1 - (dist[ok] / reach) ** 2) ** 2; u = q[ok] - c; A = np.zeros((2 * len(u) + 4, 6)); b = np.zeros(2 * len(u) + 4); s = np.sqrt(w)
        A[: len(u), 0] = u[:, 0] * s; A[: len(u), 1] = u[:, 1] * s; A[: len(u), 4] = s; b[: len(u)] = (tgt[:, 0] - c[0]) * s; A[len(u): 2 * len(u), 2] = u[:, 0] * s; A[len(u): 2 * len(u), 3] = u[:, 1] * s; A[len(u): 2 * len(u), 5] = s; b[len(u): 2 * len(u)] = (tgt[:, 1] - c[1]) * s
        for k in range(4): A[2 * len(u) + k, k] = lam
        b[2 * len(u)] = lam; b[2 * len(u) + 3] = lam; x = np.linalg.lstsq(A, b, rcond=None)[0]; M = np.array([[x[0], x[1]], [x[2], x[3]]]); t = x[4:6]; dm = r["F_cell_matrix_max"]; M = np.clip(M, np.eye(2) - dm, np.eye(2) + dm); t = np.clip(t, -r["F_cell_shift_max_px"] * sc, r["F_cell_shift_max_px"] * sc)
    return c, M, t


def fit_cells(L, lines, inside, r, sc):
    """each cell laid on the lines ; overlaps and gaps are settled by the signed distance, the deepest cell wins. FR : chaque cellule posée sur les traits ; chevauchements et trous réglés par la distance signée."""
    cells, piece = split_cells(L); n = len(piece) - 1; d, (iy, ix) = ndi.distance_transform_edt(~lines, return_indices=True); H, W = L.shape; best = np.full(L.shape, -1e9, np.float32); out = np.zeros(L.shape, np.int32); pad = int(r["F_cell_shift_max_px"] * sc) + 3 * sc; area_min = r["F_cell_area_px"] * sc * sc; moved = 0
    for i, sl in enumerate(ndi.find_objects(cells)):
        if sl is None: continue
        y0, y1, x0, x1 = max(sl[0].start - pad, 0), min(sl[0].stop + pad, H), max(sl[1].start - pad, 0), min(sl[1].stop + pad, W); m = cells[y0:y1, x0:x1] == i + 1; sdf = ndi.distance_transform_edt(m) - ndi.distance_transform_edt(~m); c_, Mi, ti = None, np.eye(2), np.zeros(2)
        if m.sum() >= area_min:
            ys, xs = np.nonzero(m ^ ndi.binary_erosion(m)); q = np.stack([ys + y0, xs + x0], 1).astype(float)
            if len(q) > 900: q = q[np.random.default_rng(i).choice(len(q), 900, replace=False)]
            c_, Mi, ti = fit_cell(q, iy, ix, d, r, sc)
            if np.abs(ti).max() > 0.2 or np.abs(Mi - np.eye(2)).max() > 1e-3: moved += 1
        if c_ is not None:      # output pixel -> input pixel, in the crop. FR : pixel de sortie vers pixel d'entrée, dans le recadrage.
            Inv = np.linalg.inv(Mi); cc_ = c_ - np.array([y0, x0]); off = cc_ - Inv @ (cc_ + ti); sdf = ndi.affine_transform(sdf.astype(np.float32), Inv, offset=off, order=1, mode="nearest")
        crop = best[y0:y1, x0:x1]; k = sdf > crop; crop[k] = sdf[k]; out[y0:y1, x0:x1][k] = i + 1
    res = np.where(best > 0, out, 0); hole = inside & (res == 0)
    if hole.any() and (res > 0).any(): iy2, ix2 = ndi.distance_transform_edt(res == 0, return_distances=False, return_indices=True); res[hole] = res[iy2[hole], ix2[hole]]
    res[~inside] = 0; piece_ = piece.copy(); piece_[0] = -1; return piece_[res], moved, n


def snap(L, E, inside, r, sc):
    """the border settles on the line within a narrow band ; without a line it stays where the mask put it, its old place being a small ridge. FR : le bord se pose sur le trait dans une bande étroite ; sans trait il reste à sa place, qui forme une petite crête."""
    cells, piece = split_cells(L); bd = borders(cells) ; dt = ndi.distance_transform_edt(~bd); R = r["F_band_px"] * sc; idx = np.arange(1, len(piece)); top = ndi.maximum(dt, cells, idx) if len(idx) else np.array([]); th = np.minimum(R, 0.6 * np.asarray(top)); thr = np.zeros(len(piece)); thr[1:] = th; marker = (dt >= thr[cells]) & (cells > 0); elev = ndi.gaussian_filter(E.astype(np.float32), 0.5) + r["F_prior"] * np.exp(-(dt / (r["F_prior_sigma_px"] * sc)) ** 2); lab = watershed(elev, np.where(marker, cells, 0), mask=inside); pc = piece.copy(); pc[0] = -1; return pc[lab]


def smooth(L, inside, r, sc):
    """a tiny blur per cell removes the pixel stairs of the flood ; a cell too thin to survive it keeps its pixels. FR : un très léger flou par cellule retire les marches ; une cellule trop fine garde ses pixels."""
    sig = r["F_smooth_px"] * sc
    if sig <= 0: return L
    cells, piece = split_cells(L); H, W = L.shape; best = np.zeros(L.shape, np.float32); out = np.zeros(L.shape, np.int32); pad = int(3 * sig) + 2
    for i, sl in enumerate(ndi.find_objects(cells)):
        if sl is None: continue
        y0, y1, x0, x1 = max(sl[0].start - pad, 0), min(sl[0].stop + pad, H), max(sl[1].start - pad, 0), min(sl[1].stop + pad, W); g = ndi.gaussian_filter((cells[y0:y1, x0:x1] == i + 1).astype(np.float32), sig); c = best[y0:y1, x0:x1]; k = g > c; c[k] = g[k]; out[y0:y1, x0:x1][k] = i + 1
    res = np.where(inside, out, 0); pc = piece.copy(); pc[0] = -1; res = pc[res]; lost = np.setdiff1d(np.unique(L[L >= 0]), np.unique(res[res >= 0]))
    for a in lost: res[L == a] = a
    return res


def run_view(L, E, inside, method, r, sc):
    """one view through the chosen moves. FR : une vue à travers les étapes choisies."""
    lines = line_map(E, inside, r, sc); d = ndi.distance_transform_edt(~lines); dy, dx = 0, 0; moved = 0; n = 0; X = np.where(inside, L, -1)
    if X[inside].size and (X[inside] < 0).any() and (X >= 0).any(): iy, ix = ndi.distance_transform_edt(X < 0, return_distances=False, return_indices=True); hole = inside & (X < 0); X[hole] = X[iy[hole], ix[hole]]
    if method != "none": dy, dx = view_shift(X, d, r, sc); X = move_labels(L, dy, dx); X = np.where(inside, X, -1); hole = inside & (X < 0)
    if method != "none" and hole.any(): iy, ix = ndi.distance_transform_edt(X < 0, return_distances=False, return_indices=True); X[hole] = X[iy[hole], ix[hole]]
    if "cells" in method: X, moved, n = fit_cells(X, lines, inside, r, sc)
    if "snap" in method: X = snap(X, E, inside, r, sc)
    if method != "none": X = smooth(X, inside, r, sc)
    return X, dict(view_shift_px=[round(dy / sc, 2), round(dx / sc, 2)], cells_moved=moved, cells=n, score=calage(X, lines, inside, r, sc))


def smooth_silhouette(inside, r, sc):
    """the silhouette of the sheet wavers by a pixel where the object fades into its shadow : a small blur removes the waves, a part too thin for the blur keeps its pixels. FR : la silhouette ondule d'un pixel là où l'objet se perd dans son ombre ; un léger flou retire les ondes, une partie trop fine garde ses pixels."""
    sig = r["F_sil_smooth_px"] * sc
    if sig <= 0: return inside
    g = ndi.gaussian_filter(inside.astype(np.float32), sig) > 0.5; k = int(r["F_thin_keep_px"] * sc); thick = ndi.binary_opening(inside, iterations=k) if k else inside; return g | (inside & ~thick)


def load_view(home, v, r=None, sc=3):
