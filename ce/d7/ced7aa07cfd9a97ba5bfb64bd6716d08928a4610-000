def truth(params):
    """the tournament on a known truth, green when the fit beats no fit and reaches the truth within 1 pixel. FR : le tournoi sur une vérité connue."""
    p, home = C.load(params); r = settings(p); sc = p["scale"]
    with ProcessPoolExecutor(6) as ex: res = list(ex.map(truth_view, [(home, v, r, sc, METHODS) for v in p["views"]]))
    tab = {}
    for m in METHODS:
        G = {b: sum(o[m][str(b)][0] for _, o in res) for b in (1, 2, 3)}; N = {b: sum(o[m][str(b)][1] for _, o in res) for b in (1, 2, 3)}; tab[m] = {f"within_{b}px": round(G[b] / max(N[b], 1), 5) for b in (1, 2, 3)}; tab[m]["calage_mean"] = round(float(np.mean([o[m]["calage"] for _, o in res])), 5); print(m, tab[m])
    best = max(METHODS, key=lambda m: (tab[m][f"within_{int(r['F_gate_band_px'])}px"], tab[m]["within_1px"])); json.dump(dict(table=tab, best=best, simulated=dict(view_px=r["F_sim_view_px"], cell_px=r["F_sim_cell_px"], matrix=r["F_sim_matrix"], wobble_px=r["F_sim_wobble_px"])), open(f"{home}/06_checks/cut_fit_truth.json", "w"), indent=1); gate = tab[best][f"within_{int(r['F_gate_band_px'])}px"]; ok = best != "none" and tab[best]["within_1px"] > tab["none"]["within_1px"] and gate >= r["F_gate"]; print("best", best, "within", int(r["F_gate_band_px"]), "px", gate, "gate", r["F_gate"], "GREEN" if ok else "RED"); return ok


def export_ids(params, out):
    """the cells as a 16 bit id image in the frame of the sheet, for PerIslandAlign.py --ids. FR : les cellules en image d'identifiants 16 bits."""
    p, home = C.load(params); sc = p["scale"]; sheet = Image.open(C.abspath(p["sheet"])); rects = {x["name"]: x["rect"] for x in json.load(open(C.abspath(p["views_dir"]) + "/sheet.json"))["panels"]}; A = np.zeros((sheet.size[1], sheet.size[0]), np.uint16); nxt = 1
    for v in p["views"]:
        L = np.load(f"{home}/02_masks/labels_raw_{v}.npz" if os.path.exists(f"{home}/02_masks/labels_raw_{v}.npz") else f"{home}/02_masks/labels_{v}.npz")["labels"]; m = L[::sc, ::sc]; cells, _ = split_cells(m); x0, y0, x1, y1 = rects[v]; h, w = min(m.shape[0], y1 - y0), min(m.shape[1], x1 - x0); c = cells[:h, :w]; A[y0:y0 + h, x0:x0 + w] = np.where(c > 0, c + nxt - 1, 0); nxt += int(c.max())
    Image.fromarray(A).save(out); print("cells", nxt - 1, out)


