# ---------- files ----------
def write_obj(path, P, Q):
    with open(path, "w") as f:
        f.write("".join("v %.6f %.6f %.6f\n" % tuple(p) for p in P))
        f.write("".join("f " + " ".join(str(int(i) + 1) for i in q) + "\n" for q in Q))


def read_obj(path):
    V, Q = [], []
    for line in open(path):
        if line.startswith("v "): V.append([float(x) for x in line.split()[1:4]])
        elif line.startswith("f "): Q.append([int(t.split("/")[0]) - 1 for t in line.split()[1:]])
    return np.array(V, float), Q


def compact(P, Q):
    used = np.unique(np.concatenate([np.asarray(q) for q in Q])); m = -np.ones(len(P), np.int64); m[used] = np.arange(len(used))
    return np.asarray(P, float)[used], [[int(m[v]) for v in q] for q in Q]


def save_cand(path, P, Q, name="CAND"):
    np.savez(path, P=np.asarray(P, np.float32), Q=np.array([list(q) for q in Q], dtype=object), names=np.array([name] * len(Q)))


# ---------- Houdini bridge ----------
def hou(code, timeout=600):
    with socket.create_connection(("127.0.0.1", PARAMS["bridge_port"]), timeout=timeout) as s:
        s.sendall((json.dumps({"op": "hom", "code": code}) + "\n").encode()); raw = b""
        while not raw.endswith(b"\n"):
            ch = s.recv(1 << 20)
            if not ch: break
            raw += ch
    r = json.loads(raw.decode())
    if not r.get("ok"): raise RuntimeError(str(r.get("error") or r)[:800])
    return r.get("result")


# ---------- mesh helpers ----------
def edge_count(Q):
    E = defaultdict(int)
    for q in Q:
        for k in range(len(q)): E[(min(q[k], q[(k + 1) % len(q)]), max(q[k], q[(k + 1) % len(q)]))] += 1
    return E


def boundary_verts(Q):
    return np.array(sorted({v for e, c in edge_count(Q).items() if c == 1 for v in e}), np.int64)


def vnormals(P, Q):
    vn = np.zeros((len(P), 3))
    for q in Q:
        if len(q) == 4: n = np.cross(P[q[2]] - P[q[0]], P[q[3]] - P[q[1]])
        else: n = np.cross(P[q[1]] - P[q[0]], P[q[2]] - P[q[0]])
        for v in q: vn[v] += n
    return vn / (np.linalg.norm(vn, axis=1, keepdims=True) + 1e-12)


def adjacency(P, Q):
    E = np.array(list(edge_count(Q).keys()), np.int64); n = len(P)
    Wm = coo_matrix((np.ones(2 * len(E)), (np.r_[E[:, 0], E[:, 1]], np.r_[E[:, 1], E[:, 0]])), shape=(n, n)).tocsr()
    return Wm, np.asarray(Wm.sum(1)).ravel()


def tris(Q): return np.array([[q[0], q[k], q[k + 1]] for q in Q for k in range(1, len(q) - 1)], np.int64)


def densify(poly, step=0.002, closed=False):
    X = np.vstack([poly, poly[:1]]) if closed else np.asarray(poly)
    out = []
    for a, b in zip(X[:-1], X[1:]):
        n = max(1, int(np.ceil(np.linalg.norm(b - a) / step))); out.append(a + (b - a) * np.linspace(0, 1, n, endpoint=False)[:, None])
    out.append(X[-1:]); return np.vstack(out)


# ---------- sculpt ----------
class Sculpt:
    def __init__(self, path=None):
        d = np.load(path or PARAMS["sculpt"]); P = d["P"].astype(float); F = d["F"].astype(np.int64)
        lo, hi = np.array(PARAMS["crop_lo"]), np.array(PARAMS["crop_hi"]); c = P[F].mean(1); F = F[((c > lo) & (c < hi)).all(1)]
        used, inv = np.unique(F, return_inverse=True); self.P = P[used]; self.F = inv.reshape(-1, 4)
        n = np.cross(self.P[self.F[:, 2]] - self.P[self.F[:, 0]], self.P[self.F[:, 3]] - self.P[self.F[:, 1]]); vn = np.zeros_like(self.P)
        for j in range(4): np.add.at(vn, self.F[:, j], n)
        self.N = vn / (np.linalg.norm(vn, axis=1, keepdims=True) + 1e-12); self.kd = cKDTree(self.P)

    def project(self, X, iters=2, nref=None):
        """Nearest sculpt vertex whose normal agrees with nref (dot > 0.3, among the 16 nearest), then its tangent plane ; a point
        farther than max_proj_m from the sculpt keeps its place (no jump onto another layer : bumper, wheel well), 28 October 2026."""
        X0 = np.asarray(X, float); X = X0.copy(); k = 16
        for _ in range(iters):
            d, i = self.kd.query(X, k=k)
            if nref is not None:
                ok = (self.N[i] * np.asarray(nref)[:, None, :]).sum(2) > 0.3; d = np.where(ok, d, np.inf)
            j = np.argmin(d, 1); ii = i[np.arange(len(X)), j]; v = self.P[ii]; n = self.N[ii]
            Y = X - ((X - v) * n).sum(1)[:, None] * n; far = ~np.isfinite(d[np.arange(len(X)), j]) | (np.linalg.norm(Y - X0, axis=1) > PARAMS["max_proj_m"])
            Y[far] = X[far]; X = Y
        return X

    def dist_mm(self, X): return np.linalg.norm(self.project(X) - X, axis=1) * 1000


_SC = None
def sculpt():
    global _SC
    if _SC is None: _SC = Sculpt()
    return _SC


# ---------- contours (the shared sampling) ----------
def load_sheet(path):
    d = np.load(path); P = d["P"]; F = d["F"]; GI = d["GI"]
    used, inv = np.unique(F.ravel(), return_inverse=True); return P[used].astype(float), inv.reshape(-1, 4).tolist(), GI[used], d["arch"]


_CT = None
def contours(path=RT + "fender/sheet_coarse.npz"):
    """Coarse sheet projected on the sculpt : boundary loop points (shared with the neighbours), crease row, patch grid."""
    global _CT
    if _CT is None:
        P, Q, GI, arch = load_sheet(path); nT = vnormals(P, Q); Pp = sculpt().project(P, nref=nT); b = boundary_verts(Q)
        cr = np.nonzero(GI[:, 2] == GI[:, 3])[0]; cr = cr[np.argsort(Pp[cr, 2])]
        # ordered boundary loop
        E = edge_count(Q); nb = defaultdict(list)
        for (u, w), c in E.items():
            if c == 1: nb[u].append(w); nb[w].append(u)
        loop = [b[0]]; prev = -1
        while True:
            nx = [w for w in nb[loop[-1]] if w != prev]
            if not nx or nx[0] == loop[0]: break
            prev = loop[-1]; loop.append(nx[0])
        if PARAMS["contour_sigma"] > 0:   # fair contours : the template arcs plus the sculpt offset along the normal, smoothed along the chain (28 October 2026)
            from scipy.ndimage import gaussian_filter1d
            off = ((Pp - P) * nT).sum(1); sg = PARAMS["contour_sigma"]
            Pp[cr] = P[cr] + gaussian_filter1d(off[cr], sg, mode="nearest")[:, None] * nT[cr]
            lp = np.array(loop); Pp[lp] = P[lp] + gaussian_filter1d(off[lp], sg, mode="wrap")[:, None] * nT[lp]
        _CT = {"P": Pp, "Q": Q, "GI": GI, "arch": arch, "bnd": b, "loop": np.array(loop), "crease": cr,
               "loop_dense": densify(Pp[loop], 0.002, True), "crease_dense": densify(Pp[cr], 0.002)}
        _CT["kd_loop"] = cKDTree(_CT["loop_dense"]); _CT["kd_crease"] = cKDTree(_CT["crease_dense"])
    return _CT


# ---------- phases ----------
def p2_conform(P, Q):
    """Boundary vertices onto the contour loop (nearest point of the dense loop), then the ring next to it relaxed."""
    C = contours(); P = np.asarray(P, float).copy(); b = boundary_verts(Q)
    _, i = C["kd_loop"].query(P[b]); P[b] = C["loop_dense"][i]
    Wm, deg = adjacency(P, Q); near = np.zeros(len(P), bool); near[b] = True
    ring = (Wm @ near.astype(float)) > 0; ring &= ~near
    for _ in range(4):
        L = (Wm @ P) / np.maximum(deg, 1)[:, None]; P[ring] = sculpt().project(0.5 * P[ring] + 0.5 * L[ring], nref=vnormals(P, Q)[ring])
    return P


def p3_fair(P, Q, fixed=None):
    """Fairing : Taubin steps, then a blend toward the sculpt (fit weight) ; boundary fixed ; vertices on the crease kept on it."""
    C = contours(); S = sculpt(); P = np.asarray(P, float).copy(); b = boundary_verts(Q)
    fix = np.zeros(len(P), bool); fix[b] = True
    if fixed is not None: fix[fixed] = True
    dc, ic = C["kd_crease"].query(P); onc = (dc * 1000 < PARAMS["crease_snap_mm"]) & ~fix
    P[onc] = C["crease_dense"][ic[onc]]; Wm, deg = adjacency(P, Q); w = PARAMS["fit_weight"]
    for it in range(PARAMS["fair_iter"]):
        for lam in (PARAMS["fair_step"], -PARAMS["fair_step"] - 0.03):
            L = (Wm @ P) / np.maximum(deg, 1)[:, None] - P; X = P + lam * L
            X[fix] = P[fix]; P = X
        free = ~fix; P[free] = (1 - w) * P[free] + w * S.project(P[free], nref=vnormals(P, Q)[free])
        _, ic = C["kd_crease"].query(P[onc]); P[onc] = C["crease_dense"][ic]
    return P


def p4_shell(P, Q):
    """Closed shell : inner copy offset along the vertex normals, walls on the open edges ; outward by signed volume."""
    P = np.asarray(P, float); vn = vnormals(P, Q)
    if ((P - P.mean(0)) * vn).sum(1).mean() < 0: Q = [q[::-1] for q in Q]; vn = -vn
    n = len(P); PL = np.vstack([P, P - PARAMS["shell_m"] * vn]); S = [list(q) for q in Q] + [[v + n for v in q[::-1]] for q in Q]
    D = set(); E = edge_count(Q)
    for q in Q:
        for k in range(len(q)): D.add((q[k], q[(k + 1) % len(q)]))
    for (u, w_), c in E.items():
        if c == 1:
            if (u, w_) not in D: u, w_ = w_, u
            S.append([w_, u, u + n, w_ + n])
    vol = sum(np.dot(PL[q[0]], np.cross(PL[q[k]], PL[q[k + 1]])) for q in S for k in range(1, len(q) - 1))
    if vol < 0: S = [q[::-1] for q in S]
    return PL, S


# ---------- measures ----------
META = json.load(open(W + "frame/frame.json")); SHEET = json.load(open(W + "views/sheet.json"))


def _frame(name, shape):
    v = [v for v in META["views"] if v["name"] == name][0]; lo = np.array(META["lo"]); D = np.array(META["dims_m"]); hi = lo + D
    rx, uy = np.array(v["rx"]), np.array(v["uy"]); a, b = int(np.argmax(abs(rx))), int(np.argmax(abs(uy)))
    umin = lo[a] if rx[a] > 0 else -hi[a]; vmax = hi[b] if uy[b] > 0 else -lo[b]; s = v["px_per_m"]; bb = v["bbox"]; R = int(max(shape))
    xc, yc = (bb[0] + bb[2]) / 2, (bb[1] + bb[3]) / 2; cu = umin + D[a] / 2 + (R / 2 - xc) / s; cv = vmax - D[b] / 2 + (yc - R / 2) / s
    return v, rx, uy, s, R, cu, cv


def px_world(name, shape, px, py):
    v, rx, uy, s, R, cu, cv = _frame(name, shape); u = cu + (np.asarray(px) - R / 2) / s; w = cv - (np.asarray(py) - R / 2) / s
    return u[:, None] * rx + w[:, None] * uy


_REF = {}
def ref_mask(name):
    if name not in _REF: _REF[name] = np.asarray(Image.open(W + "frame/mask_%s.png" % name)) > 127
    return _REF[name]


def outline_top_mm(P):
    """Candidate outer x per z against the reference top silhouette outline (+x side), where the candidate is the outline."""
    m = ref_mask("top"); ys, xs = np.nonzero(m); Wp = px_world("top", m.shape, xs, ys); Wp = Wp[Wp[:, 0] > 0]
    b = PARAMS["outline_bin_m"]; zr = np.arange(P[:, 2].min(), P[:, 2].max(), b); d = []
    for z in zr:
        c = P[(P[:, 2] >= z) & (P[:, 2] < z + b)]; r = Wp[(Wp[:, 2] >= z) & (Wp[:, 2] < z + b)]
        if len(c) and len(r) and abs(c[:, 0].max() - r[:, 0].max()) < 0.05: d.append(abs(c[:, 0].max() - r[:, 0].max()))
    return round(float(np.mean(d) * 1000), 2) if d else None


def shading_ratio(P, Q):
    """High frequency shading energy of the candidate in the left view, against the reference grey image on the same footprint."""
    import Raster
    from SheetScore import render_in_panel
    name = "left"; ref = ref_mask(name); v = [v for v in META["views"] if v["name"] == name][0]
    pan = [p for p in SHEET["panels"] if p["name"] == name][0]
    rg = np.asarray(Image.open(W + "views/%02d_%s_rgb.png" % (pan["index"], name)).convert("L"), float)
    r = Raster.Renderer(np.asarray(P, np.float32), tris(Q), smooth_deg=40.0); M, img = render_in_panel(r, META, v, ref.shape); r.release()
    fp = ndi.binary_erosion(M, iterations=4) & ref
    if fp.sum() < 50: return None
    s = PARAMS["hf_sigma_px"]; ci = img.astype(float); hc = ci - ndi.gaussian_filter(ci, s); hr = rg - ndi.gaussian_filter(rg, s)
    return round(float(np.sqrt((hc[fp] ** 2).mean()) / max(np.sqrt((hr[fp] ** 2).mean()), 1e-6)), 3)


def fairness(P, Q):
    """p95 dihedral angle (degrees) between neighbour faces, away from the crease (15 mm)."""
    C = contours(); fn = []
    for q in Q:
        n = np.cross(P[q[2]] - P[q[0]], P[q[-1]] - P[q[1]]) if len(q) == 4 else np.cross(P[q[1]] - P[q[0]], P[q[2]] - P[q[0]])
        fn.append(n / (np.linalg.norm(n) + 1e-12))
    fn = np.array(fn); ef = defaultdict(list)
    for i, q in enumerate(Q):
        for k in range(len(q)): ef[(min(q[k], q[(k + 1) % len(q)]), max(q[k], q[(k + 1) % len(q)]))].append(i)
    ang = []; mids = []
    for e, f in ef.items():
        if len(f) == 2: ang.append(np.degrees(np.arccos(np.clip(fn[f[0]] @ fn[f[1]], -1, 1)))); mids.append((P[e[0]] + P[e[1]]) / 2)
    ang = np.array(ang); dc, _ = C["kd_crease"].query(np.array(mids)); ang = ang[dc > 0.015]
    el = np.mean([np.linalg.norm(P[e[0]] - P[e[1]]) for e in ef])
    return round(float(np.percentile(ang, 95)), 2), round(float(el * 1000), 1)


def crease_on_edges(P, Q):
    """Share of the crease (dense samples) lying on candidate edges within 1.5 mm : a crease needs an edge loop to stay sharp."""
    C = contours(); E = np.array(list(edge_count(Q).keys())); a, b = P[E[:, 0]], P[E[:, 1]]; mid = (a + b) / 2
    kd = cKDTree(mid); X = C["crease_dense"]; _, idx = kd.query(X, k=8); best = np.full(len(X), 9.0)
    for j in range(8):
        aa, bb = a[idx[:, j]], b[idx[:, j]]; ab = bb - aa; t = np.clip(((X - aa) * ab).sum(1) / ((ab * ab).sum(1) + 1e-12), 0, 1)
        best = np.minimum(best, np.linalg.norm(aa + ab * t[:, None] - X, axis=1))
    return round(float((best < 0.0015).mean()), 3)


def conform(P, Q):
    """Boundary vertices against the contour loop : p95 distance (mm), and the share of the shared boundary samples that have a vertex (weld ready)."""
    C = contours(); b = boundary_verts(Q)
    if not len(b): return None, 0.0
    d, _ = C["kd_loop"].query(P[b]); dd, _ = cKDTree(P[b]).query(C["P"][C["bnd"]])
    return round(float(np.percentile(d, 95) * 1000), 2), round(float((dd < 0.0005).mean()), 3)


def measure(P, Q):
    from Bench import topology
    P = np.asarray(P, float); dv = sculpt().dist_mm(P); fair, el = fairness(P, Q); c95, weld = conform(P, Q); t = topology(Q, P)
    return {"dev_p50_mm": round(float(np.median(dv)), 2), "dev_p95_mm": round(float(np.percentile(dv, 95)), 2), "fair_p95_deg": fair,
            "edge_mm": el, "crease_on_edges": crease_on_edges(P, Q), "boundary_p95_mm": c95, "weld_ready": weld,
            "outline_top_mm": outline_top_mm(P), "shading_ratio": shading_ratio(P, Q), **t}


def board(P, Q, out, title=""):
