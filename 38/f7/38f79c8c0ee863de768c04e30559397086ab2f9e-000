    subprocess.run([PY, "-I", A + "Scripts/finish/RegionView.py", tmp, out, "--center", ",".join(map(str, PARAMS["board_center"])),
                    "--size-m", str(PARAMS["board_size_m"]), "--parts", "CAND", "--views", "front34,side", "--res", str(PARAMS["board_res"])],
                   capture_output=True); os.remove(tmp)
    if title and os.path.exists(out):
        from PIL import ImageDraw
        im = Image.open(out).convert("RGB"); ImageDraw.Draw(im).text((8, 8), title, fill=(255, 255, 0)); im.save(out)
    return out
