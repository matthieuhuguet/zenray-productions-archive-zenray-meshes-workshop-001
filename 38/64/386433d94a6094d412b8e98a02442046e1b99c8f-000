import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); sys.dont_write_bytecode=True
import diag, numpy as np
def run(obj,edge,o):
    m=diag.AP.mesh(os.path.abspath(obj)); zones=diag.ANY.segment(m,25.0,max(4,int(0.002*len(m['F']))),merge_deg=35.0,log=lambda s:None); rows=[]
    P=m['P']; F=m['F']
    for k,(Z,seed) in enumerate(zones):
        try: r,err=diag.fill4(m,Z,edge,o)
        except Exception: continue
        if r is None: continue
        n0,n1=r['info']['n0'],r['info']['n1']; Q=r['Q']; qm=diag.quad_metrics(r['P3r'],Q,r['Nz'][r['tri_of']])
        area=0.5*np.linalg.norm(np.cross(P[F[Z,1]]-P[F[Z,0]],P[F[Z,2]]-P[F[Z,0]]),axis=1).sum(); ratio=area/(n0*n1*edge**2)
        rows.append((ratio,len(Q),int((qm['jmin']<0).sum()),int((qm['jmin']<0.3).sum()),k))
    return np.array(rows)
if __name__=='__main__':
    obj,edge=sys.argv[1],float(sys.argv[2]); R=run(obj,edge,dict(k=300,relax=0.0))
    print('area/(n0*n1*edge^2) buckets : zones quads folded% squashed%')
    for lo,hi in ((0,0.1),(0.1,0.5),(0.5,0.8),(0.8,1.25),(1.25,100)):
        s=(R[:,0]>=lo)&(R[:,0]<hi)
        if s.sum(): print(f'[{lo},{hi}) zones {int(s.sum())} quads {int(R[s,1].sum())} folded {100*R[s,2].sum()/R[s,1].sum():.1f}% squashed {100*R[s,3].sum()/R[s,1].sum():.1f}%')
    print('total quads',int(R[:,1].sum()),'quads in zones with ratio<0.5:',int(R[R[:,0]<0.5,1].sum()))
