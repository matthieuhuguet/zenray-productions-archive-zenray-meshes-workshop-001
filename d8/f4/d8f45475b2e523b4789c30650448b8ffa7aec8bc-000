    for w in text.split():
        t = (line + " " + w).strip()
        if d.textlength(t, font=f) <= width: line = t
        else: out.append(line); line = w
    return out + [line] if line else out
def iou_(a, b):
    u = (a | b).sum(); return float((a & b).sum() / u) if u else 0.0
def box(m):
    ys, xs = np.nonzero(m); return np.array([xs.min(), xs.max(), ys.min(), ys.max()], float)
