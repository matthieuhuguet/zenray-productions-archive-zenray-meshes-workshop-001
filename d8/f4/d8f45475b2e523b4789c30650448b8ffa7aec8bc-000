def despeckle(m, frac=0.02):
    """a zone cut along the reference can drag stray polygons : a silhouette keeps its real pieces only"""
    lab, k = ndi.label(m)
    if k <= 1: return m
    sz = ndi.sum(m, lab, range(1, k + 1)); return np.isin(lab, 1 + np.flatnonzero(sz >= max(12, frac * sz.sum())))
def smooth(m, frac=0.006):
    """a staircase outline is removed by a small blur, thin parts that a blur would erase stay as they are"""
    sig = max(1.2, frac * m.shape[0]); dt = ndi.distance_transform_edt(m)
    return m if not m.any() or dt.max() < 2.5 * sig else ndi.gaussian_filter(m.astype(np.float32), sig) > 0.5
