    if not a.any() or not b.any(): return False
    n = a.shape[0]; ba = box(a); return bool(ba[0] > 1 and ba[2] > 1 and ba[1] < n - 2 and ba[3] < n - 2 and np.abs(ba - box(b)).max() <= tol * n)
def pieces(m):
