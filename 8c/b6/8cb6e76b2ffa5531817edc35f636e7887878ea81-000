import corners5 as C5, numpy as np
S='/Users/zenray/.claude/tmp/tmp-zenray-meshes/benchmark/gt'
data={}
for name in ('arch_hard','lily_plant'):
    m=C5.AP.mesh(S+'/%s.obj'%name); zones=C5.ANY.segment(m,25.0,max(4,int(0.002*len(m['F']))),merge_deg=35.0,log=lambda s:None); lab=C5.zone_labels(m,zones); L=[]
    for r,(Z,seed) in enumerate(zones):
        Ls,ln=C5.AP.loops(m,Z)
        if len(Ls)!=1: continue
        B=np.asarray(Ls[0]); labs,Ll=C5.boundary_runs(m,lab,r,Z,B); top,tf=C5.topological_corners(labs,Ll); L.append((m['P'][B],C5.vertex_normals_on_loop(m,Z,B),top,tf))
    data[name]=L
def score(prm):
    res={}
    for name,L in data.items():
        ok=n=0; rec=tot=pc=dd=0
        for P,N,top,tf in L:
            if top<2: continue
            idx,tn,X,per=C5.detect(P,N,prm); n+=1; ok+= (len(idx)==top); det=[i/len(X) for i in idx]
            near=lambda a,b: min(abs(a-b),1-abs(a-b))<=0.03; rec+=sum(1 for a in tf if any(near(a,b) for b in det)); tot+=len(tf); pc+=sum(1 for b in det if any(near(a,b) for a in tf)); dd+=len(det)
        res[name]=(round(ok/n,3),round(rec/max(tot,1),3),round(pc/max(dd,1),3))
    return res
base=dict(C5.PARAMS)
for gap in (0.015,0.025,0.04,0.06):
