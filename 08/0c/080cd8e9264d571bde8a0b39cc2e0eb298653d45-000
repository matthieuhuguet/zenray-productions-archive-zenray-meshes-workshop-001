# 10 November 2026: edge agreement between a side render and the reference inside the wheel circle (precision, recall, F at 12 mm).
import sys
from PIL import Image; import numpy as np
from scipy import ndimage as nd
C = '/Users/zenray/.claude/tmp/tmp-zenray-meshes/Projects/12_Car2Cage/04_checks/'
def edges(p):
    a = nd.gaussian_filter(np.asarray(Image.open(p).convert('L')).astype(float), 1.5); return np.hypot(nd.sobel(a, 0), nd.sobel(a, 1))
ref = edges(C + 'tyre_T_001_ref_only.png'); H, W = ref.shape; yy, xx = np.mgrid[:H, :W]; pxm = 1200 / 1.25
mask = np.hypot(xx - W / 2, yy - H / 2) < 0.425 * pxm
for tag in sys.argv[1:]:
    m = edges(C + tag + '_side.png'); E1 = (ref > np.percentile(ref[mask], 85)) & mask; E2 = (m > np.percentile(m[mask], 85)) & mask
    d1 = nd.distance_transform_edt(~E1); d2 = nd.distance_transform_edt(~E2); tol = 0.012 * pxm
    p = (d1[E2] < tol).mean(); r = (d2[E1] < tol).mean(); print(tag, 'precision %.3f recall %.3f F %.3f' % (p, r, 2 * p * r / (p + r)))
