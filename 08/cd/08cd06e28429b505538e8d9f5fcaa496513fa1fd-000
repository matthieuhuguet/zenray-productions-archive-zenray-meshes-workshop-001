#!/usr/bin/env python3
# 6 November 2026, 01:35 Europe/Paris: add the truck components round to IndexMapping.json and ProjectInfo.json.
# FR : ajoute le tour des composants du camion à l'index du projet, avec empreintes SHA-256 et une révision datée.
# Only the files of this round are hashed again; every other entry is kept as it is.
import datetime
import hashlib
import json
from pathlib import Path

WORKSHOP = Path('/Users/zenray/.claude/tmp/tmp-zenray-meshes')
ROUND = WORKSHOP / 'research' / 'truck-components-6-November-2026'
EXTRA = [WORKSHOP / 'Articles' / 'index.html', WORKSHOP / 'Articles' / 'truck-components-6-November-2026.html',
         WORKSHOP / 'Articles' / 'truck-components-chain.svg']


def sha(path):
    h = hashlib.sha256()
    with path.open('rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def files():
    paths = [p for p in ROUND.rglob('*') if p.is_file() and '__pycache__' not in p.parts and p.suffix not in ('.pid', '.log')]
    paths += [p for p in (WORKSHOP / 'Articles' / 'truck-components-6-November-2026').rglob('*') if p.is_file()]
    paths += [p for p in EXTRA if p.exists()]
    return sorted(set(paths))


def main():
    now = datetime.datetime.now(datetime.timezone.utc)
    mapping_path, info_path = WORKSHOP / 'IndexMapping.json', WORKSHOP / 'ProjectInfo.json'
    mapping = json.loads(mapping_path.read_text())
    by_id = {f['fileId']: f for f in mapping['files']}
    records = []
    for p in files():
        rel = p.relative_to(WORKSHOP).as_posix()
        record = {'fileId': 'workshop:' + rel, 'path': str(p), 'relativePath': rel, 'sourceId': 'workshop', 'size': p.stat().st_size, 'sha256': sha(p)}
        by_id[record['fileId']] = {**by_id.get(record['fileId'], {}), **record}
        records.append(record)
    mapping['files'] = sorted(by_id.values(), key=lambda f: f['fileId'])
    mapping['generatedAt'] = now.isoformat().replace('+00:00', 'Z')
    mapping['currentRequestFileCount'] = len(records)
    mapping_path.write_text(json.dumps(mapping, indent=1, ensure_ascii=False) + '\n')
    digest = hashlib.sha256(json.dumps([(r['fileId'], r['sha256']) for r in records]).encode()).hexdigest()
    summary = json.loads((ROUND / 'summary.json').read_text())
    measured = [r for r in summary if r.get('measure')]
    passed = [r for r in measured if min(r['measure']['agreements'].values()) >= 0.90]
    info = json.loads(info_path.read_text())
    info['revisions'].append({
        'id': 'truck-components-6-November-2026',
        'at': datetime.datetime.now().astimezone().isoformat(timespec='seconds'),
        'summary': (f'Truck components from one image: {len(summary)} parts, one ChatGPT conversation each (effort High), '
                    f'{len(measured)} clean square sheets harvested and remeasured outside ChatGPT, {len(passed)} with all three '
                    'agreements at or above 0.90. Document Articles/truck-components-6-November-2026.html; prompt V4.1.'),
        'sourceDigest': digest, 'article': 'Articles/index.html', 'cloudBackup': 'requested, not verified'})
    info['updatedAt'] = mapping['generatedAt']
    info_path.write_text(json.dumps(info, indent=1, ensure_ascii=False) + '\n')
    print(json.dumps({'records': len(records), 'files': len(mapping['files']), 'digest': digest}))


if __name__ == '__main__':
    main()
