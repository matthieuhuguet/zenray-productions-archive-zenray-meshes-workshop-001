                    SOURCE_DIR          "/Users/zenray/.claude/tmp/tmp-zenray-meshes/tools/quadwild-bimdf/build/libs/gmm"
                    BINARY_DIR          "/Users/zenray/.claude/tmp/tmp-zenray-meshes/tools/quadwild-bimdf/build/_deps/gmm-build"
                    CONFIGURE_COMMAND   ""
                    BUILD_COMMAND       ""
                    INSTALL_COMMAND     ""
                    TEST_COMMAND        ""
                    USES_TERMINAL_DOWNLOAD  YES
                    USES_TERMINAL_UPDATE    YES
                    USES_TERMINAL_PATCH     YES
