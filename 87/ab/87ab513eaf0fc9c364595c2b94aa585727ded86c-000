"""29 October 2026 : ZenRay Retopology NAMED BOARD, the parts Matthieu named one by one (side glass, grille bar, roof, windshield, rims), each
shown in the car as it is now (kept clean from v752, or repaired in place) : wireframe and reflection lines, with its audit line.
python ZrlNamedBoard.py <audit tag>        FR : la planche des pièces nommées : fil de fer, zébrures, statut d'audit."""
import json, os, sys
import numpy as np
from PIL import Image, ImageDraw, ImageFont
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
sys.path.insert(0, f"{ROOT}/Scripts"); sys.path.insert(0, f"{ROOT}/Scripts/retopo"); sys.path.insert(0, f"{ROOT}/Scripts/lines")
import ZrrData as D, ZrrSheet as S, ZrlRepair as R
PARAMS = {"parts": [("Vitre de porte", "CAR_body_glass_door_L", (0.9, 0.35, 0.25)), ("Barre de calandre", "CAR_grille_bar_C", (0.2, 0.3, 0.93)),
                    ("Toit", "CAR_body_roof_C", (0.35, 0.85, 0.4)), ("Pare-brise", "CAR_body_glass_windshield_C", (0.25, 0.6, 0.75)),
                    ("Jante, rayons (réparés)", "CAR_wheel_rim_spoke_FL", (0.95, 0.1, 0.3)), ("Jante, fût", "CAR_wheel_rim_barrel_FL", (0.95, 0.1, 0.3))], "tile": 620}   # 29 October 2026

if __name__ == "__main__":
    tag = sys.argv[1] if len(sys.argv) > 1 else "v004"; au = json.load(open(f"{ROOT}/work/lines/audit_{tag}.json")); pa = json.load(open(f"{ROOT}/work/lines/part_audit.json"))
    car = D.load(); rs = PARAMS["tile"]; f = ImageFont.truetype(S.PARAMS["font"], 22); fs = ImageFont.truetype(S.PARAMS["font"], 17)
    W = 2 * rs + 60; H = len(PARAMS["parts"]) * (rs + 70) + 70; Im = Image.new("RGB", (W, H), (248, 248, 248)); dr = ImageDraw.Draw(Im)
    dr.text((20, 16), f"ZenRay Meshes, the parts named by Matthieu, as they are in the car (audit {tag}), 29 October 2026", fill=(20, 20, 20), font=f)
    for k, (label, name, d) in enumerate(PARAMS["parts"]):
        rp = f"{ROOT}/work/lines/repair/{name}.npz"
        if au[name]["status"] == "repaired": dd = np.load(rp, allow_pickle=True); P, Q = dd["P"], dd["Q"]
        else: P, Q = R.part_mesh(car, name)
        Q = np.asarray(Q); T = S.tris(Q); A = D.frame(np.array(d, float) / np.linalg.norm(d)); c, s = S.fit(P, A, rs)
        sh, dep, _ = S.view(P, T, A, c, s, rs); E = sorted({(min(q[i], q[(i + 1) % 4]), max(q[i], q[(i + 1) % 4])) for q in Q.tolist() for i in range(4)})
        t1 = S.wire(sh, P, E, A, c, s, rs, dep); t2, _, _ = S.view(P, T, A, c, s, rs, zebra=True)
        y0 = 60 + k * (rs + 70); r = pa[name]; st = au[name]["status"]
        jac = json.loads(str(np.load(rp, allow_pickle=True)["report"]))["after"]["jac_min"] if st == "repaired" else r["jac_min"]
        dr.text((20, y0), f"{label} ({name}) : {st}, {r['polys']} quads, closed, manifold, smallest Jacobian {jac}", fill=(40, 40, 40), font=fs)
        Im.paste(Image.fromarray(t1.astype(np.uint8)), (20, y0 + 30)); Im.paste(Image.fromarray(t2.astype(np.uint8)), (rs + 40, y0 + 30))
    out = f"{ROOT}/versions/Lines_NamedParts_{tag}.png"; Im.save(out); print(out)
