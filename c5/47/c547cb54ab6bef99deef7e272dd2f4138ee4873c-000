# 26 October 2026 : ZenRay Meshes, LOFT WIREFRAME in the side view (one half, x > x_min) over a z window : quad edges drawn
# in pixels, removed quads absent, so a hole or a torn band at an arch reads at once. Diagnostic only.
# FR : fil de fer de la caisse en loft vue de côté, pour voir un trou ou une bande déchirée autour d'un passage.
# Usage: python LoftWire.py <loft.npz> <out.png> [z0=-2.4] [z1=-0.8] [x_min=0.3] [px_per_m=900]
import sys
import numpy as np
from PIL import Image, ImageDraw


def main(npz, out, z0=-2.4, z1=-0.8, x_min=0.3, ppm=900):
    z0, z1, x_min, ppm = float(z0), float(z1), float(x_min), float(ppm)
    d = np.load(npz, allow_pickle=True); P, Q = d["P"], d["Q"]
    H = int(1.5 * ppm); Wd = int((z1 - z0) * ppm); im = Image.new("RGB", (Wd, H), (30, 30, 34)); dr = ImageDraw.Draw(im)
    to = lambda p: ((z1 - p[2]) * ppm, H - 20 - p[1] * ppm)
    for q in Q:
        c = P[q].mean(0)
        if c[0] < x_min or not (z0 - 0.05 < c[2] < z1 + 0.05): continue
        pts = [to(P[i]) for i in q]; shade = int(np.clip(90 + 160 * (c[0] - x_min) / 0.9, 60, 250))
        dr.polygon(pts, outline=(shade, shade, 255 - shade // 2))
    im.save(out); print(out)


if __name__ == "__main__":
    main(*sys.argv[1:])
