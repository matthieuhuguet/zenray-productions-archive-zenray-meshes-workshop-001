import sys, os, json, numpy as np, concurrent.futures as cf
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); import qw6, q3, q3run
from scipy.spatial import cKDTree
def sharp_samples(path, thr=35.0, per=10):
    V, F = q3.loadobj(path); V = np.array(V); T = np.array([[f[0], f[k], f[k + 1]] for f in F for k in range(1, len(f) - 1)])
    N = np.cross(V[T[:, 1]] - V[T[:, 0]], V[T[:, 2]] - V[T[:, 0]]); N /= np.linalg.norm(N, axis=1)[:, None] + 1e-30; ed = {}
    for i, t in enumerate(T):
        for j in range(3): a, b = t[j], t[(j + 1) % 3]; ed.setdefault((min(a, b), max(a, b)), []).append(i)
    S = []; L = 0.0
    for (a, b), l in ed.items():
        if len(l) == 2 and np.degrees(np.arccos(np.clip(N[l[0]] @ N[l[1]], -1, 1))) > thr:
            S.append(V[a][None] + (V[b] - V[a])[None] * np.linspace(0, 1, per)[:, None]); L += np.linalg.norm(V[b] - V[a])
    return np.concatenate(S), L
def fidelity(out, S):
    Vq, F = q3.loadobj(out); Q = [f for f in F if len(f) == 4]; QS = q3run.seg_samples(Vq, Q, 12); e = float(np.mean([np.linalg.norm(Vq[q[k]] - Vq[q[(k + 1) % 4]]) for q in Q for k in range(4)]))
    d = cKDTree(QS).query(S)[0]; return dict(edge=round(e, 5), within_0_1e=round(float((d < 0.1 * e).mean()), 3), within_0_25e=round(float((d < 0.25 * e).mean()), 3), p90_over_e=round(float(np.percentile(d, 90) / e), 3))
if __name__ == "__main__":
    m = sys.argv[1]; S, L = sharp_samples(f"{qw6.GT}/{m}.obj"); print(m, "sharp edges length", round(L, 3), len(S))
    preps = sys.argv[2:]
    def one(p):
        s12 = json.load(open(f"{qw6.WORK}/{m}__{p}/stage12.json")); r = qw6.stage3(s12, f"feat_{p}", {}, f"{qw6.GT}/{m}.obj", 900 + len(p))
        out = f"{s12['dir']}/{s12['name']}_rem_p0_{900+len(p)}_quadrangulation_smooth.obj"; return p, r["quads"], fidelity(out, S)
    with cf.ThreadPoolExecutor(5) as ex:
        for p, q, f in ex.map(one, preps): print(p, q, f, flush=True)
