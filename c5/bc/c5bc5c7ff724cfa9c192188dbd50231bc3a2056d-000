"""Pass 9 : synthetic hard surface meshes with known primitives : chamfered box, pillar, chamfered cylinder (plus arch and bracket from zr8_meshes).
Usage : python3 -I zr8_hardmeshes.py out_dir. Written 30 October 2026.
FR : maillages de hard surface fabriques, a primitives connues (plans, cylindres, cones)."""
import sys, os
import numpy as np
import trimesh


def chamfer_box(sx=1.0, sy=1.0, sz=1.0, c=0.15):
    """Box with all 12 edges chamfered by c : intersection of the half spaces |x_i| <= h_i and |x_i| + |x_j| <= h_i + h_j - c,
    vertices from scipy HalfspaceIntersection, faces from the convex hull (coplanar faces are triangulated). Planar faces and strips only."""
    from scipy.spatial import HalfspaceIntersection, ConvexHull
    h = np.array([sx, sy, sz]) / 2.0; hs = []
    for i in range(3):
        for sgn in (-1, 1):
            n = np.zeros(3); n[i] = sgn; hs.append(np.r_[n, -h[i]])                      # n . x - h <= 0
    for i in range(3):
        for j in range(i + 1, 3):
            for si in (-1, 1):
                for sj in (-1, 1):
                    n = np.zeros(3); n[i] = si; n[j] = sj; hs.append(np.r_[n, -(h[i] + h[j] - c)])
    hsi = HalfspaceIntersection(np.array(hs), np.zeros(3))
    pts = hsi.intersections
    hull = ConvexHull(pts)
    return trimesh.Trimesh(pts, hull.simplices, process=True)


def revolve_profile(profile, sections=96):
    """Surface of revolution around z of a profile [(r, z), ...] that starts and ends on the axis (r = 0) : closed, caps are fans."""
    pts = np.array(profile, float); ang = np.linspace(0, 2 * np.pi, sections, endpoint=False)
    V = [[0, 0, pts[0][1]]]
    mid = pts[1:-1]
    for r, z in mid:
        for a in ang:
            V.append([r * np.cos(a), r * np.sin(a), z])
    V.append([0, 0, pts[-1][1]])
    V = np.array(V); F = []; nm = len(mid); top = len(V) - 1
    for j in range(sections):
        F.append([0, 1 + (j + 1) % sections, 1 + j])                                  # bottom fan, normal pointing down
    for i in range(nm - 1):
        for j in range(sections):
            a = 1 + i * sections + j; b = 1 + i * sections + (j + 1) % sections
            c = 1 + (i + 1) * sections + (j + 1) % sections; d = 1 + (i + 1) * sections + j
            F += [[a, b, c], [a, c, d]]
    base = 1 + (nm - 1) * sections
    for j in range(sections):
        F.append([top, base + j, base + (j + 1) % sections])
    return V, np.array(F)


def chamfer_cylinder(R=0.5, H=1.2, c=0.1, sections=96):
    prof = [(0, 0), (R - c, 0), (R, c), (R, H - c), (R - c, H), (0, H)]
    return revolve_profile(prof, sections)


def build(name):
    if name == "chamfer_box": m = chamfer_box(1.0, 1.0, 1.0, 0.15)
    elif name == "pillar": m = chamfer_box(0.5, 0.5, 2.5, 0.07)
    elif name == "chamfer_cylinder":
        V, F = chamfer_cylinder(); m = trimesh.Trimesh(V, F, process=True)
    else: raise KeyError(name)
    m.merge_vertices(); m = m.subdivide_to_size(max_edge=0.05) if name != "chamfer_cylinder" else m.subdivide_to_size(max_edge=0.05)
    m.fix_normals()
    return m


if __name__ == "__main__":
    out = sys.argv[1]; os.makedirs(out, exist_ok=True)
    for name in ("chamfer_box", "pillar", "chamfer_cylinder"):
        m = build(name)
        with open(os.path.join(out, name + ".obj"), "w") as f:
            for p in m.vertices: f.write("v %.9g %.9g %.9g\n" % tuple(p))
            for t in m.faces: f.write("f %d %d %d\n" % (t[0] + 1, t[1] + 1, t[2] + 1))
        print(name, len(m.vertices), len(m.faces), "watertight" if m.is_watertight else "OPEN", "euler", m.euler_number, "volume %.3f" % m.volume)


def plain_box(sx=1.0, sy=0.6, sz=0.4):
    m = trimesh.creation.box(extents=(sx, sy, sz)); return m.subdivide_to_size(max_edge=0.05)


def cylinder_band(R=0.5, H=0.8, sweep_deg=180.0, nu=120, nv=40):
    """Open half cylinder (one disk, four corners)."""
    u = np.linspace(0, np.radians(sweep_deg), nu); v = np.linspace(0, H, nv)
    U, Vv = np.meshgrid(u, v, indexing="ij")
    X = np.stack([R * np.cos(U), R * np.sin(U), Vv], axis=-1).reshape(-1, 3)
    F = []
    for i in range(nu - 1):
        for j in range(nv - 1):
            a = i * nv + j; b = (i + 1) * nv + j; c = (i + 1) * nv + j + 1; d = i * nv + j + 1
            F += [[a, b, c], [a, c, d]]
    return trimesh.Trimesh(X, np.array(F), process=True)


def prism(poly, depth, max_edge=0.04):
    from shapely.geometry import Polygon
    m = trimesh.creation.extrude_polygon(Polygon(poly), depth); m.merge_vertices()
    return m.subdivide_to_size(max_edge=max_edge)


def l_block(a=1.0, w=0.5, depth=0.4):
    return prism([(0, 0), (a, 0), (a, w), (w, w), (w, a), (0, a)], depth)


def stairs(n=4, run=0.4, rise=0.3, depth=0.8):
    pts = [(0, 0), (n * run, 0)]
    for i in range(n):
        x = (n - i) * run; y = (i + 1) * rise
        pts += [(x, i * rise + (rise if i > 0 else 0) * 0)]
    # explicit staircase outline : bottom right, then up and left step by step
    pts = [(0, 0), (n * run, 0), (n * run, rise)]
    for i in range(1, n):
        pts += [((n - i) * run, i * rise), ((n - i) * run, (i + 1) * rise)]
    pts += [(0, n * rise)]
    return prism(pts, depth)


def t_block(w=1.0, h=0.35, stem=0.35, sh=0.7, depth=0.4):
    return prism([(0, 0), (w, 0), (w, h), ((w + stem) / 2, h), ((w + stem) / 2, h + sh), ((w - stem) / 2, h + sh), ((w - stem) / 2, h), (0, h)], depth)


def micro_stairs(n=6, run=0.10, rise=0.03, depth=0.5, base=0.25):
    """Stairs whose rise is smaller than the quad edge : every quad row crosses a crease. Reproduces the junction folds of a molded arch."""
    pts = [(0, 0), (n * run, 0), (n * run, base)]
    for i in range(1, n + 1):
        pts += [((n - i) * run, base + (i - 1) * rise), ((n - i) * run, base + i * rise)]
    return prism(pts, depth, 0.025)


def thin_l(a=1.0, w=0.09, depth=0.4):
    return prism([(0, 0), (a, 0), (a, w), (w, w), (w, a), (0, a)], depth, 0.025)


def slotted_plate(sx=1.0, sy=0.6, th=0.12, slot=0.07):
    from shapely.geometry import Polygon, box
    p = box(0, 0, sx, sy).difference(box(sx * 0.3, sy * 0.3, sx * 0.7, sy * 0.3 + slot))
    m = trimesh.creation.extrude_polygon(p, th); m.merge_vertices(); return m.subdivide_to_size(max_edge=0.025)


def car_scene():
    """Synthetic scene : an ellipsoid body (UV-free icosphere) and four identical torus wheels, as separate components.
    Mirror planes x = 0 and y = 0, four fold instance group for the wheels."""
    body = trimesh.creation.icosphere(subdivisions=4, radius=1.0); body.apply_scale([1.6, 0.8, 0.45]); body.apply_translation([0, 0, 0.55])
    parts = [body]
    for sx in (-1, 1):
        for sy in (-1, 1):
            w = trimesh.creation.torus(0.28, 0.1, major_sections=48, minor_sections=24)
            R = trimesh.transformations.rotation_matrix(np.pi / 2, [1, 0, 0])
            w.apply_transform(R); w.apply_translation([sx * 0.95, sy * 0.78, 0.28])
            parts.append(w)
    return trimesh.util.concatenate(parts)
