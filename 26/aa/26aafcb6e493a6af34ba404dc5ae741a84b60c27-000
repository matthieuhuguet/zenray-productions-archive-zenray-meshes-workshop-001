"""Pass 9 : primitive first layout. Segment a triangle mesh into smooth regions by its sharp edges, find the corners of every region boundary
by turning angle, and wrap the result into a Layout object (same interface as the QuadWild layout) so that counts, analytic fill and weld
are reused. Written 30 October 2026.
FR : layout par regions lisses (segmentation par arretes vives), coins par angle de virage, enveloppe dans un objet Layout."""
import collections
import numpy as np
import zr8_layout as L


def sharp_segmentation(V, F, angle_deg=35.0):
    """Union find over triangles joined by non sharp edges. Returns pid (m,) and the number of regions."""
    n = np.cross(V[F[:, 1]] - V[F[:, 0]], V[F[:, 2]] - V[F[:, 0]]); n /= np.maximum(np.linalg.norm(n, axis=1, keepdims=True), 1e-30)
    parent = list(range(len(F)))
    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]; x = parent[x]
        return x
    ef = collections.defaultdict(list)
    for fi, t in enumerate(F):
        for k in range(3):
            a, b = int(t[k]), int(t[(k + 1) % 3]); ef[(min(a, b), max(a, b))].append(fi)
    cosT = np.cos(np.radians(angle_deg))
    for e, fl in ef.items():
        if len(fl) == 2 and n[fl[0]] @ n[fl[1]] > cosT:
            ra, rb = find(fl[0]), find(fl[1])
            if ra != rb: parent[ra] = rb
    roots = {}; pid = np.zeros(len(F), int)
    for fi in range(len(F)):
        pid[fi] = roots.setdefault(find(fi), len(roots))
    return pid, len(roots)


def loop_corners(V, loop, turn_deg=30.0, window=3):
    """Corner vertices of a boundary loop : vertices where the direction (averaged over `window` edges on each side) turns by more than turn_deg."""
    n = len(loop); P = V[loop]; out = []
    for i in range(n):
        a = P[i] - P[(i - window) % n]; b = P[(i + window) % n] - P[i]
        c = (a @ b) / max(np.linalg.norm(a) * np.linalg.norm(b), 1e-30)
        out.append(np.degrees(np.arccos(np.clip(c, -1, 1))))
    out = np.array(out); corners = []
    for i in range(n):
        if out[i] > turn_deg and out[i] >= out[(i - 1) % n] and out[i] > out[(i + 1) % n] - 1e-12:
            # local maximum of the turning angle within the window
            if all(out[i] >= out[(i + d) % n] for d in range(-window, window + 1)):
                corners.append(int(loop[i]))
    return corners


def region_layout(V, F, angle_deg=35.0, turn_deg=30.0, min_corners=3):
    """Layout of smooth regions. Regions with several boundary loops or fewer than min_corners corners are kept with an explicit marker
    (corners = []), they cannot be meshed by the region method."""
    pid, np_ = sharp_segmentation(V, F, angle_deg)
    lay = L.Layout.__new__(L.Layout)
    lay.V = np.asarray(V, float); lay.F = np.asarray(F, int); lay.pid = pid; lay.npatch = np_
    lay.features = []; lay.c_features = []
    lay.corners = [[] for _ in range(np_)]
    lay._topology()
    for p in range(np_):
        if len(lay.loops[p]) == 1:
            lay.corners[p] = loop_corners(lay.V, lay.loops[p][0], turn_deg)
    return lay
