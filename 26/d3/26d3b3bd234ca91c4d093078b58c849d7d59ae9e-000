# 25 October 2026 : ZenRay Meshes tree archetype, Houdini build : trunk + limb chains swept as clean quad tubes,
# leaf clumps of quad cards at the tips. Native SOPs (Python SOP only reads the skeleton JSON into curves).
# EN: chains: from the root, every node continues with its thickest child, the other children start new chains at
# the parent position (one tube per branch, like a modeller or SpeedTree); pscale = radius; Sweep 2.0 with a circle of
# `sides` sides; leaf clump = `cards` crossed quad cards copied to every tip with random orientation and size.
# FR : chaque branche est un tube propre balayé le long de sa chaîne, des touffes de cartes de feuilles aux extrémités.
# Run in Houdini: g = {'SKEL': ..., 'OUT': ...}; exec(open(this).read(), g)
import hou, os

SKEL = globals()["SKEL"]; OUT = globals()["OUT"]
obj = hou.node("/obj")
old = obj.node("ZRM_Tree")
if old:
    old.destroy()
geo = obj.createNode("geo", "ZRM_Tree")
ctrl = geo.createNode("null", "CTRL_zrm")
ptg = ctrl.parmTemplateGroup()
f = hou.FolderParmTemplate("tree", "Tree")
for n, l, v in (("sides", "Tube Sides", 8), ("cards", "Cards per Clump", 4), ("clump_shape", "Clump Shape (0 cards, 1 blob)", 0)):
    f.addParmTemplate(hou.IntParmTemplate(n, l, 1, default_value=(v,), min=3, max=32))
for n, l, v in (("leaf_size", "Leaf Card Size (m)", 0.55), ("leaf_scatter", "Clump Size Random", 0.5), ("min_radius", "Min Branch Radius (m)", 0.02)):
    f.addParmTemplate(hou.FloatParmTemplate(n, l, 1, default_value=(v,)))
f.addParmTemplate(hou.FloatParmTemplate("leaf_hang", "Leaf Hang (0 hangs from the point, 0.5 centred)", 1, default_value=(0.0,)))   # 26 October 2026
f.addParmTemplate(hou.IntParmTemplate("leaf_shape", "Leaf Shape (0 square card, 1 lanceolate hanging leaf)", 1, default_value=(0,), min=0, max=1))   # 26 October 2026
f.addParmTemplate(hou.IntParmTemplate("quad_caps", "Tube End Caps (1 clean quad Coons patch, 0 Sweep concentric grid with valence 16 poles)", 1, default_value=(1,), min=0, max=1))   # 26 October 2026 : the Sweep grid cap gave 32 degenerate quads and two valence 16 poles per tube (TopoCheck, 2 560 degenerate faces on w43)
f.addParmTemplate(hou.FloatParmTemplate("cap_dome", "Tube End Dome (0 flat cap, 1 hemisphere tangent to the tube)", 1, default_value=(1.2,), min=0.0, max=1.5))   # 26 October 2026 : 1.2 measured best by TopoCheck (score 0.9373 against 0.9293 at 1.0, 0.846 at 0.6 : poles on a sharp edge 36, 168, 533) ; a flat cap has a 90 degree rim, which TopoCheck counts as 640 poles on a sharp edge ; a dome has none
f.addParmTemplate(hou.FloatParmTemplate("cap_dome_max_r", "Dome Only Below this Tube Radius (m) : the trunk base stays flat", 1, default_value=(0.3,), min=0.0, max=5.0))   # 26 October 2026 : a 1.2 x 1.4 m dome under the trunk showed as a faceted foot below the ground
ptg.append(f); ctrl.setParmTemplateGroup(ptg)
sk = geo.createNode("python", "skeleton_chains")
sk.parm("python").set('''# 25 October 2026 : skeleton JSON -> one polyline per branch chain, pscale = radius, tips as a point group
import hou, json, numpy as np
node = hou.pwd(); geo = node.geometry()
d = json.load(open(%r))
N = np.array(d["nodes"]); par = d["parent"]; r = np.array(d["radius"]); minr = node.parent().node("CTRL_zrm").evalParm("min_radius")
ch = [[] for _ in N]
for i, q in enumerate(par):
    if q >= 0: ch[q].append(i)
geo.addAttrib(hou.attribType.Point, "pscale", 0.0); geo.addAttrib(hou.attribType.Prim, "kind", "")
def poly(pts, rads, kind):
    if len(pts) < 2: return
    pp = geo.createPoints([hou.Vector3(*p) for p in pts])
    for p_, rr in zip(pp, rads): p_.setAttribValue("pscale", float(max(rr, minr)))
    pr = geo.createPolygon(False)
    for p_ in pp: pr.addVertex(p_)
    pr.setAttribValue("kind", kind)
t = d["trunk"]   # 26 October 2026: the trunk is the first part of the first limb chain (one tube, no seam at the junction : two tubes ending on the same ring gave a sawtooth of z-fighting)
stack = [(0, None)]
while stack:
    start, frm = stack.pop()
    chain = ([frm] if frm is not None else []) + [start]; n = start
    while ch[n]:
        kids = sorted(ch[n], key=lambda c: -r[c]); n2 = kids[0]
        for k in kids[1:]: stack.append((k, n))
        chain.append(n2); n = n2
    pts_ = [N[i].tolist() for i in chain]; rad_ = [r[i] for i in chain]
    if start == 0 and frm is None: pts_ = t["points"][:-1] + pts_; rad_ = t["radius"][:-1] + rad_   # the trunk points up to the root, then the limb path
    if frm is not None: rad_[0] = 0.6 * rad_[1]   # a child starts INSIDE its parent with a small ring : with the parent radius its flat start cap stuck out of the parent surface (the flat cuts at the forks of v40)
    poly(pts_, rad_, "limb")
tg = geo.createPointGroup("tips")
for i in d["tips"]:
    p_ = geo.createPoint(); p_.setPosition(hou.Vector3(*N[i])); p_.setAttribValue("pscale", 0.0); tg.add(p_)
for c in d.get("clumps", []):
    p_ = geo.createPoint(); p_.setPosition(hou.Vector3(*c)); p_.setAttribValue("pscale", 0.0); tg.add(p_)
''' % SKEL)
# branches: sweep
lim = geo.createNode("blast", "branches_only"); lim.setInput(0, sk); lim.parm("group").set("tips"); lim.parm("grouptype").set(3); lim.parm("negate").set(0)
cl = geo.createNode("delete", "drop_points"); cl.setInput(0, lim); cl.parm("entity").set(1) if cl.parm("entity") else None
sw = geo.createNode("sweep::2.0", "branch_tubes"); sw.setInput(0, lim)      # input 0 = backbone curves
sw.parm("surfaceshape").set(1); sw.parm("surfacetype").set(5); sw.parm("endcaptype").setExpression('2 - 2 * ch("../CTRL_zrm/quad_caps")')   # tube, quads, closed at both ends by a quad grid cap (26 October 2026 : open tube ends showed as holes in the wood view)
sw.parm("cols").setExpression('ch("../CTRL_zrm/sides")'); sw.parm("radius").set(1.0)
sw.parm("transformbyattribs").set(1); sw.parm("applyscale").set(1)                          # pscale = branch radius
# leaves: crossed cards clump copied to tips
tips = geo.createNode("blast", "tips_only"); tips.setInput(0, sk); tips.parm("group").set("tips"); tips.parm("grouptype").set(3); tips.parm("negate").set(1)
rnd = geo.createNode("attribwrangle", "tip_random"); rnd.setInput(0, tips); rnd.parm("class").set(2)
rnd.parm("snippet").set('''// random orientation and size per clump (25 October 2026)
float s = chf("../CTRL_zrm/leaf_size") * fit01(rand(@ptnum + 7), 1 - chf("../CTRL_zrm/leaf_scatter"), 1 + chf("../CTRL_zrm/leaf_scatter"));
@pscale = s;
vector4 q = quaternion(radians(rand(@ptnum) * 360), {0,1,0});
q = qmultiply(q, quaternion(radians(fit01(rand(@ptnum + 3), -40, 40)), {1,0,0}));
p@orient = q;''')
card = geo.createNode("grid", "leaf_card"); card.parm("rows").set(2); card.parm("cols").set(2); card.parm("sizex").set(1.0); card.parm("sizey").set(0.6); card.parm("orient").set(0)
# 26 October 2026: LANCEOLATE HANGING LEAF (eucalyptus) : a grid of 7 x 2 points pulled to a pointed leaf, hanging from the attachment point with a slight belly ; switch 0 keeps the square card
leaf = geo.createNode("grid", "leaf_lance"); leaf.parm("rows").set(7); leaf.parm("cols").set(2); leaf.parm("sizex").set(0.55); leaf.parm("sizey").set(1.0); leaf.parm("orient").set(0)
lw = geo.createNode("attribwrangle", "leaf_lance_shape"); lw.setInput(0, leaf)
lw.parm("snippet").set('''float tt = 1.0 - fit(@P.y, -0.5, 0.5, 0.0, 1.0);   // 0 at the attachment, 1 at the tip
float w = pow(max(4.0 * tt * (1.0 - tt) * (1.0 + 0.6 * (0.5 - tt)), 0.0), 0.5);
@P.x *= w;
@P.z += 0.14 * sin(tt * 3.14159);
@P.y = chf("../CTRL_zrm/leaf_hang") - tt;   // leaf_hang 0 : hangs from the attachment point (v31), 0.5 : centred on it like the square card (26 October 2026)''')
sw_c = geo.createNode("switch", "card_shape_switch"); sw_c.setInput(0, card); sw_c.setInput(1, lw); sw_c.parm("input").setExpression('ch("../CTRL_zrm/leaf_shape")')
cards = geo.createNode("copyxform", "clump_cards"); cards.setInput(0, sw_c); cards.parm("ncy").setExpression('ch("../CTRL_zrm/cards")'); cards.parm("ry").setExpression('180/ch("../CTRL_zrm/cards")')
# 26 October 2026: CLUMP SHAPE ; 0 = crossed cards (v14 to v16), 1 = a low poly quad blob (sphere, 5 x 8 quads) per clump : a dark leaf mass instead of confetti
blob = geo.createNode("sphere", "leaf_blob"); blob.parm("type").set(2); blob.parm("rows").set(5); blob.parm("cols").set(8); blob.parmTuple("rad").set((0.5, 0.42, 0.5))
sw_s = geo.createNode("switch", "clump_shape_switch"); sw_s.setInput(0, cards); sw_s.setInput(1, blob); sw_s.parm("input").setExpression('ch("../CTRL_zrm/clump_shape")')
cp = geo.createNode("copytopoints::2.0", "leaf_clumps"); cp.setInput(0, sw_s); cp.setInput(1, rnd)
# 26 October 2026: CLEAN QUAD CAPS. Every open tube end (a ring of n points, n a multiple of 4) is closed by a Coons patch of (n/4) x (n/4) quads built from the ring itself : interior points by transfinite interpolation of the four ring sides,
# four valence 3 poles at the corners, no degenerate quad, no valence 16 pole (the Sweep grid cap had both). Boundary points are shared with the tube, so the mesh stays closed and manifold. FR : bouchons propres en patch de Coons.
cap = geo.createNode("python", "quad_caps"); cap.setInput(0, sw)
cap.parm("python").set('''import hou
geo = hou.pwd().geometry()
if hou.pwd().parent().node("CTRL_zrm").evalParm("quad_caps"):
    cnt = {}; faces = []
    for prim in geo.prims():
        vs = [v.point().number() for v in prim.vertices()]; faces.append(vs)
        for k in range(len(vs)):
            e = tuple(sorted((vs[k], vs[(k + 1) % len(vs)]))); cnt[e] = cnt.get(e, 0) + 1
    nxt = {}
    for vs in faces:
        for k in range(len(vs)):
            a, b = vs[k], vs[(k + 1) % len(vs)]
            if cnt[tuple(sorted((a, b)))] == 1: nxt[b] = a    # the tube runs a to b, the cap must run b to a
    seen = set(); loops = []
    for s0 in list(nxt):
        if s0 in seen: continue
        lp = [s0]; seen.add(s0); q = nxt[s0]
        while q != s0 and q not in seen: lp.append(q); seen.add(q); q = nxt[q]
        loops.append(lp)
    for lp in loops:
        n = len(lp)
        if n < 8 or n % 4: continue
        m = n // 4; P = [geo.point(i).position() for i in lp]; ids = {}
        c0 = sum(P, hou.Vector3()) / n; rr = sum((q - c0).length() for q in P) / n; ax = hou.Vector3(); dome = hou.pwd().parent().node("CTRL_zrm").evalParm("cap_dome") * (1.0 if rr <= hou.pwd().parent().node("CTRL_zrm").evalParm("cap_dome_max_r") else 0.0)
        for vs in faces:    # outward axis : from the middle of the neighbouring ring edge to the middle of the rim edge
            for k in range(len(vs)):
                if nxt.get(vs[(k + 1) % len(vs)]) == vs[k] and len(vs) == 4 and vs[k] in lp:
                    r_mid = (geo.point(vs[k]).position() + geo.point(vs[(k + 1) % 4]).position()) * 0.5; o_mid = (geo.point(vs[(k + 2) % 4]).position() + geo.point(vs[(k + 3) % 4]).position()) * 0.5; ax += r_mid - o_mid
        ax = ax.normalized() if ax.length() > 1e-9 else hou.Vector3(0, 1, 0)
        def B(i, j):    # boundary point of the grid
            if j == 0: return i % n
            if i == m: return (m + j) % n
            if j == m: return (3 * m - i) % n
            return (4 * m - j) % n
        for i in range(m + 1):
            for j in range(m + 1):
                if i in (0, m) or j in (0, m): ids[(i, j)] = lp[B(i, j)]
                else:
                    u = i / float(m); v = j / float(m)
                    pos = (1 - v) * P[B(i, 0)] + v * P[B(i, m)] + (1 - u) * P[B(0, j)] + u * P[B(m, j)] - ((1 - u) * (1 - v) * P[B(0, 0)] + u * (1 - v) * P[B(m, 0)] + (1 - u) * v * P[B(0, m)] + u * v * P[B(m, m)])
                    dd = (pos - c0) - ax * (pos - c0).dot(ax); pos = pos + ax * (dome * rr * max(0.0, 1.0 - (dd.length() / rr) ** 2) ** 0.5)
                    pt = geo.createPoint(); pt.setPosition(pos); ids[(i, j)] = pt.number()
        for i in range(m):
            for j in range(m):
                pl = geo.createPolygon()
                for key in ((i, j), (i + 1, j), (i + 1, j + 1), (i, j + 1)): pl.addVertex(geo.point(ids[key]))
''')
nb = geo.createNode("name", "name_branches"); nb.setInput(0, cap); nb.parm("name1").set("branches")
nl = geo.createNode("name", "name_leaves"); nl.setInput(0, cp); nl.parm("name1").set("leaves")
# 26 October 2026: the ball joint of v32 is removed (it only made a collar and z-fighting patches ; the real fix of the step at the trunk top is the trunk extension chain of BranchMethods m20)
mg = geo.createNode("merge", "tree"); mg.setInput(0, nb); mg.setInput(1, nl)
outn = geo.createNode("null", "OUT_tree"); outn.setInput(0, mg); outn.setDisplayFlag(True); outn.setRenderFlag(True)
ex = geo.createNode("rop_geometry", "EXPORT_obj"); ex.setInput(0, outn); ex.parm("sopoutput").set(OUT)
geo.layoutChildren(); ex.parm("execute").pressButton()
g = outn.geometry()
result = {"prims": len(g.prims()), "points": len(g.points()), "quad_pct": round(100.0 * sum(1 for p in g.prims() if p.numVertices() == 4) / max(len(g.prims()), 1), 1),
          "errors": [n.name() + ": " + " ".join(n.errors()) for n in geo.children() if n.errors()]}
