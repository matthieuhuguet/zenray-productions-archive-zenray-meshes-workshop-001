"""Q9, mesure 7 (H2) : les coordonnées des sommets de v752 sont-elles accrochées à un réseau (signature de masques en pixels) ?
Pour chaque pas delta entre 2 et 24 mm, longueur résultante R de la phase 2 pi x / delta sur les sommets d'une zone ; R proche de 1 = réseau."""
import sys, json
import numpy as np
sys.path.insert(0, ".")
from zrcar_common import *
P = "/home/user/Memory/Projects/zenray-meshes/handoff/car-finish-30-October-2026/files/tmp/tmp-zenray-meshes/versions/ZenRayCar_v752.obj"
V, F, G, names = load_obj(P)
Q, keep = quads_to_array(F); Gq = G[keep]
used = np.zeros(len(V), bool); used[Q.ravel()] = True
def scan(pts, label):
    out = {}
    for ax, an in enumerate("xyz"):
        c = pts[:, ax]
        best = []
        for delta in np.arange(0.002, 0.0241, 0.0001):
            ph = 2 * np.pi * c / delta
            R = np.hypot(np.cos(ph).mean(), np.sin(ph).mean())
            best.append((R, delta))
        best.sort(reverse=True)
        out[an] = [(round(float(r), 3), round(float(d) * 1000, 1)) for r, d in best[:3]]
    nz = 1 / np.sqrt(len(pts))
    print(f"{label:34s} n={len(pts):6d} bruit~{nz:.3f}  x {out['x'][0]}  y {out['y'][0]}  z {out['z'][0]}")
    return out
res = {}
res["all"] = scan(V[used], "tous les sommets utilisés")
front = used & (V[:, 2] > 1.7)
res["front_z>1.7"] = scan(V[front], "avant z > 1.7")
for nm in ("CAR_body_bumper_front_C", "CAR_body_fascia_panel_C", "CAR_light_headlight_L", "CAR_grille_lower_C", "CAR_body_hood_C", "CAR_body_door_L", "CAR_body_roof_C", "CAR_body_rear_C", "CAR_body_fender_front_L"):
    gi = names.index(nm); vs = np.unique(Q[Gq == gi].ravel())
    res[nm] = scan(V[vs], nm)
json.dump(res, open("out/q9_lattice.json", "w"), indent=1)
