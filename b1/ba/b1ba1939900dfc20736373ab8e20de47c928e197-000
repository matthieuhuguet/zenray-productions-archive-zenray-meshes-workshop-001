"""2 November 2026 : M22, a close look at the fit : the reference alone, the mask as read, the mask as fitted, side by side at high zoom. FR : un regard de près sur le calage : la référence seule, le masque lu, le masque calé.
    python -I MicroFitZoom.py Projects/<id>/params.json out.png view:x0:y0:x1:y1 ...       in pixels of the panel"""
import sys, numpy as np
from PIL import Image
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts/micro"); import MicroCommon as C, MicroCutFit as F
RAW = (255, 50, 50); FIT = (40, 240, 90); GAP = 10; ZOOM = 2


def tile(p, home, spec):
    v, x0, y0, x1, y1 = spec.split(":"); x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1); sc = p["scale"]; L0 = np.load(f"{home}/02_masks/labels_raw_{v}.npz")["labels"]; L1 = np.load(f"{home}/02_masks/labels_{v}.npz")["labels"]; h, w = min(L0.shape[0], L1.shape[0]), min(L0.shape[1], L1.shape[1]); s = sc * ZOOM; rgb = np.asarray(Image.fromarray(C.panel_rgb(p, v)).crop((x0, y0, x1, y1)).resize(((x1 - x0) * s, (y1 - y0) * s), Image.BICUBIC)); out = [rgb]
    for L, col in ((L0, RAW), (L1, FIT)):
        c = L[:h, :w][y0 * sc:y1 * sc, x0 * sc:x1 * sc]; b = np.kron(F.borders(c), np.ones((ZOOM, ZOOM), bool))[:rgb.shape[0], :rgb.shape[1]]; a = rgb.copy(); a[: b.shape[0], : b.shape[1]][b] = col; out.append(a)
    H = out[0].shape[0]; bar = np.full((H, GAP, 3), 30, np.uint8); return np.concatenate([out[0], bar, out[1], bar, out[2]], 1)


if __name__ == "__main__":
    p, home = C.load(sys.argv[1]); T = [tile(p, home, s) for s in sys.argv[3:]]; W = max(t.shape[1] for t in T); o = np.full((sum(t.shape[0] for t in T) + GAP * (len(T) - 1), W, 3), 30, np.uint8); y = 0
    for t in T: o[y:y + t.shape[0], : t.shape[1]] = t; y += t.shape[0] + GAP
    Image.fromarray(o).save(sys.argv[2]); print(o.shape)
