"""28 October 2026, 17:00 : ZenRay Meshes finishing, REAR SHELL, the whole rear as ONE closed, welded, all quad shell (finish checklist, section 224).
One structured skin grid from the ground lip (low_y0) to the deck edge : columns follow the lower cutout guides below frame_y0 and stay vertical
above, rows break on every design height ; every recess (upper panel, light bar, two vents, diffuser plate) is a DEPTH given to the vertices by an
inside distance ramp over --bevel-m, so chamfers are grid cells and nothing is laid over anything ; then the sheet is solidified (inner skin offset
along vertex normals, walls on the outer border only). Values in PAR (RearBlueprint) and LOW (RearLower), JSON --params overrides.
python RearShell.py <delivery.npz> <out.npz> [--thick 0.015]   FR : tout l'arrière en une seule coque fermée et soudée."""
import argparse, json, os, sys
from collections import defaultdict
import numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from RearBlueprint import PAR
from RearLower import LOW

ap = argparse.ArgumentParser(); ap.add_argument("npz"); ap.add_argument("out"); ap.add_argument("--params", default="")
ap.add_argument("--thick", type=float, default=0.015); ap.add_argument("--bevel-m", type=float, default=0.016); ap.add_argument("--name", default="CAR_body_rear_C")
a = ap.parse_args(); p = dict(PAR); p.update(LOW)
if a.params:
    p.update(json.load(open(a.params)))
e = p["edge_m"]
zsurf = lambda x, y: p["z_at_y0"] + (p["z_at_y1"] - p["z_at_y0"]) * (y - p["frame_y0"]) / (p["frame_y1"] - p["frame_y0"]) + p["c4"] * x ** 4


def rows(levels):
    out = []
    for y0, y1 in zip(levels[:-1], levels[1:]):
        out += list(np.linspace(y0, y1, max(1, int(round((y1 - y0) / e))) + 1))[:-1]
    return out + [levels[-1]]


bb = p["bar_bevel_m"]
ys = np.array(rows(sorted({p["low_y0"], p["cut_y0"], p["plate_y1"], p["cut_y1"], p["frame_y0"], p["hole_y0"], p["bar_y"] - bb, p["bar_y"], p["hole_y1"], p["frame_y1"]})))
clamp = lambda y: min(max(y, p["cut_y0"]), p["cut_y1"])
cin = lambda y: max(p["cut_in_top"] + (p["cut_in_bot"] - p["cut_in_top"]) * (p["cut_y1"] - clamp(y)) / (p["cut_y1"] - p["cut_y0"]), p["plate_x"] + 0.03)
cout = lambda y: p["cut_out_top"] + (p["cut_out_bot"] - p["cut_out_top"]) * (p["cut_y1"] - clamp(y)) / (p["cut_y1"] - p["cut_y0"])
xo = lambda y: p["low_x_bot"] + (p["frame_x"] - p["low_x_bot"]) * (min(y, p["frame_y0"]) - p["low_y0"]) / (p["frame_y0"] - p["low_y0"])
guides = lambda y: [0.0, p["plate_x"], cin(y), min(cout(y), xo(y) - 0.03), p["hole_x"], xo(y)]
gm = [guides(y) for y in (p["low_y0"], p["frame_y1"])]
nseg = [max(1, int(round(max(abs(g[k + 1] - g[k]) for g in gm) / e))) for k in range(5)]
half = []
for y in ys:
    g = guides(y); xr = []
    for k in range(5):
        xr += list(np.linspace(g[k], g[k + 1], nseg[k] + 1))[:-1]
    half.append(xr + [g[5]])
half = np.array(half); X = np.concatenate([-half[:, :0:-1], half], 1); Y = np.repeat(ys[:, None], X.shape[1], 1)


def inside_rect(x, y, x0, x1, y0, y1):
    return np.minimum.reduce([x - x0, x1 - x, y - y0, y1 - y])


def inside_poly(x, y, poly):   # convex polygon, counter clockwise : min signed distance to its edges
    d = np.full(np.shape(x), np.inf)
    for (x0, y0), (x1, y1) in zip(poly, poly[1:] + poly[:1]):
        nx, ny = y1 - y0, -(x1 - x0); L = np.hypot(nx, ny); d = np.minimum(d, -((x - x0) * nx + (y - y0) * ny) / L)
    return d


ramp = lambda d: np.clip(d / a.bevel_m, 0, 1)
D = np.zeros_like(X)
up = inside_rect(X, Y, -p["hole_x"], p["hole_x"], p["hole_y0"], p["hole_y1"])
D = np.maximum(D, ramp(up) * np.where(Y >= p["bar_y"] - 1e-9, p["bar_recess_m"], p["recess_m"]))
D = np.maximum(D, ramp(inside_rect(X, Y, -p["plate_x"], p["plate_x"], p["low_y0"] - 1, p["plate_y1"])) * p["plate_recess_m"])
for s in (1, -1):
    poly = [(cin(p["cut_y0"]), p["cut_y0"]), (cout(p["cut_y0"]), p["cut_y0"]), (cout(p["cut_y1"]), p["cut_y1"]), (cin(p["cut_y1"]), p["cut_y1"])]
    if s < 0:
        poly = [(-x, y) for x, y in poly[::-1]]
    D = np.maximum(D, ramp(inside_poly(X, Y, poly)) * p["cut_recess_m"])
Z = zsurf(X, Y) + D
G = np.stack([X, Y, Z], -1)
ztop = G[-1, :, 2]; roll = []
for k in range(1, p["roll_rows"] + 1):
    th = k / p["roll_rows"] * np.pi / 2
    roll.append(np.stack([G[-1, :, 0], np.full(G.shape[1], p["frame_y1"] + (p["deck_y"] - p["frame_y1"]) * np.sin(th)), p["deck_z"] + (ztop - p["deck_z"]) * np.cos(th)], -1))
G = np.concatenate([G, np.array(roll)], 0)
nb, na = G.shape[:2]
# solidify : vertex normals of the skin (outward = -z), inner skin offset inward, walls on the border
du = np.gradient(G, axis=1); dv = np.gradient(G, axis=0); N = np.cross(du, dv); N /= np.linalg.norm(N, axis=-1, keepdims=True) + 1e-12
if N[..., 2].mean() > 0:
    N = -N
B = G - a.thick * N
gid = lambda j, i: j * na + i; off = nb * na; pts = np.vstack([G.reshape(-1, 3), B.reshape(-1, 3)]); F = []
for j in range(nb - 1):
    for i in range(na - 1):
        q = [gid(j, i), gid(j, i + 1), gid(j + 1, i + 1), gid(j + 1, i)]; F.append(q); F.append([off + x for x in q[::-1]])
ring = [gid(0, i) for i in range(na)] + [gid(j, na - 1) for j in range(1, nb)] + [gid(nb - 1, i) for i in range(na - 2, -1, -1)] + [gid(j, 0) for j in range(nb - 2, 0, -1)]
for k in range(len(ring)):
    F.append([ring[k], off + ring[k], off + ring[(k + 1) % len(ring)], ring[(k + 1) % len(ring)]])
# outward by signed volume of the closed shell : it must be positive (28 October 2026, rig.outward_normals)
vol = sum(np.dot(pts[q[0]], np.cross(pts[q[k]], pts[q[k + 1]])) for q in F for k in (1, 2)) / 6
if vol < 0:
    F = [f[::-1] for f in F]
E = defaultdict(int)
for q in F:
    for k in range(4):
        E[(min(q[k], q[(k + 1) % 4]), max(q[k], q[(k + 1) % 4]))] += 1
np.savez(a.out, P=pts.astype(np.float32), Q=np.array(F, dtype=object), names=np.array([a.name] * len(F)))
print(json.dumps({"grid": [nb, na], "faces": len(F), "open_edges": sum(c == 1 for c in E.values()), "nonmanifold": sum(c > 2 for c in E.values())}))
