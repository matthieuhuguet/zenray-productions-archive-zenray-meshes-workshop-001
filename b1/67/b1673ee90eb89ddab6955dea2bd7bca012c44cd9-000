# 2 November 2026 : a part and its mirror in one file, or several parts merged, for the fixed list of a fit. FR : une partie et son miroir dans un seul fichier, ou plusieurs parties fusionnées, pour la liste fixe d'un ajustement.
import sys
out=sys.argv[1]; V=[];F=[]
for spec in sys.argv[2:]:
    mirror=spec.endswith(':m'); f=spec[:-2] if mirror else spec; v=[];ff=[]
    for l in open(f):
        if l.startswith('v '): v.append([float(x) for x in l.split()[1:4]])
        elif l.startswith('f '): ff.append([int(x.split('/')[0])-1 for x in l.split()[1:]])
    o=len(V); V+=v; F+=[[i+o for i in q] for q in ff]
    if mirror:
        o=len(V); V+=[[-a[0],a[1],a[2]] for a in v]; F+=[[i+o for i in q[::-1]] for q in ff]
with open(out,'w') as w:
    for a in V: w.write('v %f %f %f\n'%tuple(a))
    for q in F: w.write('f '+' '.join(str(i+1) for i in q)+'\n')
print(out,len(V))
