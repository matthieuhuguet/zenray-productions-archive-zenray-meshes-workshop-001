# 27 October 2026: Compare model against ref2.png wireframe sheet
import os, sys, json
import numpy as np
from PIL import Image
from scipy import ndimage as ndi

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import Raster, LineScore, SheetScore

def score_against_ref2(delivery_npz):
    d = np.load(delivery_npz, allow_pickle=True)
    P = d["P"]
    Q_ = d["Q"]

    faces_tri = []
    for q in Q_:
        faces_tri.append([q[0], q[1], q[2]])
        faces_tri.append([q[0], q[2], q[3]])
    faces_tri = np.array(faces_tri, dtype=np.int32)

    mr = Raster.Renderer(P, faces_tri)

    fdir = "work/car/frame/"
    vdir = "work/car/views_ref2/"
    meta = json.load(open(fdir + "frame.json"))
    sheet = json.load(open("work/car/views/sheet.json"))

    scores = {}
    for v in meta["views"]:
        vname = v["name"]
        pan = [p for p in sheet["panels"] if p["name"] == vname][0]
        p_idx = pan["index"]
        ref_wire_path = os.path.join(vdir, f"{p_idx:02d}_{vname}_wire.png")
        ref_img = np.asarray(Image.open(ref_wire_path).convert("L"))
        
        mref = np.asarray(Image.open(os.path.join(fdir, f"mask_{vname}.png"))) > 127
        
        M, _ = SheetScore.render_in_panel(mr, meta, v, mref.shape)
        M = ndi.binary_fill_holes(M)
        iou = float((M & mref).sum() / max((M | mref).sum(), 1))
        
        e_ref = LineScore.ref_edges(ref_img) & mref
        
        lo = np.array(meta["lo"]); D = np.array(meta["dims_m"]); hi = lo + D
        rx, uy, tz = np.array(v["rx"]), np.array(v["uy"]), np.array(v["tz"])
        if vname == "top" and tz[1] < 0 or vname == "bottom" and tz[1] > 0: tz = -tz
        a, b = int(np.argmax(np.abs(rx))), int(np.argmax(np.abs(uy)))
        umin = lo[a] if rx[a] > 0 else -hi[a]
        vmax = hi[b] if uy[b] > 0 else -lo[b]
        s = v["px_per_m"]; bb = v["bbox"]
        R = int(max(mref.shape))
        xc, yc = (bb[0] + bb[2]) / 2, (bb[1] + bb[3]) / 2
        cu = umin + D[a] / 2 + (R / 2 - xc) / s
        cv = vmax - D[b] / 2 + (yc - R / 2) / s
        c = cu * rx + cv * uy

        M, Dp, N, F = mr.render(c, s, (rx.tolist(), uy.tolist(), tz.tolist()), R)
        M = M[:mref.shape[0], :mref.shape[1]]
        Dp = Dp[:mref.shape[0], :mref.shape[1]]
        N = N[:mref.shape[0], :mref.shape[1]]

        e_mod = LineScore.model_edges(N, M, Dp)
        dt_ref = ndi.distance_transform_edt(~e_ref)
        dt_mod = ndi.distance_transform_edt(~e_mod)
        tp_p = (e_mod & (dt_ref <= 3)).sum()
        tp_r = (e_ref & (dt_mod <= 3)).sum()
        prec = tp_p / max(e_mod.sum(), 1)
        rec = tp_r / max(e_ref.sum(), 1)
        f1 = 2 * prec * rec / max(prec + rec, 1e-12)
        scores[vname] = {
            "iou": round(iou, 4),
            "f1": round(float(f1), 4),
            "prec": round(float(prec), 4),
            "rec": round(float(rec), 4)
        }

    print(f"Comparison of {delivery_npz} against ref2.png:")
    for k, val in scores.items():
        print(f"  {k:7s}: IoU={val['iou']:.4f}, Line F1={val['f1']:.4f} (prec={val['prec']:.4f}, rec={val['rec']:.4f})")
    mean_iou = np.mean([val["iou"] for val in scores.values()])
    mean_f1 = np.mean([val["f1"] for val in scores.values()])
    print(f"Mean IoU: {mean_iou:.4f}, Mean Line F1: {mean_f1:.4f}")
    return scores

if __name__ == "__main__":
    npz = sys.argv[1] if len(sys.argv) > 1 else "work/car/delivery_v578.npz"
    score_against_ref2(npz)
