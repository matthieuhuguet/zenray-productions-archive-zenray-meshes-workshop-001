def parse_obj_groups(obj_path):
    """Parse vertices and per-group faces + edge stats from real A_002 assembly.obj."""
    verts = []
    g_faces = {}
    cur = 'NONE'
    with open(obj_path, 'r', encoding='utf-8') as f:
        for line in f:
            if line.startswith('v '):
                _, x, y, z = line.split()
                verts.append((float(x), float(y), float(z)))
            elif line.startswith('g '):
                cur = line[2:].strip()
                g_faces.setdefault(cur, [])
            elif line.startswith('f '):
                toks = [int(t.split('/')[0]) - 1 for t in line.split()[1:]]
                g_faces.setdefault(cur, []).append(toks)
    V = np.array(verts, dtype=np.float64)
    return V, g_faces


def measure_pairwise_gaps(V, g_faces):
    """Measure surface vertex KDTree minimum gap & overlap across all component pairs."""
    g_pts = {}
    g_stats = {}
    for k, fl in g_faces.items():
        used = np.unique(np.array(fl, dtype=np.int64))
        pts = V[used]
        g_pts[k] = pts
        ec = {}
        for f in fl:
            m = len(f)
            for i in range(m):
                a, b = f[i], f[(i + 1) % m]
                e = (a, b) if a < b else (b, a)
                ec[e] = ec.get(e, 0) + 1
        op = sum(1 for c in ec.values() if c == 1)
        nm = sum(1 for c in ec.values() if c > 2)
        mn, mx = pts.min(0), pts.max(0)
        g_stats[k] = {
            'faces': len(fl),
            'verts': len(used),
            'open_edges': op,
            'nonmanifold': nm,
            'bbox_min': mn.tolist(),
            'bbox_max': mx.tolist(),
        }
    names = list(g_pts.keys())
    trees = {k: cKDTree(g_pts[k]) for k in names}
    pairs = {}
    for i in range(len(names)):
        for j in range(i + 1, len(names)):
            a, b = names[i], names[j]
            dists, _ = trees[b].query(g_pts[a], k=1)
            pairs[f'{a} <-> {b}'] = {
                'min_dist': float(dists.min()),
                'p05_dist': float(np.percentile(dists, 5)),
            }
    return g_pts, g_stats, pairs


def union_find_components(names, pairs_m, touch_m=0.001):
    parent = {n: n for n in names}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    for i in range(len(names)):
        for j in range(i + 1, len(names)):
            a, b = names[i], names[j]
            key = f'{a} <-> {b}' if f'{a} <-> {b}' in pairs_m else f'{b} <-> {a}'
            if pairs_m[key] <= touch_m:
                parent[find(b)] = find(a)
    comps = {}
    for n in names:
        comps.setdefault(find(n), []).append(n)
    groups = sorted(comps.values(), key=lambda c: -len(c))
    floating = [x for comp in groups[1:] for x in comp]
    return groups, floating


