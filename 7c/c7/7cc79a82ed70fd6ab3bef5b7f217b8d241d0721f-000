    flare_pts = g_pts_raw['Arm_Flare'] * scale_m_per_px
    forearm_pts = g_pts_raw['Arm_Forearm'] * scale_m_per_px

    t_flare = cKDTree(flare_pts)
    dists_cf, idx_cf = t_flare.query(cuff_pts, k=1)
    best_i = int(np.argmin(dists_cf))
    snap_vec_m = flare_pts[idx_cf[best_i]] - cuff_pts[best_i]
    # Add 2 mm seating tuck along normalized vector so ContactGraph guarantees gap = 0.0 mm (<= 1 mm)
    n_len = max(float(np.linalg.norm(snap_vec_m)), 1e-9)
    tuck_shift_m = snap_vec_m + (snap_vec_m / n_len) * 0.002

    cuff_snapped = cuff_pts + tuck_shift_m
    d_cf_after = float(t_flare.query(cuff_snapped, k=1)[0].min())

    # Estimate buried/hidden vertices of Arm_Forearm inside Arm_Flare Y-overlap band & radial proximity
