# 26 October 2026 : grid of m20 settings scored on one object, truth metrics included. FR : balayage de réglages de m20 sur un objet.
# Usage : python GridM20.py obj=tree_syn out=/path/grid_tree_syn.jsonl   (English identifiers)
import sys, json, itertools, time, numpy as np
sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zenray-meshes/Scripts")
import BranchLab as B, BranchMethods as M
obj, out = "tree_syn", "/tmp/grid.jsonl"
for a in sys.argv[1:]:
    k, v = a.split("=")
    if k == "obj": obj = v
    if k == "out": out = v
GRID = {"tau2": (0.15, 0.2, 0.3), "avg2": (0.2, 0.25, 0.35), "sub2": (3.0, 4.5, 6.0)}   # the grid is the interface : change it here only
V, RL, E, geo, root, r_root = M.setup(obj)
f = open(out, "a")
for tau2, avg2, sub2 in itertools.product(GRID["tau2"], GRID["avg2"], GRID["sub2"]):
    t0 = time.time(); N, par = M.m20_staged(V, RL, E, geo, root, r_root, tau1=0.3, sub1=4, tau2=tau2, sub2=sub2, avg2=avg2, tol=0.08)
    rad = np.sqrt(B.radius_from_ridge(V, RL, N, par, r_root) * B.pipe_radius(par, r_root * 0.8, tip_r=0.02, expo=1.6)); rad[par < 0] = r_root
    s = B.score(V, RL, N, par, rad); r = {"obj": obj, "tau2": tau2, "avg2": avg2, "sub2": sub2, "G": s["G"], "F": s["F"], "precision": s["precision"], "recall_thick": s["recall_thick"], "recall_med": s["recall_med"], "n": len(N), "sec": round(time.time() - t0, 1)}
    import os
    if os.path.exists("/Users/zenray/.claude/tmp/tmp-zenray-meshes/work/%s/topo_w_truth.npz" % obj): r.update(M.truth_curves(obj, N, par))
    f.write(json.dumps(r) + "\n"); f.flush()
