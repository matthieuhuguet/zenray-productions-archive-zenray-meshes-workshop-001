"""Auto-test du vérificateur de reprojection (six vues) dans les deux sens : vert sur le maillage exact, rouge sur un maillage agrandi de 2 % et sur un maillage décalé de 15 mm. 30 October 2026."""
import sys, json
import numpy as np
sys.path.insert(0, ".")
from facetcar import *; from facet_mesh import *; from verifiers import reprojection_iou
car, p = build()
px = 0.008
views = render_views(car, px=px)
ref = {}
for nm, v in views.items():
    a, b, d, x0, y1, pxx = v["frame"]; H, W = v["mask"].shape
    ref[nm] = (v["mask"], (x0, x0 + W * pxx, y1 - H * pxx, y1))
U, lab = closed_mesh(car, 0.15)
V0 = np.array(U.vertices); T0 = np.array(U.faces)
out = {}
for name, V in (("GREEN_exact", V0), ("RED_scaled_2pct", V0 * 1.02), ("RED_shifted_15mm_z", V0 + np.array([0, 0, 0.015])), ("RED_shifted_15mm_y", V0 + np.array([0, 0.015, 0]))):
    r = reprojection_iou(V, T0, ref, px)
    out[name] = r
    print(f"{name:20s} iou_min {r['iou_min']:.4f} ({'ok' if r['pass'] else 'ROUGE'}) ", {k: round(v, 4) for k, v in r["iou"].items()})
json.dump(out, open("out/verifier_reprojection_selftest.json", "w"), indent=1)
ok = out["GREEN_exact"]["pass"] and not any(out[k]["pass"] for k in out if k.startswith("RED"))
print("deux sens :", ok)
sys.exit(0 if ok else 1)
