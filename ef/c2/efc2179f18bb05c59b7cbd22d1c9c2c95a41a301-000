#!/bin/zsh
# 26 October 2026 : ZenRay Meshes, one car experiment with the gate rule : build, six view audit, topology audit, then the four numbers that decide (faults, review gates, silhouette, lines).
# Usage: CarTry.sh <tag>      FR : un essai de voiture, les chiffres qui tranchent.
set -e
W=/Users/zenray/.claude/tmp/tmp-zenray-meshes; cd $W; TAG=$1
zsh Scripts/BuildCar.sh $TAG > /tmp/claude-501/build_$TAG.log 2>&1 && zsh Scripts/Audit.sh $TAG > /tmp/claude-501/audit_$TAG.log 2>&1 && zsh Scripts/TopoAudit.sh $TAG --no-board > /tmp/claude-501/topo_$TAG.log 2>&1
/Users/zenray/.venvs/zenray-uv/bin/python -I - <<PYEOF
import json, re
t = json.load(open("versions/Topo_$TAG.json")); r = json.load(open("versions/Review_$TAG.json")); a = open("versions/Audit_$TAG.md").read()
print("$TAG faults", t["error_faces"], "faces", t["faces"], "gates", r["passed"], "/", r["total"], [g["gate"] for g in r["gates"] if not g["ok"]])
for g in r["gates"]:
    if g["gate"] in ("topology.fault_pct_visible", "arch.ring_fault_pct"): print("  ", g["gate"], g["measured"])
print("  ", [l for l in a.splitlines() if l.startswith("| mean")][0])
PYEOF
