"""29 October 2026 : a dense test model : midpoint subdivision of a triangle OBJ (each triangle becomes four, same surface) so the size of a model can be stepped to 100k, 500k, 2M triangles.
    python -I ZrlSubdivide.py in.obj out.obj [levels]
FR : un modèle dense pour éprouver les tailles de maillage."""
import sys, time
import numpy as np


def read(path):
    V, F = [], []
    for l in open(path):
        if l.startswith("v "): V.append([float(x) for x in l.split()[1:4]])
        elif l.startswith("f "):
            ids = [int(t.split("/")[0]) - 1 for t in l.split()[1:]]
            for k in range(1, len(ids) - 1): F.append([ids[0], ids[k], ids[k + 1]])
    return np.array(V), np.array(F)


def subdivide(V, F):
    e = np.concatenate([F[:, [0, 1]], F[:, [1, 2]], F[:, [2, 0]]]); e.sort(axis=1); u, inv = np.unique(e, axis=0, return_inverse=True); inv = inv.reshape(-1); n = len(V)
    M = (V[u[:, 0]] + V[u[:, 1]]) / 2; V2 = np.vstack([V, M]); m = len(F); m01, m12, m20 = n + inv[:m], n + inv[m:2 * m], n + inv[2 * m:]
    F2 = np.concatenate([np.stack([F[:, 0], m01, m20], 1), np.stack([m01, F[:, 1], m12], 1), np.stack([m20, m12, F[:, 2]], 1), np.stack([m01, m12, m20], 1)]); return V2, F2


def write(path, V, F):
    with open(path, "w") as f:
        f.write("g \n"); np.savetxt(f, V, fmt="v %.6f %.6f %.6f"); np.savetxt(f, F + 1, fmt="f %d %d %d")


if __name__ == "__main__":
    t = time.time(); V, F = read(sys.argv[1]); L = int(sys.argv[3]) if len(sys.argv) > 3 else 1
    for _ in range(L): V, F = subdivide(V, F)
    write(sys.argv[2], V, F); print(len(V), "vertices", len(F), "triangles", round(time.time() - t, 1), "s")
