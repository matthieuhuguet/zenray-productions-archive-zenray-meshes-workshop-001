"""Voiture facettée synthétique, paramétrique et déterministe : une définition (FacetCar), des paramètres, des instances.
La carrosserie est une expression CSG de polytopes convexes (intersections de demi-espaces) ; la vérité 3D est exacte :
chaque facette est un plan, chaque arête une droite. Lancer de rayons orthographique par intervalles (numpy), échantillonnage de surface,
export en maillage triangulé. Axes : x latéral, y haut, z avant (comme v752, mètres). 30 October 2026."""
import numpy as np
from scipy.spatial import HalfspaceIntersection

def unit(v):
    v = np.asarray(v, float); return v / np.linalg.norm(v)

class Polytope:
    """Intersection de demi-espaces n.x <= c. name_i par plan."""
    def __init__(self, planes, interior):
        self.n = np.array([unit(p[0]) for p in planes]); self.c = np.array([p[1] for p in planes], float)
        self.names = [p[2] for p in planes]
        self.interior = np.asarray(interior, float)
        hs = np.c_[self.n, -self.c]
        hi = HalfspaceIntersection(hs, self.interior)
        self.verts = hi.intersections
        # polygone par plan : sommets sur le plan, ordonnés par angle
        self.polys = {}
        for i in range(len(self.n)):
            d = np.abs(self.verts @ self.n[i] - self.c[i])
            idx = np.where(d < 1e-7)[0]
            if len(idx) < 3: continue
            P = self.verts[idx]; cen = P.mean(0)
            a = np.cross(self.n[i], [1, 0, 0]);
            if np.linalg.norm(a) < 0.1: a = np.cross(self.n[i], [0, 1, 0])
            a = unit(a); b = np.cross(self.n[i], a)
            ang = np.arctan2((P - cen) @ b, (P - cen) @ a)
            self.polys[i] = P[np.argsort(ang)]
    def contains(self, X, tol=1e-9):
        return np.all(X @ self.n.T <= self.c[None, :] + tol, axis=1)
    def interval(self, O, D):
        """Rayons O + t D (m,3). Retourne t_in, t_out, plan_in, plan_out (t_in > t_out : manqué)."""
        m = len(O)
        t_in = np.full(m, -1e18); t_out = np.full(m, 1e18); p_in = np.full(m, -1); p_out = np.full(m, -1)
        for i in range(len(self.n)):
            nd = D @ self.n[i]; no = O @ self.n[i] - self.c[i]
            with np.errstate(divide="ignore", invalid="ignore"):
                t = -no / nd
            enter = nd < -1e-12; leave = nd > 1e-12
            par = ~(enter | leave)
            miss = par & (no > 0)
            t_in = np.where(miss, 1e19, t_in); t_out = np.where(miss, -1e19, t_out)
            upd = enter & (t > t_in); t_in = np.where(upd, t, t_in); p_in = np.where(upd, i, p_in)
            upd = leave & (t < t_out); t_out = np.where(upd, t, t_out); p_out = np.where(upd, i, p_out)
        return t_in, t_out, p_in, p_out

class CSG:
    """Arbre : ('p', index) | ('u', a, b) | ('d', a, b). pieces = liste de Polytope."""
    def __init__(self, pieces, tree):
        self.pieces = pieces; self.tree = tree
    def _eval(self, node, O, D, cache):
        if node[0] == "p":
            k = node[1]
            if k not in cache: cache[k] = self.pieces[k].interval(O, D)
            ti, to, pi, po = cache[k]
            ok = ti < to
            return [(np.where(ok, ti, np.nan), np.where(ok, to, np.nan), np.where(ok, pi, -1), np.where(ok, po, -1), np.full(len(O), k), np.full(len(O), k))]
        raise NotImplementedError
    def first_hit(self, O, D):
        """Premier point d'entrée dans le solide : renvoie t, (pièce, plan). Union/différence évaluées sur des listes d'intervalles par rayon (vectorisé par boucle sur les pièces)."""
        m = len(O)
        # intervalles par pièce
        iv = {}
        for k, P in enumerate(self.pieces):
            iv[k] = P.interval(O, D)
        best_t = np.full(m, np.inf); best_id = np.full((m, 2), -1)
        # on évalue l'arbre par candidats : t d'entrée de chaque pièce positive ; on garde le plus petit t qui est à l'intérieur de l'expression
        cand = []
        for k, (ti, to, pi, po) in iv.items():
            ok = ti < to
            cand.append((np.where(ok, ti, np.inf), k, pi))
            # sorties des pièces soustraites comptent comme entrées du solide
            cand.append((np.where(ok, to, np.inf), k, po))
        for t, k, pl in cand:
            valid = np.isfinite(t)
            X = O + D * (t[:, None] + 1e-7)           # point juste après
            ins = self._inside(self.tree, X)
            ok = valid & ins & (t < best_t)
            best_t = np.where(ok, t, best_t)
            best_id[ok, 0] = k; best_id[ok, 1] = pl[ok]
        return best_t, best_id
    def _inside(self, node, X):
        if node[0] == "p": return self.pieces[node[1]].contains(X)
        a = self._inside(node[1], X); b = self._inside(node[2], X)
        return (a | b) if node[0] == "u" else (a & ~b)

