    'edge_sigma': 1.0,       # Canny sigma for facet edges
    'canny': (0.030, 0.065), # Canny thresholds at working scale (gradient of a 0..1 image, 3 px per view px)
    'near_judge_px': 1.5,    # a sub-pixel line is kept when the judge sees a line this close
    'sil_band_px': 3.0,      # lines closer to the outline than this are the outline
