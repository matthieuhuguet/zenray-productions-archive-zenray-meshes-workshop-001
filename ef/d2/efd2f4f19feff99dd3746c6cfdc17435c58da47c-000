    dr.line([(40 * 4, 100 * 4), (220 * 4, 80 * 4)], fill=60, width=6)                                        # a thin dark line
    g = np.asarray(im.resize((W, H), Image.LANCZOS)).astype(float)
    ms = Image.new('L', (W * 4, H * 4), 0); ImageDraw.Draw(ms).polygon([(x * 4, y * 4) for x, y in body], fill=255)
    sil = np.asarray(ms.resize((W, H), Image.LANCZOS)) > 127
    Image.fromarray(g.astype(np.uint8)).save(d / (VG.FILES['front'] + '_rgb.png')); Image.fromarray((sil * 255).astype(np.uint8)).save(d / (VG.FILES['front'] + '_mask.png'))
