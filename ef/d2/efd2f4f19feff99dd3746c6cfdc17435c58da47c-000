def raster(polys, shape):
    R = np.zeros(shape, bool)
    for p in polys:
        q = Cage.resample(np.asarray(p, float), 0.25); x = np.clip(np.floor(q[:, 0]).astype(int), 0, shape[1] - 1); y = np.clip(np.floor(q[:, 1]).astype(int), 0, shape[0] - 1)
        R[y, x] = True
    return R


def check_view(G, g, sil, judge, inner, shift=(0.0, 0.0)):
    """Measures of one tracing against its IMAGE. shift moves the tracing (selftest: a shifted tracing must fail).
    Inner lines: recall and precision against the lines the judge of the cut reads in the image. Outline: at every
    contrasted point the grey level under the traced outline must sit half way between the level 2 px inside and the
    level 2 px outside (that is where an anti-aliased edge is); roughness = median second difference of the outline read every 2 px (0 on a
    straight run, 0.08 on an arc of 50 px radius, about 1 on a pixel staircase); overlap with the old mask is given as information."""
    sh = np.asarray(shift, float); tol = P['check_line_tol_px']
    inner_lines = [np.asarray(e['poly'], float) + sh for e in G['edges'] if e.get('role') == 'line']
    T = raster(inner_lines, g.shape) if inner_lines else np.zeros(g.shape, bool)
    dT = ndi.distance_transform_edt(~T) if T.any() else np.full(g.shape, 1e9); dJ = ndi.distance_transform_edt(~judge) if judge.any() else np.full(g.shape, 1e9)
    recall = 1.0 - float((judge & (dT > tol)).sum()) / max(int(judge.sum()), 1)
    Tin = T & inner
    precision = 1.0 - float((Tin & (dJ > tol)).sum()) / max(int(Tin.sum()), 1)
    res = {'recall': round(recall, 4), 'precision': round(precision, 4), 'recall_1px': round(1.0 - float((judge & (dT > 1.0)).sum()) / max(int(judge.sum()), 1), 4),
           'lines_px': int(judge.sum()), 'traced_px': int(Tin.sum())}
    loops = closed_loops(G, sh)
    if loops:
        gs = ndi.gaussian_filter(g, 0.6); lev = []; wob = []
        for c in loops:
            q = Cage.resample(np.vstack([c, c[:1]]), 1.0)[:-1]
            if len(q) < 12:
                continue
            tan = np.roll(q, -2, 0) - np.roll(q, 2, 0); tan /= np.maximum(np.linalg.norm(tan, axis=1, keepdims=True), 1e-9); nrm = np.stack([tan[:, 1], -tan[:, 0]], 1)
            smp = lambda P_: ndi.map_coordinates(gs, [P_[:, 1] - 0.5, P_[:, 0] - 0.5], order=1, mode='nearest')
            a, m, b = smp(q - 2 * nrm), smp(q), smp(q + 2 * nrm); con = np.abs(a - b) > 25
            lev.append(np.abs(m[con] - (a[con] + b[con]) / 2) / np.abs(a[con] - b[con]))
            q2 = q[::2]; wob.append(np.linalg.norm(np.roll(q2, 1, 0) - 2 * q2 + np.roll(q2, -1, 0), axis=1))     # second difference every 2 px: 0 on a line, 4/R on an arc
        lev = np.concatenate(lev) if lev else np.array([1.0]); wob = np.concatenate(wob) if wob else np.array([9.0])
        fill = np.asarray(Image.fromarray((fill_loops([c * 4 for c in loops], (g.shape[0] * 4, g.shape[1] * 4)) * 255).astype(np.uint8)).resize((g.shape[1], g.shape[0]), Image.BOX)) > 127
        res.update({'outline_level': round(float((lev <= 0.2).mean()), 4), 'outline_level_mean': round(float(lev.mean()), 3), 'outline_rough_px': round(float(np.median(wob)), 3),
                    'mask_iou': round(float((fill & sil).sum() / max(1, (fill | sil).sum())), 4), 'contrasted_points': int(len(lev))})
    gate = P['gate']
    res['pass'] = bool(res['recall'] >= gate['recall'] and res['precision'] >= gate['precision'] and res.get('outline_level', 0) >= gate['outline_level'] and res.get('outline_level_mean', 9) <= gate['outline_level_mean']
                       and res.get('outline_rough_px', 9) <= gate['outline_rough_px'] and res.get('mask_iou', 0) >= gate['mask_iou'])
    return res


def closed_loops(G, sh=(0.0, 0.0)):
    """Outline pieces chained back into closed loops (the biggest first)."""
    es = [e for e in G['edges'] if e.get('role') == 'outline']; used = set(); loops = []
    for i, e in enumerate(es):
        if i in used:
            continue
        loop = [np.asarray(e['poly'], float)]; used.add(i); end = e['b']; start = e['a']
        while end != start:
            nxt = next((j for j, f in enumerate(es) if j not in used and f['a'] == end), None)
            if nxt is None:
                break
            loop.append(np.asarray(es[nxt]['poly'], float)); used.add(nxt); end = es[nxt]['b']
        loops.append(np.vstack(loop) + np.asarray(sh, float))
    return sorted(loops, key=lambda l: -len(l))


