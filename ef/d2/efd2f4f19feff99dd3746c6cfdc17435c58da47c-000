def selftest():
    import tempfile
    d = Path(tempfile.mkdtemp()); H, W = 160, 260
    g = np.full((H, W), 90.0); sil = np.zeros((H, W), bool)
    im = Image.new('L', (W * 4, H * 4), 90); dr = ImageDraw.Draw(im)
    body = [(30, 110), (60, 50), (150, 30), (230, 70), (240, 120), (30, 120)]
