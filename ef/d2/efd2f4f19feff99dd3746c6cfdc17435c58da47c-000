    from skimage import measure
    cs = measure.find_contours(sil3, 0.5)
    out = [np.stack([c[:, 1], c[:, 0]], 1) + 0.5 for c in cs if len(c) > 12 * S]     # index -> continuous working px (pixel i covers [i, i+1))
    return sorted(out, key=lambda c: -len(c))


def refine_outline(g3, c, passes=2):
    """10 November 2026: a closed contour (continuous working px) moved onto the strongest edge of the image. The mask
    only says roughly where the object ends; the gradient of the image says exactly where, to sub-pixel. Offsets along
    the normal are median filtered then smoothed around the loop, so a weak edge (ground shadow) follows its neighbours."""
    G = ndi.gaussian_gradient_magnitude(g3, P['outline_sigma_px'] * S)
    R = P['outline_search_px'] * S; ts = np.arange(-R, R + 1e-6, 0.5)
    seg = np.linalg.norm(np.diff(np.vstack([c, c[:1]]), axis=0), axis=1); L = float(seg.sum()); n = max(16, int(L))
    u = np.concatenate([[0], np.cumsum(seg)]); cc = np.vstack([c, c[:1]])
    c = np.stack([np.interp(np.linspace(0, L, n, endpoint=False), u, cc[:, k]) for k in range(2)], 1)
    for _ in range(passes):
        tan = np.roll(c, -3, 0) - np.roll(c, 3, 0); tan /= np.maximum(np.linalg.norm(tan, axis=1, keepdims=True), 1e-9)
        nrm = np.stack([tan[:, 1], -tan[:, 0]], 1)
        X = c[:, None, 0] + ts[None, :] * nrm[:, None, 0]; Y = c[:, None, 1] + ts[None, :] * nrm[:, None, 1]
        val = ndi.map_coordinates(G, [Y - 0.5, X - 0.5], order=1, mode='nearest')
        score = val * (1.0 - 0.25 * np.abs(ts)[None, :] / R)
        k = score.argmax(1); peak = val[np.arange(n), k]; t = ts[k].astype(float)
        inside = (k > 0) & (k < len(ts) - 1); ki = k[inside]; rows = np.arange(n)[inside]
        a, b, d = val[rows, ki - 1], val[rows, ki], val[rows, ki + 1]
        den = a - 2 * b + d                                 # parabola through the three samples about the peak; half a step at most
        t[inside] += 0.5 * np.clip(np.where(den < -1e-9, 0.5 * (a - d) / np.where(den < -1e-9, den, -1.0), 0.0), -0.5, 0.5)
        weak = peak < P['outline_weak'] * np.median(peak)
        if weak.all():
            return c
        idx = np.arange(n); t[weak] = np.interp(idx[weak], idx[~weak], t[~weak], period=n)
        t = ndi.median_filter(t, size=9, mode='wrap'); t = ndi.gaussian_filter1d(t, 2.5, mode='wrap')
        c = c + t[:, None] * nrm
        if weak.any():                                      # no edge to read (ground shadow): the outline there is the smooth run of its neighbours
            sm = np.stack([ndi.gaussian_filter1d(c[:, k], 3.0 * S, mode='wrap') for k in range(2)], 1)
            w = ndi.gaussian_filter1d(weak.astype(float), 1.5 * S, mode='wrap')[:, None]
            c = (1 - w) * c + w * sm
    return c


def fill_loops(loops, shape):
    """Even-odd fill of closed contours given in continuous px of that shape."""
    acc = np.zeros(shape, bool)
    for c in loops:
        im = Image.new('L', (shape[1], shape[0]), 0)
        ImageDraw.Draw(im).polygon([(float(x) - 0.5, float(y) - 0.5) for x, y in c], fill=255)
        acc ^= np.asarray(im) > 127
    return acc


def assemble(g, sil, judge=None):
    """The whole tracing of one view: {'nodes': [[u, v, kind]], 'edges': [[a, b, poly (view px), role, kind]]}."""
    lines, sil3 = detect(g, sil, judge)
    nodes, edges = skeleton_graph(lines); edges = prune_merge(nodes, edges)
    nodes = [[n[0] + 0.5, n[1] + 0.5] for n in nodes]; edges = [[a, b, p + 0.5] for a, b, p in edges]      # pixel centres, continuous working px
    H, W = g.shape
    g3 = np.asarray(Image.fromarray(g.astype(np.uint8)).resize((W * S, H * S), Image.BICUBIC)).astype(float)
    cont = [refine_outline(g3, c) for c in outlines(sil3)]
    out_nodes = []; out_edges = []; remap = {}

    def node(xy, kind):
        out_nodes.append([float(xy[0]) / S, float(xy[1]) / S, kind]); return len(out_nodes) - 1
    # ends of inner lines that reach the outline band join the outline
    deg = {}
    for a, b, _p in edges:
        deg[a] = deg.get(a, 0) + 1; deg[b] = deg.get(b, 0) + 1
    splits = [set() for _ in cont]; joined = {}
    if cont:
        allp = np.vstack(cont); owner = np.concatenate([np.full(len(c), i) for i, c in enumerate(cont)])
        local = np.concatenate([np.arange(len(c)) for c in cont]); tree = cKDTree(allp)
        reach = (P['sil_band_px'] + P['join_px']) * S
        aim = {}                                           # direction a free end points to (last 4 px of its line)
        for a, b, p_ in edges:
            if len(p_) >= 3:
                k = min(len(p_) - 1, 4 * S)
                aim[a] = p_[0] - p_[k]; aim[b] = p_[-1] - p_[-1 - k]
        for n, d in deg.items():
            if d == 1 and n in aim:
                dist, k = tree.query(nodes[n]); to = allp[k] - np.asarray(nodes[n]); v = aim[n]
                cosang = float(to @ v) / max(float(np.linalg.norm(to) * np.linalg.norm(v)), 1e-9)
                if dist <= reach and (cosang >= 0.8 or dist < 1.0):     # a line that runs along the outline does not join it
                    joined[n] = (int(owner[k]), int(local[k])); splits[owner[k]].add(int(local[k]))
    on_outline = {}
    for ci, c in enumerate(cont):
        cuts = set(split_corners(c, True)[:-1]) | splits[ci]
        if len(cuts) < 2:
            cuts |= {0, len(c) // 2}
        cuts = sorted(cuts); ids = []
        for k in cuts:
            ids.append(node(c[k], 'O')); on_outline[(ci, k)] = ids[-1]
        for i in range(len(cuts)):
            a, b = cuts[i], cuts[(i + 1) % len(cuts)]
            seg = c[a:b + 1] if b > a else np.vstack([c[a:], c[:b + 1]])
            fp, kind = fair_piece(seg); out_edges.append([ids[i], ids[(i + 1) % len(cuts)], fp, 'outline', kind])
    for a, b, p in edges:
        closed = a == b
        cuts = split_corners(p, closed) if len(p) > 6 else [0, len(p) - 1]
        if closed and len(cuts) == 2:
            cuts = [0, len(p) // 2, len(p) - 1]                         # a ring needs two pieces to be fitted
        ids = []
        for k in cuts:
            if k == 0 and a in remap:
                ids.append(remap[a])
            elif k == len(p) - 1 and b in remap:
                ids.append(remap[b])
            else:
                src = a if k == 0 else (b if k == len(p) - 1 else None)
                if src is not None and src in joined:
                    nid = on_outline[joined[src]]
                else:
                    nid = node(p[k], 'J' if (src is not None and deg.get(src, 0) >= 3) else ('E' if src is not None and deg.get(src, 0) == 1 else 'C'))
                if src is not None:
                    remap[src] = nid
                ids.append(nid)
        for i in range(len(cuts) - 1):
            seg = p[cuts[i]:cuts[i + 1] + 1].copy()
            seg[0] = np.array(out_nodes[ids[i]][:2]) * S; seg[-1] = np.array(out_nodes[ids[i + 1]][:2]) * S    # a joined end runs to the outline
            fp, kind = fair_piece(seg); out_edges.append([ids[i], ids[i + 1], fp, 'line', kind])
    out_nodes, out_edges = bridge_gaps(out_nodes, out_edges)
    return {'nodes': out_nodes, 'edges': out_edges, 'sil3': fill_loops(cont, (H * S, W * S)) if cont else sil3 > 0.5}


def bridge_gaps(nodes, edges):
    """10 November 2026: a weak edge is detected in dashes, and a line often stops a few pixels short of the line it
    meets. A bridge is a straight inferred piece (role 'bridge') that joins two facing ends, or an end to the line it
    points at, so that a plan edge can be followed from corner to corner. Bridges are not counted as traced lines."""
    deg = {}
    for e in edges:
        deg[e[0]] = deg.get(e[0], 0) + 1; deg[e[1]] = deg.get(e[1], 0) + 1
    aim = {}; host = {}
    for i, e in enumerate(edges):
        p = e[2]
        if e[3] != 'line' or len(p) < 2:
            continue
        k = min(len(p) - 1, 6)
        for n, d in ((e[0], p[0] - p[k]), (e[1], p[-1] - p[-1 - k])):
            if deg.get(n, 0) == 1 and nodes[n][2] != 'O' and np.linalg.norm(d) > 1e-9:
                aim[n] = d / np.linalg.norm(d); host[n] = i
    free = list(aim); new_edges = []; done = set()
    P_ = {n: np.array(nodes[n][:2]) for n in free}
    # 1. two facing ends
    for n in free:
        best = None
        for m in free:
            if m == n or host[m] == host[n] or m in done or n in done:
                continue
            v = P_[m] - P_[n]; dist = float(np.linalg.norm(v))
            if 1e-6 < dist <= P['gap_px'] and float(aim[n] @ v) / dist >= P['gap_cos'] and float(aim[m] @ -v) / dist >= P['gap_cos']:
                if best is None or dist < best[0]:
                    best = (dist, m)
        if best is not None:
            m = best[1]; new_edges.append([n, m, np.stack([P_[n], P_[m]]), 'bridge', 'line']); done.add(n); done.add(m)
    # 2. an end that points at another line
    samples = []; owner = []; index = []
    for i, e in enumerate(edges):
        q = np.asarray(e[2], float); samples.append(q); owner += [i] * len(q); index += list(range(len(q)))
    if samples:
        allp = np.vstack(samples); owner = np.array(owner); index = np.array(index); tree = cKDTree(allp); splits = {}
        for n in free:
            if n in done:
                continue
            best = None
            for k in tree.query_ball_point(P_[n], P['tee_px']):
                if owner[k] == host[n]:
                    continue
                v = allp[k] - P_[n]; dist = float(np.linalg.norm(v))
                if dist < 1e-6 or float(aim[n] @ v) / dist >= P['gap_cos'] - 0.15:
                    if best is None or dist < best[0]:
                        best = (dist, k)
            if best is not None:
                k = best[1]; splits.setdefault(int(owner[k]), []).append((int(index[k]), n)); done.add(n)
        for i, lst in splits.items():
            a, b, poly, role, kind = edges[i]; poly = np.asarray(poly, float); cuts = sorted(set(min(max(j, 0), len(poly) - 1) for j, _ in lst))
            ids = {}
            for j in cuts:
                if j == 0:
                    ids[j] = a
                elif j == len(poly) - 1:
                    ids[j] = b
                else:
                    nodes.append([float(poly[j, 0]), float(poly[j, 1]), 'J' if role != 'outline' else 'O']); ids[j] = len(nodes) - 1
            seq = [0] + [j for j in cuts if 0 < j < len(poly) - 1] + [len(poly) - 1]; nid = [a] + [ids[j] for j in seq[1:-1]] + [b]
            edges[i] = [nid[0], nid[1], poly[seq[0]:seq[1] + 1], role, kind]
            for t in range(1, len(seq) - 1):
                edges.append([nid[t], nid[t + 1], poly[seq[t]:seq[t + 1] + 1], role, kind])
            for j, n in lst:
                j = min(max(j, 0), len(poly) - 1); new_edges.append([n, ids[j], np.stack([P_[n], poly[j]]), 'bridge', 'line'])
    return nodes, edges + new_edges


