#!/bin/zsh
# 2 November 2026 : the whole dragon from parts that kept their structure : placed by anchors, moved as blocks, large parts refined on a leash, then sculpted ; three views judge. FR : le dragon entier depuis des pièces qui ont gardé leur structure : placées par repères, déplacées d'un bloc, grandes pièces affinées en laisse, puis sculpté ; trois vues jugent.
cd /Users/zenray/.claude/tmp/tmp-zenray-meshes/work/dracard/v3; PY=/Users/zenray/.venvs/zenray-meshes/bin/python; HY=/Applications/Houdini/Current/Frameworks/Houdini.framework/Versions/Current/Resources/bin/hython; F=../../../Scripts/Dracard/DragonFit.py; C=../../../Scripts/Dracard/Comp; V=1419,1423,1435,1439,1447,1455; U=1431,1443,1451; O=parts/T_all/f; mkdir -p $O/s
$PY -I - <<'P'
import json
get=lambda f:json.load(open(f))['tubes']
def clean(L):
    for t in L:
        for k in list(t):
            if k.startswith('_'): t.pop(k)
    return L
Pl=clean(get('parts/T_plates/fit2.json')); Body=clean(get('parts/T_body/fit3.json')); W=clean(get('parts/T_wing/fit_b3.json')); H=[t for t in clean(get('parts/T_horn/fit4.json')) if t.get('kind')!='obj']
by=lambda L:{t['name']:t for t in L}; p=by(Pl); b=by(Body); w=by(W); h=by(H)
for t in W+Body+H+Pl: t.pop('leash',None); t['frozen']=True
for t in W: t['mirror']=True
h['horn_base'].update(pts=[[.346,.783,-.284],[.413,.85,-.251]],radius=1.0,ramp=[[0,.1],[.3,.165],[.7,.165],[1,.1]])
h['horn'].update(pts=[[.416,.76,-.286],[.56,.9,-.17],[.655,1.13,-.1],[.6,1.27,-.03],[.43,1.33,0.0]],radius=1.0,ramp=[[0,.085],[.35,.075],[.7,.05],[1,.006]])
head=dict(name='head',kind='obj',file='parts/sf/head_final/part.obj',pts=[[0,0,0]],ramp=[[0,1]],radius=1.0,mirror=False)
sets=[dict(name='back',tubes=Pl,anchors={'c_tail_tip':p['tail']['pts'][-1],'c_plate18':p['plate_18']['pts'][2],'c_plate09':p['plate_09']['pts'][2]}),
 dict(name='head',tubes=[head]+H,anchors={'c_nose_top':[0,.815,1.675],'c_nose_low':[0,-.239,2.058],'horn_tip':h['horn']['pts'][-1]}),
 dict(name='limbs',tubes=[t for t in Body if t['name']!='torso'],anchors={'toe':b['toe_mid']['pts'][-1],'heel':b['foot']['pts'][0],'hand':b['finger_b']['pts'][-1],'thumb':b['thumb']['pts'][-1]}),
 dict(name='wings',tubes=W,free_x=True,anchors={'wing_tip1':w['finger1']['pts'][-1],'wing_tip3':w['finger3']['pts'][-1],'wing_claw':w['claw']['pts'][-1]})]
json.dump(dict(sets=sets),open('parts/T_all/f/sets.json','w'))
P
$PY -I $C/PlaceByAnchors.py parts/T_all/bundle.json $O/sets.json $O/placed.json
$PY -I - <<'P'
import json
D=json.load(open('parts/T_all/f/placed.json')); by={t['name']:t for t in D['tubes']}
by['thigh'].update(pts=[[.70,-.46,.48],[.66,-.96,.48]],radius=1.0,ramp=[[0,.06],[.15,.26],[.35,.39],[.5,.42],[.65,.39],[.85,.26],[1,.06]],flatten=[1,1,1.05])
json.dump(D,open('parts/T_all/f/placed.json','w'),indent=0)
P
$PY -I $C/CamSearch.py parts/T_all/views $O/placed.json $V $O/cams0.json 2>&1 | head -1 | cut -c1-260
$PY -I $F parts/T_all/views $O/placed.json $O/s1.json --minutes 3 --coarse --views $V --cams $O/cams0.json 2>&1 | grep -E '^final|Traceback' | sed 's/.*mean/BLOCKS mean/' | cut -c1-100
$PY -I - <<'P'
import json
D=json.load(open('parts/T_all/f/s1.json'))
for t in D['tubes']:
    if t['name'] in ('body_ep05','tail'): t.pop('frozen',None); t['leash']=.12; t['leash_ratio']=1.12
    if t['name'].startswith('plate_'): t.pop('frozen',None); t['leash']=.05; t['leash_ratio']=4
json.dump(D,open('parts/T_all/f/s2in.json','w'))
P
$PY -I $F parts/T_all/views $O/s2in.json $O/s2.json --minutes 3 --views $V --cams $O/s1.json.cams.json 2>&1 | grep -E '^final|Traceback' | sed 's/.*mean/LARGE PARTS mean/' | cut -c1-100
perl -e 'alarm 300; exec @ARGV' $HY $C/TubeBuild.py $O/s2.json $O/h 2>&1 | grep -v Octane | tail -1 | cut -c1-140
$PY -I $C/CamConvert.py to_comp $O/s2.json.cams.json $O/h/cams.json
echo TUBES ONLY; $PY -I $C/PartBoard.py $O/h full/ep05 $V $O/h/board.png --mask grey --tile 420 2>&1 | tail -1 | cut -c1-150
echo UNSEEN TUBES; $PY -I $C/CamSearch.py parts/T_all/views $O/h/part.obj $U $O/h/cams_unseen.json 2>&1 | head -1 | cut -c1-230
cp $O/h/part.obj $O/s/cage.obj; cp $O/h/cams.json $O/s/cams.json; rm -f $O/s/sculpt.json
$PY -I - <<'P'
import json
D=json.load(open('parts/T_all/f/s2.json')); h=[t for t in D['tubes'] if t.get('kind')=='obj'][0]; x=h['xform']; s_=x[3]
pr=[[0.0,y*s_+x[1],z*s_+x[2],r*s_] for y,z,r in ((0.0,1.9,1.15),(0.1,0.9,1.0),(0.1,-0.5,1.35))]
json.dump(dict(protect=pr),open('parts/T_all/f/s/protect.json','w'))
P
$PY -I $C/CompFit.py $O/s full/ep05 $V --mask grey --symmetric 1 --levels 0 --minutes ${1:-6} --cam-range 3 --centers 400 --brushes 0.03:0.0015,0.015:0.001,0.008:0.0006 --fair 100 --protect $O/s/protect.json 2>&1 | grep -E '^score|Traceback' | cut -c1-260
$PY -I - <<'P'
import json,numpy as np
V=[];rest=[]
for l in open('parts/T_all/f/s/cage.obj'):
    if l.startswith('v '): V.append([float(x) for x in l.split()[1:4]])
    elif l.startswith('f '): rest.append(l)
D=np.array(json.load(open('parts/T_all/f/s/sculpt.json'))); V=np.array(V)+D; print('moved',int((np.abs(D).sum(1)>1e-6).sum()),'of',len(V),'max',round(float(np.linalg.norm(D,axis=1).max()),3))
with open('parts/T_all/f/s/part.obj','w') as o:
    for v in V: o.write('v %f %f %f\n'%tuple(v))
    o.writelines(rest)
P
echo SCULPTED; $PY -I $C/PartBoard.py $O/s full/ep05 $V $O/s/board.png --mask grey --tile 420 2>&1 | tail -1 | cut -c1-150
echo UNSEEN SCULPTED; $PY -I $C/CamSearch.py parts/T_all/views $O/s/part.obj $U $O/s/cams_unseen.json 2>&1 | head -1 | cut -c1-230
mkdir -p $O/t; SF=../../../tools/sculptforge/build/sculptforge-cli; perl -e 'alarm 200; exec @ARGV' $SF -q -c "open path=$PWD/$O/s/part.obj; deform_smooth amount=25 keep_volume=true; save_obj path=$PWD/$O/t/part.obj"; cp $O/s/cams.json $O/t/cams.json
echo SMOOTHED; $PY -I $C/PartBoard.py $O/t full/ep05 $V $O/t/board.png --mask grey --tile 420 2>&1 | tail -1 | cut -c1-150
echo UNSEEN SMOOTHED; $PY -I $C/CamSearch.py parts/T_all/views $O/t/part.obj $U $O/t/cams_unseen.json 2>&1 | head -1 | cut -c1-230
echo FINAL_DONE
