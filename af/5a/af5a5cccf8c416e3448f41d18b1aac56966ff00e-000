"""29 October 2026 : ZenRay Retopology TUNE RAW, the rippled but clean panels of the validated car rebuilt on THEIR OWN outline (cut raw :
the part mask in its own view) with the fair field that removes the ripples ; 24 combinations each (harmonic, smoothing wavelength,
border band, Winslow), the best written into the table when it passes more judge lines than the current entry.
python ZrlTuneRaw.py <part> [...]        FR : les panneaux ondulés refaits sur leur propre contour, avec le champ lissé."""
import itertools, json, sys
from concurrent.futures import ThreadPoolExecutor
ROOT = "/Users/zenray/.claude/tmp/tmp-zenray-meshes"
sys.path.insert(0, f"{ROOT}/Scripts/lines")
import ZrlTune as T
GRID = {"cut": ["raw"], "corners": [4], "harmonic": [0, 1], "fair_cut_m": [0.3, 0.6, 1.0], "data_border_m": [0.004, 0.015], "winslow": [0, 2]}   # 29 October 2026

if __name__ == "__main__":
    jobs = [(n, dict(zip(GRID, v))) for n in sys.argv[1:] for v in itertools.product(*GRID.values())]
    with ThreadPoolExecutor(8) as ex: res = list(ex.map(lambda j: (j[0],) + T.build(*j), jobs))
    table = json.load(open(T.PARAMS["table"]))
    for n in sys.argv[1:]:
        mine = [r for r in res if r[0] == n and r[2] is not None]
        if not mine: print(n, "no build"); continue
        best = max(mine, key=lambda r: T.rank(r[2])); cur = table.get(n); cur_j = T.build(n, cur)[1] if cur else None
        better = cur_j is None or T.rank(best[2]) > T.rank(cur_j)
        print(f"{n:30s} raw best {best[2]['score']['percent']} % (was {cur_j['score']['percent'] if cur_j else None}) failed {[k for k, v in best[2].items() if k != 'score' and not v['ok']]} {'KEEP' if better else ''}", flush=True)
        if better: table[n] = {k: best[1][k] for k in best[1]}
    json.dump(table, open(T.PARAMS["table"], "w"), indent=1)
