  }
  function renderSelection() {
    const g = el.gSel, k = S.v2.k;
    g.innerHTML = '';
    if (S.sel.arc != null) {
      const a = model.arc(S.sel.arc);
      if (a) {
        const e = entryFor(a);
        g.appendChild(svgEl('path', { d: pathFromRuns(e, [[0, e.x.length - 1]], 2), fill: 'none', stroke: C.arcSelected, 'stroke-width': Z.arcSelected / k, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }));
        const q = [0, 0, 0], poly = [];
        a.ctrl.forEach((c, i) => { project(S.viewDef, c, q); poly.push((i ? 'L' : 'M') + q[0] + ' ' + q[1]); });
        g.appendChild(svgEl('path', { d: poly.join(''), fill: 'none', stroke: C.polygon, 'stroke-width': Z.polygon / k, 'stroke-dasharray': Z.dashPolygon.map((d) => d / k).join(' '), opacity: 0.8 }));
        const ma = S.params.mirror && a.mirror >= 0 && a.mirror !== a.id ? model.arc(a.mirror) : null;
        if (ma) { const me = entryFor(ma); g.appendChild(svgEl('path', { d: pathFromRuns(me, [[0, me.x.length - 1]], 2), fill: 'none', stroke: C.arcSelected, 'stroke-width': 1.4 / k, 'stroke-dasharray': Z.dashHidden.map((d) => d / k).join(' '), opacity: 0.7 })); }
        for (const h of handleList(a)) {
          g.appendChild(svgEl('circle', { cx: h.x, cy: h.y, r: Z.handleRadius / k, fill: C.handleFill, stroke: C.handleStroke, 'stroke-width': Z.handleStroke / k, 'data-i': h.i }));
        }
