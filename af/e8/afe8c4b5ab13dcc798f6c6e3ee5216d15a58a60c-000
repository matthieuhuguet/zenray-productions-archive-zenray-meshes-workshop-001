    for (const a of model.doc.arcs) for (const n of new Set(a.pair)) if (n) counts.set(n, (counts.get(n) || 0) + 1);
    el.compList.innerHTML = '';
    for (const [name, c] of counts) {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'chip' + (S.filter.comp === name ? ' on' : ''); b.setAttribute('data-comp', name);
