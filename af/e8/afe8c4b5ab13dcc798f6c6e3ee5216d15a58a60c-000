    }
    updateButtons();
  }
  function updateButtons() {
    el.bUndo.disabled = !model.undoStack.length; el.bRedo.disabled = !model.redoStack.length;
    const has = S.sel.arc != null && !!model.arc(S.sel.arc);
    el.bSmooth.disabled = !has; el.bWeld.disabled = !has; el.bDelete.disabled = !has;
    el.bAdd.classList.toggle('on', S.mode === 'add');
    refreshTitle();
  }

  // ---------------------------------------------------------------- edits
  function afterEdit(plan, finished) {
    for (const id of plan.arcs) { const a = model.arc(id); if (a) updateArc(a); }
    if (plan.nodes) renderNodes(); else renderGaps();
    renderSelection(); renderHover();
    if (S.filter.comp) renderComponent();
    if (finished) { updateRowLengths(plan.arcs); updateInfo(); }
    refreshTitle();
  }
  function structureChanged() {
    syncArcEls(); renderNodes(); renderSelection(); renderHover(); renderComponent();
    renderComponentList(); renderArcList(); updateInfo();
  }
  function discreteEdit(label, fn) {
    if (S.sel.arc == null) return;
    model.checkpoint();
    const ids = fn();
    afterEdit({ arcs: ids }, true);
    updateButtons();
    setStatus(label + ' (' + ids.map((i) => '#' + i).join(', ') + ')');
  }
  function doSmooth() { discreteEdit('Smoothed', () => model.smooth(S.sel.arc, S.params.smoothAmount, S.params.mirror)); }
  function doWeld() { discreteEdit('Welded ends to nodes', () => model.weld(S.sel.arc, S.params.mirror)); }
  function doDelete() {
    if (S.sel.arc == null) return;
    model.checkpoint();
    const ids = model.removeArcs(S.sel.arc, S.params.mirror);
    S.sel.arc = null;
    structureChanged();
    setStatus('Deleted ' + ids.map((i) => '#' + i).join(', '));
  }
  function doUndo() { if (model.undo()) { fixSelection(); S.proj.clear(); structureChanged(); setStatus('Undo'); } }
  function doRedo() { if (model.redo()) { fixSelection(); S.proj.clear(); structureChanged(); setStatus('Redo'); } }
  function fixSelection() { if (S.sel.arc != null && !model.arc(S.sel.arc)) S.sel.arc = null; if (S.sel.node != null && !model.node(S.sel.node)) S.sel.node = null; }

  function setMode(mode) {
    S.mode = mode; S.addFirst = null;
    el.stage.classList.toggle('mode-add', mode === 'add');
    el.modeHint.textContent = mode === 'add' ? 'Click a start node, then an end node. Esc cancels.' : 'Select, drag handles and nodes.';
    removePreview(); renderNodes(); updateButtons();
  }
  function removePreview() { if (S.preview) { S.preview.remove(); S.preview = null; } }
  function addModeClick(pt) {
    const best = nearestNode(pt);
    if (best === null) { setStatus('No node under the cursor. Click on a red dot.'); return; }
    if (S.addFirst === null) { S.addFirst = best; renderNodes(); setStatus('Start node #' + best + '. Now click the end node.'); return; }
    if (best === S.addFirst) return;
    model.checkpoint();
    const created = model.addArc(S.addFirst, best, S.params.mirror);
    setMode('select');
    if (created) { structureChanged(); selectArc(created[0], { reveal: true }); setStatus('Added arc ' + created.map((i) => '#' + i).join(', ') + ' (4 control points)'); }
  }

  // ---------------------------------------------------------------- pointer interaction
  function onDown(ev) {
    if (ev.button === 1 || (ev.button === 0 && S.space)) { S.drag = { type: 'pan', sx: ev.clientX, sy: ev.clientY, x0: S.v2.x0, y0: S.v2.y0 }; el.stage.classList.add('panning'); ev.preventDefault(); return; }
    if (ev.button !== 0) return;
    const pt = imgPoint(ev);
    if (S.mode === 'add') { addModeClick(pt); return; }
    const hit = pickAt(pt);
    if (hit.type === 'ctrl' || hit.type === 'node') {
      const hx = hit.type === 'ctrl' ? hit.x : S.nodeView.get(hit.id).x, hy = hit.type === 'ctrl' ? hit.y : S.nodeView.get(hit.id).y;
      const p3 = hit.type === 'ctrl' ? model.arc(hit.arc).ctrl[hit.index] : model.node(hit.id).p, q = project(S.viewDef, p3, [0, 0, 0]);
      S.drag = { type: hit.type, hit, sx: ev.clientX, sy: ev.clientY, started: false, plan: null, depth0: q[2], offset: [hx - pt[0], hy - pt[1]] };
    } else if (hit.type === 'arc') {
      selectArc(hit.id);
    } else {
      S.drag = { type: 'bg', sx: ev.clientX, sy: ev.clientY, x0: S.v2.x0, y0: S.v2.y0, moved: false };
    }
  }
  function pointFromCursor(d, ev) {
    const pt = imgPoint(ev), x = pt[0] + d.offset[0], y = pt[1] + d.offset[1];
    let depth = d.depth0, snapped = false;
    if (S.params.snap && S.depth) {
      const s = S.depth.surface(x, y, CONFIG.snap.searchPx, CONFIG.snap.maxJumpM);
      if (s === s && Math.abs(s - d.depth0) <= CONFIG.snap.maxDepthM) { depth = s; snapped = true; }    // a point on the far side of the car is not pulled through it
    }
    return { p: unproject(S.viewDef, x, y, depth), snapped };
  }
  function onMove(ev) {
    const d = S.drag;
    if (!d) { if (ev.target === el.svg || el.stage.contains(ev.target)) scheduleHover(ev); return; }
    if (ev.buttons === 0) { onUp(ev); return; }                  // the button was released outside the window : end the drag
    const dx = ev.clientX - d.sx, dy = ev.clientY - d.sy;
    if (d.type === 'pan') { S.v2.x0 = d.x0 - dx / S.v2.k; S.v2.y0 = d.y0 - dy / S.v2.k; applyViewBox(); return; }
    if (d.type === 'bg') {
      if (!d.moved && Math.hypot(dx, dy) > CONFIG.pick.dragStartPx) { d.moved = true; el.stage.classList.add('panning'); }
      if (d.moved && CONFIG.zoom.leftDragPansBackground) { S.v2.x0 = d.x0 - dx / S.v2.k; S.v2.y0 = d.y0 - dy / S.v2.k; applyViewBox(); }
      return;
    }
    if (!d.started) {
      if (Math.hypot(dx, dy) < CONFIG.pick.dragStartPx) return;
      d.started = true;
      model.checkpoint();
      d.plan = d.type === 'ctrl' ? model.beginCtrlDrag(d.hit.arc, d.hit.index, S.params.mirror) : model.beginNodeDrag(d.hit.id, S.params.mirror);
      if (d.type === 'ctrl') { S.sel.arc = d.hit.arc; S.sel.node = null; updateRowSelection(); }
      if (d.plan.mismatch) setStatus('Mirror arc has another control point count: only this side moves.', 'warn');
      else if (d.plan.detached) setStatus(d.plan.detached + ' arc end(s) are farther than ' + (CONFIG.attach.tolM * 1000) + ' mm from this node and stay where they are (use Weld ends).', 'warn');
    }
    const r = pointFromCursor(d, ev);
    d.plan.apply(r.p);
    afterEdit(d.plan, false);
    el.coords.textContent = r.p.map((v) => v.toFixed(3)).join('  ') + (r.snapped ? '  (surface)' : '');
  }
  function onUp(ev) {
    const d = S.drag;
