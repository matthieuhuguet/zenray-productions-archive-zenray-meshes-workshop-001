    'pMirror', 'pSnap', 'pHidden', 'pNodes', 'pGaps', 'pSvgBg', 'pBgOpacity', 'pSmooth', 'pLineWidth', 'bUndo', 'bRedo', 'bSmooth', 'bWeld', 'bDelete',
