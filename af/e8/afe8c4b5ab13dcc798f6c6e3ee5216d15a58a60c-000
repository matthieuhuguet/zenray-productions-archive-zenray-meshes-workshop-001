    };
  };

  M.beginNodeDrag = (nodeId, mirrorOn) => {
    const targets = [{ id: nodeId, mirrored: false }];
    let plane = false;
    if (mirrorOn) {
      const mid = M.nodeMirror.get(nodeId);
      if (mid === nodeId) plane = true; else if (mid != null) targets.push({ id: mid, mirrored: true });
    }
    const ends = [];
    let detached = 0;
    for (const t of targets) {
      for (const e of M.attachedEnds(t.id, CONFIG.attach.tolM)) ends.push({ arc: e.arc, index: e.index, node: t });
      detached += M.nodeArcs(t.id).length - ends.filter((e) => e.node === t).length;
    }
    const touched = [...new Set(ends.map((e) => e.arc.id))];
    return {
      arcs: touched, nodes: targets.map((t) => t.id), detached, mismatch: false,
      apply(p) {
        const q = clone3(p);
        if (plane) q[0] = 0;
        for (const t of targets) M.nodeMap.get(t.id).p = t.mirrored ? mir(q) : clone3(q);
        for (const e of ends) e.arc.ctrl[e.index] = clone3(M.nodeMap.get(e.node.id).p);
        for (const id of touched) M.touch(id);
        M.dirty = true;
      },
    };
  };

  // ---- discrete edits (the caller takes a checkpoint first). Each returns the ids of the arcs it changed.
  M.mirrorIds = (arcId, mirrorOn) => {
    const ids = [arcId], a = M.arcMap.get(arcId);
    if (mirrorOn && a && a.mirror != null && a.mirror >= 0 && a.mirror !== arcId && M.arcMap.has(a.mirror)) ids.push(a.mirror);
    return ids;
  };

  M.smooth = (arcId, lambda, mirrorOn) => {
    const ids = M.mirrorIds(arcId, mirrorOn);
    for (const id of ids) {
      const a = M.arcMap.get(id), c = a.ctrl, n = c.length;
      if (n < 3) continue;
      const nc = c.map(clone3);
      for (let i = 1; i < n - 1; i++) for (let k = 0; k < 3; k++) nc[i][k] = c[i][k] + lambda * (0.5 * (c[i - 1][k] + c[i + 1][k]) - c[i][k]);
      a.ctrl = nc;
      M.touch(id);
    }
    return ids;
  };

  M.weld = (arcId, mirrorOn) => {           // put the end control points back on their nodes
    const ids = M.mirrorIds(arcId, mirrorOn);
    for (const id of ids) {
      const a = M.arcMap.get(id), n = a.ctrl.length;
      if (a.a >= 0 && M.nodeMap.has(a.a)) a.ctrl[0] = clone3(M.nodeMap.get(a.a).p);
      if (a.b >= 0 && M.nodeMap.has(a.b)) a.ctrl[n - 1] = clone3(M.nodeMap.get(a.b).p);
      M.touch(id);
    }
    return ids;
  };

  M.removeArcs = (arcId, mirrorOn) => {
    const ids = M.mirrorIds(arcId, mirrorOn), gone = new Set(ids);
    M.doc.arcs = M.doc.arcs.filter((a) => !gone.has(a.id));
