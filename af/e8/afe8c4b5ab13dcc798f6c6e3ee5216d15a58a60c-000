    for (const a of model.doc.arcs) { const b = entryFor(a).bbox; if (b[0] < x0) x0 = b[0]; if (b[1] < y0) y0 = b[1]; if (b[2] > x1) x1 = b[2]; if (b[3] > y1) y1 = b[3]; }
    for (const n of model.doc.nodes) { const q = project(S.viewDef, n.p, [0, 0, 0]); if (q[0] < x0) x0 = q[0]; if (q[1] < y0) y0 = q[1]; if (q[0] > x1) x1 = q[0]; if (q[1] > y1) y1 = q[1]; }
