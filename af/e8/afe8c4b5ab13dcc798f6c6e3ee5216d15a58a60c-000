  function setStatus(msg, kind) { el.status.textContent = msg; el.status.className = kind || ''; }
  const safe = (fn) => (...a) => { try { return fn(...a); } catch (e) { console.error(e); setStatus('Error: ' + (e && e.message ? e.message : e), 'error'); } };
  function refreshTitle() { document.title = (model && model.dirty ? '* ' : '') + 'ZenRay Lines'; }
  function stageRect() { return el.svg.getBoundingClientRect(); }
  function measure() { const r = stageRect(); S.W = r.width; S.H = r.height; }

  // ---------------------------------------------------------------- projection cache
  function entryFor(arc) {
