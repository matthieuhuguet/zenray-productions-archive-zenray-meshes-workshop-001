    }
    if (S.sel.node != null) {
      const v = S.nodeView.get(S.sel.node);
      if (v) g.appendChild(svgEl('circle', { cx: v.x, cy: v.y, r: Z.nodeSelectedRing / k, fill: 'none', stroke: C.nodeSelected, 'stroke-width': 1.8 / k }));
    }
  }
  function renderHover() {
    const g = el.gHover;
    g.innerHTML = '';
    const h = S.hover;
    if (h && h.type === 'arc' && h.id !== S.sel.arc) {
      const a = model.arc(h.id);
      if (a) { const e = entryFor(a); g.appendChild(svgEl('path', { d: pathFromRuns(e, [[0, e.x.length - 1]], 2), fill: 'none', stroke: C.arcHover, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' })); }
    }
  }
  function renderComponent() {
    const g = el.gComp;
    g.innerHTML = '';
    const comp = S.filter.comp;
    if (!comp) return;
    const parts = [];
    for (const a of model.doc.arcs) if (a.pair.includes(comp)) { const e = entryFor(a); parts.push(pathFromRuns(e, [[0, e.x.length - 1]], 2)); }
    if (parts.length) g.appendChild(svgEl('path', { d: parts.join(''), stroke: C.component, opacity: 0.55 }));
  }

  function renderAll() {
    syncArcEls();
    el.gHid.style.display = S.params.showHidden ? '' : 'none';
    renderNodes(); renderSelection(); renderHover(); renderComponent();
    applyZoomStyles();
  }

  // ---------------------------------------------------------------- picking
  function pickAt(pt) {
    const k = S.v2.k;
    if (S.sel.arc != null) {                                   // 1. handles of the selected arc
      const a = model.arc(S.sel.arc);
      if (a) {
        let best = null, bd = Math.pow(CONFIG.pick.handlePx / k, 2);
        for (const h of handleList(a)) { const d = Math.pow(h.x - pt[0], 2) + Math.pow(h.y - pt[1], 2); if (d <= bd) { bd = d; best = h; } }
        if (best) return { type: 'ctrl', arc: a.id, index: best.i, x: best.x, y: best.y };
      }
    }
    const nid = nearestNode(pt);                                  // 2. nodes
    if (nid !== null) return { type: 'node', id: nid };
    const tol = CONFIG.pick.arcPx / k, tol2 = tol * tol;       // 3. arcs : visible parts first, hidden parts only when they are shown
    let bestV = null, bvd = tol2, bestH = null, bhd = tol2;
    for (const a of model.doc.arcs) {
      const e = entryFor(a), b = e.bbox;
      if (pt[0] < b[0] - tol || pt[0] > b[2] + tol || pt[1] < b[1] - tol || pt[1] > b[3] + tol) continue;
      for (let i = 0; i < e.x.length - 1; i++) {
        const d = segDist2(pt[0], pt[1], e.x[i], e.y[i], e.x[i + 1], e.y[i + 1]);
        if (e.vis[i] === 1 && e.vis[i + 1] === 1) { if (d < bvd) { bvd = d; bestV = a.id; } } else if (d < bhd) { bhd = d; bestH = a.id; }
      }
    }
    if (bestV !== null) return { type: 'arc', id: bestV };
    if (bestH !== null && S.params.showHidden) return { type: 'arc', id: bestH };
    return { type: 'none' };
  }
  // nearest node within the pick radius, a visible node winning over a hidden one
  function nearestNode(pt) {
    const r2 = Math.pow(CONFIG.pick.nodePx / S.v2.k, 2);
    let bv = null, bvd = r2, bh = null, bhd = r2;
    for (const [id, v] of S.nodeView) {
      if (!v.show) continue;
      const d = Math.pow(v.x - pt[0], 2) + Math.pow(v.y - pt[1], 2);
      if (v.vis) { if (d < bvd) { bvd = d; bv = id; } } else if (d < bhd) { bhd = d; bh = id; }
