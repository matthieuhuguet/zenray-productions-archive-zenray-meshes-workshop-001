      if (!d.started) { if (d.type === 'node') selectNode(d.hit.id); return; }
      afterEdit(d.plan, true);
      if (d.type === 'node') selectNode(d.hit.id);
      updateButtons();
      if (!d.plan.mismatch && !d.plan.detached) setStatus('Moved (' + (S.params.mirror ? 'mirror on' : 'mirror off') + ')');
    } else if (d.type === 'bg' && !d.moved) {
