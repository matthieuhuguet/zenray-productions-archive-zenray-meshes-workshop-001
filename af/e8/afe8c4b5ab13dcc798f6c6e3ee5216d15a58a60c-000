  };

  const nodeComponents = (nodeId) => { const s = new Set(); for (const a of M.nodeArcs(nodeId)) for (const n of a.pair) if (n) s.add(n); return s; };
  M.addArc = (na, nb, mirrorOn) => {
    const A = M.nodeMap.get(na), B = M.nodeMap.get(nb);
    if (!A || !B || na === nb) return null;
    const k = CONFIG.edit.addArcCtrl, ctrl = [];
    for (let i = 0; i < k; i++) { const t = i / (k - 1); ctrl.push([A.p[0] + (B.p[0] - A.p[0]) * t, A.p[1] + (B.p[1] - A.p[1]) * t, A.p[2] + (B.p[2] - A.p[2]) * t]); }
    ctrl[0] = clone3(A.p); ctrl[k - 1] = clone3(B.p);
    const shared = [...nodeComponents(na)].filter((n) => nodeComponents(nb).has(n));
    const pair = shared.length >= 2 ? [shared[0], shared[1]] : shared.length === 1 ? [shared[0], shared[0]] : ['', ''];
    let nextId = 1 + Math.max(-1, ...M.doc.arcs.map((a) => a.id));
    const arc = { id: nextId++, a: na, b: nb, closed: false, pair, ctrl, mirror: -1 };
    M.doc.arcs.push(arc); M.arcMap.set(arc.id, arc); M.touch(arc.id);
    const created = [arc.id];
    const ma = M.nodeMirror.get(na), mb = M.nodeMirror.get(nb);
    if (mirrorOn && ma != null && mb != null) {
      if ((ma === na && mb === nb) || (ma === nb && mb === na)) arc.mirror = arc.id;             // a centre arc : its own mirror
      else {
        const m = { id: nextId++, a: ma, b: mb, closed: false, pair: pair.map(swapSide), ctrl: ctrl.map(mir), mirror: arc.id };
        m.ctrl[0] = clone3(M.nodeMap.get(ma).p); m.ctrl[k - 1] = clone3(M.nodeMap.get(mb).p);
        arc.mirror = m.id;
        M.doc.arcs.push(m); M.arcMap.set(m.id, m); M.touch(m.id);
        created.push(m.id);
      }
    }
    return created;
  };

  M.serialize = () => serializeDoc(M.doc, CONFIG.export.jsonDecimals);

  M.load(docIn);
  return M;
}

// ------------------------------------------------------------------------------------------------------------------ projection of an arc
// Samples of an arc projected into a view, with a visibility flag per sample (depth map test).
function projectArc(model, arc, view, depthMap) {
  const pts = model.samples(arc.id), m = pts.length / 3;
  const x = new Float32Array(m), y = new Float32Array(m), vis = new Uint8Array(m), p = [0, 0, 0], q = [0, 0, 0];
  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity, anyVis = false;
  for (let i = 0; i < m; i++) {
    p[0] = pts[3 * i]; p[1] = pts[3 * i + 1]; p[2] = pts[3 * i + 2];
    project(view, p, q);
    x[i] = q[0]; y[i] = q[1];
    const v = isVisible(depthMap, q[0], q[1], q[2]);
    vis[i] = v ? 1 : 0; if (v) anyVis = true;
    if (q[0] < x0) x0 = q[0]; if (q[0] > x1) x1 = q[0]; if (q[1] < y0) y0 = q[1]; if (q[1] > y1) y1 = q[1];
  }
  return { x, y, vis, bbox: [x0, y0, x1, y1], anyVis };
}

// runs of consecutive points whose segments are all visible (or all hidden) : [[i0, i1], ...] with the points i0..i1
function runsOf(e, wantVisible) {
  const runs = [], m = e.x.length;
  let start = -1;
  for (let i = 0; i < m - 1; i++) {
    const segVisible = e.vis[i] === 1 && e.vis[i + 1] === 1;
    if (segVisible === wantVisible) { if (start < 0) start = i; } else if (start >= 0) { runs.push([start, i]); start = -1; }
  }
  if (start >= 0) runs.push([start, m - 1]);
  return runs;
}

function pathFromRuns(e, runs, decimals) {
  const f = Math.pow(10, decimals), parts = [];
  for (const [i0, i1] of runs) {
    parts.push('M' + Math.round(e.x[i0] * f) / f + ' ' + Math.round(e.y[i0] * f) / f);
    for (let i = i0 + 1; i <= i1; i++) parts.push('L' + Math.round(e.x[i] * f) / f + ' ' + Math.round(e.y[i] * f) / f);
  }
  return parts.join('');
}

// ------------------------------------------------------------------------------------------------------------------ SVG export
// One <path> per arc (id arc-<id>), one cubic Bezier per span (exact), image pixel coordinates of the view.
function buildSvg(doc, view, depthMap, opts) {
  const res = view.res, D = opts.decimals, f = Math.pow(10, D), n2 = (v) => String(Math.round(v * f) / f), q = [0, 0, 0], model = opts.model;
  const pr = (p) => { project(view, p, q); return n2(q[0]) + ' ' + n2(q[1]); };
  const out = ['<?xml version="1.0" encoding="UTF-8"?>',
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + res + ' ' + res + '" width="' + res + '" height="' + res + '">',
    '<title>ZenRay Lines, view ' + escapeHtml(opts.viewName) + ', ' + escapeHtml(doc.date || '') + '</title>'];
  if (opts.backgroundHref) out.push('<image x="0" y="0" width="' + res + '" height="' + res + '" opacity="' + opts.bgOpacity + '" href="' + opts.backgroundHref + '"/>');
  out.push('<g id="arcs" fill="none" stroke-linecap="round" stroke-linejoin="round">');
  let written = 0;
  for (const a of doc.arcs) {
    const e = projectArc(model, a, view, depthMap);
    if (!e.anyVis && !opts.showHidden) continue;
    const spans = Spline.bezierSpans(a.ctrl);
    if (!spans.length) continue;
    let d = 'M' + pr(spans[0][0]);
    for (const s of spans) d += 'C' + pr(s[1]) + ' ' + pr(s[2]) + ' ' + pr(s[3]);
    const style = e.anyVis ? 'stroke="' + opts.colors.arc + '" stroke-width="' + opts.stroke + '"'
      : 'stroke="' + opts.colors.arcHidden + '" stroke-width="' + opts.hiddenStroke + '" stroke-dasharray="6 5"';
    out.push('<path id="arc-' + a.id + '" class="' + (e.anyVis ? 'visible' : 'hidden') + '" data-pair="' + escapeHtml(a.pair.join(' / ')) + '" data-mirror="' + a.mirror + '" ' + style + ' d="' + d + '"/>');
    written++;
  }
  out.push('</g>', '<g id="nodes" stroke="none">');
  for (const nd of doc.nodes) {
    project(view, nd.p, q);
    if (!opts.showHidden && !isVisible(depthMap, q[0], q[1], q[2])) continue;
    out.push('<circle id="node-' + nd.id + '" cx="' + n2(q[0]) + '" cy="' + n2(q[1]) + '" r="' + opts.nodeRadius + '" fill="' + opts.colors.node + '"/>');
  }
  out.push('</g>', '</svg>');
  return { text: out.join('\n') + '\n', arcs: written };
}

// ------------------------------------------------------------------------------------------------------------------ application (DOM)
function startApp() {
  const SVGNS = 'http://www.w3.org/2000/svg';
