  }

  // ---------------------------------------------------------------- camera (viewBox) : zoom and pan
  function saveViewState() { S.viewStates[S.viewName] = { k: S.v2.k, x0: S.v2.x0, y0: S.v2.y0, fitK: S.fitK }; }
