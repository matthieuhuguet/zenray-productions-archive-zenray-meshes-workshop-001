    hoverRaf = typeof requestAnimationFrame === 'function' ? requestAnimationFrame(run) : (run(), 0);
  }
  function updateHover(ev) {
    const pt = imgPoint(ev);
    const hit = S.mode === 'add' ? { type: 'none' } : pickAt(pt);
    const prev = S.hover;
    const same = prev && prev.type === hit.type && prev.id === hit.id && prev.index === hit.index && prev.arc === hit.arc;
    if (!same) {
      S.hover = hit.type === 'none' ? null : hit;
      renderHover();
      if ((prev && prev.type === 'node') || hit.type === 'node') renderNodes();
      el.stage.classList.toggle('hot', hit.type === 'ctrl' || hit.type === 'node');
      el.stage.classList.toggle('over-arc', hit.type === 'arc');
      const ha = hit.type === 'arc' ? model.arc(hit.id) : null;
      el.hoverInfo.textContent = ha ? 'Arc #' + ha.id + '  ' + arcLabel(ha) : hit.type === 'node' ? 'Node #' + hit.id : hit.type === 'ctrl' ? 'Control point ' + hit.index : '';
    }
    if (S.mode === 'add' && S.addFirst !== null) {
      const v = S.nodeView.get(S.addFirst);
      if (v) {
        if (!S.preview) { S.preview = svgEl('line', { stroke: C.preview, 'stroke-dasharray': Z.dashGap.map((x) => x / S.v2.k).join(' ') }); el.gTop.appendChild(S.preview); }
        S.preview.setAttribute('stroke-width', 1.6 / S.v2.k);
        S.preview.setAttribute('x1', v.x); S.preview.setAttribute('y1', v.y); S.preview.setAttribute('x2', pt[0]); S.preview.setAttribute('y2', pt[1]);
      }
    }
    // world coordinates of the surface under the cursor
    if (S.depth) {
      const s = S.depth.surface(pt[0], pt[1], 0, CONFIG.snap.maxJumpM);
      if (s === s) { el.coords.textContent = unproject(S.viewDef, pt[0], pt[1], s).map((v) => v.toFixed(3)).join('  '); return; }
    }
    el.coords.textContent = '-';
  }
  function onWheel(ev) {
    ev.preventDefault();
    let dy = ev.deltaY;
    if (ev.deltaMode === 1) dy *= CONFIG.zoom.lineStepPx; else if (ev.deltaMode === 2) dy *= CONFIG.zoom.pageStepPx;
    const speed = CONFIG.zoom.speed * (ev.ctrlKey ? CONFIG.zoom.pinchBoost : 1);
    zoomAt(ev.clientX, ev.clientY, Math.exp(-dy * speed));
  }

  // ---------------------------------------------------------------- keyboard
  const typing = (ev) => { const t = ev.target; return !!t && (t.tagName === 'INPUT' && t.type !== 'checkbox' && t.type !== 'range' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT'); };
  function onKeyDown(ev) {
    if (typing(ev)) return;
    const mod = ev.metaKey || ev.ctrlKey, key = ev.key;
    if (key === ' ') { S.space = true; el.stage.classList.add('space'); ev.preventDefault(); return; }
    if (mod && (key === 'z' || key === 'Z')) { ev.preventDefault(); if (ev.shiftKey) doRedo(); else doUndo(); return; }
    if (mod && (key === 'y' || key === 'Y')) { ev.preventDefault(); doRedo(); return; }
