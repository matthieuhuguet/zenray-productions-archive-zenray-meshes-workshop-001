    params: Object.assign({}, CONFIG.defaults, { lineWidth: Z.arc }), filter: { text: '', comp: null },
    proj: new Map(), arcEls: new Map(), nodeEls: new Map(), nodeView: new Map(),
    W: 0, H: 0, fitK: 1, lastK: 0, fitted: false, v2: { k: 1, x0: 0, y0: 0 }, rowEls: new Map(), preview: null,
  };
  let model = null;

