    if (key === 'Escape') { if (S.mode === 'add') setMode('select'); else clearSelection(); return; }
    if (key === 'f' || key === 'F') { fitView(); return; }
    if (CONFIG.views.keys[key]) setView(CONFIG.views.keys[key]);
  }
  function onKeyUp(ev) {
    if (ev.key === ' ') { S.space = false; el.stage.classList.remove('space'); if (!typing(ev)) ev.preventDefault(); }
  }

  // ---------------------------------------------------------------- views
  async function setView(name) {
    if (!S.views[name] || name === S.viewName && S.viewDef) return;
    if (S.viewName) saveViewState();
    S.viewName = name; S.viewDef = S.views[name];
    S.depth = S.depthCache[name] || null;
    S.proj.clear(); S.hover = null;
    for (const b of el.viewButtons.querySelectorAll('button')) { const on = b.getAttribute('data-view') === name; b.classList.toggle('on', on); b.setAttribute('aria-checked', on ? 'true' : 'false'); }
    let bg = el.svg.querySelector('image');
    if (!bg) { bg = svgEl('image', { x: 0, y: 0, preserveAspectRatio: 'none' }); el.svg.insertBefore(bg, el.svg.firstChild); }
    bg.setAttribute('width', S.viewDef.res); bg.setAttribute('height', S.viewDef.res);
    bg.setAttribute('href', S.viewDef.image);
    bg.setAttribute('opacity', S.params.bgOpacity);
    measure();
    const st = S.viewStates[name];
    if (st && S.W > 0) { S.v2 = { k: st.k, x0: st.x0, y0: st.y0 }; S.fitK = st.fitK; applyViewBox(); } else fitView();
    renderAll();
    setStatus('View: ' + (S.viewDef.label || name) + (S.depth ? '' : ' (loading depth map)'));
