    t = t < 0 ? 0 : t > 1 ? 1 : t;
    const cx = ax + t * dx - px, cy = ay + t * dy - py;
    return cx * cx + cy * cy;
  }

  // ---------------------------------------------------------------- selection and lists
  function selectArc(id, opts) {
    S.sel.arc = id; S.sel.node = null;
    renderSelection(); renderHover(); renderNodes(); updateInfo(); updateRowSelection();
    if (opts && opts.reveal) revealArc(id);
  }
  function selectNode(id) {
    S.sel.node = id; S.sel.arc = null;
    renderSelection(); renderNodes(); updateInfo(); updateRowSelection();
  }
  function clearSelection() {
    S.sel.arc = null; S.sel.node = null;
    renderSelection(); renderNodes(); updateInfo(); updateRowSelection();
  }
  function revealArc(id) {                                      // bring a selected arc into the viewport (keeps the zoom when it fits)
    const a = model.arc(id);
    if (!a) return;
    measure();
    if (!(S.W > 0)) return;
    const b = entryFor(a).bbox, v = S.v2, vw = S.W / v.k, vh = S.H / v.k;
    const inside = b[0] >= v.x0 && b[2] <= v.x0 + vw && b[1] >= v.y0 && b[3] <= v.y0 + vh;
    if (inside) return;
    const w = Math.max(b[2] - b[0], 1), h = Math.max(b[3] - b[1], 1);
    if (w * 1.2 > vw || h * 1.2 > vh) { v.k = clamp(Math.min(S.W / (w * 1.4), S.H / (h * 1.4)), S.fitK * CONFIG.zoom.minFactor, CONFIG.zoom.maxScale); }
