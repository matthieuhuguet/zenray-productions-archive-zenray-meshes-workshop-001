  }
  async function loadDepth(name) {
    try {
      const r = await fetch(S.views[name].depth);
      if (!r.ok) throw new Error('HTTP ' + r.status);
      const png = await decodePng16(await r.arrayBuffer());
      S.depthCache[name] = createDepthMap(png, S.views[name]);
    } catch (e) {
      console.error(e);
      S.depthCache[name] = null;
      setStatus('Depth map not available (' + e.message + '): every arc is drawn as visible and Snap to surface is off.', 'warn');
      return;
    }
    if (S.viewName === name) { S.depth = S.depthCache[name]; S.proj.clear(); renderAll(); setStatus('View: ' + (S.viewDef.label || name)); }
  }
  function buildViewButtons() {
    el.viewButtons.innerHTML = '';
    CONFIG.views.order.forEach((name, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'btn view'; b.setAttribute('data-view', name); b.setAttribute('role', 'radio');
      b.innerHTML = '<span>' + escapeHtml((S.views[name] && S.views[name].label) || name) + '</span><kbd>' + (i + 1) + '</kbd>';
      el.viewButtons.appendChild(b);
    });
  }

  // ---------------------------------------------------------------- exports
  function download(blob, filename) {
    const url = URL.createObjectURL(blob), a = document.createElement('a');
    a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }
  function exportJson() { const text = model.serialize(); download(new Blob([text], { type: 'application/json' }), CONFIG.files.downloadJson); setStatus('Exported ' + CONFIG.files.downloadJson + ' (' + model.doc.arcs.length + ' arcs)'); return text; }
  function blobToDataUrl(blob) { return new Promise((res, rej) => { const fr = new FileReader(); fr.onload = () => res(fr.result); fr.onerror = () => rej(fr.error); fr.readAsDataURL(blob); }); }
  async function svgText() {
    const E = CONFIG.export;
    let href = null;
    if (S.params.svgBackground) { const r = await fetch(S.viewDef.image); href = await blobToDataUrl(await r.blob()); }
    return buildSvg(model.doc, S.viewDef, S.depth, { model, viewName: S.viewName, decimals: E.svgDecimals, showHidden: S.params.showHidden, backgroundHref: href,
      bgOpacity: E.svgBackgroundOpacity, colors: C, stroke: E.svgStroke, hiddenStroke: E.svgHiddenStroke, nodeRadius: E.svgNodeRadius });
  }
  async function exportSvg() {
    const r = await svgText();
    download(new Blob([r.text], { type: 'image/svg+xml' }), 'lines_' + S.viewName + '.svg');
    setStatus('Exported lines_' + S.viewName + '.svg (' + r.arcs + ' arcs, Bezier spans)');
    return r.text;
  }
  function loadImage(url) { return new Promise((res, rej) => { const im = new Image(); im.onload = () => res(im); im.onerror = () => rej(new Error('cannot load ' + url)); im.src = url; }); }
  async function exportPng() {
    const v = S.viewDef, E = CONFIG.export, im = await loadImage(v.image);
    const cv = document.createElement('canvas');
    cv.width = v.res; cv.height = v.res;
    const ctx = cv.getContext('2d');
    ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, v.res, v.res); ctx.drawImage(im, 0, 0, v.res, v.res);
    ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    const draw = (e, wantVisible) => {
      for (const [i0, i1] of runsOf(e, wantVisible)) { ctx.beginPath(); ctx.moveTo(e.x[i0], e.y[i0]); for (let i = i0 + 1; i <= i1; i++) ctx.lineTo(e.x[i], e.y[i]); ctx.stroke(); }
    };
    if (S.params.showHidden) {
      ctx.strokeStyle = C.arcHidden; ctx.lineWidth = E.pngHiddenPx; ctx.setLineDash([8, 6]);
      for (const a of model.doc.arcs) draw(entryFor(a), false);
      ctx.setLineDash([]);
    }
    ctx.strokeStyle = C.arc; ctx.lineWidth = E.pngArcPx;
    for (const a of model.doc.arcs) draw(entryFor(a), true);
    if (S.params.showNodes) {
      for (const [, nv] of S.nodeView) { if (!nv.show) continue; ctx.fillStyle = nv.vis ? C.node : C.nodeHidden; ctx.beginPath(); ctx.arc(nv.x, nv.y, E.pngNodePx, 0, Math.PI * 2); ctx.fill(); }
    }
    await new Promise((res) => cv.toBlob((blob) => { download(blob, 'lines_' + S.viewName + '.png'); res(); }, 'image/png'));
    setStatus('Exported lines_' + S.viewName + '.png');
  }
  async function saveToAtelier() {
    setStatus('Saving...');
    const r = await fetch(CONFIG.files.save, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: model.serialize() });
    let j = {};
    try { j = await r.json(); } catch (e) { /* the server answered without JSON */ }
    if (!r.ok || !j.ok) throw new Error(j.error || ('HTTP ' + r.status));
    model.dirty = false; refreshTitle();
    setStatus('Saved to atelier: ' + j.path + ' (' + j.arcs + ' arcs' + (j.backup ? ', backup kept' : '') + ')', 'ok');
    return j;
  }
  async function loadSaved() {
    const r = await fetch(CONFIG.files.saved, { cache: 'no-store' });
    if (!r.ok) { setStatus('No saved edit yet (' + CONFIG.files.saved + ' answers HTTP ' + r.status + ').', 'warn'); return; }
    const doc = await r.json();
    validateDoc(doc);
    model.checkpoint();
    model.load(doc);
    fixSelection(); S.proj.clear(); structureChanged();
    setStatus('Loaded ' + CONFIG.files.saved + ' (' + doc.arcs.length + ' arcs). Undo returns to the previous state.');
  }

  // ---------------------------------------------------------------- panel wiring
  function bindParams() {
    const P = S.params;
    el.pMirror.checked = P.mirror; el.pSnap.checked = P.snap; el.pHidden.checked = P.showHidden; el.pNodes.checked = P.showNodes;
    el.pGaps.checked = P.showGaps; el.pSvgBg.checked = P.svgBackground; el.pBgOpacity.value = P.bgOpacity; el.pSmooth.value = P.smoothAmount; el.pLineWidth.value = P.lineWidth;
    el.pMirror.addEventListener('change', () => { P.mirror = el.pMirror.checked; renderSelection(); setStatus('Mirror ' + (P.mirror ? 'on: edits also move the mirror arc (x to -x)' : 'off')); });
    el.pSnap.addEventListener('change', () => {
      P.snap = el.pSnap.checked;
      if (P.snap && !S.depth) setStatus('Snap to surface needs the depth map of this view (not loaded).', 'warn'); else setStatus('Snap to surface ' + (P.snap ? 'on' : 'off'));
    });
    el.pHidden.addEventListener('change', () => { P.showHidden = el.pHidden.checked; el.gHid.style.display = P.showHidden ? '' : 'none'; renderNodes(); });
    el.pNodes.addEventListener('change', () => { P.showNodes = el.pNodes.checked; renderNodes(); });
    el.pGaps.addEventListener('change', () => { P.showGaps = el.pGaps.checked; renderGaps(); });
    el.pSvgBg.addEventListener('change', () => { P.svgBackground = el.pSvgBg.checked; });
    el.pBgOpacity.addEventListener('input', () => { P.bgOpacity = parseFloat(el.pBgOpacity.value); const bg = el.svg.querySelector('image'); if (bg) bg.setAttribute('opacity', P.bgOpacity); });
    el.pSmooth.addEventListener('input', () => { P.smoothAmount = parseFloat(el.pSmooth.value); });
    el.pLineWidth.addEventListener('input', () => { P.lineWidth = parseFloat(el.pLineWidth.value); applyZoomStyles(); });
  }
  function bindUi() {
    bindParams();
    el.viewButtons.addEventListener('click', (ev) => { const b = ev.target.closest && ev.target.closest('button[data-view]'); if (b) setView(b.getAttribute('data-view')); });
    el.compList.addEventListener('click', (ev) => {
      const b = ev.target.closest && ev.target.closest('button[data-comp]');
      if (!b) return;
      const c = b.getAttribute('data-comp');
      S.filter.comp = S.filter.comp === c ? null : c;
      renderComponentList(); renderArcList(); renderComponent(); updateRowSelection();
    });
    el.filter.addEventListener('input', () => { S.filter.text = el.filter.value.trim(); renderArcList(); });
    el.arcList.addEventListener('click', (ev) => { const r = ev.target.closest && ev.target.closest('.row'); if (r) selectArc(parseInt(r.getAttribute('data-id'), 10), { reveal: true }); });
    el.bAdd.addEventListener('click', () => setMode(S.mode === 'add' ? 'select' : 'add'));
    el.bFit.addEventListener('click', fitView);
    el.bUndo.addEventListener('click', doUndo); el.bRedo.addEventListener('click', doRedo);
    el.bSmooth.addEventListener('click', doSmooth); el.bWeld.addEventListener('click', doWeld); el.bDelete.addEventListener('click', doDelete);
    el.bExportJson.addEventListener('click', safe(exportJson));
    el.bExportSvg.addEventListener('click', safe(exportSvg));
    el.bExportPng.addEventListener('click', safe(exportPng));
    el.bSave.addEventListener('click', safe(saveToAtelier));
    el.bLoadSaved.addEventListener('click', safe(loadSaved));
    el.svg.addEventListener('mousedown', safe(onDown));
    el.svg.addEventListener('wheel', safe(onWheel), { passive: false });
    el.svg.addEventListener('mouseleave', () => { if (!S.drag && S.hover) { S.hover = null; renderHover(); renderNodes(); } });
    window.addEventListener('mousemove', safe(onMove));
    window.addEventListener('mouseup', safe(onUp));
    window.addEventListener('keydown', safe(onKeyDown));
    window.addEventListener('keyup', safe(onKeyUp));
    window.addEventListener('beforeunload', (ev) => { if (model && model.dirty) { ev.preventDefault(); ev.returnValue = ''; } });
    const onResize = () => { measure(); if (!S.fitted && S.viewDef) fitView(); else applyViewBox(); };
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(onResize).observe(el.stage); else window.addEventListener('resize', onResize);
  }

  async function fetchJson(url) {
    const r = await fetch(url, { cache: 'no-store' });
    if (!r.ok) throw new Error(url + ' answers HTTP ' + r.status);
    return r.json();
  }

  async function init() {
    try {
      const [doc, views] = await Promise.all([fetchJson(CONFIG.files.lines), fetchJson(CONFIG.files.views)]);
      S.views = views;
      model = createModel(doc);
      model.buildNodeMirror();
    } catch (e) {
      console.error(e);
      setStatus('Cannot load the data (' + e.message + '). Run Scripts/lines/ZrlExport.py, then reload.', 'error');
      return;
    }
    buildViewButtons(); bindUi();
    renderComponentList(); renderArcList(); updateInfo();
    await setView(CONFIG.views.initial);
  }

  const ready = init();
  return {
    ready, state: S, config: CONFIG, model: () => model,
    api: { setView, selectArc, selectNode, clearSelection, fitView, toClient, imgPoint, pickAt, doUndo, doRedo, doSmooth, doWeld, doDelete, setMode, exportJson, exportSvg, saveToAtelier, loadSaved, renderAll, entryFor, handleList, svgText },
  };
}

