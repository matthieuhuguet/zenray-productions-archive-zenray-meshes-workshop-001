      row.className = 'row' + (S.sel.arc === a.id ? ' sel' : ''); row.setAttribute('data-id', a.id);
      row.innerHTML = '<span class="num">#' + a.id + '</span><span class="names">' + escapeHtml(arcLabel(a)) + '</span><span class="len">' + model.length(a.id).toFixed(2) + '</span>';
      frag.appendChild(row);
      S.rowEls.set(a.id, row);
    }
    el.arcList.innerHTML = '';
    el.arcList.appendChild(frag);
    el.arcCount.textContent = shown + ' of ' + model.doc.arcs.length;
  }
  function updateRowSelection() {
    for (const [id, row] of S.rowEls) row.classList.toggle('sel', id === S.sel.arc);
    const r = S.sel.arc != null ? S.rowEls.get(S.sel.arc) : null;
    if (r && r.scrollIntoView) r.scrollIntoView({ block: 'nearest' });
  }
  function updateRowLengths(ids) {
    for (const id of ids) { const row = S.rowEls.get(id), a = model.arc(id); if (row && a) row.querySelector('.len').textContent = model.length(id).toFixed(2); }
  }

  function updateInfo() {
    const box = el.selInfo;
    const row = (k, v) => '<div class="kv"><span>' + k + '</span><b>' + v + '</b></div>';
    if (S.sel.arc != null && model.arc(S.sel.arc)) {
      const a = model.arc(S.sel.arc), n = a.ctrl.length;
      const gap = (end, nid) => { if (nid < 0) return 'free'; const nd = model.node(nid); return '#' + nid + (nd ? ' (' + (dist3(a.ctrl[end], nd.p) * 1000).toFixed(1) + ' mm)' : ''); };
      box.innerHTML = row('Arc', '#' + a.id + (a.closed ? ' closed' : '')) + row('Pair', escapeHtml(arcLabel(a))) +
        row('Length', model.length(a.id).toFixed(3) + ' m') + row('Control points', n + ', ' + Spline.spanCount(n) + ' spans') +
        row('Node a', gap(0, a.a)) + row('Node b', gap(n - 1, a.b)) +
        row('Mirror', a.mirror >= 0 ? (a.mirror === a.id ? 'itself (centre)' : '#' + a.mirror) : 'none');
    } else if (S.sel.node != null && model.node(S.sel.node)) {
      const nd = model.node(S.sel.node), arcs = model.nodeArcs(nd.id).map((a) => '#' + a.id).join(' ');
      const mn = model.nodeMirror.get(nd.id);
      box.innerHTML = row('Node', '#' + nd.id) + row('Position', nd.p.map((v) => v.toFixed(3)).join(', ')) + row('Arcs', arcs || 'none') +
        row('Mirror', mn == null ? 'none' : mn === nd.id ? 'itself (centre)' : '#' + mn);
    } else {
