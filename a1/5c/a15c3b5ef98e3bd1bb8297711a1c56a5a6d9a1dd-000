def as_function(points, key_index=0):
    """Make a 1D interpolator value(key) from a polyline, sorted on the key axis (0 or 1)."""
    pts = sorted(points, key=lambda p: p[key_index])
    ks = [p[key_index] for p in pts]
    vs = [p[1 - key_index] for p in pts]

    def f(k):
        if k <= ks[0]:
            return vs[0]
        if k >= ks[-1]:
            return vs[-1]
        lo, hi = 0, len(ks) - 1
        while hi - lo > 1:
            mid = (lo + hi) // 2
            if ks[mid] <= k:
                lo = mid
            else:
                hi = mid
        t = (k - ks[lo]) / max(1e-12, ks[hi] - ks[lo])
        return vs[lo] + t * (vs[hi] - vs[lo])
    return f, (ks[0], ks[-1])


