    models = [a.split('=', 1) for a in argv[2:] if '=' in a and not a.startswith('--')]
    trace = json.loads(Path(trace_path).read_text())
    cams = json.loads(Path(trace['cameras']).read_text())
    meshes = [(label, *load_obj(obj, group)) for label, obj in models]
    whole = {label: load_obj(obj, None)[0] for label, obj in models}   # silhouettes use every group, bead included
    report = {}
    cols, rows = 1 + len(meshes), len(trace['views'])
    tw = (BOARD[0] - GAP * (cols + 1)) // cols
    th = (BOARD[1] - HEADER - GAP * (rows + 1)) // rows
    board = Image.new('RGB', BOARD, (24, 24, 26))
    d = ImageDraw.Draw(board)
    d.text((GAP, 18), trace.get('title', trace['component']), font=font(34), fill=(240, 240, 240))
    for r, view in enumerate(trace['views']):
        cam = camera(cams, view['camera'])
        photo = Image.open(view['photo']).convert('RGB')

        def curves(dr, to):
            for c in view['curves'].values():
                pts = [to(p) for p in c['px']]
                dr.line(pts, fill=CURVE + (255,), width=3) if len(pts) > 1 else None

        for label, _V, _F in meshes:
            for cname, c in view['curves'].items():
