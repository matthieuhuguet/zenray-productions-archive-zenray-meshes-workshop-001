def _axis_map(spec):
    # 'x:-z,y:-y' -> {'x': ('z', -1), 'y': ('y', -1)}
    out = {}
    for part in spec.split(','):
        screen, world = part.split(':')
        sign = -1.0 if world.strip().startswith('-') else 1.0
        out[screen.strip()] = (world.strip().lstrip('+-'), sign)
    return out


def load(path):
