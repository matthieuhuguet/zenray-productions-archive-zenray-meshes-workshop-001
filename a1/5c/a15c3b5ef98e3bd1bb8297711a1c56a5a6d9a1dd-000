# FR : planche de jugement, chaque modèle en fil de fer rouge sur les vraies photos calées, la courbe du plan en jaune.
#
# One row per view of the trace (side, front...), one column for the bare photo, then one column per model.
# Each model is projected with the calibrated camera of the view (same pinhole model as PhotoToBlueprint.py), so a
# wrong size or a wrong proportion shows at once against the photo. The blueprint curves (traced pixels) are drawn in
# yellow on every tile. Only the main group of each OBJ is drawn as wireframe; its open border is drawn thicker.
# Usage: BlueprintBoard.py <trace.json> <out.png> "<label>=<obj>" ["<label>=<obj>" ...] [--group hood_sheet]
import json
import sys
from pathlib import Path

import numpy as np
from PIL import Image, ImageDraw, ImageFont

BOARD = (1920, 1080)          # 1080p board, the size every synthesis schema uses
HEADER = 70                   # px reserved for the title
GAP = 12                      # px between tiles
WIRE = (255, 59, 48)          # red wireframe, the board Matthieu validated
CURVE = (255, 214, 10)        # yellow blueprint curve
FONT = '/Users/zenray/Library/Fonts/AdobeClean-Regular.otf'


def font(size):
    try:
        return ImageFont.truetype(FONT, size)
    except OSError:
        return ImageFont.load_default()


def camera(cams, name):
    c = cams[name]
    pos, tgt = np.array(c['pos'], float), np.array(c['target'], float)
    fwd = tgt - pos; fwd /= np.linalg.norm(fwd)
    right = np.cross(fwd, [0, 1, 0]); right /= np.linalg.norm(right)
    up = np.cross(right, fwd)
    x0, y0, x1, y1 = c['rect']
    f = c.get('focal_px') or cams['focal_mm'] / cams['film_back_mm'] * (x1 - x0)
    return dict(pos=pos, fwd=fwd, right=right, up=up, f=f, cx=(x0 + x1) / 2, cy=(y0 + y1) / 2)


def project(cam, P):
    d = P - cam['pos']
    dep = d @ cam['fwd']
    return np.stack([cam['cx'] + cam['f'] * (d @ cam['right']) / dep, cam['cy'] - cam['f'] * (d @ cam['up']) / dep], 1)


def load_obj(path, group):
    verts, faces, cur = [], [], ''
