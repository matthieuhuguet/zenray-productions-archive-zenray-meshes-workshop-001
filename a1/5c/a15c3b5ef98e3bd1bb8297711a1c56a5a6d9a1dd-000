SAMPLES_PER_SEGMENT = 24


def _tokens(d):
    # Every SVG command letter is tokenised, so an unsupported one (A, arc) is refused instead of read as a line.
    return re.findall(r'[A-Za-z]|[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?', d)


