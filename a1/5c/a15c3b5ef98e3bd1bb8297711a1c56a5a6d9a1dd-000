                e = edges(F)
                for (a, b), n in e.items():
                    dr.line([to(UV[a]), to(UV[b])], fill=WIRE + ((255,) if n == 1 else (120,)), width=3 if n == 1 else 1)
                curves(dr, to)
            cells.append((label, wire))
