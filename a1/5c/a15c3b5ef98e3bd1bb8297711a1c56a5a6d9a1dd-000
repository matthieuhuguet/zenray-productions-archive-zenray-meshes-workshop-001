            d.text((x, y + 2), '%s, %s' % (label, view.get('label', view['id'])), font=font(24), fill=(220, 220, 220))
    board.save(out)
    return {'board': out, 'size': BOARD, 'views': rows, 'models': [m[0] for m in models], 'silhouette_error': report}


if __name__ == '__main__':
    print(json.dumps(main(sys.argv[1:])))


