A = geo("Mad_Villain_AutoRig"); mk = maker(A)
shp = mk("object_merge", "Base_shp", objpath1=FINAL, xformtype=1); shp.setColor(GREEN); skl = mk("object_merge", "Base_skel", objpath1="/obj/Mad_Villain/null1", xformtype=1)
pcg = mk("~packcharacter", "packcharacter1", shp, skl); pfd = mk("~packfolder", "packfolder1", pcg)
comps = []
prev = pfd
for c in ("Spine", "Leg", "Arm", "Hand", "Neck", "LookAt", "BlendShape"):
    prev = mk("~autorigcomponent", "autorigcomponent_" + c, prev); comps.append(prev)
cfg = mk("~configurecontrols", "configurecontrols1", prev); sac = mk("~sceneaddcharacter", "sceneaddcharacter1", cfg); san = mk("~sceneanimate", "sceneanimate1", sac)
A.layoutChildren()
# ------------------------------------------------------------------ EP12 LookDev and rendering (Solaris)
stage = hou.node("/stage")
for nm in ("sopimport_Mad_Villain", "camera1", "materiallibrary1", "arealight1", "karmarendersettings1"):
    o = stage.node(nm)
    if o: o.destroy()
LOP = {}
try:
    si = stage.createNode("sopimport", "sopimport_Mad_Villain"); si.parm("soppath").set(FINAL); LOP["sopimport"] = si
    grid = stage.createNode("grid", "grid1") if "grid" in [t for t in hou.lopNodeTypeCategory().nodeTypes()] else None
    cam = stage.createNode("camera", "camera1"); lib = stage.createNode("materiallibrary", "materiallibrary1"); lt = stage.createNode("arealight::2.0" if "arealight::2.0" in hou.lopNodeTypeCategory().nodeTypes() else "light", "arealight1")
    krs = stage.createNode("karmarendersettings", "karmarendersettings1")
    chain = [x for x in (si, grid, cam, lib, lt, krs) if x]
    for a, b in zip(chain, chain[1:]): b.setInput(0, a)
    krs.setDisplayFlag(True); stage.layoutChildren(); LOP = {n.name(): n.type().name() for n in chain}
except Exception as e: MISSING.append(("lop", "stage", str(e)[:80]))
report = {}
for net in (B, T, S, A):
    for n in net.children():
        t = time.time()
        try: n.cook(force=True); g = n.geometry(); report[net.name() + "/" + n.name()] = (len(g.points()) if g else None, round(time.time() - t, 1), [e[:70] for e in n.errors()][:1])
        except Exception as e: report[net.name() + "/" + n.name()] = str(e)[:70]
RESULT = {"missing": MISSING, "lop": LOP, "report": report}
