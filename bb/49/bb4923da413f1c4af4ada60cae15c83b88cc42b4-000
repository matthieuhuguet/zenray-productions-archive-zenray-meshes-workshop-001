import sys, numpy as np
from scipy.spatial import cKDTree
def load(p):
    V=[];grp=[];cur=-1;names=[];G={}
    for l in open(p):
        if l.startswith("v "): V.append([float(x) for x in l.split()[1:4]])
        elif l.startswith("g "): names.append(l[2:].strip()); cur=len(names)-1
        elif l.startswith("f "):
            for x in l.split()[1:]: G.setdefault(int(x.split("/")[0])-1,set()).add(cur)
    return np.array(V),G,names
V0,G,names=load(sys.argv[1]); V1,_,_=load(sys.argv[2])
# coincident vertex pairs between different parts in the ORIGINAL (unwelded contacts)
idx=np.array(sorted(G)); T=cKDTree(V0[idx]); pairs=T.query_pairs(0.0015,output_type="ndarray")
a=idx[pairs[:,0]]; b=idx[pairs[:,1]]
diff=np.array([G[i]!=G[j] and not (G[i]&G[j]) for i,j in zip(a,b)]); a=a[diff]; b=b[diff]
d0=np.linalg.norm(V0[a]-V0[b],axis=1)*1000; d1=np.linalg.norm(V1[a]-V1[b],axis=1)*1000
if not len(a): print("no contact pairs between different parts"); sys.exit(0)
print("contact pairs between different parts: %d ; distance before mean %.2f mm ; after mean %.2f p99 %.2f max %.2f mm" % (len(a), d0.mean(), d1.mean(), np.percentile(d1,99), d1.max()))
print("pairs opened by more than 2 mm: %d, more than 5 mm: %d" % ((d1-d0>2).sum(), (d1-d0>5).sum()))
